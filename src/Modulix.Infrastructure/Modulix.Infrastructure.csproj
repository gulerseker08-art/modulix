<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\Modulix.Core\Modulix.Core.csproj" />
    <ProjectReference Include="..\Modulix.Core.Contracts\Modulix.Core.Contracts.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.*" />
  </ItemGroup>
  <ItemGroup>
    <!-- .xlsx okuma (GTİP kataloğu içe aktarma, ADR-0032 Dilim 3d-2): bağımlılığı yok, satırları akıtarak okur. -->
    <PackageReference Include="MiniExcel" Version="1.46.*" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.*" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.*" />
  </ItemGroup>
  <ItemGroup>
    <!-- Data Protection anahtarlarının veritabanında saklanması (çok örnekli çalışma, yeniden başlatmada oturum korunur). -->
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.*" />
  </ItemGroup>
  <ItemGroup>
    <!-- SMTP gönderimi (Email/SmtpEmailTransport). -->
    <PackageReference Include="MailKit" Version="4.18.*" />
  </ItemGroup>
  <ItemGroup>
    <!-- Sektör kataloğu başlangıç paketleri (ADR-0029 Dilim D): veri olarak gömülür. -->
    <EmbeddedResource Include="Sectors/StarterPackages/*.json" LogicalName="Modulix.StarterPackages.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>