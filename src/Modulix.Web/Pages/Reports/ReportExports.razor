@page "/raporlar/disa-aktarimlar"
@using System.Net
@inject ApiClient Api
@inject SessionState Session
@inject IJSRuntime Js

<PageTitle>@Texts.Get("reports.exports.pageTitle") · Modulix</PageTitle>

<AuthGate Permission="@ReportAccess.Export">
    <a class="back-link" href="raporlar"><AppIcon Name="arrow-left" Size="16" /> @Texts.Get("nav.app.reports")</a>

    <PageHeader Title="@Texts.Get("reports.exports.title")" Icon="file-text" Subtitle="@Texts.Get("reports.exports.subtitle")" />

    <div class="alert alert-info" role="note">@Texts.Get("reports.exports.note")</div>

    @if (message is not null)
    {
        <div class="alert @(messageFailed ? "alert-danger" : "alert-success")" role="@(messageFailed ? "alert" : "status")">@message</div>
    }

    <AnalyticsStatus Loading="loading" Error="@error" Forbidden="forbidden" OnRetry="LoadAsync" />

    @if (!loading && error is null && loaded)
    {
        @if (items.Count == 0)
        {
            <p class="text-muted" role="status">@Texts.Get("reports.exports.empty")</p>
        }
        else
        {
            <p class="visually-hidden" role="status" aria-live="polite">@Texts.Get("reports.exports.listed", items.Count)</p>
            <div class="table-responsive report-table-wrap" tabindex="0" role="region" aria-label="@Texts.Get("reports.exports.region")">
                <table class="table report-table">
                    <caption class="visually-hidden">@Texts.Get("reports.exports.caption")</caption>
                    <thead>
                        <tr>
                            <th scope="col">@Texts.Get("reports.run.pageTitle")</th>
                            <th scope="col">@Texts.Get("reports.exports.col.file")</th>
                            <th scope="col" class="text-end">@Texts.Get("reports.exports.col.rows")</th>
                            <th scope="col" class="text-end">@Texts.Get("reports.exports.col.size")</th>
                            <th scope="col">@Texts.Get("reports.exports.col.source")</th>
                            <th scope="col">@Texts.Get("reports.exports.col.created")</th>
                            <th scope="col">@Texts.Get("reports.exports.col.expires")</th>
                            <th scope="col" class="text-end">@Texts.Get("reports.exports.col.downloads")</th>
                            <th scope="col"><span class="visually-hidden">@Texts.Get("common.actions")</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in items)
                        {
                            <tr>
                                <td>
                                    @if (item.ReportId is { } reportId)
                                    {
                                        <a href="raporlar/@reportId">@item.ReportName</a>
                                    }
                                    else
                                    {
                                        @item.ReportName
                                    }
                                    @if (item.Truncated)
                                    {
                                        <span class="badge status-prospect ms-1" title="@Texts.Get("reports.exports.truncatedTitle")">@Texts.Get("reports.exports.truncated")</span>
                                    }
                                    @if (item.Expired)
                                    {
                                        <span class="badge status-inactive ms-1">@Texts.Get("reports.exports.expired")</span>
                                    }
                                </td>
                                <td>@item.FileName</td>
                                <td class="text-end">@item.RowCount.ToString("N0", Regional.Numbers)</td>
                                <td class="text-end">@ReportCenterLabels.Size(item.SizeBytes)</td>
                                <td>@ReportCenterLabels.ExportSource(item.Source)</td>
                                <td>@CrmLabels.Time(item.CreatedAt)</td>
                                <td>@CrmLabels.Time(item.ExpiresAt)</td>
                                <td class="text-end">@item.DownloadCount</td>
                                <td class="text-end">
                                    @if (item.Expired)
                                    {
                                        <span class="small text-muted me-2">@Texts.Get("reports.exports.exportAgain")</span>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@busy" aria-label="@Texts.Get("reports.exports.downloadAria", item.FileName)" @onclick="() => DownloadAsync(item)">@Texts.Get("crm.sales.export.download")</button>
                                    }
                                    @if (confirmDeleteId == item.Id)
                                    {
                                        <span class="confirm" role="alert">
                                            <span>@Texts.Get("reports.exports.deleteConfirm")</span>
                                            <button type="button" class="btn btn-danger btn-sm" disabled="@busy" @onclick="() => DeleteAsync(item)">@Texts.Get("common.view.deleteYes")</button>
                                            <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@busy" @onclick="() => confirmDeleteId = null">@Texts.Get("common.dismiss")</button>
                                        </span>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-outline-danger btn-sm" disabled="@busy" aria-label="@Texts.Get("reports.exports.deleteAria", item.FileName)" @onclick="() => confirmDeleteId = item.Id">@Texts.Get("common.delete")</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</AuthGate>

@code {
    private readonly List<ReportExportDto> items = [];
    private bool loading;
    private bool loaded;
    private string? error;
    private bool forbidden;
    private bool busy;
    private Guid? confirmDeleteId;
    private string? message;
    private bool messageFailed;

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (Session.Can(ReportAccess.Export))
        {
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        loading = true;
        error = null;
        forbidden = false;
        var result = await Api.GetAsync<List<ReportExportDto>>("/api/reports/exports");
        loading = false;
        loaded = true;
        error = result.Error;
        forbidden = result.Status == HttpStatusCode.Forbidden;
        items.Clear();
        if (result.Value is { } value)
        {
            items.AddRange(value.OrderByDescending(i => i.CreatedAt));
        }
    }

    private async Task DownloadAsync(ReportExportDto item)
    {
        busy = true;
        message = null;
        var failure = await ReportExportDownloads.DownloadAsync(Api, Js, item);
        busy = false;
        messageFailed = failure is not null;
        message = failure ?? Texts.Get("reports.exports.downloaded", item.FileName);
        if (failure is null)
        {
            await LoadAsync();
        }
    }

    private async Task DeleteAsync(ReportExportDto item)
    {
        busy = true;
        message = null;
        var result = await Api.DeleteAsync($"/api/reports/exports/{item.Id}");
        busy = false;
        confirmDeleteId = null;
        messageFailed = !result.IsSuccess;
        message = result.IsSuccess ? Texts.Get("reports.center.deleted", item.FileName) : result.Error;
        if (result.IsSuccess || result.Status == HttpStatusCode.NotFound)
        {
            await LoadAsync();
        }
    }
}
