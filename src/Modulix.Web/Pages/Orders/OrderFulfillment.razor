@page "/siparisler/{Id:guid}/teslimat"
@using Microsoft.AspNetCore.Components.Forms
@inject ApiClient Api
@inject SessionState Session

<PageTitle>@Texts.Get("orders.detail.fulfillment") · Modulix</PageTitle>

<AuthGate Module="@OrdersAccess.ModuleKey" Permission="@OrdersAccess.OrdersRead">
    @if (notFound)
    {
        <div class="alert alert-warning" role="alert">@Texts.Get("orders.detail.not-found") <a href="siparisler">@Texts.Get("orders.detail.back-to-list")</a></div>
    }
    else if (view is null)
    {
        <p class="text-muted" role="status">@Texts.Get("common.loading")</p>
    }
    else
    {
        <div class="page-header">
            <div>
                <h1>@Texts.Get("orders.detail.fulfillment")</h1>
                <p class="mb-0">
                    <span class="text-muted"><a href="siparisler/@view.OrderId">@Texts.Get("orders.fulfillment-page.order-link", view.OrderNumber)</a></span>
                    <span class="badge stage-@OrderLabels.FulfillmentBadge(view.Status)">@OrderLabels.Label(OrderLabels.Fulfillments, view.Status)</span>
                    @if (!string.IsNullOrEmpty(view.ContractNumber)) { <span class="text-muted">@Texts.Get("orders.fulfillment-page.contract", view.ContractNumber)</span> }
                </p>
            </div>
            <div class="header-actions"><a class="btn btn-outline-secondary" href="siparisler/@view.OrderId">@Texts.Get("orders.col.order")</a></div>
        </div>

        <Notice Text="@notice" Failed="@failed" />

        <p class="text-muted">
            @Texts.Get("orders.fulfillment-page.intro")
        </p>

        @if (view.Products.Count > 0)
        {
            <section aria-labelledby="products-title">
                <h2 id="products-title">@Texts.Get("orders.fulfillment-page.products")</h2>
                <table class="table record-table">
                    <caption class="visually-hidden">@Texts.Get("orders.fulfillment-page.products-caption")</caption>
                    <thead>
                        <tr><th scope="col">@Texts.Get("orders.change.col.line")</th><th scope="col" class="text-end">@Texts.Get("orders.col.order")</th><th scope="col" class="text-end">@Texts.Get("orders.fulfillment-page.col.effective")</th><th scope="col" class="text-end">@Texts.Get("orders.change.col.delivered")</th><th scope="col" class="text-end">@Texts.Get("orders.fromquote.col.remaining")</th><th scope="col" class="text-end">@Texts.Get("orders.fulfillment-page.col.planned-open")</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var p in view.Products)
                        {
                            <tr>
                                <td data-label="@Texts.Get("orders.change.col.line")" class="primary">@p.Name</td>
                                <td data-label="@Texts.Get("orders.col.order")" class="text-end">@OrderLabels.Quantity(p.Ordered, p.Unit)</td>
                                <td data-label="@Texts.Get("orders.fulfillment-page.col.effective")" class="text-end">@OrderLabels.Quantity(p.Effective, p.Unit)</td>
                                <td data-label="@Texts.Get("orders.change.col.delivered")" class="text-end">@OrderLabels.Quantity(p.Delivered, p.Unit)</td>
                                <td data-label="@Texts.Get("orders.fromquote.col.remaining")" class="text-end">@OrderLabels.Quantity(p.Remaining, p.Unit)</td>
                                <td data-label="@Texts.Get("orders.fulfillment-page.col.planned-open")" class="text-end">@OrderLabels.Quantity(p.PlannedOpen, p.Unit)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </section>

            <section aria-labelledby="deliveries-title">
                <h2 id="deliveries-title">@Texts.Get("orders.fulfillment-page.deliveries")</h2>
                @if (CanRecord && view.Products.Any(p => p.Remaining - p.PlannedOpen > 0m))
                {
                    @if (!planning)
                    {
                        <button type="button" class="btn btn-primary" disabled="@busy" @onclick="StartPlan">@Texts.Get("orders.fulfillment-page.plan")</button>
                    }
                    else
                    {
                        <form class="record-form" novalidate @onsubmit="PlanAsync" @onsubmit:preventDefault>
                            <fieldset disabled="@busy">
                                <legend>@Texts.Get("orders.fulfillment-page.new-delivery")</legend>
                                <FormTabs Title="@Texts.Get("orders.fulfillment-page.plan-tabs-title")" Label="@Texts.Get("orders.fulfillment-page.plan-tabs-label")">
                                <div class="form-grid">
                                    <div class="span-4"><label class="form-label" for="plan-date">@Texts.Get("orders.fulfillment-page.plan-date")</label><input id="plan-date" type="date" class="form-control" @bind="planDate" /></div>
                                    <div class="span-8"><label class="form-label" for="plan-notes">@Texts.Get("orders.fulfillment-page.note")</label><input id="plan-notes" class="form-control" maxlength="2000" @bind="planNotes" /></div>
                                    @foreach (var p in view.Products.Where(p => p.Remaining - p.PlannedOpen > 0m))
                                    {
                                        <div class="span-4">
                                            <label class="form-label" for="plan-q-@p.LineId">@Texts.Get("orders.fulfillment-page.plannable", p.Name, OrderLabels.Quantity(p.Remaining - p.PlannedOpen, p.Unit))</label>
                                            <input id="plan-q-@p.LineId" type="number" min="0" step="any" class="form-control" @bind="quantities[p.LineId]" />
                                        </div>
                                    }
                                </div>
                                </FormTabs>
                            </fieldset>
                            @if (formError is not null) { <div class="invalid-feedback d-block" role="alert">@formError</div> }
                            <div class="form-actions">
                                <button type="submit" class="btn btn-primary" disabled="@busy">@Texts.Get("orders.fulfillment-page.plan-submit")</button>
                                <button type="button" class="btn btn-outline-secondary" disabled="@busy" @onclick="() => planning = false">@Texts.Get("common.dismiss")</button>
                            </div>
                        </form>
                    }
                }

                @if (view.Deliveries.Count == 0)
                {
                    <p class="text-muted mt-2">@Texts.Get("orders.fulfillment-page.no-deliveries")</p>
                }

                @foreach (var d in view.Deliveries)
                {
                    <article class="mb-4 pb-3 border-bottom" aria-labelledby="del-@d.Id">
                        <h3 id="del-@d.Id">
                            @d.Number
                            <span class="badge stage-@DeliveryBadge(d.Status)">@DeliveryLabel(d.Status)</span>
                            @if (d.IsOverdue) { <span class="badge stage-lost">@Texts.Get("orders.fulfillment-page.overdue")</span> }
                        </h3>
                        <dl class="detail-list">
                            <dt>@Texts.Get("orders.fulfillment-page.planned")</dt><dd>@OrderLabels.Date(d.PlannedDate)</dd>
                            @if (d.ActualDate is not null) { <dt>@Texts.Get("orders.fulfillment-page.actual")</dt><dd>@OrderLabels.Date(d.ActualDate)</dd> }
                            @if (!string.IsNullOrEmpty(d.ReceiverName)) { <dt>@Texts.Get("orders.fulfillment-page.receiver")</dt><dd>@d.ReceiverName@(string.IsNullOrEmpty(d.ReceiverNote) ? null : " · " + d.ReceiverNote)</dd> }
                            @if (!string.IsNullOrEmpty(d.FailureReason)) { <dt>@Texts.Get(d.Status == "Cancelled" ? "orders.fulfillment-page.cancel-reason" : "orders.fulfillment-page.failure-reason")</dt><dd>@d.FailureReason</dd> }
                            @if (d.RescheduledFromId is not null) { <dt>@Texts.Get("orders.fulfillment-page.rescheduled")</dt><dd>@d.RescheduleReason</dd> }
                            @if (!string.IsNullOrEmpty(d.Notes)) { <dt>@Texts.Get("orders.fulfillment-page.note")</dt><dd>@d.Notes</dd> }
                        </dl>
                        <ul>
                            @foreach (var l in d.Lines)
                            {
                                <li>@Texts.Get("orders.fulfillment-page.line-planned", l.Name, OrderLabels.Quantity(l.Planned, l.Unit))@(d.Status == "Delivered" ? Texts.Get("orders.fulfillment-page.line-delivered", OrderLabels.Quantity(l.Delivered, l.Unit)) : null)</li>
                            }
                        </ul>

                        <h4 class="h6">@Texts.Get("orders.fulfillment-page.evidence")</h4>
                        @if (d.Evidence.Count == 0) { <p class="text-muted small">@Texts.Get("orders.fulfillment-page.no-evidence")</p> }
                        else
                        {
                            <ul class="small">
                                @foreach (var e in d.Evidence)
                                {
                                    <li>
                                        <a href="api/orders/deliveries/@d.Id/evidence/@e.Id" download="@e.FileName">@e.FileName</a>
                                        <span class="text-muted"> · @(e.SizeBytes / 1024) KB · @CrmLabels.Time(e.At)@(string.IsNullOrEmpty(e.Description) ? null : " · " + e.Description)</span>
                                    </li>
                                }
                            </ul>
                        }
                        @if (CanRecord && d.Status != "Cancelled")
                        {
                            <div class="mb-2">
                                <label class="form-label" for="ev-@d.Id">@Texts.Get("orders.fulfillment-page.add-evidence")</label>
                                <InputFile id="@("ev-" + d.Id)" class="form-control" accept=".pdf,.png,.jpg,.jpeg,application/pdf,image/png,image/jpeg" disabled="@busy"
                                           OnChange="e => UploadAsync(d, e)" />
                            </div>
                        }

                        @if (CanRecord && d.Actions.Count > 0)
                        {
                            <div class="header-actions" role="group" aria-label="@Texts.Get("orders.fulfillment-page.actions-of", d.Number)">
                                @foreach (var a in d.Actions.Where(a => a.Allowed))
                                {
                                    <button type="button" class="btn @(a.Action == "deliver" ? "btn-primary" : a.Action == "cancel" ? "btn-outline-danger" : "btn-outline-secondary")"
                                            disabled="@busy" @onclick="() => ChooseDelivery(d, a.Action)">@DeliveryAction(a.Action)</button>
                                }
                            </div>
                            @if (activeDelivery == d.Id && activeAction is { } act)
                            {
                                <form class="record-form" novalidate @onsubmit="RunDeliveryAsync" @onsubmit:preventDefault>
                                    <fieldset disabled="@busy">
                                        <legend>@DeliveryAction(act)</legend>
                                        <div class="form-grid">
                                            @if (act == "deliver")
                                            {
                                                <div class="span-6"><label class="form-label" for="f-receiver">@Texts.Get("orders.fulfillment-page.f.receiver")</label><input id="f-receiver" class="form-control" maxlength="300" @bind="receiver" /></div>
                                                <div class="span-6"><label class="form-label" for="f-actual">@Texts.Get("orders.fulfillment-page.f.actual")</label><input id="f-actual" type="date" class="form-control" @bind="actualDate" /></div>
                                                <div class="span-12"><label class="form-label" for="f-rnote">@Texts.Get("orders.fulfillment-page.f.receiver-note")</label><input id="f-rnote" class="form-control" maxlength="2000" @bind="receiverNote" /></div>
                                                @foreach (var l in d.Lines)
                                                {
                                                    <div class="span-4">
                                                        <label class="form-label" for="f-q-@l.OrderLineId">@Texts.Get("orders.fulfillment-page.f.line-delivered", l.Name, OrderLabels.Quantity(l.Planned, l.Unit))</label>
                                                        <input id="f-q-@l.OrderLineId" type="number" min="0" step="any" class="form-control" @bind="quantities[l.OrderLineId]" />
                                                    </div>
                                                }
                                            }
                                            else
                                            {
                                                <div class="span-12"><label class="form-label" for="f-reason">@Texts.Get("orders.change.reason")</label><textarea id="f-reason" class="form-control" rows="2" maxlength="500" @bind="reason"></textarea></div>
                                                @if (act == "reschedule")
                                                {
                                                    <div class="span-4"><label class="form-label" for="f-new-date">@Texts.Get("orders.fulfillment-page.f.new-date")</label><input id="f-new-date" type="date" class="form-control" @bind="rescheduleDate" /></div>
                                                }
                                            }
                                        </div>
                                    </fieldset>
                                    @if (formError is not null) { <div class="invalid-feedback d-block" role="alert">@formError</div> }
                                    <div class="form-actions">
                                        <button type="submit" class="btn btn-primary" disabled="@busy">@Texts.Get("common.save")</button>
                                        <button type="button" class="btn btn-outline-secondary" disabled="@busy" @onclick="CancelForm">@Texts.Get("common.dismiss")</button>
                                    </div>
                                </form>
                            }
                        }
                    </article>
                }
            </section>
        }

        @if (view.Services.Count > 0)
        {
            <section aria-labelledby="services-title">
                <h2 id="services-title">@Texts.Get("orders.fulfillment-page.services")</h2>
                @foreach (var s in view.Services)
                {
                    <article class="mb-4 pb-3 border-bottom" aria-labelledby="svc-@s.LineId">
                        <h3 id="svc-@s.LineId">
                            @s.Name
                            <span class="badge stage-@ServiceBadge(s.Start?.Status)">@ServiceLabel(s.Start?.Status)</span>
                            @if (s.IsOverdue) { <span class="badge stage-lost">@Texts.Get("orders.fulfillment-page.start-overdue")</span> }
                        </h3>
                        <dl class="detail-list">
                            <dt>@Texts.Get("orders.detail.col.quantity")</dt><dd>@OrderLabels.Quantity(s.Quantity, null)@(string.IsNullOrEmpty(s.RecurringPeriod) ? null : " · " + s.RecurringPeriod)</dd>
                            @if (s.Start is { } st)
                            {
                                <dt>@Texts.Get("orders.jobs.field.start")</dt><dd>@OrderLabels.Date(st.PlannedStartDate)</dd>
                                @if (st.ActualStartAt is { } started) { <dt>@Texts.Get("orders.fulfillment-page.actual-start")</dt><dd>@CrmLabels.Time(started)</dd> }
                                @if (st.CustomerConfirmedAt is { } confirmedAt) { <dt>@Texts.Get("orders.fulfillment-page.customer-confirmation")</dt><dd>@st.CustomerConfirmedBy · @CrmLabels.Time(confirmedAt)@(string.IsNullOrEmpty(st.ConfirmationNote) ? null : " · " + st.ConfirmationNote)</dd> }
                                @if (st.CompletedAt is { } completedAt) { <dt>@Texts.Get("orders.fulfillment-page.completed")</dt><dd>@CrmLabels.Time(completedAt)</dd> }
                                @if (!string.IsNullOrEmpty(st.DelayReason)) { <dt>@Texts.Get("orders.fulfillment-page.delay-reason")</dt><dd>@st.DelayReason</dd> }
                            }
                        </dl>
                        @if (s.OngoingObligation)
                        {
                            <p class="small text-muted">@Texts.Get("orders.fulfillment-page.ongoing")</p>
                        }
                        @if (s.Blockers.Count > 0)
                        {
                            <div class="alert alert-warning" role="status">
                                <strong>@Texts.Get("orders.fulfillment-page.blockers")</strong>
                                <ul class="mb-0">@foreach (var b in s.Blockers) { <li>@b</li> }</ul>
                            </div>
                        }

                        @if (CanRecord)
                        {
                            @if (s.Start is null)
                            {
                                <div class="search">
                                    <label class="visually-hidden" for="svc-date-@s.LineId">@Texts.Get("orders.jobs.field.start")</label>
                                    <input id="svc-date-@s.LineId" type="date" class="form-control" @bind="servicePlanDates[s.LineId]" />
                                    <button type="button" class="btn btn-primary" disabled="@busy" @onclick="() => PlanServiceAsync(s)">@Texts.Get("orders.fulfillment-page.plan-start")</button>
                                </div>
                            }
                            else
                            {
                                <div class="header-actions" role="group" aria-label="@Texts.Get("orders.fulfillment-page.actions-of", s.Name)">
                                    @foreach (var a in s.Actions)
                                    {
                                        <button type="button" class="btn @(a.Action == "start" ? "btn-primary" : "btn-outline-secondary")" disabled="@(!a.Allowed || busy)"
                                                aria-describedby="@(a.Allowed ? null : $"why-{s.LineId}-{a.Action}")" @onclick="() => ChooseService(s, a.Action)">@ServiceAction(a.Action)</button>
                                    }
                                </div>
                                <ul class="small text-muted mt-2">
                                    @foreach (var a in s.Actions.Where(a => !a.Allowed))
                                    {
                                        <li id="why-@s.LineId-@a.Action"><strong>@ServiceAction(a.Action):</strong> @a.Message</li>
                                    }
                                </ul>
                                @if (activeService == s.LineId && activeServiceAction == "confirm")
                                {
                                    <form class="record-form" novalidate @onsubmit="RunServiceAsync" @onsubmit:preventDefault>
                                        <fieldset disabled="@busy">
                                            <legend>@Texts.Get("orders.fulfillment-page.confirm-legend")</legend>
                                            <div class="form-grid">
                                                <div class="span-6"><label class="form-label" for="c-by">@Texts.Get("orders.fulfillment-page.f.confirmed-by")</label><input id="c-by" class="form-control" maxlength="300" @bind="confirmedBy" /></div>
                                                <div class="span-6"><label class="form-label" for="c-note">@Texts.Get("orders.fulfillment-page.note")</label><input id="c-note" class="form-control" maxlength="500" @bind="confirmNote" /></div>
                                            </div>
                                        </fieldset>
                                        @if (formError is not null) { <div class="invalid-feedback d-block" role="alert">@formError</div> }
                                        <div class="form-actions">
                                            <button type="submit" class="btn btn-primary" disabled="@busy">Kaydet</button>
                                            <button type="button" class="btn btn-outline-secondary" disabled="@busy" @onclick="CancelForm">@Texts.Get("common.dismiss")</button>
                                        </div>
                                    </form>
                                }
                                @if (s.Start.Status == "Planned" && s.IsOverdue)
                                {
                                    <form class="search" novalidate @onsubmit="() => SaveDelayAsync(s)" @onsubmit:preventDefault>
                                        <label class="visually-hidden" for="delay-@s.LineId">@Texts.Get("orders.fulfillment-page.delay-reason")</label>
                                        <input id="delay-@s.LineId" class="form-control" maxlength="500" placeholder="@Texts.Get("orders.fulfillment-page.delay-placeholder")" @bind="delayReasons[s.LineId]" />
                                        <button type="submit" class="btn btn-outline-secondary" disabled="@(busy || string.IsNullOrWhiteSpace(delayReasons.GetValueOrDefault(s.LineId)))">@Texts.Get("orders.fulfillment-page.delay-save")</button>
                                    </form>
                                }
                            }
                        }
                    </article>
                }
            </section>
        }

        @if (view.Products.Count == 0 && view.Services.Count == 0)
        {
            <p class="text-muted">@Texts.Get("orders.fulfillment-page.nothing")</p>
        }
    }
</AuthGate>

@code {
    private const long MaxEvidenceBytes = OrderFulfillmentAccess.MaxEvidenceBytes;

    [Parameter] public Guid Id { get; set; }

    private FulfillmentDto? view;
    private string? notice;
    private bool failed;
    private bool notFound;
    private bool busy;
    private bool planning;
    private DateOnly? planDate;
    private string planNotes = string.Empty;
    private readonly Dictionary<Guid, decimal> quantities = [];
    private readonly Dictionary<Guid, DateOnly?> servicePlanDates = [];
    private readonly Dictionary<Guid, string> delayReasons = [];
    private string? formError;
    private Guid? activeDelivery;
    private string? activeAction;
    private string reason = string.Empty;
    private string receiver = string.Empty;
    private string receiverNote = string.Empty;
    private DateOnly? actualDate;
    private DateOnly? rescheduleDate;
    private Guid? activeService;
    private string? activeServiceAction;
    private string confirmedBy = string.Empty;
    private string confirmNote = string.Empty;

    private bool CanRecord => Session.Can(OrderFulfillmentAccess.FulfillmentRecord);

    protected override async Task OnParametersSetAsync()
    {
        await Session.EnsureLoadedAsync();
        if (!Session.Can(OrdersAccess.OrdersRead)) { return; }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var result = await Api.GetAsync<FulfillmentDto>($"/api/orders/orders/{Id}/fulfillment");
        if (!result.IsSuccess)
        {
            notFound = true;
            return;
        }

        view = result.Value;
        foreach (var s in view!.Services)
        {
            servicePlanDates.TryAdd(s.LineId, null);
            delayReasons.TryAdd(s.LineId, s.Start?.DelayReason ?? string.Empty);
        }
    }

    private void Report(bool ok, string success, string? error)
    {
        failed = !ok;
        notice = ok ? success : error;
    }

    // ---- Teslimat planı

    private void StartPlan()
    {
        planDate = DateOnly.FromDateTime(DateTime.Today.AddDays(1));
        planNotes = string.Empty;
        formError = null;
        quantities.Clear();
        foreach (var p in view!.Products) { quantities[p.LineId] = Math.Max(0m, p.Remaining - p.PlannedOpen); }
        planning = true;
    }

    private async Task PlanAsync()
    {
        if (busy || view is null) { return; }
        if (planDate is null) { formError = "Planlanan teslim tarihi zorunludur."; return; }
        var lines = view.Products.Where(p => quantities.GetValueOrDefault(p.LineId) > 0m).Select(p => new QuantityDto(p.LineId, quantities[p.LineId])).ToList();
        if (lines.Count == 0) { formError = Texts.Get("orders.fulfillment-page.msg.lines-required"); return; }

        busy = true;
        var result = await Api.PostAsync<DeliveryViewDto>($"/api/orders/orders/{Id}/deliveries", new PlanDeliveryRequest(planDate.Value, lines, null, string.IsNullOrWhiteSpace(planNotes) ? null : planNotes.Trim()));
        busy = false;
        Report(result.IsSuccess, Texts.Get("orders.fulfillment-page.msg.planned"), result.Error);
        formError = result.IsSuccess ? null : result.Error;
        if (result.IsSuccess) { planning = false; await LoadAsync(); }
    }

    // ---- Teslimat eylemleri

    private void ChooseDelivery(DeliveryViewDto d, string action)
    {
        if (activeDelivery == d.Id && activeAction == action) { CancelForm(); return; }
        activeDelivery = d.Id;
        activeAction = action;
        formError = null;
        reason = string.Empty;
        receiver = string.Empty;
        receiverNote = string.Empty;
        actualDate = DateOnly.FromDateTime(DateTime.Today);
        rescheduleDate = null;
        quantities.Clear();
        foreach (var l in d.Lines) { quantities[l.OrderLineId] = l.Planned; }
    }

    private void CancelForm()
    {
        activeDelivery = null;
        activeAction = null;
        activeService = null;
        activeServiceAction = null;
        formError = null;
    }

    private async Task RunDeliveryAsync()
    {
        if (busy || view is null || activeDelivery is not { } id || activeAction is not { } action) { return; }
        var delivery = view.Deliveries.First(d => d.Id == id);
        DeliveryActionRequest request;
        if (action == "deliver")
        {
            if (string.IsNullOrWhiteSpace(receiver)) { formError = Texts.Get("orders.fulfillment-page.msg.receiver-required"); return; }
            var lines = delivery.Lines.Select(l => new QuantityDto(l.OrderLineId, quantities.GetValueOrDefault(l.OrderLineId))).ToList();
            request = new DeliveryActionRequest(delivery.Version, null, receiver.Trim(), string.IsNullOrWhiteSpace(receiverNote) ? null : receiverNote.Trim(), actualDate, lines);
        }
        else
        {
            if (string.IsNullOrWhiteSpace(reason)) { formError = Texts.Get("orders.actions.reason-required"); return; }
            if (action == "reschedule" && rescheduleDate is null) { formError = "Yeni teslim tarihi zorunludur."; return; }
            request = new DeliveryActionRequest(delivery.Version, reason.Trim(), PlannedDate: rescheduleDate);
        }

        busy = true;
        var result = await Api.PostAsync<DeliveryViewDto>($"/api/orders/deliveries/{id}/{action}", request);
        busy = false;
        Report(result.IsSuccess, $"{DeliveryAction(action)}: kaydedildi.", result.Error);
        formError = result.IsSuccess ? null : result.Error;
        if (result.IsSuccess) { CancelForm(); await LoadAsync(); }
    }

    private async Task UploadAsync(DeliveryViewDto d, InputFileChangeEventArgs e)
    {
        if (busy || e.File is not { } file) { return; }
        if (file.Size > MaxEvidenceBytes) { Report(false, string.Empty, "Dosya en fazla 2 MB olabilir."); return; }
        if (!OrderFulfillmentAccess.AllowedEvidenceTypes.Contains(file.ContentType)) { Report(false, string.Empty, Texts.Get("orders.fulfillment-page.msg.evidence-type")); return; }

        busy = true;
        try
        {
            using var stream = file.OpenReadStream(MaxEvidenceBytes);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            var url = $"/api/orders/deliveries/{d.Id}/evidence?fileName={Uri.EscapeDataString(file.Name)}";
            var result = await Api.PutBytesAsync<DeliveryViewDto>(url, buffer.ToArray(), file.ContentType);
            Report(result.IsSuccess, Texts.Get("orders.fulfillment-page.msg.evidence-added"), result.Error);
        }
        catch (IOException)
        {
            Report(false, string.Empty, Texts.Get("orders.fulfillment-page.msg.file-unreadable"));
        }
        finally
        {
            busy = false;
        }

        await LoadAsync();
    }

    // ---- Hizmet başlangıcı

    private async Task PlanServiceAsync(ServiceLineDto s)
    {
        if (busy) { return; }
        busy = true;
        var result = await Api.PostAsync<ServiceLineDto>($"/api/orders/orders/{Id}/service-starts", new PlanServiceRequest(s.LineId, servicePlanDates.GetValueOrDefault(s.LineId)));
        busy = false;
        Report(result.IsSuccess, Texts.Get("orders.fulfillment-page.msg.service-planned"), result.Error);
        await LoadAsync();
    }

    private async Task ChooseService(ServiceLineDto s, string action)
    {
        formError = null;
        confirmedBy = string.Empty;
        confirmNote = string.Empty;
        if (action == "confirm")
        {
            activeService = activeService == s.LineId && activeServiceAction == "confirm" ? null : s.LineId;
            activeServiceAction = activeService is null ? null : "confirm";
            return;
        }

        activeService = s.LineId;
        activeServiceAction = action;
        await RunServiceAsync();
    }

    private async Task RunServiceAsync()
    {
        if (busy || view is null || activeService is not { } lineId || activeServiceAction is not { } action) { return; }
        var service = view.Services.First(x => x.LineId == lineId);
        if (service.Start is null) { return; }
        if (action == "confirm" && string.IsNullOrWhiteSpace(confirmedBy)) { formError = Texts.Get("orders.fulfillment-page.msg.confirmer-required"); return; }

        busy = true;
        var request = new ServiceActionRequest(service.Start.Version, string.IsNullOrWhiteSpace(confirmedBy) ? null : confirmedBy.Trim(), string.IsNullOrWhiteSpace(confirmNote) ? null : confirmNote.Trim());
        var result = await Api.PostAsync<ServiceLineDto>($"/api/orders/service-starts/{service.Start.Id}/{action}", request);
        busy = false;
        Report(result.IsSuccess, $"{ServiceAction(action)}: kaydedildi.", result.Error);
        formError = result.IsSuccess ? null : result.Error;
        if (result.IsSuccess) { CancelForm(); }
        await LoadAsync();
    }

    private async Task SaveDelayAsync(ServiceLineDto s)
    {
        if (busy || s.Start is null) { return; }
        busy = true;
        var result = await Api.PutAsync<ServiceStartDto>($"/api/orders/service-starts/{s.Start.Id}",
            new SaveServiceStartRequest(s.Start.Version, s.Start.PlannedStartDate, delayReasons.GetValueOrDefault(s.LineId)?.Trim()));
        busy = false;
        Report(result.IsSuccess, Texts.Get("orders.fulfillment-page.msg.delay-saved"), result.Error);
        await LoadAsync();
    }

    // ---- Etiketler

    private static string DeliveryLabel(string status) => status switch
    {
        "Planned" => Texts.Get("orders.fulfillment-page.delivery.planned"),
        "Delivered" => Texts.Get("orders.fulfillment-page.delivery.delivered"),
        "Failed" => Texts.Get("orders.fulfillment-page.delivery.failed"),
        "Cancelled" => Texts.Get("orders.fulfillment-page.delivery.cancelled"),
        _ => status,
    };

    private static string DeliveryBadge(string status) => status switch
    {
        "Delivered" => "won",
        "Planned" => "onhold",
        "Failed" => "lost",
        _ => "cancelled",
    };

    private static string DeliveryAction(string action) => action switch
    {
        "deliver" => Texts.Get("orders.fulfillment-page.delivery-action.deliver"),
        "fail" => Texts.Get("orders.fulfillment-page.delivery-action.fail"),
        "cancel" => Texts.Get("orders.fulfillment-page.delivery-action.cancel"),
        "reschedule" => Texts.Get("orders.fulfillment-page.delivery-action.reschedule"),
        _ => action,
    };

    private static string ServiceLabel(string? status) => status switch
    {
        null => Texts.Get("orders.fulfillment-page.service.none"),
        "Planned" => Texts.Get("orders.fulfillment-page.service.planned"),
        "Started" => Texts.Get("orders.fulfillment-page.service.started"),
        "Completed" => Texts.Get("orders.fulfillment-page.service.completed"),
        _ => status,
    };

    private static string ServiceBadge(string? status) => status switch
    {
        "Completed" => "won",
        "Started" or "Planned" => "onhold",
        _ => "open",
    };

    private static string ServiceAction(string action) => action switch
    {
        "start" => Texts.Get("orders.fulfillment-page.service-action.start"),
        "confirm" => Texts.Get("orders.fulfillment-page.service-action.confirm"),
        "complete" => Texts.Get("orders.fulfillment-page.service-action.complete"),
        _ => action,
    };
}
