@page "/siparisler/{OrderId:guid}/devir"
@inject ApiClient Api
@inject SessionState Session
@inject CrmLookups Lookups

<PageTitle>@Texts.Get("orders.handover-page.title") · Modulix</PageTitle>

<AuthGate Module="@OrdersAccess.ModuleKey" Permission="@OrdersAccess.OrdersRead">
    <div class="page-header">
        <div>
            <h1>@Texts.Get("orders.handover-page.title")@(order is null ? null : " · " + order.Number)</h1>
            <p class="text-muted mb-0">@Texts.Get("orders.handover-page.intro")</p>
        </div>
        <div class="header-actions">
            <a class="btn btn-outline-secondary" href="siparisler/@OrderId">@Texts.Get("orders.handover-page.back")</a>
        </div>
    </div>

    <Notice Text="@notice" Failed="@failed" />

    @if (notFoundOrder)
    {
        <div class="alert alert-warning" role="alert">@Texts.Get("orders.detail.not-found") <a href="siparisler">@Texts.Get("orders.detail.back-to-list")</a></div>
    }
    else if (loading)
    {
        <LoadingState />
    }
    else if (detail is null)
    {
        <p class="text-muted">@Texts.Get("orders.handover-page.none")</p>
        @if (Session.Can(OrderHandoverAccess.HandoversWrite))
        {
            <button type="button" class="btn btn-primary" disabled="@busy" @onclick="CreateAsync">@Texts.Get("orders.handover-page.create")</button>
        }
        else
        {
            <p class="text-muted">@Texts.Get("orders.handover-page.permission", OrderHandoverAccess.HandoversWrite)</p>
        }
    }
    else
    {
        var h = detail.Handover;
        <p>
            <span class="badge stage-@OrderLabels.HandoverBadge(h.Status)">@OrderLabels.Label(OrderLabels.Handovers, h.Status)</span>
            @if (h.Round > 0) { <span class="text-muted">@Texts.Get("orders.handover-page.round", h.Round)</span> }
            @if (h.SentAt is { } sentAt) { <span class="text-muted">@Texts.Get("orders.handover-page.sent-by", Lookups.MemberName(h.SentBy), CrmLabels.Time(sentAt))</span> }
            @if (h.AcceptedAt is { } acceptedAt) { <span class="text-muted">@Texts.Get("orders.handover-page.accepted-by", Lookups.MemberName(h.AcceptedBy), CrmLabels.Time(acceptedAt))</span> }
        </p>

        @if (h.Status == "InfoRequested" && !string.IsNullOrEmpty(h.InfoRequest))
        {
            <div class="alert alert-warning" role="status"><strong>@Texts.Get("orders.handover-page.info-requested")</strong> @h.InfoRequest</div>
        }

        @if (Editable)
        {
            <section aria-labelledby="missing-title">
                <h2 id="missing-title" class="h6">@Texts.Get("orders.handover-page.missing")</h2>
                @if (detail.Missing.Count == 0)
                {
                    <p class="text-success" role="status">@Texts.Get("orders.handover-page.missing-ok")</p>
                }
                else
                {
                    <ul class="alert alert-warning" role="status" aria-live="polite">
                        @foreach (var missing in detail.Missing) { <li>@missing</li> }
                    </ul>
                }
            </section>
        }

        <section aria-labelledby="actions-title">
            <h2 id="actions-title">@Texts.Get("orders.handover-page.actions")</h2>
            @if (detail.Actions.Count == 0)
            {
                <p class="text-muted">@Texts.Get("orders.handover-page.no-actions")</p>
            }
            else
            {
                <div class="header-actions" role="group" aria-label="@Texts.Get("orders.handover-page.actions-group")">
                    @foreach (var action in detail.Actions)
                    {
                        <button type="button" class="btn @(action.Action == "send" || action.Action == "accept" ? "btn-primary" : "btn-outline-secondary")"
                                disabled="@(!action.Allowed || busy)" aria-describedby="@(action.Allowed ? null : $"why-{action.Action}")" @onclick="() => Choose(action)">@ActionLabel(action, h.Status)</button>
                    }
                </div>
                <ul class="small text-muted mt-2">
                    @foreach (var blocked in detail.Actions.Where(a => !a.Allowed))
                    {
                        <li id="why-@blocked.Action"><strong>@ActionLabel(blocked, h.Status):</strong> @blocked.Message</li>
                    }
                </ul>
                @if (selected is { } chosen)
                {
                    <form class="record-form" novalidate @onsubmit="RunAsync" @onsubmit:preventDefault>
                        @if (chosen.RequiresNote || chosen.Action == "accept")
                        {
                            <label class="form-label" for="action-note">@NoteLabel(chosen)</label>
                            <textarea id="action-note" class="form-control" rows="2" maxlength="4000" @bind="note" aria-invalid="@(noteError is not null ? "true" : null)"></textarea>
                            @if (noteError is not null) { <div class="invalid-feedback d-block" role="alert">@noteError</div> }
                        }
                        @if (chosen.Action == "accept")
                        {
                            <label class="form-label mt-2" for="accept-responsible">@Texts.Get("orders.handover-page.accept-responsible")</label>
                            <LookupPicker Id="accept-responsible" LookupKey="orders.handover.responsible" @bind-Value="responsible" Placeholder="@(h.ResponsibleUserId is null ? "—" : Lookups.MemberName(h.ResponsibleUserId))" />
                        }
                        <div class="form-actions">
                            <button type="submit" class="btn btn-primary" disabled="@busy">@Texts.Get("orders.actions.confirm", ActionLabel(chosen, h.Status))</button>
                            <button type="button" class="btn btn-outline-secondary" disabled="@busy" @onclick="() => selected = null">@Texts.Get("common.dismiss")</button>
                        </div>
                    </form>
                }
            }
        </section>

        <form class="record-form" novalidate @onsubmit="SaveAsync" @onsubmit:preventDefault>
            <TabBar Tabs="FormTabs" State="tabs" Label="@Texts.Get("orders.handover-page.tabs-label")" />
            <fieldset disabled="@(!Editable || busy)">
                <legend class="visually-hidden">@Texts.Get("orders.handover-page.legend")</legend>
                @if (!Editable)
                {
                    <p class="text-muted">@Texts.Get(h.Status == "Accepted" ? "orders.handover-page.locked-accepted" : "orders.handover-page.locked-sent")</p>
                }
                <TabPanel State="tabs" Key="form-kapsam">
                <div class="form-grid">
                    <div class="span-12"><label class="form-label" for="f-scope">@Texts.Get("orders.handover-page.f.scope")</label><textarea id="f-scope" class="form-control" rows="2" maxlength="4000" @bind="form.Scope"></textarea></div>
                    <div class="span-12"><label class="form-label" for="f-out">@Texts.Get("orders.handover-page.f.out-of-scope")</label><textarea id="f-out" class="form-control" rows="2" maxlength="4000" @bind="form.OutOfScope"></textarea></div>
                    <div class="span-12"><label class="form-label" for="f-deliverables">@Texts.Get("orders.handover-page.f.deliverables")</label><textarea id="f-deliverables" class="form-control" rows="2" maxlength="4000" @bind="form.Deliverables"></textarea></div>
                    <div class="span-12"><label class="form-label" for="f-commitments">@Texts.Get("orders.header-field.commitments")</label><textarea id="f-commitments" class="form-control" rows="2" maxlength="4000" @bind="form.Commitments"></textarea></div>
                </div>
                </TabPanel>
                <TabPanel State="tabs" Key="form-lokasyon">
                <div class="form-grid">
                    <div class="span-12"><label class="form-label" for="f-location">@Texts.Get("orders.handover-page.f.location")</label><input id="f-location" class="form-control" maxlength="1000" @bind="form.Location" /></div>
                    <div class="span-4"><label class="form-label" for="f-contact">@Texts.Get("orders.handover-page.f.contact")</label><input id="f-contact" class="form-control" maxlength="300" @bind="form.ContactName" /></div>
                    <div class="span-4"><label class="form-label" for="f-phone">@Texts.Get("orders.handover-page.f.phone")</label><input id="f-phone" class="form-control" maxlength="300" @bind="form.ContactPhone" /></div>
                    <div class="span-4"><label class="form-label" for="f-email">@Texts.Get("orders.handover-page.f.email")</label><input id="f-email" type="email" class="form-control" maxlength="254" @bind="form.ContactEmail" /><FieldError Field="contactEmail" Errors="errors" /></div>
                    <div class="span-12"><small class="text-muted">@Texts.Get("orders.handover-page.contact-note")</small></div>
                </div>
                </TabPanel>
                <TabPanel State="tabs" Key="form-tarih">
                <div class="form-grid">
                    <div class="span-4"><label class="form-label" for="f-start">@Texts.Get("orders.handover-page.f.start")</label><input id="f-start" type="date" class="form-control" @bind="form.TargetStartDate" /></div>
                    <div class="span-4"><label class="form-label" for="f-end">@Texts.Get("orders.handover-page.f.end")</label><input id="f-end" type="date" class="form-control" @bind="form.TargetEndDate" /><FieldError Field="targetEndDate" Errors="errors" /></div>
                    <div class="span-4">
                        <label class="form-label" for="f-priority">@Texts.Get("orders.handover-page.f.priority")</label>
                        <select id="f-priority" class="form-select" @bind="form.Priority">
                            @foreach (var p in OrderLabels.Priorities) { <option value="@p.Key">@p.Label</option> }
                        </select>
                    </div>
                    <div class="span-6"><label class="form-label" for="f-resp">@Texts.Get("orders.handover-page.f.responsible")</label><LookupPicker Id="f-resp" LookupKey="orders.handover.responsible" @bind-Value="form.ResponsibleUserId" Placeholder="—" ReadOnly="@(!Editable)" /></div>
                    <div class="span-6"><label class="form-label" for="f-team">@Texts.Get("orders.handover-page.f.team")</label><input id="f-team" class="form-control" maxlength="300" @bind="form.ResponsibleTeam" /></div>
                    <div class="span-12"><small class="text-muted">@Texts.Get("orders.handover-page.responsible-note")</small></div>
                </div>
                </TabPanel>
                <TabPanel State="tabs" Key="form-belge">
                <div class="form-grid">
                    <div class="span-12"><label class="form-label" for="f-docs">@Texts.Get("orders.handover-page.f.documents")</label><textarea id="f-docs" class="form-control" rows="2" maxlength="4000" @bind="form.RequiredDocuments"></textarea></div>
                    <div class="span-12"><label class="form-label" for="f-pre">@Texts.Get("orders.handover-page.f.prerequisites")</label><textarea id="f-pre" class="form-control" rows="2" maxlength="4000" @bind="form.CustomerPrerequisites"></textarea></div>
                    <div class="span-12"><label class="form-label" for="f-pay">@Texts.Get("orders.handover-page.f.payment")</label><textarea id="f-pay" class="form-control" rows="2" maxlength="4000" @bind="form.PaymentConditions"></textarea></div>
                    <div class="span-12"><label class="form-label" for="f-risks">@Texts.Get("orders.handover-page.f.risks")</label><textarea id="f-risks" class="form-control" rows="2" maxlength="4000" @bind="form.Risks"></textarea></div>
                    <div class="span-12"><label class="form-label" for="f-special">@Texts.Get("orders.handover-page.f.special")</label><textarea id="f-special" class="form-control" rows="2" maxlength="4000" @bind="form.SpecialRequests"></textarea></div>
                    <div class="span-12"><label class="form-label" for="f-deps">@Texts.Get("orders.handover-page.f.dependencies")</label><textarea id="f-deps" class="form-control" rows="2" maxlength="4000" @bind="form.Dependencies"></textarea></div>
                </div>
                </TabPanel>
                <TabPanel State="tabs" Key="form-kabul">
                <div class="form-grid">
                    <div class="span-12"><label class="form-label" for="f-complete">@Texts.Get("orders.handover-page.f.completion")</label><textarea id="f-complete" class="form-control" rows="2" maxlength="4000" @bind="form.CompletionCriteria"></textarea></div>
                    <div class="span-12"><label class="form-label" for="f-accept">@Texts.Get("orders.handover-page.f.acceptance")</label><textarea id="f-accept" class="form-control" rows="2" maxlength="4000" @bind="form.AcceptanceCriteria"></textarea></div>
                </div>
                </TabPanel>
            </fieldset>
            @if (Editable)
            {
                <div class="form-actions"><button type="submit" class="btn btn-primary" disabled="@busy">@Texts.Get("orders.handover-page.save")</button></div>
            }
        </form>

        <section aria-labelledby="checklist-title">
            <h2 id="checklist-title">@Texts.Get("orders.handover-page.checklist")</h2>
            <ul class="list-unstyled">
                @foreach (var item in detail.Items)
                {
                    <li class="form-check">
                        <input class="form-check-input" type="checkbox" id="item-@item.Id" checked="@item.IsDone" disabled="@(!Editable || busy)" @onchange="e => ToggleAsync(item, (bool)e.Value!)" />
                        <label class="form-check-label" for="item-@item.Id">@item.Text@(item.IsRequired ? null : Texts.Get("orders.handover-page.optional"))</label>
                        @if (item.IsDone && item.DoneAt is { } doneAt) { <small class="text-muted"> · @Lookups.MemberName(item.DoneBy), @CrmLabels.Time(doneAt)</small> }
                        @if (Editable && !item.IsDefault)
                        {
                            <button type="button" class="btn btn-link btn-sm" disabled="@busy" @onclick="() => DeleteItemAsync(item)">@Texts.Get("common.delete")</button>
                        }
                    </li>
                }
            </ul>
            @if (Editable)
            {
                <form class="search" novalidate @onsubmit="AddItemAsync" @onsubmit:preventDefault>
                    <label class="visually-hidden" for="new-item">@Texts.Get("orders.handover-page.new-item")</label>
                    <input id="new-item" class="form-control" maxlength="300" placeholder="@Texts.Get("orders.handover-page.new-item-placeholder")" @bind="newItem" />
                    <button type="submit" class="btn btn-outline-secondary" disabled="@(busy || string.IsNullOrWhiteSpace(newItem))">@Texts.Get("orders.handover-page.add-item")</button>
                </form>
            }
        </section>

        <section aria-labelledby="handover-history-title">
            <h2 id="handover-history-title">@Texts.Get("orders.handover-page.history")</h2>
            <ol class="history-list">
                @foreach (var e in detail.History)
                {
                    <li>
                        <strong>@HistoryLabel(e.Kind)</strong>@(e.Round > 0 ? Texts.Get("orders.handover-page.round-note", e.Round) : null)
                        <span class="text-muted"> · @CrmLabels.Time(e.At) · @(Lookups.MemberName(e.ActorId) is { Length: > 0 } actor ? actor : Texts.Get("orders.change.system"))</span>
                        @if (!string.IsNullOrEmpty(e.Note)) { <div>@e.Note</div> }
                    </li>
                }
            </ol>
        </section>
    }
</AuthGate>

@code {
    [Parameter] public Guid OrderId { get; set; }

    private OrderDto? order;
    private HandoverDetailDto? detail;
    private HandoverActionDto? selected;
    private IReadOnlyDictionary<string, string[]>? errors;

    // Her kayıt formu sekmelidir; hatalı alan içeren sekme "!" rozeti taşır, kayıt denemesinden sonra hatalı ilk sekme açılır.
    private readonly TabState tabs = new("form-kapsam");

    private int ErrorCount(params string[] fields) => errors is null ? 0 : fields.Count(errors.ContainsKey);

    private IReadOnlyList<TabItem> FormTabs =>
    [
        new("form-kapsam", Texts.Get("orders.handover-page.tab.scope"), Errors: ErrorCount("scope", "outOfScope", "deliverables", "commitments")),
        new("form-lokasyon", Texts.Get("orders.handover-page.tab.location"), Errors: ErrorCount("location", "contactName", "contactPhone", "contactEmail")),
        new("form-tarih", Texts.Get("orders.handover-page.tab.dates"), Errors: ErrorCount("targetStartDate", "targetEndDate", "priority", "responsibleUserId", "responsibleTeam")),
        new("form-belge", Texts.Get("orders.handover-page.tab.documents"), Errors: ErrorCount("requiredDocuments", "customerPrerequisites", "paymentConditions", "risks", "specialRequests", "dependencies")),
        new("form-kabul", Texts.Get("orders.handover-page.tab.acceptance"), Errors: ErrorCount("completionCriteria", "acceptanceCriteria")),
    ];
    private string? notice;
    private bool failed;
    private bool loading = true;
    private bool notFoundOrder;
    private bool busy;
    private string note = string.Empty;
    private string? noteError;
    private string newItem = string.Empty;
    private Guid? responsible;
    private Form form = new();

    private bool Editable => detail is not null && Session.Can(OrderHandoverAccess.HandoversWrite) && detail.Handover.Status is "Preparing" or "Ready" or "InfoRequested";

    private sealed class Form
    {
        public string? Scope { get; set; }
        public string? OutOfScope { get; set; }
        public string? Deliverables { get; set; }
        public string? Commitments { get; set; }
        public string? Location { get; set; }
        public string? ContactName { get; set; }
        public string? ContactPhone { get; set; }
        public string? ContactEmail { get; set; }
        public DateOnly? TargetStartDate { get; set; }
        public DateOnly? TargetEndDate { get; set; }
        public string Priority { get; set; } = "Normal";
        public string? RequiredDocuments { get; set; }
        public string? CustomerPrerequisites { get; set; }
        public string? PaymentConditions { get; set; }
        public string? Risks { get; set; }
        public string? SpecialRequests { get; set; }
        public string? Dependencies { get; set; }
        public Guid? ResponsibleUserId { get; set; }
        public string? ResponsibleTeam { get; set; }
        public string? CompletionCriteria { get; set; }
        public string? AcceptanceCriteria { get; set; }
    }

    protected override async Task OnParametersSetAsync()
    {
        await Session.EnsureLoadedAsync();
        if (!Session.Can(OrdersAccess.OrdersRead))
        {
            return;
        }

        await Lookups.LoadAsync();
        var orderResult = await Api.GetAsync<OrderDto>($"/api/orders/orders/{OrderId}");
        if (!orderResult.IsSuccess)
        {
            notFoundOrder = true;
            loading = false;
            return;
        }

        order = orderResult.Value;
        await LoadAsync();
        loading = false;
    }

    private async Task LoadAsync()
    {
        var result = await Api.GetAsync<HandoverDetailDto>($"/api/orders/orders/{OrderId}/handover");
        detail = result.IsSuccess ? result.Value : null;
        if (detail is not null)
        {
            var h = detail.Handover;
            form = new Form
            {
                Scope = h.Scope, OutOfScope = h.OutOfScope, Deliverables = h.Deliverables, Commitments = h.Commitments, Location = h.Location, ContactName = h.ContactName,
                ContactPhone = h.ContactPhone, ContactEmail = h.ContactEmail, TargetStartDate = h.TargetStartDate, TargetEndDate = h.TargetEndDate, Priority = h.Priority,
                RequiredDocuments = h.RequiredDocuments, CustomerPrerequisites = h.CustomerPrerequisites, PaymentConditions = h.PaymentConditions, Risks = h.Risks,
                SpecialRequests = h.SpecialRequests, Dependencies = h.Dependencies, ResponsibleUserId = h.ResponsibleUserId, ResponsibleTeam = h.ResponsibleTeam,
                CompletionCriteria = h.CompletionCriteria, AcceptanceCriteria = h.AcceptanceCriteria,
            };
        }
    }

    private async Task CreateAsync()
    {
        busy = true;
        var result = await Api.PostAsync<HandoverDetailDto>($"/api/orders/orders/{OrderId}/handover", new { });
        busy = false;
        failed = !result.IsSuccess;
        notice = result.IsSuccess ? Texts.Get("orders.handover-page.created") : result.Error;
        await LoadAsync();
    }

    private async Task SaveAsync()
    {
        if (busy || detail is null) { return; }
        busy = true;
        errors = null;
        var f = form;
        var request = new SaveHandoverRequest(
            detail.Handover.Version, f.Scope, f.OutOfScope, f.Deliverables, f.Commitments, f.Location, f.ContactName, f.ContactPhone, f.ContactEmail, f.TargetStartDate, f.TargetEndDate,
            f.Priority, f.RequiredDocuments, f.CustomerPrerequisites, f.PaymentConditions, f.Risks, f.SpecialRequests, f.Dependencies, f.ResponsibleUserId, f.ResponsibleTeam,
            f.CompletionCriteria, f.AcceptanceCriteria);
        var result = await Api.PutAsync<HandoverDto>($"/api/orders/handovers/{detail.Handover.Id}", request);
        busy = false;
        failed = !result.IsSuccess;
        errors = result.FieldErrors;
        tabs.RevealFirstFailing(FormTabs);
        notice = result.IsSuccess ? Texts.Get("orders.handover-page.saved") : result.Error;
        await LoadAsync();
    }

    private async Task ToggleAsync(HandoverItemDto item, bool done)
    {
        if (busy || detail is null) { return; }
        busy = true;
        var result = await Api.PutAsync<HandoverItemDto>($"/api/orders/handover-items/{item.Id}", new SaveHandoverItemRequest(detail.Handover.Id, item.Text, done, item.Note, item.Version));
        busy = false;
        failed = !result.IsSuccess;
        notice = result.IsSuccess ? null : result.Error;
        await LoadAsync();
    }

    private async Task AddItemAsync()
    {
        if (busy || detail is null || string.IsNullOrWhiteSpace(newItem)) { return; }
        busy = true;
        var result = await Api.PostAsync<HandoverItemDto>("/api/orders/handover-items", new SaveHandoverItemRequest(detail.Handover.Id, newItem.Trim()));
        busy = false;
        failed = !result.IsSuccess;
        notice = result.IsSuccess ? Texts.Get("orders.handover-page.item-added") : result.Error;
        if (result.IsSuccess) { newItem = string.Empty; }
        await LoadAsync();
    }

    private async Task DeleteItemAsync(HandoverItemDto item)
    {
        if (busy) { return; }
        busy = true;
        var result = await Api.DeleteAsync($"/api/orders/handover-items/{item.Id}?version={item.Version}");
        busy = false;
        failed = !result.IsSuccess;
        notice = result.IsSuccess ? Texts.Get("orders.handover-page.item-deleted") : result.Error;
        await LoadAsync();
    }

    private async Task Choose(HandoverActionDto action)
    {
        note = string.Empty;
        noteError = null;
        responsible = null;
        selected = selected?.Action == action.Action ? null : action;
        if (selected is { RequiresNote: false } && action.Action == "send")
        {
            await RunAsync();
        }
    }

    private async Task RunAsync()
    {
        if (busy || detail is null || selected is not { } action) { return; }
        if (action.RequiresNote && string.IsNullOrWhiteSpace(note))
        {
            noteError = Texts.Get(action.Action == "request-info" ? "orders.handover-page.info-required" : "orders.handover-page.resubmit-required");
            return;
        }

        busy = true;
        var result = await Api.PostAsync<HandoverDetailDto>($"/api/orders/handovers/{detail.Handover.Id}/{action.Action}",
            new HandoverActionRequest(detail.Handover.Version, string.IsNullOrWhiteSpace(note) ? null : note.Trim(), responsible));
        busy = false;
        failed = !result.IsSuccess;
        notice = result.IsSuccess ? Texts.Get("orders.handover-page.action-done", ActionLabel(action, detail.Handover.Status)) : result.Error;
        selected = null;
        var refreshed = await Api.GetAsync<OrderDto>($"/api/orders/orders/{OrderId}");
        order = refreshed.Value ?? order;
        await LoadAsync();
    }

    private static string ActionLabel(HandoverActionDto action, string status) => action.Action switch
    {
        "send" => Texts.Get(status == "InfoRequested" ? "orders.handover-page.action.resend" : "orders.handover-page.action.send"),
        "request-info" => Texts.Get("orders.handover-page.action.request-info"),
        "accept" => Texts.Get("orders.handover-page.action.accept"),
        _ => action.Action,
    };

    private static string NoteLabel(HandoverActionDto action) => action.Action switch
    {
        "request-info" => Texts.Get("orders.handover-page.note.request-info"),
        "send" => Texts.Get("orders.handover-page.note.send"),
        _ => Texts.Get("orders.handover-page.note.accept"),
    };

    private static string HistoryLabel(string kind) => kind switch
    {
        "Created" => Texts.Get("orders.handover-page.history.created"),
        "Sent" => Texts.Get("orders.handover-page.history.sent"),
        "Resubmitted" => Texts.Get("orders.handover-page.history.resubmitted"),
        "InfoRequested" => Texts.Get("orders.handover-page.history.inforequested"),
        "Accepted" => Texts.Get("orders.handover-page.history.accepted"),
        "WaitingEscalated" => Texts.Get("orders.handover-page.history.waitingescalated"),
        _ => kind,
    };
}
