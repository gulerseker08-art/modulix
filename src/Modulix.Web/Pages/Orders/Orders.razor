@page "/siparisler"
@inject ApiClient Api
@inject SessionState Session
@inject CrmLookups Lookups

<PageTitle>@Texts.Get("orders.list.title") · Modulix</PageTitle>

<AuthGate Module="@OrdersAccess.ModuleKey" Permission="@OrdersAccess.OrdersRead">
    <div class="page-header">
        <div>
            <h1>@Texts.Get("orders.list.title")</h1>
            <p class="text-muted mb-0">@Texts.Get("orders.list.intro")</p>
        </div>
    </div>

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message <button type="button" class="btn btn-sm btn-outline-secondary ms-2" @onclick="() => LoadAsync(1)">@Texts.Get("orders.list.retry")</button></div>
    }

    <ViewTabs Items="ViewOptions" Value="@viewKey" ValueChanged="ChooseViewAsync" Label="@Texts.Get("orders.list.views")" NewView="StartNaming" />

    <div class="list-toolbar">
        <form class="search" @onsubmit="() => LoadAsync(1)" @onsubmit:preventDefault>
            <label class="visually-hidden" for="order-search">@Texts.Get("orders.list.search-label")</label>
            <input id="order-search" class="form-control" type="search" placeholder="@Texts.Get("orders.list.search-placeholder")" @bind="search" />
        </form>
        <FilterToggle @bind-Open="filtersOpen" Count="ActiveFilters" />
        <GridColumnPicker State="grid" Changed="@(() => Task.CompletedTask)" />
        @if (Session.Can(OrdersAccess.OrdersCreate))
        {
            <a class="btn btn-primary" href="crm/teklifler"><AppIcon Name="plus" Size="16" /> @Texts.Get("orders.list.pick-quote")</a>
        }
    </div>

    @if (filtersOpen || ActiveFilters > 0)
    {
        <div class="filters">
            <label class="visually-hidden" for="status-filter">@Texts.Get("orders.list.status-filter")</label>
            <select id="status-filter" class="form-select form-select-sm filter-select" @bind="status" @bind:after="() => LoadAsync(1)">
                <option value="">@Texts.Get("common.allStatuses")</option>
                @foreach (var s in OrderLabels.Statuses)
                {
                    <option value="@s.Key">@s.Label</option>
                }
            </select>
        </div>
    }

    <PersonalViewBar Active="Active" Dirty="Dirty" Naming="views.Naming" NamingChanged="views.StartNaming" Error="@views.Error"
                     SaveAs="SaveAsAsync" UpdateView="UpdateViewAsync" DiscardChanges="DiscardAsync" DeleteView="DeleteViewAsync" />

    @if (page is null && message is null)
    {
        <p class="text-muted" role="status">@Texts.Get("common.loading")</p>
    }
    else if (page is not null && page.Items.Count == 0)
    {
        <p class="text-muted" role="status">@Texts.Get("orders.list.empty")@(Session.Can(OrdersAccess.OrdersCreate) ? Texts.Get("orders.list.empty-hint") : null)</p>
    }
    else if (page is not null)
    {
        <p class="visually-hidden" role="status" aria-live="polite">@Texts.Get("orders.list.listed", page.TotalCount)</p>
        <table class="table record-table">
            <caption class="visually-hidden">@Texts.Get("orders.dashboard.list-link")</caption>
            <thead>
                <tr>
                    @foreach (var column in grid.VisibleColumns)
                    {
                        <GridHeader Column="column" State="grid" SortChanged="SortAsync" Class="@(column.Key == "total" ? "text-end" : null)" />
                    }
                    <th scope="col" class="row-menu-cell"><span class="visually-hidden">@Texts.Get("common.actions")</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var o in page.Items)
                {
                    <tr>
                        @foreach (var column in grid.VisibleColumns)
                        {
                            @Cell(column, o)
                        }
                        <td class="row-menu-cell">
                            <RowMenu Label="@Texts.Get("common.rowActionsOf", o.Number)">
                                <a class="view-menu-item" role="menuitem" href="siparisler/@o.Id"><AppIcon Name="eye" Size="16" /> <span>@Texts.Get("common.open")</span></a>
                            </RowMenu>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager PageSizeChoice="true" Page="page.Page" PageSize="page.PageSize" TotalCount="page.TotalCount" PageChanged="LoadAsync" />
    }
</AuthGate>

@code {
    private bool filtersOpen;

    /// <summary>Etkin süzgeç sayısı ("Filtrele" rozeti); süzgeç satırı etkin süzgeç varken açık kalır.</summary>
    private int ActiveFilters => (string.IsNullOrEmpty(status) ? 0 : 1);

    private const string DefaultSort = "-createdAt";
    private const string AllViews = "all";

    /// <summary>Hızlı görünümler; her biri sunucudaki süzgeçlerden birine karşılık gelir.</summary>
    private static (string Key, string Label, string Icon)[] Presets =>
    [
        ("mine", Texts.Get("orders.list.view.mine"), "star"), ("draft", Texts.Get("orders.list.view.draft"), "pencil"), ("handover", Texts.Get("orders.list.view.handover"), "repeat"),
        ("overdue", Texts.Get("orders.list.view.overdue"), "clock"), ("partial", Texts.Get("orders.list.view.partial"), "package"),
    ];

    // Sıralama sunucudaki sort anahtarlarıdır; Sipariş sütunu numaraya göre sıralanır.
    private static GridColumnDef[] Columns =>
    [
        new("order", Texts.Get("orders.col.order"), "file-text", "number", "-number", Locked: true),
        new("customer", Texts.Get("orders.list.col.customer"), "building"),
        new("quote", Texts.Get("orders.list.col.quote"), "file-text"),
        new("statuses", Texts.Get("orders.list.col.statuses"), "tag"),
        new("delivery", Texts.Get("orders.list.col.delivery"), "calendar", "deliveryDate", "-deliveryDate"),
        new("total", Texts.Get("orders.col.amount"), "coins"),
        new("owner", Texts.Get("common.field.owner"), "user"),
        new("contract", Texts.Get("orders.list.col.contract"), "file-text", DefaultVisible: false),
        new("location", Texts.Get("orders.list.col.location"), "map-pin", DefaultVisible: false),
    ];

    /// <summary>Özet panosundan gelen bağlantılar: <c>?gorunum=handover</c>, <c>?durum=PendingApproval</c>.</summary>
    [SupplyParameterFromQuery(Name = "gorunum")] public string? InitialView { get; set; }

    [SupplyParameterFromQuery(Name = "durum")] public string? InitialStatus { get; set; }

    private readonly GridViewState grid = new("orders.orders", DefaultSort);
    private PersonalGridViews views = default!;
    private PagedResult<OrderDto>? page;
    private string? message;
    private string? view;
    private string viewKey = AllViews;
    private string? status;
    private string search = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        views = new PersonalGridViews(Api, "orders.orders");
        grid.Define(Columns);
        await Session.EnsureLoadedAsync();
        if (Session.Can(OrdersAccess.OrdersRead))
        {
            await Lookups.LoadAsync();
            await views.LoadAsync();
            if (InitialView is not null && Presets.Any(p => p.Key == InitialView)) { view = InitialView; viewKey = InitialView; }
            if (InitialStatus is not null && OrderLabels.Statuses.Any(x => x.Key == InitialStatus)) { status = InitialStatus; }
            await LoadAsync(1);
        }
    }

    private GridViewDto? Active => views.Find(viewKey);

    // Kaydedilmemiş değişiklik: sütunlar ve sıralama (süzgeç görünüm seçilince belirlenir).
    private bool Dirty => grid.Differs(Active);

    private IReadOnlyList<ViewOption> ViewOptions =>
    [
        new(AllViews, Texts.Get("orders.list.view.all"), Icon: "file-text"),
        .. Presets.Select(p => new ViewOption(p.Key, p.Label, Icon: p.Icon)),
        .. views.Options,
    ];

    private async Task ChooseViewAsync(string key)
    {
        viewKey = key;
        views.StartNaming(false);
        if (Active is { } saved)
        {
            // Kişisel görünüm: sütunlar, sıralama ve süzgeç (görünüm + durum) birlikte gelir.
            grid.Apply(saved);
            var filters = GridFilters.Parse(saved.Filters);
            var preset = filters.GetValueOrDefault("view");
            view = preset is not null && Presets.Any(p => p.Key == preset) ? preset : null;
            status = filters.GetValueOrDefault("status");
        }
        else
        {
            grid.Reset();
            view = key == AllViews ? null : key;
        }

        await LoadAsync(1);
    }

    private Task SortAsync(string key)
    {
        grid.Sort = key;
        return LoadAsync(1);
    }

    private string? CurrentFilters => GridFilters.Build(view is { } v ? ("view", v) : null, status is { Length: > 0 } s ? ("status", s) : null);

    private void StartNaming() => views.StartNaming(true);

    private async Task SaveAsAsync(string name)
    {
        if (await views.SaveAsAsync(grid.ToRequest(name, CurrentFilters)) is { } key)
        {
            viewKey = key;
        }
    }

    private async Task UpdateViewAsync()
    {
        if (Active is { } current)
        {
            await views.UpdateAsync(current, grid.ToRequest(current.Name, CurrentFilters));
        }
    }

    private async Task DiscardAsync() => await ChooseViewAsync(viewKey);

    private async Task DeleteViewAsync()
    {
        if (Active is { } current && await views.DeleteAsync(current))
        {
            await ChooseViewAsync(AllViews);
        }
    }

    private string Query(int pageNumber)
    {
        var parts = new List<string> { $"page={pageNumber}&pageSize={ListPaging.Size}" };
        if (!string.IsNullOrWhiteSpace(search)) { parts.Add($"search={Uri.EscapeDataString(search.Trim())}"); }
        switch (view)
        {
            case "mine": parts.Add("ownerId=me"); break;
            case "draft": if (string.IsNullOrEmpty(status)) { parts.Add("status=Draft"); } break;
            case "handover": parts.Add("handoverPending=true"); break;
            case "overdue": parts.Add("overdue=true"); break;
            case "partial": parts.Add("fulfillmentStatus=Partial"); break;
        }

        if (!string.IsNullOrEmpty(status)) { parts.Add($"status={Uri.EscapeDataString(status)}"); }
        if (grid.Sort != DefaultSort) { parts.Add($"sort={Uri.EscapeDataString(grid.Sort)}"); }
        return string.Join('&', parts);
    }

    private async Task LoadAsync(int pageNumber)
    {
        var result = await Api.GetAsync<PagedResult<OrderDto>>($"/api/orders/orders?{Query(pageNumber)}");
        page = result.Value;
        message = result.IsSuccess ? null : result.Error;
    }

    private RenderFragment Cell(GridColumnDef column, OrderDto o) => @<td data-label="@column.Label" class="@(column.Key == "order" ? "primary" : column.Key == "total" ? "text-end" : null)">@CellContent(column.Key, o)</td>;

    private RenderFragment CellContent(string key, OrderDto o) => key switch
    {
        "order" => @<text><a href="siparisler/@o.Id">@o.Title</a> <small class="text-muted">@o.Number</small></text>,
        "customer" => @<text>@(o.CustomerName ?? "—")</text>,
        "quote" => @<a href="crm/teklifler/@o.SourceQuoteId">@o.SourceQuoteNumber · V@(o.SourceQuoteRevisionNo)</a>,
        "statuses" => @<text>
            <span class="badge stage-@OrderLabels.StatusBadge(o.Status)">@OrderLabels.Label(OrderLabels.Statuses, o.Status)</span>
            <span class="badge stage-@OrderLabels.HandoverBadge(o.HandoverStatus)">@OrderLabels.Label(OrderLabels.Handovers, o.HandoverStatus)</span>
            <span class="badge stage-@OrderLabels.FulfillmentBadge(o.FulfillmentStatus)">@OrderLabels.Label(OrderLabels.Fulfillments, o.FulfillmentStatus)</span>
        </text>,
        "delivery" => @<text>@OrderLabels.Date(o.PlannedDeliveryDate)</text>,
        "total" => @<text>@OrderLabels.Money(o.GrossTotal, o.Currency)</text>,
        "owner" => @<text>@Lookups.MemberName(o.OwnerId)</text>,
        "contract" => @<text>@(o.ContractNumber ?? "—")</text>,
        "location" => @<text>@o.Location</text>,
        _ => @<text></text>,
    };
}
