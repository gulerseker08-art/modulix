@page "/siparisler"
@inject ApiClient Api
@inject SessionState Session
@inject CrmLookups Lookups

<PageTitle>Siparişler · Modulix</PageTitle>

<AuthGate Module="@OrdersAccess.ModuleKey" Permission="@OrdersAccess.OrdersRead">
    <div class="page-header">
        <div>
            <h1>Siparişler</h1>
            <p class="text-muted mb-0">Siparişler kabul edilmiş tekliften oluşur. Tutarlar her siparişin kendi para birimindedir; farklı para birimleri toplanmaz. Sipariş tutarı tahsilat ya da gelir değildir.</p>
        </div>
    </div>

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message <button type="button" class="btn btn-sm btn-outline-secondary ms-2" @onclick="() => LoadAsync(1)">Tekrar dene</button></div>
    }

    <div class="list-toolbar">
        <ViewSelector Items="ViewOptions" Value="@(view ?? AllViews)" ValueChanged="ChooseViewAsync" />
        <form class="search" @onsubmit="() => LoadAsync(1)" @onsubmit:preventDefault>
            <label class="visually-hidden" for="order-search">Sipariş ara</label>
            <input id="order-search" class="form-control" type="search" placeholder="Başlık, sipariş no, teklif no veya müşteri ara" @bind="search" />
            <button type="submit" class="btn btn-outline-secondary">Ara</button>
        </form>
        <FilterToggle @bind-Open="filtersOpen" Count="ActiveFilters" />
        <ColumnPicker />
        @if (Session.Can(OrdersAccess.OrdersCreate))
        {
            <a class="btn btn-primary" href="crm/teklifler"><AppIcon Name="plus" Size="16" /> Teklif seç</a>
        }
    </div>

    @if (filtersOpen || ActiveFilters > 0)
    {
        <div class="filters">
            <label class="visually-hidden" for="status-filter">Sipariş durumu</label>
            <select id="status-filter" class="form-select form-select-sm filter-select" @bind="status" @bind:after="() => LoadAsync(1)">
                <option value="">Tüm durumlar</option>
                @foreach (var s in OrderLabels.Statuses)
                {
                    <option value="@s.Key">@s.Label</option>
                }
            </select>
            <label class="visually-hidden" for="sort-select">Sıralama</label>
            <select id="sort-select" class="form-select form-select-sm filter-select" @bind="sort" @bind:after="() => LoadAsync(1)">
                @foreach (var (key, label) in OrderLabels.Sorts)
                {
                    <option value="@key">Sıralama: @label</option>
                }
            </select>
        </div>
    }

    @if (page is null && message is null)
    {
        <p class="text-muted" role="status">Yükleniyor…</p>
    }
    else if (page is not null && page.Items.Count == 0)
    {
        <p class="text-muted" role="status">Bu süzgece uyan sipariş yok.@(Session.Can(OrdersAccess.OrdersCreate) ? " Kabul edilmiş bir teklifin sayfasından sipariş oluşturabilirsiniz." : null)</p>
    }
    else if (page is not null)
    {
        <p class="visually-hidden" role="status" aria-live="polite">@(page.TotalCount) sipariş listelendi.</p>
        <table class="table record-table">
            <caption class="visually-hidden">Sipariş listesi</caption>
            <thead>
                <tr>
                    <th scope="col">Sipariş</th><th scope="col">Müşteri</th><th scope="col">Teklif</th><th scope="col">Durumlar</th>
                    <th scope="col">Planlanan teslim</th><th scope="col" class="text-end">Tutar</th><th scope="col">Sorumlu</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var o in page.Items)
                {
                    <tr>
                        <td data-label="Sipariş" class="primary">
                            <a href="siparisler/@o.Id">@o.Title</a>
                            <small class="text-muted">@o.Number</small>
                        </td>
                        <td data-label="Müşteri">@(o.CustomerName ?? "—")</td>
                        <td data-label="Teklif"><a href="crm/teklifler/@o.SourceQuoteId">@o.SourceQuoteNumber · V@(o.SourceQuoteRevisionNo)</a></td>
                        <td data-label="Durumlar">
                            <span class="badge stage-@OrderLabels.StatusBadge(o.Status)">@OrderLabels.Label(OrderLabels.Statuses, o.Status)</span>
                            <span class="badge stage-@OrderLabels.HandoverBadge(o.HandoverStatus)">@OrderLabels.Label(OrderLabels.Handovers, o.HandoverStatus)</span>
                            <span class="badge stage-@OrderLabels.FulfillmentBadge(o.FulfillmentStatus)">@OrderLabels.Label(OrderLabels.Fulfillments, o.FulfillmentStatus)</span>
                        </td>
                        <td data-label="Planlanan teslim">@OrderLabels.Date(o.PlannedDeliveryDate)</td>
                        <td data-label="Tutar" class="text-end">@OrderLabels.Money(o.GrossTotal, o.Currency)</td>
                        <td data-label="Sorumlu">@Lookups.MemberName(o.OwnerId)</td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager Page="page.Page" PageSize="page.PageSize" TotalCount="page.TotalCount" PageChanged="LoadAsync" />
    }
</AuthGate>

@code {
    private bool filtersOpen;

    /// <summary>Etkin süzgeç sayısı ("Filtrele" rozeti); süzgeç satırı etkin süzgeç varken açık kalır.</summary>
    private int ActiveFilters => (string.IsNullOrEmpty(status) ? 0 : 1);

    private const string DefaultSort = "-createdAt";

    /// <summary>Hızlı görünümler; her biri sunucudaki süzgeçlerden birine karşılık gelir.</summary>
    private static readonly (string Key, string Label)[] Presets =
    [
        ("mine", "Benim siparişlerim"), ("draft", "Taslaklar"), ("handover", "Devir bekleyenler"), ("overdue", "Gecikenler"), ("partial", "Kısmen gerçekleşenler"),
    ];

    /// <summary>Özet panosundan gelen bağlantılar: <c>?gorunum=handover</c>, <c>?durum=PendingApproval</c>.</summary>
    [SupplyParameterFromQuery(Name = "gorunum")] public string? InitialView { get; set; }

    [SupplyParameterFromQuery(Name = "durum")] public string? InitialStatus { get; set; }

    private PagedResult<OrderDto>? page;
    private string? message;
    private string? view;
    private string? status;
    private string sort = DefaultSort;
    private string search = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (Session.Can(OrdersAccess.OrdersRead))
        {
            await Lookups.LoadAsync();
            if (InitialView is not null && Presets.Any(p => p.Key == InitialView)) { view = InitialView; }
            if (InitialStatus is not null && OrderLabels.Statuses.Any(x => x.Key == InitialStatus)) { status = InitialStatus; }
            await LoadAsync(1);
        }
    }

    private const string AllViews = "all";

    private IReadOnlyList<ViewOption> ViewOptions => [new(AllViews, "Tüm siparişler"), .. Presets.Select(p => new ViewOption(p.Key, p.Label))];

    private async Task ChooseViewAsync(string key)
    {
        view = key == AllViews ? null : key;
        await LoadAsync(1);
    }

    private string Query(int pageNumber)
    {
        var parts = new List<string> { $"page={pageNumber}" };
        if (!string.IsNullOrWhiteSpace(search)) { parts.Add($"search={Uri.EscapeDataString(search.Trim())}"); }
        switch (view)
        {
            case "mine": parts.Add("ownerId=me"); break;
            case "draft": if (string.IsNullOrEmpty(status)) { parts.Add("status=Draft"); } break;
            case "handover": parts.Add("handoverPending=true"); break;
            case "overdue": parts.Add("overdue=true"); break;
            case "partial": parts.Add("fulfillmentStatus=Partial"); break;
        }

        if (!string.IsNullOrEmpty(status)) { parts.Add($"status={Uri.EscapeDataString(status)}"); }
        if (sort != DefaultSort) { parts.Add($"sort={Uri.EscapeDataString(sort)}"); }
        return string.Join('&', parts);
    }

    private async Task LoadAsync(int pageNumber)
    {
        var result = await Api.GetAsync<PagedResult<OrderDto>>($"/api/orders/orders?{Query(pageNumber)}");
        page = result.Value;
        message = result.IsSuccess ? null : result.Error;
    }
}
