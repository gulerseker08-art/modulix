@page "/siparisler/ozet"
@inject ApiClient Api
@inject SessionState Session

<PageTitle>Sipariş panosu · Modulix</PageTitle>

<AuthGate Module="@OrdersAccess.ModuleKey" Permission="@OrdersAccess.OrdersRead">
    <div class="page-header">
        <h1>Sipariş panosu</h1>
        <div class="header-actions">
            <a class="btn btn-outline-secondary" href="siparisler">Sipariş listesi</a>
            <a class="btn btn-outline-secondary" href="siparisler/isler">Operasyon işleri</a>
        </div>
    </div>
    <p class="text-muted">
        Yalnızca görebildiğiniz siparişler ve işler sayılır; kutular tıklanınca aynı süzgeçle listeyi açar. Göstergeler sayıdır: sipariş tutarı toplanmaz,
        gelir ya da tahsilat sayılmaz.
    </p>

    <Notice Text="@error" Failed="true" />

    @if (summary is null && error is null)
    {
        <LoadingState />
    }
    else if (summary is not null)
    {
        <section aria-labelledby="orders-counts-title">
            <h2 id="orders-counts-title">Siparişler</h2>
            <div class="stat-grid">
                <a class="stat-card" href="siparisler?gorunum=handover" aria-label="Devir bekleyen sipariş: @summary.HandoverPending"><span>Devir bekleyen</span><strong>@Count(summary.HandoverPending)</strong></a>
                <a class="stat-card" href="siparisler?durum=PendingApproval" aria-label="Onay bekleyen sipariş: @summary.PendingApproval"><span>Onay bekleyen</span><strong>@Count(summary.PendingApproval)</strong></a>
                <a class="stat-card" href="siparisler?gorunum=partial" aria-label="Kısmen gerçekleşen sipariş: @summary.PartiallyFulfilled"><span>Kısmen gerçekleşen</span><strong>@Count(summary.PartiallyFulfilled)</strong></a>
                <a class="stat-card" href="siparisler?gorunum=overdue" aria-label="Geciken sipariş: @summary.OverdueOrders"><span>Geciken (planlanan teslim geçti)</span><strong>@Count(summary.OverdueOrders)</strong></a>
            </div>
            <p class="mt-2">
                <strong>Ortalama devir kabul süresi:</strong>&nbsp;
                @if (summary.AverageHandoverAcceptanceHours is { } hours)
                {
                    <span>@FormatHours(hours) <span class="text-muted">(ilk gönderimden kabule; son @summary.HandoverAcceptanceSample kabul edilen devir)</span></span>
                }
                else
                {
                    <span class="text-muted">Henüz kabul edilen devir yok.</span>
                }
            </p>
        </section>

        <section aria-labelledby="ops-counts-title">
            <h2 id="ops-counts-title">Operasyon</h2>
            <div class="stat-grid">
                <a class="stat-card" href="siparisler/isler?gorunum=unassigned" aria-label="Atanmamış iş: @summary.UnassignedJobs"><span>Atanmamış iş</span><strong>@Count(summary.UnassignedJobs)</strong></a>
                <a class="stat-card" href="siparisler/isler?gorunum=overdue" aria-label="Geciken iş: @summary.OverdueJobs"><span>Geciken iş</span><strong>@Count(summary.OverdueJobs)</strong></a>
                <div class="stat-card" role="group" aria-label="Açık teslimat: @summary.OpenDeliveries"><span>Açık (planlı) teslimat</span><strong>@Count(summary.OpenDeliveries)</strong></div>
                <div class="stat-card" role="group" aria-label="Geciken teslimat: @summary.OverdueDeliveries"><span>Geciken teslimat</span><strong>@Count(summary.OverdueDeliveries)</strong></div>
                <div class="stat-card" role="group" aria-label="Geciken hizmet başlangıcı: @summary.OverdueServiceStarts"><span>Geciken hizmet başlangıcı</span><strong>@Count(summary.OverdueServiceStarts)</strong></div>
            </div>
        </section>

        <section aria-labelledby="late-title">
            <h2 id="late-title">Geciken teslimat ve hizmet başlangıçları</h2>
            @if (lateDeliveries.Count == 0 && lateServices.Count == 0)
            {
                <p class="text-muted">Geciken teslimat ya da hizmet başlangıcı yok.</p>
            }
            else
            {
                <ul>
                    @foreach (var d in lateDeliveries)
                    {
                        <li><a href="siparisler/@d.OrderId/teslimat">Teslimat @d.Number</a> <span class="text-muted">· planlanan @OrderLabels.Date(d.PlannedDate)</span></li>
                    }
                    @foreach (var s in lateServices)
                    {
                        <li><a href="siparisler/@s.OrderId/teslimat">Hizmet başlangıcı</a> <span class="text-muted">· planlanan @OrderLabels.Date(s.PlannedStartDate)@(string.IsNullOrEmpty(s.DelayReason) ? null : " · " + s.DelayReason)</span></li>
                    }
                </ul>
                @if (summary.OverdueDeliveries > lateDeliveries.Count || summary.OverdueServiceStarts > lateServices.Count)
                {
                    <p class="small text-muted">Her türden en gecikmiş ilk @Limit kayıt gösterilir.</p>
                }
            }
        </section>
    }
</AuthGate>

@code {
    private const int Limit = 10;

    private OrderSummaryDto? summary;
    private List<DeliveryDto> lateDeliveries = [];
    private List<ServiceStartDto> lateServices = [];
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (!Session.Can(OrdersAccess.OrdersRead)) { return; }

        var result = await Api.GetAsync<OrderSummaryDto>("/api/orders/summary");
        if (!result.IsSuccess)
        {
            error = result.Error ?? "Özet yüklenemedi.";
            return;
        }

        summary = result.Value;
        var deliveries = await Api.GetAsync<PagedResult<DeliveryDto>>($"/api/orders/deliveries?overdue=true&pageSize={Limit}");
        var services = await Api.GetAsync<PagedResult<ServiceStartDto>>($"/api/orders/service-starts?overdue=true&pageSize={Limit}");
        lateDeliveries = [.. deliveries.Value?.Items ?? []];
        lateServices = [.. services.Value?.Items ?? []];
    }

    private static string Count(int value) => value.ToString("N0", Regional.Numbers);

    private static string FormatHours(double hours) =>
        hours < 48 ? $"{hours.ToString("0.#", Regional.Numbers)} saat" : $"{(hours / 24).ToString("0.#", Regional.Numbers)} gün";
}
