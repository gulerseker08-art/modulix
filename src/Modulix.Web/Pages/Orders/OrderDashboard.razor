@page "/siparisler/ozet"
@inject ApiClient Api
@inject SessionState Session

<PageTitle>@Texts.Get("orders.dashboard.title") · Modulix</PageTitle>

<AuthGate Module="@OrdersAccess.ModuleKey" Permission="@OrdersAccess.OrdersRead">
    <div class="page-header">
        <h1>@Texts.Get("orders.dashboard.title")</h1>
        <div class="header-actions">
            <a class="btn btn-outline-secondary" href="siparisler">@Texts.Get("orders.dashboard.list-link")</a>
            <a class="btn btn-outline-secondary" href="siparisler/isler">@Texts.Get("orders.jobs.title")</a>
        </div>
    </div>
    <p class="text-muted">
        @Texts.Get("orders.dashboard.intro")
    </p>

    <Notice Text="@error" Failed="true" />

    @if (summary is null && error is null)
    {
        <p class="text-muted" role="status">@Texts.Get("common.loading")</p>
    }
    else if (summary is not null)
    {
        <section aria-labelledby="orders-counts-title">
            <h2 id="orders-counts-title">@Texts.Get("orders.dashboard.orders")</h2>
            <div class="stat-grid">
                <a class="stat-card" href="siparisler?gorunum=handover" aria-label="@Texts.Get("orders.dashboard.aria.handover", summary.HandoverPending)"><span>@Texts.Get("orders.dashboard.stat.handover")</span><strong>@Count(summary.HandoverPending)</strong></a>
                <a class="stat-card" href="siparisler?durum=PendingApproval" aria-label="@Texts.Get("orders.dashboard.aria.pending", summary.PendingApproval)"><span>@Texts.Get("orders.dashboard.stat.pending")</span><strong>@Count(summary.PendingApproval)</strong></a>
                <a class="stat-card" href="siparisler?gorunum=partial" aria-label="@Texts.Get("orders.dashboard.aria.partial", summary.PartiallyFulfilled)"><span>@Texts.Get("orders.dashboard.stat.partial")</span><strong>@Count(summary.PartiallyFulfilled)</strong></a>
                <a class="stat-card" href="siparisler?gorunum=overdue" aria-label="@Texts.Get("orders.dashboard.aria.overdue", summary.OverdueOrders)"><span>@Texts.Get("orders.dashboard.stat.overdue")</span><strong>@Count(summary.OverdueOrders)</strong></a>
            </div>
            <p class="mt-2">
                <strong>@Texts.Get("orders.dashboard.handover-time")</strong>&nbsp;
                @if (summary.AverageHandoverAcceptanceHours is { } hours)
                {
                    <span>@FormatHours(hours) <span class="text-muted">@Texts.Get("orders.dashboard.handover-time-note", summary.HandoverAcceptanceSample)</span></span>
                }
                else
                {
                    <span class="text-muted">@Texts.Get("orders.dashboard.no-handover")</span>
                }
            </p>
        </section>

        <section aria-labelledby="ops-counts-title">
            <h2 id="ops-counts-title">@Texts.Get("orders.dashboard.operations")</h2>
            <div class="stat-grid">
                <a class="stat-card" href="siparisler/isler?gorunum=unassigned" aria-label="@Texts.Get("orders.dashboard.aria.unassigned", summary.UnassignedJobs)"><span>@Texts.Get("orders.dashboard.stat.unassigned")</span><strong>@Count(summary.UnassignedJobs)</strong></a>
                <a class="stat-card" href="siparisler/isler?gorunum=overdue" aria-label="@Texts.Get("orders.dashboard.aria.overdue-jobs", summary.OverdueJobs)"><span>@Texts.Get("orders.dashboard.stat.overdue-jobs")</span><strong>@Count(summary.OverdueJobs)</strong></a>
                <div class="stat-card" role="group" aria-label="@Texts.Get("orders.dashboard.aria.open-deliveries", summary.OpenDeliveries)"><span>@Texts.Get("orders.dashboard.stat.open-deliveries")</span><strong>@Count(summary.OpenDeliveries)</strong></div>
                <div class="stat-card" role="group" aria-label="@Texts.Get("orders.dashboard.aria.overdue-deliveries", summary.OverdueDeliveries)"><span>@Texts.Get("orders.dashboard.stat.overdue-deliveries")</span><strong>@Count(summary.OverdueDeliveries)</strong></div>
                <div class="stat-card" role="group" aria-label="@Texts.Get("orders.dashboard.aria.overdue-services", summary.OverdueServiceStarts)"><span>@Texts.Get("orders.dashboard.stat.overdue-services")</span><strong>@Count(summary.OverdueServiceStarts)</strong></div>
            </div>
        </section>

        <section aria-labelledby="late-title">
            <h2 id="late-title">@Texts.Get("orders.dashboard.late-title")</h2>
            @if (lateDeliveries.Count == 0 && lateServices.Count == 0)
            {
                <p class="text-muted">@Texts.Get("orders.dashboard.late-none")</p>
            }
            else
            {
                <ul>
                    @foreach (var d in lateDeliveries)
                    {
                        <li><a href="siparisler/@d.OrderId/teslimat">@Texts.Get("orders.dashboard.late-delivery", d.Number)</a> <span class="text-muted">@Texts.Get("orders.dashboard.late-planned", OrderLabels.Date(d.PlannedDate), string.Empty)</span></li>
                    }
                    @foreach (var s in lateServices)
                    {
                        <li><a href="siparisler/@s.OrderId/teslimat">@Texts.Get("orders.dashboard.late-service")</a> <span class="text-muted">@Texts.Get("orders.dashboard.late-planned", OrderLabels.Date(s.PlannedStartDate), string.IsNullOrEmpty(s.DelayReason) ? string.Empty : " · " + s.DelayReason)</span></li>
                    }
                </ul>
                @if (summary.OverdueDeliveries > lateDeliveries.Count || summary.OverdueServiceStarts > lateServices.Count)
                {
                    <p class="small text-muted">@Texts.Get("orders.dashboard.late-limit", Limit)</p>
                }
            }
        </section>
    }
</AuthGate>

@code {
    private const int Limit = 10;

    private OrderSummaryDto? summary;
    private List<DeliveryDto> lateDeliveries = [];
    private List<ServiceStartDto> lateServices = [];
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (!Session.Can(OrdersAccess.OrdersRead)) { return; }

        var result = await Api.GetAsync<OrderSummaryDto>("/api/orders/summary");
        if (!result.IsSuccess)
        {
            error = result.Error ?? Texts.Get("orders.dashboard.load-failed");
            return;
        }

        summary = result.Value;
        var deliveries = await Api.GetAsync<PagedResult<DeliveryDto>>($"/api/orders/deliveries?overdue=true&pageSize={Limit}");
        var services = await Api.GetAsync<PagedResult<ServiceStartDto>>($"/api/orders/service-starts?overdue=true&pageSize={Limit}");
        lateDeliveries = [.. deliveries.Value?.Items ?? []];
        lateServices = [.. services.Value?.Items ?? []];
    }

    private static string Count(int value) => value.ToString("N0", Regional.Numbers);

    private static string FormatHours(double hours) =>
        hours < 48 ? Texts.Get("orders.dashboard.hours", hours.ToString("0.#", Regional.Numbers)) : Texts.Get("orders.dashboard.days", (hours / 24).ToString("0.#", Regional.Numbers));
}
