@page "/siparisler/isler"
@inject ApiClient Api
@inject SessionState Session
@inject CrmLookups Lookups

<PageTitle>@Texts.Get("orders.jobs.title") · Modulix</PageTitle>

<AuthGate Module="@OrdersAccess.ModuleKey" Permission="@OrdersAccess.OrdersRead">
    <div class="page-header">
        <div>
            <h1>@Texts.Get("orders.jobs.title")</h1>
            <p class="text-muted mb-0">@Texts.Get("orders.opjobs.intro")</p>
        </div>
        <div class="header-actions">
            <a class="btn btn-outline-secondary" href="siparisler">@Texts.Get("orders.list.title")</a>
        </div>
    </div>

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message <button type="button" class="btn btn-sm btn-outline-secondary ms-2" @onclick="() => LoadAsync(1)">@Texts.Get("orders.list.retry")</button></div>
    }

    <ViewTabs Items="ViewOptions" Value="@viewKey" ValueChanged="ChooseViewAsync" Label="@Texts.Get("orders.opjobs.views")" NewView="StartNaming" />

    <div class="list-toolbar">
        <form class="search" @onsubmit="() => LoadAsync(1)" @onsubmit:preventDefault>
            <label class="visually-hidden" for="job-search">@Texts.Get("orders.opjobs.search-label")</label>
            <input id="job-search" class="form-control" type="search" placeholder="@Texts.Get("orders.opjobs.search-placeholder")" @bind="search" />
        </form>
        <FilterToggle @bind-Open="filtersOpen" Count="ActiveFilters" />
        <GridColumnPicker State="grid" Changed="@(() => Task.CompletedTask)" />
    </div>

    @if (filtersOpen || ActiveFilters > 0)
    {
        <div class="filters">
            <label class="visually-hidden" for="job-status">@Texts.Get("orders.opjobs.status-filter")</label>
            <select id="job-status" class="form-select form-select-sm filter-select" @bind="status" @bind:after="() => LoadAsync(1)">
                <option value="">@Texts.Get("common.allStatuses")</option>
                @foreach (var s in OrderLabels.JobStatuses) { <option value="@s.Key">@s.Label</option> }
            </select>
            <label class="visually-hidden" for="job-kind">@Texts.Get("orders.opjobs.kind-filter")</label>
            <select id="job-kind" class="form-select form-select-sm filter-select" @bind="kind" @bind:after="() => LoadAsync(1)">
                <option value="">@Texts.Get("orders.opjobs.all-kinds")</option>
                @foreach (var k in OrderLabels.JobKinds) { <option value="@k.Key">@k.Label</option> }
            </select>
        </div>
    }

    <PersonalViewBar Active="Active" Dirty="grid.Differs(Active)" Naming="views.Naming" NamingChanged="views.StartNaming" Error="@views.Error"
                     SaveAs="SaveAsAsync" UpdateView="UpdateViewAsync" DiscardChanges="DiscardAsync" DeleteView="DeleteViewAsync" />

    @if (page is null && message is null)
    {
        <LoadingState Kind="LoadingKind.Table" />
    }
    else if (page is not null && page.Items.Count == 0)
    {
        <EmptyState Compact="true" Title="@Texts.Get("orders.opjobs.empty")" />
    }
    else if (page is not null)
    {
        <p class="visually-hidden" role="status" aria-live="polite">@Texts.Get("orders.opjobs.listed", page.TotalCount)</p>
        <table class="table record-table">
            <caption class="visually-hidden">@Texts.Get("orders.opjobs.caption")</caption>
            <thead>
                <tr>
                    @foreach (var column in grid.VisibleColumns)
                    {
                        <GridHeader Column="column" State="grid" SortChanged="SortAsync" />
                    }
                    <th scope="col" class="row-menu-cell"><span class="visually-hidden">@Texts.Get("common.actions")</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var j in page.Items)
                {
                    <tr>
                        @foreach (var column in grid.VisibleColumns)
                        {
                            @Cell(column, j)
                        }
                        <td class="row-menu-cell">
                            <RowMenu Label="@Texts.Get("common.rowActionsOf", j.Number)">
                                <a class="view-menu-item" role="menuitem" href="siparisler/isler/@j.Id"><AppIcon Name="eye" Size="16" /> <span>@Texts.Get("orders.opjobs.open-job")</span></a>
                                <a class="view-menu-item" role="menuitem" href="siparisler/@j.OrderId"><AppIcon Name="file-text" Size="16" /> <span>@Texts.Get("orders.opjobs.open-order")</span></a>
                            </RowMenu>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager PageSizeChoice="true" Page="page.Page" PageSize="page.PageSize" TotalCount="page.TotalCount" PageChanged="LoadAsync" />
    }
</AuthGate>

@code {
    private bool filtersOpen;

    /// <summary>Etkin süzgeç sayısı ("Filtrele" rozeti); süzgeç satırı etkin süzgeç varken açık kalır.</summary>
    private int ActiveFilters => (string.IsNullOrEmpty(status) ? 0 : 1) + (string.IsNullOrEmpty(kind) ? 0 : 1);

    private const string DefaultSort = "-createdAt";
    private const string AllViews = "all";

    /// <summary>Hızlı görünümler; her biri sunucudaki süzgeçlerden birine karşılık gelir.</summary>
    private static (string Key, string Label, string Icon)[] Presets =>
    [
        ("mine", Texts.Get("orders.opjobs.view.mine"), "star"), ("unassigned", Texts.Get("orders.opjobs.view.unassigned"), "user"), ("planned", Texts.Get("orders.opjobs.view.planned"), "calendar"),
        ("progress", Texts.Get("orders.opjobs.view.progress"), "activity"), ("overdue", Texts.Get("orders.opjobs.view.overdue"), "clock"),
    ];

    // Sıralama sunucudaki sort anahtarlarıdır (JobSort); varsayılan sıra en yeni önce.
    private static GridColumnDef[] Columns =>
    [
        new("job", Texts.Get("orders.jobs.col.job"), "clipboard-list", "number", "-number", Locked: true),
        new("kind", Texts.Get("orders.jobs.col.kind"), "tag"),
        new("status", Texts.Get("common.field.status"), "activity"),
        new("responsible", Texts.Get("orders.jobs.col.responsible"), "user"),
        new("planned", Texts.Get("orders.jobs.col.planned"), "calendar", "plannedEnd", "-plannedEnd"),
        new("priority", Texts.Get("orders.opjobs.col.priority"), "alert-circle"),
        new("location", Texts.Get("orders.list.col.location"), "map-pin", DefaultVisible: false),
    ];

    /// <summary>Özet panosundan gelen bağlantılar: <c>?gorunum=unassigned</c>, <c>?gorunum=overdue</c>.</summary>
    [SupplyParameterFromQuery(Name = "gorunum")] public string? InitialView { get; set; }

    private readonly GridViewState grid = new("orders.operation-jobs", DefaultSort);
    private PersonalGridViews views = default!;
    private PagedResult<OperationJobDto>? page;
    private string? message;
    private string? view;
    private string viewKey = AllViews;
    private string? status;
    private string? kind;
    private string search = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        views = new PersonalGridViews(Api, "orders.operation-jobs");
        grid.Define(Columns);
        await Session.EnsureLoadedAsync();
        if (Session.Can(OrdersAccess.OrdersRead))
        {
            await Lookups.LoadAsync();
            await views.LoadAsync();
            if (InitialView is not null && Presets.Any(p => p.Key == InitialView)) { view = InitialView; viewKey = InitialView; }
            await LoadAsync(1);
        }
    }

    private GridViewDto? Active => views.Find(viewKey);

    private IReadOnlyList<ViewOption> ViewOptions =>
    [
        new(AllViews, Texts.Get("orders.opjobs.view.all"), Icon: "clipboard-list"),
        .. Presets.Select(p => new ViewOption(p.Key, p.Label, Icon: p.Icon)),
        .. views.Options,
    ];

    private async Task ChooseViewAsync(string key)
    {
        viewKey = key;
        views.StartNaming(false);
        if (Active is { } saved)
        {
            // Kişisel görünüm: sütunlar, sıralama ve süzgeç (görünüm + durum + tür) birlikte gelir.
            grid.Apply(saved);
            var filters = GridFilters.Parse(saved.Filters);
            var preset = filters.GetValueOrDefault("view");
            view = preset is not null && Presets.Any(p => p.Key == preset) ? preset : null;
            status = filters.GetValueOrDefault("status");
            kind = filters.GetValueOrDefault("kind");
        }
        else
        {
            grid.Reset();
            view = key == AllViews ? null : key;
        }

        await LoadAsync(1);
    }

    private Task SortAsync(string key)
    {
        grid.Sort = key;
        return LoadAsync(1);
    }

    private string? CurrentFilters => GridFilters.Build(
        view is { } v ? ("view", v) : null,
        status is { Length: > 0 } s ? ("status", s) : null,
        kind is { Length: > 0 } k ? ("kind", k) : null);

    private void StartNaming() => views.StartNaming(true);

    private async Task SaveAsAsync(string name)
    {
        if (await views.SaveAsAsync(grid.ToRequest(name, CurrentFilters)) is { } key)
        {
            viewKey = key;
        }
    }

    private async Task UpdateViewAsync()
    {
        if (Active is { } current)
        {
            await views.UpdateAsync(current, grid.ToRequest(current.Name, CurrentFilters));
        }
    }

    private async Task DiscardAsync() => await ChooseViewAsync(viewKey);

    private async Task DeleteViewAsync()
    {
        if (Active is { } current && await views.DeleteAsync(current))
        {
            await ChooseViewAsync(AllViews);
        }
    }

    private static bool IsOverdue(OperationJobDto j) =>
        j.Status is not ("Completed" or "Cancelled") && j.PlannedEndDate is { } end && end < DateOnly.FromDateTime(Regional.Now.DateTime);

    private string Query(int pageNumber)
    {
        var parts = new List<string> { $"page={pageNumber}&pageSize={ListPaging.Size}" };
        if (!string.IsNullOrWhiteSpace(search)) { parts.Add($"search={Uri.EscapeDataString(search.Trim())}"); }
        switch (view)
        {
            case "mine": parts.Add("responsibleUserId=me"); if (string.IsNullOrEmpty(status)) { parts.Add("status=AwaitingAssignment,Planned,InProgress"); } break;
            case "unassigned": parts.Add("unassigned=true"); break;
            case "planned": if (string.IsNullOrEmpty(status)) { parts.Add("status=Planned"); } break;
            case "progress": if (string.IsNullOrEmpty(status)) { parts.Add("status=InProgress"); } break;
            case "overdue": parts.Add("overdue=true"); break;
        }

        if (!string.IsNullOrEmpty(status)) { parts.Add($"status={Uri.EscapeDataString(status)}"); }
        if (!string.IsNullOrEmpty(kind)) { parts.Add($"kind={Uri.EscapeDataString(kind)}"); }
        if (grid.Sort != DefaultSort) { parts.Add($"sort={Uri.EscapeDataString(grid.Sort)}"); }
        return string.Join('&', parts);
    }

    private async Task LoadAsync(int pageNumber)
    {
        var result = await Api.GetAsync<PagedResult<OperationJobDto>>($"/api/orders/operation-jobs?{Query(pageNumber)}");
        page = result.Value;
        message = result.IsSuccess ? null : result.Error;
    }

    private RenderFragment Cell(GridColumnDef column, OperationJobDto j) => @<td data-label="@column.Label" class="@(column.Key == "job" ? "primary" : null)">@CellContent(column.Key, j)</td>;

    private RenderFragment CellContent(string key, OperationJobDto j) => key switch
    {
        "job" => @<text>
            <a href="siparisler/isler/@j.Id">@j.Title</a>
            <small class="text-muted">@j.Number · <a href="siparisler/@j.OrderId">@Texts.Get("orders.opjobs.open-order-lower")</a></small>
        </text>,
        "kind" => @<text>@OrderLabels.Label(OrderLabels.JobKinds, j.Kind)</text>,
        "status" => @<text>
            <span class="badge stage-@OrderLabels.JobBadge(j.Status)">@OrderLabels.Label(OrderLabels.JobStatuses, j.Status)</span>
            @if (IsOverdue(j)) { <span class="badge stage-lost">@Texts.Get("orders.fulfillment-page.overdue")</span> }
        </text>,
        "responsible" => @<text>
            @(Lookups.MemberName(j.ResponsibleUserId) is { Length: > 0 } who ? who : null)
            @if (!string.IsNullOrEmpty(j.TeamName)) { <small class="text-muted d-block">@j.TeamName</small> }
            @if (j.ResponsibleUserId is null && string.IsNullOrEmpty(j.TeamName)) { <span class="text-muted">@Texts.Get("orders.jobs.unassigned")</span> }
        </text>,
        "planned" => @<text>@OrderLabels.Date(j.PlannedStartDate) – @OrderLabels.Date(j.PlannedEndDate)</text>,
        "priority" => @<text>@OrderLabels.Label(OrderLabels.Priorities, j.Priority)</text>,
        "location" => @<text>@j.Location</text>,
        _ => @<text></text>,
    };
}
