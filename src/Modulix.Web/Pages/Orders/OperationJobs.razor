@page "/siparisler/isler"
@inject ApiClient Api
@inject SessionState Session
@inject CrmLookups Lookups

<PageTitle>Operasyon işleri · Modulix</PageTitle>

<AuthGate Module="@OrdersAccess.ModuleKey" Permission="@OrdersAccess.OrdersRead">
    <div class="page-header">
        <div>
            <h1>Operasyon işleri</h1>
            <p class="text-muted mb-0">Kabul edilen satış devirlerinden üretilen ve elle açılan işler. Atanacak sorumlu ya da ekip yoksa iş "Atama bekliyor" durumunda burada görünür.</p>
        </div>
        <div class="header-actions">
            <a class="btn btn-outline-secondary" href="siparisler">Siparişler</a>
        </div>
    </div>

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message <button type="button" class="btn btn-sm btn-outline-secondary ms-2" @onclick="() => LoadAsync(1)">Tekrar dene</button></div>
    }

    <div class="filters" role="group" aria-label="Hızlı görünümler">
        @foreach (var (key, label) in Presets)
        {
            <button type="button" class="chip @(view == key ? "active" : null)" aria-pressed="@(view == key ? "true" : "false")" @onclick="() => TogglePresetAsync(key)">@label</button>
        }
        <label class="visually-hidden" for="job-status">İş durumu</label>
        <select id="job-status" class="form-select form-select-sm filter-select" @bind="status" @bind:after="() => LoadAsync(1)">
            <option value="">Tüm durumlar</option>
            @foreach (var s in OrderLabels.JobStatuses) { <option value="@s.Key">@s.Label</option> }
        </select>
        <label class="visually-hidden" for="job-kind">İş türü</label>
        <select id="job-kind" class="form-select form-select-sm filter-select" @bind="kind" @bind:after="() => LoadAsync(1)">
            <option value="">Tüm türler</option>
            @foreach (var k in OrderLabels.JobKinds) { <option value="@k.Key">@k.Label</option> }
        </select>
        <label class="visually-hidden" for="job-sort">Sıralama</label>
        <select id="job-sort" class="form-select form-select-sm filter-select" @bind="sort" @bind:after="() => LoadAsync(1)">
            @foreach (var (key, label) in OrderLabels.JobSorts) { <option value="@key">Sıralama: @label</option> }
        </select>
    </div>

    <form class="search" @onsubmit="() => LoadAsync(1)" @onsubmit:preventDefault>
        <label class="visually-hidden" for="job-search">İş ara</label>
        <input id="job-search" class="form-control" type="search" placeholder="İş numarası, başlık ya da ekip ara" @bind="search" />
        <button type="submit" class="btn btn-outline-secondary">Ara</button>
    </form>

    @if (page is null && message is null)
    {
        <p class="text-muted" role="status">Yükleniyor…</p>
    }
    else if (page is not null && page.Items.Count == 0)
    {
        <p class="text-muted" role="status">Bu süzgece uyan operasyon işi yok. İşler satış devri operasyonca kabul edilince oluşur.</p>
    }
    else if (page is not null)
    {
        <p class="visually-hidden" role="status" aria-live="polite">@(page.TotalCount) iş listelendi.</p>
        <table class="table record-table">
            <caption class="visually-hidden">Operasyon işi kuyruğu</caption>
            <thead>
                <tr>
                    <th scope="col">İş</th><th scope="col">Tür</th><th scope="col">Durum</th><th scope="col">Sorumlu / ekip</th>
                    <th scope="col">Planlanan</th><th scope="col">Öncelik</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var j in page.Items)
                {
                    <tr>
                        <td data-label="İş" class="primary">
                            <a href="siparisler/isler/@j.Id">@j.Title</a>
                            <small class="text-muted">@j.Number · <a href="siparisler/@j.OrderId">siparişi aç</a></small>
                        </td>
                        <td data-label="Tür">@OrderLabels.Label(OrderLabels.JobKinds, j.Kind)</td>
                        <td data-label="Durum">
                            <span class="badge stage-@OrderLabels.JobBadge(j.Status)">@OrderLabels.Label(OrderLabels.JobStatuses, j.Status)</span>
                            @if (IsOverdue(j)) { <span class="badge stage-lost">Gecikti</span> }
                        </td>
                        <td data-label="Sorumlu / ekip">
                            @(Lookups.MemberName(j.ResponsibleUserId) is { Length: > 0 } who ? who : null)
                            @if (!string.IsNullOrEmpty(j.TeamName)) { <small class="text-muted d-block">@j.TeamName</small> }
                            @if (j.ResponsibleUserId is null && string.IsNullOrEmpty(j.TeamName)) { <span class="text-muted">Atanmadı</span> }
                        </td>
                        <td data-label="Planlanan">@OrderLabels.Date(j.PlannedStartDate) – @OrderLabels.Date(j.PlannedEndDate)</td>
                        <td data-label="Öncelik">@OrderLabels.Label(OrderLabels.Priorities, j.Priority)</td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager Page="page.Page" PageSize="page.PageSize" TotalCount="page.TotalCount" PageChanged="LoadAsync" />
    }
</AuthGate>

@code {
    private const string DefaultSort = "-createdAt";

    /// <summary>Hızlı görünümler; her biri sunucudaki süzgeçlerden birine karşılık gelir.</summary>
    private static readonly (string Key, string Label)[] Presets =
    [
        ("mine", "Benim işlerim"), ("unassigned", "Atanmamış"), ("planned", "Planlanan"), ("progress", "Devam eden"), ("overdue", "Geciken"),
    ];

    private PagedResult<OperationJobDto>? page;
    private string? message;
    private string? view;
    private string? status;
    private string? kind;
    private string sort = DefaultSort;
    private string search = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (Session.Can(OrdersAccess.OrdersRead))
        {
            await Lookups.LoadAsync();
            await LoadAsync(1);
        }
    }

    private async Task TogglePresetAsync(string key)
    {
        view = view == key ? null : key;
        await LoadAsync(1);
    }

    private static bool IsOverdue(OperationJobDto j) =>
        j.Status is not ("Completed" or "Cancelled") && j.PlannedEndDate is { } end && end < DateOnly.FromDateTime(Regional.Now.DateTime);

    private string Query(int pageNumber)
    {
        var parts = new List<string> { $"page={pageNumber}" };
        if (!string.IsNullOrWhiteSpace(search)) { parts.Add($"search={Uri.EscapeDataString(search.Trim())}"); }
        switch (view)
        {
            case "mine": parts.Add("responsibleUserId=me"); if (string.IsNullOrEmpty(status)) { parts.Add("status=AwaitingAssignment,Planned,InProgress"); } break;
            case "unassigned": parts.Add("unassigned=true"); break;
            case "planned": if (string.IsNullOrEmpty(status)) { parts.Add("status=Planned"); } break;
            case "progress": if (string.IsNullOrEmpty(status)) { parts.Add("status=InProgress"); } break;
            case "overdue": parts.Add("overdue=true"); break;
        }

        if (!string.IsNullOrEmpty(status)) { parts.Add($"status={Uri.EscapeDataString(status)}"); }
        if (!string.IsNullOrEmpty(kind)) { parts.Add($"kind={Uri.EscapeDataString(kind)}"); }
        if (sort != DefaultSort) { parts.Add($"sort={Uri.EscapeDataString(sort)}"); }
        return string.Join('&', parts);
    }

    private async Task LoadAsync(int pageNumber)
    {
        var result = await Api.GetAsync<PagedResult<OperationJobDto>>($"/api/orders/operation-jobs?{Query(pageNumber)}");
        page = result.Value;
        message = result.IsSuccess ? null : result.Error;
    }
}
