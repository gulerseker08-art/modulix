@page "/siparisler/tekliften/{QuoteId:guid}"
@inject ApiClient Api
@inject SessionState Session
@inject NavigationManager Navigation

<PageTitle>@Texts.Get("orders.fromquote.page-title") · Modulix</PageTitle>

<AuthGate Module="@OrdersAccess.ModuleKey" Permission="@OrdersAccess.OrdersCreate">
    <div class="page-header">
        <div>
            <h1>@Texts.Get("orders.fromquote.title")</h1>
            <p class="text-muted mb-0">@Texts.Get("orders.fromquote.intro")</p>
        </div>
        <div class="header-actions">
            <a class="btn btn-outline-secondary" href="crm/teklifler/@QuoteId">@Texts.Get("orders.fromquote.back")</a>
        </div>
    </div>

    @if (!Session.Can(OrdersAccess.FinancialsRead))
    {
        <div class="alert alert-warning" role="alert">@((MarkupString)Texts.Get("orders.fromquote.financials-needed", $"<code>{System.Net.WebUtility.HtmlEncode(OrdersAccess.FinancialsRead)}</code>"))</div>
    }
    else if (notFound)
    {
        <div class="alert alert-warning" role="alert">@Texts.Get("orders.fromquote.not-found") <a href="crm/teklifler">@Texts.Get("orders.fromquote.back-to-quotes")</a></div>
    }
    else if (preview is null)
    {
        <p class="text-muted" role="status">@Texts.Get("common.loading")</p>
    }
    else
    {
        <Notice Text="@message" Failed="true" />

        @foreach (var blocker in preview.Blockers)
        {
            <div class="alert alert-danger" role="alert">@blocker</div>
        }

        @if (preview.ExistingOrders.Count > 0)
        {
            <div class="alert alert-info" role="status">
                @Texts.Get(preview.ExistingOrders.Count > 1 ? "orders.fromquote.existing-many" : "orders.fromquote.existing-one")
                @foreach (var existing in preview.ExistingOrders)
                {
                    <a class="ms-2" href="siparisler/@existing.Id">@existing.Number</a>
                }
            </div>
        }

        @if (preview.Warnings.Count > 0)
        {
            <section aria-labelledby="warn-title">
                <h2 id="warn-title" class="h6">@Texts.Get("orders.fromquote.warnings")</h2>
                <ul class="alert alert-warning">
                    @foreach (var warning in preview.Warnings) { <li>@warning</li> }
                </ul>
            </section>
        }

        <section aria-labelledby="quote-summary-title">
            <h2 id="quote-summary-title">@Texts.Get("orders.fromquote.accepted")</h2>
            <dl class="detail-list">
                <dt>@Texts.Get("orders.list.col.quote")</dt><dd><strong>@preview.Title</strong> · @preview.QuoteNumber · @Texts.Get("orders.fromquote.revision", preview.RevisionNo)</dd>
                <dt>@Texts.Get("orders.list.col.customer")</dt><dd>@(preview.CustomerName ?? "—")</dd>
                <dt>@Texts.Get("orders.fromquote.acceptance")</dt>
                <dd>
                    @OrderLabels.Label(OrderLabels.AcceptanceMethods, preview.AcceptanceMethod)@(preview.AcceptedBy is { Length: > 0 } by ? " · " + by : string.Empty) · @CrmLabels.Time(preview.AcceptedAt)
                    @if (preview.DocumentSha256 is { Length: > 12 } sha) { <small class="text-muted">@Texts.Get("orders.fromquote.digest") <code title="@sha">@sha[..12]…</code></small> }
                </dd>
                <dt>@Texts.Get("orders.detail.quote-valid")</dt><dd>@(preview.ValidUntil is { } until ? CrmLabels.Time(until) : "—") <small class="text-muted">@Texts.Get("orders.fromquote.valid-note")</small></dd>
                <dt>@Texts.Get("orders.col.amount")</dt><dd>@Texts.Get("orders.fromquote.totals", OrderLabels.Money(preview.NetTotal, preview.Currency), OrderLabels.Money(preview.GrossTotal, preview.Currency))</dd>
                <dt>@Texts.Get("orders.header-field.paymentterms")</dt><dd>@(preview.PaymentTerms ?? "—")</dd>
                <dt>@Texts.Get("orders.header-field.deliveryterms")</dt><dd>@(preview.DeliveryTerms ?? "—")</dd>
            </dl>
        </section>

        <form class="record-form" novalidate @onsubmit="CreateAsync" @onsubmit:preventDefault>
            <TabBar Tabs="FormTabs" State="tabs" Label="@Texts.Get("orders.fromquote.tabs-label")" />
            <fieldset disabled="@(busy || preview.Blockers.Count > 0)">
                <legend class="visually-hidden">@Texts.Get("orders.fromquote.legend")</legend>
                <TabPanel State="tabs" Key="form-kapsam">
                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" id="partial" checked="@partial" @onchange="e => SetPartial((bool)e.Value!)" />
                    <label class="form-check-label" for="partial">@Texts.Get("orders.fromquote.partial")</label>
                </div>
                <table class="table record-table">
                    <caption class="visually-hidden">@Texts.Get("orders.fromquote.lines-caption")</caption>
                    <thead><tr>
                        <th scope="col">@Texts.Get("orders.change.col.line")</th><th scope="col">@Texts.Get("orders.jobs.col.kind")</th><th scope="col" class="text-end">@Texts.Get("orders.fromquote.col.accepted")</th><th scope="col" class="text-end">@Texts.Get("orders.fromquote.col.converted")</th>
                        <th scope="col" class="text-end">@Texts.Get("orders.fromquote.col.remaining")</th><th scope="col" class="text-end">@Texts.Get("orders.fromquote.col.this-order")</th><th scope="col" class="text-end">@Texts.Get("orders.detail.col.net")</th>
                    </tr></thead>
                    <tbody>
                        @foreach (var line in preview.Lines)
                        {
                            <tr>
                                <td data-label="@Texts.Get("orders.change.col.line")" class="primary"><label for="qty-@line.StableKey">@line.Name</label></td>
                                <td data-label="@Texts.Get("orders.jobs.col.kind")">@OrderLabels.Label(OrderLabels.LineKinds, line.Kind)</td>
                                <td data-label="@Texts.Get("orders.fromquote.col.accepted")" class="text-end">@OrderLabels.Quantity(line.AcceptedQuantity, line.Unit)</td>
                                <td data-label="@Texts.Get("orders.fromquote.col.converted")" class="text-end">@OrderLabels.Quantity(line.ConvertedQuantity, line.Unit)</td>
                                <td data-label="@Texts.Get("orders.fromquote.col.remaining")" class="text-end">@OrderLabels.Quantity(line.RemainingQuantity, line.Unit)</td>
                                <td data-label="@Texts.Get("orders.fromquote.col.this-order")" class="text-end">
                                    @if (partial)
                                    {
                                        <input id="qty-@line.StableKey" type="number" min="0" max="@line.RemainingQuantity.ToString(System.Globalization.CultureInfo.InvariantCulture)" step="any" class="form-control form-control-sm text-end"
                                               disabled="@(line.RemainingQuantity <= 0)" value="@QuantityOf(line.StableKey)" @onchange="e => SetQuantity(line.StableKey, e.Value?.ToString())" />
                                    }
                                    else
                                    {
                                        <span id="qty-@line.StableKey">@OrderLabels.Quantity(line.RemainingQuantity, line.Unit)</span>
                                    }
                                </td>
                                <td data-label="@Texts.Get("orders.detail.col.net")" class="text-end">@OrderLabels.Money(line.Net, preview.Currency)</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <FieldError Field="lines" Errors="errors" />
                </TabPanel>
                <TabPanel State="tabs" Key="form-planlama">
                <div class="form-grid">
                    <div class="span-12">
                        <label class="form-label" for="f-title">@Texts.Get("orders.fromquote.field.title")</label>
                        <input id="f-title" class="form-control" maxlength="200" placeholder="@preview.Title" @bind="title" />
                        <FieldError Field="title" Errors="errors" />
                    </div>
                    <div class="span-6">
                        <label class="form-label" for="f-start">@Texts.Get("orders.jobs.field.start")</label>
                        <input id="f-start" type="date" class="form-control" @bind="startDate" />
                        <FieldError Field="plannedStartDate" Errors="errors" />
                    </div>
                    <div class="span-6">
                        <label class="form-label" for="f-delivery">@Texts.Get("orders.header-field.planneddeliverydate")</label>
                        <input id="f-delivery" type="date" class="form-control" @bind="deliveryDate" />
                        <FieldError Field="plannedDeliveryDate" Errors="errors" />
                    </div>
                    <div class="span-6">
                        <label class="form-label" for="f-owner">@Texts.Get("orders.detail.owner")</label>
                        <LookupPicker Id="f-owner" LookupKey="orders.order.owner" @bind-Value="ownerId" Placeholder="@Texts.Get("orders.fromquote.owner-placeholder")" />
                    </div>
                    <div class="span-6">
                        <label class="form-label" for="f-location">@Texts.Get("orders.header-field.location")</label>
                        <input id="f-location" class="form-control" maxlength="1000" @bind="location" />
                        <FieldError Field="location" Errors="errors" />
                    </div>
                    <div class="span-12">
                        <label class="form-label" for="f-address">@Texts.Get("orders.header-field.deliveryaddress")</label>
                        <textarea id="f-address" class="form-control" rows="2" maxlength="1000" placeholder="@(preview.DeliveryAddress ?? Texts.Get("orders.fromquote.address-placeholder"))" @bind="deliveryAddress"></textarea>
                        <small class="text-muted">@Texts.Get("orders.fromquote.address-note")</small>
                        <FieldError Field="deliveryAddress" Errors="errors" />
                    </div>
                    <div class="span-12">
                        <label class="form-label" for="f-commitments">@Texts.Get("orders.header-field.commitments")</label>
                        <textarea id="f-commitments" class="form-control" rows="2" maxlength="4000" @bind="commitments"></textarea>
                    </div>
                    <div class="span-12">
                        <label class="form-label" for="f-notes">@Texts.Get("orders.header-field.operationsnotes")</label>
                        <textarea id="f-notes" class="form-control" rows="2" maxlength="4000" @bind="operationsNotes"></textarea>
                    </div>
                </div>
                </TabPanel>
            </fieldset>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary" disabled="@(busy || preview.Blockers.Count > 0 || (partial && quantities.Count(q => q.Value > 0) == 0))">@Texts.Get("orders.fromquote.submit")</button>
            </div>
        </form>
    }
</AuthGate>

@code {
    [Parameter] public Guid QuoteId { get; set; }

    private OrderSourceDto? preview;
    private IReadOnlyDictionary<string, string[]>? errors;

    // Her kayıt formu sekmelidir; hatalı alan içeren sekme "!" rozeti taşır, kayıt denemesinden sonra hatalı ilk sekme açılır.
    private readonly TabState tabs = new("form-kapsam");

    private int ErrorCount(params string[] fields) => errors is null ? 0 : fields.Count(errors.ContainsKey);

    private IReadOnlyList<TabItem> FormTabs =>
    [
        new("form-kapsam", Texts.Get("orders.fromquote.tab.scope"), Errors: ErrorCount("lines")),
        new("form-planlama", Texts.Get("orders.fromquote.tab.planning"), Errors: ErrorCount("title", "plannedStartDate", "plannedDeliveryDate", "ownerId", "location", "deliveryAddress", "commitments", "operationsNotes")),
    ];
    private string? message;
    private bool notFound;
    private bool busy;
    private bool partial;
    private readonly Dictionary<Guid, decimal> quantities = [];
    private string title = string.Empty;
    private DateOnly? startDate;
    private DateOnly? deliveryDate;
    private Guid? ownerId;
    private string location = string.Empty;
    private string deliveryAddress = string.Empty;
    private string commitments = string.Empty;
    private string operationsNotes = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        await Session.EnsureLoadedAsync();
        if (!Session.Can(OrdersAccess.OrdersCreate) || !Session.Can(OrdersAccess.FinancialsRead))
        {
            return;
        }

        var result = await Api.GetAsync<OrderSourceDto>($"/api/orders/from-quote/{QuoteId}");
        if (!result.IsSuccess)
        {
            notFound = true;
            return;
        }

        preview = result.Value;
        quantities.Clear();
    }

    private void SetPartial(bool on)
    {
        partial = on;
        quantities.Clear();
        if (on && preview is not null)
        {
            // Başlangıçta her kalemin kalan miktarı önerilir; kullanıcı azaltır ya da sıfırlar.
            foreach (var line in preview.Lines.Where(l => l.RemainingQuantity > 0)) { quantities[line.StableKey] = line.RemainingQuantity; }
        }
    }

    private string QuantityOf(Guid key) =>
        quantities.TryGetValue(key, out var value) ? value.ToString("G29", System.Globalization.CultureInfo.InvariantCulture) : "0";

    private void SetQuantity(Guid key, string? text)
    {
        quantities[key] = decimal.TryParse(text, System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var value) && value > 0 ? value : 0m;
    }

    private async Task CreateAsync()
    {
        if (busy || preview is null) { return; }
        busy = true;
        message = null;
        errors = null;
        var lines = partial ? quantities.Where(q => q.Value > 0).Select(q => new OrderLineQuantityRequest(q.Key, q.Value)).ToList() : null;
        var request = new CreateOrderFromQuoteRequest(
            partial ? "Partial" : "Full", lines, string.IsNullOrWhiteSpace(title) ? null : title.Trim(), ownerId,
            string.IsNullOrWhiteSpace(deliveryAddress) ? null : deliveryAddress.Trim(), string.IsNullOrWhiteSpace(location) ? null : location.Trim(),
            startDate, deliveryDate, string.IsNullOrWhiteSpace(commitments) ? null : commitments.Trim(), string.IsNullOrWhiteSpace(operationsNotes) ? null : operationsNotes.Trim());
        var result = await Api.PostAsync<OrderDto>($"/api/orders/from-quote/{QuoteId}", request);
        busy = false;
        if (result.IsSuccess)
        {
            Navigation.NavigateTo($"siparisler/{result.Value!.Id}");
            return;
        }

        errors = result.FieldErrors;
        tabs.RevealFirstFailing(FormTabs);
        message = result.Error;

        // Çakışma (çift tıklama, başkası oluşturdu): güncel durumu yükle; mevcut sipariş bağlantısı görünür.
        if (result.Status == System.Net.HttpStatusCode.Conflict)
        {
            var again = await Api.GetAsync<OrderSourceDto>($"/api/orders/from-quote/{QuoteId}");
            if (again.IsSuccess)
            {
                preview = again.Value;
                if (preview!.ExistingOrders.Count > 0 && preview.FullyConverted && !partial)
                {
                    Navigation.NavigateTo($"siparisler/{preview.ExistingOrders[0].Id}");
                }
            }
        }
    }
}
