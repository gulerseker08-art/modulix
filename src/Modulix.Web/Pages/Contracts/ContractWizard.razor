@page "/sozlesmeler/sihirbaz"
@inject ApiClient Api
@inject SessionState Session
@inject CrmLookups Lookups
@inject NavigationManager Navigation
@inject IJSRuntime Js

<PageTitle>@Texts.Get("contracts.wizard.title") · Modulix</PageTitle>

<NavigationLock ConfirmExternalNavigation="@dirty" OnBeforeInternalNavigation="ConfirmLeaveAsync" />

<AuthGate Module="@ContractsAccess.ModuleKey" Permission="@ContractsAccess.ContractsWrite">
    <div class="page-header">
        <div>
            <h1>@Texts.Get("contracts.wizard.title")</h1>
            <p class="text-muted mb-0">@Texts.Get("contracts.wizard.intro")</p>
        </div>
        <div class="header-actions">
            @if (contract is not null)
            {
                <a class="btn btn-outline-secondary" href="sozlesmeler/@contract.Id">@Texts.Get("contracts.wizard.goToDetail")</a>
            }
            <a class="btn btn-outline-secondary" href="sozlesmeler">@Texts.Get("crm.quoteDetail.backToList")</a>
        </div>
    </div>

    <ol class="wizard-steps" aria-label="@Texts.Get("contracts.wizard.stepsLabel")">
        @for (var i = 0; i < Steps.Length; i++)
        {
            var index = i;
            var reachable = index == 0 || contract is not null;
            <li class="@(index == step ? "current" : index < step ? "done" : null)" aria-current="@(index == step ? "step" : null)">
                @if (reachable && index != step)
                {
                    <button type="button" class="btn btn-link" disabled="@busy" @onclick="() => GoAsync(index)">@(index + 1). @Steps[index]</button>
                }
                else
                {
                    <span>@(index + 1). @Steps[index]</span>
                }
            </li>
        }
    </ol>

    <Notice Text="@notice" Failed="@noticeFailed" />

    @if (loading)
    {
        <LoadingState />
    }
    else if (step == 0)
    {
        <section class="record-form" aria-labelledby="step-title">
            <h2 id="step-title" tabindex="-1" @ref="stepHeading">@Texts.Get("contracts.wizard.sourceTitle")</h2>
            <fieldset>
                <legend class="visually-hidden">@Texts.Get("contracts.wizard.step.source")</legend>
                <div class="form-check">
                    <input id="src-blank" class="form-check-input" type="radio" name="source" checked="@(source == "blank")" @onchange='() => source = "blank"' />
                    <label class="form-check-label" for="src-blank">@Texts.Get("contracts.wizard.sourceBlank")</label>
                </div>
                <div class="form-check">
                    <input id="src-template" class="form-check-input" type="radio" name="source" checked="@(source == "template")" @onchange='() => source = "template"' />
                    <label class="form-check-label" for="src-template">@Texts.Get("contracts.wizard.sourceTemplate")</label>
                </div>
                @if (Session.IsModuleEnabled("crm") && Session.Can(CrmAccess.QuotesRead))
                {
                    <div class="form-check">
                        <input id="src-quote" class="form-check-input" type="radio" name="source" checked="@(source == "quote")" @onchange='() => source = "quote"' />
                        <label class="form-check-label" for="src-quote">@Texts.Get("contracts.wizard.sourceQuote")</label>
                    </div>
                }
            </fieldset>

            @if (source == "template")
            {
                <div>
                    <label class="form-label" for="wiz-template">@Texts.Get("contracts.detail.col.template")</label>
                    @if (templates.Count == 0)
                    {
                        <p class="text-muted">@((MarkupString)Texts.Get("contracts.wizard.noTemplates", $"<a href=\"sozlesmeler/sablonlar\">{System.Net.WebUtility.HtmlEncode(Texts.Get("nav.app.contracts.templates"))}</a>"))</p>
                    }
                    else
                    {
                        <select id="wiz-template" class="form-select" @bind="templateId" @bind:after="TemplateChosen">
                            <option value="">@Texts.Get("contracts.detail.chooseTemplate")</option>
                            @foreach (var t in templates) { <option value="@t.Id">@t.Name@(t.IsExample ? " " + Texts.Get("contracts.wizard.exampleText") : "")</option> }
                        </select>
                    }
                </div>
            }
            else if (source == "quote")
            {
                @if (quotes is null)
                {
                    <p class="text-muted" role="status">@Texts.Get("contracts.wizard.quotesLoading")</p>
                }
                else if (quotes.Count == 0)
                {
                    <EmptyState Title="@Texts.Get("contracts.wizard.noQuotes")" />
                }
                else
                {
                    <table class="table record-table">
                        <caption class="visually-hidden">@Texts.Get("contracts.wizard.quotesCaption")</caption>
                        <thead><tr><th scope="col">@Texts.Get("contracts.wizard.col.quote")</th><th scope="col">@Texts.Get("contracts.field.title")</th><th scope="col" class="text-end">@Texts.Get("contracts.field.gross")</th><th scope="col"><span class="visually-hidden">@Texts.Get("crm.quoteApprovals.col.action")</span></th></tr></thead>
                        <tbody>
                            @foreach (var q in quotes)
                            {
                                <tr>
                                    <td data-label="@Texts.Get("contracts.wizard.col.quote")" class="primary">@q.QuoteNumber @Texts.Get("contracts.versionNo", q.RevisionNo)</td>
                                    <td data-label="@Texts.Get("contracts.field.title")">@q.Title</td>
                                    <td data-label="@Texts.Get("contracts.field.gross")" class="text-end">@ContractLabels.Money(q.GrossTotal, q.Currency)</td>
                                    <td><a class="btn btn-sm btn-outline-primary" href="sozlesmeler/tekliften/@q.Id">@Texts.Get("contracts.wizard.startWithQuote")</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <p class="small text-muted">@Texts.Get("contracts.wizard.quoteHelp")</p>
                }
            }

            <div class="form-actions">
                @if (source != "quote")
                {
                    <button type="button" class="btn btn-primary" disabled="@(source == "template" && templateId == "")" @onclick="() => GoAsync(1)">@Texts.Get("contracts.wizard.continue")</button>
                }
            </div>
        </section>
    }
    else if (step == 1)
    {
        <form class="record-form" novalidate @onsubmit="() => NextAsync(2)" @onsubmit:preventDefault aria-labelledby="step-title">
            <h2 id="step-title" tabindex="-1" @ref="stepHeading">@Texts.Get("contracts.wizard.step.parties")</h2>
            <ErrorSummary Errors="errors" />
            <div @oninput="() => dirty = true" @onchange="() => dirty = true">
                <div>
                    <label class="form-label required" for="w-title">@Texts.Get("contracts.field.title")</label>
                    <input id="w-title" class="form-control" maxlength="200" required aria-required="true" @bind="form.Title" aria-invalid="@(errors?.ContainsKey("title") == true)" />
                    <FieldError Field="title" Errors="errors" />
                </div>
                <div>
                    <label class="form-label" for="w-type">@Texts.Get("contracts.field.type")</label>
                    <select id="w-type" class="form-select" @bind="form.Type">
                        @foreach (var t in Lookups.Choices(ContractsAccess.ContractTypeList, contract?.Type)) { <option value="@t.Key">@t.Label</option> }
                    </select>
                    <FieldError Field="type" Errors="errors" />
                </div>
                <div>
                    <label class="form-label required" for="partyId">@Texts.Get("contracts.field.partyid")</label>
                    <LookupPicker Id="partyId" LookupKey="contracts.contract.party" @bind-Value="form.PartyId" Required="true" Invalid="@(errors?.ContainsKey("partyId") == true)" />
                    <FieldError Field="partyId" Errors="errors" />
                </div>
                <div>
                    <label class="form-label" for="personId">@Texts.Get("contracts.field.personid")</label>
                    <LookupPicker Id="personId" LookupKey="contracts.contract.person" @bind-Value="form.PersonId" ParentId="form.PartyId" Placeholder="—" Invalid="@(errors?.ContainsKey("personId") == true)" />
                    <FieldError Field="personId" Errors="errors" />
                </div>
                <div>
                    <label class="form-label" for="ownerId">@Texts.Get("common.field.owner")</label>
                    <LookupPicker Id="ownerId" LookupKey="contracts.contract.owner" @bind-Value="form.OwnerId" Placeholder="@Texts.Get("common.me")" />
                    <FieldError Field="ownerId" Errors="errors" />
                </div>
            </div>

            @if (contract is not null)
            {
                <fieldset class="wizard-sub" aria-labelledby="parties-title">
                    <legend id="parties-title" class="h6">@Texts.Get("contracts.wizard.otherParties")</legend>
                    @if (parties.Count == 0) { <p class="text-muted small">@Texts.Get("contracts.wizard.noOtherParties")</p> }
                    else
                    {
                        <ul class="list-unstyled">
                            @foreach (var p in parties)
                            {
                                <li>
                                    @ContractLabels.Label(ContractLabels.PartyRoles, p.Role): @PartyName(p.PartyId ?? p.PersonId ?? Guid.Empty)
                                    <button type="button" class="btn btn-link btn-sm text-danger" disabled="@busy" @onclick="() => DeletePartyAsync(p)" aria-label="@Texts.Get("contracts.wizard.removeParty")">@Texts.Get("contracts.signaturePanel.remove")</button>
                                </li>
                            }
                        </ul>
                    }
                    <div class="row g-2">
                        <div class="col-md-4">
                            <label class="form-label" for="p-role">@Texts.Get("contracts.field.role")</label>
                            <select id="p-role" class="form-select" @bind="partyRole">
                                @foreach (var r in ContractLabels.PartyRoles) { <option value="@r.Key">@r.Label</option> }
                            </select>
                        </div>
                        <div class="col-md-5">
                            <label class="form-label" for="p-party">@Texts.Get("contracts.detail.party")</label>
                            <LookupPicker Id="p-party" LookupKey="contracts.contract-party.party" @bind-Value="partyPick" Placeholder="@Texts.Get("contracts.wizard.chooseParty")" />
                        </div>
                        <div class="col-md-3 d-flex align-items-end">
                            <button type="button" class="btn btn-outline-secondary" disabled="@(busy || partyPick is null)" @onclick="AddPartyAsync">@Texts.Get("contracts.wizard.addParty")</button>
                        </div>
                    </div>
                    <FieldError Field="role" Errors="partyErrors" />
                </fieldset>
            }

            <div class="form-actions">
                <button type="button" class="btn btn-outline-secondary" disabled="@busy" @onclick="() => GoAsync(0)">@Texts.Get("contracts.wizard.back")</button>
                <button type="submit" class="btn btn-primary" disabled="@busy">@Texts.Get(contract is null ? "contracts.wizard.createAndContinue" : "contracts.wizard.saveAndContinue")</button>
            </div>
        </form>
    }
    else if (step == 2)
    {
        <section class="record-form" aria-labelledby="step-title">
            <h2 id="step-title" tabindex="-1" @ref="stepHeading">@Texts.Get("contracts.detail.linesTitle")</h2>
            @if (lines.Count == 0) { <p class="text-muted">@Texts.Get("contracts.wizard.noLines")</p> }
            else
            {
                <table class="table record-table">
                    <caption class="visually-hidden">@Texts.Get("contracts.detail.linesCaption")</caption>
                    <thead><tr><th scope="col">@Texts.Get("crm.quoteDetail.col.line")</th><th scope="col" class="text-end">@Texts.Get("crm.quoteDetail.col.quantity")</th><th scope="col" class="text-end">@Texts.Get("crm.quoteDetail.col.unitPrice")</th><th scope="col" class="text-end">@Texts.Get("contracts.wizard.vatPercent")</th><th scope="col"><span class="visually-hidden">@Texts.Get("crm.quoteApprovals.col.action")</span></th></tr></thead>
                    <tbody>
                        @foreach (var l in lines)
                        {
                            <tr>
                                <td data-label="@Texts.Get("crm.quoteDetail.col.line")" class="primary">@l.Name</td>
                                <td data-label="@Texts.Get("crm.quoteDetail.col.quantity")" class="text-end">@l.Quantity.ToString("0.##", Regional.Numbers) @l.UnitName</td>
                                <td data-label="@Texts.Get("crm.quoteDetail.col.unitPrice")" class="text-end">@(Session.Can(ContractsAccess.FinancialsRead) ? ContractLabels.Money(l.UnitPrice, contract!.Currency) : "—")</td>
                                <td data-label="@Texts.Get("contracts.wizard.vatPercent")" class="text-end">@l.TaxRatePercent.ToString("0.##", Regional.Numbers)</td>
                                <td><button type="button" class="btn btn-link btn-sm text-danger" disabled="@busy" @onclick="() => DeleteLineAsync(l)" aria-label="@Texts.Get("contracts.wizard.removeLine", l.Name)">@Texts.Get("contracts.signaturePanel.remove")</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (Session.Can(ContractsAccess.FinancialsRead)) { <p><strong>@Texts.Get("contracts.wizard.grandTotalLabel")</strong> @ContractLabels.Money(contract!.GrossTotal, contract.Currency)</p> }
            }

            <form class="wizard-sub" novalidate @onsubmit="AddLineAsync" @onsubmit:preventDefault>
                <h3 class="h6">@Texts.Get("crm.quoteDetail.addLine")</h3>
                <div class="row g-2">
                    <div class="col-md-5">
                        <label class="form-label required" for="l-name">@Texts.Get("common.field.name")</label>
                        <input id="l-name" class="form-control" maxlength="200" required aria-required="true" @bind="lineName" aria-invalid="@(lineErrors?.ContainsKey("name") == true)" />
                        <FieldError Field="name" Errors="lineErrors" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label" for="l-qty">@Texts.Get("crm.quoteDetail.col.quantity")</label>
                        <input id="l-qty" class="form-control" type="number" step="any" min="0" @bind="lineQuantity" />
                        <FieldError Field="quantity" Errors="lineErrors" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label" for="l-unit">@Texts.Get("contracts.field.unitname")</label>
                        <input id="l-unit" class="form-control" maxlength="30" @bind="lineUnit" />
                    </div>
                    @if (Session.Can(ContractsAccess.FinancialsRead))
                    {
                        <div class="col-md-2">
                            <label class="form-label" for="l-price">@Texts.Get("crm.quoteDetail.col.unitPrice")</label>
                            <input id="l-price" class="form-control" type="number" step="any" min="0" @bind="linePrice" />
                            <FieldError Field="unitPrice" Errors="lineErrors" />
                        </div>
                        <div class="col-md-1">
                            <label class="form-label" for="l-tax">@Texts.Get("contracts.wizard.vatPercent")</label>
                            <input id="l-tax" class="form-control" type="number" step="any" min="0" max="100" @bind="lineTax" />
                            <FieldError Field="taxRatePercent" Errors="lineErrors" />
                        </div>
                    }
                </div>
                <div class="form-actions"><button type="submit" class="btn btn-outline-secondary" disabled="@busy">@Texts.Get("contracts.wizard.addLineSubmit")</button></div>
            </form>

            <div class="form-actions">
                <button type="button" class="btn btn-outline-secondary" disabled="@busy" @onclick="() => GoAsync(1)">@Texts.Get("contracts.wizard.back")</button>
                <button type="button" class="btn btn-primary" disabled="@busy" @onclick="() => GoAsync(3)">@Texts.Get("contracts.wizard.continue")</button>
            </div>
        </section>
    }
    else if (step == 3)
    {
        <form class="record-form" novalidate @onsubmit="() => NextAsync(4)" @onsubmit:preventDefault aria-labelledby="step-title">
            <h2 id="step-title" tabindex="-1" @ref="stepHeading">@Texts.Get("contracts.wizard.step.dates")</h2>
            <ErrorSummary Errors="errors" />
            <div @oninput="() => dirty = true" @onchange="() => dirty = true">
                <div class="row g-2">
                    <div class="col-md-4">
                        <label class="form-label" for="d-start">@Texts.Get("contracts.field.startdate")</label>
                        <input id="d-start" type="date" class="form-control" @bind="form.StartDate" aria-invalid="@(errors?.ContainsKey("startDate") == true)" />
                        <FieldError Field="startDate" Errors="errors" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="d-end">@Texts.Get("contracts.field.enddate")</label>
                        <input id="d-end" type="date" class="form-control" @bind="form.EndDate" disabled="@form.IsIndefinite" aria-invalid="@(errors?.ContainsKey("endDate") == true)" />
                        <FieldError Field="endDate" Errors="errors" />
                    </div>
                    <div class="col-md-4 d-flex align-items-end">
                        <div class="form-check">
                            <input id="d-indef" type="checkbox" class="form-check-input" @bind="form.IsIndefinite" />
                            <label class="form-check-label" for="d-indef">@Texts.Get("contracts.indefinite")</label>
                        </div>
                    </div>
                </div>
                <div class="row g-2">
                    <div class="col-md-4">
                        <label class="form-label" for="d-renewal">@Texts.Get("contracts.field.renewalmode")</label>
                        <select id="d-renewal" class="form-select" @bind="form.RenewalMode">
                            @foreach (var m in ContractLabels.RenewalModes) { <option value="@m.Key">@m.Label</option> }
                        </select>
                        <FieldError Field="renewalMode" Errors="errors" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="d-period">@Texts.Get("contracts.field.renewalperiodmonths")</label>
                        <input id="d-period" type="number" min="1" max="120" class="form-control" @bind="form.RenewalPeriodMonths" disabled="@(form.RenewalMode == "None")" />
                        <FieldError Field="renewalPeriodMonths" Errors="errors" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="d-notice">@Texts.Get("contracts.field.noticeperioddays")</label>
                        <input id="d-notice" type="number" min="0" max="3650" class="form-control" @bind="form.NoticePeriodDays" />
                        <FieldError Field="noticePeriodDays" Errors="errors" />
                    </div>
                </div>
                <div>
                    <label class="form-label" for="escalationUserId">@Texts.Get("contracts.wizard.renewalEscalation")</label>
                    <LookupPicker Id="escalationUserId" LookupKey="contracts.contract.escalation" @bind-Value="form.EscalationUserId" Placeholder="—" />
                    <small class="text-muted">@Texts.Get("contracts.detail.escalationHelp")</small>
                </div>
                <div class="row g-2">
                    <div class="col-md-4">
                        <label class="form-label" for="d-currency">@Texts.Get("contracts.field.currency")</label>
                        <input id="d-currency" class="form-control" maxlength="3" @bind="form.Currency" aria-invalid="@(errors?.ContainsKey("currency") == true)" />
                        <FieldError Field="currency" Errors="errors" />
                    </div>
                    @if (Session.Can(ContractsAccess.FinancialsRead))
                    {
                        <div class="col-md-4">
                            <label class="form-label" for="d-value">@Texts.Get("contracts.field.contractvalue")</label>
                            <input id="d-value" type="number" step="any" min="0" class="form-control" @bind="form.ContractValue" />
                            <FieldError Field="contractValue" Errors="errors" />
                        </div>
                    }
                    <div class="col-md-4 d-flex align-items-end">
                        <div class="form-check">
                            <input id="d-tax" type="checkbox" class="form-check-input" @bind="form.PriceIncludesTax" />
                            <label class="form-check-label" for="d-tax">@Texts.Get("crm.quoteDetail.taxIncluded")</label>
                        </div>
                    </div>
                </div>
                <div>
                    <label class="form-label" for="d-payment">@Texts.Get("contracts.field.paymentterms")</label>
                    <textarea id="d-payment" class="form-control" rows="2" maxlength="2000" @bind="form.PaymentTerms"></textarea>
                    <FieldError Field="paymentTerms" Errors="errors" />
                </div>
            </div>
            <div class="form-actions">
                <button type="button" class="btn btn-outline-secondary" disabled="@busy" @onclick="() => GoAsync(2)">@Texts.Get("contracts.wizard.back")</button>
                <button type="submit" class="btn btn-primary" disabled="@busy">@Texts.Get("contracts.wizard.saveAndContinue")</button>
            </div>
        </form>
    }
    else if (step == 4)
    {
        <section class="record-form" aria-labelledby="step-title">
            <h2 id="step-title" tabindex="-1" @ref="stepHeading">@Texts.Get("contracts.wizard.commitmentsTitle")</h2>
            @if (!Session.Can(ContractsAccess.CommitmentsWrite))
            {
                <p class="text-muted">@Texts.Get("contracts.wizard.noCommitmentPermission")</p>
            }
            else
            {
                @if (commitments.Count == 0) { <p class="text-muted">@Texts.Get("contracts.wizard.noCommitments")</p> }
                else
                {
                    <ul class="list-unstyled">
                        @foreach (var c in commitments)
                        {
                            <li>@Texts.Get("contracts.wizard.commitmentDue", c.Title, ContractLabels.Date(c.DueDate)) <button type="button" class="btn btn-link btn-sm text-danger" disabled="@busy" @onclick="() => DeleteCommitmentAsync(c)" aria-label="@Texts.Get("contracts.wizard.cancelCommitment", c.Title)">@Texts.Get("contracts.commitmentsPanel.cancelConfirm")</button></li>
                        }
                    </ul>
                }

                <form class="wizard-sub" novalidate @onsubmit="AddCommitmentAsync" @onsubmit:preventDefault>
                    <h3 class="h6">@Texts.Get("contracts.wizard.addOneTimeCommitment")</h3>
                    <div class="row g-2">
                        <div class="col-md-5">
                            <label class="form-label required" for="c-title">@Texts.Get("contracts.field.title")</label>
                            <input id="c-title" class="form-control" maxlength="200" required aria-required="true" @bind="commitmentTitle" aria-invalid="@(commitmentErrors?.ContainsKey("title") == true)" />
                            <FieldError Field="title" Errors="commitmentErrors" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="c-category">@Texts.Get("contracts.commitmentsPanel.category")</label>
                            <select id="c-category" class="form-select" @bind="commitmentCategory">
                                <option value="">—</option>
                                @foreach (var c in Lookups.Choices(ContractsAccess.CommitmentCategoryList)) { <option value="@c.Key">@c.Label</option> }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label required" for="c-due">@Texts.Get("contracts.commitments.col.due")</label>
                            <input id="c-due" type="date" class="form-control" required aria-required="true" @bind="commitmentDue" aria-invalid="@(commitmentErrors?.ContainsKey("dueDate") == true)" />
                            <FieldError Field="dueDate" Errors="commitmentErrors" />
                        </div>
                    </div>
                    <div class="form-actions"><button type="submit" class="btn btn-outline-secondary" disabled="@busy">@Texts.Get("contracts.wizard.addCommitment")</button></div>
                </form>
            }

            <div class="form-actions">
                <button type="button" class="btn btn-outline-secondary" disabled="@busy" @onclick="() => GoAsync(3)">@Texts.Get("contracts.wizard.back")</button>
                <button type="button" class="btn btn-primary" disabled="@busy" @onclick="() => GoAsync(5)">@Texts.Get("contracts.wizard.continue")</button>
            </div>
        </section>
    }
    else if (step == 5 && contract is not null)
    {
        <section class="record-form" aria-labelledby="step-title">
            <h2 id="step-title" tabindex="-1" @ref="stepHeading">@Texts.Get("contracts.wizard.step.review")</h2>
            <dl class="summary-list">
                <dt>@Texts.Get("contracts.list.col.contract")</dt><dd>@contract.Title <small class="text-muted">@contract.Number</small></dd>
                <dt>@Texts.Get("contracts.list.col.customer")</dt><dd>@PartyName(contract.PartyId)</dd>
                <dt>@Texts.Get("contracts.wizard.term")</dt><dd>@ContractLabels.Date(contract.StartDate) – @(contract.IsIndefinite ? Texts.Get("contracts.indefinite") : ContractLabels.Date(contract.EndDate))</dd>
                <dt>@Texts.Get("contracts.detail.tab.renewal")</dt><dd>@ContractLabels.Label(ContractLabels.RenewalModes, contract.RenewalMode)@(contract.NoticeDeadline is { } nd ? " · " + Texts.Get("contracts.wizard.noticeSummary", ContractLabels.Date(nd)) : "")</dd>
                <dt>@Texts.Get("contracts.wizard.countsLabel")</dt><dd>@Texts.Get("contracts.wizard.counts", lines.Count, commitments.Count, parties.Count + 1)</dd>
                @if (Session.Can(ContractsAccess.FinancialsRead)) { <dt>@Texts.Get("contracts.field.grosstotal")</dt><dd>@ContractLabels.Money(contract.GrossTotal, contract.Currency)</dd> }
            </dl>

            @if (actions.Any(a => !a.Allowed && WizardActions.Contains(a.Action)))
            {
                <div class="alert alert-warning" role="status">
                    <strong>@Texts.Get("contracts.wizard.missingForSubmit")</strong>
                    <ul class="mb-0">
                        @foreach (var a in actions.Where(a => !a.Allowed && WizardActions.Contains(a.Action)))
                        {
                            <li><strong>@ContractActionLabels.Action(a.Action):</strong> @a.Message</li>
                        }
                    </ul>
                </div>
            }

            @if (Session.Can(ContractsAccess.DocumentsGenerate) && templates.Count > 0)
            {
                <div class="wizard-sub">
                    <label class="form-label" for="r-template">@Texts.Get("contracts.wizard.previewTemplate")</label>
                    <div class="search">
                        <select id="r-template" class="form-select" @bind="templateId">
                            <option value="">@Texts.Get("contracts.detail.chooseTemplate")</option>
                            @foreach (var t in templates) { <option value="@t.Id">@t.Name@(t.IsExample ? " " + Texts.Get("contracts.wizard.exampleText") : "")</option> }
                        </select>
                        <button type="button" class="btn btn-outline-secondary" disabled="@(busy || templateId == "")" @onclick="PreviewAsync">@Texts.Get("contracts.templates.previewButton")</button>
                    </div>
                    @if (preview is not null) { <RenderedDocumentView Preview="preview" /> }
                </div>
            }

            <div class="form-actions" role="group" aria-label="@Texts.Get("contracts.wizard.submitActions")">
                <button type="button" class="btn btn-outline-secondary" disabled="@busy" @onclick="() => GoAsync(4)">@Texts.Get("contracts.wizard.back")</button>
                <a class="btn btn-outline-secondary" href="sozlesmeler/@contract.Id">@Texts.Get("contracts.wizard.leaveAsDraft")</a>
                @foreach (var a in actions.Where(a => a.Allowed && WizardActions.Contains(a.Action)))
                {
                    <button type="button" class="btn @(ContractActionLabels.IsPrimary(a.Action) ? "btn-primary" : "btn-outline-secondary")" disabled="@busy" @onclick="() => RunActionAsync(a)">@ContractActionLabels.Action(a.Action)</button>
                }
            </div>
        </section>
    }
</AuthGate>

@code {
    // Adım adları her okunuşta çevrilir (sözlük sonradan yüklenir, ADR-0034).
    private static string[] Steps =>
    [
        Texts.Get("contracts.wizard.step.source"), Texts.Get("contracts.wizard.step.parties"), Texts.Get("contracts.detail.tab.lines"),
        Texts.Get("contracts.wizard.step.dates"), Texts.Get("contracts.commitmentsPanel.title"), Texts.Get("contracts.wizard.step.review"),
    ];

    private static readonly string[] WizardActions = ["send-to-review", "mark-ready", "submit-for-approval"];

    [SupplyParameterFromQuery(Name = "id")] public Guid? ResumeId { get; set; }

    private ElementReference stepHeading;
    private bool focusHeading;
    private int step;
    private bool loading;
    private bool busy;
    private bool dirty;
    private string? notice;
    private bool noticeFailed;
    private string source = "blank";
    private string templateId = string.Empty;
    private List<ContractTemplateDto> templates = [];
    private List<QuoteDto>? quotes;

    private ContractDto? contract;
    private WizardForm form = new();
    private IReadOnlyDictionary<string, string[]>? errors;
    private List<ContractPartyDto> parties = [];
    private List<ContractLineDto> lines = [];
    private List<ContractCommitmentDto> commitments = [];
    private List<ContractActionDto> actions = [];
    private ContractPreviewDto? preview;
    private readonly Dictionary<Guid, string> partyNames = [];

    private string partyRole = "Signatory";
    private Guid? partyPick;
    private IReadOnlyDictionary<string, string[]>? partyErrors;

    private string lineName = string.Empty;
    private decimal lineQuantity = 1m;
    private string? lineUnit;
    private decimal? linePrice;
    private decimal lineTax = 20m;
    private IReadOnlyDictionary<string, string[]>? lineErrors;

    private string commitmentTitle = string.Empty;
    private string commitmentCategory = string.Empty;
    private DateOnly? commitmentDue;
    private IReadOnlyDictionary<string, string[]>? commitmentErrors;

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (!Session.Can(ContractsAccess.ContractsWrite)) { return; }
        loading = true;
        await Lookups.LoadAsync();
        var published = await Api.GetAsync<PagedResult<ContractTemplateDto>>("/api/contracts/templates?status=Published&pageSize=100");
        templates = [.. published.Value?.Items ?? []];
        if (Session.IsModuleEnabled("crm") && Session.Can(CrmAccess.QuotesRead))
        {
            var accepted = await Api.GetAsync<CrmPage<QuoteDto>>("/api/crm/quotes?status=Accepted&pageSize=20");
            quotes = [.. accepted.Value?.Items ?? []];
        }

        if (ResumeId is { } id)
        {
            var loaded = await Api.GetAsync<ContractDto>($"/api/contracts/contracts/{id}");
            if (loaded.IsSuccess) { await AdoptAsync(loaded.Value!); step = 1; }
            else { Notify(Texts.Get("contracts.wizard.resumeNotFound"), true); }
        }

        loading = false;
    }

    // Adım değişince odak yeni adımın başlığına taşınır: ekran okuyucu ve klavye kullanıcısı nerede olduğunu duyar.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusHeading)
        {
            focusHeading = false;
            await stepHeading.FocusAsync();
        }
    }

    // ---- adım geçişi

    private void TemplateChosen()
    {
        if (templates.FirstOrDefault(t => t.Id.ToString() == templateId) is { ContractType: { Length: > 0 } type })
        {
            form.Type = type;
        }
    }

    private async Task GoAsync(int target)
    {
        if (busy) { return; }
        // Düzenlenmiş form yalnızca ileri adımlara geçerken kaydedilir; geri dönüşte değişiklik kaybolmaz (kaydedilmemiş uyarısı çıkış için vardır).
        if (dirty && contract is not null && (step == 1 || step == 3) && target > step)
        {
            if (!await SaveHeaderAsync()) { return; }
        }

        if (target == 5) { await LoadActionsAsync(); }
        if (target == 2 || target == 4 || target == 5) { await RefreshChildrenAsync(); }
        notice = null;
        step = target;
        focusHeading = true;
    }

    private async Task NextAsync(int target)
    {
        if (busy) { return; }
        if (!await SaveHeaderAsync()) { return; }
        if (target == 2 && templateId != "" && preview is null) { /* şablon seçimi son adımda önizlemeye taşınır */ }
        await GoAsync(target);
    }

    private async Task ConfirmLeaveAsync(LocationChangingContext context)
    {
        if (dirty && !await Js.InvokeAsync<bool>("confirm", Texts.Get("crm.quoteDetail.leaveConfirm")))
        {
            context.PreventNavigation();
        }
    }

    // ---- taslak (başlık)

    private async Task<bool> SaveHeaderAsync()
    {
        // Zorunlu alanlar sunucuya gitmeden de denetlenir (anlaşılır ileti, gereksiz istek yok); asıl doğrulama yine sunucudadır.
        var local = new Dictionary<string, string[]>();
        if (string.IsNullOrWhiteSpace(form.Title)) { local["title"] = [Texts.Get("contracts.wizard.titleRequired")]; }
        if (form.PartyId is null) { local["partyId"] = [Texts.Get("contracts.wizard.partyRequired")]; }
        if (local.Count > 0)
        {
            errors = local;
            Notify(Texts.Get("contracts.wizard.fixFields"), true);
            return false;
        }

        busy = true;
        errors = null;
        var request = new SaveContractRequest(
            form.Title, form.PartyId ?? Guid.Empty, form.Type, Blank(form.Description), form.PersonId, form.OwnerId, null,
            form.StartDate, form.IsIndefinite ? null : form.EndDate, form.IsIndefinite, form.Currency, form.PriceIncludesTax,
            Session.Can(ContractsAccess.FinancialsRead) ? form.ContractValue : null, Blank(form.PaymentTerms), form.RenewalMode,
            form.RenewalMode == "None" ? null : form.RenewalPeriodMonths, form.NoticePeriodDays, form.Confidentiality, form.HasNonStandardTerms, form.RiskLevel, contract?.Version,
            null, form.EscalationUserId);
        var result = contract is { } current
            ? await Api.PutAsync<ContractDto>($"/api/contracts/contracts/{current.Id}", request)
            : await Api.PostAsync<ContractDto>("/api/contracts/contracts", request);
        busy = false;
        if (!result.IsSuccess)
        {
            errors = result.FieldErrors.Count > 0 ? result.FieldErrors : new Dictionary<string, string[]> { ["title"] = [result.Error ?? Texts.Get("common.saveFailed")] };
            Notify(result.FieldErrors.Count > 0 ? Texts.Get("contracts.wizard.fixFields") : result.Error, true);
            return false;
        }

        contract = result.Value;
        dirty = false;
        Notify(Texts.Get("contracts.wizard.draftSaved"), false);
        return true;
    }

    private async Task AdoptAsync(ContractDto c)
    {
        contract = c;
        form = WizardForm.From(c);
        await RefreshChildrenAsync();
    }

    private async Task RefreshChildrenAsync()
    {
        if (contract is not { } c) { return; }
        var fresh = await Api.GetAsync<ContractDto>($"/api/contracts/contracts/{c.Id}");
        if (fresh.IsSuccess) { contract = fresh.Value; }
        parties = [.. (await Api.GetAsync<PagedResult<ContractPartyDto>>($"/api/contracts/contract-parties?contractId={c.Id}&pageSize=100")).Value?.Items ?? []];
        lines = [.. (await Api.GetAsync<PagedResult<ContractLineDto>>($"/api/contracts/contract-lines?contractId={c.Id}&pageSize=200")).Value?.Items ?? []];
        if (Session.Can(ContractsAccess.ContractsRead))
        {
            commitments = [.. ((await Api.GetAsync<PagedResult<ContractCommitmentDto>>($"/api/contracts/commitments?contractId={c.Id}&pageSize=100")).Value?.Items ?? []).Where(x => x.Status == "Active")];
        }

        await ResolvePartyAsync(c.PartyId);
        await ResolveNamesAsync(parties.Select(p => p.PartyId).OfType<Guid>(), "contracts.contract-party.party");
        await ResolveNamesAsync(parties.Select(p => p.PersonId).OfType<Guid>(), "contracts.contract-party.person");
    }

    private async Task ResolvePartyAsync(Guid id)
    {
        if (partyNames.ContainsKey(id)) { return; }
        var resolved = await Api.PostAsync<LookupResolveDto>("/api/lookups/contracts.contract.party/resolve", new ResolveLookupRequest([id]));
        if (resolved.Value?.Items.FirstOrDefault() is { } item) { partyNames[id] = item.Label ?? "—"; }
    }

    private async Task ResolveNamesAsync(IEnumerable<Guid> ids, string key)
    {
        var missing = ids.Distinct().Where(id => !partyNames.ContainsKey(id)).ToList();
        if (missing.Count == 0) { return; }
        var resolved = await Api.PostAsync<LookupResolveDto>($"/api/lookups/{key}/resolve", new ResolveLookupRequest(missing));
        foreach (var item in resolved.Value?.Items ?? []) { partyNames[item.Id] = item.Label ?? "—"; }
    }

    private string PartyName(Guid id) => partyNames.TryGetValue(id, out var name) ? name : "—";

    // ---- taraflar

    private async Task AddPartyAsync()
    {
        if (busy || contract is null || partyPick is null) { return; }
        busy = true;
        partyErrors = null;
        var result = await Api.PostAsync<ContractPartyDto>("/api/contracts/contract-parties", new SaveContractPartyRequest(contract.Id, partyRole, partyPick));
        busy = false;
        if (!result.IsSuccess)
        {
            partyErrors = result.FieldErrors.Count > 0 ? result.FieldErrors : new Dictionary<string, string[]> { ["role"] = [result.Error ?? Texts.Get("contracts.wizard.partyAddFailed")] };
            return;
        }

        partyPick = null;
        await RefreshChildrenAsync();
    }

    private async Task DeletePartyAsync(ContractPartyDto p)
    {
        if (busy) { return; }
        busy = true;
        var result = await Api.DeleteAsync($"/api/contracts/contract-parties/{p.Id}?version={p.Version}");
        busy = false;
        if (!result.IsSuccess) { Notify(result.Error, true); return; }
        await RefreshChildrenAsync();
    }

    // ---- kalemler

    private async Task AddLineAsync()
    {
        if (busy || contract is null) { return; }
        busy = true;
        lineErrors = null;
        var financial = Session.Can(ContractsAccess.FinancialsRead);
        var result = await Api.PostAsync<ContractLineDto>("/api/contracts/contract-lines", new SaveContractLineRequest(
            contract.Id, lineName.Trim(), Quantity: lineQuantity, UnitName: Blank(lineUnit), UnitPrice: financial ? linePrice : null, TaxRatePercent: financial ? lineTax : 0m));
        busy = false;
        if (!result.IsSuccess)
        {
            lineErrors = result.FieldErrors.Count > 0 ? result.FieldErrors : new Dictionary<string, string[]> { ["name"] = [result.Error ?? Texts.Get("contracts.wizard.lineAddFailed")] };
            return;
        }

        lineName = string.Empty;
        lineQuantity = 1m;
        lineUnit = null;
        linePrice = null;
        await RefreshChildrenAsync();
    }

    private async Task DeleteLineAsync(ContractLineDto line)
    {
        if (busy) { return; }
        busy = true;
        var result = await Api.DeleteAsync($"/api/contracts/contract-lines/{line.Id}?version={line.Version}");
        busy = false;
        if (!result.IsSuccess) { Notify(result.Error, true); return; }
        await RefreshChildrenAsync();
    }

    // ---- taahhütler

    private async Task AddCommitmentAsync()
    {
        if (busy || contract is null) { return; }
        busy = true;
        commitmentErrors = null;
        var due = commitmentDue ?? default;
        var result = await Api.PostAsync<ContractCommitmentDto>("/api/contracts/commitments", new SaveContractCommitmentRequest(
            contract.Id, commitmentTitle.Trim(), contract.StartDate ?? DateOnly.FromDateTime(Regional.Now.DateTime), due, Category: Blank(commitmentCategory)));
        busy = false;
        if (!result.IsSuccess || commitmentDue is null)
        {
            commitmentErrors = result.FieldErrors.Count > 0 ? result.FieldErrors
                : new Dictionary<string, string[]> { [commitmentDue is null ? "dueDate" : "title"] = [commitmentDue is null ? Texts.Get("contracts.wizard.dueRequired") : result.Error ?? Texts.Get("contracts.wizard.commitmentAddFailed")] };
            return;
        }

        commitmentTitle = string.Empty;
        commitmentCategory = string.Empty;
        commitmentDue = null;
        await RefreshChildrenAsync();
    }

    private async Task DeleteCommitmentAsync(ContractCommitmentDto c)
    {
        if (busy) { return; }
        busy = true;
        var result = await Api.PostAsync<ContractCommitmentDto>($"/api/contracts/commitments/{c.Id}/cancel", new SignatureReasonRequest("Sihirbazda iptal edildi."));
        busy = false;
        if (!result.IsSuccess) { Notify(result.Error, true); return; }
        await RefreshChildrenAsync();
    }

    // ---- önizleme ve gönderim

    private async Task LoadActionsAsync()
    {
        if (contract is not { } c) { return; }
        actions = [.. (await Api.GetAsync<List<ContractActionDto>>($"/api/contracts/contracts/{c.Id}/actions")).Value ?? []];
    }

    private async Task PreviewAsync()
    {
        if (busy || contract is null || !Guid.TryParse(templateId, out var id)) { return; }
        busy = true;
        var result = await Api.PostAsync<ContractPreviewDto>($"/api/contracts/contracts/{contract.Id}/documents/preview", new PreviewContractDocumentRequest(id));
        busy = false;
        preview = result.Value;
        if (!result.IsSuccess) { Notify(result.Error, true); }
    }

    private async Task RunActionAsync(ContractActionDto action)
    {
        if (busy || contract is null) { return; }
        busy = true;
        var result = await Api.PostAsync<ContractDto>($"/api/contracts/contracts/{contract.Id}/{action.Action}", new ContractTransitionRequest(contract.Version, null));
        busy = false;
        if (!result.IsSuccess) { Notify(result.Error, true); return; }

        // Onaya gönderim süreci sihirbazın dışındadır (onaylayıcılar, imza); diğer adımlar sırayla burada ilerler.
        if (action.Action == "submit-for-approval")
        {
            dirty = false;
            Navigation.NavigateTo($"sozlesmeler/{contract.Id}");
            return;
        }

        await RefreshChildrenAsync();
        await LoadActionsAsync();
        preview = null;
        Notify(Texts.Get("contracts.wizard.actionDone", ContractActionLabels.Action(action.Action)), false);
    }

    private void Notify(string? text, bool failed)
    {
        notice = text;
        noticeFailed = failed;
    }

    private static string? Blank(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private sealed class WizardForm
    {
        public string Title { get; set; } = string.Empty;
        public Guid? PartyId { get; set; }
        public Guid? PersonId { get; set; }
        public Guid? OwnerId { get; set; }
        public Guid? EscalationUserId { get; set; }
        public string Type { get; set; } = "Service";
        public DateOnly? StartDate { get; set; }
        public DateOnly? EndDate { get; set; }
        public bool IsIndefinite { get; set; }
        public string Currency { get; set; } = "TRY";
        public bool PriceIncludesTax { get; set; }
        public decimal? ContractValue { get; set; }
        public string RenewalMode { get; set; } = "None";
        public int? RenewalPeriodMonths { get; set; }
        public int? NoticePeriodDays { get; set; }
        public string Confidentiality { get; set; } = "Internal";
        public bool HasNonStandardTerms { get; set; }
        public string RiskLevel { get; set; } = "Low";
        public string? Description { get; set; }
        public string? PaymentTerms { get; set; }

        public static WizardForm From(ContractDto c) => new()
        {
            Title = c.Title, PartyId = c.PartyId, PersonId = c.PersonId, OwnerId = c.OwnerId, EscalationUserId = c.EscalationUserId, Type = c.Type,
            StartDate = c.StartDate, EndDate = c.EndDate, IsIndefinite = c.IsIndefinite, Currency = c.Currency, PriceIncludesTax = c.PriceIncludesTax,
            ContractValue = c.ContractValue, RenewalMode = c.RenewalMode, RenewalPeriodMonths = c.RenewalPeriodMonths, NoticePeriodDays = c.NoticePeriodDays,
            Confidentiality = c.Confidentiality, HasNonStandardTerms = c.HasNonStandardTerms, RiskLevel = c.RiskLevel, Description = c.Description, PaymentTerms = c.PaymentTerms,
        };
    }
}
