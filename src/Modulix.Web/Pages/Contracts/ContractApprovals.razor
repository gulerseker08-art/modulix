@page "/sozlesmeler/onaylar"
@inject ApiClient Api
@inject SessionState Session
@inject CrmLookups Lookups

<PageTitle>Sözleşme onayları · Modulix</PageTitle>

<AuthGate Module="@ContractsAccess.ModuleKey" Permission="@ContractsAccess.ContractsApprove">
    <div class="page-header">
        <h1>Sözleşme onayları</h1>
    </div>
    <p class="text-muted">
        İç onay bekleyen sözleşmeler. Onay, onaya gönderilirken dondurulan sürüme bağlıdır; adımlar sırayla, aynı adımdaki adlı onaylayıcılar birlikte çalışır.
        Kendi gönderdiğiniz sözleşmeyi ve önceki bir adımda karar verdiğiniz sözleşmenin sonraki adımını onaylayamazsınız. Hedef süre firma ayarlarındandır;
        süre aşımı yalnızca işaretlenir, kararı engellemez.
    </p>

    <Notice Text="@notice" Failed="@noticeFailed" />

    <div class="form-check mb-3">
        <input id="only-mine" class="form-check-input" type="checkbox" checked="@onlyMine" @onchange="ToggleAsync" />
        <label class="form-check-label" for="only-mine">Yalnızca karar verebileceklerim</label>
    </div>

    @if (items is null)
    {
        <p class="text-muted" role="status">Yükleniyor…</p>
    }
    else if (items.Count == 0)
    {
        <p class="text-muted">@(onlyMine ? "Karar vermenizi bekleyen sözleşme yok." : "Onay bekleyen sözleşme yok.")</p>
    }
    else
    {
        <table class="table record-table">
            <caption class="visually-hidden">Onay bekleyen sözleşmeler</caption>
            <thead>
                <tr>
                    <th scope="col">Sözleşme</th><th scope="col">Gönderen</th><th scope="col">Hedef süre</th><th scope="col">Adım</th>
                    <th scope="col">Bekleyenler</th><th scope="col">İşlem</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in items)
                {
                    <tr>
                        <td data-label="Sözleşme" class="primary">
                            <a href="sozlesmeler/@item.ContractId">@item.Title</a> <small class="text-muted">@item.Number · V@(item.VersionNo)</small>
                            @if (item.Rules.Count > 0) { <div class="small text-muted">@string.Join(", ", item.Rules)</div> }
                        </td>
                        <td data-label="Gönderen">@Lookups.MemberName(item.SubmittedBy)<br /><small class="text-muted">@(item.SubmittedAt is { } at ? CrmLabels.Time(at) : "—")</small></td>
                        <td data-label="Hedef süre">
                            @(item.DueAt is { } due ? CrmLabels.Time(due) : "—")
                            @if (item.IsOverdue) { <span class="badge stage-lost">Gecikti</span> }
                        </td>
                        <td data-label="Adım">@(item.CurrentStep == 0 ? "—" : $"{item.CurrentStep} / {item.StepCount}")</td>
                        <td data-label="Bekleyenler">
                            @if (item.WaitingFor.Count == 0) { <span class="text-muted">Onay izni olan biri</span> }
                            else { @string.Join(", ", item.WaitingFor.Select(w => Lookups.MemberName(w))) }
                        </td>
                        <td class="actions">
                            @if (active?.ContractId == item.ContractId)
                            {
                                <form @onsubmit="() => DecideAsync(item, ContractActionNames.Approve)" @onsubmit:preventDefault>
                                    @if (plan is not null)
                                    {
                                        <div class="small approval-reasons">
                                            <strong>Onay gerekçesi:</strong>
                                            @if (plan.Steps.Count > 1)
                                            {
                                                <div>Adımlar: @foreach (var step in plan.Steps) { <span class="badge stage-@(step.Completed ? "won" : step.IsCurrent ? "qualified" : "open")">@step.Step@(step.Completed ? " ✓" : string.Empty)</span> }</div>
                                            }
                                            @if (plan.ActingAsDelegate) { <div class="text-muted">Bu kararı vekâleten vereceksiniz.</div> }
                                            @foreach (var match in plan.Rules) { <div>@match.Name — @match.Reason</div> }
                                            @if (plan.Rules.Count == 0 && plan.Note is not null) { <div>@plan.Note</div> }
                                            @if (plan.CannotDecideReason is not null) { <div class="text-danger">@plan.CannotDecideReason</div> }
                                        </div>
                                    }
                                    <label class="visually-hidden" for="reason-@item.ContractId">Gerekçe</label>
                                    <input id="reason-@item.ContractId" class="form-control form-control-sm" placeholder="Gerekçe (ret ve geri gönderme için zorunlu)" maxlength="500" @bind="reason" />
                                    <button type="button" class="btn btn-primary btn-sm" disabled="@(busy || cannotDecide)" @onclick="() => DecideAsync(item, ContractActionNames.Approve)">Onayla</button>
                                    <button type="button" class="btn btn-outline-danger btn-sm" disabled="@(busy || cannotDecide)" @onclick="() => DecideAsync(item, ContractActionNames.Reject)">Reddet</button>
                                    <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@(busy || cannotDecide)" @onclick="() => DecideAsync(item, ContractActionNames.Return)">Değişiklik iste</button>
                                    <button type="button" class="btn btn-link btn-sm" @onclick="() => active = null">Vazgeç</button>
                                </form>
                            }
                            else
                            {
                                <button type="button" class="btn btn-outline-primary btn-sm" disabled="@(!item.CanDecide && onlyMine)" @onclick="() => OpenAsync(item)">@(item.CanDecide ? "İncele ve karar ver" : "İncele")</button>
                                @if (!item.CanDecide && item.CannotDecideReason is not null) { <div class="small text-muted">@item.CannotDecideReason</div> }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</AuthGate>

@code {
    private List<ContractApprovalInboxItemDto>? items;
    private ContractApprovalInboxItemDto? active;
    private ContractApprovalDto? plan;
    private bool onlyMine = true;
    private string reason = string.Empty;
    private string? notice;
    private bool noticeFailed;
    private bool busy;

    private bool cannotDecide => plan is { CanDecide: false };

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (Session.Can(ContractsAccess.ContractsApprove))
        {
            await Lookups.LoadAsync();
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        var result = await Api.GetAsync<List<ContractApprovalInboxItemDto>>($"/api/contracts/approvals/inbox?mine={(onlyMine ? "true" : "false")}");
        items = result.Value ?? [];
        Notify(result.IsSuccess ? null : result.Error, !result.IsSuccess);
    }

    private async Task ToggleAsync(ChangeEventArgs e)
    {
        onlyMine = e.Value is true;
        active = null;
        await LoadAsync();
    }

    private async Task OpenAsync(ContractApprovalInboxItemDto item)
    {
        active = item;
        reason = string.Empty;
        plan = (await Api.GetAsync<ContractApprovalDto>($"/api/contracts/contracts/{item.ContractId}/approval")).Value;
    }

    private async Task DecideAsync(ContractApprovalInboxItemDto item, string action)
    {
        if (busy) { return; }
        if (action != ContractActionNames.Approve && string.IsNullOrWhiteSpace(reason))
        {
            Notify("Ret ve değişiklik isteği için gerekçe zorunludur.", true);
            return;
        }

        busy = true;
        // Karar kaydın güncel sürümüne bağlanır: önce sözleşmeyi okuyup sürümünü alırız (eşzamanlı değişimde sunucu 409 verir).
        var current = (await Api.GetAsync<ContractDto>($"/api/contracts/contracts/{item.ContractId}")).Value;
        if (current is null)
        {
            busy = false;
            Notify("Sözleşme okunamadı.", true);
            return;
        }

        var result = await Api.PostAsync<ContractDto>($"/api/contracts/contracts/{item.ContractId}/{action}", new ContractTransitionRequest(current.Version, string.IsNullOrWhiteSpace(reason) ? null : reason.Trim()));
        busy = false;
        Notify(result.IsSuccess ? $"{ContractActionLabels.Action(action)}: tamamlandı." : result.Error, !result.IsSuccess);
        active = null;
        await LoadAsync();
    }

    private void Notify(string? text, bool failed)
    {
        notice = text;
        noticeFailed = failed;
    }
}
