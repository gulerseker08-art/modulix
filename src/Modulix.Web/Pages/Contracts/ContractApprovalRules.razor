@page "/sozlesmeler/onay-kurallari"
@inject ApiClient Api
@inject SessionState Session
@inject CrmLookups Lookups

<PageTitle>@Texts.Get("nav.app.contracts.approval-rules.menu") · Modulix</PageTitle>

<AuthGate Module="@ContractsAccess.ModuleKey" Permission="@ContractsAccess.ApprovalsManage">
    <div class="page-header">
        <h1>@Texts.Get("nav.app.contracts.approval-rules.menu")</h1>
        @if (form is null && delegationForm is null)
        {
            <div class="header-actions">
                <button type="button" class="btn btn-primary" @onclick="NewRule">@Texts.Get("crm.quoteRules.new")</button>
                <button type="button" class="btn btn-outline-primary" @onclick="NewDelegation">@Texts.Get("crm.quoteDelegations.new")</button>
            </div>
        }
    </div>

    <p class="text-muted">
        @Texts.Strong("contracts.approvalRules.intro", Texts.Get("crm.quoteRules.introAll"), Texts.Get("crm.quoteRules.introAny"))
    </p>

    <Notice Text="@message" Failed="@failed" />

    @if (form is not null)
    {
        <form class="record-form" novalidate @onsubmit="SaveRuleAsync" @onsubmit:preventDefault>
            <h2>@(form.Id is null ? Texts.Get("crm.quoteRules.new") : Texts.Get("crm.quoteRules.edit"))</h2>
            <FormTabs Title="@Texts.Get("crm.quoteRules.info")" Label="@Texts.Get("contracts.approvalRules.formSections")">
            <div class="form-grid">
                <div>
                    <label class="form-label" for="r-name">@Texts.Get("common.field.nameRequired")</label>
                    <input id="r-name" class="form-control" maxlength="150" @bind="form.Name" />
                    <FieldError Field="name" Errors="errors" />
                </div>
                <div>
                    <label class="form-label" for="r-step">@Texts.Get("crm.quoteRules.field.step")</label>
                    <input id="r-step" class="form-control" type="number" min="1" max="9" @bind="form.Step" />
                    <FieldError Field="step" Errors="errors" />
                </div>
                <div>
                    <label class="form-label" for="r-priority">@Texts.Get("crm.quoteRules.field.priority")</label>
                    <input id="r-priority" class="form-control" type="number" min="0" @bind="form.Priority" />
                    <FieldError Field="priority" Errors="errors" />
                </div>
                <div>
                    <label class="form-label" for="r-type">@Texts.Get("contracts.approvalRules.field.type")</label>
                    <select id="r-type" class="form-select" @bind="form.ContractType">
                        <option value="">@Texts.Get("crm.quoteRules.field.currencyAll")</option>
                        @foreach (var type in Lookups.Choices(ContractsAccess.ContractTypeList, form.ContractType)) { <option value="@type.Key">@type.Label</option> }
                    </select>
                    <FieldError Field="contractType" Errors="errors" />
                </div>
                <div>
                    <label class="form-label" for="r-gross">@Texts.Get("contracts.approvalRules.field.gross")</label>
                    <input id="r-gross" class="form-control" type="number" step="0.01" min="0" @bind="form.MinGrossTotal" />
                    <FieldError Field="minGrossTotal" Errors="errors" />
                </div>
                <div>
                    <label class="form-label" for="r-currency">@Texts.Get("crm.quoteRules.field.currency")</label>
                    <input id="r-currency" class="form-control" maxlength="3" placeholder="@Texts.Get("crm.quoteRules.field.currencyAll")" @bind="form.Currency" />
                    <FieldError Field="currency" Errors="errors" />
                </div>
                <div>
                    <label class="form-label" for="r-discount">@Texts.Get("contracts.approvalRules.field.discount")</label>
                    <input id="r-discount" class="form-control" type="number" step="any" min="0" max="99.99" @bind="form.MinDiscountPercent" />
                    <FieldError Field="minDiscountPercent" Errors="errors" />
                </div>
                <div>
                    <label class="form-label" for="r-term">@Texts.Get("contracts.approvalRules.field.term")</label>
                    <input id="r-term" class="form-control" type="number" min="0" max="1200" @bind="form.MinTermMonths" />
                    <FieldError Field="minTermMonths" Errors="errors" />
                    <div class="form-text">@Texts.Get("contracts.approvalRules.field.termHelp")</div>
                </div>
                <div>
                    <label class="form-label" for="r-risk">@Texts.Get("contracts.approvalRules.field.risk")</label>
                    <select id="r-risk" class="form-select" @bind="form.MinRiskLevel">
                        <option value="">@Texts.Get("contracts.approvalRules.noCondition")</option>
                        @foreach (var level in ContractLabels.RiskLevels) { <option value="@level.Key">@level.Label</option> }
                    </select>
                    <FieldError Field="minRiskLevel" Errors="errors" />
                </div>
                <div class="form-check">
                    <input id="r-nonstd" class="form-check-input" type="checkbox" @bind="form.RequiresNonStandardTerms" />
                    <label class="form-check-label" for="r-nonstd">@Texts.Get("contracts.approvalRules.field.nonStandard")</label>
                </div>
                <div>
                    <label class="form-label" for="approverId">@Texts.Get("contracts.approvalRules.field.approver")</label>
                    <LookupPicker Id="approverId" LookupKey="contracts.approval-rule.approver" @bind-Value="form.ApproverId" Placeholder="@Texts.Get("crm.quoteRules.anyApprover")"
                                  Invalid="@(errors?.ContainsKey("approverId") == true)" />
                    <FieldError Field="approverId" Errors="errors" />
                </div>
                <div class="form-check">
                    <input id="r-active" class="form-check-input" type="checkbox" @bind="form.IsActive" />
                    <label class="form-check-label" for="r-active">@Texts.Get("crm.quoteRules.field.active")</label>
                </div>
                <div class="wide">
                    <label class="form-label" for="r-description">@Texts.Get("common.field.description")</label>
                    <textarea id="r-description" class="form-control" rows="2" maxlength="500" @bind="form.Description"></textarea>
                </div>
            </div>
            </FormTabs>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary" disabled="@busy">@Texts.Get("common.save")</button>
                <button type="button" class="btn btn-outline-secondary" @onclick="CancelRule">@Texts.Get("common.dismiss")</button>
                @if (form.Id is not null)
                {
                    <button type="button" class="btn btn-outline-danger ms-auto" disabled="@busy" @onclick="DeleteRuleAsync">@Texts.Get("common.delete")</button>
                }
            </div>
        </form>
    }

    @if (delegationForm is not null)
    {
        <form class="record-form" novalidate @onsubmit="SaveDelegationAsync" @onsubmit:preventDefault>
            <h2>@(delegationForm.Id is null ? Texts.Get("crm.quoteDelegations.new") : Texts.Get("crm.quoteDelegations.edit"))</h2>
            <p class="text-muted">@Texts.Get("contracts.approvalRules.delegationIntro")</p>
            <FormTabs Title="@Texts.Get("crm.quoteDelegations.info")" Label="@Texts.Get("contracts.approvalRules.delegationSections")">
            <div class="form-grid">
                <div>
                    <label class="form-label" for="fromUserId">@Texts.Get("crm.quoteDelegations.field.from")</label>
                    <LookupPicker Id="fromUserId" LookupKey="contracts.approval-delegation.from" @bind-Value="delegationForm.FromUserId" Required="true"
                                  Invalid="@(delegationErrors?.ContainsKey("fromUserId") == true)" />
                    <FieldError Field="fromUserId" Errors="delegationErrors" />
                </div>
                <div>
                    <label class="form-label" for="toUserId">@Texts.Get("crm.quoteDelegations.field.to")</label>
                    <LookupPicker Id="toUserId" LookupKey="contracts.approval-delegation.to" @bind-Value="delegationForm.ToUserId" Required="true"
                                  Invalid="@(delegationErrors?.ContainsKey("toUserId") == true)" />
                    <FieldError Field="toUserId" Errors="delegationErrors" />
                </div>
                <div>
                    <label class="form-label" for="d-start">@Texts.Get("crm.quoteDelegations.field.start")</label>
                    <input id="d-start" class="form-control" type="datetime-local" @bind="delegationForm.StartsAt" />
                    <FieldError Field="startsAt" Errors="delegationErrors" />
                </div>
                <div>
                    <label class="form-label" for="d-end">@Texts.Get("crm.quoteDelegations.field.end")</label>
                    <input id="d-end" class="form-control" type="datetime-local" @bind="delegationForm.EndsAt" />
                    <FieldError Field="endsAt" Errors="delegationErrors" />
                </div>
                <div class="form-check">
                    <input id="d-active" class="form-check-input" type="checkbox" @bind="delegationForm.IsActive" />
                    <label class="form-check-label" for="d-active">@Texts.Get("crm.quoteDelegations.active")</label>
                </div>
                <div class="wide">
                    <label class="form-label" for="d-note">@Texts.Get("crm.quoteDelegations.field.note")</label>
                    <input id="d-note" class="form-control" maxlength="300" @bind="delegationForm.Note" />
                </div>
            </div>
            </FormTabs>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary" disabled="@busy">@Texts.Get("common.save")</button>
                <button type="button" class="btn btn-outline-secondary" @onclick="() => delegationForm = null">@Texts.Get("common.dismiss")</button>
                @if (delegationForm.Id is not null)
                {
                    <button type="button" class="btn btn-outline-danger ms-auto" disabled="@busy" @onclick="DeleteDelegationAsync">@Texts.Get("common.delete")</button>
                }
            </div>
        </form>
    }

    <section aria-labelledby="rules-title">
        <h2 id="rules-title">@Texts.Get("contracts.approvalRules.rules")</h2>
        @if (rules is null)
        {
            <LoadingState Kind="LoadingKind.Table" />
        }
        else if (rules.Count == 0)
        {
            <EmptyState Title="@Texts.Get("contracts.approvalRules.none")" />
        }
        else
        {
            <table class="table record-table">
                <caption class="visually-hidden">@Texts.Get("nav.app.contracts.approval-rules.menu")</caption>
                <thead><tr><th scope="col">@Texts.Get("crm.quoteRules.col.rule")</th><th scope="col">@Texts.Get("crm.quoteRules.col.step")</th><th scope="col">@Texts.Get("crm.quoteRules.col.conditionsAll")</th><th scope="col">@Texts.Get("contracts.approvalRules.col.approver")</th><th scope="col">@Texts.Get("common.field.status")</th><th scope="col"></th></tr></thead>
                <tbody>
                    @foreach (var rule in rules)
                    {
                        <tr>
                            <td data-label="@Texts.Get("crm.quoteRules.col.rule")" class="primary">@rule.Name <small class="text-muted">@Texts.Get("crm.quoteRules.priorityVersion", rule.Priority, rule.Version)</small>
                                @if (!string.IsNullOrWhiteSpace(rule.Description)) { <div class="small text-muted">@rule.Description</div> }</td>
                            <td data-label="@Texts.Get("crm.quoteRules.col.step")">@rule.Step</td>
                            <td data-label="@Texts.Get("crm.quoteRules.col.conditions")">@Conditions(rule)</td>
                            <td data-label="@Texts.Get("contracts.approvalRules.col.approver")">@(rule.ApproverId is null ? Texts.Get("crm.quoteRules.anyApprover") : Lookups.MemberName(rule.ApproverId))</td>
                            <td data-label="@Texts.Get("common.field.status")">@(rule.IsActive ? Texts.Get("crm.quoteRules.active") : Texts.Get("common.inactive"))</td>
                            <td class="actions"><button type="button" class="btn btn-outline-primary btn-sm" @onclick="() => EditRule(rule)">@Texts.Get("common.edit")</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>

    <section aria-labelledby="delegations-title">
        <h2 id="delegations-title">@Texts.Get("contracts.approvalRules.delegations")</h2>
        @if (delegations is null)
        {
            <LoadingState Kind="LoadingKind.Table" />
        }
        else if (delegations.Count == 0)
        {
            <EmptyState Title="@Texts.Get("contracts.approvalRules.noDelegations")" />
        }
        else
        {
            <table class="table record-table">
                <caption class="visually-hidden">@Texts.Get("contracts.approvalRules.delegationsCaption")</caption>
                <thead><tr><th scope="col">@Texts.Get("crm.quoteDelegations.col.from")</th><th scope="col">@Texts.Get("crm.quoteDelegations.col.to")</th><th scope="col">@Texts.Get("contracts.approvalRules.col.period")</th><th scope="col">@Texts.Get("common.field.status")</th><th scope="col"></th></tr></thead>
                <tbody>
                    @foreach (var item in delegations)
                    {
                        <tr>
                            <td data-label="@Texts.Get("crm.quoteDelegations.col.from")" class="primary">@Lookups.MemberName(item.FromUserId) @if (!string.IsNullOrWhiteSpace(item.Note)) { <div class="small text-muted">@item.Note</div> }</td>
                            <td data-label="@Texts.Get("crm.quoteDelegations.col.to")">@Lookups.MemberName(item.ToUserId)</td>
                            <td data-label="@Texts.Get("contracts.approvalRules.col.period")">@CrmLabels.Time(item.StartsAt) – @(item.EndsAt is { } end ? CrmLabels.Time(end) : Texts.Get("crm.quoteDelegations.openEnded"))</td>
                            <td data-label="@Texts.Get("common.field.status")">@DelegationState(item)</td>
                            <td class="actions"><button type="button" class="btn btn-outline-primary btn-sm" @onclick="() => EditDelegation(item)">@Texts.Get("common.edit")</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>
</AuthGate>

@code {
    private const string RulesUrl = "/api/contracts/approval-rules";
    private const string DelegationsUrl = "/api/contracts/approval-delegations";

    private List<ContractApprovalRuleDto>? rules;
    private List<ContractApprovalDelegationDto>? delegations;
    private RuleForm? form;
    private DelegationForm? delegationForm;
    private IReadOnlyDictionary<string, string[]>? errors;
    private IReadOnlyDictionary<string, string[]>? delegationErrors;
    private string? message;
    private bool failed;
    private bool busy;

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (Session.Can(ContractsAccess.ApprovalsManage))
        {
            await Lookups.LoadAsync();
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        var (loadedRules, ruleError) = await Api.GetAllAsync<ContractApprovalRuleDto>(RulesUrl);
        rules = loadedRules;
        var (loadedDelegations, delegationError) = await Api.GetAllAsync<ContractApprovalDelegationDto>(DelegationsUrl);
        delegations = loadedDelegations;
        Notify(ruleError ?? delegationError, (ruleError ?? delegationError) is not null);
    }

    private string Conditions(ContractApprovalRuleDto rule)
    {
        var parts = new List<string>();
        // Tutar ve yüzde önceki gibi biçimlenip metne verilir; koşullar "{0} ve {1}" ile birleşir.
        if (rule.MinGrossTotal is { } gross) { parts.Add(Texts.Get("contracts.approvalRules.cond.gross", gross.ToString("N2"), rule.Currency ?? Texts.Get("crm.quoteRules.anyCurrency"))); }
        if (rule.MinDiscountPercent is { } percent) { parts.Add(Texts.Get("contracts.approvalRules.cond.discount", percent.ToString("0.##"))); }
        if (rule.MinTermMonths is { } term) { parts.Add(Texts.Get("contracts.approvalRules.cond.term", term)); }
        if (rule.RequiresNonStandardTerms) { parts.Add(Texts.Get("contracts.approvalRules.cond.nonStandard")); }
        if (rule.MinRiskLevel is { Length: > 0 } risk) { parts.Add(Texts.Get("contracts.approvalRules.cond.risk", ContractLabels.Label(ContractLabels.RiskLevels, risk))); }
        if (rule.ContractType is { Length: > 0 } type) { parts.Add(Texts.Get("contracts.approvalRules.cond.type", Lookups.Label(ContractsAccess.ContractTypeList, type))); }
        return parts.Count == 0 ? string.Empty : parts.Aggregate((left, right) => Texts.Get("crm.quoteRules.cond.both", left, right));
    }

    private static string DelegationState(ContractApprovalDelegationDto item)
    {
        var now = DateTimeOffset.UtcNow;
        return !item.IsActive ? Texts.Get("common.inactive")
            : item.StartsAt > now ? Texts.Get("contracts.approvalRules.notStarted")
            : item.EndsAt is { } end && end <= now ? Texts.Get("crm.quoteDelegations.expired")
            : Texts.Get("contracts.approvalRules.valid");
    }

    private void NewRule()
    {
        form = new RuleForm();
        errors = null;
        Notify(null, false);
    }

    private void EditRule(ContractApprovalRuleDto rule)
    {
        form = new RuleForm
        {
            Id = rule.Id, Version = rule.Version, Name = rule.Name, Description = rule.Description, Priority = rule.Priority, Step = rule.Step, IsActive = rule.IsActive,
            ContractType = rule.ContractType ?? string.Empty, Currency = rule.Currency, MinGrossTotal = rule.MinGrossTotal, MinDiscountPercent = rule.MinDiscountPercent,
            MinTermMonths = rule.MinTermMonths, RequiresNonStandardTerms = rule.RequiresNonStandardTerms, MinRiskLevel = rule.MinRiskLevel ?? string.Empty, ApproverId = rule.ApproverId,
        };
        errors = null;
        Notify(null, false);
    }

    private void CancelRule()
    {
        form = null;
        errors = null;
    }

    private async Task SaveRuleAsync()
    {
        if (busy || form is null) { return; }
        busy = true;
        var f = form;
        var request = new SaveContractApprovalRuleRequest(
            f.Name, Blank(f.Description), f.Priority, f.Step, f.IsActive, Blank(f.ContractType), Blank(f.Currency)?.ToUpperInvariant(), f.MinGrossTotal, f.MinDiscountPercent,
            f.MinTermMonths, f.RequiresNonStandardTerms, Blank(f.MinRiskLevel), f.ApproverId, f.Version);
        var result = f.Id is { } id
            ? await Api.PutAsync<ContractApprovalRuleDto>($"{RulesUrl}/{id}", request)
            : await Api.PostAsync<ContractApprovalRuleDto>(RulesUrl, request);
        busy = false;
        if (result.IsSuccess)
        {
            form = null;
            errors = null;
            Notify(Texts.Get("crm.quoteRules.saved"), false);
            await LoadAsync();
            return;
        }

        errors = result.FieldErrors;
        Notify(result.Status == System.Net.HttpStatusCode.Conflict ? Texts.Get("crm.quoteDetail.conflictRetry", result.Error) : result.Error, true);
    }

    private async Task DeleteRuleAsync()
    {
        if (busy || form is null) { return; }
        busy = true;
        var result = await Api.DeleteAsync($"{RulesUrl}/{form.Id}?version={form.Version}");
        busy = false;
        Notify(result.IsSuccess ? Texts.Get("crm.quoteRules.deleted") : result.Error, !result.IsSuccess);
        if (result.IsSuccess)
        {
            form = null;
            await LoadAsync();
        }
    }

    private void NewDelegation()
    {
        delegationForm = new DelegationForm { StartsAt = DateTime.Now };
        delegationErrors = null;
        Notify(null, false);
    }

    private void EditDelegation(ContractApprovalDelegationDto item)
    {
        delegationForm = new DelegationForm
        {
            Id = item.Id, Version = item.Version, FromUserId = item.FromUserId, ToUserId = item.ToUserId, StartsAt = item.StartsAt.LocalDateTime,
            EndsAt = item.EndsAt?.LocalDateTime, IsActive = item.IsActive, Note = item.Note,
        };
        delegationErrors = null;
        Notify(null, false);
    }

    private async Task SaveDelegationAsync()
    {
        if (busy || delegationForm is null) { return; }
        busy = true;
        var d = delegationForm;
        var request = new SaveContractApprovalDelegationRequest(
            d.FromUserId ?? Guid.Empty, d.ToUserId ?? Guid.Empty, d.StartsAt is { } s ? new DateTimeOffset(s) : null, d.EndsAt is { } e ? new DateTimeOffset(e) : null,
            d.IsActive, Blank(d.Note), d.Version);
        var result = d.Id is { } id
            ? await Api.PutAsync<ContractApprovalDelegationDto>($"{DelegationsUrl}/{id}", request)
            : await Api.PostAsync<ContractApprovalDelegationDto>(DelegationsUrl, request);
        busy = false;
        if (result.IsSuccess)
        {
            delegationForm = null;
            delegationErrors = null;
            Notify(Texts.Get("crm.quoteDelegations.saved"), false);
            await LoadAsync();
            return;
        }

        delegationErrors = result.FieldErrors;
        Notify(result.Error, true);
    }

    private async Task DeleteDelegationAsync()
    {
        if (busy || delegationForm is null) { return; }
        busy = true;
        var result = await Api.DeleteAsync($"{DelegationsUrl}/{delegationForm.Id}?version={delegationForm.Version}");
        busy = false;
        Notify(result.IsSuccess ? Texts.Get("crm.quoteDelegations.deleted") : result.Error, !result.IsSuccess);
        if (result.IsSuccess)
        {
            delegationForm = null;
            await LoadAsync();
        }
    }

    private void Notify(string? text, bool isFailure)
    {
        message = text;
        failed = isFailure;
    }

    private static string? Blank(string? text) => string.IsNullOrWhiteSpace(text) ? null : text.Trim();

    private sealed class RuleForm
    {
        public Guid? Id { get; init; }
        public long? Version { get; init; }
        public string Name { get; set; } = string.Empty;
        public string? Description { get; set; }
        public int Priority { get; set; }
        public int Step { get; set; } = 1;
        public bool IsActive { get; set; } = true;
        public string? ContractType { get; set; } = string.Empty;
        public string? Currency { get; set; }
        public decimal? MinGrossTotal { get; set; }
        public decimal? MinDiscountPercent { get; set; }
        public int? MinTermMonths { get; set; }
        public bool RequiresNonStandardTerms { get; set; }
        public string? MinRiskLevel { get; set; } = string.Empty;
        public Guid? ApproverId { get; set; }
    }

    private sealed class DelegationForm
    {
        public Guid? Id { get; init; }
        public long? Version { get; init; }
        public Guid? FromUserId { get; set; }
        public Guid? ToUserId { get; set; }
        public DateTime? StartsAt { get; set; }
        public DateTime? EndsAt { get; set; }
        public bool IsActive { get; set; } = true;
        public string? Note { get; set; }
    }
}
