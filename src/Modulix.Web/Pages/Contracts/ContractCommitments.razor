@page "/sozlesmeler/taahhutler"
@inject ApiClient Api
@inject SessionState Session
@inject CrmLookups Lookups

<PageTitle>@Texts.Get("contracts.commitments.title") · Modulix</PageTitle>

<AuthGate Module="@ContractsAccess.ModuleKey" Permission="@ContractsAccess.ContractsRead">
    <div class="page-header">
        <h1>@Texts.Get("contracts.commitments.title")</h1>
    </div>
    <p class="text-muted">@Texts.Get("contracts.commitments.intro")</p>

    <Notice Text="@notice" Failed="true" />

    <div class="filters">
        <div class="form-check">
            <input id="cl-mine" class="form-check-input" type="checkbox" checked="@mine" @onchange="ToggleMineAsync" />
            <label class="form-check-label" for="cl-mine">@Texts.Get("contracts.commitments.onlyMine")</label>
        </div>
        <div>
            <label class="form-label" for="cl-status">@Texts.Get("common.field.status")</label>
            <select id="cl-status" class="form-select" value="@status" @onchange="FilterAsync">
                <option value="Overdue">@Texts.Get("contracts.commitments.overdue")</option>
                @foreach (var key in FilterStatuses) { <option value="@key">@CommitmentLabels.Label(CommitmentLabels.OccurrenceStatuses, key)</option> }
                <option value="">@Texts.Get("crm.pending.view.all")</option>
            </select>
        </div>
    </div>

    @if (items is null)
    {
        <LoadingState Kind="LoadingKind.Table" />
    }
    else if (items.Count == 0)
    {
        <EmptyState Title="@Texts.Get("contracts.commitments.empty")" />
    }
    else
    {
        <table class="table record-table">
            <caption class="visually-hidden">@Texts.Get("contracts.commitments.caption")</caption>
            <thead><tr><th scope="col">@Texts.Get("contracts.commitments.col.commitment")</th><th scope="col">@Texts.Get("contracts.list.col.contract")</th><th scope="col">@Texts.Get("contracts.commitments.col.period")</th><th scope="col">@Texts.Get("contracts.commitments.col.due")</th><th scope="col">@Texts.Get("common.field.status")</th><th scope="col">@Texts.Get("common.field.owner")</th></tr></thead>
            <tbody>
                @foreach (var o in items)
                {
                    <tr>
                        <td data-label="@Texts.Get("contracts.commitments.col.commitment")" class="primary">@o.CommitmentTitle <small class="text-muted">@Lookups.Label(ContractsAccess.CommitmentCategoryList, o.Category)</small></td>
                        <td data-label="@Texts.Get("contracts.list.col.contract")"><a href="sozlesmeler/@o.ContractId">@o.ContractTitle</a> <small class="text-muted">@o.ContractNumber</small></td>
                        <td data-label="@Texts.Get("contracts.commitments.col.period")">@o.Sequence</td>
                        <td data-label="@Texts.Get("contracts.commitments.col.due")">@ContractLabels.Date(o.DueDate)@if (o.IsOverdue) { <div class="small text-danger">@Texts.Get("contracts.commitments.daysOverdue", o.DaysOverdue)</div> }</td>
                        <td data-label="@Texts.Get("common.field.status")"><span class="badge stage-@CommitmentLabels.Badge(o.Status, o.IsOverdue && o.Status == "Open")">@CommitmentLabels.Label(CommitmentLabels.OccurrenceStatuses, o.Status)</span></td>
                        <td data-label="@Texts.Get("common.field.owner")">@(o.ResponsibleUserId is null ? "—" : Lookups.MemberName(o.ResponsibleUserId))</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</AuthGate>

@code {
    // Süzgeçteki durumlar (Gecikmiş ve Tümü dışında); adları gerçekleşme durumu tablosundan gelir.
    private static readonly string[] FilterStatuses = ["Open", "Breached", "Fulfilled", "Waived"];

    private List<CommitmentOccurrenceDto>? items;
    private bool mine = true;
    private string status = "Overdue";
    private string? notice;

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (Session.Can(ContractsAccess.ContractsRead))
        {
            await Lookups.LoadAsync();
            await LoadAsync();
        }
    }

    private async Task ToggleMineAsync(ChangeEventArgs e)
    {
        mine = e.Value is true;
        await ReloadAsync();
    }

    private async Task FilterAsync(ChangeEventArgs e)
    {
        status = e.Value?.ToString() ?? string.Empty;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        items = null;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var query = $"mine={(mine ? "true" : "false")}&includeClosed={(status is "Fulfilled" or "Waived" or "" ? "true" : "false")}{(status.Length > 0 ? "&status=" + status : string.Empty)}";
        var result = await Api.GetAsync<List<CommitmentOccurrenceDto>>($"/api/contracts/commitments/occurrences?{query}");
        items = result.Value ?? [];
        notice = result.IsSuccess ? null : result.Error;
    }
}
