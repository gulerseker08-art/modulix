@page "/sozlesmeler/ozet"
@inject ApiClient Api
@inject SessionState Session
@inject CrmLookups Lookups

<PageTitle>@Texts.Get("nav.app.contracts.dashboard.menu") · Modulix</PageTitle>

<AuthGate Module="@ContractsAccess.ModuleKey" Permission="@ContractsAccess.ContractsRead">
    <div class="page-header">
        <h1>@Texts.Get("nav.app.contracts.dashboard.menu")</h1>
        <div class="header-actions">
            <a class="btn btn-outline-secondary" href="sozlesmeler">@Texts.Get("contracts.dashboard.list")</a>
            <a class="btn btn-outline-secondary" href="sozlesmeler/yenileme">@Texts.Get("contracts.renewals.calendar")</a>
        </div>
    </div>
    <p class="text-muted">@Texts.Get("contracts.dashboard.intro")</p>

    <Notice Text="@error" Failed="true" />

    @if (data is null && error is null)
    {
        <LoadingState />
    }
    else if (data is not null)
    {
        <section aria-labelledby="counts-title">
            <h2 id="counts-title" class="visually-hidden">@Texts.Get("contracts.dashboard.counters")</h2>
            <div class="stat-grid">
                @foreach (var (key, label) in ViewLabels.Counters)
                {
                    var count = data.Counts.FirstOrDefault(c => c.Key == key)?.Count ?? 0;
                    <a class="stat-card" href="@ViewLabels.CounterLink(key)" aria-label="@label: @count">
                        <span>@label</span>
                        <strong>@count.ToString("N0", Regional.Numbers)</strong>
                    </a>
                }
            </div>
        </section>

        <div class="chart-grid">
            <section class="chart-card" aria-labelledby="type-title">
                <h2 id="type-title">@Texts.Get("contracts.dashboard.byType")</h2>
                @if (data.ByType.Count == 0)
                {
                    <p class="text-muted">@Texts.Get("contracts.dashboard.noneActive")</p>
                }
                else
                {
                    <BarChart Slices="TypeSlices" Title="@Texts.Get("contracts.dashboard.byTypeChart")" />
                }
                @if (data.Truncated)
                {
                    <p class="small text-muted">@Texts.Get("contracts.dashboard.truncated")</p>
                }
            </section>

            <section class="chart-card" aria-labelledby="money-title">
                <h2 id="money-title">@Texts.Get("contracts.dashboard.byCurrency")</h2>
                @if (data.Money is null)
                {
                    <p class="text-muted">@Texts.Get("contracts.dashboard.moneyPermission")</p>
                }
                else if (data.Money.Count == 0)
                {
                    <EmptyState Title="@Texts.Get("contracts.dashboard.noneActive")" />
                }
                else
                {
                    <table class="table record-table">
                        <caption class="visually-hidden">@Texts.Get("contracts.dashboard.moneyCaption")</caption>
                        <thead><tr><th scope="col">@Texts.Get("contracts.field.currency")</th><th scope="col" class="text-end">@Texts.Get("contracts.list.col.contract")</th><th scope="col" class="text-end">@Texts.Get("contracts.field.net")</th><th scope="col" class="text-end">@Texts.Get("contracts.field.grosstotal")</th></tr></thead>
                        <tbody>
                            @foreach (var m in data.Money)
                            {
                                <tr>
                                    <td data-label="@Texts.Get("contracts.field.currency")" class="primary">@m.Currency</td>
                                    <td data-label="@Texts.Get("contracts.list.col.contract")" class="text-end">@m.Count</td>
                                    <td data-label="@Texts.Get("contracts.field.net")" class="text-end">@ContractLabels.Money(m.NetTotal, m.Currency)</td>
                                    <td data-label="@Texts.Get("contracts.field.grosstotal")" class="text-end">@ContractLabels.Money(m.GrossTotal, m.Currency)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <p class="small text-muted">@Texts.Get("contracts.dashboard.oneTimeOnly")</p>
                }
            </section>
        </div>

        <section aria-labelledby="upcoming-title">
            <h2 id="upcoming-title">@Texts.Get("contracts.dashboard.upcoming")</h2>
            @if (data.Upcoming.Count == 0)
            {
                <EmptyState Title="@Texts.Get("contracts.dashboard.noUpcoming")" />
            }
            else
            {
                <table class="table record-table">
                    <caption class="visually-hidden">@Texts.Get("contracts.dashboard.upcomingCaption")</caption>
                    <thead><tr><th scope="col">@Texts.Get("contracts.list.col.contract")</th><th scope="col">@Texts.Get("contracts.dashboard.col.date")</th><th scope="col">@Texts.Get("contracts.dashboard.col.left")</th></tr></thead>
                    <tbody>
                        @foreach (var d in data.Upcoming)
                        {
                            <tr>
                                <td data-label="@Texts.Get("contracts.list.col.contract")" class="primary"><a href="sozlesmeler/@d.ContractId">@d.Title</a> <small class="text-muted">@d.Number</small></td>
                                <td data-label="@Texts.Get("contracts.dashboard.col.date")">@(d.Kind == "notice" ? Texts.Get("contracts.dashboard.noticeOn", ContractLabels.Date(d.Date)) : Texts.Get("contracts.dashboard.endOn", ContractLabels.Date(d.Date)))</td>
                                <td data-label="@Texts.Get("contracts.dashboard.col.left")">@RenewalLabels.Days(d.DaysLeft)</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <p class="small"><a href="sozlesmeler/yenileme">@Texts.Get("contracts.dashboard.openCalendar")</a></p>
            }
        </section>
    }
</AuthGate>

@code {
    private ContractDashboardDto? data;
    private string? error;

    private IReadOnlyList<ChartSlice> TypeSlices =>
        [.. (data?.ByType ?? []).Select(t => new ChartSlice(t.Key == "—" ? Texts.Get("contracts.dashboard.noType") : Lookups.Label(ContractsAccess.ContractTypeList, t.Key), t.Count))];

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (!Session.Can(ContractsAccess.ContractsRead)) { return; }
        await Lookups.LoadAsync();
        var result = await Api.GetAsync<ContractDashboardDto>("/api/contracts/dashboard");
        data = result.Value;
        error = result.IsSuccess ? null : result.Error;
    }
}
