@page "/sozlesmeler"
@inject ApiClient Api
@inject SessionState Session
@inject CrmLookups Lookups

<PageTitle>@Texts.Get("nav.app.contracts") · Modulix</PageTitle>

<AuthGate Module="@ContractsAccess.ModuleKey" Permission="@ContractsAccess.ContractsRead">
    <div class="page-header">
        <h1>@Texts.Get("nav.app.contracts")</h1>
        <div class="header-actions">
            <a class="btn btn-outline-secondary" href="sozlesmeler/ozet">@Texts.Get("nav.app.contracts.dashboard")</a>
            @if (Session.Can(ContractsAccess.ContractsExport))
            {
                <a class="btn btn-outline-secondary" href="@ExportUrl()" download="sozlesmeler.csv">@Texts.Get("crm.leads.csv")</a>
            }
        </div>
    </div>

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }

    <ViewTabs Items="ViewOptions" Value="@viewKey" ValueChanged="ChooseViewAsync" Label="@Texts.Get("contracts.list.viewsLabel")" NewView="StartNaming" NewViewText="@Texts.Get("common.view.add")" />

    <div class="list-toolbar">
        <form class="search" @onsubmit="() => LoadAsync(1)" @onsubmit:preventDefault>
            <label class="visually-hidden" for="contract-search">@Texts.Get("contracts.list.searchLabel")</label>
            <input id="contract-search" class="form-control" type="search" placeholder="@Texts.Get("contracts.list.searchPlaceholder")" @bind="search" />
        </form>
        <FilterToggle @bind-Open="filtersOpen" Count="ActiveFilters" />
        <GridColumnPicker State="grid" Changed="@(() => Task.CompletedTask)" />
        @if (Session.Can(ContractsAccess.ContractsWrite))
        {
            <a class="btn btn-primary" href="sozlesmeler/sihirbaz"><AppIcon Name="plus" Size="16" /> @Texts.Get("contracts.list.new")</a>
        }
    </div>

    @if (filtersOpen || ActiveFilters > 0)
    {
        <div class="filters">
            <label class="visually-hidden" for="effective-filter">@Texts.Get("contracts.list.effectiveFilter")</label>
            <select id="effective-filter" class="form-select form-select-sm filter-select" @bind="effective" @bind:after="() => LoadAsync(1)">
                <option value="">@Texts.Get("contracts.list.allEffective")</option>
                @foreach (var s in ContractLabels.Effectives)
                {
                    <option value="@s.Key">@s.Label</option>
                }
            </select>
            <label class="visually-hidden" for="type-filter">@Texts.Get("common.field.kind")</label>
            <select id="type-filter" class="form-select form-select-sm filter-select" @bind="type" @bind:after="() => LoadAsync(1)">
                <option value="">@Texts.Get("crm.act.allTypes")</option>
                @foreach (var t in Lookups.Choices(ContractsAccess.ContractTypeList))
                {
                    <option value="@t.Key">@t.Label</option>
                }
            </select>
        </div>
    }

    @if (approval is not null || preparation is not null)
    {
        <div class="filters" role="group" aria-label="@Texts.Get("contracts.list.extraFilters")">
            @if (approval is not null)
            {
                <button type="button" class="chip active" @onclick="() => ClearExtraAsync(true)" aria-label="@Texts.Get("contracts.list.removeApproval", ContractLabels.Label(ContractLabels.Approvals, approval))">@Texts.Get("contracts.list.chipApproval", ContractLabels.Label(ContractLabels.Approvals, approval)) ×</button>
            }
            @if (preparation is not null)
            {
                <button type="button" class="chip active" @onclick="() => ClearExtraAsync(false)" aria-label="@Texts.Get("contracts.list.removePreparation", ContractLabels.Label(ContractLabels.Preparations, preparation))">@Texts.Get("contracts.list.chipPreparation", ContractLabels.Label(ContractLabels.Preparations, preparation)) ×</button>
            }
        </div>
    }

    <PersonalViewBar Active="Active" Dirty="grid.Differs(Active)" Naming="views.Naming" NamingChanged="views.StartNaming" Error="@views.Error"
                     SaveAs="SaveAsAsync" UpdateView="UpdateViewAsync" DiscardChanges="DiscardAsync" DeleteView="DeleteViewAsync" />

    @if (page is null)
    {
        <LoadingState Kind="LoadingKind.Table" />
    }
    else if (page.Items.Count == 0)
    {
        <EmptyState Compact="true" Title="@Texts.Get("contracts.list.empty")" />
    }
    else
    {
        <p class="visually-hidden" role="status" aria-live="polite">@Texts.Get("contracts.list.count", page.TotalCount)</p>
        <table class="table record-table">
            <caption class="visually-hidden">@Texts.Get("contracts.list.caption")</caption>
            <thead>
                <tr>
                    @foreach (var column in grid.VisibleColumns)
                    {
                        <GridHeader Column="column" State="grid" SortChanged="SortAsync" Class="@(column.Key == "total" ? "text-end" : null)" />
                    }
                    <th scope="col" class="row-menu-cell"><span class="visually-hidden">@Texts.Get("common.actions")</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in page.Items)
                {
                    <tr>
                        @foreach (var column in grid.VisibleColumns)
                        {
                            @Cell(column, c)
                        }
                        <td class="row-menu-cell">
                            <RowMenu Label="@Texts.Get("common.rowActionsOf", c.Number)">
                                <a class="view-menu-item" role="menuitem" href="sozlesmeler/@c.Id"><AppIcon Name="eye" Size="16" /> <span>@Texts.Get("common.open")</span></a>
                            </RowMenu>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager PageSizeChoice="true" Page="page.Page" PageSize="page.PageSize" TotalCount="page.TotalCount" PageChanged="LoadAsync" />
    }
</AuthGate>

@code {
    private bool filtersOpen;

    /// <summary>Etkin süzgeç sayısı ("Filtrele" rozeti); süzgeç satırı etkin süzgeç varken açık kalır.</summary>
    private int ActiveFilters => (string.IsNullOrEmpty(effective) ? 0 : 1) + (string.IsNullOrEmpty(type) ? 0 : 1);

    private const string DefaultSort = "-createdAt";
    private const string AllViews = "all";
    private const string PresetPrefix = "preset:";

    // Sıralama sunucudaki sort anahtarlarıdır (ContractSort); varsayılan sıra en yeni önce.
    // Özellik olarak tanımlıdır: başlıklar sayfa açılırken etkin dilden çözülür (ADR-0034).
    private static GridColumnDef[] Columns =>
    [
        new("contract", Texts.Get("contracts.list.col.contract"), "file-text", "title", "-title", Locked: true),
        new("customer", Texts.Get("contracts.list.col.customer"), "building"),
        new("type", Texts.Get("common.field.kind"), "tag"),
        new("statuses", Texts.Get("contracts.list.col.statuses"), "activity"),
        new("dates", Texts.Get("contracts.list.col.dates"), "calendar", "endDate", "-endDate"),
        new("critical", Texts.Get("contracts.list.col.critical"), "clock", "noticeDeadline", "-noticeDeadline"),
        new("total", Texts.Get("contracts.list.col.total"), "coins"),
        new("owner", Texts.Get("common.field.owner"), "user"),
        new("number", Texts.Get("contracts.list.col.number"), "hash", "number", "-number", DefaultVisible: false),
        new("start", Texts.Get("contracts.list.col.start"), "calendar", "startDate", "-startDate", DefaultVisible: false),
        new("payment", Texts.Get("contracts.list.col.payment"), "wallet", DefaultVisible: false),
    ];

    private readonly GridViewState grid = new("contracts.contracts", DefaultSort);
    private PersonalGridViews views = default!;
    private PagedResult<ContractDto>? page;
    private string? message;
    private string? effective;
    private string? type;
    private string? view;
    private string viewKey = AllViews;
    private string? approval;
    private string? preparation;
    private string search = string.Empty;
    private readonly Dictionary<Guid, string> partyNames = [];

    // Panodaki sayaçlardan gelen bağlantılar: hızlı görünüm ya da tek durum süzgeci.
    [SupplyParameterFromQuery(Name = "gorunum")] public string? QueryView { get; set; }

    [SupplyParameterFromQuery(Name = "onay")] public string? QueryApproval { get; set; }

    [SupplyParameterFromQuery(Name = "hazirlik")] public string? QueryPreparation { get; set; }

    [SupplyParameterFromQuery(Name = "yururluk")] public string? QueryEffective { get; set; }

    private GridViewDto? Active => views.Find(viewKey);

    private static string PresetIcon(string key) => key switch
    {
        "mine" => "star", "signature" => "pencil", "ending" => "hourglass", "notice" => "alert-circle", "overdue" => "clock", _ => "briefcase",
    };

    // Görünümler yalnızca süzgeçtir: "Tüm sözleşmeler", hızlı görünümler ve kişisel görünümler (kapsamı sunucu uygular).
    private IReadOnlyList<ViewOption> ViewOptions =>
    [
        new(AllViews, Texts.Get("contracts.list.view.all"), Icon: "file-text"),
        .. ViewLabels.Presets.Select(p => new ViewOption(PresetPrefix + p.Key, p.Label, Icon: PresetIcon(p.Key))),
        .. views.Options,
    ];

    protected override async Task OnInitializedAsync()
    {
        views = new PersonalGridViews(Api, "contracts.contracts");
        grid.Define(Columns);
        await Session.EnsureLoadedAsync();
        if (Session.Can(ContractsAccess.ContractsRead))
        {
            if (ViewLabels.Presets.Any(p => p.Key == QueryView)) { view = QueryView; viewKey = PresetPrefix + QueryView; }
            if (ContractLabels.Approvals.Any(a => a.Key == QueryApproval)) { approval = QueryApproval; }
            if (ContractLabels.Preparations.Any(p => p.Key == QueryPreparation)) { preparation = QueryPreparation; }
            if (ContractLabels.Effectives.Any(e => e.Key == QueryEffective)) { effective = QueryEffective; }
            await Lookups.LoadAsync();
            await views.LoadAsync();
            appliedQueryView = QueryView;
            initialized = true;
            await LoadAsync(1);
        }
    }

    private string? appliedQueryView;
    private bool initialized;

    // Aynı sayfadayken menüden başka bir hızlı görünüme gidilirse (ör. Satış sözleşmeleri) sayfa yeniden kurulmaz; görünümü burada uygularız.
    protected override async Task OnParametersSetAsync()
    {
        if (initialized && QueryView != appliedQueryView && Session.Can(ContractsAccess.ContractsRead))
        {
            appliedQueryView = QueryView;
            view = ViewLabels.Presets.Any(p => p.Key == QueryView) ? QueryView : null;
            viewKey = view is null ? AllViews : PresetPrefix + view;
            await LoadAsync(1);
        }
    }

    /// <summary>Liste süzgeçleri: hızlı görünüm göreli tarihleri bugüne göre açar; seçili alanlar hızlı görünümün varsayılanını ezer.</summary>
    private Dictionary<string, string> Filters()
    {
        var today = DateOnly.FromDateTime(Regional.Now.DateTime);
        var filters = new Dictionary<string, string>();
        switch (view)
        {
            case "mine": filters["ownerId"] = "me"; break;
            case "signature": filters["signatureStatus"] = "Pending,PartiallySigned"; break;
            // Yürürlükteki sözleşmelerde bitiş önümüzdeki 90 gün içinde; bildirim süresi 30 gün içinde.
            case "ending": filters["effectiveStatus"] = "Active"; filters["endFrom"] = $"{today:yyyy-MM-dd}"; filters["endTo"] = $"{today.AddDays(90):yyyy-MM-dd}"; break;
            case "notice": filters["effectiveStatus"] = "Active"; filters["noticeFrom"] = $"{today:yyyy-MM-dd}"; filters["noticeTo"] = $"{today.AddDays(30):yyyy-MM-dd}"; break;
            case "overdue": filters["commitmentOverdue"] = "true"; break;
            // Satış kapsamı türün adına değil, firmanın tür listesindeki "Satış / müşteri" kategorisine bağlıdır; kümeyi sunucu çözer.
            case "sales": filters["typeCategory"] = "sales"; break;
        }

        if (!string.IsNullOrEmpty(effective)) { filters["effectiveStatus"] = effective; }
        if (!string.IsNullOrEmpty(type)) { filters["type"] = type; }
        if (!string.IsNullOrEmpty(approval)) { filters["approvalStatus"] = approval; }
        if (!string.IsNullOrEmpty(preparation)) { filters["preparationStatus"] = preparation; }
        if (grid.Sort != DefaultSort) { filters["sort"] = grid.Sort; }
        return filters;
    }

    private string Query(int? pageNumber)
    {
        var parts = new List<string>();
        if (pageNumber is { } n) { parts.Add($"page={n}&pageSize={ListPaging.Size}"); }
        if (!string.IsNullOrWhiteSpace(search)) { parts.Add($"search={Uri.EscapeDataString(search.Trim())}"); }
        parts.AddRange(Filters().Select(f => $"{f.Key}={Uri.EscapeDataString(f.Value)}"));
        return string.Join('&', parts);
    }

    private string ExportUrl() => $"api/contracts/contracts/export?{Query(null)}";

    private async Task LoadAsync(int pageNumber)
    {
        var result = await Api.GetAsync<PagedResult<ContractDto>>($"/api/contracts/contracts?{Query(pageNumber)}");
        page = result.Value;
        message = result.Error;
        if (page is not null)
        {
            await ResolvePartiesAsync(page.Items.Select(c => c.PartyId));
        }
    }

    /// <summary>Müşteri adları ortak lookup üzerinden çözülür: yalnızca kullanıcının görebildiği kayıtlar ad döner.</summary>
    private async Task ResolvePartiesAsync(IEnumerable<Guid> ids)
    {
        var missing = ids.Distinct().Where(id => !partyNames.ContainsKey(id)).ToList();
        if (missing.Count == 0) { return; }
        var resolved = await Api.PostAsync<LookupResolveDto>("/api/lookups/contracts.contract.party/resolve", new ResolveLookupRequest(missing));
        foreach (var item in resolved.Value?.Items ?? [])
        {
            partyNames[item.Id] = item.Label ?? "—";
        }
    }

    private string PartyName(Guid id) => partyNames.TryGetValue(id, out var name) ? name : "—";

    private async Task ChooseViewAsync(string key)
    {
        viewKey = key;
        views.StartNaming(false);
        if (Active is { } saved)
        {
            // Kişisel görünüm: sütunlar, sıralama ve süzgeçler birlikte gelir (hızlı görünüm anahtarıyla; göreli tarihler bugüne göre yeniden açılır).
            grid.Apply(saved);
            var filters = GridFilters.Parse(saved.Filters);
            var preset = filters.GetValueOrDefault("preset");
            view = ViewLabels.Presets.Any(p => p.Key == preset) ? preset : null;
            effective = filters.GetValueOrDefault("effectiveStatus");
            preparation = filters.GetValueOrDefault("preparationStatus");
            approval = filters.GetValueOrDefault("approvalStatus");
            type = filters.GetValueOrDefault("type");
        }
        else
        {
            // Hızlı görünüm ya da "Tüm sözleşmeler": sütunlar varsayılana döner, diğer süzgeçler korunur.
            grid.Reset();
            view = key.StartsWith(PresetPrefix, StringComparison.Ordinal) ? key[PresetPrefix.Length..] : null;
        }

        await LoadAsync(1);
    }

    private Task SortAsync(string key)
    {
        grid.Sort = key;
        return LoadAsync(1);
    }

    private Task ClearExtraAsync(bool approvalFilter)
    {
        if (approvalFilter) { approval = null; } else { preparation = null; }
        return LoadAsync(1);
    }

    // ---- kişisel görünümler (ADR-0036); eski sözleşmeye özel kayıtlı görünüm arayüzü kaldırıldı, uç noktaları yerinde duruyor.

    private string? CurrentFilters => GridFilters.Build(
        view is { Length: > 0 } v ? ("preset", v) : null,
        effective is { Length: > 0 } e ? ("effectiveStatus", e) : null,
        preparation is { Length: > 0 } p ? ("preparationStatus", p) : null,
        approval is { Length: > 0 } a ? ("approvalStatus", a) : null,
        type is { Length: > 0 } t ? ("type", t) : null);

    private void StartNaming() => views.StartNaming(true);

    private async Task SaveAsAsync(string name)
    {
        if (await views.SaveAsAsync(grid.ToRequest(name, CurrentFilters)) is { } key)
        {
            viewKey = key;
        }
    }

    private async Task UpdateViewAsync()
    {
        if (Active is { } current)
        {
            await views.UpdateAsync(current, grid.ToRequest(current.Name, CurrentFilters));
        }
    }

    private async Task DiscardAsync() => await ChooseViewAsync(viewKey);

    private async Task DeleteViewAsync()
    {
        if (Active is { } current && await views.DeleteAsync(current))
        {
            view = effective = type = approval = preparation = null;
            await ChooseViewAsync(AllViews);
        }
    }

    private RenderFragment Cell(GridColumnDef column, ContractDto c) => @<td data-label="@column.Label" class="@(column.Key == "contract" ? "primary" : column.Key == "total" ? "text-end" : null)">@CellContent(column.Key, c)</td>;

    private RenderFragment CellContent(string key, ContractDto c) => key switch
    {
        "contract" => @<text>
            <a href="sozlesmeler/@c.Id">@c.Title</a>
            <small class="text-muted">@c.Number · @Texts.Get("contracts.versionNo", c.CurrentVersionNo)</small>
        </text>,
        "customer" => @<text>@PartyName(c.PartyId)</text>,
        "type" => @<text>@Lookups.Label(ContractsAccess.ContractTypeList, c.Type)</text>,
        "statuses" => @<text>
            <span class="badge stage-@ContractLabels.EffectiveBadge(c.EffectiveStatus)">@ContractLabels.Label(ContractLabels.Effectives, c.EffectiveStatus)</span>
            @if (c.ApprovalStatus != "NotRequired") { <span class="badge stage-@ContractLabels.ApprovalBadge(c.ApprovalStatus)">@ContractLabels.Label(ContractLabels.Approvals, c.ApprovalStatus)</span> }
            @if (c.SignatureStatus != "NotSent") { <span class="badge stage-@ContractLabels.SignatureBadge(c.SignatureStatus)">@ContractLabels.Label(ContractLabels.Signatures, c.SignatureStatus)</span> }
        </text>,
        "dates" => @<text>@ContractLabels.Date(c.StartDate) – @(c.IsIndefinite ? Texts.Get("contracts.indefinite") : ContractLabels.Date(c.EndDate))</text>,
        "critical" => @<text>@Critical(c)</text>,
        "total" => @<text>@ContractLabels.Money(c.GrossTotal, c.Currency)</text>,
        "owner" => @<OwnerCell Name="@Lookups.MemberName(c.OwnerId)" />,
        "number" => @<text>@c.Number</text>,
        "start" => @<text>@ContractLabels.Date(c.StartDate)</text>,
        "payment" => @<text>@c.PaymentTerms</text>,
        _ => @<text></text>,
    };

    private static string Critical(ContractDto c)
    {
        if (c.NoticeDeadline is { } notice && ContractLabels.DaysUntil(notice) is { } nd && nd >= 0)
        {
            return Texts.Get("contracts.list.critical.notice", ContractLabels.Date(notice), nd);
        }

        if (!c.IsIndefinite && c.EndDate is { } end && ContractLabels.DaysUntil(end) is { } ed)
        {
            return ed < 0 ? Texts.Get("contracts.list.critical.ended", ContractLabels.Date(end)) : Texts.Get("contracts.list.critical.end", ContractLabels.Date(end), ed);
        }

        return "—";
    }
}
