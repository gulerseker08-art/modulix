@page "/sozlesmeler"
@inject ApiClient Api
@inject SessionState Session
@inject CrmLookups Lookups

<PageTitle>Sözleşmeler · Modulix</PageTitle>

<AuthGate Module="@ContractsAccess.ModuleKey" Permission="@ContractsAccess.ContractsRead">
    <div class="page-header">
        <h1>Sözleşmeler</h1>
        <div class="header-actions">
            <a class="btn btn-outline-secondary" href="sozlesmeler/ozet">Pano</a>
            @if (Session.Can(ContractsAccess.ContractsExport))
            {
                <a class="btn btn-outline-secondary" href="@ExportUrl()" download="sozlesmeler.csv">CSV indir</a>
            }
        </div>
    </div>

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }
    <Notice Text="@notice" Failed="@noticeFailed" />

    <div class="list-toolbar">
        <ViewSelector Items="ViewOptions" Value="@CurrentView" ValueChanged="ChooseViewAsync" NewView="() => saving = true" NewViewText="Yeni görünüm kaydet" />
        <form class="search" @onsubmit="() => LoadAsync(1)" @onsubmit:preventDefault>
            <label class="visually-hidden" for="contract-search">Sözleşme ara</label>
            <input id="contract-search" class="form-control" type="search" placeholder="Başlık veya sözleşme no ara" @bind="search" />
            <button type="submit" class="btn btn-outline-secondary">Ara</button>
        </form>
        <FilterToggle @bind-Open="filtersOpen" Count="ActiveFilters" />
        <ColumnPicker />
        @if (Session.Can(ContractsAccess.ContractsWrite))
        {
            <a class="btn btn-primary" href="sozlesmeler/sihirbaz"><AppIcon Name="plus" Size="16" /> Yeni sözleşme</a>
        }
    </div>

    @if (filtersOpen || ActiveFilters > 0)
    {
        <div class="filters">
            <label class="visually-hidden" for="effective-filter">Yürürlük durumu</label>
            <select id="effective-filter" class="form-select form-select-sm filter-select" @bind="effective" @bind:after="() => LoadAsync(1)">
                <option value="">Tüm yürürlük durumları</option>
                @foreach (var s in ContractLabels.Effectives)
                {
                    <option value="@s.Key">@s.Label</option>
                }
            </select>
            <label class="visually-hidden" for="type-filter">Tür</label>
            <select id="type-filter" class="form-select form-select-sm filter-select" @bind="type" @bind:after="() => LoadAsync(1)">
                <option value="">Tüm türler</option>
                @foreach (var t in Lookups.Choices(ContractsAccess.ContractTypeList))
                {
                    <option value="@t.Key">@t.Label</option>
                }
            </select>
            <label class="visually-hidden" for="sort-select">Sıralama</label>
            <select id="sort-select" class="form-select form-select-sm filter-select" @bind="sort" @bind:after="() => LoadAsync(1)">
                @foreach (var (key, label) in ViewLabels.Sorts)
                {
                    <option value="@key">Sıralama: @label</option>
                }
            </select>
        </div>
    }

    @if (approval is not null || preparation is not null)
    {
        <div class="filters" role="group" aria-label="Uygulanan ek süzgeçler">
            @if (approval is not null)
            {
                <button type="button" class="chip active" @onclick="() => ClearExtraAsync(true)" aria-label="Süzgeci kaldır: Onay durumu @ContractLabels.Label(ContractLabels.Approvals, approval)">Onay: @ContractLabels.Label(ContractLabels.Approvals, approval) ×</button>
            }
            @if (preparation is not null)
            {
                <button type="button" class="chip active" @onclick="() => ClearExtraAsync(false)" aria-label="Süzgeci kaldır: Hazırlık durumu @ContractLabels.Label(ContractLabels.Preparations, preparation)">Hazırlık: @ContractLabels.Label(ContractLabels.Preparations, preparation) ×</button>
            }
        </div>
    }

    @if (SelectedView is not null || saving)
    {
    <section class="saved-views" aria-labelledby="views-title">
        <h2 id="views-title" class="visually-hidden">Kaydedilmiş görünüm işlemleri</h2>
        @if (SelectedView is not null)
        {
            <div class="filters">
                <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@busy" @onclick="UpdateViewAsync">Görünümü güncelle</button>
                <button type="button" class="btn btn-sm btn-outline-danger" disabled="@busy" @onclick="DeleteViewAsync">Görünümü sil</button>
            </div>
        }
        @if (saving)
        {
            <form id="save-view-form" class="search" novalidate @onsubmit="SaveViewAsync" @onsubmit:preventDefault>
                <label class="visually-hidden" for="view-name">Görünüm adı</label>
                <input id="view-name" class="form-control" maxlength="100" placeholder="Görünüm adı (ör. Bu çeyrek biten hizmet sözleşmeleri)" @bind="viewName" aria-invalid="@(viewErrors is not null)" aria-describedby="@(viewErrors is null ? null : "view-name-error")" />
                <button type="submit" class="btn btn-primary" disabled="@busy">Kaydet</button>
                <button type="button" class="btn btn-outline-secondary" @onclick="() => saving = false">Vazgeç</button>
                @if (viewErrors is not null) { <div id="view-name-error" class="invalid-feedback d-block" role="alert">@viewErrors</div> }
            </form>
            <p class="small text-muted">Görünüm yalnızca sizin listenizi hatırlar; başkalarına gösterilmez ve yetkinizi genişletmez.</p>
        }
    </section>
    }

    @if (page is null)
    {
        <p class="text-muted" role="status">Yükleniyor…</p>
    }
    else if (page.Items.Count == 0)
    {
        <p class="text-muted" role="status">Bu süzgece uyan sözleşme yok.</p>
    }
    else
    {
        <p class="visually-hidden" role="status" aria-live="polite">@(page.TotalCount) sözleşme listelendi.</p>
        <table class="table record-table">
            <caption class="visually-hidden">Sözleşme listesi</caption>
            <thead>
                <tr>
                    <th scope="col">Sözleşme</th><th scope="col">Müşteri</th><th scope="col">Tür</th><th scope="col">Durumlar</th>
                    <th scope="col">Başlangıç / Bitiş</th><th scope="col">Kritik tarih</th><th scope="col" class="text-end">Toplam</th><th scope="col">Sorumlu</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in page.Items)
                {
                    <tr>
                        <td data-label="Sözleşme" class="primary">
                            <a href="sozlesmeler/@c.Id">@c.Title</a>
                            <small class="text-muted">@c.Number · V@(c.CurrentVersionNo)</small>
                        </td>
                        <td data-label="Müşteri">@PartyName(c.PartyId)</td>
                        <td data-label="Tür">@Lookups.Label(ContractsAccess.ContractTypeList, c.Type)</td>
                        <td data-label="Durumlar">
                            <span class="badge stage-@ContractLabels.EffectiveBadge(c.EffectiveStatus)">@ContractLabels.Label(ContractLabels.Effectives, c.EffectiveStatus)</span>
                            @if (c.ApprovalStatus != "NotRequired") { <span class="badge stage-@ContractLabels.ApprovalBadge(c.ApprovalStatus)">@ContractLabels.Label(ContractLabels.Approvals, c.ApprovalStatus)</span> }
                            @if (c.SignatureStatus != "NotSent") { <span class="badge stage-@ContractLabels.SignatureBadge(c.SignatureStatus)">@ContractLabels.Label(ContractLabels.Signatures, c.SignatureStatus)</span> }
                        </td>
                        <td data-label="Başlangıç / Bitiş">@ContractLabels.Date(c.StartDate) – @(c.IsIndefinite ? "Belirsiz süreli" : ContractLabels.Date(c.EndDate))</td>
                        <td data-label="Kritik tarih">@Critical(c)</td>
                        <td data-label="Toplam" class="text-end">@ContractLabels.Money(c.GrossTotal, c.Currency)</td>
                        <td data-label="Sorumlu">@Lookups.MemberName(c.OwnerId)</td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager Page="page.Page" PageSize="page.PageSize" TotalCount="page.TotalCount" PageChanged="LoadAsync" />
    }
</AuthGate>

@code {
    private bool filtersOpen;

    /// <summary>Etkin süzgeç sayısı ("Filtrele" rozeti); süzgeç satırı etkin süzgeç varken açık kalır.</summary>
    private int ActiveFilters => (string.IsNullOrEmpty(effective) ? 0 : 1) + (string.IsNullOrEmpty(type) ? 0 : 1);

    private const string DefaultSort = "-createdAt";

    private PagedResult<ContractDto>? page;
    private string? message;
    private string? notice;
    private bool noticeFailed;
    private string? effective;
    private string? type;
    private string? view;
    private string? approval;
    private string? preparation;
    private string sort = DefaultSort;
    private string search = string.Empty;
    private readonly Dictionary<Guid, string> partyNames = [];

    private List<ContractSavedViewDto> views = [];
    private string? selectedViewId;
    private bool saving;
    private bool busy;
    private string viewName = string.Empty;
    private string? viewErrors;

    // Panodaki sayaçlardan gelen bağlantılar: hızlı görünüm ya da tek durum süzgeci.
    [SupplyParameterFromQuery(Name = "gorunum")] public string? QueryView { get; set; }

    [SupplyParameterFromQuery(Name = "onay")] public string? QueryApproval { get; set; }

    [SupplyParameterFromQuery(Name = "hazirlik")] public string? QueryPreparation { get; set; }

    [SupplyParameterFromQuery(Name = "yururluk")] public string? QueryEffective { get; set; }

    private ContractSavedViewDto? SelectedView => views.FirstOrDefault(v => v.Id.ToString() == selectedViewId);

    private const string AllViews = "all";
    private const string PresetPrefix = "preset:";
    private const string SavedPrefix = "saved:";

    // Görünüm seçici: tek menüde "Tüm sözleşmeler", hızlı görünümler ve kaydedilmiş görünümler (yalnızca süzgeç; kapsamı sunucu uygular).
    private IReadOnlyList<ViewOption> ViewOptions =>
    [
        new(AllViews, "Tüm sözleşmeler"),
        .. ViewLabels.Presets.Select(p => new ViewOption(PresetPrefix + p.Key, p.Label, "Hızlı görünümler")),
        .. views.Select(v => new ViewOption(SavedPrefix + v.Id, v.Name, "Kayıtlı görünümlerim")),
    ];

    private string CurrentView =>
        SelectedView is { } saved ? SavedPrefix + saved.Id
        : view is not null ? PresetPrefix + view
        : AllViews;

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (Session.Can(ContractsAccess.ContractsRead))
        {
            if (ViewLabels.Presets.Any(p => p.Key == QueryView)) { view = QueryView; }
            if (ContractLabels.Approvals.Any(a => a.Key == QueryApproval)) { approval = QueryApproval; }
            if (ContractLabels.Preparations.Any(p => p.Key == QueryPreparation)) { preparation = QueryPreparation; }
            if (ContractLabels.Effectives.Any(e => e.Key == QueryEffective)) { effective = QueryEffective; }
            await Lookups.LoadAsync();
            await LoadViewsAsync();
            await LoadAsync(1);
        }
    }

    /// <summary>Liste süzgeçleri: hızlı görünüm göreli tarihleri bugüne göre açar; seçili alanlar hızlı görünümün varsayılanını ezer.</summary>
    private Dictionary<string, string> Filters()
    {
        var today = DateOnly.FromDateTime(Regional.Now.DateTime);
        var filters = new Dictionary<string, string>();
        switch (view)
        {
            case "mine": filters["ownerId"] = "me"; break;
            case "signature": filters["signatureStatus"] = "Pending,PartiallySigned"; break;
            // Yürürlükteki sözleşmelerde bitiş önümüzdeki 90 gün içinde; bildirim süresi 30 gün içinde.
            case "ending": filters["effectiveStatus"] = "Active"; filters["endFrom"] = $"{today:yyyy-MM-dd}"; filters["endTo"] = $"{today.AddDays(90):yyyy-MM-dd}"; break;
            case "notice": filters["effectiveStatus"] = "Active"; filters["noticeFrom"] = $"{today:yyyy-MM-dd}"; filters["noticeTo"] = $"{today.AddDays(30):yyyy-MM-dd}"; break;
            case "overdue": filters["commitmentOverdue"] = "true"; break;
        }

        if (!string.IsNullOrEmpty(effective)) { filters["effectiveStatus"] = effective; }
        if (!string.IsNullOrEmpty(type)) { filters["type"] = type; }
        if (!string.IsNullOrEmpty(approval)) { filters["approvalStatus"] = approval; }
        if (!string.IsNullOrEmpty(preparation)) { filters["preparationStatus"] = preparation; }
        if (sort != DefaultSort) { filters["sort"] = sort; }
        return filters;
    }

    private string Query(int? pageNumber)
    {
        var parts = new List<string>();
        if (pageNumber is { } n) { parts.Add($"page={n}"); }
        if (!string.IsNullOrWhiteSpace(search)) { parts.Add($"search={Uri.EscapeDataString(search.Trim())}"); }
        parts.AddRange(Filters().Select(f => $"{f.Key}={Uri.EscapeDataString(f.Value)}"));
        return string.Join('&', parts);
    }

    private string ExportUrl() => $"api/contracts/contracts/export?{Query(null)}";

    private async Task LoadAsync(int pageNumber)
    {
        var result = await Api.GetAsync<PagedResult<ContractDto>>($"/api/contracts/contracts?{Query(pageNumber)}");
        page = result.Value;
        message = result.Error;
        if (page is not null)
        {
            await ResolvePartiesAsync(page.Items.Select(c => c.PartyId));
        }
    }

    /// <summary>Müşteri adları ortak lookup üzerinden çözülür: yalnızca kullanıcının görebildiği kayıtlar ad döner.</summary>
    private async Task ResolvePartiesAsync(IEnumerable<Guid> ids)
    {
        var missing = ids.Distinct().Where(id => !partyNames.ContainsKey(id)).ToList();
        if (missing.Count == 0) { return; }
        var resolved = await Api.PostAsync<LookupResolveDto>("/api/lookups/contracts.contract.party/resolve", new ResolveLookupRequest(missing));
        foreach (var item in resolved.Value?.Items ?? [])
        {
            partyNames[item.Id] = item.Label ?? "—";
        }
    }

    private string PartyName(Guid id) => partyNames.TryGetValue(id, out var name) ? name : "—";

    private async Task ChooseViewAsync(string key)
    {
        if (key.StartsWith(SavedPrefix, StringComparison.Ordinal))
        {
            await ApplyViewAsync(key[SavedPrefix.Length..]);
            return;
        }

        // Hızlı görünüm ya da "Tüm sözleşmeler": kaydedilmiş görünüm seçimi kalkar, diğer süzgeçler korunur.
        selectedViewId = null;
        view = key.StartsWith(PresetPrefix, StringComparison.Ordinal) ? key[PresetPrefix.Length..] : null;
        await LoadAsync(1);
    }

    private Task ClearExtraAsync(bool approvalFilter)
    {
        if (approvalFilter) { approval = null; } else { preparation = null; }
        return LoadAsync(1);
    }

    // ---- kaydedilmiş görünümler

    private async Task LoadViewsAsync()
    {
        var result = await Api.GetAsync<PagedResult<ContractSavedViewDto>>("/api/contracts/saved-views?pageSize=50");
        views = [.. result.Value?.Items ?? []];
    }

    /// <summary>Geçerli süzgeçleri görünüm metnine çevirir: göreli tarihli hızlı görünüm tarih yerine anahtarıyla saklanır.</summary>
    private string ViewText()
    {
        var parts = new List<string>();
        void Add(string key, string? value)
        {
            if (!string.IsNullOrWhiteSpace(value)) { parts.Add($"{key}={Uri.EscapeDataString(value.Trim())}"); }
        }

        Add("preset", view);
        Add("effectiveStatus", effective);
        Add("preparationStatus", preparation);
        Add("approvalStatus", approval);
        Add("type", type);
        Add("search", search);
        if (sort != DefaultSort) { Add("sort", sort); }
        return string.Join('&', parts);
    }

    private async Task ApplyViewAsync(string? id)
    {
        selectedViewId = id;
        notice = null;
        view = effective = type = approval = preparation = null;
        search = string.Empty;
        sort = DefaultSort;
        if (SelectedView is { } selected)
        {
            foreach (var part in (selected.Filters ?? string.Empty).Split('&', StringSplitOptions.RemoveEmptyEntries))
            {
                var pair = part.Split('=', 2);
                var value = pair.Length == 2 ? Uri.UnescapeDataString(pair[1]) : string.Empty;
                switch (Uri.UnescapeDataString(pair[0]))
                {
                    case "preset": view = value; break;
                    case "effectiveStatus": effective = value; break;
                    case "preparationStatus": preparation = value; break;
                    case "approvalStatus": approval = value; break;
                    case "type": type = value; break;
                    case "search": search = value; break;
                    case "sort": sort = ViewLabels.Sorts.Any(s => s.Key == value) ? value : DefaultSort; break;
                }
            }
        }

        await LoadAsync(1);
    }

    private async Task SaveViewAsync()
    {
        if (busy) { return; }
        busy = true;
        viewErrors = null;
        var result = await Api.PostAsync<ContractSavedViewDto>("/api/contracts/saved-views", new SaveContractSavedViewRequest(viewName.Trim(), ViewText()));
        busy = false;
        if (!result.IsSuccess)
        {
            viewErrors = result.FieldErrors.Values.SelectMany(v => v).FirstOrDefault() ?? result.Error ?? "Görünüm kaydedilemedi.";
            return;
        }

        saving = false;
        viewName = string.Empty;
        await LoadViewsAsync();
        selectedViewId = result.Value!.Id.ToString();
        Notify("Görünüm kaydedildi.", false);
    }

    private async Task UpdateViewAsync()
    {
        if (busy || SelectedView is not { } selected) { return; }
        busy = true;
        var result = await Api.PutAsync<ContractSavedViewDto>($"/api/contracts/saved-views/{selected.Id}", new SaveContractSavedViewRequest(selected.Name, ViewText(), selected.Version));
        busy = false;
        if (!result.IsSuccess)
        {
            Notify(result.FieldErrors.Values.SelectMany(v => v).FirstOrDefault() ?? result.Error, true);
            return;
        }

        await LoadViewsAsync();
        Notify($"“{selected.Name}” görünümü güncellendi.", false);
    }

    private async Task DeleteViewAsync()
    {
        if (busy || SelectedView is not { } selected) { return; }
        busy = true;
        var result = await Api.DeleteAsync($"/api/contracts/saved-views/{selected.Id}?version={selected.Version}");
        busy = false;
        if (!result.IsSuccess)
        {
            Notify(result.Error, true);
            return;
        }

        selectedViewId = null;
        await LoadViewsAsync();
        Notify($"“{selected.Name}” görünümü silindi.", false);
    }

    private void Notify(string? text, bool failed)
    {
        notice = text;
        noticeFailed = failed;
    }

    private static string Critical(ContractDto c)
    {
        if (c.NoticeDeadline is { } notice && ContractLabels.DaysUntil(notice) is { } nd && nd >= 0)
        {
            return $"Son bildirim: {ContractLabels.Date(notice)} ({nd} gün)";
        }

        if (!c.IsIndefinite && c.EndDate is { } end && ContractLabels.DaysUntil(end) is { } ed)
        {
            return ed < 0 ? $"Bitti: {ContractLabels.Date(end)}" : $"Bitiş: {ContractLabels.Date(end)} ({ed} gün)";
        }

        return "—";
    }
}
