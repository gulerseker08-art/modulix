@page "/sozlesmeler/imzalar"
@inject ApiClient Api
@inject SessionState Session
@inject CrmLookups Lookups

<PageTitle>@Texts.Get("nav.app.contracts.signatures.menu") · Modulix</PageTitle>

<AuthGate Module="@ContractsAccess.ModuleKey" Permission="@ContractsAccess.ContractsRead">
    <div class="page-header">
        <h1>@Texts.Get("nav.app.contracts.signatures.menu")</h1>
    </div>
    <p class="text-muted">@Texts.Get("contracts.signatures.intro")</p>

    <Notice Text="@notice" Failed="true" />

    <div class="filters">
        <label class="form-label" for="sig-filter">@Texts.Get("common.field.status")</label>
        <select id="sig-filter" class="form-select" value="@status" @onchange="FilterAsync">
            @foreach (var s in Statuses) { <option value="@s.Key">@s.Label</option> }
        </select>
    </div>

    @if (items is null)
    {
        <p class="text-muted" role="status">@Texts.Get("common.loading")</p>
    }
    else if (items.Count == 0)
    {
        <p class="text-muted">@Texts.Get("contracts.signatures.empty")</p>
    }
    else
    {
        <table class="table record-table">
            <caption class="visually-hidden">@Texts.Get("contracts.signatures.caption")</caption>
            <thead><tr><th scope="col">@Texts.Get("contracts.list.col.contract")</th><th scope="col">@Texts.Get("contracts.list.col.customer")</th><th scope="col">@Texts.Get("contracts.signatures.col.signature")</th><th scope="col">@Texts.Get("contracts.signatures.col.effective")</th><th scope="col">@Texts.Get("contracts.list.col.dates")</th></tr></thead>
            <tbody>
                @foreach (var c in items)
                {
                    <tr>
                        <td data-label="@Texts.Get("contracts.list.col.contract")" class="primary"><a href="sozlesmeler/@c.Id">@c.Title</a> <small class="text-muted">@c.Number · @Texts.Get("contracts.versionNo", c.CurrentVersionNo)</small></td>
                        <td data-label="@Texts.Get("contracts.list.col.customer")">@PartyName(c.PartyId)</td>
                        <td data-label="@Texts.Get("contracts.signatures.col.signature")"><span class="badge stage-@ContractLabels.SignatureBadge(c.SignatureStatus)">@ContractLabels.Label(ContractLabels.Signatures, c.SignatureStatus)</span></td>
                        <td data-label="@Texts.Get("contracts.signatures.col.effective")"><span class="badge stage-@ContractLabels.EffectiveBadge(c.EffectiveStatus)">@ContractLabels.Label(ContractLabels.Effectives, c.EffectiveStatus)</span></td>
                        <td data-label="@Texts.Get("contracts.list.col.dates")">@ContractLabels.Date(c.StartDate) – @(c.IsIndefinite ? Texts.Get("contracts.indefinite") : ContractLabels.Date(c.EndDate))</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</AuthGate>

@code {
    // Süzgeç, imzaya gönderilmiş sözleşmelerin imza durumlarıdır; adlar ortak imza durumu tablosundan gelir (ADR-0034).
    private static IEnumerable<(string Key, string Label)> Statuses => ContractLabels.Signatures.Where(s => s.Key != "NotSent");

    private readonly Dictionary<Guid, string> partyNames = [];
    private List<ContractDto>? items;
    private string status = "Pending";
    private string? notice;

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (Session.Can(ContractsAccess.ContractsRead))
        {
            await Lookups.LoadAsync();
            await LoadAsync();
        }
    }

    private async Task FilterAsync(ChangeEventArgs e)
    {
        status = e.Value?.ToString() ?? "Pending";
        items = null;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var (loaded, error) = await Api.GetAllAsync<ContractDto>($"/api/contracts/contracts?signatureStatus={status}");
        items = loaded;
        notice = error;
        await ResolvePartiesAsync((loaded ?? []).Select(c => c.PartyId));
    }

    /// <summary>Müşteri adları ortak lookup üzerinden çözülür: yalnızca kullanıcının görebildiği kayıtlar ad döner.</summary>
    private async Task ResolvePartiesAsync(IEnumerable<Guid> ids)
    {
        var missing = ids.Distinct().Where(id => !partyNames.ContainsKey(id)).ToList();
        if (missing.Count == 0) { return; }
        var resolved = await Api.PostAsync<LookupResolveDto>("/api/lookups/contracts.contract.party/resolve", new ResolveLookupRequest(missing));
        foreach (var item in resolved.Value?.Items ?? [])
        {
            partyNames[item.Id] = item.Label ?? "—";
        }
    }

    private string PartyName(Guid id) => partyNames.TryGetValue(id, out var name) ? name : "—";
}
