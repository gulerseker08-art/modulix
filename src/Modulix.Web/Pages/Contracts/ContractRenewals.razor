@page "/sozlesmeler/yenileme"
@inject ApiClient Api
@inject SessionState Session
@inject CrmLookups Lookups

<PageTitle>@Texts.Get("contracts.renewals.title") · Modulix</PageTitle>

<AuthGate Module="@ContractsAccess.ModuleKey" Permission="@ContractsAccess.ContractsRead">
    <div class="page-header">
        <h1>@Texts.Get("contracts.renewals.title")</h1>
        @if (Session.Can(ContractsAccess.RenewalsManage))
        {
            <div class="header-actions">
                <button type="button" class="btn btn-outline-secondary" disabled="@running" @onclick="RunAsync">@Texts.Get("contracts.renewals.runNow")</button>
            </div>
        }
    </div>
    <p class="text-muted">@Texts.Get("contracts.renewals.intro")</p>

    <Notice Text="@notice" Failed="@noticeFailed" />

    <div class="filters">
        <div>
            <label class="form-label" for="rn-days">@Texts.Get("contracts.renewals.horizon")</label>
            <select id="rn-days" class="form-select" value="@days" @onchange="HorizonAsync">
                <option value="30">@Texts.Get("crm.sales.days", 30)</option>
                <option value="90">@Texts.Get("crm.sales.days", 90)</option>
                <option value="180">@Texts.Get("crm.sales.days", 180)</option>
                <option value="365">@Texts.Get("contracts.renewals.oneYear")</option>
            </select>
        </div>
        <div class="form-check">
            <input id="rn-undecided" class="form-check-input" type="checkbox" checked="@onlyUndecided" @onchange="Toggle" />
            <label class="form-check-label" for="rn-undecided">@Texts.Get("contracts.renewals.onlyUndecided")</label>
        </div>
    </div>

    @if (items is null)
    {
        <LoadingState Kind="LoadingKind.Table" />
    }
    else if (Visible.Count == 0)
    {
        <EmptyState Title="@Texts.Get("contracts.renewals.empty")" />
    }
    else
    {
        <table class="table record-table">
            <caption class="visually-hidden">@Texts.Get("contracts.renewals.calendar")</caption>
            <thead><tr><th scope="col">@Texts.Get("contracts.list.col.contract")</th><th scope="col">@Texts.Get("contracts.renewals.col.notice")</th><th scope="col">@Texts.Get("contracts.field.enddate")</th><th scope="col">@Texts.Get("contracts.renewals.col.mode")</th><th scope="col">@Texts.Get("contracts.renewals.col.decision")</th><th scope="col">@Texts.Get("common.field.owner")</th></tr></thead>
            <tbody>
                @foreach (var i in Visible)
                {
                    <tr>
                        <td data-label="@Texts.Get("contracts.list.col.contract")" class="primary"><a href="sozlesmeler/@i.ContractId">@i.Title</a> <small class="text-muted">@i.Number</small></td>
                        <td data-label="@Texts.Get("contracts.renewals.col.notice")">
                            @ContractLabels.Date(i.NoticeDeadline)
                            @if (i.DaysToNotice is { } n) { <div class="small @(n < 0 && i.Decision is null ? "text-danger" : "text-muted")">@RenewalLabels.Days(n)</div> }
                        </td>
                        <td data-label="@Texts.Get("contracts.field.enddate")">@ContractLabels.Date(i.EndDate)@if (i.DaysToEnd is { } e) { <div class="small text-muted">@RenewalLabels.Days(e)</div> }</td>
                        <td data-label="@Texts.Get("contracts.renewals.col.mode")">@ContractLabels.Label(ContractLabels.RenewalModes, i.RenewalMode)</td>
                        <td data-label="@Texts.Get("contracts.renewals.col.decision")">
                            @if (i.TerminationDate is { } termination) { <div class="small text-danger">@Texts.Get("contracts.renewals.terminationOn", ContractLabels.Date(termination))</div> }
                            @if (i.Decision is { } decision)
                            {
                                <span class="badge stage-@RenewalLabels.Badge(decision)">@RenewalLabels.Label(RenewalLabels.Outcomes, decision)</span>
                                @if (i.ResultContractId is { } resultId) { <div class="small"><a href="sozlesmeler/@resultId">@Texts.Get("contracts.renewals.openDraft")</a></div> }
                            }
                            else
                            {
                                <span class="text-muted">@Texts.Get("contracts.renewals.awaitingDecision")</span>
                            }
                            @if (i.LastReminder is not null) { <div class="small text-muted">@Texts.Get("contracts.renewals.lastReminder", i.LastReminder)</div> }
                        </td>
                        <td data-label="@Texts.Get("common.field.owner")">@(i.OwnerId is null ? "—" : Lookups.MemberName(i.OwnerId))</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</AuthGate>

@code {
    private List<RenewalCalendarItemDto>? items;
    private int days = 90;
    private bool onlyUndecided;
    private bool running;
    private string? notice;
    private bool noticeFailed;

    private List<RenewalCalendarItemDto> Visible => (items ?? []).Where(i => !onlyUndecided || i.Decision is null).ToList();

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (Session.Can(ContractsAccess.ContractsRead))
        {
            await Lookups.LoadAsync();
            await LoadAsync();
        }
    }

    private async Task HorizonAsync(ChangeEventArgs e)
    {
        days = int.TryParse(e.Value?.ToString(), out var parsed) ? parsed : 90;
        items = null;
        await LoadAsync();
    }

    private void Toggle(ChangeEventArgs e) => onlyUndecided = e.Value is true;

    private async Task LoadAsync()
    {
        var result = await Api.GetAsync<List<RenewalCalendarItemDto>>($"/api/contracts/renewals/calendar?days={days}");
        items = result.Value ?? [];
        if (!result.IsSuccess) { Notify(result.Error, true); }
    }

    private async Task RunAsync()
    {
        if (running) { return; }
        running = true;
        var result = await Api.PostAsync<SchedulerRunDto>("/api/contracts/scheduler/run", new { });
        running = false;
        if (!result.IsSuccess)
        {
            Notify(result.Error, true);
            return;
        }

        var r = result.Value!;
        Notify(
            Texts.Get("contracts.renewals.runDone", r.AutoRenewed, r.RemindersCreated, r.EscalationsCreated, r.Terminated, r.PeriodsExpired, r.Activated), false);
        items = null;
        await LoadAsync();
    }

    private void Notify(string? text, bool failed)
    {
        notice = text;
        noticeFailed = failed;
    }
}
