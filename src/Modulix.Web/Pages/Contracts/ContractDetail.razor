@page "/sozlesmeler/yeni"
@page "/sozlesmeler/{Id:guid}"
@inject ApiClient Api
@inject SessionState Session
@inject CrmLookups Lookups
@inject NavigationManager Navigation
@inject IJSRuntime Js
@inject FormLayouts Layouts

<PageTitle>@(contract?.Title ?? Texts.Get("contracts.list.new")) · Modulix</PageTitle>

<NavigationLock ConfirmExternalNavigation="@(dirty || childDirty)" OnBeforeInternalNavigation="ConfirmLeaveAsync" />

<AuthGate Module="@ContractsAccess.ModuleKey" Permission="@ContractsAccess.ContractsRead">
    @if (notFound)
    {
        <div class="alert alert-warning" role="alert">@Texts.Get("contracts.detail.notFound") <a href="sozlesmeler">@Texts.Get("contracts.detail.backToContracts")</a></div>
    }
    else if (Id is not null && contract is null)
    {
        <p class="text-muted" role="status">@Texts.Get("common.loading")</p>
    }
    else
    {
        <div class="page-header">
            <div>
                <h1>@(contract?.Title ?? Texts.Get("contracts.list.new"))</h1>
                @if (contract is not null)
                {
                    <p class="text-muted mb-0">
                        @contract.Number · @Texts.Get("contracts.detail.currentVersion", contract.CurrentVersionNo)@(contract.EffectiveVersionNo is { } ev ? " · " + Texts.Get("contracts.detail.effectiveVersion", ev) : "")
                        @if (contract.SourceQuoteNumber is not null)
                        {
                            <text> · @Texts.Get("contracts.detail.sourceQuote") </text>
                            @if (contract.SourceQuoteId is { } sourceQuote && Session.Can(CrmAccess.QuotesRead)) { <a href="crm/teklifler/@sourceQuote">@contract.SourceQuoteNumber @Texts.Get("contracts.versionNo", contract.SourceQuoteRevisionNo)</a> }
                            else { <text>@contract.SourceQuoteNumber @Texts.Get("contracts.versionNo", contract.SourceQuoteRevisionNo)</text> }
                        }
                        <span class="badge stage-@ContractLabels.EffectiveBadge(contract.EffectiveStatus)">@ContractLabels.Label(ContractLabels.Effectives, contract.EffectiveStatus)</span>
                        <span class="badge stage-open">@ContractLabels.Label(ContractLabels.Preparations, contract.PreparationStatus)</span>
                        <span class="badge stage-@ContractLabels.ApprovalBadge(contract.ApprovalStatus)">@ContractLabels.Label(ContractLabels.Approvals, contract.ApprovalStatus)</span>
                        <span class="badge stage-@ContractLabels.SignatureBadge(contract.SignatureStatus)">@ContractLabels.Label(ContractLabels.Signatures, contract.SignatureStatus)</span>
                    </p>
                }
            </div>
            <div class="header-actions">
                <a class="btn btn-outline-secondary" href="sozlesmeler">@Texts.Get("crm.quoteDetail.backToList")</a>
                @if (contract is not null && CanWrite)
                {
                    @if (Editable && contract.PreparationStatus == "Draft")
                    {
                        <a class="btn btn-outline-secondary" href="sozlesmeler/sihirbaz?id=@contract.Id">@Texts.Get("contracts.detail.editInWizard")</a>
                    }
                    <button type="button" class="btn btn-outline-danger" @onclick="DeleteAsync" disabled="@busy">@Texts.Get("contracts.detail.deleteDraft")</button>
                }
            </div>
        </div>

        <Notice Text="@notice" Failed="@noticeFailed" />

        @if (contract is not null)
        {
            <div class="kpi-strip" role="list" aria-label="@Texts.Get("contracts.detail.criticalDates")">
                <div role="listitem"><span class="kpi-label">@Texts.Get("contracts.field.startdate")</span><span class="kpi-value">@ContractLabels.Date(contract.StartDate)</span></div>
                <div role="listitem"><span class="kpi-label">@Texts.Get("contracts.field.enddate")</span><span class="kpi-value">@(contract.IsIndefinite ? Texts.Get("contracts.indefinite") : ContractLabels.Date(contract.EndDate))</span></div>
                <div role="listitem"><span class="kpi-label">@Texts.Get("contracts.field.noticedeadline")</span><span class="kpi-value">@ContractLabels.Date(contract.NoticeDeadline)</span></div>
                <div role="listitem"><span class="kpi-label">@Texts.Get("contracts.detail.oneTimeTotal")</span><span class="kpi-value">@ContractLabels.Money(contract.GrossTotal, contract.Currency)</span></div>
            </div>

            @if (!Editable)
            {
                <div class="alert alert-info" role="status">
                    @Texts.Get("contracts.detail.readOnly")
                    @if (!string.IsNullOrWhiteSpace(contract.StatusReason)) { <span> @Texts.Get("contracts.detail.readOnlyReason", contract.StatusReason)</span> }
                </div>
            }

            <section aria-labelledby="actions-title" class="contract-actions">
                <h2 id="actions-title" class="visually-hidden">@Texts.Get("crm.quoteDetail.actions.title")</h2>
                @if (reasonAction is not null)
                {
                    <form class="record-form" novalidate @onsubmit="ConfirmReasonAsync" @onsubmit:preventDefault>
                        <label class="form-label" for="reason">@Texts.Get(actions.FirstOrDefault(a => a.Action == reasonAction)?.RequiresReason == true ? "crm.quoteDetail.reasonFor" : "contracts.detail.reasonForOptional", ContractActionLabels.Action(reasonAction))</label>
                        <textarea id="reason" class="form-control" rows="2" maxlength="500" @bind="reasonText"></textarea>
                        <FieldError Field="reason" Errors="actionErrors" />
                        <div class="form-actions">
                            <button type="submit" class="btn btn-primary" disabled="@busy">@Texts.Get("crm.quoteDetail.confirm")</button>
                            <button type="button" class="btn btn-outline-secondary" @onclick="() => reasonAction = null">@Texts.Get("common.dismiss")</button>
                        </div>
                    </form>
                }
                <div class="header-actions" role="group" aria-label="@Texts.Get("contracts.detail.actionsLabel")">
                    @foreach (var action in actions.Where(a => a.Allowed))
                    {
                        <button type="button" class="btn @(ContractActionLabels.IsPrimary(action.Action) ? "btn-primary" : "btn-outline-secondary")" disabled="@busy"
                                @onclick="() => StartActionAsync(action)">@ContractActionLabels.Action(action.Action)</button>
                    }
                </div>
                @if (actions.Any(a => !a.Allowed))
                {
                    <details class="small text-muted">
                        <summary>@Texts.Get("contracts.detail.unavailableActions", actions.Count(a => !a.Allowed))</summary>
                        <ul class="action-reasons">
                            @foreach (var action in actions.Where(a => !a.Allowed))
                            {
                                <li><strong>@ContractActionLabels.Action(action.Action):</strong> @action.Message</li>
                            }
                        </ul>
                    </details>
                }
            </section>

            <TabBar Tabs="Tabs" State="tabs" Label="@Texts.Get("contracts.detail.sections")" Changed="_ => { }" />
        }

        @if (contract is null || tabs.Rendered(TabGeneral))
        {
            <div role="tabpanel" id="tabpanel-@TabGeneral" aria-labelledby="tab-@TabGeneral" class="record-tabpanel" hidden="@(contract is not null && tabs.Hidden(TabGeneral))">
                <form class="record-form" novalidate @onsubmit="SaveAsync" @onsubmit:preventDefault>
                    <fieldset disabled="@(!CanEditHeader || busy)">
                        <legend class="visually-hidden">@Texts.Get("crm.quoteDetail.generalInfo")</legend>
                        @if (errors is { Count: > 0 })
                        {
                            <div class="alert alert-danger" role="alert">
                                <strong>@Texts.Get("common.errorSummary")</strong>
                                <ul class="mb-0">
                                    @foreach (var (_, messages) in errors)
                                    {
                                        foreach (var text in messages) { <li>@text</li> }
                                    }
                                </ul>
                            </div>
                        }
                        <div @oninput="() => dirty = true" @onchange="() => dirty = true">
                            <LayoutForm Layout="layout" CustomFields="CustomFields" CustomValues="form.Custom" Errors="errors" Shows="ShowsField" TabsLabel="@Texts.Get("contracts.fromQuote.formSections")">
                                <Field Context="f">
                                    @switch (f.Key)
                                    {
                                        case "title":
                                            <label class="@f.LabelClass()" for="c-title">@f.Label</label>
                                            <input id="c-title" class="form-control" maxlength="200" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.Title" aria-invalid="@(errors?.ContainsKey("title") == true)" />
                                            <FieldError Field="title" Errors="errors" />
                                            break;
                                        case "partyId":
                                            <label class="@f.LabelClass()" for="partyId">@f.Label</label>
                                            <LookupPicker Id="partyId" LookupKey="contracts.contract.party" @bind-Value="form.PartyId" Required="f.Required"
                                                          Invalid="@(errors?.ContainsKey("partyId") == true)" ReadOnly="@(!CanEditHeader)" />
                                            <FieldError Field="partyId" Errors="errors" />
                                            break;
                                        case "personId":
                                            <label class="@f.LabelClass()" for="personId">@f.Label</label>
                                            <LookupPicker Id="personId" LookupKey="contracts.contract.person" @bind-Value="form.PersonId" ParentId="form.PartyId" Placeholder="—" Required="f.Required"
                                                          Invalid="@(errors?.ContainsKey("personId") == true)" ReadOnly="@(!CanEditHeader)" />
                                            <FieldError Field="personId" Errors="errors" />
                                            break;
                                        case "type":
                                            <label class="@f.LabelClass()" for="c-type">@f.Label</label>
                                            <select id="c-type" class="form-select" @bind="form.Type">
                                                @foreach (var t in Lookups.Choices(ContractsAccess.ContractTypeList, contract?.Type))
                                                {
                                                    <option value="@t.Key">@t.Label</option>
                                                }
                                            </select>
                                            <FieldError Field="type" Errors="errors" />
                                            break;
                                        case "ownerId":
                                            <label class="@f.LabelClass()" for="ownerId">@f.Label</label>
                                            <LookupPicker Id="ownerId" LookupKey="contracts.contract.owner" @bind-Value="form.OwnerId" Required="f.Required" Placeholder="@(contract is null ? Texts.Get("common.me") : "—")" ReadOnly="@(!CanEditHeader)" />
                                            <FieldError Field="ownerId" Errors="errors" />
                                            break;
                                        case "escalationUserId":
                                            <label class="@f.LabelClass()" for="escalationUserId">@f.Label</label>
                                            <LookupPicker Id="escalationUserId" LookupKey="contracts.contract.escalation" @bind-Value="form.EscalationUserId" Placeholder="—" ReadOnly="@(!CanEditHeader)" />
                                            <small class="text-muted">@Texts.Get("contracts.detail.escalationHelp")</small>
                                            <FieldError Field="escalationUserId" Errors="errors" />
                                            break;
                                        case "confidentiality":
                                            <label class="@f.LabelClass()" for="c-conf">@f.Label</label>
                                            <select id="c-conf" class="form-select" @bind="form.Confidentiality">
                                                @foreach (var c in ContractLabels.Confidentialities) { <option value="@c.Key">@c.Label</option> }
                                            </select>
                                            break;
                                        case "hasNonStandardTerms":
                                            <div class="form-check">
                                                <input id="c-nonstd" type="checkbox" class="form-check-input" @bind="form.HasNonStandardTerms" />
                                                <label class="form-check-label" for="c-nonstd">@f.Label</label>
                                            </div>
                                            break;
                                        case "riskLevel":
                                            <label class="@f.LabelClass()" for="c-risk">@f.Label</label>
                                            <select id="c-risk" class="form-select" @bind="form.RiskLevel">
                                                @foreach (var r in ContractLabels.RiskLevels) { <option value="@r.Key">@r.Label</option> }
                                            </select>
                                            break;
                                        case "previousContractId":
                                            <label class="@f.LabelClass()" for="previousContractId">@f.Label</label>
                                            <LookupPicker Id="previousContractId" LookupKey="contracts.contract.previous" @bind-Value="form.PreviousContractId" Placeholder="—" Required="f.Required"
                                                          Invalid="@(errors?.ContainsKey("previousContractId") == true)" ReadOnly="@(!CanEditHeader)" />
                                            <FieldError Field="previousContractId" Errors="errors" />
                                            break;
                                        case "startDate":
                                            <label class="@f.LabelClass()" for="c-start">@f.Label</label>
                                            <input id="c-start" type="date" class="form-control" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.StartDate" />
                                            <FieldError Field="startDate" Errors="errors" />
                                            break;
                                        case "endDate":
                                            <label class="@f.LabelClass()" for="c-end">@f.Label</label>
                                            <input id="c-end" type="date" class="form-control" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.EndDate" disabled="@form.IsIndefinite" />
                                            <FieldError Field="endDate" Errors="errors" />
                                            break;
                                        case "isIndefinite":
                                            <div class="form-check">
                                                <input id="c-indef" type="checkbox" class="form-check-input" @bind="form.IsIndefinite" />
                                                <label class="form-check-label" for="c-indef">@f.Label</label>
                                            </div>
                                            break;
                                        case "renewalMode":
                                            <label class="@f.LabelClass()" for="c-renewal">@f.Label</label>
                                            <select id="c-renewal" class="form-select" @bind="form.RenewalMode">
                                                @foreach (var m in ContractLabels.RenewalModes) { <option value="@m.Key">@m.Label</option> }
                                            </select>
                                            <FieldError Field="renewalMode" Errors="errors" />
                                            break;
                                        case "renewalPeriodMonths":
                                            <label class="@f.LabelClass()" for="c-renewal-months">@f.Label</label>
                                            <input id="c-renewal-months" type="number" min="1" max="120" class="form-control" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.RenewalPeriodMonths" disabled="@(form.RenewalMode == "None")" />
                                            <FieldError Field="renewalPeriodMonths" Errors="errors" />
                                            break;
                                        case "noticePeriodDays":
                                            <label class="@f.LabelClass()" for="c-notice">@f.Label</label>
                                            <input id="c-notice" type="number" min="0" max="3650" class="form-control" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.NoticePeriodDays" />
                                            <small class="text-muted">@Texts.Get("contracts.detail.noticeHelp")</small>
                                            <FieldError Field="noticePeriodDays" Errors="errors" />
                                            break;
                                        case "currency":
                                            <label class="@f.LabelClass()" for="c-currency">@f.Label</label>
                                            <input id="c-currency" class="form-control" maxlength="3" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.Currency" />
                                            <FieldError Field="currency" Errors="errors" />
                                            break;
                                        case "priceIncludesTax":
                                            <label class="@f.LabelClass()" for="c-tax">@f.Label</label>
                                            <select id="c-tax" class="form-select" @bind="form.PriceIncludesTax">
                                                <option value="False">@Texts.Get("crm.quoteDetail.taxExcluded")</option>
                                                <option value="True">@Texts.Get("crm.quoteDetail.taxIncluded")</option>
                                            </select>
                                            break;
                                        case "contractValue":
                                            <label class="@f.LabelClass()" for="c-value">@f.Label</label>
                                            <input id="c-value" type="number" step="0.01" min="0" class="form-control" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.ContractValue" />
                                            <small class="text-muted">@Texts.Get("contracts.detail.contractValueHelp")</small>
                                            <FieldError Field="contractValue" Errors="errors" />
                                            break;
                                        case "description":
                                            <label class="@f.LabelClass()" for="c-desc">@f.Label</label>
                                            <textarea id="c-desc" class="form-control" rows="3" maxlength="4000" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.Description"></textarea>
                                            break;
                                        case "paymentTerms":
                                            <label class="@f.LabelClass()" for="c-payment">@f.Label</label>
                                            <textarea id="c-payment" class="form-control" rows="3" maxlength="4000" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.PaymentTerms"></textarea>
                                            break;
                                    }
                                </Field>
                            </LayoutForm>
                        </div>
                    </fieldset>
                    @if (CanEditHeader)
                    {
                        <div class="form-actions">
                            <button type="submit" class="btn btn-primary" disabled="@(busy || layout is null)">@Texts.Get(contract is null ? "crm.quoteDetail.createDraft" : "common.save")</button>
                            @if (dirty) { <span class="text-muted" role="status">@Texts.Get("crm.quoteDetail.unsaved")</span> }
                        </div>
                    }
                </form>
            </div>
        }

        @if (contract is not null && tabs.Rendered(TabParties))
        {
            <div role="tabpanel" id="tabpanel-@TabParties" aria-labelledby="tab-@TabParties" class="record-tabpanel" hidden="@tabs.Hidden(TabParties)">
                <section aria-labelledby="parties-title">
                    <h2 id="parties-title">@Texts.Get("contracts.detail.parties")</h2>
                    <p class="text-muted">@Texts.Get("contracts.detail.partiesIntro")</p>
                    @if (Editable && CanWrite && partyForm is null)
                    {
                        <button type="button" class="btn btn-outline-primary" @onclick="NewParty">@Texts.Get("contracts.detail.addParty")</button>
                    }
                    @if (partyForm is not null)
                    {
                        <form class="record-form" novalidate @onsubmit="SavePartyAsync" @onsubmit:preventDefault>
                            <h3>@Texts.Get(partyForm.Id is null ? "contracts.detail.newParty" : "contracts.detail.editParty")</h3>
                            @if (childMessage is not null) { <div class="alert alert-danger" role="alert">@childMessage</div> }
                            <div class="form-grid" @oninput="() => childDirty = true">
                                <div>
                                    <label class="form-label" for="p-role">@Texts.Get("contracts.detail.roleRequired")</label>
                                    <select id="p-role" class="form-select" @bind="partyForm.Role">
                                        @foreach (var r in ContractLabels.PartyRoles) { <option value="@r.Key">@r.Label</option> }
                                    </select>
                                </div>
                                <div>
                                    <label class="form-label" for="p-party">@Texts.Get("contracts.detail.party")</label>
                                    <LookupPicker Id="p-party" LookupKey="contracts.contract-party.party" @bind-Value="partyForm.PartyId" Placeholder="—"
                                                  Invalid="@(childErrors?.ContainsKey("partyId") == true)" />
                                    <FieldError Field="partyId" Errors="childErrors" />
                                </div>
                                <div>
                                    <label class="form-label" for="p-person">@Texts.Get("contracts.detail.person")</label>
                                    <LookupPicker Id="p-person" LookupKey="contracts.contract-party.person" @bind-Value="partyForm.PersonId" ParentId="partyForm.PartyId" Placeholder="—"
                                                  Invalid="@(childErrors?.ContainsKey("personId") == true)" />
                                    <FieldError Field="personId" Errors="childErrors" />
                                </div>
                                <div class="span-all">
                                    <label class="form-label" for="p-notes">@Texts.Get("contracts.field.notes")</label>
                                    <input id="p-notes" class="form-control" maxlength="1000" @bind="partyForm.Notes" />
                                </div>
                            </div>
                            <div class="form-actions">
                                <button type="submit" class="btn btn-primary" disabled="@busy">@Texts.Get("common.save")</button>
                                <button type="button" class="btn btn-outline-secondary" @onclick="CancelChild">@Texts.Get("common.dismiss")</button>
                            </div>
                        </form>
                    }
                    @if (parties.Count == 0)
                    {
                        <p class="text-muted">@Texts.Get("contracts.detail.noParties")</p>
                    }
                    else
                    {
                        <table class="table record-table">
                            <caption class="visually-hidden">@Texts.Get("contracts.detail.partiesCaption")</caption>
                            <thead><tr><th scope="col">@Texts.Get("contracts.field.role")</th><th scope="col">@Texts.Get("contracts.detail.party")</th><th scope="col">@Texts.Get("contracts.detail.person")</th><th scope="col">@Texts.Get("contracts.field.notes")</th><th scope="col"><span class="visually-hidden">@Texts.Get("crm.quoteDetail.actions.title")</span></th></tr></thead>
                            <tbody>
                                @foreach (var p in parties)
                                {
                                    <tr>
                                        <td data-label="@Texts.Get("contracts.field.role")">@ContractLabels.Label(ContractLabels.PartyRoles, p.Role)</td>
                                        <td data-label="@Texts.Get("contracts.detail.party")">@Name(partyNames, p.PartyId)</td>
                                        <td data-label="@Texts.Get("contracts.detail.person")">@Name(personNames, p.PersonId)</td>
                                        <td data-label="@Texts.Get("contracts.field.notes")">@p.Notes</td>
                                        <td data-label="@Texts.Get("crm.quoteDetail.actions.title")">
                                            @if (Editable && CanWrite)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => EditParty(p)">@Texts.Get("common.edit")</button>
                                                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => DeletePartyAsync(p)">@Texts.Get("contracts.signaturePanel.remove")</button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </section>
            </div>
        }

        @if (contract is not null && tabs.Rendered(TabLines))
        {
            <div role="tabpanel" id="tabpanel-@TabLines" aria-labelledby="tab-@TabLines" class="record-tabpanel" hidden="@tabs.Hidden(TabLines)">
                <section aria-labelledby="lines-title">
                    <h2 id="lines-title">@Texts.Get("contracts.detail.linesTitle")</h2>
                    @if (Editable && CanWrite && lineForm is null)
                    {
                        <button type="button" class="btn btn-outline-primary" @onclick="NewLine">@Texts.Get("crm.quoteDetail.addLine")</button>
                    }
                    @if (lineForm is not null)
                    {
                        <form class="record-form" novalidate @onsubmit="SaveLineAsync" @onsubmit:preventDefault>
                            <h3>@Texts.Get(lineForm.Id is null ? "crm.quoteDetail.newLine" : "crm.quoteDetail.editLine")</h3>
                            @if (childMessage is not null) { <div class="alert alert-danger" role="alert">@childMessage</div> }
                            <div class="form-grid" @oninput="() => childDirty = true">
                                <div>
                                    <label class="form-label" for="l-kind">@Texts.Get("contracts.field.type")</label>
                                    <select id="l-kind" class="form-select" @bind="lineForm.Kind">
                                        @foreach (var k in ContractLabels.LineKinds) { <option value="@k.Key">@k.Label</option> }
                                    </select>
                                </div>
                                <div>
                                    <label class="form-label" for="l-name">@Texts.Get("common.field.nameRequired")</label>
                                    <input id="l-name" class="form-control" maxlength="200" @bind="lineForm.Name" />
                                    <FieldError Field="name" Errors="childErrors" />
                                </div>
                                <div>
                                    <label class="form-label" for="l-code">@Texts.Get("contracts.field.productcode")</label>
                                    <input id="l-code" class="form-control" maxlength="50" @bind="lineForm.ProductCode" />
                                </div>
                                @if (lineForm.Kind != "Text")
                                {
                                    <div>
                                        <label class="form-label" for="l-qty">@Texts.Get("crm.quoteDetail.line.quantity")</label>
                                        <input id="l-qty" type="number" step="any" min="0" class="form-control" @bind="lineForm.Quantity" />
                                        <FieldError Field="quantity" Errors="childErrors" />
                                    </div>
                                    <div>
                                        <label class="form-label" for="l-unit">@Texts.Get("contracts.field.unitname")</label>
                                        <input id="l-unit" class="form-control" maxlength="50" @bind="lineForm.UnitName" />
                                    </div>
                                    @if (Session.Can(ContractsAccess.FinancialsRead))
                                    {
                                        <div>
                                            <label class="form-label" for="l-price">@Texts.Get("crm.quoteDetail.line.unitPriceRequired")</label>
                                            <input id="l-price" type="number" step="any" min="0" class="form-control" @bind="lineForm.UnitPrice" />
                                            <FieldError Field="unitPrice" Errors="childErrors" />
                                        </div>
                                        <div>
                                            <label class="form-label" for="l-disc">@Texts.Get("contracts.detail.discountPercent")</label>
                                            <input id="l-disc" type="number" step="any" min="0" max="100" class="form-control" @bind="lineForm.DiscountPercent" />
                                            <FieldError Field="discountPercent" Errors="childErrors" />
                                        </div>
                                    }
                                    <div>
                                        <label class="form-label" for="l-tax">@Texts.Get("crm.quoteDetail.line.taxRate")</label>
                                        <input id="l-tax" type="number" step="any" min="0" max="100" class="form-control" @bind="lineForm.TaxRatePercent" />
                                        <FieldError Field="taxRatePercent" Errors="childErrors" />
                                    </div>
                                    <div>
                                        <label class="form-label" for="l-period">@Texts.Get("contracts.detail.billingPeriod")</label>
                                        <select id="l-period" class="form-select" @bind="lineForm.BillingPeriod">
                                            @foreach (var p in ContractLabels.Periods) { <option value="@p.Key">@p.Label</option> }
                                        </select>
                                    </div>
                                }
                                <div class="span-all">
                                    <label class="form-label" for="l-desc">@Texts.Get("contracts.field.description")</label>
                                    <textarea id="l-desc" class="form-control" rows="2" maxlength="2000" @bind="lineForm.Description"></textarea>
                                </div>
                            </div>
                            <div class="form-actions">
                                <button type="submit" class="btn btn-primary" disabled="@busy">@Texts.Get("common.save")</button>
                                <button type="button" class="btn btn-outline-secondary" @onclick="CancelChild">@Texts.Get("common.dismiss")</button>
                            </div>
                        </form>
                    }
                    @if (lines.Count == 0)
                    {
                        <p class="text-muted">@Texts.Get("contracts.detail.noLines")</p>
                    }
                    else
                    {
                        <table class="table record-table">
                            <caption class="visually-hidden">@Texts.Get("contracts.detail.linesCaption")</caption>
                            <thead>
                                <tr>
                                    <th scope="col">#</th><th scope="col">@Texts.Get("crm.quoteDetail.col.line")</th><th scope="col" class="text-end">@Texts.Get("crm.quoteDetail.col.quantity")</th><th scope="col" class="text-end">@Texts.Get("crm.quoteDetail.col.unitPrice")</th>
                                    <th scope="col" class="text-end">@Texts.Get("crm.quoteDetail.col.tax")</th><th scope="col">@Texts.Get("contracts.field.billingperiod")</th><th scope="col" class="text-end">@Texts.Get("crm.quoteDetail.col.net")</th><th scope="col" class="text-end">@Texts.Get("contracts.field.gross")</th>
                                    <th scope="col"><span class="visually-hidden">@Texts.Get("crm.quoteDetail.actions.title")</span></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var l in lines)
                                {
                                    <tr>
                                        <td data-label="#">@l.Position</td>
                                        <td data-label="@Texts.Get("crm.quoteDetail.col.line")" class="primary">@l.Name @if (l.ProductCode is not null) { <small class="text-muted">@l.ProductCode</small> }</td>
                                        <td data-label="@Texts.Get("crm.quoteDetail.col.quantity")" class="text-end">@(l.Kind == "Text" ? "—" : $"{l.Quantity.ToString("G29", Regional.Numbers)} {l.UnitName}")</td>
                                        <td data-label="@Texts.Get("crm.quoteDetail.col.unitPrice")" class="text-end">@(l.Kind == "Text" ? "—" : ContractLabels.Money(l.UnitPrice, contract.Currency))</td>
                                        <td data-label="@Texts.Get("crm.quoteDetail.col.tax")" class="text-end">@l.TaxRatePercent.ToString("G29", Regional.Numbers)</td>
                                        <td data-label="@Texts.Get("contracts.field.billingperiod")">@ContractLabels.Label(ContractLabels.Periods, l.BillingPeriod ?? "")</td>
                                        <td data-label="@Texts.Get("crm.quoteDetail.col.net")" class="text-end">@(l.Kind == "Text" ? "—" : ContractLabels.Money(l.Net, contract.Currency))</td>
                                        <td data-label="@Texts.Get("contracts.field.gross")" class="text-end">@(l.Kind == "Text" ? "—" : ContractLabels.Money(l.Gross, contract.Currency))</td>
                                        <td data-label="@Texts.Get("crm.quoteDetail.actions.title")">
                                            @if (Editable && CanWrite)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => EditLine(l)">@Texts.Get("common.edit")</button>
                                                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => DeleteLineAsync(l)">@Texts.Get("contracts.signaturePanel.remove")</button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <th scope="row" colspan="6">@Texts.Get("contracts.detail.oneTimeTotals")</th>
                                    <td class="text-end" colspan="2">@ContractLabels.Money(contract.NetTotal, contract.Currency) / @ContractLabels.Money(contract.TaxTotal, contract.Currency) / @ContractLabels.Money(contract.GrossTotal, contract.Currency)</td>
                                    <td></td>
                                </tr>
                                @foreach (var r in Recurring())
                                {
                                    <tr>
                                        <th scope="row" colspan="6">@Texts.Get("contracts.detail.recurringTotal", ContractLabels.Label(ContractLabels.Periods, r.Period))</th>
                                        <td class="text-end" colspan="2">@ContractLabels.Money(r.Net, contract.Currency) / @ContractLabels.Money(r.Tax, contract.Currency) / @ContractLabels.Money(r.Gross, contract.Currency)</td>
                                        <td></td>
                                    </tr>
                                }
                            </tfoot>
                        </table>
                        <p class="text-muted">@Texts.Get("contracts.detail.recurringNote")</p>
                    }
                </section>
            </div>
        }

        @if (contract is not null && tabs.Rendered(TabApproval))
        {
            <div role="tabpanel" id="tabpanel-@TabApproval" aria-labelledby="tab-@TabApproval" class="record-tabpanel" hidden="@tabs.Hidden(TabApproval)">
                <ContractApprovalPanel ContractId="contract.Id" Version="contract.Version" />
            </div>
        }

        @if (contract is not null && tabs.Rendered(TabSignature))
        {
            <div role="tabpanel" id="tabpanel-@TabSignature" aria-labelledby="tab-@TabSignature" class="record-tabpanel" hidden="@tabs.Hidden(TabSignature)">
                <ContractSignaturePanel Contract="contract" Changed="@(() => LoadAsync(contract.Id))" />
            </div>
        }

        @if (contract is not null && tabs.Rendered(TabCommitments))
        {
            <div role="tabpanel" id="tabpanel-@TabCommitments" aria-labelledby="tab-@TabCommitments" class="record-tabpanel" hidden="@tabs.Hidden(TabCommitments)">
                <ContractCommitmentsPanel Contract="contract" Changed="@(() => LoadAsync(contract.Id))" />
            </div>
        }

        @if (contract is not null && tabs.Rendered(TabRenewal))
        {
            <div role="tabpanel" id="tabpanel-@TabRenewal" aria-labelledby="tab-@TabRenewal" class="record-tabpanel" hidden="@tabs.Hidden(TabRenewal)">
                <ContractRenewalPanel Contract="contract" Changed="@(() => LoadAsync(contract.Id))" />
            </div>
        }

        @if (contract is not null && tabs.Rendered(TabVersions))
        {
            <div role="tabpanel" id="tabpanel-@TabVersions" aria-labelledby="tab-@TabVersions" class="record-tabpanel" hidden="@tabs.Hidden(TabVersions)">
                <section aria-labelledby="versions-title">
                    <h2 id="versions-title">@Texts.Get("contracts.detail.versions")</h2>
                    <p class="text-muted">@(contract.EffectiveVersionNo is { } ev2 ? Texts.Get("contracts.detail.versionsIntroEffective", contract.CurrentVersionNo, ev2) : Texts.Get("contracts.detail.versionsIntro", contract.CurrentVersionNo))</p>
                    @if (versions.Count == 0)
                    {
                        <p class="text-muted">@Texts.Get("contracts.detail.noVersions")</p>
                    }
                    else
                    {
                        <table class="table record-table">
                            <caption class="visually-hidden">@Texts.Get("contracts.detail.versionsCaption")</caption>
                            <thead><tr><th scope="col">@Texts.Get("contracts.approvalPanel.version")</th><th scope="col">@Texts.Get("common.field.status")</th><th scope="col">@Texts.Get("contracts.detail.col.frozenAt")</th><th scope="col">@Texts.Get("contracts.detail.col.hash")</th><th scope="col">@Texts.Get("crm.quoteApprovals.reasonLabel")</th><th scope="col"><span class="visually-hidden">@Texts.Get("crm.quoteDetail.actions.title")</span></th></tr></thead>
                            <tbody>
                                @foreach (var v in versions)
                                {
                                    <tr>
                                        <td data-label="@Texts.Get("contracts.approvalPanel.version")">@Texts.Get("contracts.versionNo", v.VersionNo) <small class="text-muted">@Texts.Get(v.Kind == "Approval" ? "contracts.detail.versionKind.approval" : "contracts.detail.versionKind.signature")</small></td>
                                        <td data-label="@Texts.Get("common.field.status")">@ContractLabels.Label(ContractActionLabels.VersionStatuses, v.Status)</td>
                                        <td data-label="@Texts.Get("contracts.detail.col.frozenAt")">@CrmLabels.Time(v.FrozenAt) · @Lookups.MemberName(v.CreatedBy)</td>
                                        <td data-label="@Texts.Get("contracts.templates.col.hashShort")"><code title="@v.Sha256">@v.Sha256[..12]…</code></td>
                                        <td data-label="@Texts.Get("crm.quoteApprovals.reasonLabel")">@v.Reason</td>
                                        <td data-label="@Texts.Get("crm.quoteDetail.actions.title")">
                                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => CompareAsync(v.VersionNo, 0)">@Texts.Get("contracts.detail.compareWithDraft")</button>
                                            @if (versions.FirstOrDefault(o => o.VersionNo < v.VersionNo) is { } previous)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => CompareAsync(previous.VersionNo, v.VersionNo)">@Texts.Get("contracts.detail.compareWith", previous.VersionNo)</button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    @if (compare is not null)
                    {
                        <section aria-labelledby="compare-title" class="compare">
                            <h3 id="compare-title">@Texts.Get("contracts.detail.compareTitle", compareFrom, compareTo == 0 ? Texts.Get("contracts.detail.currentDraft") : Texts.Get("contracts.versionNo", compareTo))</h3>
                            @if (compare.Header.Count == 0 && compare.Lines.Count == 0 && compare.Parties.Count == 0)
                            {
                                <p class="text-muted">@Texts.Get("contracts.detail.noDifference")</p>
                            }
                            @if (compare.Header.Count > 0)
                            {
                                <table class="table record-table">
                                    <caption>@Texts.Get("contracts.detail.fieldDiffs")</caption>
                                    <thead><tr><th scope="col">@Texts.Get("contracts.detail.col.field")</th><th scope="col">@Texts.Get("contracts.detail.col.before")</th><th scope="col">@Texts.Get("contracts.detail.col.after")</th></tr></thead>
                                    <tbody>
                                        @foreach (var f in compare.Header)
                                        {
                                            <tr><td data-label="@Texts.Get("contracts.detail.col.field")">@ContractActionLabels.Field(f.Field)</td><td data-label="@Texts.Get("contracts.detail.col.before")">@(f.Before ?? "—")</td><td data-label="@Texts.Get("contracts.detail.col.after")">@(f.After ?? "—")</td></tr>
                                        }
                                    </tbody>
                                </table>
                            }
                            @if (compare.Lines.Count > 0)
                            {
                                <table class="table record-table">
                                    <caption>@Texts.Get("contracts.detail.lineDiffs")</caption>
                                    <thead><tr><th scope="col">@Texts.Get("crm.quoteDetail.col.line")</th><th scope="col">@Texts.Get("contracts.detail.col.change")</th><th scope="col">@Texts.Get("contracts.detail.col.detail")</th></tr></thead>
                                    <tbody>
                                        @foreach (var l in compare.Lines)
                                        {
                                            <tr>
                                                <td data-label="@Texts.Get("crm.quoteDetail.col.line")">@l.Name</td>
                                                <td data-label="@Texts.Get("contracts.detail.col.change")">@ContractActionLabels.Change(l.Change)</td>
                                                <td data-label="@Texts.Get("contracts.detail.col.detail")">@string.Join("; ", l.Fields.Where(f => l.Change != "Changed" ? f.After is not null || f.Before is not null : true).Select(f => $"{ContractActionLabels.Field(f.Field)}: {f.Before ?? "—"} → {f.After ?? "—"}"))</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                            @if (compare.Parties.Count > 0)
                            {
                                <table class="table record-table">
                                    <caption>@Texts.Get("contracts.detail.partyDiffs")</caption>
                                    <thead><tr><th scope="col">@Texts.Get("contracts.field.role")</th><th scope="col">@Texts.Get("contracts.detail.col.change")</th><th scope="col">@Texts.Get("contracts.detail.col.detail")</th></tr></thead>
                                    <tbody>
                                        @foreach (var p in compare.Parties)
                                        {
                                            <tr>
                                                <td data-label="@Texts.Get("contracts.field.role")">@ContractLabels.Label(ContractLabels.PartyRoles, p.Role)</td>
                                                <td data-label="@Texts.Get("contracts.detail.col.change")">@ContractActionLabels.Change(p.Change)</td>
                                                <td data-label="@Texts.Get("contracts.detail.col.detail")">@string.Join("; ", p.Fields.Select(f => $"{ContractActionLabels.Field(f.Field)}: {f.Before ?? "—"} → {f.After ?? "—"}"))</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                        </section>
                    }
                </section>
            </div>
        }

        @if (contract is not null && tabs.Rendered(TabDocuments))
        {
            <div role="tabpanel" id="tabpanel-@TabDocuments" aria-labelledby="tab-@TabDocuments" class="record-tabpanel" hidden="@tabs.Hidden(TabDocuments)">
                <section aria-labelledby="documents-title">
                    <h2 id="documents-title">@Texts.Get("contracts.detail.documents")</h2>
                    <p class="text-muted">@((MarkupString)Texts.Get("contracts.detail.documentsIntro", $"<a href=\"sozlesmeler/sablonlar\">{System.Net.WebUtility.HtmlEncode(Texts.Get("contracts.detail.templateManagement"))}</a>"))</p>
                    <div class="form-grid">
                        <div class="span-6">
                            <label class="form-label" for="doc-template">@Texts.Get("contracts.detail.publishedTemplate")</label>
                            <select id="doc-template" class="form-select" @bind="documentTemplateId">
                                <option value="">@Texts.Get("contracts.detail.chooseTemplate")</option>
                                @foreach (var t in publishedTemplates)
                                {
                                    <option value="@t.Id">@($"{t.Name} ({Texts.Get("contracts.versionNo", t.PublishedVersionNo)})")@(t.IsExample ? " — " + Texts.Get("contracts.detail.exampleUpper") : "")</option>
                                }
                            </select>
                            <FieldError Field="templateId" Errors="documentErrors" />
                        </div>
                        <div class="span-6 align-self-end">
                            <button type="button" class="btn btn-outline-secondary" disabled="@(busy || !HasDocumentTemplate)" @onclick="PreviewDocumentAsync">@Texts.Get("contracts.templates.previewButton")</button>
                            @if (Session.Can(ContractsAccess.DocumentsGenerate))
                            {
                                <button type="button" class="btn btn-primary" disabled="@(busy || !HasDocumentTemplate)" @onclick="GenerateDocumentAsync">@Texts.Get("contracts.detail.generateDocument")</button>
                            }
                        </div>
                    </div>
                    <RenderedDocumentView Preview="documentPreview" />
                    @if (documents.Count == 0)
                    {
                        <p class="text-muted">@Texts.Get("contracts.detail.noDocuments")</p>
                    }
                    else
                    {
                        <table class="table record-table">
                            <caption class="visually-hidden">@Texts.Get("contracts.detail.documentsCaption")</caption>
                            <thead><tr><th scope="col">@Texts.Get("contracts.detail.col.document")</th><th scope="col">@Texts.Get("contracts.detail.col.template")</th><th scope="col">@Texts.Get("contracts.detail.col.contractVersion")</th><th scope="col">@Texts.Get("common.field.status")</th><th scope="col">@Texts.Get("contracts.detail.col.hash")</th><th scope="col">@Texts.Get("contracts.detail.col.generated")</th></tr></thead>
                            <tbody>
                                @foreach (var d in documents)
                                {
                                    <tr>
                                        <td data-label="@Texts.Get("contracts.detail.col.document")" class="primary">
                                            @if (Session.Can(ContractsAccess.DocumentsDownload))
                                            {
                                                <a href="api/contracts/contracts/@contract.Id/documents/@d.Id/file" download="@d.FileName">@d.FileName</a>
                                            }
                                            else { <span>@d.FileName</span> }
                                            <small class="text-muted">@(d.SizeBytes / 1024 + 1) KB</small>
                                        </td>
                                        <td data-label="@Texts.Get("contracts.detail.col.template")">@d.TemplateName @Texts.Get("contracts.versionNo", d.TemplateVersionNo) @if (d.IsExample) { <span class="badge stage-lost">@Texts.Get("contracts.detail.example")</span> }</td>
                                        <td data-label="@Texts.Get("contracts.detail.col.contractVersion")">@Texts.Get("contracts.versionNo", d.ContractVersionNo)</td>
                                        <td data-label="@Texts.Get("common.field.status")"><span class="badge stage-@(d.IsFinal ? "won" : "onhold")">@Texts.Get(d.IsFinal ? "contracts.detail.finalDocument" : "contracts.detail.draftCopy")</span></td>
                                        <td data-label="@Texts.Get("contracts.templates.col.hashShort")"><code title="@d.Sha256">@d.Sha256[..12]…</code></td>
                                        <td data-label="@Texts.Get("contracts.detail.col.generated")">@CrmLabels.Time(d.CreatedAt) · @Lookups.MemberName(d.CreatedBy)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </section>
            </div>
        }

        @if (contract is not null && tabs.Rendered(TabHistory))
        {
            <div role="tabpanel" id="tabpanel-@TabHistory" aria-labelledby="tab-@TabHistory" class="record-tabpanel" hidden="@tabs.Hidden(TabHistory)">
                <RelatedTickets Title="@Texts.Get("contracts.detail.relatedTickets")" LinkedEntityKey="contracts.contract" LinkedRecordId="contract.Id" />
                <section aria-labelledby="timeline-title">
                    <h2 id="timeline-title">@Texts.Get("contracts.detail.timeline")</h2>
                    @if (history.Count == 0)
                    {
                        <p class="text-muted">@Texts.Get("contracts.detail.noHistory")</p>
                    }
                    else
                    {
                        <ol class="timeline">
                            @foreach (var h in history)
                            {
                                <li>
                                    <strong>@ContractActionLabels.History(h.Kind)</strong> · @CrmLabels.Time(h.At) · @Lookups.MemberName(h.ActorId)
                                    @if (h.FromStatus is not null || h.ToStatus is not null) { <span> (@h.FromStatus → @h.ToStatus)</span> }
                                    @if (!string.IsNullOrWhiteSpace(h.Reason)) { <div class="text-muted">@h.Reason</div> }
                                </li>
                            }
                        </ol>
                    }
                </section>
                <section aria-labelledby="audit-title">
                    <h2 id="audit-title">@Texts.Get("contracts.detail.audit")</h2>
                    <RecordHistory EntityKey="contracts.contract" RecordId="contract.Id" Version="contract.Version" />
                </section>
            </div>
        }
    }
</AuthGate>

@code {
    private const string TabGeneral = "general";
    private const string TabParties = "parties";
    private const string TabLines = "lines";
    private const string TabApproval = "approval";
    private const string TabSignature = "signature";
    private const string TabCommitments = "commitments";
    private const string TabRenewal = "renewal";
    private const string TabVersions = "versions";
    private const string TabDocuments = "documents";
    private const string TabHistory = "history";

    [Parameter] public Guid? Id { get; set; }

    private readonly TabState tabs = new(TabGeneral);
    private ContractDto? contract;
    private ContractForm form = new();
    private List<ContractPartyDto> parties = [];
    private List<ContractLineDto> lines = [];
    private List<ContractHistoryDto> history = [];
    private List<ContractActionDto> actions = [];
    private List<ContractVersionDto> versions = [];
    private List<ContractDocumentDto> documents = [];
    private List<ContractTemplateDto> publishedTemplates = [];
    private ContractPreviewDto? documentPreview;
    private IReadOnlyDictionary<string, string[]>? documentErrors;
    private string? documentTemplateId;
    private bool HasDocumentTemplate => Guid.TryParse(documentTemplateId, out _);
    private ContractCompareDto? compare;
    private int compareFrom;
    private int compareTo;
    private string? reasonAction;
    private string reasonText = string.Empty;
    private IReadOnlyDictionary<string, string[]>? actionErrors;
    private readonly Dictionary<Guid, string> partyNames = [];
    private readonly Dictionary<Guid, string> personNames = [];
    private FormLayoutDto? layout;
    private PartyForm? partyForm;
    private LineForm? lineForm;
    private IReadOnlyDictionary<string, string[]>? errors;
    private IReadOnlyDictionary<string, string[]>? childErrors;
    private string? childMessage;
    private string? notice;
    private bool noticeFailed;
    private bool notFound;
    private bool busy;
    private bool dirty;
    private bool childDirty;

    private IReadOnlyList<CustomFieldDto> CustomFields => [.. Lookups.FieldsOf(ContractsAccess.ContractEntityKey)];

    /// <summary>Düzende çizilecek alan süzgeci: sözleşme bedeli yalnızca finansal izni olana (sunucu yine de denetler).</summary>
    private bool ShowsField(FormFieldDto field) => field.Key != "contractValue" || Session.Can(ContractsAccess.FinancialsRead);

    private bool CanWrite => Session.Can(ContractsAccess.ContractsWrite);

    /// <summary>İçerik düzenlemesi: sunucu kuralının (ContractRules.CanEditContent) arayüzdeki karşılığı; API yine de denetler.</summary>
    private bool Editable => contract is null
        || (contract.PreparationStatus == "Draft" && contract.ApprovalStatus != "Pending"
            && contract.SignatureStatus is "NotSent" or "Rejected" or "Expired" or "Cancelled"
            && contract.EffectiveStatus is "NotInForce" or "Cancelled");

    private bool CanEditHeader => CanWrite && Editable;

    private IReadOnlyList<TabItem> Tabs =>
    [
        new(TabGeneral, Texts.Get("crm.quoteDetail.generalInfo")),
        new(TabParties, Texts.Get("contracts.detail.parties"), parties.Count),
        new(TabLines, Texts.Get("contracts.detail.tab.lines"), lines.Count),
        new(TabApproval, Texts.Get("contracts.detail.tab.approval")),
        new(TabSignature, Texts.Get("contracts.signatures.col.signature")),
        new(TabCommitments, Texts.Get("contracts.commitmentsPanel.title")),
        new(TabRenewal, Texts.Get("contracts.detail.tab.renewal")),
        new(TabVersions, Texts.Get("contracts.detail.versions"), versions.Count),
        new(TabDocuments, Texts.Get("contracts.detail.documents"), documents.Count),
        new(TabHistory, Texts.Get("contracts.detail.tab.history")),
    ];

    protected override async Task OnParametersSetAsync()
    {
        await Session.EnsureLoadedAsync();
        if (!Session.Can(ContractsAccess.ContractsRead)) { return; }
        await Lookups.LoadAsync();
        layout ??= await Layouts.ForAsync(ContractsAccess.ContractEntityKey);
        if (Id is { } id)
        {
            await LoadAsync(id);
        }
        else
        {
            contract = null;
            form = new ContractForm { Type = Lookups.DefaultOf(ContractsAccess.ContractTypeList) ?? "Service", Currency = Regional.Currency };
        }
    }

    private async Task LoadAsync(Guid id)
    {
        var result = await Api.GetAsync<ContractDto>($"/api/contracts/contracts/{id}");
        if (!result.IsSuccess)
        {
            notFound = true;
            return;
        }

        contract = result.Value!;
        form = ContractForm.From(contract);
        parties = (await Api.GetAsync<PagedResult<ContractPartyDto>>($"/api/contracts/contract-parties?contractId={id}&pageSize=200")).Value?.Items.ToList() ?? [];
        lines = (await Api.GetAsync<PagedResult<ContractLineDto>>($"/api/contracts/contract-lines?contractId={id}&pageSize=200")).Value?.Items.ToList() ?? [];
        history = (await Api.GetAsync<List<ContractHistoryDto>>($"/api/contracts/contracts/{id}/history")).Value ?? [];
        actions = (await Api.GetAsync<List<ContractActionDto>>($"/api/contracts/contracts/{id}/actions")).Value ?? [];
        versions = (await Api.GetAsync<List<ContractVersionDto>>($"/api/contracts/contracts/{id}/versions")).Value ?? [];
        compare = null;
        documents = (await Api.GetAsync<List<ContractDocumentDto>>($"/api/contracts/contracts/{id}/documents")).Value ?? [];
        publishedTemplates = (await Api.GetAsync<PagedResult<ContractTemplateDto>>($"/api/contracts/templates?status=Published&contractType={Uri.EscapeDataString(contract.Type)}&pageSize=100")).Value?.Items.ToList() ?? [];
        documentPreview = null;
        documentErrors = null;
        await ResolveAsync("contracts.contract-party.party", partyNames, parties.Select(p => p.PartyId));
        await ResolveAsync("contracts.contract-party.person", personNames, parties.Select(p => p.PersonId));
    }

    private async Task ResolveAsync(string lookupKey, Dictionary<Guid, string> names, IEnumerable<Guid?> ids)
    {
        var missing = ids.OfType<Guid>().Distinct().Where(id => !names.ContainsKey(id)).ToList();
        if (missing.Count == 0) { return; }
        var resolved = await Api.PostAsync<LookupResolveDto>($"/api/lookups/{lookupKey}/resolve", new ResolveLookupRequest(missing));
        foreach (var item in resolved.Value?.Items ?? [])
        {
            names[item.Id] = item.Label ?? "—";
        }
    }

