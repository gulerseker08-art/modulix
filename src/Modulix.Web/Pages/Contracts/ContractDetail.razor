@page "/sozlesmeler/yeni"
@page "/sozlesmeler/{Id:guid}"
@inject ApiClient Api
@inject SessionState Session
@inject CrmLookups Lookups
@inject NavigationManager Navigation
@inject IJSRuntime Js

<PageTitle>@(contract?.Title ?? "Yeni sözleşme") · Modulix</PageTitle>

<NavigationLock ConfirmExternalNavigation="@(dirty || childDirty)" OnBeforeInternalNavigation="ConfirmLeaveAsync" />

<AuthGate Module="@ContractsAccess.ModuleKey" Permission="@ContractsAccess.ContractsRead">
    @if (notFound)
    {
        <div class="alert alert-warning" role="alert">Sözleşme bulunamadı ya da erişim yetkiniz yok. <a href="sozlesmeler">Sözleşmelere dön</a></div>
    }
    else if (Id is not null && contract is null)
    {
        <p class="text-muted" role="status">Yükleniyor…</p>
    }
    else
    {
        <div class="page-header">
            <div>
                <h1>@(contract?.Title ?? "Yeni sözleşme")</h1>
                @if (contract is not null)
                {
                    <p class="text-muted mb-0">
                        @contract.Number · Sürüm V@(contract.CurrentVersionNo)@(contract.EffectiveVersionNo is { } ev ? $" · Yürürlükte V{ev}" : "")
                        <span class="badge stage-@ContractLabels.EffectiveBadge(contract.EffectiveStatus)">@ContractLabels.Label(ContractLabels.Effectives, contract.EffectiveStatus)</span>
                        <span class="badge stage-open">@ContractLabels.Label(ContractLabels.Preparations, contract.PreparationStatus)</span>
                        <span class="badge stage-@ContractLabels.ApprovalBadge(contract.ApprovalStatus)">@ContractLabels.Label(ContractLabels.Approvals, contract.ApprovalStatus)</span>
                        <span class="badge stage-@ContractLabels.SignatureBadge(contract.SignatureStatus)">@ContractLabels.Label(ContractLabels.Signatures, contract.SignatureStatus)</span>
                    </p>
                }
            </div>
            <div class="header-actions">
                <a class="btn btn-outline-secondary" href="sozlesmeler">Listeye dön</a>
                @if (contract is not null && CanWrite)
                {
                    <button type="button" class="btn btn-outline-danger" @onclick="DeleteAsync" disabled="@busy">Taslağı sil</button>
                }
            </div>
        </div>

        <Notice Text="@notice" Failed="@noticeFailed" />

        @if (contract is not null)
        {
            <div class="kpi-strip" role="list" aria-label="Kritik tarihler">
                <div role="listitem"><span class="kpi-label">Başlangıç</span><span class="kpi-value">@ContractLabels.Date(contract.StartDate)</span></div>
                <div role="listitem"><span class="kpi-label">Bitiş</span><span class="kpi-value">@(contract.IsIndefinite ? "Belirsiz süreli" : ContractLabels.Date(contract.EndDate))</span></div>
                <div role="listitem"><span class="kpi-label">Son bildirim tarihi</span><span class="kpi-value">@ContractLabels.Date(contract.NoticeDeadline)</span></div>
                <div role="listitem"><span class="kpi-label">Tek seferlik toplam</span><span class="kpi-value">@ContractLabels.Money(contract.GrossTotal, contract.Currency)</span></div>
            </div>

            @if (!Editable)
            {
                <div class="alert alert-info" role="status">
                    Bu sözleşmenin içeriği salt okunurdur (hazırlık durumu, onay ya da imza süreci nedeniyle). Değişiklik için yeni revizyon ya da ek protokol gerekir.
                    @if (!string.IsNullOrWhiteSpace(contract.StatusReason)) { <span> Gerekçe: @contract.StatusReason</span> }
                </div>
            }

            <section aria-labelledby="actions-title" class="contract-actions">
                <h2 id="actions-title" class="visually-hidden">İşlemler</h2>
                @if (reasonAction is not null)
                {
                    <form class="record-form" novalidate @onsubmit="ConfirmReasonAsync" @onsubmit:preventDefault>
                        <label class="form-label" for="reason">@ContractActionLabels.Action(reasonAction) için gerekçe @(actions.FirstOrDefault(a => a.Action == reasonAction)?.RequiresReason == true ? "*" : "(isteğe bağlı)")</label>
                        <textarea id="reason" class="form-control" rows="2" maxlength="500" @bind="reasonText"></textarea>
                        <FieldError Field="reason" Errors="actionErrors" />
                        <div class="form-actions">
                            <button type="submit" class="btn btn-primary" disabled="@busy">Onayla</button>
                            <button type="button" class="btn btn-outline-secondary" @onclick="() => reasonAction = null">Vazgeç</button>
                        </div>
                    </form>
                }
                <div class="header-actions" role="group" aria-label="Sözleşme işlemleri">
                    @foreach (var action in actions.Where(a => a.Allowed))
                    {
                        <button type="button" class="btn @(ContractActionLabels.IsPrimary(action.Action) ? "btn-primary" : "btn-outline-secondary")" disabled="@busy"
                                @onclick="() => StartActionAsync(action)">@ContractActionLabels.Action(action.Action)</button>
                    }
                </div>
                @if (actions.Any(a => !a.Allowed))
                {
                    <details class="small text-muted">
                        <summary>Şu an yapılamayan işlemler (@actions.Count(a => !a.Allowed))</summary>
                        <ul class="action-reasons">
                            @foreach (var action in actions.Where(a => !a.Allowed))
                            {
                                <li><strong>@ContractActionLabels.Action(action.Action):</strong> @action.Message</li>
                            }
                        </ul>
                    </details>
                }
            </section>

            <TabBar Tabs="Tabs" State="tabs" Label="Sözleşme bölümleri" Changed="_ => { }" />
        }

        @if (contract is null || tabs.Rendered(TabGeneral))
        {
            <div role="tabpanel" id="tabpanel-@TabGeneral" aria-labelledby="tab-@TabGeneral" class="record-tabpanel" hidden="@(contract is not null && tabs.Hidden(TabGeneral))">
                <form class="record-form" novalidate @onsubmit="SaveAsync" @onsubmit:preventDefault>
                    <fieldset disabled="@(!CanEditHeader || busy)">
                        <legend class="visually-hidden">Genel bilgiler</legend>
                        @if (errors is { Count: > 0 })
                        {
                            <div class="alert alert-danger" role="alert">
                                <strong>Kaydetmeden önce şunları düzeltin:</strong>
                                <ul class="mb-0">
                                    @foreach (var (_, messages) in errors)
                                    {
                                        foreach (var text in messages) { <li>@text</li> }
                                    }
                                </ul>
                            </div>
                        }
                        <div class="form-grid" @oninput="() => dirty = true">
                            <div class="span-all">
                                <label class="form-label" for="c-title">Başlık *</label>
                                <input id="c-title" class="form-control" maxlength="200" @bind="form.Title" aria-invalid="@(errors?.ContainsKey("title") == true)" />
                                <FieldError Field="title" Errors="errors" />
                            </div>
                            <div>
                                <label class="form-label" for="partyId">Müşteri *</label>
                                <LookupPicker Id="partyId" LookupKey="contracts.contract.party" @bind-Value="form.PartyId" Required="true"
                                              Invalid="@(errors?.ContainsKey("partyId") == true)" ReadOnly="@(!CanEditHeader)" />
                                <FieldError Field="partyId" Errors="errors" />
                            </div>
                            <div>
                                <label class="form-label" for="personId">İlgili kişi</label>
                                <LookupPicker Id="personId" LookupKey="contracts.contract.person" @bind-Value="form.PersonId" ParentId="form.PartyId" Placeholder="—"
                                              Invalid="@(errors?.ContainsKey("personId") == true)" ReadOnly="@(!CanEditHeader)" />
                                <FieldError Field="personId" Errors="errors" />
                            </div>
                            <div>
                                <label class="form-label" for="c-type">Tür *</label>
                                <select id="c-type" class="form-select" @bind="form.Type">
                                    @foreach (var t in Lookups.Choices(ContractsAccess.ContractTypeList, contract?.Type))
                                    {
                                        <option value="@t.Key">@t.Label</option>
                                    }
                                </select>
                                <FieldError Field="type" Errors="errors" />
                            </div>
                            <div>
                                <label class="form-label" for="ownerId">Sorumlu</label>
                                <LookupPicker Id="ownerId" LookupKey="contracts.contract.owner" @bind-Value="form.OwnerId" Placeholder="@(contract is null ? "Ben" : "—")" ReadOnly="@(!CanEditHeader)" />
                            </div>
                            <div>
                                <label class="form-label" for="c-start">Başlangıç tarihi</label>
                                <input id="c-start" type="date" class="form-control" @bind="form.StartDate" />
                                <FieldError Field="startDate" Errors="errors" />
                            </div>
                            <div>
                                <label class="form-label" for="c-end">Bitiş tarihi</label>
                                <input id="c-end" type="date" class="form-control" @bind="form.EndDate" disabled="@form.IsIndefinite" />
                                <FieldError Field="endDate" Errors="errors" />
                            </div>
                            <div class="form-check">
                                <input id="c-indef" type="checkbox" class="form-check-input" @bind="form.IsIndefinite" />
                                <label class="form-check-label" for="c-indef">Belirsiz süreli sözleşme</label>
                            </div>
                            <div>
                                <label class="form-label" for="c-renewal">Yenileme yöntemi</label>
                                <select id="c-renewal" class="form-select" @bind="form.RenewalMode">
                                    @foreach (var m in ContractLabels.RenewalModes) { <option value="@m.Key">@m.Label</option> }
                                </select>
                                <FieldError Field="renewalMode" Errors="errors" />
                            </div>
                            <div>
                                <label class="form-label" for="c-renewal-months">Yenileme süresi (ay)</label>
                                <input id="c-renewal-months" type="number" min="1" max="120" class="form-control" @bind="form.RenewalPeriodMonths" disabled="@(form.RenewalMode == "None")" />
                                <FieldError Field="renewalPeriodMonths" Errors="errors" />
                            </div>
                            <div>
                                <label class="form-label" for="c-notice">Bildirim süresi (gün)</label>
                                <input id="c-notice" type="number" min="0" max="3650" class="form-control" @bind="form.NoticePeriodDays" />
                                <small class="text-muted">Son bildirim tarihi = bitiş − bildirim süresi; sunucu hesaplar.</small>
                                <FieldError Field="noticePeriodDays" Errors="errors" />
                            </div>
                            <div>
                                <label class="form-label" for="c-currency">Para birimi *</label>
                                <input id="c-currency" class="form-control" maxlength="3" @bind="form.Currency" />
                                <FieldError Field="currency" Errors="errors" />
                            </div>
                            <div>
                                <label class="form-label" for="c-tax">Fiyatlandırma biçimi</label>
                                <select id="c-tax" class="form-select" @bind="form.PriceIncludesTax">
                                    <option value="False">Fiyatlar vergi hariç</option>
                                    <option value="True">Fiyatlar vergi dahil</option>
                                </select>
                            </div>
                            @if (Session.Can(ContractsAccess.FinancialsRead))
                            {
                                <div>
                                    <label class="form-label" for="c-value">Sözleşme bedeli (isteğe bağlı)</label>
                                    <input id="c-value" type="number" step="0.01" min="0" class="form-control" @bind="form.ContractValue" />
                                    <small class="text-muted">Kalem toplamından bağımsız üst limit ya da toplam bedel.</small>
                                    <FieldError Field="contractValue" Errors="errors" />
                                </div>
                            }
                            <div>
                                <label class="form-label" for="c-conf">Gizlilik</label>
                                <select id="c-conf" class="form-select" @bind="form.Confidentiality">
                                    @foreach (var c in ContractLabels.Confidentialities) { <option value="@c.Key">@c.Label</option> }
                                </select>
                            </div>
                            <div>
                                <label class="form-label" for="previousContractId">Önceki sözleşme</label>
                                <LookupPicker Id="previousContractId" LookupKey="contracts.contract.previous" @bind-Value="form.PreviousContractId" Placeholder="—"
                                              Invalid="@(errors?.ContainsKey("previousContractId") == true)" ReadOnly="@(!CanEditHeader)" />
                                <FieldError Field="previousContractId" Errors="errors" />
                            </div>
                            <div class="span-all">
                                <label class="form-label" for="c-desc">Açıklama</label>
                                <textarea id="c-desc" class="form-control" rows="3" maxlength="4000" @bind="form.Description"></textarea>
                            </div>
                            <div class="span-all">
                                <label class="form-label" for="c-payment">Ödeme koşulları</label>
                                <textarea id="c-payment" class="form-control" rows="3" maxlength="4000" @bind="form.PaymentTerms"></textarea>
                            </div>
                        </div>
                    </fieldset>
                    @if (CanEditHeader)
                    {
                        <div class="form-actions">
                            <button type="submit" class="btn btn-primary" disabled="@busy">@(contract is null ? "Taslağı oluştur" : "Kaydet")</button>
                            @if (dirty) { <span class="text-muted" role="status">Kaydedilmemiş değişiklikler var.</span> }
                        </div>
                    }
                </form>
            </div>
        }

        @if (contract is not null && tabs.Rendered(TabParties))
        {
            <div role="tabpanel" id="tabpanel-@TabParties" aria-labelledby="tab-@TabParties" class="record-tabpanel" hidden="@tabs.Hidden(TabParties)">
                <section aria-labelledby="parties-title">
                    <h2 id="parties-title">Taraflar ve kişiler</h2>
                    <p class="text-muted">Müşteri genel bilgilerde seçilir; burada ek taraflar (kefil, alt yüklenici) ve rolleriyle ilgili kişiler tutulur.</p>
                    @if (Editable && CanWrite && partyForm is null)
                    {
                        <button type="button" class="btn btn-outline-primary" @onclick="NewParty">Taraf / kişi ekle</button>
                    }
                    @if (partyForm is not null)
                    {
                        <form class="record-form" novalidate @onsubmit="SavePartyAsync" @onsubmit:preventDefault>
                            <h3>@(partyForm.Id is null ? "Yeni taraf" : "Tarafı düzenle")</h3>
                            @if (childMessage is not null) { <div class="alert alert-danger" role="alert">@childMessage</div> }
                            <div class="form-grid" @oninput="() => childDirty = true">
                                <div>
                                    <label class="form-label" for="p-role">Rol *</label>
                                    <select id="p-role" class="form-select" @bind="partyForm.Role">
                                        @foreach (var r in ContractLabels.PartyRoles) { <option value="@r.Key">@r.Label</option> }
                                    </select>
                                </div>
                                <div>
                                    <label class="form-label" for="p-party">Taraf</label>
                                    <LookupPicker Id="p-party" LookupKey="contracts.contract-party.party" @bind-Value="partyForm.PartyId" Placeholder="—"
                                                  Invalid="@(childErrors?.ContainsKey("partyId") == true)" />
                                    <FieldError Field="partyId" Errors="childErrors" />
                                </div>
                                <div>
                                    <label class="form-label" for="p-person">Kişi</label>
                                    <LookupPicker Id="p-person" LookupKey="contracts.contract-party.person" @bind-Value="partyForm.PersonId" ParentId="partyForm.PartyId" Placeholder="—"
                                                  Invalid="@(childErrors?.ContainsKey("personId") == true)" />
                                    <FieldError Field="personId" Errors="childErrors" />
                                </div>
                                <div class="span-all">
                                    <label class="form-label" for="p-notes">Not</label>
                                    <input id="p-notes" class="form-control" maxlength="1000" @bind="partyForm.Notes" />
                                </div>
                            </div>
                            <div class="form-actions">
                                <button type="submit" class="btn btn-primary" disabled="@busy">Kaydet</button>
                                <button type="button" class="btn btn-outline-secondary" @onclick="CancelChild">Vazgeç</button>
                            </div>
                        </form>
                    }
                    @if (parties.Count == 0)
                    {
                        <p class="text-muted">Henüz ek taraf yok.</p>
                    }
                    else
                    {
                        <table class="table record-table">
                            <caption class="visually-hidden">Sözleşme tarafları</caption>
                            <thead><tr><th scope="col">Rol</th><th scope="col">Taraf</th><th scope="col">Kişi</th><th scope="col">Not</th><th scope="col"><span class="visually-hidden">İşlemler</span></th></tr></thead>
                            <tbody>
                                @foreach (var p in parties)
                                {
                                    <tr>
                                        <td data-label="Rol">@ContractLabels.Label(ContractLabels.PartyRoles, p.Role)</td>
                                        <td data-label="Taraf">@Name(partyNames, p.PartyId)</td>
                                        <td data-label="Kişi">@Name(personNames, p.PersonId)</td>
                                        <td data-label="Not">@p.Notes</td>
                                        <td data-label="İşlemler">
                                            @if (Editable && CanWrite)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => EditParty(p)">Düzenle</button>
                                                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => DeletePartyAsync(p)">Kaldır</button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </section>
            </div>
        }

        @if (contract is not null && tabs.Rendered(TabLines))
        {
            <div role="tabpanel" id="tabpanel-@TabLines" aria-labelledby="tab-@TabLines" class="record-tabpanel" hidden="@tabs.Hidden(TabLines)">
                <section aria-labelledby="lines-title">
                    <h2 id="lines-title">Kapsam ve ticari kalemler</h2>
                    @if (Editable && CanWrite && lineForm is null)
                    {
                        <button type="button" class="btn btn-outline-primary" @onclick="NewLine">Kalem ekle</button>
                    }
                    @if (lineForm is not null)
                    {
                        <form class="record-form" novalidate @onsubmit="SaveLineAsync" @onsubmit:preventDefault>
                            <h3>@(lineForm.Id is null ? "Yeni kalem" : "Kalemi düzenle")</h3>
                            @if (childMessage is not null) { <div class="alert alert-danger" role="alert">@childMessage</div> }
                            <div class="form-grid" @oninput="() => childDirty = true">
                                <div>
                                    <label class="form-label" for="l-kind">Tür</label>
                                    <select id="l-kind" class="form-select" @bind="lineForm.Kind">
                                        @foreach (var k in ContractLabels.LineKinds) { <option value="@k.Key">@k.Label</option> }
                                    </select>
                                </div>
                                <div>
                                    <label class="form-label" for="l-name">Ad *</label>
                                    <input id="l-name" class="form-control" maxlength="200" @bind="lineForm.Name" />
                                    <FieldError Field="name" Errors="childErrors" />
                                </div>
                                <div>
                                    <label class="form-label" for="l-code">Kod</label>
                                    <input id="l-code" class="form-control" maxlength="50" @bind="lineForm.ProductCode" />
                                </div>
                                @if (lineForm.Kind != "Text")
                                {
                                    <div>
                                        <label class="form-label" for="l-qty">Miktar *</label>
                                        <input id="l-qty" type="number" step="any" min="0" class="form-control" @bind="lineForm.Quantity" />
                                        <FieldError Field="quantity" Errors="childErrors" />
                                    </div>
                                    <div>
                                        <label class="form-label" for="l-unit">Birim</label>
                                        <input id="l-unit" class="form-control" maxlength="50" @bind="lineForm.UnitName" />
                                    </div>
                                    @if (Session.Can(ContractsAccess.FinancialsRead))
                                    {
                                        <div>
                                            <label class="form-label" for="l-price">Birim fiyat *</label>
                                            <input id="l-price" type="number" step="any" min="0" class="form-control" @bind="lineForm.UnitPrice" />
                                            <FieldError Field="unitPrice" Errors="childErrors" />
                                        </div>
                                        <div>
                                            <label class="form-label" for="l-disc">İndirim (%)</label>
                                            <input id="l-disc" type="number" step="any" min="0" max="100" class="form-control" @bind="lineForm.DiscountPercent" />
                                            <FieldError Field="discountPercent" Errors="childErrors" />
                                        </div>
                                    }
                                    <div>
                                        <label class="form-label" for="l-tax">Vergi oranı (%)</label>
                                        <input id="l-tax" type="number" step="any" min="0" max="100" class="form-control" @bind="lineForm.TaxRatePercent" />
                                        <FieldError Field="taxRatePercent" Errors="childErrors" />
                                    </div>
                                    <div>
                                        <label class="form-label" for="l-period">Ücret dönemi</label>
                                        <select id="l-period" class="form-select" @bind="lineForm.BillingPeriod">
                                            @foreach (var p in ContractLabels.Periods) { <option value="@p.Key">@p.Label</option> }
                                        </select>
                                    </div>
                                }
                                <div class="span-all">
                                    <label class="form-label" for="l-desc">Açıklama</label>
                                    <textarea id="l-desc" class="form-control" rows="2" maxlength="2000" @bind="lineForm.Description"></textarea>
                                </div>
                            </div>
                            <div class="form-actions">
                                <button type="submit" class="btn btn-primary" disabled="@busy">Kaydet</button>
                                <button type="button" class="btn btn-outline-secondary" @onclick="CancelChild">Vazgeç</button>
                            </div>
                        </form>
                    }
                    @if (lines.Count == 0)
                    {
                        <p class="text-muted">Henüz kalem yok.</p>
                    }
                    else
                    {
                        <table class="table record-table">
                            <caption class="visually-hidden">Sözleşme kalemleri</caption>
                            <thead>
                                <tr>
                                    <th scope="col">#</th><th scope="col">Kalem</th><th scope="col" class="text-end">Miktar</th><th scope="col" class="text-end">Birim fiyat</th>
                                    <th scope="col" class="text-end">Vergi %</th><th scope="col">Dönem</th><th scope="col" class="text-end">Net</th><th scope="col" class="text-end">Toplam</th>
                                    <th scope="col"><span class="visually-hidden">İşlemler</span></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var l in lines)
                                {
                                    <tr>
                                        <td data-label="#">@l.Position</td>
                                        <td data-label="Kalem" class="primary">@l.Name @if (l.ProductCode is not null) { <small class="text-muted">@l.ProductCode</small> }</td>
                                        <td data-label="Miktar" class="text-end">@(l.Kind == "Text" ? "—" : $"{l.Quantity.ToString("G29", Regional.Numbers)} {l.UnitName}")</td>
                                        <td data-label="Birim fiyat" class="text-end">@(l.Kind == "Text" ? "—" : ContractLabels.Money(l.UnitPrice, contract.Currency))</td>
                                        <td data-label="Vergi %" class="text-end">@l.TaxRatePercent.ToString("G29", Regional.Numbers)</td>
                                        <td data-label="Dönem">@ContractLabels.Label(ContractLabels.Periods, l.BillingPeriod ?? "")</td>
                                        <td data-label="Net" class="text-end">@(l.Kind == "Text" ? "—" : ContractLabels.Money(l.Net, contract.Currency))</td>
                                        <td data-label="Toplam" class="text-end">@(l.Kind == "Text" ? "—" : ContractLabels.Money(l.Gross, contract.Currency))</td>
                                        <td data-label="İşlemler">
                                            @if (Editable && CanWrite)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => EditLine(l)">Düzenle</button>
                                                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => DeleteLineAsync(l)">Kaldır</button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <th scope="row" colspan="6">Tek seferlik toplam (net / vergi / genel)</th>
                                    <td class="text-end" colspan="2">@ContractLabels.Money(contract.NetTotal, contract.Currency) / @ContractLabels.Money(contract.TaxTotal, contract.Currency) / @ContractLabels.Money(contract.GrossTotal, contract.Currency)</td>
                                    <td></td>
                                </tr>
                                @foreach (var r in Recurring())
                                {
                                    <tr>
                                        <th scope="row" colspan="6">@ContractLabels.Label(ContractLabels.Periods, r.Period) dönemsel toplam</th>
                                        <td class="text-end" colspan="2">@ContractLabels.Money(r.Net, contract.Currency) / @ContractLabels.Money(r.Tax, contract.Currency) / @ContractLabels.Money(r.Gross, contract.Currency)</td>
                                        <td></td>
                                    </tr>
                                }
                            </tfoot>
                        </table>
                        <p class="text-muted">Dönemsel tutarlar sözleşme süresiyle çarpılarak genel toplama eklenmez; tutarlar sunucuda hesaplanır.</p>
                    }
                </section>
            </div>
        }

        @if (contract is not null && tabs.Rendered(TabVersions))
        {
            <div role="tabpanel" id="tabpanel-@TabVersions" aria-labelledby="tab-@TabVersions" class="record-tabpanel" hidden="@tabs.Hidden(TabVersions)">
                <section aria-labelledby="versions-title">
                    <h2 id="versions-title">Sürümler</h2>
                    <p class="text-muted">Onaya gönderilen içerik dondurulur ve SHA-256 özetiyle saklanır; güncel taslak V@(contract.CurrentVersionNo)@(contract.EffectiveVersionNo is { } ev2 ? $", yürürlükteki sürüm V{ev2}" : "").</p>
                    @if (versions.Count == 0)
                    {
                        <p class="text-muted">Henüz dondurulmuş sürüm yok; ilk sürüm onaya gönderildiğinde oluşur.</p>
                    }
                    else
                    {
                        <table class="table record-table">
                            <caption class="visually-hidden">Sözleşme sürümleri</caption>
                            <thead><tr><th scope="col">Sürüm</th><th scope="col">Durum</th><th scope="col">Dondurulma</th><th scope="col">Özet (SHA-256)</th><th scope="col">Gerekçe</th><th scope="col"><span class="visually-hidden">İşlemler</span></th></tr></thead>
                            <tbody>
                                @foreach (var v in versions)
                                {
                                    <tr>
                                        <td data-label="Sürüm">V@(v.VersionNo) <small class="text-muted">@(v.Kind == "Approval" ? "onay" : "imza")</small></td>
                                        <td data-label="Durum">@ContractLabels.Label(ContractActionLabels.VersionStatuses, v.Status)</td>
                                        <td data-label="Dondurulma">@CrmLabels.Time(v.FrozenAt) · @Lookups.MemberName(v.CreatedBy)</td>
                                        <td data-label="Özet"><code title="@v.Sha256">@v.Sha256[..12]…</code></td>
                                        <td data-label="Gerekçe">@v.Reason</td>
                                        <td data-label="İşlemler">
                                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => CompareAsync(v.VersionNo, 0)">Güncel taslakla karşılaştır</button>
                                            @if (versions.FirstOrDefault(o => o.VersionNo < v.VersionNo) is { } previous)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => CompareAsync(previous.VersionNo, v.VersionNo)">V@(previous.VersionNo) ile karşılaştır</button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    @if (compare is not null)
                    {
                        <section aria-labelledby="compare-title" class="compare">
                            <h3 id="compare-title">Karşılaştırma: V@(compareFrom) → @(compareTo == 0 ? "güncel taslak" : $"V{compareTo}")</h3>
                            @if (compare.Header.Count == 0 && compare.Lines.Count == 0 && compare.Parties.Count == 0)
                            {
                                <p class="text-muted">İki sürüm arasında fark yok.</p>
                            }
                            @if (compare.Header.Count > 0)
                            {
                                <table class="table record-table">
                                    <caption>Alan farkları</caption>
                                    <thead><tr><th scope="col">Alan</th><th scope="col">Önce</th><th scope="col">Sonra</th></tr></thead>
                                    <tbody>
                                        @foreach (var f in compare.Header)
                                        {
                                            <tr><td data-label="Alan">@ContractActionLabels.Field(f.Field)</td><td data-label="Önce">@(f.Before ?? "—")</td><td data-label="Sonra">@(f.After ?? "—")</td></tr>
                                        }
                                    </tbody>
                                </table>
                            }
                            @if (compare.Lines.Count > 0)
                            {
                                <table class="table record-table">
                                    <caption>Kalem farkları</caption>
                                    <thead><tr><th scope="col">Kalem</th><th scope="col">Değişiklik</th><th scope="col">Ayrıntı</th></tr></thead>
                                    <tbody>
                                        @foreach (var l in compare.Lines)
                                        {
                                            <tr>
                                                <td data-label="Kalem">@l.Name</td>
                                                <td data-label="Değişiklik">@ContractActionLabels.Change(l.Change)</td>
                                                <td data-label="Ayrıntı">@string.Join("; ", l.Fields.Where(f => l.Change != "Changed" ? f.After is not null || f.Before is not null : true).Select(f => $"{ContractActionLabels.Field(f.Field)}: {f.Before ?? "—"} → {f.After ?? "—"}"))</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                            @if (compare.Parties.Count > 0)
                            {
                                <table class="table record-table">
                                    <caption>Taraf farkları</caption>
                                    <thead><tr><th scope="col">Rol</th><th scope="col">Değişiklik</th><th scope="col">Ayrıntı</th></tr></thead>
                                    <tbody>
                                        @foreach (var p in compare.Parties)
                                        {
                                            <tr>
                                                <td data-label="Rol">@ContractLabels.Label(ContractLabels.PartyRoles, p.Role)</td>
                                                <td data-label="Değişiklik">@ContractActionLabels.Change(p.Change)</td>
                                                <td data-label="Ayrıntı">@string.Join("; ", p.Fields.Select(f => $"{ContractActionLabels.Field(f.Field)}: {f.Before ?? "—"} → {f.After ?? "—"}"))</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                        </section>
                    }
                </section>
            </div>
        }

        @if (contract is not null && tabs.Rendered(TabHistory))
        {
            <div role="tabpanel" id="tabpanel-@TabHistory" aria-labelledby="tab-@TabHistory" class="record-tabpanel" hidden="@tabs.Hidden(TabHistory)">
                <section aria-labelledby="timeline-title">
                    <h2 id="timeline-title">Sözleşme tarihçesi</h2>
                    @if (history.Count == 0)
                    {
                        <p class="text-muted">Tarihçe yok.</p>
                    }
                    else
                    {
                        <ol class="timeline">
                            @foreach (var h in history)
                            {
                                <li>
                                    <strong>@ContractActionLabels.History(h.Kind)</strong> · @CrmLabels.Time(h.At) · @Lookups.MemberName(h.ActorId)
                                    @if (h.FromStatus is not null || h.ToStatus is not null) { <span> (@h.FromStatus → @h.ToStatus)</span> }
                                    @if (!string.IsNullOrWhiteSpace(h.Reason)) { <div class="text-muted">@h.Reason</div> }
                                </li>
                            }
                        </ol>
                    }
                </section>
                <section aria-labelledby="audit-title">
                    <h2 id="audit-title">İşlem geçmişi</h2>
                    <RecordHistory EntityKey="contracts.contract" RecordId="contract.Id" Version="contract.Version" />
                </section>
            </div>
        }
    }
</AuthGate>

@code {
    private const string TabGeneral = "general";
    private const string TabParties = "parties";
    private const string TabLines = "lines";
    private const string TabVersions = "versions";
    private const string TabHistory = "history";

    [Parameter] public Guid? Id { get; set; }

    private readonly TabState tabs = new(TabGeneral);
    private ContractDto? contract;
    private ContractForm form = new();
    private List<ContractPartyDto> parties = [];
    private List<ContractLineDto> lines = [];
    private List<ContractHistoryDto> history = [];
    private List<ContractActionDto> actions = [];
    private List<ContractVersionDto> versions = [];
    private ContractCompareDto? compare;
    private int compareFrom;
    private int compareTo;
    private string? reasonAction;
    private string reasonText = string.Empty;
    private IReadOnlyDictionary<string, string[]>? actionErrors;
    private readonly Dictionary<Guid, string> partyNames = [];
    private readonly Dictionary<Guid, string> personNames = [];
    private PartyForm? partyForm;
    private LineForm? lineForm;
    private IReadOnlyDictionary<string, string[]>? errors;
    private IReadOnlyDictionary<string, string[]>? childErrors;
    private string? childMessage;
    private string? notice;
    private bool noticeFailed;
    private bool notFound;
    private bool busy;
    private bool dirty;
    private bool childDirty;

    private bool CanWrite => Session.Can(ContractsAccess.ContractsWrite);

    /// <summary>İçerik düzenlemesi: sunucu kuralının (ContractRules.CanEditContent) arayüzdeki karşılığı; API yine de denetler.</summary>
    private bool Editable => contract is null
        || (contract.PreparationStatus == "Draft" && contract.ApprovalStatus != "Pending"
            && contract.SignatureStatus is "NotSent" or "Rejected" or "Expired" or "Cancelled"
            && contract.EffectiveStatus is "NotInForce" or "Cancelled");

    private bool CanEditHeader => CanWrite && Editable;

    private IReadOnlyList<TabItem> Tabs =>
    [
        new(TabGeneral, "Genel bilgiler"),
        new(TabParties, "Taraflar ve kişiler", parties.Count),
        new(TabLines, "Kapsam ve kalemler", lines.Count),
        new(TabVersions, "Sürümler", versions.Count),
        new(TabHistory, "Tarihçe"),
    ];

    protected override async Task OnParametersSetAsync()
    {
        await Session.EnsureLoadedAsync();
        if (!Session.Can(ContractsAccess.ContractsRead)) { return; }
        await Lookups.LoadAsync();
        if (Id is { } id)
        {
            await LoadAsync(id);
        }
        else
        {
            contract = null;
            form = new ContractForm { Type = Lookups.DefaultOf(ContractsAccess.ContractTypeList) ?? "Service", Currency = Regional.Currency };
        }
    }

    private async Task LoadAsync(Guid id)
    {
        var result = await Api.GetAsync<ContractDto>($"/api/contracts/contracts/{id}");
        if (!result.IsSuccess)
        {
            notFound = true;
            return;
        }

        contract = result.Value!;
        form = ContractForm.From(contract);
        parties = (await Api.GetAsync<PagedResult<ContractPartyDto>>($"/api/contracts/contract-parties?contractId={id}&pageSize=200")).Value?.Items.ToList() ?? [];
        lines = (await Api.GetAsync<PagedResult<ContractLineDto>>($"/api/contracts/contract-lines?contractId={id}&pageSize=200")).Value?.Items.ToList() ?? [];
        history = (await Api.GetAsync<List<ContractHistoryDto>>($"/api/contracts/contracts/{id}/history")).Value ?? [];
        actions = (await Api.GetAsync<List<ContractActionDto>>($"/api/contracts/contracts/{id}/actions")).Value ?? [];
        versions = (await Api.GetAsync<List<ContractVersionDto>>($"/api/contracts/contracts/{id}/versions")).Value ?? [];
        compare = null;
        await ResolveAsync("contracts.contract-party.party", partyNames, parties.Select(p => p.PartyId));
        await ResolveAsync("contracts.contract-party.person", personNames, parties.Select(p => p.PersonId));
    }

    private async Task ResolveAsync(string lookupKey, Dictionary<Guid, string> names, IEnumerable<Guid?> ids)
    {
        var missing = ids.OfType<Guid>().Distinct().Where(id => !names.ContainsKey(id)).ToList();
        if (missing.Count == 0) { return; }
        var resolved = await Api.PostAsync<LookupResolveDto>($"/api/lookups/{lookupKey}/resolve", new ResolveLookupRequest(missing));
        foreach (var item in resolved.Value?.Items ?? [])
        {
            names[item.Id] = item.Label ?? "—";
        }
    }

    private static string Name(Dictionary<Guid, string> names, Guid? id) => id is { } key && names.TryGetValue(key, out var name) ? name : (id is null ? "—" : "…");

    private async Task ConfirmLeaveAsync(LocationChangingContext context)
    {
        if ((dirty || childDirty) && !await Js.InvokeAsync<bool>("confirm", "Kaydedilmemiş değişiklikler var. Sayfadan ayrılmak istiyor musunuz?"))
        {
            context.PreventNavigation();
        }
    }

    private async Task SaveAsync()
    {
        if (busy) { return; }
        busy = true;
        var request = new SaveContractRequest(
            form.Title, form.PartyId ?? Guid.Empty, form.Type, Blank(form.Description), form.PersonId, form.OwnerId, form.PreviousContractId,
            form.StartDate, form.IsIndefinite ? null : form.EndDate, form.IsIndefinite, form.Currency, form.PriceIncludesTax,
            Session.Can(ContractsAccess.FinancialsRead) ? form.ContractValue : null, Blank(form.PaymentTerms), form.RenewalMode,
            form.RenewalMode == "None" ? null : form.RenewalPeriodMonths, form.NoticePeriodDays, form.Confidentiality, contract?.Version);
        var result = contract is { } current
            ? await Api.PutAsync<ContractDto>($"/api/contracts/contracts/{current.Id}", request)
            : await Api.PostAsync<ContractDto>("/api/contracts/contracts", request);
        busy = false;

        if (!result.IsSuccess)
        {
            errors = result.FieldErrors;
            Notify(result.Status == System.Net.HttpStatusCode.Conflict ? $"{result.Error} Sayfayı yenileyip tekrar deneyin." : result.Error, failed: true);
            return;
        }

        errors = null;
        dirty = false;
        if (contract is null)
        {
            Navigation.NavigateTo($"sozlesmeler/{result.Value!.Id}");
            return;
        }

        Notify("Sözleşme kaydedildi.");
        await LoadAsync(contract.Id);
    }

    private async Task DeleteAsync()
    {
        if (contract is null || busy) { return; }
        if (!await Js.InvokeAsync<bool>("confirm", "Bu sözleşme taslağı kalemleri ve taraflarıyla birlikte silinecek. Devam edilsin mi?")) { return; }
        busy = true;
        var result = await Api.DeleteAsync($"/api/contracts/contracts/{contract.Id}?version={contract.Version}");
        busy = false;
        if (!result.IsSuccess)
        {
            Notify(result.Error, failed: true);
            return;
        }

        dirty = false;
        Navigation.NavigateTo("sozlesmeler");
    }

    private void NewParty() { partyForm = new PartyForm(); childErrors = null; childMessage = null; childDirty = false; }

    private void EditParty(ContractPartyDto p)
    {
        partyForm = new PartyForm { Id = p.Id, Version = p.Version, Role = p.Role, PartyId = p.PartyId, PersonId = p.PersonId, Notes = p.Notes };
        childErrors = null; childMessage = null; childDirty = false;
    }

    private void NewLine() { lineForm = new LineForm(); childErrors = null; childMessage = null; childDirty = false; }

    private void EditLine(ContractLineDto l)
    {
        lineForm = new LineForm
        {
            Id = l.Id, Version = l.Version, Kind = l.Kind, Name = l.Name, ProductCode = l.ProductCode, Description = l.Description, Quantity = l.Quantity,
            UnitName = l.UnitName, UnitPrice = l.UnitPrice, DiscountPercent = l.DiscountPercent, TaxRatePercent = l.TaxRatePercent, BillingPeriod = l.BillingPeriod ?? "",
        };
        childErrors = null; childMessage = null; childDirty = false;
    }

    private void CancelChild() { partyForm = null; lineForm = null; childErrors = null; childMessage = null; childDirty = false; }

    private async Task SavePartyAsync()
    {
        if (contract is null || partyForm is null || busy) { return; }
        busy = true;
        var request = new SaveContractPartyRequest(contract.Id, partyForm.Role, partyForm.PartyId, partyForm.PersonId, null, Blank(partyForm.Notes), partyForm.Version);
        var result = partyForm.Id is { } id
            ? await Api.PutAsync<ContractPartyDto>($"/api/contracts/contract-parties/{id}", request)
            : await Api.PostAsync<ContractPartyDto>("/api/contracts/contract-parties", request);
        busy = false;
        await AfterChildAsync(result.IsSuccess, result.Error, result.FieldErrors, "Taraf kaydedildi.");
    }

    private async Task DeletePartyAsync(ContractPartyDto p)
    {
        if (contract is null || busy) { return; }
        if (!await Js.InvokeAsync<bool>("confirm", "Taraf sözleşmeden kaldırılsın mı?")) { return; }
        busy = true;
        var result = await Api.DeleteAsync($"/api/contracts/contract-parties/{p.Id}?version={p.Version}");
        busy = false;
        await AfterChildAsync(result.IsSuccess, result.Error, null, "Taraf kaldırıldı.");
    }

    private async Task SaveLineAsync()
    {
        if (contract is null || lineForm is null || busy) { return; }
        busy = true;
        var financial = Session.Can(ContractsAccess.FinancialsRead);
        var request = new SaveContractLineRequest(contract.Id, lineForm.Name ?? string.Empty, lineForm.Kind, Blank(lineForm.ProductCode), Blank(lineForm.Description),
            lineForm.Quantity, Blank(lineForm.UnitName), financial ? lineForm.UnitPrice : null, financial ? lineForm.DiscountPercent : null, lineForm.TaxRatePercent,
            string.IsNullOrEmpty(lineForm.BillingPeriod) ? null : lineForm.BillingPeriod, null, lineForm.Version);
        var result = lineForm.Id is { } id
            ? await Api.PutAsync<ContractLineDto>($"/api/contracts/contract-lines/{id}", request)
            : await Api.PostAsync<ContractLineDto>("/api/contracts/contract-lines", request);
        busy = false;
        await AfterChildAsync(result.IsSuccess, result.Error, result.FieldErrors, "Kalem kaydedildi; toplamlar sunucuda yeniden hesaplandı.");
    }

    private async Task DeleteLineAsync(ContractLineDto l)
    {
        if (contract is null || busy) { return; }
        if (!await Js.InvokeAsync<bool>("confirm", "Kalem sözleşmeden kaldırılsın mı?")) { return; }
        busy = true;
        var result = await Api.DeleteAsync($"/api/contracts/contract-lines/{l.Id}?version={l.Version}");
        busy = false;
        await AfterChildAsync(result.IsSuccess, result.Error, null, "Kalem kaldırıldı; toplamlar yeniden hesaplandı.");
    }

    private async Task AfterChildAsync(bool success, string? error, IReadOnlyDictionary<string, string[]>? fieldErrors, string message)
    {
        if (!success)
        {
            childErrors = fieldErrors;
            childMessage = error;
            return;
        }

        CancelChild();
        Notify(message);
        await LoadAsync(contract!.Id);
    }

    private void Notify(string? text, bool failed = false)
    {
        notice = text;
        noticeFailed = failed;
    }

    private IEnumerable<(string Period, decimal? Net, decimal? Tax, decimal? Gross)> Recurring()
    {
        if (string.IsNullOrEmpty(contract?.RecurringSummary)) { yield break; }
        List<RecurringTotal>? totals;
        try
        {
            totals = System.Text.Json.JsonSerializer.Deserialize<List<RecurringTotal>>(contract.RecurringSummary, System.Text.Json.JsonSerializerOptions.Web);
        }
        catch (System.Text.Json.JsonException)
        {
            yield break;
        }

        foreach (var t in totals ?? [])
        {
            yield return (t.Period ?? "", t.Net, t.Tax, t.Gross);
        }
    }

    /// <summary>Gerekçe isteyen eylemde önce gerekçe formu açılır; diğerleri doğrudan çalışır.</summary>
    private Task StartActionAsync(ContractActionDto action)
    {
        actionErrors = null;
        if (action.RequiresReason || action.Action is "reopen-draft" or "withdraw-approval")
        {
            reasonAction = action.Action;
            reasonText = string.Empty;
            return Task.CompletedTask;
        }

        return RunActionAsync(action.Action, null);
    }

    private Task ConfirmReasonAsync() => reasonAction is { } action ? RunActionAsync(action, Blank(reasonText)) : Task.CompletedTask;

    private async Task RunActionAsync(string action, string? reason)
    {
        if (contract is null || busy) { return; }
        if ((dirty || childDirty) && !await Js.InvokeAsync<bool>("confirm", "Kaydedilmemiş değişiklikler var; işlem bunları dikkate almaz. Devam edilsin mi?")) { return; }
        busy = true;
        var result = await Api.PostAsync<ContractDto>($"/api/contracts/contracts/{contract.Id}/{action}", new ContractTransitionRequest(contract.Version, reason));
        busy = false;
        if (!result.IsSuccess)
        {
            actionErrors = result.FieldErrors;
            Notify(result.Status == System.Net.HttpStatusCode.Conflict ? $"{result.Error} Sayfayı yenileyip tekrar deneyin." : result.Error, failed: true);
            if (result.Status == System.Net.HttpStatusCode.Conflict) { await LoadAsync(contract.Id); }
            return;
        }

        reasonAction = null;
        dirty = false;
        Notify($"{ContractActionLabels.Action(action)}: tamamlandı.");
        await LoadAsync(contract.Id);
    }

    private async Task CompareAsync(int from, int to)
    {
        if (contract is null) { return; }
        var result = await Api.GetAsync<ContractCompareDto>($"/api/contracts/contracts/{contract.Id}/versions/{from}/compare?with={to}");
        compare = result.Value;
        compareFrom = from;
        compareTo = to;
        if (!result.IsSuccess) { Notify(result.Error, failed: true); }
    }

    private static string? Blank(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private sealed record RecurringTotal(string? Period, decimal Net, decimal Tax, decimal Gross);

    private sealed class ContractForm
    {
        public string Title { get; set; } = string.Empty;
        public Guid? PartyId { get; set; }
        public Guid? PersonId { get; set; }
        public Guid? OwnerId { get; set; }
        public Guid? PreviousContractId { get; set; }
        public string Type { get; set; } = "Service";
        public DateOnly? StartDate { get; set; }
        public DateOnly? EndDate { get; set; }
        public bool IsIndefinite { get; set; }
        public string Currency { get; set; } = "TRY";
        public bool PriceIncludesTax { get; set; }
        public decimal? ContractValue { get; set; }
        public string RenewalMode { get; set; } = "None";
        public int? RenewalPeriodMonths { get; set; }
        public int? NoticePeriodDays { get; set; }
        public string Confidentiality { get; set; } = "Internal";
        public string? Description { get; set; }
        public string? PaymentTerms { get; set; }

        public static ContractForm From(ContractDto c) => new()
        {
            Title = c.Title, PartyId = c.PartyId, PersonId = c.PersonId, OwnerId = c.OwnerId, PreviousContractId = c.PreviousContractId, Type = c.Type,
            StartDate = c.StartDate, EndDate = c.EndDate, IsIndefinite = c.IsIndefinite, Currency = c.Currency, PriceIncludesTax = c.PriceIncludesTax,
            ContractValue = c.ContractValue, RenewalMode = c.RenewalMode, RenewalPeriodMonths = c.RenewalPeriodMonths, NoticePeriodDays = c.NoticePeriodDays,
            Confidentiality = c.Confidentiality, Description = c.Description, PaymentTerms = c.PaymentTerms,
        };
    }

    private sealed class PartyForm
    {
        public Guid? Id { get; set; }
        public long? Version { get; set; }
        public string Role { get; set; } = "Signatory";
        public Guid? PartyId { get; set; }
        public Guid? PersonId { get; set; }
        public string? Notes { get; set; }
    }

    private sealed class LineForm
    {
        public Guid? Id { get; set; }
        public long? Version { get; set; }
        public string Kind { get; set; } = "Service";
        public string? Name { get; set; }
        public string? ProductCode { get; set; }
        public string? Description { get; set; }
        public decimal Quantity { get; set; } = 1m;
        public string? UnitName { get; set; }
        public decimal? UnitPrice { get; set; }
        public decimal? DiscountPercent { get; set; }
        public decimal TaxRatePercent { get; set; }
        public string BillingPeriod { get; set; } = "";
    }
}
