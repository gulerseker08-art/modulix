        busy = false;
        documentPreview = result.Value;
        if (!result.IsSuccess)
        {
            documentErrors = result.FieldErrors;
            Notify(result.Error, failed: true);
        }
    }

    private async Task GenerateDocumentAsync()
    {
        if (contract is null || !Guid.TryParse(documentTemplateId, out var templateId) || busy) { return; }
        busy = true;
        documentErrors = null;
        var result = await Api.PostAsync<ContractDocumentDto>($"/api/contracts/contracts/{contract.Id}/documents", new GenerateContractDocumentRequest(templateId));
        busy = false;
        if (!result.IsSuccess)
        {
            documentErrors = result.FieldErrors;
            Notify(result.Status == System.Net.HttpStatusCode.Conflict ? Texts.Get("crm.quoteDetail.conflictRetry", result.Error) : result.Error, failed: true);
            return;
        }

        Notify(Texts.Get("contracts.detail.documentGenerated", result.Value!.FileName));
        await LoadAsync(contract.Id);
        tabs.Select(TabDocuments);
    }

