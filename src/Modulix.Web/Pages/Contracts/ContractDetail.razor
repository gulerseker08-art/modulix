    private async Task AfterChildAsync(bool success, string? error, IReadOnlyDictionary<string, string[]>? fieldErrors, string message)
    {
        if (!success)
        {
            childErrors = fieldErrors;
            childMessage = error;
            return;
        }

        CancelChild();
        Notify(message);
        await LoadAsync(contract!.Id);
    }

    private void Notify(string? text, bool failed = false)
    {
        notice = text;
        noticeFailed = failed;
    }

    private IEnumerable<(string Period, decimal? Net, decimal? Tax, decimal? Gross)> Recurring()
    {
        if (string.IsNullOrEmpty(contract?.RecurringSummary)) { yield break; }
        List<RecurringTotal>? totals;
        try
        {
            totals = System.Text.Json.JsonSerializer.Deserialize<List<RecurringTotal>>(contract.RecurringSummary, System.Text.Json.JsonSerializerOptions.Web);
        }
        catch (System.Text.Json.JsonException)
        {
            yield break;
        }

        foreach (var t in totals ?? [])
        {
            yield return (t.Period ?? "", t.Net, t.Tax, t.Gross);
        }
    }

    /// <summary>Gerekçe isteyen eylemde önce gerekçe formu açılır; diğerleri doğrudan çalışır.</summary>
    private Task StartActionAsync(ContractActionDto action)
    {
        actionErrors = null;
        if (action.RequiresReason || action.Action is "reopen-draft" or "withdraw-approval" or "approve")
        {
            reasonAction = action.Action;
            reasonText = string.Empty;
            return Task.CompletedTask;
        }

        return RunActionAsync(action.Action, null);
    }

    private Task ConfirmReasonAsync() => reasonAction is { } action ? RunActionAsync(action, Blank(reasonText)) : Task.CompletedTask;

    private async Task RunActionAsync(string action, string? reason)
    {
        if (contract is null || busy) { return; }
        if ((dirty || childDirty) && !await Js.InvokeAsync<bool>("confirm", Texts.Get("contracts.detail.actionUnsavedConfirm"))) { return; }
        busy = true;
        var result = await Api.PostAsync<ContractDto>($"/api/contracts/contracts/{contract.Id}/{action}", new ContractTransitionRequest(contract.Version, reason));
        busy = false;
        if (!result.IsSuccess)
        {
            actionErrors = result.FieldErrors;
            Notify(result.Status == System.Net.HttpStatusCode.Conflict ? Texts.Get("crm.quoteDetail.conflictRetry", result.Error) : result.Error, failed: true);
            if (result.Status == System.Net.HttpStatusCode.Conflict) { await LoadAsync(contract.Id); }
            return;
        }

        reasonAction = null;
        dirty = false;
        Notify(Texts.Get("crm.quoteApprovals.done", ContractActionLabels.Action(action)));
        await LoadAsync(contract.Id);
    }

    private async Task CompareAsync(int from, int to)
    {
        if (contract is null) { return; }
        var result = await Api.GetAsync<ContractCompareDto>($"/api/contracts/contracts/{contract.Id}/versions/{from}/compare?with={to}");
        compare = result.Value;
        compareFrom = from;
        compareTo = to;
        if (!result.IsSuccess) { Notify(result.Error, failed: true); }
    }

    private async Task PreviewDocumentAsync()
    {
        if (contract is null || !Guid.TryParse(documentTemplateId, out var templateId)) { return; }
        busy = true;
