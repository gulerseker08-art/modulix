    private async Task SaveAsync()
    {
        if (busy) { return; }
        busy = true;
        var request = new SaveContractRequest(
            form.Title, form.PartyId ?? Guid.Empty, form.Type, Blank(form.Description), form.PersonId, form.OwnerId, form.PreviousContractId,
            form.StartDate, form.IsIndefinite ? null : form.EndDate, form.IsIndefinite, form.Currency, form.PriceIncludesTax,
            Session.Can(ContractsAccess.FinancialsRead) ? form.ContractValue : null, Blank(form.PaymentTerms), form.RenewalMode,
            form.RenewalMode == "None" ? null : form.RenewalPeriodMonths, form.NoticePeriodDays, form.Confidentiality, form.HasNonStandardTerms, form.RiskLevel, contract?.Version,
            CustomFieldText.ForSave(CustomFields, form.Custom), form.EscalationUserId);
        var result = contract is { } current
            ? await Api.PutAsync<ContractDto>($"/api/contracts/contracts/{current.Id}", request)
            : await Api.PostAsync<ContractDto>("/api/contracts/contracts", request);
        busy = false;

        if (!result.IsSuccess)
        {
            errors = result.FieldErrors;
            Notify(result.Status == System.Net.HttpStatusCode.Conflict ? Texts.Get("crm.quoteDetail.conflictRetry", result.Error) : result.Error, failed: true);
            return;
        }

        errors = null;
        dirty = false;
        if (contract is null)
        {
            Navigation.NavigateTo($"sozlesmeler/{result.Value!.Id}");
            return;
        }

        Notify(Texts.Get("contracts.detail.saved"));
        await LoadAsync(contract.Id);
    }

    private async Task DeleteAsync()
    {
        if (contract is null || busy) { return; }
        if (!await Js.InvokeAsync<bool>("confirm", Texts.Get("contracts.detail.deleteConfirm"))) { return; }
        busy = true;
        var result = await Api.DeleteAsync($"/api/contracts/contracts/{contract.Id}?version={contract.Version}");
        busy = false;
        if (!result.IsSuccess)
        {
            Notify(result.Error, failed: true);
            return;
        }

        dirty = false;
        Navigation.NavigateTo("sozlesmeler");
    }

