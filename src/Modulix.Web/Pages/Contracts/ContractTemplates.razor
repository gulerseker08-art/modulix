@page "/sozlesmeler/sablonlar"
@inject ApiClient Api
@inject SessionState Session
@inject CrmLookups Lookups
@inject IJSRuntime Js

<PageTitle>@Texts.Get("nav.app.contracts.templates.menu") · Modulix</PageTitle>

<NavigationLock ConfirmExternalNavigation="@dirty" OnBeforeInternalNavigation="ConfirmLeaveAsync" />

<AuthGate Module="@ContractsAccess.ModuleKey" Permission="@ContractsAccess.ContractsRead">
    <div class="page-header">
        <div>
            <h1>@Texts.Get("nav.app.contracts.templates.menu")</h1>
            <p class="text-muted mb-0">@((MarkupString)Texts.Get("contracts.templates.intro", $"<code>{{{{{Texts.Get("contracts.templates.variableExample")}}}}}</code>"))</p>
        </div>
        <div class="header-actions">
            <a class="btn btn-outline-secondary" href="sozlesmeler">@Texts.Get("nav.app.contracts")</a>
            @if (CanEdit)
            {
                <button type="button" class="btn btn-outline-primary" @onclick="NewFromSampleAsync">@Texts.Get("contracts.templates.fromSample")</button>
                <button type="button" class="btn btn-primary" @onclick="NewTemplate">@Texts.Get("contracts.templates.new")</button>
            }
        </div>
    </div>

    <Notice Text="@notice" Failed="@noticeFailed" />

    <div class="filters" role="group" aria-label="@Texts.Get("contracts.templates.filters")">
        <label class="visually-hidden" for="t-status">@Texts.Get("common.field.status")</label>
        <select id="t-status" class="form-select form-select-sm filter-select" @bind="statusFilter" @bind:after="LoadAsync">
            <option value="">@Texts.Get("common.allStatuses")</option>
            @foreach (var s in TemplateLabels.Statuses) { <option value="@s.Key">@s.Label</option> }
        </select>
    </div>

    @if (templates is null)
    {
        <p class="text-muted" role="status">@Texts.Get("common.loading")</p>
    }
    else if (templates.Count == 0)
    {
        <p class="text-muted">@(CanEdit ? Texts.Get("contracts.templates.emptyCanEdit") : Texts.Get("contracts.templates.empty"))</p>
    }
    else
    {
        <table class="table record-table">
            <caption class="visually-hidden">@Texts.Get("nav.app.contracts.templates.menu")</caption>
            <thead><tr><th scope="col">@Texts.Get("contracts.templates.col.template")</th><th scope="col">@Texts.Get("contracts.templates.col.language")</th><th scope="col">@Texts.Get("common.field.kind")</th><th scope="col">@Texts.Get("common.field.status")</th><th scope="col">@Texts.Get("contracts.templates.col.published")</th><th scope="col"><span class="visually-hidden">@Texts.Get("crm.lead.actions")</span></th></tr></thead>
            <tbody>
                @foreach (var t in templates)
                {
                    <tr class="@(selected?.Id == t.Id ? "selected" : null)">
                        <td data-label="@Texts.Get("contracts.templates.col.template")" class="primary">
                            @t.Name
                            @if (t.IsExample) { <span class="badge stage-lost" title="@Texts.Get("contracts.templates.exampleHint")">@Texts.Get("contracts.templates.example")</span> }
                            @if (!string.IsNullOrWhiteSpace(t.UsageScope)) { <small class="text-muted">@t.UsageScope</small> }
                        </td>
                        <td data-label="@Texts.Get("contracts.templates.col.language")">@t.Language.ToUpperInvariant()</td>
                        <td data-label="@Texts.Get("common.field.kind")">@(t.ContractType is null ? Texts.Get("contracts.templates.anyType") : Lookups.Label(ContractsAccess.ContractTypeList, t.ContractType))</td>
                        <td data-label="@Texts.Get("common.field.status")"><span class="badge stage-@TemplateLabels.StatusBadge(t.Status)">@TemplateLabels.Label(TemplateLabels.Statuses, t.Status)</span></td>
                        <td data-label="@Texts.Get("contracts.templates.col.published")">@(t.PublishedVersionNo is { } n ? Texts.Get("contracts.versionNo", n) : "—")</td>
                        <td data-label="@Texts.Get("crm.lead.actions")"><button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => SelectAsync(t)">@(CanEdit ? Texts.Get("contracts.templates.openEdit") : Texts.Get("contracts.templates.view"))</button></td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (form is not null)
    {
        <section aria-labelledby="template-editor-title" class="template-editor">
            <h2 id="template-editor-title">@(selected is null ? Texts.Get("contracts.templates.new") : selected.Name)</h2>
            @if (selected is not null)
            {
                <p class="text-muted">
                    <span class="badge stage-@TemplateLabels.StatusBadge(selected.Status)">@TemplateLabels.Label(TemplateLabels.Statuses, selected.Status)</span>
                    @if (selected.PublishedVersionNo is { } pv) { <text> @Texts.Get("contracts.templates.publishedVersion", pv)</text> }
                    @if (HasUnpublishedChanges) { <strong> @Texts.Get("contracts.templates.unpublishedChanges")</strong> }
                </p>
            }
            @if (selected?.Status == "Archived")
            {
                <div class="alert alert-info" role="status">@Texts.Get("contracts.templates.archivedReadOnly")</div>
            }

            <form class="record-form" novalidate @onsubmit="SaveAsync" @onsubmit:preventDefault>
                <TabBar Tabs="FormTabs" State="tabs" Label="@Texts.Get("contracts.templates.formSections")" />
                <fieldset disabled="@(!CanEditSelected || busy)">
                    <legend class="visually-hidden">@Texts.Get("contracts.templates.info")</legend>
                    @if (errors is { Count: > 0 })
                    {
                        <div class="alert alert-danger" role="alert">
                            <strong>@Texts.Get("common.errorSummary")</strong>
                            <ul class="mb-0">@foreach (var (_, messages) in errors) { foreach (var text in messages) { <li>@text</li> } }</ul>
                        </div>
                    }
                    <TabPanel State="tabs" Key="form-genel">
                    <div class="form-grid" @oninput="() => dirty = true" @onchange="() => dirty = true">
                        <div class="span-6">
                            <label class="form-label required" for="t-name">@Texts.Get("common.field.name")</label>
                            <input id="t-name" class="form-control" maxlength="150" aria-required="true" @bind="form.Name" />
                            <FieldError Field="name" Errors="errors" />
                        </div>
                        <div class="span-3">
                            <label class="form-label" for="t-lang">@Texts.Get("contracts.templates.col.language")</label>
                            <select id="t-lang" class="form-select" @bind="form.Language">
                                <option value="tr">@Texts.Get("contracts.templates.language.tr")</option>
                                <option value="en">@Texts.Get("contracts.templates.language.en")</option>
                            </select>
                        </div>
                        <div class="span-3">
                            <label class="form-label" for="t-type">@Texts.Get("contracts.templates.contractType")</label>
                            <select id="t-type" class="form-select" @bind="form.ContractType">
                                <option value="">@Texts.Get("contracts.templates.anyType")</option>
                                @foreach (var t in Lookups.Choices(ContractsAccess.ContractTypeList, form.ContractType)) { <option value="@t.Key">@t.Label</option> }
                            </select>
                            <FieldError Field="contractType" Errors="errors" />
                        </div>
                        <div class="span-6">
                            <label class="form-label" for="t-scope">@Texts.Get("contracts.templates.usageScope")</label>
                            <input id="t-scope" class="form-control" maxlength="100" @bind="form.UsageScope" />
                        </div>
                        <div class="span-6">
                            <label class="form-label" for="t-desc">@Texts.Get("common.field.description")</label>
                            <input id="t-desc" class="form-control" maxlength="2000" @bind="form.Description" />
                        </div>
                        <div class="span-12 form-check">
                            <input id="t-example" type="checkbox" class="form-check-input" @bind="form.IsExample" />
                            <label class="form-check-label" for="t-example">@Texts.Get("contracts.templates.isExample")</label>
                        </div>
                    </div>
                    </TabPanel>
                    <TabPanel State="tabs" Key="form-metin">
                    <div class="form-grid" @oninput="() => dirty = true" @onchange="() => dirty = true">
                        <div class="span-12">
                            <label class="form-label required" for="t-body">@Texts.Get("contracts.templates.body")</label>
                            <textarea id="t-body" class="form-control template-body" maxlength="20000" aria-required="true" aria-describedby="t-body-help" @bind="form.Body" @bind:event="oninput"></textarea>
                            <small id="t-body-help" class="text-muted">
                                @((MarkupString)Texts.Get("contracts.templates.bodyHelp", "<code>#</code>", "<code>##</code>", "<code>{{kalem_tablosu}}</code>, <code>{{taraflar_listesi}}</code>, <code>{{imza_alani}}</code>, <code>{{sayfa_sonu}}</code>"))
                            </small>
                            <FieldError Field="body" Errors="errors" />
                        </div>
                    </div>
                <details class="variable-catalog">
                    <summary>@Texts.Get("contracts.templates.variables", variables.Count)</summary>
                    <table class="table record-table">
                        <caption class="visually-hidden">@Texts.Get("contracts.templates.variablesCaption")</caption>
                        <thead><tr><th scope="col">@Texts.Get("contracts.templates.col.variable")</th><th scope="col">@Texts.Get("contracts.templates.col.meaning")</th><th scope="col">@Texts.Get("contracts.templates.col.group")</th><th scope="col"><span class="visually-hidden">@Texts.Get("common.add")</span></th></tr></thead>
                        <tbody>
                            @foreach (var v in variables)
                            {
                                <tr>
                                    <td data-label="@Texts.Get("contracts.templates.col.variable")"><code>@("{{" + v.Key + "}}")</code></td>
                                    <td data-label="@Texts.Get("contracts.templates.col.meaning")">@v.Label @if (v.Financial) { <span class="badge stage-onhold" title="@Texts.Get("contracts.templates.financialHint")">@Texts.Get("contracts.templates.financial")</span> }</td>
                                    <td data-label="@Texts.Get("contracts.templates.col.group")">@v.Group</td>
                                    <td data-label="@Texts.Get("common.add")">
                                        @if (CanEditSelected)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => Insert(v)">@Texts.Get("contracts.templates.insert")</button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </details>
                    </TabPanel>
                </fieldset>

                <div class="form-actions">
                    @if (CanEditSelected)
                    {
                        <button type="submit" class="btn btn-primary" disabled="@busy">@(selected is null ? Texts.Get("contracts.templates.createDraft") : Texts.Get("common.save"))</button>
                    }
                    @if (selected is not null && CanPublish && selected.Status != "Archived")
                    {
                        <button type="button" class="btn btn-outline-primary" disabled="@(busy || dirty)" title="@(dirty ? Texts.Get("contracts.templates.saveFirst") : null)" @onclick='() => StartAsync("publish")'>@TemplateLabels.Action("publish")</button>
                        <button type="button" class="btn btn-outline-danger" disabled="@busy" @onclick='() => StartAsync("archive")'>@TemplateLabels.Action("archive")</button>
                    }
                    @if (selected is { Status: "Archived" } && CanPublish)
                    {
                        <button type="button" class="btn btn-outline-primary" disabled="@busy" @onclick='() => StartAsync("restore")'>@TemplateLabels.Action("restore")</button>
                    }
                    <button type="button" class="btn btn-outline-secondary" @onclick="Close">@Texts.Get("common.close")</button>
                    @if (dirty) { <span class="text-muted" role="status">@Texts.Get("crm.quoteDetail.unsaved")</span> }
                </div>
            </form>

            @if (action is not null)
            {
                <form class="record-form" novalidate @onsubmit="ConfirmActionAsync" @onsubmit:preventDefault>
                    <label class="form-label" for="t-reason">@(action == "publish" ? Texts.Get("contracts.templates.publishNote") : Texts.Get("contracts.templates.archiveReason"))</label>
                    @if (action != "restore")
                    {
                        <textarea id="t-reason" class="form-control" rows="2" maxlength="500" @bind="reasonText"></textarea>
                    }
                    <FieldError Field="reason" Errors="errors" />
                    <div class="form-actions">
                        <button type="submit" class="btn btn-primary" disabled="@busy">@TemplateLabels.Action(action)</button>
                        <button type="button" class="btn btn-outline-secondary" @onclick="() => action = null">@Texts.Get("common.dismiss")</button>
                    </div>
                </form>
            }

            @if (selected is not null)
            {
                <section aria-labelledby="preview-title">
                    <h3 id="preview-title">@Texts.Get("contracts.templates.preview")</h3>
                    <p class="text-muted">@Texts.Get("contracts.templates.previewHelp")</p>
                    <div class="form-grid">
                        <div class="span-6">
                            <label class="form-label" for="previewContract">@Texts.Get("contracts.list.col.contract")</label>
                            <LookupPicker Id="previewContract" LookupKey="contracts.contract.previous" @bind-Value="previewContractId" Placeholder="@Texts.Get("contracts.templates.pickContract")" />
                        </div>
                        <div class="span-6 align-self-end">
                            <button type="button" class="btn btn-outline-secondary" disabled="@(previewContractId is null || busy)" @onclick="PreviewAsync">@Texts.Get("contracts.templates.previewButton")</button>
                        </div>
                    </div>
                    <RenderedDocumentView Preview="preview" />
                </section>

                <section aria-labelledby="versions-title">
                    <h3 id="versions-title">@Texts.Get("contracts.templates.versions")</h3>
                    @if (versions.Count == 0)
                    {
                        <p class="text-muted">@Texts.Get("contracts.templates.noVersions")</p>
                    }
                    else
                    {
                        <table class="table record-table">
                            <caption class="visually-hidden">@Texts.Get("contracts.templates.versionsCaption")</caption>
                            <thead><tr><th scope="col">@Texts.Get("contracts.templates.col.version")</th><th scope="col">@Texts.Get("contracts.templates.col.publishedAt")</th><th scope="col">@Texts.Get("contracts.templates.col.hash")</th><th scope="col">@Texts.Get("contracts.field.notes")</th></tr></thead>
                            <tbody>
                                @foreach (var v in versions)
                                {
                                    <tr>
                                        <td data-label="@Texts.Get("contracts.templates.col.version")">@(v.IsExample ? Texts.Get("contracts.templates.versionExample", v.VersionNo) : Texts.Get("contracts.versionNo", v.VersionNo))</td>
                                        <td data-label="@Texts.Get("contracts.templates.col.publishedAt")">@CrmLabels.Time(v.PublishedAt) · @Lookups.MemberName(v.PublishedBy)</td>
                                        <td data-label="@Texts.Get("contracts.templates.col.hashShort")"><code title="@v.Sha256">@v.Sha256[..12]…</code></td>
                                        <td data-label="@Texts.Get("contracts.field.notes")">@v.Notes</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </section>
            }
        </section>
    }
</AuthGate>

@code {
    private PagedResult<ContractTemplateDto>? page;
    private IReadOnlyList<ContractTemplateDto>? templates => page?.Items;
    private ContractTemplateDto? selected;
    private TemplateForm? form;
    private List<ContractTemplateVersionDto> versions = [];
    private IReadOnlyList<TemplateVariableDto> variables = [];
    private ContractPreviewDto? preview;
    private Guid? previewContractId;
    private IReadOnlyDictionary<string, string[]>? errors;

    // Her kayıt formu sekmelidir; hatalı alan içeren sekme "!" rozeti taşır, kayıt denemesinden sonra hatalı ilk sekme açılır.
    private readonly TabState tabs = new("form-genel");

    private int ErrorCount(params string[] fields) => errors is null ? 0 : fields.Count(errors.ContainsKey);

    private IReadOnlyList<TabItem> FormTabs =>
    [
        new("form-genel", Texts.Get("contracts.templates.tab.general"), Errors: ErrorCount("name", "contractType")),
        new("form-metin", Texts.Get("contracts.templates.body"), Errors: ErrorCount("body")),
    ];
    private string? notice;
    private bool noticeFailed;
    private string? statusFilter;
    private string? action;
    private string reasonText = string.Empty;
    private bool busy;
    private bool dirty;

    private bool CanEdit => Session.Can(ContractsAccess.TemplatesEdit);

    private bool CanPublish => Session.Can(ContractsAccess.TemplatesPublish);

    private bool CanEditSelected => CanEdit && selected?.Status != "Archived";

    private bool HasUnpublishedChanges =>
        selected is { PublishedVersionNo: not null } && versions.FirstOrDefault() is { } latest && latest.Sha256 != selected.BodySha256;

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (!Session.Can(ContractsAccess.ContractsRead)) { return; }
        await Lookups.LoadAsync();
        variables = (await Api.GetAsync<List<TemplateVariableDto>>("/api/contracts/templates/variables")).Value ?? [];
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var url = "/api/contracts/templates?pageSize=100";
        if (!string.IsNullOrEmpty(statusFilter)) { url += $"&status={statusFilter}"; }
        var result = await Api.GetAsync<PagedResult<ContractTemplateDto>>(url);
        page = result.Value;
        if (!result.IsSuccess) { Notify(result.Error, true); }
    }

    private async Task ConfirmLeaveAsync(LocationChangingContext context)
    {
        if (dirty && !await Js.InvokeAsync<bool>("confirm", Texts.Get("crm.quoteDetail.leaveConfirm")))
        {
            context.PreventNavigation();
        }
    }

    private void NewTemplate()
    {
        selected = null;
        form = new TemplateForm { Language = "tr" };
        versions = [];
        preview = null;
        tabs.Select("form-genel");
        errors = null;
        action = null;
        dirty = false;
    }

    private async Task NewFromSampleAsync()
    {
        var sample = await Api.GetAsync<TemplateSampleDto>("/api/contracts/templates/sample");
        if (!sample.IsSuccess) { Notify(sample.Error, true); return; }
        NewTemplate();
        form = new TemplateForm { Name = sample.Value!.Name, Body = sample.Value.Body, IsExample = true, Language = "tr" };
        dirty = true;
        Notify(sample.Value.Notice);
    }

    private async Task SelectAsync(ContractTemplateDto template)
    {
        if (dirty && !await Js.InvokeAsync<bool>("confirm", Texts.Get("contracts.templates.switchConfirm"))) { return; }
        await OpenAsync(template);
    }

    private async Task OpenAsync(ContractTemplateDto template)
    {
        selected = template;
        form = TemplateForm.From(template);
        preview = null;
        tabs.Select("form-genel");
        errors = null;
        action = null;
        dirty = false;
        versions = (await Api.GetAsync<List<ContractTemplateVersionDto>>($"/api/contracts/templates/{template.Id}/versions")).Value ?? [];
    }

    private void Close()
    {
        selected = null;
        form = null;
        preview = null;
        dirty = false;
    }

    private void Insert(TemplateVariableDto variable)
    {
        if (form is null) { return; }
        var token = "{{" + variable.Key + "}}";
        // Blok değişkenleri satırda tek başına durmalıdır.
        form.Body = variable.IsBlock ? $"{form.Body.TrimEnd()}\n\n{token}\n" : $"{form.Body}{token}";
        dirty = true;
    }

    private async Task SaveAsync()
    {
        if (form is null || busy) { return; }
        busy = true;
        var request = new SaveContractTemplateRequest(form.Name, form.Body, form.Language, string.IsNullOrEmpty(form.ContractType) ? null : form.ContractType,
            Blank(form.UsageScope), Blank(form.Description), form.IsExample, selected?.Version);
        var result = selected is { } current
            ? await Api.PutAsync<ContractTemplateDto>($"/api/contracts/templates/{current.Id}", request)
            : await Api.PostAsync<ContractTemplateDto>("/api/contracts/templates", request);
        busy = false;
        if (!result.IsSuccess)
        {
            errors = result.FieldErrors;
            tabs.RevealFirstFailing(FormTabs);
            Notify(result.Status == System.Net.HttpStatusCode.Conflict ? Texts.Get("contracts.templates.conflictRetry", result.Error) : result.Error, true);
            return;
        }

        errors = null;
        dirty = false;
        Notify(Texts.Get("contracts.templates.saved"));
        await LoadAsync();
        await OpenAsync(result.Value!);
    }

    private Task StartAsync(string kind)
    {
        action = kind;
        reasonText = string.Empty;
        errors = null;
        return kind == "restore" ? ConfirmActionAsync() : Task.CompletedTask;
    }

    private async Task ConfirmActionAsync()
    {
        if (selected is null || action is null || busy) { return; }
        busy = true;
        var result = await Api.PostAsync<ContractTemplateDto>($"/api/contracts/templates/{selected.Id}/{action}", new TemplateActionRequest(selected.Version, Blank(reasonText)));
        busy = false;
        if (!result.IsSuccess)
        {
            errors = result.FieldErrors;
            Notify(result.Error, true);
            return;
        }

        var label = TemplateLabels.Action(action);
        action = null;
        Notify(Texts.Get("crm.quoteApprovals.done", label));
        await LoadAsync();
        await OpenAsync(result.Value!);
    }

    private async Task PreviewAsync()
    {
        if (selected is null || previewContractId is not { } contractId) { return; }
        busy = true;
        var result = await Api.PostAsync<ContractPreviewDto>($"/api/contracts/contracts/{contractId}/documents/preview", new PreviewContractDocumentRequest(selected.Id, UseDraft: CanEdit));
        busy = false;
        preview = result.Value;
        if (!result.IsSuccess) { Notify(result.Error, true); }
    }

    private void Notify(string? text, bool failed = false)
    {
        notice = text;
        noticeFailed = failed;
    }

    private static string? Blank(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private sealed class TemplateForm
    {
        public string Name { get; set; } = string.Empty;
        public string Body { get; set; } = string.Empty;
        public string Language { get; set; } = "tr";
        public string? ContractType { get; set; }
        public string? UsageScope { get; set; }
        public string? Description { get; set; }
        public bool IsExample { get; set; }

        public static TemplateForm From(ContractTemplateDto t) => new()
        {
            Name = t.Name, Body = t.Body, Language = t.Language, ContractType = t.ContractType, UsageScope = t.UsageScope, Description = t.Description, IsExample = t.IsExample,
        };
    }
}
