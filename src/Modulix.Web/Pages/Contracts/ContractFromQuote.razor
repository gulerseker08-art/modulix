@page "/sozlesmeler/tekliften/{QuoteId:guid}"
@inject ApiClient Api
@inject SessionState Session
@inject CrmLookups Lookups
@inject NavigationManager Navigation

<PageTitle>@Texts.Get("contracts.fromQuote.pageTitle") · Modulix</PageTitle>

<AuthGate Module="@ContractsAccess.ModuleKey" Permission="@ContractsAccess.ContractsWrite">
    <div class="page-header">
        <div>
            <h1>@Texts.Get("contracts.fromQuote.title")</h1>
            <p class="text-muted mb-0">@Texts.Get("contracts.fromQuote.intro")</p>
        </div>
        <div class="header-actions">
            <a class="btn btn-outline-secondary" href="crm/teklifler/@QuoteId">@Texts.Get("contracts.fromQuote.backToQuote")</a>
        </div>
    </div>

    @if (!Session.Can(ContractsAccess.FinancialsRead))
    {
        <div class="alert alert-warning" role="alert">@((MarkupString)Texts.Get("contracts.fromQuote.needsFinancials", $"<code>{ContractsAccess.FinancialsRead}</code>"))</div>
    }
    else if (notFound)
    {
        <div class="alert alert-warning" role="alert">@Texts.Get("contracts.fromQuote.notFound") <a href="crm/teklifler">@Texts.Get("contracts.fromQuote.backToQuotes")</a></div>
    }
    else if (preview is null)
    {
        <LoadingState />
    }
    else
    {
        <Notice Text="@message" Failed="true" />
        @if (!preview.CustomerLinked)
        {
            <div class="alert alert-danger" role="alert">@Texts.Get("contracts.fromQuote.customerNotLinked")</div>
        }

        <section aria-labelledby="quote-summary-title">
            <h2 id="quote-summary-title">@Texts.Get("contracts.fromQuote.source")</h2>
            <p>
                <strong>@preview.Title</strong> · @preview.QuoteNumber · @Texts.Get("contracts.fromQuote.revision", preview.RevisionNo)<br />
                @Texts.Get("contracts.fromQuote.acceptedBy", preview.AcceptedBy ?? "—") · @CrmLabels.Time(preview.AcceptedAt) ·
                @Texts.Get("contracts.fromQuote.totals", CrmLabels.Amount(preview.NetTotal, preview.Currency), CrmLabels.Amount(preview.GrossTotal, preview.Currency))
                @if (preview.DocumentSha256 is { Length: > 12 } sha) { <small class="text-muted"> · @Texts.Get("contracts.fromQuote.documentHash") <code title="@sha">@sha[..12]…</code></small> }
            </p>
        </section>

        <form class="record-form" novalidate @onsubmit="CreateAsync" @onsubmit:preventDefault>
            <TabBar Tabs="FormTabs" State="tabs" Label="@Texts.Get("contracts.fromQuote.formSections")" />
            <fieldset disabled="@(busy || !preview.CustomerLinked)">
                <legend class="visually-hidden">@Texts.Get("contracts.fromQuote.legend")</legend>
                <TabPanel State="tabs" Key="form-kapsam">
                <p class="text-muted">@Texts.Get("contracts.fromQuote.scopeHelp")</p>
                <table class="table record-table">
                    <caption class="visually-hidden">@Texts.Get("contracts.fromQuote.linesCaption")</caption>
                    <thead><tr><th scope="col"><span class="visually-hidden">@Texts.Get("crm.act.select")</span></th><th scope="col">@Texts.Get("contracts.fromQuote.col.line")</th><th scope="col" class="text-end">@Texts.Get("contracts.field.quantity")</th><th scope="col" class="text-end">@Texts.Get("contracts.field.net")</th><th scope="col">@Texts.Get("contracts.field.billingperiod")</th><th scope="col">@Texts.Get("common.field.status")</th></tr></thead>
                    <tbody>
                        @foreach (var line in preview.Lines)
                        {
                            <tr>
                                <td data-label="@Texts.Get("crm.act.select")"><input type="checkbox" class="form-check-input" id="line-@line.StableKey" aria-label="@Texts.Get("contracts.fromQuote.selectLine", line.Name)" disabled="@line.Taken" checked="@selected.Contains(line.StableKey)" @onchange="e => Toggle(line.StableKey, (bool)e.Value!)" /></td>
                                <td data-label="@Texts.Get("contracts.fromQuote.col.line")" class="primary"><label for="line-@line.StableKey">@line.Name</label></td>
                                <td data-label="@Texts.Get("contracts.field.quantity")" class="text-end">@line.Quantity.ToString("G29", Regional.Numbers) @line.Unit</td>
                                <td data-label="@Texts.Get("contracts.field.net")" class="text-end">@CrmLabels.Amount(line.Net, preview.Currency)</td>
                                <td data-label="@Texts.Get("contracts.field.billingperiod")">@ContractLabels.Label(ContractLabels.Periods, line.RecurringPeriod ?? "")</td>
                                <td data-label="@Texts.Get("common.field.status")">
                                    @if (line.Taken)
                                    {
                                        @if (line.ContractId is { } cid) { <span>@Texts.Get("contracts.fromQuote.inContract") <a href="sozlesmeler/@cid">@line.ContractNumber</a></span> }
                                        else { <span>@Texts.Get("contracts.fromQuote.inOtherContract")</span> }
                                    }
                                    else { <span class="text-muted">@Texts.Get("contracts.fromQuote.available")</span> }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <FieldError Field="lineKeys" Errors="errors" />
                </TabPanel>
                <TabPanel State="tabs" Key="form-sure">
                <div class="form-grid">
                    <div class="span-4">
                        <label class="form-label" for="f-type">@Texts.Get("common.field.kind")</label>
                        <select id="f-type" class="form-select" @bind="type">
                            @foreach (var t in Lookups.Choices(ContractsAccess.ContractTypeList)) { <option value="@t.Key">@t.Label</option> }
                        </select>
                    </div>
                    <div class="span-4">
                        <label class="form-label" for="f-start">@Texts.Get("contracts.fromQuote.startDate")</label>
                        <input id="f-start" type="date" class="form-control" @bind="startDate" />
                        <FieldError Field="startDate" Errors="errors" />
                    </div>
                    <div class="span-4">
                        <label class="form-label" for="f-term">@Texts.Get("contracts.fromQuote.term")</label>
                        <input id="f-term" type="number" min="1" max="120" class="form-control" @bind="termMonths" />
                        <small class="text-muted">@Texts.Get("contracts.fromQuote.termHelp")@(EndPreview)</small>
                        <FieldError Field="termMonths" Errors="errors" />
                    </div>
                    <div class="span-4">
                        <label class="form-label" for="f-renewal">@Texts.Get("contracts.field.renewalmode")</label>
                        <select id="f-renewal" class="form-select" @bind="renewalMode">
                            @foreach (var m in ContractLabels.RenewalModes) { <option value="@m.Key">@m.Label</option> }
                        </select>
                        <FieldError Field="renewalMode" Errors="errors" />
                    </div>
                    <div class="span-4">
                        <label class="form-label" for="f-renewal-months">@Texts.Get("contracts.field.renewalperiodmonths")</label>
                        <input id="f-renewal-months" type="number" min="1" max="120" class="form-control" @bind="renewalPeriodMonths" disabled="@(renewalMode == "None")" />
                        <FieldError Field="renewalPeriodMonths" Errors="errors" />
                    </div>
                    <div class="span-4">
                        <label class="form-label" for="f-notice">@Texts.Get("contracts.field.noticeperioddays")</label>
                        <input id="f-notice" type="number" min="0" max="3650" class="form-control" @bind="noticePeriodDays" />
                        <FieldError Field="noticePeriodDays" Errors="errors" />
                    </div>
                </div>
                </TabPanel>
            </fieldset>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary" disabled="@(busy || !preview.CustomerLinked || selected.Count == 0)">@Texts.Get("contracts.fromQuote.create")</button>
            </div>
        </form>
    }
</AuthGate>

@code {
    [Parameter] public Guid QuoteId { get; set; }

    private QuoteSourceDto? preview;
    private readonly HashSet<Guid> selected = [];
    private IReadOnlyDictionary<string, string[]>? errors;

    // Her kayıt formu sekmelidir; hatalı alan içeren sekme "!" rozeti taşır, kayıt denemesinden sonra hatalı ilk sekme açılır.
    private readonly TabState tabs = new("form-kapsam");

    private int ErrorCount(params string[] fields) => errors is null ? 0 : fields.Count(errors.ContainsKey);

    private IReadOnlyList<TabItem> FormTabs =>
    [
        new("form-kapsam", Texts.Get("contracts.fromQuote.tab.scope"), Errors: ErrorCount("lineKeys")),
        new("form-sure", Texts.Get("contracts.fromQuote.tab.term"), Errors: ErrorCount("type", "startDate", "termMonths", "renewalMode", "renewalPeriodMonths", "noticePeriodDays")),
    ];
    private string? message;
    private bool notFound;
    private bool busy;
    private string type = string.Empty;
    private DateOnly? startDate;
    private int? termMonths = 12;
    private string renewalMode = "None";
    private int? renewalPeriodMonths;
    private int? noticePeriodDays;

    /// <summary>Hesaplanan bitiş önizlemesi (yalnızca bilgi; kaydı sunucu hesaplar).</summary>
    private string EndPreview => startDate is { } start && termMonths is >= 1 and <= 120 ? " " + Texts.Get("contracts.fromQuote.endPreview", ContractLabels.Date(AddTerm(start, termMonths.Value))) : string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        await Session.EnsureLoadedAsync();
        if (!Session.Can(ContractsAccess.ContractsWrite) || !Session.Can(ContractsAccess.FinancialsRead))
        {
            return;
        }

        await Lookups.LoadAsync();
        type = Lookups.DefaultOf(ContractsAccess.ContractTypeList) ?? "Service";
        var result = await Api.GetAsync<QuoteSourceDto>($"/api/contracts/from-quote/{QuoteId}");
        if (!result.IsSuccess)
        {
            notFound = true;
            return;
        }

        preview = result.Value;
        selected.Clear();
        foreach (var line in preview!.Lines.Where(l => !l.Taken)) { selected.Add(line.StableKey); }
    }

    private void Toggle(Guid key, bool on)
    {
        if (on) { selected.Add(key); } else { selected.Remove(key); }
    }

    private async Task CreateAsync()
    {
        if (busy || preview is null) { return; }
        busy = true;
        message = null;
        var request = new CreateContractFromQuoteRequest(type, startDate, startDate is null ? null : termMonths, renewalMode, renewalMode == "None" ? null : renewalPeriodMonths,
            noticePeriodDays, [.. selected]);
        var result = await Api.PostAsync<ContractDto>($"/api/contracts/from-quote/{QuoteId}", request);
        busy = false;
        if (!result.IsSuccess)
        {
            errors = result.FieldErrors;
            tabs.RevealFirstFailing(FormTabs);
            message = result.Error;
            return;
        }

        Navigation.NavigateTo($"sozlesmeler/{result.Value!.Id}");
    }

    /// <summary>Takvim ayı toplamı (sunucudaki ContractPeriod ile aynı kural): gün taşarsa bir sonraki ayın ilk günü, bitiş bir gün önce.</summary>
    private static DateOnly AddTerm(DateOnly start, int months)
    {
        var first = new DateOnly(start.Year, start.Month, 1).AddMonths(months);
        var target = start.Day <= DateTime.DaysInMonth(first.Year, first.Month) ? new DateOnly(first.Year, first.Month, start.Day) : first.AddMonths(1);
        return target.AddDays(-1);
    }
}
