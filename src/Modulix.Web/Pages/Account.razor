@page "/hesabim"
@inject ApiClient Api
@inject SessionState Session

<PageTitle>@Texts.Get("account.title") · Modulix</PageTitle>

@* Kişinin kendi hesabı (Y7a). Bilgiler kişiye aittir: değişiklik üye olduğu bütün kuruluşlarda geçerlidir. *@
<AuthGate AllowWithoutTwoFactor="true" AllowWithoutTenant="true">
    <h1>@Texts.Get("account.title")</h1>
    <p class="text-muted">@Texts.Get("account.intro")</p>

    @if (Session.TwoFactorRequired)
    {
        <div class="alert alert-warning" role="alert">
            <strong>@Session.ActiveTenantName</strong> @Texts.Get("account.twoFactorRequired.text")
            <a href="hesabim#iki-adim">@Texts.Get("account.twoFactorRequired.link")</a>.
        </div>
    }
    else if (RecoveryCodeUsed)
    {
        <div class="alert alert-warning" role="status">
            @Texts.Get("account.recoveryUsed")
        </div>
    }

    @if (loadError is not null)
    {
        <div class="alert alert-danger" role="alert">@loadError</div>
    }
    else if (profile is null)
    {
        <LoadingState />
    }
    else
    {
        <form class="record-form settings-group" novalidate @onsubmit="SaveNameAsync" @onsubmit:preventDefault>
            <h2>@Texts.Get("account.profile.title")</h2>
            <Notice Text="@nameNotice" Failed="nameFailed" />
            <div class="mb-3">
                <label class="form-label" for="displayName">@Texts.Get("account.profile.name")</label>
                <input id="displayName" class="form-control" maxlength="200" autocomplete="name" @bind="displayName" @bind:event="oninput" />
                <FieldError Field="displayName" Errors="nameErrors" />
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary" disabled="@(busy || displayName.Trim() == profile.DisplayName)">@Texts.Get("common.save")</button>
            </div>
        </form>

        <form class="record-form settings-group" novalidate @onsubmit="SaveLanguageAsync" @onsubmit:preventDefault>
            <h2>@Texts.Get("account.language.title")</h2>
            <Notice Text="@languageNotice" Failed="languageFailed" />
            <div class="mb-3">
                <label class="form-label" for="language">@Texts.Get("account.language.label")</label>
                <select id="language" class="form-select" @bind="language">
                    <option value="">@Texts.Get("account.language.tenantDefault")</option>
                    @foreach (var option in LanguageCodes.All)
                    {
                        <option value="@option.Code">@option.Name</option>
                    }
                </select>
                <FieldError Field="language" Errors="languageErrors" />
                <div class="form-text">@Texts.Get("account.language.help")</div>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary" disabled="@(busy || language == (profile.PreferredLanguage ?? string.Empty))">@Texts.Get("common.save")</button>
            </div>
        </form>

        <form class="record-form settings-group" novalidate @onsubmit="ChangeEmailAsync" @onsubmit:preventDefault>
            <h2>@Texts.Get("account.email.title")</h2>
            <Notice Text="@emailNotice" Failed="emailFailed" />
            <p>@Texts.Strong("account.email.current", profile.Email)</p>
            <div class="form-grid">
                <div class="mb-3">
                    <label class="form-label" for="newEmail">@Texts.Get("account.email.new")</label>
                    <input id="newEmail" class="form-control" type="email" autocomplete="email" @bind="newEmail" @bind:event="oninput" />
                    <FieldError Field="email" Errors="emailErrors" />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="emailPassword">@Texts.Get("account.currentPassword")</label>
                    <input id="emailPassword" class="form-control" type="password" autocomplete="current-password" @bind="emailPassword" />
                    <FieldError Field="currentPassword" Errors="emailErrors" />
                </div>
            </div>
            <div class="form-text mb-3">@Texts.Get("account.email.help")</div>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary" disabled="@(busy || string.IsNullOrWhiteSpace(newEmail))">@Texts.Get("account.email.send")</button>
            </div>
        </form>

        <section class="record-form settings-group">
            <h2>@Texts.Get("account.password.title")</h2>
            <Notice Text="@passwordNotice" Failed="passwordFailed" />
            <div class="mb-3">
                <label class="form-label" for="currentPassword">@Texts.Get("account.currentPassword")</label>
                <input id="currentPassword" class="form-control" type="password" autocomplete="current-password" @bind="currentPassword" />
                <FieldError Field="currentPassword" Errors="passwordErrors" />
            </div>
            <PasswordForm @key="passwordFormKey" Email="@profile.Email" Errors="passwordErrors" Busy="busy" Submit="ChangePasswordAsync" ButtonText="@Texts.Get("account.password.submit")" />
            <div class="form-text">@Texts.Get("account.password.help")</div>
        </section>

        <TwoFactorSection />

        <section class="record-form settings-group">
            <h2>@Texts.Get("account.sessions.title")</h2>
            <Notice Text="@sessionNotice" Failed="sessionFailed" />
            @if (sessions is null)
            {
                <LoadingState />
            }
            else
            {
                <ul class="session-list">
                    @foreach (var session in sessions)
                    {
                        <li class="session-item">
                            <div>
                                <strong>@session.Device</strong>
                                @if (session.IsCurrent)
                                {
                                    <span class="badge user-active ms-1">@Texts.Get("account.sessions.current")</span>
                                }
                                <div class="text-muted small">
                                    @Texts.Get("account.sessions.meta", session.IpAddress ?? Texts.Get("account.sessions.unknownIp"), CrmLabels.Time(session.LastSeenAt), CrmLabels.Time(session.CreatedAt))
                                </div>
                            </div>
                            @if (!session.IsCurrent)
                            {
                                <button type="button" class="btn btn-outline-danger btn-sm" disabled="@busy" @onclick="() => CloseAsync(session)">@Texts.Get("account.sessions.close")</button>
                            }
                        </li>
                    }
                </ul>
                @if (sessions.Count > 1)
                {
                    <div class="form-actions">
                        <button type="button" class="btn btn-outline-danger" disabled="@busy" @onclick="CloseOthersAsync">@Texts.Get("account.sessions.closeOthers")</button>
                    </div>
                }
            }
        </section>
    }
</AuthGate>

@code {
    [SupplyParameterFromQuery(Name = "kurtarma")] public int? RecoveryCode { get; set; }

    private bool RecoveryCodeUsed => RecoveryCode == 1;

    private AccountProfileResponse? profile;
    private List<SessionDto>? sessions;
    private string? loadError;
    private bool busy;

    private string displayName = string.Empty;
    private string? nameNotice;
    private bool nameFailed;
    private IReadOnlyDictionary<string, string[]>? nameErrors;

    private string language = string.Empty;
    private string? languageNotice;
    private bool languageFailed;
    private IReadOnlyDictionary<string, string[]>? languageErrors;

    private string newEmail = string.Empty;
    private string emailPassword = string.Empty;
    private string? emailNotice;
    private bool emailFailed;
    private IReadOnlyDictionary<string, string[]>? emailErrors;

    private string currentPassword = string.Empty;
    private int passwordFormKey;
    private string? passwordNotice;
    private bool passwordFailed;
    private IReadOnlyDictionary<string, string[]>? passwordErrors;

    private string? sessionNotice;
    private bool sessionFailed;

    protected override async Task OnInitializedAsync()
    {
        var result = await Api.GetAsync<AccountProfileResponse>("/api/account");
        loadError = result.Error;
        if (result.Value is { } loaded)
        {
            profile = loaded;
            displayName = loaded.DisplayName;
            language = loaded.PreferredLanguage ?? string.Empty;
            await LoadSessionsAsync();
        }
    }

    private async Task LoadSessionsAsync() =>
        sessions = (await Api.GetAsync<List<SessionDto>>("/api/account/sessions")).Value ?? [];

    private async Task SaveNameAsync()
    {
        busy = true;
        var result = await Api.PutAsync<AccountProfileResponse>("/api/account/profile", new UpdateProfileRequest(displayName));
        busy = false;
        nameErrors = result.FieldErrors;
        if (result.Value is { } saved)
        {
            profile = saved;
            displayName = saved.DisplayName;
            (nameNotice, nameFailed) = (Texts.Get("common.saved"), false);

            // Üst çubuktaki ad yenilenir.
            await Session.RefreshAsync();
        }
        else
        {
            (nameNotice, nameFailed) = (result.FieldErrors.Count > 0 ? null : result.Error, true);
        }
    }

    private async Task SaveLanguageAsync()
    {
        busy = true;
        var result = await Api.PutAsync<AccountProfileResponse>("/api/account/language", new UpdateLanguageRequest(language.Length == 0 ? null : language));
        busy = false;
        languageErrors = result.FieldErrors;
        if (result.Value is { } saved)
        {
            profile = saved;
            language = saved.PreferredLanguage ?? string.Empty;

            // Etkin dil ve metinler oturumdan yeniden yüklenir; bildirim yeni dilde gösterilir.
            await Session.RefreshAsync();
            (languageNotice, languageFailed) = (Texts.Get("common.saved"), false);
        }
        else
        {
            (languageNotice, languageFailed) = (result.FieldErrors.Count > 0 ? null : result.Error, true);
        }
    }

    private async Task ChangeEmailAsync()
    {
        busy = true;
        var email = newEmail.Trim();
        var result = await Api.PostAsync<bool>("/api/account/email", new ChangeEmailRequest(email, emailPassword));
        busy = false;
        emailErrors = result.FieldErrors;
        if (result.IsSuccess)
        {
            (emailNotice, emailFailed) = (Texts.Get("account.email.sent", email), false);
            (newEmail, emailPassword) = (string.Empty, string.Empty);
        }
        else
        {
            (emailNotice, emailFailed) = (result.FieldErrors.Count > 0 ? null : result.Error, true);
        }
    }

    private async Task ChangePasswordAsync(string password)
    {
        busy = true;
        var result = await Api.PostAsync<bool>("/api/account/password", new ChangePasswordRequest(currentPassword, password));
        busy = false;
        passwordErrors = result.FieldErrors;
        if (result.IsSuccess)
        {
            (passwordNotice, passwordFailed) = (Texts.Get("account.password.changed"), false);
            currentPassword = string.Empty;
            passwordFormKey++;
            await LoadSessionsAsync();
        }
        else
        {
            (passwordNotice, passwordFailed) = (result.FieldErrors.Count > 0 ? null : result.Error, true);
        }
    }

    private async Task CloseAsync(SessionDto session)
    {
        busy = true;
        var result = await Api.DeleteAsync($"/api/account/sessions/{session.Id}");
        busy = false;
        (sessionNotice, sessionFailed) = result.IsSuccess ? (Texts.Get("account.sessions.closed", session.Device), false) : (result.Error, true);
        await LoadSessionsAsync();
    }

    private async Task CloseOthersAsync()
    {
        busy = true;
        var result = await Api.PostAsync<CloseSessionsResponse>("/api/account/sessions/close-others", new { });
        busy = false;
        (sessionNotice, sessionFailed) = result.Value is { } closed
            ? (Texts.Get("account.sessions.closedCount", closed.Closed), false)
            : (result.Error, true);
        await LoadSessionsAsync();
    }
}
