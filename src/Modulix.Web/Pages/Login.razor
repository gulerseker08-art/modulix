@page "/giris"
@inject SessionState Session
@inject NavigationManager Navigation

<PageTitle>@Texts.Get("auth.login.title") · Modulix</PageTitle>

<div class="narrow">
    <h1>@Texts.Get("auth.login.title")</h1>

    @if (error is not null)
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }

    @if (Session.TwoFactorPending)
    {
        @* İkinci adım (Y7b): doğrulama uygulamasındaki kod veya bir kurtarma kodu. *@
        <form @onsubmit="VerifyAsync" @onsubmit:preventDefault>
            <p>@Texts.Get("auth.login.twoFactor.help")</p>
            <div class="mb-3">
                <label class="form-label" for="code">@Texts.Get("auth.login.twoFactor.code")</label>
                <input id="code" class="form-control" autocomplete="one-time-code" inputmode="text" maxlength="20" required
                       @bind="code" @bind:event="oninput" />
            </div>
            <button type="submit" class="btn btn-primary w-100" disabled="@(busy || string.IsNullOrWhiteSpace(code))">@Texts.Get("auth.login.twoFactor.submit")</button>
        </form>
    }
    else
    {
        <form @onsubmit="LoginAsync" @onsubmit:preventDefault>
            <div class="mb-3">
                <label class="form-label" for="email">@Texts.Get("common.email")</label>
                <input id="email" class="form-control" type="email" autocomplete="username" required @bind="email" />
            </div>
            <div class="mb-3">
                <label class="form-label" for="password">@Texts.Get("common.password")</label>
                <input id="password" class="form-control" type="password" autocomplete="current-password" required @bind="password" />
            </div>
            <button type="submit" class="btn btn-primary w-100" disabled="@busy">@Texts.Get("auth.login.submit")</button>
        </form>
        <p class="mt-3"><a href="sifremi-unuttum">@Texts.Get("auth.login.forgot")</a></p>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "donus")] public string? ReturnUrl { get; set; }

    private string email = string.Empty;
    private string password = string.Empty;
    private string code = string.Empty;
    private string? error;
    private bool busy;

    private async Task LoginAsync()
    {
        busy = true;
        error = await Session.LoginAsync(email, password);
        busy = false;

        if (error is null && !Session.TwoFactorPending)
        {
            Continue(usedRecoveryCode: false);
        }
    }

    private async Task VerifyAsync()
    {
        busy = true;
        var entered = code.Trim();
        error = await Session.CompleteTwoFactorAsync(entered);
        busy = false;
        code = string.Empty;

        if (error is null)
        {
            // 6 haneli kod uygulamanındır; diğerleri kurtarma kodudur. Kişi kalan kodlarını Hesabım'da görür.
            Continue(usedRecoveryCode: !(entered.Replace(" ", string.Empty) is { Length: 6 } digits && digits.All(char.IsAsciiDigit)));
        }
    }

    private void Continue(bool usedRecoveryCode)
    {
        if (usedRecoveryCode)
        {
            Navigation.NavigateTo("hesabim?kurtarma=1");
            return;
        }

        // Yalnızca uygulama içi adreslere dönülür.
        var target = ReturnUrl is { Length: > 0 } url && !url.Contains("//") && !url.Contains(':') ? url : string.Empty;
        Navigation.NavigateTo(Session.HasActiveTenant ? target : Session.NoTenantHome);
    }
}
