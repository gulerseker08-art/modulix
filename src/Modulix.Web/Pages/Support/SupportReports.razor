@page "/destek/raporlar"
@inject ApiClient Api
@inject SessionState Session
@inject CrmLookups Lookups

<PageTitle>@Texts.Get("support.reports.title") · Modulix</PageTitle>

<AuthGate Module="@SupportAccess.ModuleKey" Permission="@SupportAccess.ReportsRead">
    <div class="page-header">
        <div>
            <h1>@Texts.Get("support.reports.title")</h1>
            <p class="text-muted mb-0">
                @Texts.Strong("support.reports.intro", Texts.Get("support.reports.introOpened"))
            </p>
        </div>
        <div class="header-actions"><a class="btn btn-outline-secondary" href="destek/sikayetler">@Texts.Get("nav.app.support.complaints")</a></div>
    </div>

    <form class="filters" @onsubmit="LoadAsync" @onsubmit:preventDefault aria-label="@Texts.Get("support.reports.filters")">
        <label class="visually-hidden" for="rp-from">@Texts.Get("support.reports.from")</label>
        <input id="rp-from" type="date" class="form-control form-control-sm filter-select" @bind="from" />
        <label class="visually-hidden" for="rp-to">@Texts.Get("support.reports.to")</label>
        <input id="rp-to" type="date" class="form-control form-control-sm filter-select" @bind="to" />
        <label class="visually-hidden" for="rp-gran">@Texts.Get("support.reports.granularity")</label>
        <select id="rp-gran" class="form-select form-select-sm filter-select" @bind="granularity">
            @foreach (var g in new[] { "day", "week", "month" }) { <option value="@g">@ReportLabels.Granularity(g)</option> }
        </select>
        <label class="visually-hidden" for="rp-type">@Texts.Get("common.field.kind")</label>
        <select id="rp-type" class="form-select form-select-sm filter-select" @bind="typeKey">
            <option value="">@Texts.Get("crm.act.allTypes")</option>
            @foreach (var t in Lookups.Choices(SupportLabels.TicketTypeList)) { <option value="@t.Key">@t.Label</option> }
        </select>
        <label class="visually-hidden" for="rp-priority">@Texts.Get("crm.leads.col.priority")</label>
        <select id="rp-priority" class="form-select form-select-sm filter-select" @bind="priority">
            <option value="">@Texts.Get("crm.act.allPriorities")</option>
            @foreach (var p in SupportLabels.Priorities) { <option value="@p.Key">@p.Label</option> }
        </select>
        <button type="submit" class="btn btn-sm btn-outline-secondary" disabled="@busy">@Texts.Get("support.reports.load")</button>
    </form>

    <Notice Text="@error" Failed="true" />

    @if (report is null && error is null)
    {
        <LoadingState />
    }
    else if (report is not null)
    {
        <p class="small text-muted" role="status">
            @report.Meta.From.ToString("dd.MM.yyyy") – @report.Meta.To.ToString("dd.MM.yyyy") · @Texts.Strong("support.reports.ticketCount", report.Meta.TicketCount.ToString()) · @ReportLabels.Granularity(report.Meta.Granularity) · @Texts.Get("support.reports.generatedAt", CrmLabels.Time(report.Meta.GeneratedAt))
        </p>
        @if (report.Meta.Truncated)
        {
            <div class="alert alert-warning" role="alert">@Texts.Get("support.reports.truncated")</div>
        }

        <section aria-labelledby="rp-volume"><h2 id="rp-volume">@Texts.Get("support.reports.volume")</h2>
            <p>@Texts.Get("support.reports.openedInPeriod") <strong><a href="@ReportLabels.Drill(report.Volume.DrillDown)">@report.Volume.Total</a></strong></p>
            @{ var max = Math.Max(1, report.Volume.Series.Max(p => p.Created)); }
            <table class="table record-table">
                <caption class="visually-hidden">@Texts.Get("support.reports.seriesCaption")</caption>
                <thead><tr><th scope="col">@Texts.Get("support.reports.col.bucketStart", ReportLabels.Granularity(report.Meta.Granularity))</th><th scope="col">@Texts.Get("support.reports.col.opened")</th><th scope="col">@Texts.Get("support.reports.col.distribution")</th></tr></thead>
                <tbody>
                    @foreach (var point in report.Volume.Series)
                    {
                        <tr><td data-label="@Texts.Get("support.reports.from")">@point.Bucket.ToString("dd.MM.yyyy")</td><td data-label="@Texts.Get("support.reports.col.opened")">@point.Created</td><td data-label="@Texts.Get("support.reports.col.distribution")"><progress value="@point.Created" max="@max" aria-label="@Texts.Get("support.reports.tickets", point.Created)"></progress></td></tr>
                    }
                </tbody>
            </table>
            <div class="form-grid">
                <div class="span-3"><h3 class="h6">@Texts.Get("support.reports.byStatus")</h3><ul class="plain-list">@foreach (var c in report.Volume.ByStatus) { <li><a href="@ReportLabels.Drill(c.DrillDown)">@SupportLabels.Label(SupportLabels.Statuses, c.Key)</a>: @c.Count</li> }</ul></div>
                <div class="span-3"><h3 class="h6">@Texts.Get("support.reports.byType")</h3><ul class="plain-list">@foreach (var c in report.Volume.ByType) { <li><a href="@ReportLabels.Drill(c.DrillDown)">@Lookups.Label(SupportLabels.TicketTypeList, c.Key)</a>: @c.Count</li> }</ul></div>
                <div class="span-3"><h3 class="h6">@Texts.Get("support.reports.byChannel")</h3><ul class="plain-list">@foreach (var c in report.Volume.ByChannel) { <li><a href="@ReportLabels.Drill(c.DrillDown)">@SupportLabels.Label(SupportLabels.Channels, c.Key)</a>: @c.Count</li> }</ul></div>
                <div class="span-3"><h3 class="h6">@Texts.Get("support.reports.byPriority")</h3><ul class="plain-list">@foreach (var c in report.Volume.ByPriority) { <li><a href="@ReportLabels.Drill(c.DrillDown)">@SupportLabels.Label(SupportLabels.Priorities, c.Key)</a>: @c.Count</li> }</ul></div>
            </div>
        </section>

        <section aria-labelledby="rp-backlog"><h2 id="rp-backlog">@Texts.Get("support.reports.backlog")</h2>
            <p class="small text-muted">@Texts.Get("support.reports.backlogHelp")</p>
            <p>@Texts.Strong("support.reports.backlogOpen", report.Backlog.Open.ToString()) · @Texts.Get("support.reports.backlogUnassigned", report.Backlog.Unassigned) · @Texts.Get("support.reports.oldest", report.Backlog.OldestDays is { } oldest ? Texts.Get("support.reports.days", oldest.ToString("0.#")) : "—")</p>
            <table class="table record-table">
                <caption class="visually-hidden">@Texts.Get("support.reports.backlogCaption")</caption>
                <thead><tr><th scope="col">@Texts.Get("support.tickets.col.age")</th><th scope="col">@Texts.Get("support.tickets.col.ticket")</th></tr></thead>
                <tbody>@foreach (var b in report.Backlog.Buckets) { <tr><td data-label="@Texts.Get("support.tickets.col.age")">@b.Label</td><td data-label="@Texts.Get("support.tickets.col.ticket")"><a href="@ReportLabels.Drill(b.DrillDown)">@b.Count</a></td></tr> }</tbody>
            </table>
        </section>

        <section aria-labelledby="rp-times"><h2 id="rp-times">@Texts.Get("support.reports.times")</h2>
            <p class="small text-muted">
                @Texts.Strong("support.reports.timesHelp", Texts.Get("support.reports.calendarTime"), Texts.Get("support.reports.businessTime"))
            </p>
            <table class="table record-table">
                <caption class="visually-hidden">@Texts.Get("support.reports.timesCaption")</caption>
                <thead><tr><th scope="col">@Texts.Get("support.reports.col.measure")</th><th scope="col">@Texts.Get("support.reports.col.sample")</th><th scope="col">@Texts.Get("support.reports.col.mean")</th><th scope="col">@Texts.Get("support.reports.col.median")</th><th scope="col">@Texts.Get("support.percent", 90)</th><th scope="col">@Texts.Get("support.percent", 95)</th><th scope="col">@Texts.Get("support.reports.col.minMax")</th></tr></thead>
                <tbody>
                    @foreach (var (label, d) in DurationRows())
                    {
                        <tr><td data-label="@Texts.Get("support.reports.col.measure")">@label</td><td data-label="@Texts.Get("support.reports.col.sample")">@d.Count</td><td data-label="@Texts.Get("support.reports.col.mean")">@ReportLabels.Minutes(d.Mean)</td><td data-label="@Texts.Get("support.reports.col.median")">@ReportLabels.Minutes(d.Median)</td>
                            <td data-label="@Texts.Get("support.percent", 90)">@ReportLabels.Minutes(d.P90)</td><td data-label="@Texts.Get("support.percent", 95)">@ReportLabels.Minutes(d.P95)</td><td data-label="@Texts.Get("support.reports.col.minMax")">@ReportLabels.Minutes(d.Min) / @ReportLabels.Minutes(d.Max)</td></tr>
                    }
                </tbody>
            </table>
            <p class="small text-muted">@Texts.Get("support.reports.notYet", report.Times.NotYetResponded, report.Times.NotYetResolved)</p>
        </section>

        <section aria-labelledby="rp-sla"><h2 id="rp-sla">@Texts.Get("support.reports.sla")</h2>
            <p class="small text-muted">@Texts.Get("support.reports.slaHelp")</p>
            <table class="table record-table">
                <caption class="visually-hidden">@Texts.Get("support.reports.sla")</caption>
                <thead><tr><th scope="col">@Texts.Get("support.reports.col.metric")</th><th scope="col">@Texts.Get("support.reports.col.met")</th><th scope="col">@Texts.Get("support.reports.col.missed")</th><th scope="col">@Texts.Get("support.reports.col.breached")</th><th scope="col">@Texts.Get("support.reports.col.decided")</th><th scope="col">@Texts.Get("support.reports.col.compliance")</th><th scope="col">@Texts.Get("support.reports.col.inProgress")</th><th scope="col">@Texts.Get("common.cancel")</th></tr></thead>
                <tbody>
                    @foreach (var s in report.Sla)
                    {
                        <tr><td data-label="@Texts.Get("support.reports.col.metric")">@ReportLabels.Metric(s.Metric)</td><td data-label="@Texts.Get("support.reports.col.met")">@s.Counts.Met</td><td data-label="@Texts.Get("support.reports.col.missed")">@s.Counts.Missed</td>
                            <td data-label="@Texts.Get("support.reports.col.breached")">@s.Counts.Breached</td><td data-label="@Texts.Get("support.reports.col.decided")">@s.Counts.Decided</td>
                            <td data-label="@Texts.Get("support.reports.col.compliance")"><strong>@ReportLabels.Percent(s.CompliancePercent)</strong> <small class="text-muted">(@s.Counts.Met / @s.Counts.Decided)</small></td>
                            <td data-label="@Texts.Get("support.reports.col.inProgress")">@s.Counts.InProgress</td><td data-label="@Texts.Get("common.cancel")">@s.Counts.Cancelled</td></tr>
                    }
                </tbody>
            </table>
            <a class="small" href="@ReportLabels.Drill(report.Sla[0].DrillDown)">@Texts.Get("support.reports.breachedOpen")</a>
        </section>

        <section aria-labelledby="rp-reopen"><h2 id="rp-reopen">@Texts.Get("support.detail.reopens")</h2>
            <p><strong>@ReportLabels.Percent(report.Reopen.RatePercent)</strong> <small class="text-muted">@Texts.Get("support.reports.reopenRatio", report.Reopen.Reopened, report.Reopen.Resolved)</small> · @Texts.Get("support.reports.reopenTotal", report.Reopen.TotalReopens) ·
                <a href="@ReportLabels.Drill(report.Reopen.DrillDown)">@Texts.Get("support.reports.showTickets")</a></p>
        </section>

        <section aria-labelledby="rp-csat"><h2 id="rp-csat">@Texts.Get("support.reports.csat")</h2>
            @if (report.Csat.SmallSample)
            {
                <div class="alert alert-warning" role="status">@Texts.Get("support.reports.smallSample", report.Csat.Answered)</div>
            }
            <p>
                @(report.Csat.NotSent > 0 ? Texts.Strong("support.reports.sentWithFailed", report.Csat.Sent.ToString(), report.Csat.NotSent.ToString()) : Texts.Strong("support.reports.sent", report.Csat.Sent.ToString())) · @Texts.Strong("support.reports.answered", report.Csat.Answered.ToString())
                · @Texts.Strong("support.reports.responseRate", ReportLabels.Percent(report.Csat.ResponseRatePercent)) · @Texts.Strong("support.reports.averageRating", report.Csat.AverageRating is { } avg ? avg.ToString("0.##") : "—")
                · @Texts.Get("support.reports.lowRating") <a href="@ReportLabels.Drill(report.Csat.DrillDown)">@report.Csat.Low</a>
            </p>
            <ul class="plain-list">@foreach (var d in report.Csat.Distribution) { <li>@Texts.Get("support.reports.ratingCount", d.Key, d.Count)</li> }</ul>
            <p class="small text-muted">@Texts.Get("support.reports.comments")</p>
        </section>
    }
</AuthGate>

@code {
    private ReportOverviewDto? report;
    private string? error;
    private bool busy;
    private DateOnly from = DateOnly.FromDateTime(DateTime.Today.AddDays(-29));
    private DateOnly to = DateOnly.FromDateTime(DateTime.Today);
    private string granularity = "day";
    private string typeKey = string.Empty;
    private string priority = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (Session.Can(SupportAccess.ReportsRead))
        {
            await Lookups.LoadAsync();
            await LoadAsync();
        }
    }

    private IEnumerable<(string Label, ReportDurationDto Stats)> DurationRows()
    {
        yield return (Texts.Get("support.reports.firstResponseCalendar"), report!.Times.FirstResponseCalendar);
        yield return (Texts.Get("support.reports.firstResponseBusiness"), report.Times.FirstResponseBusiness);
        yield return (Texts.Get("support.reports.resolutionCalendar"), report.Times.ResolutionCalendar);
        yield return (Texts.Get("support.reports.resolutionBusiness"), report.Times.ResolutionBusiness);
    }

    private async Task LoadAsync()
    {
        busy = true;
        var query = new List<string> { $"from={from:yyyy-MM-dd}", $"to={to:yyyy-MM-dd}", $"granularity={granularity}" };
        if (typeKey.Length > 0) { query.Add($"typeKey={Uri.EscapeDataString(typeKey)}"); }
        if (priority.Length > 0) { query.Add($"priority={Uri.EscapeDataString(priority)}"); }
        var result = await Api.GetAsync<ReportOverviewDto>($"/api/support/reports/overview?{string.Join('&', query)}");
        busy = false;
        error = result.IsSuccess ? null : result.Error;
        if (result.IsSuccess) { report = result.Value; }
    }
}
