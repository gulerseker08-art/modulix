@page "/destek/yonlendirme"
@inject ApiClient Api
@inject SessionState Session
@inject CrmLookups Lookups

<PageTitle>Öncelik ve yönlendirme · Modulix</PageTitle>

<AuthGate Module="@SupportAccess.ModuleKey" Permission="@SupportAccess.SettingsManage">
    <div class="page-header">
        <div>
            <h1>Öncelik matrisi ve yönlendirme</h1>
            <p class="text-muted mb-0">Yeni talebin önceliği etki × aciliyetten, kuyruğu ve sorumlusu yönlendirme kurallarından belirlenir. Matris ve kurallar yalnızca <strong>sonradan açılan</strong> talepleri etkiler; mevcut talepler yeniden yönlendirilmez.</p>
        </div>
        <div class="header-actions"><a class="btn btn-outline-secondary" href="destek/ayarlar">Kuyruklar ve kategoriler</a></div>
    </div>

    <Notice Text="@message" Failed="@failed" />

    <section aria-labelledby="matrix-title">
        <h2 id="matrix-title">Öncelik matrisi</h2>
        @if (cells is null) { <p class="text-muted" role="status">Yükleniyor…</p> }
        else
        {
            <form class="record-form" novalidate @onsubmit="SaveMatrixAsync" @onsubmit:preventDefault>
                <fieldset disabled="@busy">
                    <legend class="visually-hidden">Etki ve aciliyete göre öncelik</legend>
                    <table class="table record-table">
                        <caption class="visually-hidden">Öncelik matrisi (satır: etki, sütun: aciliyet)</caption>
                        <thead><tr><th scope="col">Etki \ Aciliyet</th>@foreach (var (u, label) in SupportLabels.Levels) { <th scope="col">@label</th> }</tr></thead>
                        <tbody>
                            @foreach (var (i, iLabel) in SupportLabels.Levels)
                            {
                                <tr>
                                    <th scope="row">@iLabel</th>
                                    @foreach (var (u, uLabel) in SupportLabels.Levels)
                                    {
                                        var cell = cells.First(c => c.Impact == i && c.Urgency == u);
                                        <td data-label="@(iLabel + " / " + uLabel)">
                                            <label class="visually-hidden" for="cell-@i-@u">Etki @iLabel, aciliyet @uLabel için öncelik</label>
                                            <select id="cell-@i-@u" class="form-select form-select-sm" @bind="cell.Priority">
                                                @foreach (var (key, label) in SupportLabels.Priorities) { <option value="@key">@label</option> }
                                            </select>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </fieldset>
                <div class="form-actions"><button type="submit" class="btn btn-primary" disabled="@busy">Matrisi kaydet</button></div>
            </form>
        }
    </section>

    <section aria-labelledby="rules-title">
        <h2 id="rules-title">Yönlendirme kuralları</h2>
        <p class="small text-muted">Etkin kurallardan sırası küçük olan, eşit sırada daha çok kısıtı olan <strong>ilk eşleşen</strong> uygulanır; yalnızca talep açılırken bir kez değerlendirilir. Yetkiyle açıkça kuyruk/sorumlu verilen talepte kural uygulanmaz. Hiçbiri uymazsa kategori, sonra varsayılan kuyruk kullanılır.</p>
        @if (rules is null) { <p class="text-muted" role="status">Yükleniyor…</p> }
        else if (rules.Count == 0) { <p class="text-muted">Kural yok.</p> }
        else
        {
            <table class="table record-table">
                <caption class="visually-hidden">Yönlendirme kuralları</caption>
                <thead><tr><th scope="col">Sıra</th><th scope="col">Kural</th><th scope="col">Kısıtlar</th><th scope="col">Eylem</th><th scope="col">Durum</th><th scope="col">İşlem</th></tr></thead>
                <tbody>
                    @foreach (var r in rules)
                    {
                        <tr>
                            <td data-label="Sıra">@r.Order</td>
                            <td data-label="Kural" class="primary">@r.Name</td>
                            <td data-label="Kısıtlar">@Constraints(r)</td>
                            <td data-label="Eylem">@Actions(r)</td>
                            <td data-label="Durum"><span class="badge stage-@(r.IsActive ? "won" : "cancelled")">@(r.IsActive ? "Etkin" : "Pasif")</span></td>
                            <td data-label="İşlem"><button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => EditRule(r)" disabled="@busy">Düzenle</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <form class="record-form" novalidate @onsubmit="SaveRuleAsync" @onsubmit:preventDefault>
            <fieldset disabled="@busy">
                <legend class="h6">@(rule.Id is null ? "Yeni kural" : "Kuralı düzenle")</legend>
                <FormTabs Title="Kural bilgileri" Label="Yönlendirme kuralı formu bölümleri">
                <div class="form-grid">
                    <div class="span-6">
                        <label class="form-label" for="rule-name">Ad</label>
                        <input id="rule-name" class="form-control" maxlength="100" @bind="rule.Name" />
                        <FieldError Field="name" Errors="ruleErrors" />
                    </div>
                    <div class="span-3">
                        <label class="form-label" for="rule-order">Sıra (küçük önce)</label>
                        <input id="rule-order" type="number" min="0" max="1000" class="form-control" @bind="rule.Order" />
                    </div>
                    <div class="span-3 form-check align-self-end">
                        <input id="rule-active" class="form-check-input" type="checkbox" @bind="rule.IsActive" />
                        <label class="form-check-label" for="rule-active">Etkin</label>
                    </div>
                    <div class="span-3">
                        <label class="form-label" for="rule-channel">Kanal</label>
                        <select id="rule-channel" class="form-select" @bind="rule.Channel">
                            <option value="">Tümü</option>
                            @foreach (var (key, label) in SupportLabels.Channels) { <option value="@key">@label</option> }
                        </select>
                    </div>
                    <div class="span-3">
                        <label class="form-label" for="rule-type">Tür</label>
                        <select id="rule-type" class="form-select" @bind="rule.TypeKey">
                            <option value="">Tümü</option>
                            @foreach (var t in Lookups.Choices(SupportLabels.TicketTypeList)) { <option value="@t.Key">@t.Label</option> }
                        </select>
                    </div>
                    <div class="span-3">
                        <label class="form-label" for="rule-priority">Öncelik</label>
                        <select id="rule-priority" class="form-select" @bind="rule.Priority">
                            <option value="">Tümü</option>
                            @foreach (var (key, label) in SupportLabels.Priorities) { <option value="@key">@label</option> }
                        </select>
                    </div>
                    <div class="span-3">
                        <label class="form-label" for="rule-category">Kategori</label>
                        <LookupPicker Id="rule-category" LookupKey="support.routing-rule.category" @bind-Value="rule.CategoryId" Placeholder="Tümü" />
                        <FieldError Field="categoryId" Errors="ruleErrors" />
                    </div>
                    <div class="span-4">
                        <label class="form-label" for="rule-party">Müşteri</label>
                        <LookupPicker Id="rule-party" LookupKey="support.routing-rule.party" @bind-Value="rule.PartyId" Placeholder="Tümü" />
                        <FieldError Field="partyId" Errors="ruleErrors" />
                    </div>
                    <div class="span-4">
                        <label class="form-label" for="rule-queue">Kuyruğa yönlendir</label>
                        <LookupPicker Id="rule-queue" LookupKey="support.routing-rule.queue" @bind-Value="rule.QueueId" Placeholder="Kuyruk seçin…" />
                        <FieldError Field="queueId" Errors="ruleErrors" />
                    </div>
                    <div class="span-4">
                        <label class="form-label" for="rule-owner">Sorumlu ata</label>
                        <LookupPicker Id="rule-owner" LookupKey="support.routing-rule.owner" @bind-Value="rule.OwnerId" Placeholder="Atama yok" />
                        <FieldError Field="ownerId" Errors="ruleErrors" />
                    </div>
                </div>
                </FormTabs>
            </fieldset>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary" disabled="@busy">@(rule.Id is null ? "Kural ekle" : "Kaydet")</button>
                @if (rule.Id is not null) { <button type="button" class="btn btn-outline-secondary" @onclick="NewRule">Vazgeç</button> }
            </div>
        </form>
    </section>

    <section aria-labelledby="try-title">
        <h2 id="try-title">Kural denemesi</h2>
        <p class="small text-muted">Örnek bir talep için hangi kural eşleşir, hangi kuyruk ve sorumlu çıkar? Hiçbir şey yazılmaz.</p>
        <form class="record-form" novalidate @onsubmit="PreviewAsync" @onsubmit:preventDefault>
            <div class="form-grid">
                <div class="span-3">
                    <label class="form-label" for="pv-channel">Kanal</label>
                    <select id="pv-channel" class="form-select" @bind="pv.Channel">
                        @foreach (var (key, label) in SupportLabels.Channels) { <option value="@key">@label</option> }
                    </select>
                </div>
                <div class="span-3">
                    <label class="form-label" for="pv-type">Tür</label>
                    <select id="pv-type" class="form-select" @bind="pv.TypeKey">
                        @foreach (var t in Lookups.Choices(SupportLabels.TicketTypeList)) { <option value="@t.Key">@t.Label</option> }
                    </select>
                </div>
                <div class="span-3">
                    <label class="form-label" for="pv-priority">Öncelik</label>
                    <select id="pv-priority" class="form-select" @bind="pv.Priority">
                        @foreach (var (key, label) in SupportLabels.Priorities) { <option value="@key">@label</option> }
                    </select>
                </div>
                <div class="span-3">
                    <label class="form-label" for="pv-category">Kategori</label>
                    <LookupPicker Id="pv-category" LookupKey="support.routing-rule.category" @bind-Value="pv.CategoryId" Placeholder="Kategorisiz" />
                </div>
                <div class="span-6">
                    <label class="form-label" for="pv-party">Müşteri</label>
                    <LookupPicker Id="pv-party" LookupKey="support.routing-rule.party" @bind-Value="pv.PartyId" Placeholder="Müşterisiz" />
                </div>
            </div>
            <div class="form-actions"><button type="submit" class="btn btn-outline-secondary" disabled="@busy">Dene</button></div>
        </form>
        @if (preview is not null)
        {
            <div class="alert @(preview.RuleMatched ? "alert-info" : "alert-warning")" role="status">
                @if (preview.RuleMatched) { <span>Eşleşen kural: <strong>@preview.RuleName</strong> (sıra @preview.RuleOrder).</span> }
                else { <span>Hiçbir kural eşleşmedi.</span> }
                Kuyruk: <strong>@(preview.QueueId is { } q ? queues.FirstOrDefault(x => x.Id == q)?.Name ?? "—" : "kuyruksuz (atanmamış)")</strong> (@preview.Source);
                sorumlu: <strong>@(preview.OwnerId is { } o ? Lookups.MemberName(o) : "atanmaz")</strong>.
            </div>
        }
    </section>
</AuthGate>

@code {
    private List<CellEdit>? cells;
    private List<RoutingRuleDto>? rules;
    private List<QueueDto> queues = [];
    private string? message;
    private bool failed;
    private bool busy;
    private RuleForm rule = new();
    private IReadOnlyDictionary<string, string[]>? ruleErrors;
    private PreviewForm pv = new();
    private RoutingPreviewDto? preview;

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (!Session.Can(SupportAccess.SettingsManage)) { return; }
        await Lookups.LoadAsync();
        pv.TypeKey = Lookups.DefaultOf(SupportLabels.TicketTypeList) ?? "Support";
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        cells = ((await Api.GetAsync<List<PriorityCellDto>>("/api/support/priority-matrix")).Value ?? []).Select(c => new CellEdit(c.Impact, c.Urgency, c.Priority)).ToList();
        rules = (await Api.GetAsync<PagedResult<RoutingRuleDto>>("/api/support/routing-rules?pageSize=200")).Value?.Items.ToList() ?? [];
        queues = (await Api.GetAsync<PagedResult<QueueDto>>("/api/support/queues?pageSize=200")).Value?.Items.ToList() ?? [];
    }

    private async Task SaveMatrixAsync()
    {
        busy = true;
        var result = await Api.PutAsync<List<PriorityCellDto>>("/api/support/priority-matrix", new SavePriorityMatrixRequest([.. cells!.Select(c => new PriorityCellDto(c.Impact, c.Urgency, c.Priority))]));
        busy = false;
        failed = !result.IsSuccess;
        message = result.IsSuccess ? "Öncelik matrisi kaydedildi; yalnızca sonradan açılan talepleri etkiler." : result.Error;
        if (result.IsSuccess) { cells = result.Value!.Select(c => new CellEdit(c.Impact, c.Urgency, c.Priority)).ToList(); }
    }

    private void NewRule() { rule = new RuleForm(); ruleErrors = null; }

    private void EditRule(RoutingRuleDto r)
    {
        rule = new RuleForm
        {
            Id = r.Id, Version = r.Version, Name = r.Name, Order = r.Order, IsActive = r.IsActive, Channel = r.Channel ?? string.Empty, TypeKey = r.TypeKey ?? string.Empty,
            CategoryId = r.CategoryId, Priority = r.Priority ?? string.Empty, PartyId = r.PartyId, QueueId = r.QueueId, OwnerId = r.OwnerId,
        };
        ruleErrors = null;
    }

    private async Task SaveRuleAsync()
    {
        ruleErrors = null;
        var request = new SaveRoutingRuleRequest(
            rule.Id is null ? 0 : rule.Version, rule.Name, rule.Order, rule.IsActive, rule.Channel.Length == 0 ? null : rule.Channel, rule.TypeKey.Length == 0 ? null : rule.TypeKey,
            rule.CategoryId, rule.Priority.Length == 0 ? null : rule.Priority, rule.PartyId, rule.QueueId, rule.OwnerId);
        busy = true;
        message = null;
        var result = rule.Id is null
            ? await Api.PostAsync<RoutingRuleDto>("/api/support/routing-rules", request)
            : await Api.PutAsync<RoutingRuleDto>($"/api/support/routing-rules/{rule.Id}", request);
        busy = false;
        failed = !result.IsSuccess;
        message = result.IsSuccess ? "Kural kaydedildi." : result.Error;
        ruleErrors = result.FieldErrors;
        if (result.IsSuccess)
        {
            NewRule();
            await ReloadAsync();
        }
    }

    private async Task PreviewAsync()
    {
        busy = true;
        var result = await Api.PostAsync<RoutingPreviewDto>("/api/support/routing/preview", new RoutingPreviewRequest(pv.Channel, pv.TypeKey, pv.Priority, pv.CategoryId, pv.PartyId));
        busy = false;
        failed = !result.IsSuccess;
        message = result.IsSuccess ? null : result.Error;
        preview = result.Value;
    }

    private string Constraints(RoutingRuleDto r)
    {
        var parts = new List<string>();
        if (r.Channel is not null) { parts.Add("kanal: " + SupportLabels.Label(SupportLabels.Channels, r.Channel)); }
        if (r.TypeKey is not null) { parts.Add("tür: " + Lookups.Label(SupportLabels.TicketTypeList, r.TypeKey)); }
        if (r.Priority is not null) { parts.Add("öncelik: " + SupportLabels.Label(SupportLabels.Priorities, r.Priority)); }
        if (r.CategoryId is not null) { parts.Add("kategori"); }
        if (r.PartyId is not null) { parts.Add("müşteri"); }
        return parts.Count == 0 ? "kısıtsız (hepsi)" : string.Join(", ", parts);
    }

    private string Actions(RoutingRuleDto r) =>
        string.Join(" · ", new[] { r.QueueId is { } q ? "kuyruk: " + (queues.FirstOrDefault(x => x.Id == q)?.Name ?? "—") : null, r.OwnerId is { } o ? "sorumlu: " + Lookups.MemberName(o) : null }.Where(x => x is not null));

    private sealed class CellEdit(string impact, string urgency, string priority)
    {
        public string Impact { get; } = impact;
        public string Urgency { get; } = urgency;
        public string Priority { get; set; } = priority;
    }

    private sealed class RuleForm
    {
        public Guid? Id { get; set; }
        public long Version { get; set; }
        public string Name { get; set; } = string.Empty;
        public int Order { get; set; } = 100;
        public bool IsActive { get; set; } = true;
        public string Channel { get; set; } = string.Empty;
        public string TypeKey { get; set; } = string.Empty;
        public Guid? CategoryId { get; set; }
        public string Priority { get; set; } = string.Empty;
        public Guid? PartyId { get; set; }
        public Guid? QueueId { get; set; }
        public Guid? OwnerId { get; set; }
    }

    private sealed class PreviewForm
    {
        public string Channel { get; set; } = "Web";
        public string TypeKey { get; set; } = "Support";
        public string Priority { get; set; } = "Normal";
        public Guid? CategoryId { get; set; }
        public Guid? PartyId { get; set; }
    }
}
