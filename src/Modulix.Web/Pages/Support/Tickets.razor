@page "/destek/talepler"
@inject ApiClient Api
@inject SessionState Session
@inject CrmLookups Lookups

<PageTitle>Destek talepleri · Modulix</PageTitle>

<AuthGate Module="@SupportAccess.ModuleKey" Permission="@SupportAccess.TicketsRead">
    <div class="page-header">
        <div>
            <h1>Destek çalışma alanı</h1>
            <p class="text-muted mb-0">Benim taleplerim, atanmamış talepler ve bekleyenler. Sayılar yetkiniz ve veri kapsamınızla sınırlıdır ve altındaki listeyle aynı süzgeci kullanır.</p>
        </div>
        <div class="header-actions">
            @if (Session.Can(SupportAccess.TicketsExport))
            {
                <a class="btn btn-outline-secondary" href="api/support/tickets/export?@Query(1)" download="talepler.csv">CSV dışa aktar</a>
            }
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(RawFilter))
    {
        <div class="alert alert-info" role="status">Rapor süzgeci uygulandı. <a href="destek/talepler">Süzgeci temizle</a> · <a href="destek/raporlar">Rapora dön</a></div>
    }

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message <button type="button" class="btn btn-sm btn-outline-secondary ms-2" @onclick="() => LoadAsync(1)">Tekrar dene</button></div>
    }

    <ViewTabs Items="ViewOptions" Value="@viewKey" ValueChanged="ChooseViewAsync" Label="Talep görünümleri" NewView="StartNaming" NewViewText="Görünüm" />

    <div class="list-toolbar">
        <form class="search" @onsubmit="() => LoadAsync(1)" @onsubmit:preventDefault>
            <label class="visually-hidden" for="ticket-search">Talep ara</label>
            <input id="ticket-search" class="form-control" type="search" placeholder="Konu, talep numarası veya başvuran ara" @bind="search" />
        </form>
        <FilterToggle @bind-Open="filtersOpen" Count="ActiveFilters" />
        <GridColumnPicker State="grid" Changed="@(() => Task.CompletedTask)" />
        @if (Session.Can(SupportAccess.TicketsCreate))
        {
            <a class="btn btn-primary" href="destek/talepler/yeni"><AppIcon Name="plus" Size="16" /> Yeni talep</a>
        }
    </div>

    @if (filtersOpen || ActiveFilters > 0)
    {
        <div class="filters">
            <label class="visually-hidden" for="status-filter">Durum</label>
            <select id="status-filter" class="form-select form-select-sm filter-select" @bind="status" @bind:after="() => LoadAsync(1)">
                <option value="">Tüm durumlar</option>
                @foreach (var s in SupportLabels.Statuses)
                {
                    <option value="@s.Key">@s.Label</option>
                }
            </select>
            <label class="visually-hidden" for="priority-filter">Öncelik</label>
            <select id="priority-filter" class="form-select form-select-sm filter-select" @bind="priority" @bind:after="() => LoadAsync(1)">
                <option value="">Tüm öncelikler</option>
                @foreach (var p in SupportLabels.Priorities)
                {
                    <option value="@p.Key">@p.Label</option>
                }
            </select>
            <label class="visually-hidden" for="type-filter">Tür</label>
            <select id="type-filter" class="form-select form-select-sm filter-select" @bind="typeKey" @bind:after="() => LoadAsync(1)">
                <option value="">Tüm türler</option>
                @foreach (var t in Lookups.Choices(SupportLabels.TicketTypeList))
                {
                    <option value="@t.Key">@t.Label</option>
                }
            </select>
        </div>
    }

    <PersonalViewBar Active="Active" Dirty="grid.Differs(Active)" Naming="views.Naming" NamingChanged="views.StartNaming" Error="@views.Error"
                     SaveAs="SaveAsAsync" UpdateView="UpdateViewAsync" DiscardChanges="DiscardAsync" DeleteView="DeleteViewAsync" />

    @if (page is null && message is null)
    {
        <p class="text-muted" role="status">Yükleniyor…</p>
    }
    else if (page is not null && page.Items.Count == 0)
    {
        <p class="text-muted" role="status">Bu süzgece uyan talep yok.@(Session.Can(SupportAccess.TicketsCreate) ? " Yeni talep açabilirsiniz." : null)</p>
    }
    else if (page is not null)
    {
        <p class="visually-hidden" role="status" aria-live="polite">@(page.TotalCount) talep listelendi.</p>
        @if (CanBulk)
        {
            <section class="bulk-bar" aria-label="Toplu işlem">
                <p class="small text-muted mb-1">
                    Seçilen taleplerin her biri kendi eyleminin izin, veri kapsamı ve kuralıyla işlenir; işlem atomik değildir, her talebin sonucu ayrı gösterilir. En çok 50 talep.
                </p>
                <div class="filters">
                    <span role="status" aria-live="polite">@selected.Count talep seçili</span>
                    <label class="visually-hidden" for="bulk-action">Toplu işlem</label>
                    <select id="bulk-action" class="form-select form-select-sm filter-select" @bind="bulkAction">
                        <option value="">İşlem seçin</option>
                        @if (Session.Can(SupportAccess.TicketsAssign)) { <option value="assign">Sorumlu ata</option> }
                        @if (Session.Can(SupportAccess.TicketsClose)) { <option value="close">Kapat (çözülmüş olmalı)</option> }
                        @if (Session.Can(SupportAccess.TicketsCancel)) { <option value="cancel">İptal et</option> }
                    </select>
                    @if (bulkAction == "assign")
                    {
                        <LookupPicker Id="bulk-owner" LookupKey="support.ticket.owner" @bind-Value="bulkOwner" Placeholder="Sorumlu seçin" />
                    }
                    @if (bulkAction == "cancel")
                    {
                        <label class="visually-hidden" for="bulk-reason">Gerekçe</label>
                        <input id="bulk-reason" class="form-control form-control-sm" maxlength="500" placeholder="Gerekçe (zorunlu)" @bind="bulkReason" />
                    }
                    <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(bulkBusy || selected.Count == 0 || string.IsNullOrEmpty(bulkAction))" @onclick="RunBulkAsync">Uygula</button>
                </div>
                @if (bulkResults is not null)
                {
                    <div class="alert @(bulkResults.All(r => r.Succeeded) ? "alert-success" : "alert-warning")" role="status">
                        @bulkResults.Count(r => r.Succeeded) / @bulkResults.Count talep işlendi.
                        @if (bulkResults.Any(r => !r.Succeeded))
                        {
                            <ul class="mb-0">
                                @foreach (var r in bulkResults.Where(r => !r.Succeeded))
                                {
                                    <li>@(r.Number ?? "Talep bulunamadı"): @r.Message</li>
                                }
                            </ul>
                        }
                    </div>
                }
            </section>
        }
        <table class="table record-table">
            <caption class="visually-hidden">Destek talebi listesi</caption>
            <thead>
                <tr>
                    @if (CanBulk)
                    {
                        <th scope="col"><span class="visually-hidden">Seç</span></th>
                    }
                    @foreach (var column in grid.VisibleColumns)
                    {
                        <GridHeader Column="column" State="grid" SortChanged="SortAsync" />
                    }
                    <th scope="col" class="row-menu-cell"><span class="visually-hidden">Eylemler</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in page.Items)
                {
                    <tr>
                        @if (CanBulk)
                        {
                            <td data-label="Seç">
                                <input type="checkbox" class="form-check-input" aria-label="@(t.Number + " numaralı talebi seç")" checked="@selected.Contains(t.Id)" @onchange="e => Toggle(t.Id, (bool)e.Value!)" />
                            </td>
                        }
                        @foreach (var column in grid.VisibleColumns)
                        {
                            @Cell(column, t)
                        }
                        <td class="row-menu-cell">
                            <RowMenu Label="@($"{t.Number} eylemleri")">
                                <a class="view-menu-item" role="menuitem" href="destek/talepler/@t.Id"><AppIcon Name="eye" Size="16" /> <span>Aç</span></a>
                            </RowMenu>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager PageSizeChoice="true" Page="page.Page" PageSize="page.PageSize" TotalCount="page.TotalCount" PageChanged="LoadAsync" />
    }
</AuthGate>

@code {
    private bool filtersOpen;

    /// <summary>Etkin süzgeç sayısı ("Filtrele" rozeti); süzgeç satırı etkin süzgeç varken açık kalır.</summary>
    private int ActiveFilters => (string.IsNullOrEmpty(status) ? 0 : 1) + (string.IsNullOrEmpty(priority) ? 0 : 1) + (string.IsNullOrEmpty(typeKey) ? 0 : 1);

    private const string DefaultSort = "-createdAt";
    private const string AllViews = "all";

    /// <summary>Hızlı görünümler; her biri sunucudaki süzgeçlerden birine karşılık gelir.</summary>
    private static readonly (string Key, string Label, string Icon)[] Presets =
    [
        ("mine", "Benim taleplerim", "star"), ("unassigned", "Atanmamış", "user"), ("awaiting", "Yanıt bekleyen", "clock"), ("waiting", "Müşteri bekleyen", "hourglass"),
        ("reopened", "Yeniden açılan", "repeat"), ("resolved", "Çözüldü (teyit bekliyor)", "check-circle"), ("slarisk", "SLA riski", "alert-circle"), ("slabreach", "SLA ihlali", "alert-circle"), ("open", "Tüm açık talepler", "inbox"),
    ];

    // Sıralama sunucudaki sort anahtarlarıdır (TicketSort). Bazı anahtarlar tek yönlüdür: öncelik (yüksek önce), son hareket (yeni önce), SLA (yakın önce),
    // yaş (eski önce); ikinci tıklama varsayılan sıraya (en yeni önce) döner.
    private static readonly GridColumnDef[] Columns =
    [
        new("ticket", "Talep", "message-square", "number", "-number", Locked: true),
        new("customer", "Müşteri", "building"),
        new("type", "Tür", "tag"),
        new("priority", "Öncelik", "alert-circle", "priority"),
        new("status", "Durum", "activity"),
        new("owner", "Sorumlu", "user"),
        new("age", "Yaş", "clock", "createdAt"),
        new("sla", "SLA hedefleri", "hourglass", "resolutionDue"),
        new("activity", "Son hareket", "history", "-lastActivity"),
        new("reporter", "Başvuran", "user", DefaultVisible: false),
    ];

    /// <summary>Pano / başka ekranlardan gelen bağlantılar: <c>?gorunum=unassigned</c>, <c>?musteri={id}</c>.</summary>
    [SupplyParameterFromQuery(Name = "gorunum")] public string? InitialView { get; set; }

    [SupplyParameterFromQuery(Name = "musteri")] public Guid? PartyId { get; set; }

    /// <summary>Rapor kırılımı: rapordaki sayıyla aynı sonucu veren süzgeç sorgu dizesi (ör. createdFrom=2026-10-01&status=New); sunucu bilinmeyen süzgeci reddeder.</summary>
    [SupplyParameterFromQuery(Name = "filtre")] public string? RawFilter { get; set; }

    private PagedResult<TicketDto>? page;
    private TicketSummaryDto? summary;
    private string? message;
    private string? view;
    private string viewKey = AllViews;
    private string? status;
    private string? priority;
    private string? typeKey;
    private readonly GridViewState grid = new("support.tickets", DefaultSort);
    private PersonalGridViews views = default!;
    private string search = string.Empty;

    private Task SortAsync(string key)
    {
        grid.Sort = key;
        return LoadAsync(1);
    }

    private GridViewDto? Active => views.Find(viewKey);
    private readonly HashSet<Guid> selected = [];
    private string bulkAction = string.Empty;
    private Guid? bulkOwner;
    private string bulkReason = string.Empty;
    private bool bulkBusy;
    private List<BulkTicketResultDto>? bulkResults;

    private bool CanBulk => Session.Can(SupportAccess.TicketsAssign) || Session.Can(SupportAccess.TicketsClose) || Session.Can(SupportAccess.TicketsCancel);

    private void Toggle(Guid id, bool on)
    {
        if (on && selected.Count < 50) { selected.Add(id); } else { selected.Remove(id); }
    }

    private async Task RunBulkAsync()
    {
        if (bulkBusy || selected.Count == 0 || string.IsNullOrEmpty(bulkAction)) { return; }
        bulkBusy = true;
        var result = await Api.PostAsync<List<BulkTicketResultDto>>("/api/support/tickets/bulk",
            new BulkTicketsRequest(bulkAction, [.. selected], string.IsNullOrWhiteSpace(bulkReason) ? null : bulkReason.Trim(), bulkOwner));
        bulkBusy = false;
        if (result.IsSuccess)
        {
            bulkResults = result.Value;
            selected.Clear();
            await LoadAsync(page?.Page ?? 1);
        }
        else
        {
            bulkResults = [new BulkTicketResultDto(Guid.Empty, null, false, null, result.Error)];
        }
    }

    protected override async Task OnInitializedAsync()
    {
        views = new PersonalGridViews(Api, "support.tickets");
        grid.Define(Columns);
        await Session.EnsureLoadedAsync();
        if (Session.Can(SupportAccess.TicketsRead))
        {
            await Lookups.LoadAsync();
            await views.LoadAsync();
            if (InitialView is not null && Presets.Any(p => p.Key == InitialView)) { view = InitialView; viewKey = InitialView; }
            await LoadAsync(1);
        }
    }

    private int? Count(string key) => summary is null ? null : key switch
    {
        "mine" => summary.Mine,
        "unassigned" => summary.Unassigned,
        "awaiting" => summary.AwaitingFirstResponse,
        "waiting" => summary.WaitingCustomer,
        "reopened" => summary.Reopened,
        "resolved" => summary.Resolved,
        "slarisk" => summary.SlaAtRisk,
        "slabreach" => summary.SlaBreached,
        "open" => summary.Open,
        _ => null,
    };

    // Her hızlı görünümün yanında özet sayısı gösterilir (varsa); ardından kişisel görünümler.
    private IReadOnlyList<ViewOption> ViewOptions =>
    [
        new(AllViews, "Tüm talepler", Icon: "inbox"),
        .. Presets.Select(p => new ViewOption(p.Key, p.Label + (Count(p.Key) is { } n ? $" ({n})" : null), Icon: p.Icon)),
        .. views.Options,
    ];

    private async Task ChooseViewAsync(string key)
    {
        viewKey = key;
        views.StartNaming(false);
        if (Active is { } saved)
        {
            // Kişisel görünüm: sütunlar, sıralama ve süzgeç (görünüm + durum + öncelik + tür) birlikte gelir.
            grid.Apply(saved);
            var filters = GridFilters.Parse(saved.Filters);
            var preset = filters.GetValueOrDefault("view");
            view = preset is not null && Presets.Any(p => p.Key == preset) ? preset : null;
            status = filters.GetValueOrDefault("status");
            priority = filters.GetValueOrDefault("priority");
            typeKey = filters.GetValueOrDefault("type");
        }
        else
        {
            grid.Reset();
            view = key == AllViews ? null : key;
        }

        await LoadAsync(1);
    }

    private string? CurrentFilters => GridFilters.Build(
        view is { Length: > 0 } v ? ("view", v) : null,
        status is { Length: > 0 } s ? ("status", s) : null,
        priority is { Length: > 0 } p ? ("priority", p) : null,
        typeKey is { Length: > 0 } t ? ("type", t) : null);

    private void StartNaming() => views.StartNaming(true);

    private async Task SaveAsAsync(string name)
    {
        if (await views.SaveAsAsync(grid.ToRequest(name, CurrentFilters)) is { } key)
        {
            viewKey = key;
        }
    }

    private async Task UpdateViewAsync()
    {
        if (Active is { } current)
        {
            await views.UpdateAsync(current, grid.ToRequest(current.Name, CurrentFilters));
        }
    }

    private async Task DiscardAsync() => await ChooseViewAsync(viewKey);

    private async Task DeleteViewAsync()
    {
        if (Active is { } current && await views.DeleteAsync(current))
        {
            status = priority = typeKey = null;
            await ChooseViewAsync(AllViews);
        }
    }

    private string Query(int pageNumber)
    {
        var parts = new List<string> { $"page={pageNumber}&pageSize={ListPaging.Size}" };
        if (!string.IsNullOrWhiteSpace(search)) { parts.Add($"search={Uri.EscapeDataString(search.Trim())}"); }
        switch (view)
        {
            case "mine": parts.Add("ownerId=me"); parts.Add("open=true"); break;
            case "unassigned": parts.Add("unassigned=true"); break;
            case "awaiting": parts.Add("awaitingFirstResponse=true"); break;
            case "waiting": parts.Add("status=WaitingCustomer"); break;
            case "reopened": parts.Add("status=Reopened"); break;
            case "resolved": parts.Add("status=Resolved"); break;
            case "slarisk": parts.Add("slaAtRisk=true"); parts.Add("open=true"); break;
            case "slabreach": parts.Add("slaBreached=true"); parts.Add("open=true"); break;
            case "open": parts.Add("open=true"); break;
        }

        // Durum seçimi hızlı görünümün durum süzgeciyle çakışırsa seçilen durum geçerlidir.
        if (!string.IsNullOrEmpty(status)) { parts.RemoveAll(p => p.StartsWith("status=")); parts.Add($"status={Uri.EscapeDataString(status)}"); }
        if (!string.IsNullOrEmpty(priority)) { parts.Add($"priority={Uri.EscapeDataString(priority)}"); }
        if (!string.IsNullOrEmpty(typeKey)) { parts.Add($"typeKey={Uri.EscapeDataString(typeKey)}"); }
        if (PartyId is { } party) { parts.Add($"partyId={party}"); }
        if (!string.IsNullOrWhiteSpace(RawFilter)) { parts.Add(RawFilter.Trim().TrimStart('&')); }
        if (grid.Sort != DefaultSort) { parts.Add($"sort={Uri.EscapeDataString(grid.Sort)}"); }
        return string.Join('&', parts);
    }

    private async Task LoadAsync(int pageNumber)
    {
        var result = await Api.GetAsync<PagedResult<TicketDto>>($"/api/support/tickets?{Query(pageNumber)}");
        page = result.Value;
        message = result.IsSuccess ? null : result.Error;
        summary = (await Api.GetAsync<TicketSummaryDto>("/api/support/summary")).Value;
    }

    private RenderFragment Cell(GridColumnDef column, TicketDto t) => @<td data-label="@column.Label" class="@(column.Key == "ticket" ? "primary" : null)">@CellContent(column.Key, t)</td>;

    private RenderFragment CellContent(string key, TicketDto t) => key switch
    {
        "ticket" => @<text>
            <a href="destek/talepler/@t.Id">@t.Subject</a>
            <small class="text-muted">@t.Number</small>
        </text>,
        "customer" => @<text>@(t.CustomerName ?? t.ReporterName ?? "—")@(t.PartyId is null ? " (tanımsız)" : null)</text>,
        "type" => @<text>@Lookups.Label(SupportLabels.TicketTypeList, t.TypeKey)</text>,
        "priority" => @<span class="badge stage-@SupportLabels.PriorityBadge(t.Priority)">@SupportLabels.Label(SupportLabels.Priorities, t.Priority)</span>,
        "status" => @<span class="badge stage-@SupportLabels.StatusBadge(t.Status)">@SupportLabels.Label(SupportLabels.Statuses, t.Status)</span>,
        "owner" => @<text>@(t.OwnerId is null ? "Atanmamış" : Lookups.MemberName(t.OwnerId))</text>,
        "age" => @<text>@Age(t.CreatedAt)</text>,
        "sla" => @<text>@SlaText(t)</text>,
        "activity" => @<text>@CrmLabels.Time(t.LastActivityAt)</text>,
        "reporter" => @<text>@t.ReporterName</text>,
        _ => @<text></text>,
    };

    /// <summary>Listedeki hedef anı kopyası (otorite SLA örneğidir): çalışan sayaç yoksa tire.</summary>
    private static string SlaText(TicketDto t) =>
        t.FirstResponseDueAt is null && t.ResolutionDueAt is null
            ? "—"
            : string.Join(" · ", new[] { t.FirstResponseDueAt is { } f ? "İlk yanıt " + CrmLabels.Time(f) : null, t.ResolutionDueAt is { } r ? "Çözüm " + CrmLabels.Time(r) : null }.Where(x => x is not null));

    private static string Age(DateTimeOffset createdAt)
    {
        var age = DateTimeOffset.UtcNow - createdAt;
        return age.TotalDays >= 1 ? $"{(int)age.TotalDays} gün" : age.TotalHours >= 1 ? $"{(int)age.TotalHours} sa" : $"{Math.Max(0, (int)age.TotalMinutes)} dk";
    }
}
