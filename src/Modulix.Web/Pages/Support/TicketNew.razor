@page "/destek/talepler/yeni"
@inject ApiClient Api
@inject SessionState Session
@inject CrmLookups Lookups
@inject NavigationManager Navigation

<PageTitle>Yeni talep · Modulix</PageTitle>

<AuthGate Module="@SupportAccess.ModuleKey" Permission="@SupportAccess.TicketsCreate">
    <div class="page-header">
        <div>
            <h1>Yeni talep</h1>
            <p class="text-muted mb-0">Destek talebi, şikâyet, bilgi talebi ya da hizmet isteği. Müşteri henüz tanımlı değilse başvuranın adını girin; müşteri kaydı açılmaz, talep sonradan mevcut firmaya bağlanır.</p>
        </div>
        <div class="header-actions">
            <a class="btn btn-outline-secondary" href="destek/talepler">Taleplere dön</a>
        </div>
    </div>

    <Notice Text="@message" Failed="true" />
    @if (duplicates is { Count: > 0 })
    {
        <div class="alert alert-warning" role="status">
            <strong>Olası mükerrer talep:</strong> aynı başvuranın benzer açık talepleri var. Yine de kaydedebilirsiniz; mükerrerse mevcut talepte devam etmeniz önerilir.
            <ul class="mb-0">
                @foreach (var d in duplicates)
                {
                    <li><a href="destek/talepler/@d.Id">@d.Number</a> · @d.Subject <small class="text-muted">(@SupportLabels.Label(SupportLabels.Statuses, d.Status) · @d.Reason · benzerlik %@((int)Math.Round(d.Score * 100)))</small></li>
                }
            </ul>
        </div>
    }

    <form class="record-form" novalidate @onsubmit="SaveAsync" @onsubmit:preventDefault>
        <fieldset disabled="@busy">
            <legend class="visually-hidden">Talep bilgileri</legend>
            <div class="form-grid">
                <div class="span-12">
                    <label class="form-label" for="f-subject">Konu (zorunlu)</label>
                    <input id="f-subject" class="form-control" maxlength="200" @bind="form.Subject" @bind:after="CheckDuplicatesAsync" aria-invalid="@(Has("subject") ? "true" : null)" aria-describedby="@(Has("subject") ? "e-subject" : null)" />
                    <FieldError Field="subject" Errors="errors" />
                </div>
                <div class="span-6">
                    <label class="form-label" for="f-type">Tür</label>
                    <select id="f-type" class="form-select" @bind="form.TypeKey">
                        @foreach (var t in Lookups.Choices(SupportLabels.TicketTypeList))
                        {
                            <option value="@t.Key">@t.Label</option>
                        }
                    </select>
                    <FieldError Field="typeKey" Errors="errors" />
                </div>
                <div class="span-6">
                    <label class="form-label" for="f-channel">Kanal</label>
                    <select id="f-channel" class="form-select" @bind="form.Channel">
                        @foreach (var (key, label) in SupportLabels.Channels)
                        {
                            <option value="@key">@label</option>
                        }
                    </select>
                </div>
                <div class="span-6">
                    <label class="form-label" for="f-party">Müşteri</label>
                    <LookupPicker Id="f-party" LookupKey="support.ticket.party" @bind-Value="form.PartyId" Placeholder="Müşteri ara…" Invalid="@Has("partyId")" />
                    <FieldError Field="partyId" Errors="errors" />
                </div>
                <div class="span-6">
                    <label class="form-label" for="f-person">İlgili kişi</label>
                    <LookupPicker Id="f-person" LookupKey="support.ticket.person" @bind-Value="form.PersonId" ParentId="form.PartyId" Placeholder="Kişi ara…" Invalid="@Has("personId")" />
                    <FieldError Field="personId" Errors="errors" />
                </div>
                @if (form.PartyId is null)
                {
                    <div class="span-12"><p class="small text-muted mb-0">Müşteri seçilmediği için başvuran bilgisi gerekir.</p></div>
                    <div class="span-4">
                        <label class="form-label" for="f-rname">Başvuran adı</label>
                        <input id="f-rname" class="form-control" maxlength="200" @bind="form.ReporterName" />
                        <FieldError Field="reporterName" Errors="errors" />
                    </div>
                    <div class="span-4">
                        <label class="form-label" for="f-remail">Başvuran e-postası</label>
                        <input id="f-remail" type="email" class="form-control" maxlength="254" @bind="form.ReporterEmail" />
                        <FieldError Field="reporterEmail" Errors="errors" />
                    </div>
                    <div class="span-4">
                        <label class="form-label" for="f-rphone">Başvuran telefonu</label>
                        <input id="f-rphone" class="form-control" maxlength="30" @bind="form.ReporterPhone" />
                    </div>
                }
                <div class="span-12">
                    <label class="form-label" for="f-category">Kategori</label>
                    <LookupPicker Id="f-category" LookupKey="support.ticket.category" @bind-Value="form.CategoryId" Placeholder="Kategori ara…" Invalid="@Has("categoryId")" />
                    <FieldError Field="categoryId" Errors="errors" />
                </div>
                <div class="span-4">
                    <label class="form-label" for="f-impact">Etki</label>
                    <select id="f-impact" class="form-select" @bind="form.Impact">
                        @foreach (var (key, label) in SupportLabels.Levels) { <option value="@key">@label</option> }
                    </select>
                </div>
                <div class="span-4">
                    <label class="form-label" for="f-urgency">Aciliyet</label>
                    <select id="f-urgency" class="form-select" @bind="form.Urgency">
                        @foreach (var (key, label) in SupportLabels.Levels) { <option value="@key">@label</option> }
                    </select>
                </div>
                <div class="span-4">
                    <span class="form-label d-block">Hesaplanan öncelik</span>
                    <span class="badge stage-@SupportLabels.PriorityBadge(Priority())">@SupportLabels.Label(SupportLabels.Priorities, Priority())</span>
                    <small class="text-muted d-block">Etki ve aciliyetten hesaplanır; sonradan yalnızca yetkili ve gerekçeli değiştirilebilir.</small>
                </div>
                <div class="span-12">
                    <label class="form-label" for="f-desc">Açıklama</label>
                    <textarea id="f-desc" class="form-control" rows="4" maxlength="4000" @bind="form.Description"></textarea>
                    <FieldError Field="description" Errors="errors" />
                </div>
                @if (IsComplaint)
                {
                    <div class="span-4">
                        <label class="form-label" for="f-event">Olay tarihi</label>
                        <input id="f-event" type="date" class="form-control" @bind="form.EventDate" />
                        <FieldError Field="eventDate" Errors="errors" />
                    </div>
                    <div class="span-8">
                        <label class="form-label" for="f-outcome">Beklenen sonuç</label>
                        <input id="f-outcome" class="form-control" maxlength="4000" @bind="form.ExpectedOutcome" />
                    </div>
                }
                @if (Session.Can(SupportAccess.TicketsAssign))
                {
                    <div class="span-6">
                        <label class="form-label" for="f-queue">Kuyruk</label>
                        <LookupPicker Id="f-queue" LookupKey="support.ticket.queue" @bind-Value="form.QueueId" Placeholder="Kategori / varsayılan kuyruk" />
                        <FieldError Field="queueId" Errors="errors" />
                    </div>
                    <div class="span-6">
                        <label class="form-label" for="f-owner">Sorumlu</label>
                        <LookupPicker Id="f-owner" LookupKey="support.ticket.owner" @bind-Value="form.OwnerId" Placeholder="Atanmamış kalsın" />
                        <FieldError Field="ownerId" Errors="errors" />
                    </div>
                }
            </div>
        </fieldset>
        <div class="form-actions">
            <button type="submit" class="btn btn-primary" disabled="@busy">Talebi oluştur</button>
        </div>
    </form>
</AuthGate>

@code {
    /// <summary>Müşteri kartından açılış: <c>?musteri={id}</c>; ilişkili talepten açılış: <c>?iliskili={id}</c>.</summary>
    [SupplyParameterFromQuery(Name = "musteri")] public Guid? InitialParty { get; set; }

    [SupplyParameterFromQuery(Name = "iliskili")] public Guid? InitialParent { get; set; }

    private readonly TicketForm form = new();
    private IReadOnlyDictionary<string, string[]>? errors;
    private string? message;
    private bool busy;
    private readonly string clientKey = Guid.NewGuid().ToString("N");

    private bool IsComplaint => Lookups.CategoryOf(SupportLabels.TicketTypeList, form.TypeKey) == SupportLabels.ComplaintCategory;

    private bool Has(string field) => errors?.ContainsKey(field) == true;

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (!Session.Can(SupportAccess.TicketsCreate)) { return; }
        await Lookups.LoadAsync();
        matrix = (await Api.GetAsync<List<PriorityCellDto>>("/api/support/priority-matrix")).Value ?? [];
        form.TypeKey = Lookups.DefaultOf(SupportLabels.TicketTypeList) ?? "Support";
        form.PartyId = InitialParty;
        form.ParentTicketId = InitialParent;
    }

    private List<PriorityCellDto> matrix = [];
    private List<TicketDuplicateDto>? duplicates;

    /// <summary>Tenant matrisinden (sunucu) hesaplanan öncelik; yalnızca gösterim, otorite sunucudur.</summary>
    private string Priority() => matrix.FirstOrDefault(c => c.Impact == form.Impact && c.Urgency == form.Urgency)?.Priority ?? "Normal";

    private async Task CheckDuplicatesAsync()
    {
        duplicates = null;
        if (string.IsNullOrWhiteSpace(form.Subject) || (form.PartyId is null && string.IsNullOrWhiteSpace(form.ReporterEmail) && string.IsNullOrWhiteSpace(form.ReporterPhone))) { return; }
        var query = new List<string> { $"subject={Uri.EscapeDataString(form.Subject)}" };
        if (form.PartyId is { } party) { query.Add($"partyId={party}"); }
        if (!string.IsNullOrWhiteSpace(form.ReporterEmail)) { query.Add($"reporterEmail={Uri.EscapeDataString(form.ReporterEmail.Trim())}"); }
        if (!string.IsNullOrWhiteSpace(form.ReporterPhone)) { query.Add($"reporterPhone={Uri.EscapeDataString(form.ReporterPhone.Trim())}"); }
        if (form.CategoryId is { } category) { query.Add($"categoryId={category}"); }
        duplicates = (await Api.GetAsync<List<TicketDuplicateDto>>($"/api/support/tickets/duplicates?{string.Join('&', query)}")).Value;
    }

    private async Task SaveAsync()
    {
        if (busy) { return; }
        busy = true;
        message = null;
        errors = null;

        // İstemci anahtarı çift tıklamayı korur: aynı form için ikinci gönderim yeni talep açmaz.
        var request = new SaveTicketRequest(
            Subject: form.Subject, Description: Blank(form.Description), TypeKey: form.TypeKey, Channel: form.Channel, PartyId: form.PartyId, PersonId: form.PersonId,
            ReporterName: form.PartyId is null ? Blank(form.ReporterName) : null, ReporterEmail: form.PartyId is null ? Blank(form.ReporterEmail) : null,
            ReporterPhone: form.PartyId is null ? Blank(form.ReporterPhone) : null, CategoryId: form.CategoryId, Impact: form.Impact, Urgency: form.Urgency,
            OwnerId: form.OwnerId, QueueId: form.QueueId, ParentTicketId: form.ParentTicketId, ClientKey: clientKey,
            EventDate: IsComplaint && form.EventDate is { } date ? DateOnly.FromDateTime(date) : null, ExpectedOutcome: IsComplaint ? Blank(form.ExpectedOutcome) : null);
        var result = await Api.PostAsync<TicketDto>("/api/support/tickets", request);
        busy = false;
        if (result.IsSuccess)
        {
            Navigation.NavigateTo($"destek/talepler/{result.Value!.Id}");
            return;
        }

        errors = result.FieldErrors;
        message = result.Error;
    }

    private static string? Blank(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private sealed class TicketForm
    {
        public string Subject { get; set; } = string.Empty;
        public string? Description { get; set; }
        public string TypeKey { get; set; } = "Support";
        public string Channel { get; set; } = "User";
        public Guid? PartyId { get; set; }
        public Guid? PersonId { get; set; }
        public string? ReporterName { get; set; }
        public string? ReporterEmail { get; set; }
        public string? ReporterPhone { get; set; }
        public Guid? CategoryId { get; set; }
        public string Impact { get; set; } = "Medium";
        public string Urgency { get; set; } = "Medium";
        public Guid? OwnerId { get; set; }
        public Guid? QueueId { get; set; }
        public Guid? ParentTicketId { get; set; }
        public DateTime? EventDate { get; set; }
        public string? ExpectedOutcome { get; set; }
    }
}
