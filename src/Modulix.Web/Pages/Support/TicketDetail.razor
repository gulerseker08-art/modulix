@page "/destek/talepler/{Id:guid}"
@inject ApiClient Api
@inject SessionState Session
@inject CrmLookups Lookups

<PageTitle>@(ticket is null ? Texts.Get("support.tickets.col.ticket") : ticket.Number) · Modulix</PageTitle>

<AuthGate Module="@SupportAccess.ModuleKey" Permission="@SupportAccess.TicketsRead">
    @if (notFound)
    {
        <div class="alert alert-warning" role="alert">@Texts.Get("support.detail.notFound") <a href="destek/talepler">@Texts.Get("support.backToTickets")</a></div>
    }
    else if (ticket is null)
    {
        <LoadingState />
    }
    else
    {
        <div class="page-header">
            <div>
                <h1>@ticket.Subject</h1>
                <p class="mb-0">
                    <span class="text-muted">@ticket.Number</span>
                    <span class="badge stage-@SupportLabels.StatusBadge(ticket.Status)">@SupportLabels.Label(SupportLabels.Statuses, ticket.Status)</span>
                    <span class="badge stage-@SupportLabels.PriorityBadge(ticket.Priority)">@(ticket.PriorityOverridden ? Texts.Get("support.detail.priorityManual", SupportLabels.Label(SupportLabels.Priorities, ticket.Priority)) : Texts.Get("support.detail.priority", SupportLabels.Label(SupportLabels.Priorities, ticket.Priority)))</span>
                    <span class="text-muted">· @Lookups.Label(SupportLabels.TicketTypeList, ticket.TypeKey)</span>
                </p>
                <p class="small text-muted mb-0">@Texts.Strong("support.detail.owner", ticket.OwnerId is null ? Texts.Get("support.unassigned") : Lookups.MemberName(ticket.OwnerId)) · @Texts.Get("support.detail.opened", CrmLabels.Time(ticket.CreatedAt), ticket.FirstResponseAt is { } first ? CrmLabels.Time(first) : Texts.Get("support.detail.notYet"))</p>
            </div>
            <div class="header-actions">
                <a class="btn btn-outline-secondary" href="destek/talepler">@Texts.Get("support.backToTickets")</a>
                @if (Session.Can(SupportAccess.TicketsCreate))
                {
                    <a class="btn btn-outline-secondary" href="@RelatedHref">@Texts.Get("support.detail.openRelated")</a>
                }
            </div>
        </div>

        <TicketActionsPanel Ticket="ticket" Changed="OnChangedAsync" />

        <TicketSlaPanel Ticket="ticket" Changed="OnChangedAsync" />

        <TicketTasksPanel Ticket="ticket" Changed="ReloadAsync" />

        <TicketMergePanel Ticket="ticket" />

        <TicketLinksPanel Ticket="ticket" Changed="ReloadAsync" />

        <TicketCorrectiveActionsPanel Ticket="ticket" />

        <TicketAttachmentsPanel Ticket="ticket" Messages="messages" />

        <TicketSurveyPanel Ticket="ticket" />

        <div class="detail-columns">
            <div>
                <section aria-labelledby="messages-title">
                    <h2 id="messages-title">@Texts.Get("support.detail.messages")</h2>
                    @if (messages is null)
                    {
                        <LoadingState />
                    }
                    else if (messages.Count == 0)
                    {
                        <EmptyState Compact="true" Title="@Texts.Get("support.detail.noMessages")" />
                    }
                    else
                    {
                        <ol class="timeline">
                            @foreach (var m in messages)
                            {
                                <li class="@(m.Visibility == "Internal" ? "timeline-internal" : null)">
                                    <strong>@Describe(m)</strong>
                                    <span class="text-muted small"> · @CrmLabels.Time(m.CreatedAt) · @(m.AuthorId is null ? Texts.Get("support.system") : Lookups.MemberName(m.AuthorId))</span>
                                    @if (m.Channel is { } channel) { <span class="badge stage-open">@SupportLabels.Label(SupportLabels.Channels, channel)</span> }
                                    @if (m.SourceTicketId is { } source) { <span class="badge stage-open">@Texts.Get("support.detail.fromMerged")</span> <a class="small" href="destek/talepler/@source">@Texts.Get("support.detail.sourceTicket")</a> }
                                    <div class="message-body">@m.Body</div>
                                    @if (SupportLabels.Delivery(m.DeliveryStatus) is { Length: > 0 } delivery) { <small class="text-muted">@delivery</small> }
                                </li>
                            }
                        </ol>
                    }

                    @if (CanWrite)
                    {
                        <form class="record-form" novalidate @onsubmit="SendAsync" @onsubmit:preventDefault>
                            <fieldset disabled="@sending">
                                <legend class="h6">@Texts.Get("support.detail.newMessage")</legend>
                                <div role="radiogroup" aria-label="@Texts.Get("support.detail.messageKind")" class="filters">
                                    @foreach (var (key, label) in KindsAllowed)
                                    {
                                        <label class="chip @(kind == key ? "active" : null)">
                                            <input type="radio" class="visually-hidden" name="msg-kind" value="@key" checked="@(kind == key)" @onchange="() => kind = key" />@label
                                        </label>
                                    }
                                </div>
                                @if (kind == "note")
                                {
                                    <p class="small text-muted mb-1">@Texts.Get("support.detail.noteHelp")</p>
                                }
                                else if (kind == "reply")
                                {
                                    <p class="small text-muted mb-1">@Texts.Get("support.detail.replyHelp")</p>
                                }
                                <label class="form-label visually-hidden" for="msg-body">@Texts.Get("support.detail.messageBody")</label>
                                <textarea id="msg-body" class="form-control" rows="3" maxlength="8000" @bind="body" aria-invalid="@(Has("body") ? "true" : null)"></textarea>
                                <FieldError Field="body" Errors="sendErrors" />
                            </fieldset>
                            <Notice Text="@sendMessage" Failed="true" />
                            <div class="form-actions">
                                <button type="submit" class="btn btn-primary" disabled="@sending">@Texts.Get("support.detail.send")</button>
                            </div>
                        </form>
                    }
                </section>

                <section aria-labelledby="history-title">
                    <h2 id="history-title">@Texts.Get("contracts.detail.tab.history")</h2>
                    @if (history is null)
                    {
                        <LoadingState />
                    }
                    else
                    {
                        <ol class="history-list">
                            @foreach (var h in history)
                            {
                                <li>
                                    <strong>@HistoryText(h.Kind)</strong>
                                    <span class="text-muted small"> · @CrmLabels.Time(h.At) · @(h.ActorId is null ? Texts.Get("support.system") : Lookups.MemberName(h.ActorId))</span>
                                    @if (h.FromStatus != h.ToStatus && h.ToStatus is not null) { <div class="small">@SupportLabels.Label(SupportLabels.Statuses, h.FromStatus) → @SupportLabels.Label(SupportLabels.Statuses, h.ToStatus)</div> }
                                    @if (h.FromOwnerId != h.ToOwnerId) { <div class="small">@Texts.Get("support.detail.ownerChange", h.FromOwnerId is null ? "—" : Lookups.MemberName(h.FromOwnerId), h.ToOwnerId is null ? Texts.Get("support.unassigned") : Lookups.MemberName(h.ToOwnerId))</div> }
                                    @if (!string.IsNullOrEmpty(h.Reason)) { <div class="small">@Texts.Get("support.detail.reason", h.Reason)</div> }
                                </li>
                            }
                        </ol>
                    }
                </section>
            </div>

            <aside aria-labelledby="info-title">
                <h2 id="info-title">@Texts.Get("support.detail.info")</h2>
                <dl class="detail-list">
                    <dt>@Texts.Get("support.tickets.col.customer")</dt>
                    <dd>
                        @if (ticket.PartyId is { } party)
                        {
                            @(ticket.CustomerName ?? "—")
                        }
                        else
                        {
                            <span>@(ticket.ReporterName ?? "—") <span class="badge stage-open">@Texts.Get("support.detail.customerUndefined")</span></span>
                        }
                    </dd>
                    @if (ticket.ReporterEmail is { Length: > 0 }) { <dt>@Texts.Get("support.reporterEmail")</dt><dd>@ticket.ReporterEmail</dd> }
                    @if (ticket.ReporterPhone is { Length: > 0 }) { <dt>@Texts.Get("support.reporterPhone")</dt><dd>@ticket.ReporterPhone</dd> }
                    <dt>@Texts.Get("crm.contactPoint.channel")</dt><dd>@SupportLabels.Label(SupportLabels.Channels, ticket.Channel)</dd>
                    <dt>@Texts.Get("support.detail.impactUrgency")</dt><dd>@SupportLabels.Label(SupportLabels.Levels, ticket.Impact) / @SupportLabels.Label(SupportLabels.Levels, ticket.Urgency)</dd>
                    @if (ticket.PriorityReason is { Length: > 0 }) { <dt>@Texts.Get("support.detail.priorityReason")</dt><dd>@ticket.PriorityReason</dd> }
                    @if (ticket.StatusReason is { Length: > 0 }) { <dt>@Texts.Get("support.detail.statusReason")</dt><dd>@ticket.StatusReason</dd> }
                    @if (ticket.ParentTicketId is { } parent) { <dt>@Texts.Get("support.detail.related")</dt><dd><a href="destek/talepler/@parent">@Texts.Get("support.detail.previous")</a></dd> }
                    @if (ticket.MergedIntoId is { } mergedInto) { <dt>@Texts.Get("support.status.merged")</dt><dd><a href="destek/talepler/@mergedInto">@Texts.Get("support.detail.target")</a></dd> }
                    @if (ticket.EventDate is { } eventDate) { <dt>@Texts.Get("support.eventDate")</dt><dd>@SupportLabels.Date(eventDate)</dd> }
                    @if (ticket.ExpectedOutcome is { Length: > 0 }) { <dt>@Texts.Get("support.expectedOutcome")</dt><dd>@ticket.ExpectedOutcome</dd> }
                    @if (ticket.Description is { Length: > 0 }) { <dt>@Texts.Get("common.field.description")</dt><dd class="message-body">@ticket.Description</dd> }
                </dl>

                @if (ticket.ResolutionCode is not null)
                {
                    <h3 class="h6">@Texts.Get("support.sla-metric.resolution")</h3>
                    <dl class="detail-list">
                        <dt>@Texts.Get("support.detail.code")</dt><dd>@Lookups.Label(SupportLabels.ResolutionCodeList, ticket.ResolutionCode)</dd>
                        <dt>@Texts.Get("common.field.description")</dt><dd class="message-body">@ticket.ResolutionNote</dd>
                        @if (ticket.RootCause is { Length: > 0 }) { <dt>@Texts.Get("support.rootCause")</dt><dd>@ticket.RootCause</dd> }
                        @if (ticket.CorrectiveAction is { Length: > 0 }) { <dt>@Texts.Get("support.correctiveAction")</dt><dd>@ticket.CorrectiveAction</dd> }
                        <dt>@Texts.Get("support.detail.resolvedBy")</dt><dd>@Lookups.MemberName(ticket.ResolvedBy) · @(ticket.ResolvedAt is { } at ? CrmLabels.Time(at) : "—")</dd>
                        @if (ticket.ReopenCount > 0) { <dt>@Texts.Get("support.detail.reopens")</dt><dd>@Texts.Get("support.detail.reopenCount", ticket.ReopenCount)</dd> }
                    </dl>
                }

                @if (Session.Can(SupportAccess.TicketsWrite) && ticket.PartyId is null && !TicketStatusFinal)
                {
                    <h3 class="h6">@Texts.Get("support.detail.linkCustomer")</h3>
                    <p class="small text-muted">@Texts.Get("support.detail.linkHelp")</p>
                    <label class="form-label" for="link-party">@Texts.Get("support.tickets.col.customer")</label>
                    <LookupPicker Id="link-party" LookupKey="support.ticket.party" @bind-Value="linkPartyId" Placeholder="@Texts.Get("support.searchCustomer")" />
                    <FieldError Field="partyId" Errors="linkErrors" />
                    <Notice Text="@linkMessage" Failed="true" />
                    <div class="form-actions"><button type="button" class="btn btn-outline-secondary" disabled="@(linkPartyId is null || sending)" @onclick="LinkAsync">@Texts.Get("crm.opp.link")</button></div>
                }
            </aside>
        </div>
    }
</AuthGate>

@code {
    [Parameter] public Guid Id { get; set; }

    private TicketDto? ticket;
    private List<TicketMessageDto>? messages;
    private List<TicketHistoryDto>? history;
    private bool notFound;
    private string kind = "reply";
    private string body = string.Empty;
    private bool sending;
    private string? sendMessage;
    private IReadOnlyDictionary<string, string[]>? sendErrors;
    private Guid? linkPartyId;
    private string? linkMessage;
    private IReadOnlyDictionary<string, string[]>? linkErrors;

    private string RelatedHref => ticket is null ? "destek/talepler/yeni" : ticket.PartyId is { } party ? $"destek/talepler/yeni?iliskili={ticket.Id}&musteri={party}" : $"destek/talepler/yeni?iliskili={ticket.Id}";

    private bool TicketStatusFinal => ticket is { Status: "Closed" or "Cancelled" };

    private bool CanWrite => ticket is not null && !TicketStatusFinal && (Session.Can(SupportAccess.MessagesReply) || Session.Can(SupportAccess.NotesWrite));

    private IEnumerable<(string Key, string Label)> KindsAllowed => SupportLabels.MessageKinds.Where(k =>
        k.Key == "note" ? Session.Can(SupportAccess.NotesWrite)
        : k.Key == "customer-confirmation" ? Session.Can(SupportAccess.MessagesReply) && ticket?.Status == "Resolved"
        : Session.Can(SupportAccess.MessagesReply));

    private bool Has(string field) => sendErrors?.ContainsKey(field) == true;

    protected override async Task OnParametersSetAsync()
    {
        await Session.EnsureLoadedAsync();
        if (!Session.Can(SupportAccess.TicketsRead)) { return; }
        await Lookups.LoadAsync();
        await ReloadAsync();
        kind = KindsAllowed.FirstOrDefault().Key ?? "reply";
    }

    private async Task ReloadAsync()
    {
        var result = await Api.GetAsync<TicketDto>($"/api/support/tickets/{Id}");
        notFound = !result.IsSuccess;
        ticket = result.Value;
        if (ticket is null) { return; }
        messages = (await Api.GetAsync<List<TicketMessageDto>>($"/api/support/tickets/{Id}/messages")).Value ?? [];
        history = (await Api.GetAsync<List<TicketHistoryDto>>($"/api/support/tickets/{Id}/history")).Value ?? [];
    }

    private async Task OnChangedAsync(TicketDto updated)
    {
        ticket = updated;
        messages = (await Api.GetAsync<List<TicketMessageDto>>($"/api/support/tickets/{Id}/messages")).Value ?? [];
        history = (await Api.GetAsync<List<TicketHistoryDto>>($"/api/support/tickets/{Id}/history")).Value ?? [];
    }

    private static string HistoryText(string kind) => SlaLabels.HistoryKind(kind) is var sla && sla != kind ? sla : SupportLabels.History(kind);

    private static string Describe(TicketMessageDto m) => m.Direction switch
    {
        "Outbound" => Texts.Get("support.message-kind.reply"),
        "Inbound" => Texts.Get("support.detail.inbound"),
        _ => Texts.Get("support.message-kind.note"),
    };

    private async Task SendAsync()
    {
        if (sending) { return; }
        sending = true;
        sendMessage = null;
        sendErrors = null;
        var result = await Api.PostAsync<TicketMessageDto>($"/api/support/tickets/{Id}/messages", new AddTicketMessageRequest(kind, body));
        sending = false;
        if (!result.IsSuccess)
        {
            sendMessage = result.Error;
            sendErrors = result.FieldErrors;
            return;
        }

        body = string.Empty;
        await ReloadAsync();
    }

    private async Task LinkAsync()
    {
        if (ticket is null || linkPartyId is null || sending) { return; }
        sending = true;
        linkMessage = null;
        linkErrors = null;
        var request = new SaveTicketRequest(
            ticket.Version, ticket.Subject, ticket.Description, ticket.TypeKey, ticket.Channel, linkPartyId, ticket.PersonId, ticket.ReporterName, ticket.ReporterEmail, ticket.ReporterPhone,
            ticket.CategoryId, ticket.Impact, ticket.Urgency, EventDate: ticket.EventDate, ExpectedOutcome: ticket.ExpectedOutcome);
        var result = await Api.PutAsync<TicketDto>($"/api/support/tickets/{Id}", request);
        sending = false;
        if (!result.IsSuccess)
        {
            linkMessage = result.Error;
            linkErrors = result.FieldErrors;
            return;
        }

        linkPartyId = null;
        await ReloadAsync();
    }
}
