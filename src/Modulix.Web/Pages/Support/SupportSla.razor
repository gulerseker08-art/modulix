    // ---- Takvim

    private void NewCalendar() { cal = CalForm.New(); calErrors = null; }

    private void EditCalendar(SlaCalendarDto c)
    {
        cal = CalForm.New();
        cal.Id = c.Id; cal.Version = c.Version; cal.Name = c.Name; cal.TimeZoneId = c.TimeZoneId; cal.AlwaysOpen = c.IsAlwaysOpen; cal.IsActive = c.IsActive;
        foreach (var day in cal.Days.Values) { day.Enabled = false; }
        foreach (var w in ParseWeekly(c.WeeklyHours))
        {
            if (cal.Days.TryGetValue(w.Day, out var row)) { row.Enabled = true; row.Start = TimeOnly.ParseExact(w.Start, "HH:mm", CultureInfo.InvariantCulture); row.End = TimeOnly.ParseExact(w.End, "HH:mm", CultureInfo.InvariantCulture); }
        }

        cal.HolidaysText = string.Join('\n', ParseHolidays(c.Holidays).Select(h => h.Window is { } win ? $"{h.Date}; {h.Name}; {win}" : $"{h.Date}; {h.Name}"));
        calErrors = null;
    }

    private async Task SaveCalendarAsync()
    {
        calErrors = null;
        var holidays = new List<object>();
        foreach (var line in cal.HolidaysText.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            var parts = line.Split(';', StringSplitOptions.TrimEntries);
            string? start = null, end = null;
            if (parts.Length > 2 && parts[2].Split('-', StringSplitOptions.TrimEntries) is { Length: 2 } window) { start = window[0]; end = window[1]; }
            holidays.Add(new { date = parts[0], name = parts.Length > 1 && parts[1].Length > 0 ? parts[1] : null, start, end });
        }

        var weekly = cal.Days.Where(d => d.Value.Enabled).Select(d => new { day = d.Key, start = d.Value.Start.ToString("HH:mm", CultureInfo.InvariantCulture), end = d.Value.End.ToString("HH:mm", CultureInfo.InvariantCulture) });
        var request = new SaveSlaCalendarRequest(
            cal.Id is null ? 0 : cal.Version, cal.Name, cal.TimeZoneId, cal.AlwaysOpen, cal.AlwaysOpen ? null : JsonSerializer.Serialize(weekly, Json),
            cal.AlwaysOpen || holidays.Count == 0 ? null : JsonSerializer.Serialize(holidays, Json), cal.IsActive);
        if (await RunAsync(() => cal.Id is null ? Api.PostAsync<SlaCalendarDto>("/api/support/sla-calendars", request) : Api.PutAsync<SlaCalendarDto>($"/api/support/sla-calendars/{cal.Id}", request),
                Texts.Get("support.sla.calendarSaved"), e => calErrors = e))
        {
            NewCalendar();
        }
    }

    private static IEnumerable<(int Day, string Start, string End)> ParseWeekly(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) { yield break; }
        using var doc = JsonDocument.Parse(json);
        foreach (var e in doc.RootElement.EnumerateArray())
        {
            yield return (e.GetProperty("day").GetInt32(), e.GetProperty("start").GetString() ?? "09:00", e.GetProperty("end").GetString() ?? "18:00");
        }
    }

    private static IEnumerable<(string Date, string Name, string? Window)> ParseHolidays(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) { yield break; }
        using var doc = JsonDocument.Parse(json);
        foreach (var e in doc.RootElement.EnumerateArray())
        {
            var start = e.TryGetProperty("start", out var s) && s.ValueKind == JsonValueKind.String ? s.GetString() : null;
            var end = e.TryGetProperty("end", out var en) && en.ValueKind == JsonValueKind.String ? en.GetString() : null;
            yield return (e.GetProperty("date").GetString() ?? string.Empty, e.TryGetProperty("name", out var n) && n.ValueKind == JsonValueKind.String ? n.GetString()! : string.Empty, start is not null && end is not null ? $"{start}-{end}" : null);
        }
    }

    private static string WeeklySummary(SlaCalendarDto c)
    {
        if (c.IsAlwaysOpen) { return "7/24"; }
        var groups = ParseWeekly(c.WeeklyHours).GroupBy(w => (w.Start, w.End)).Select(g => $"{string.Join(", ", g.Select(w => SlaLabels.ShortDay(w.Day)))} {g.Key.Start}-{g.Key.End}");
        return string.Join("; ", groups);
    }

    private static string HolidayCount(SlaCalendarDto c) => c.IsAlwaysOpen ? "—" : Texts.Get("support.reports.days", ParseHolidays(c.Holidays).Count());

    // ---- Politika

    private void NewPolicy() { pol = new PolForm(); polErrors = null; polTabs.Select("form-genel"); }

    private void EditPolicy(SlaPolicyDto p)
    {
        pol = new PolForm
        {
            Id = p.Id, Version = p.Version, Name = p.Name, Description = p.Description, IsActive = p.IsActive, IsDefault = p.IsDefault, Precedence = p.Precedence, TypeKey = p.TypeKey ?? string.Empty,
            CategoryId = p.CategoryId, Priority = p.Priority ?? string.Empty, PartyId = p.PartyId, FirstResponseMinutes = p.FirstResponseMinutes, ResolutionMinutes = p.ResolutionMinutes,
            CalendarId = p.CalendarId, PauseOnWaitingCustomer = p.PauseOnWaitingCustomer, PauseOnWaitingInternal = p.PauseOnWaitingInternal, ContractKey = p.ContractId?.ToString() ?? string.Empty,
        };
        if (!string.IsNullOrWhiteSpace(p.EscalationRules))
        {
            pol.Rules = JsonSerializer.Deserialize<List<RuleRow>>(p.EscalationRules, Json) ?? [];
        }

        polTabs.Select("form-genel");
        polErrors = null;
    }

    private void AddRule() => pol.Rules.Add(new RuleRow { Id = $"k{pol.Rules.Count + 1}", Metric = "Resolution", Percent = 75, Action = "NotifyOwner" });

    private async Task SavePolicyAsync()
    {
        polErrors = null;
        var rules = pol.Rules.Count == 0 ? null : JsonSerializer.Serialize(pol.Rules.Select(r => new { id = r.Id, metric = r.Metric, percent = r.Percent, action = r.Action, userId = r.Action is "NotifyUser" or "Reassign" ? r.UserId : null, queueId = r.Action == "Reassign" ? r.QueueId : null }), Json);
        var request = new SaveSlaPolicyRequest(
            pol.Id is null ? 0 : pol.Version, pol.Name, string.IsNullOrWhiteSpace(pol.Description) ? null : pol.Description.Trim(), pol.IsActive, pol.IsDefault, pol.Precedence,
            pol.IsDefault || pol.TypeKey.Length == 0 ? null : pol.TypeKey, pol.IsDefault ? null : pol.CategoryId, pol.IsDefault || pol.Priority.Length == 0 ? null : pol.Priority, pol.IsDefault ? null : pol.PartyId,
            pol.FirstResponseMinutes, pol.ResolutionMinutes, pol.CalendarId, pol.PauseOnWaitingCustomer, pol.PauseOnWaitingInternal, rules,
            pol.IsDefault || !Guid.TryParse(pol.ContractKey, out var contractId) ? null : contractId);
        if (await RunAsync(() => pol.Id is null ? Api.PostAsync<SlaPolicyDto>("/api/support/sla-policies", request) : Api.PutAsync<SlaPolicyDto>($"/api/support/sla-policies/{pol.Id}", request),
                Texts.Get("support.sla.policySaved"), e => polErrors = e))
        {
            NewPolicy();
            return;
        }

        polTabs.RevealFirstFailing(PolicyTabs);
    }

    private static string Constraints(SlaPolicyDto p)
    {
        var parts = new List<string>();
        if (p.TypeKey is not null) { parts.Add(Texts.Get("support.routing.cond.type", p.TypeKey)); }
        if (p.Priority is not null) { parts.Add(Texts.Get("support.routing.cond.priority", SupportLabels.Label(SupportLabels.Priorities, p.Priority))); }
        if (p.CategoryId is not null) { parts.Add(Texts.Get("support.routing.cond.category")); }
        if (p.PartyId is not null) { parts.Add(Texts.Get("support.routing.cond.customer")); }
        if (p.ContractId is not null) { parts.Add(Texts.Get("support.sla.cond.contract")); }
        return parts.Count == 0 ? (p.IsDefault ? Texts.Get("support.sla.cond.fallback") : Texts.Get("support.sla.cond.none")) : string.Join(", ", parts);
    }

    private static string Targets(SlaPolicyDto p) =>
        string.Join(" · ", new[] { p.FirstResponseMinutes is { } f ? Texts.Get("support.sla.targetFirst", SlaLabels.Duration(f)) : null, p.ResolutionMinutes is { } r ? Texts.Get("support.sla.targetResolution", SlaLabels.Duration(r)) : null }.Where(x => x is not null));

    // ---- Önizleme

    private async Task PreviewAsync()
    {
        pvErrors = null;
        preview = null;
        busy = true;
        var request = new SlaPreviewRequest(pv.TypeKey, pv.Priority, pv.CategoryId, pv.PartyId, pv.StartAt is { } at ? new DateTimeOffset(at) : null);
        var result = await Api.PostAsync<SlaPreviewDto>("/api/support/sla/preview", request);
        busy = false;
        failed = !result.IsSuccess;
        message = result.IsSuccess ? null : result.Error;
        pvErrors = result.FieldErrors;
        preview = result.Value;
    }

    private async Task<bool> RunAsync<T>(Func<Task<ApiResult<T>>> call, string done, Action<IReadOnlyDictionary<string, string[]>>? errors = null)
    {
        busy = true;
        message = null;
        var result = await call();
        busy = false;
        failed = !result.IsSuccess;
        message = result.IsSuccess ? done : result.Error;
        if (!result.IsSuccess) { errors?.Invoke(result.FieldErrors); return false; }
        await ReloadAsync();
        return true;
    }

