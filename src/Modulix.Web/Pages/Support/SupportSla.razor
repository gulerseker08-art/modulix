@page "/destek/sla"
@using System.Globalization
@using System.Text.Json
@inject ApiClient Api
@inject SessionState Session
@inject CrmLookups Lookups

<PageTitle>@Texts.Get("support.sla.pageTitle") · Modulix</PageTitle>

<AuthGate Module="@SupportAccess.ModuleKey" Permission="@SupportAccess.SlaManage">
    <div class="page-header">
        <div>
            <h1>@Texts.Get("nav.app.support.sla")</h1>
            <p class="text-muted mb-0">@Texts.Strong("support.sla.intro", Texts.Get("support.sla.introNotChange"))</p>
        </div>
        <div class="header-actions"><a class="btn btn-outline-secondary" href="destek/ayarlar">@Texts.Get("nav.app.support.settings")</a></div>
    </div>

    <Notice Text="@message" Failed="@failed" />

    <section aria-labelledby="cal-title">
        <h2 id="cal-title">@Texts.Get("support.sla.calendars")</h2>
        @if (calendars is null) { <LoadingState Kind="LoadingKind.Table" /> }
        else if (calendars.Count == 0) { <p class="text-muted">@Texts.Get("support.sla.noCalendars")</p> }
        else
        {
            <table class="table record-table">
                <caption class="visually-hidden">@Texts.Get("support.sla.calendars")</caption>
                <thead><tr><th scope="col">@Texts.Get("support.sla.calendar")</th><th scope="col">@Texts.Get("support.sla.timeZone")</th><th scope="col">@Texts.Get("support.sla.workingHours")</th><th scope="col">@Texts.Get("support.sla.holiday")</th><th scope="col">@Texts.Get("common.field.status")</th><th scope="col">@Texts.Get("crm.quoteApprovals.col.action")</th></tr></thead>
                <tbody>
                    @foreach (var c in calendars)
                    {
                        <tr>
                            <td data-label="@Texts.Get("support.sla.calendar")" class="primary">@c.Name</td>
                            <td data-label="@Texts.Get("support.sla.timeZone")">@(c.IsAlwaysOpen ? "7/24" : c.TimeZoneId)</td>
                            <td data-label="@Texts.Get("support.sla.workingHours")">@WeeklySummary(c)</td>
                            <td data-label="@Texts.Get("support.sla.holiday")">@HolidayCount(c)</td>
                            <td data-label="@Texts.Get("common.field.status")"><span class="badge stage-@(c.IsActive ? "won" : "cancelled")">@(c.IsActive ? Texts.Get("support.settings.enabled") : Texts.Get("common.inactive"))</span></td>
                            <td data-label="@Texts.Get("crm.quoteApprovals.col.action")"><button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => EditCalendar(c)" disabled="@busy">@Texts.Get("common.edit")</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <form class="record-form" novalidate @onsubmit="SaveCalendarAsync" @onsubmit:preventDefault>
            <fieldset disabled="@busy">
                <legend class="h6">@(cal.Id is null ? Texts.Get("support.sla.newCalendar") : Texts.Get("support.sla.editCalendar"))</legend>
                <FormTabs Title="@Texts.Get("support.sla.calendarInfo")" Label="@Texts.Get("support.sla.calendarSections")">
                <div class="form-grid">
                    <div class="span-6">
                        <label class="form-label" for="cal-name">@Texts.Get("common.field.name")</label>
                        <input id="cal-name" class="form-control" maxlength="100" @bind="cal.Name" />
                        <FieldError Field="name" Errors="calErrors" />
                    </div>
                    <div class="span-6">
                        <label class="form-label" for="cal-zone">@Texts.Get("support.sla.timeZone")</label>
                        <input id="cal-zone" class="form-control" list="zones" maxlength="64" @bind="cal.TimeZoneId" />
                        <datalist id="zones"><option value="Europe/Istanbul"></option><option value="UTC"></option><option value="Europe/Berlin"></option><option value="Europe/London"></option></datalist>
                        <FieldError Field="timeZoneId" Errors="calErrors" />
                    </div>
                    <div class="span-12 form-check">
                        <input id="cal-always" class="form-check-input" type="checkbox" @bind="cal.AlwaysOpen" />
                        <label class="form-check-label" for="cal-always">@Texts.Get("support.sla.alwaysOpen")</label>
                    </div>
                    @if (!cal.AlwaysOpen)
                    {
                        <div class="span-12">
                            <span class="form-label d-block">@Texts.Get("support.sla.workingHoursHelp")</span>
                            @foreach (var (day, label) in SlaLabels.Days)
                            {
                                var row = cal.Days[day];
                                <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                                    <div class="form-check" style="min-width:9rem">
                                        <input id="day-@day" class="form-check-input" type="checkbox" @bind="row.Enabled" />
                                        <label class="form-check-label" for="day-@day">@label</label>
                                    </div>
                                    <label class="visually-hidden" for="day-start-@day">@Texts.Get("support.sla.dayStart", label)</label>
                                    <input id="day-start-@day" type="time" class="form-control form-control-sm" style="max-width:8rem" @bind="row.Start" disabled="@(!row.Enabled)" />
                                    <span aria-hidden="true">–</span>
                                    <label class="visually-hidden" for="day-end-@day">@Texts.Get("support.sla.dayEnd", label)</label>
                                    <input id="day-end-@day" type="time" class="form-control form-control-sm" style="max-width:8rem" @bind="row.End" disabled="@(!row.Enabled)" />
                                </div>
                            }
                            <FieldError Field="weeklyHours" Errors="calErrors" />
                        </div>
                        <div class="span-12">
                            <label class="form-label" for="cal-holidays">@Texts.Get("support.sla.holidays")</label>
                            <textarea id="cal-holidays" class="form-control" rows="4" @bind="cal.HolidaysText" placeholder="2026-10-29; Cumhuriyet Bayramı&#10;2026-10-28; Arife; 09:00-13:00"></textarea>
                            <small class="text-muted">@((MarkupString)Texts.Get("support.sla.holidayFormat", $"<code>{System.Net.WebUtility.HtmlEncode(Texts.Get("support.sla.holidayFormatDay"))}</code>", $"<code>{System.Net.WebUtility.HtmlEncode(Texts.Get("support.sla.holidayFormatWindow"))}</code>"))</small>
                            <FieldError Field="holidays" Errors="calErrors" />
                        </div>
                    }
                    <div class="span-12 form-check">
                        <input id="cal-active" class="form-check-input" type="checkbox" @bind="cal.IsActive" />
                        <label class="form-check-label" for="cal-active">@Texts.Get("support.settings.enabled")</label>
                    </div>
                </div>
                </FormTabs>
            </fieldset>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary" disabled="@busy">@(cal.Id is null ? Texts.Get("support.sla.addCalendar") : Texts.Get("common.save"))</button>
                @if (cal.Id is not null) { <button type="button" class="btn btn-outline-secondary" @onclick="NewCalendar">@Texts.Get("common.dismiss")</button> }
            </div>
        </form>
    </section>

    <section aria-labelledby="pol-title">
        <h2 id="pol-title">@Texts.Get("support.sla.policies")</h2>
        @if (policies is null) { <LoadingState Kind="LoadingKind.Table" /> }
        else if (policies.Count == 0) { <p class="text-muted">@Texts.Get("support.sla.noPolicies")</p> }
        else
        {
            <table class="table record-table">
                <caption class="visually-hidden">@Texts.Get("support.sla.policies")</caption>
                <thead><tr><th scope="col">@Texts.Get("support.slaPanel.policy")</th><th scope="col">@Texts.Get("support.routing.col.constraints")</th><th scope="col">@Texts.Get("support.sla.targets")</th><th scope="col">@Texts.Get("support.sla.calendar")</th><th scope="col">@Texts.Get("contracts.signaturePanel.order")</th><th scope="col">@Texts.Get("common.field.status")</th><th scope="col">@Texts.Get("crm.quoteApprovals.col.action")</th></tr></thead>
                <tbody>
                    @foreach (var p in policies)
                    {
                        <tr>
                            <td data-label="@Texts.Get("support.slaPanel.policy")" class="primary">@p.Name <small class="text-muted">@(p.IsDefault ? Texts.Get("support.sla.revisionDefault", p.Revision) : Texts.Get("support.sla.revision", p.Revision))</small></td>
                            <td data-label="@Texts.Get("support.routing.col.constraints")">@Constraints(p)</td>
                            <td data-label="@Texts.Get("support.sla.targets")">@Targets(p)</td>
                            <td data-label="@Texts.Get("support.sla.calendar")">@(p.CalendarId is { } id ? calendars?.FirstOrDefault(c => c.Id == id)?.Name ?? "—" : "7/24")</td>
                            <td data-label="@Texts.Get("contracts.signaturePanel.order")">@p.Precedence</td>
                            <td data-label="@Texts.Get("common.field.status")"><span class="badge stage-@(p.IsActive ? "won" : "cancelled")">@(p.IsActive ? Texts.Get("support.settings.enabled") : Texts.Get("common.inactive"))</span></td>
                            <td data-label="@Texts.Get("crm.quoteApprovals.col.action")"><button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => EditPolicy(p)" disabled="@busy">@Texts.Get("common.edit")</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <form class="record-form" novalidate @onsubmit="SavePolicyAsync" @onsubmit:preventDefault>
            <TabBar Tabs="PolicyTabs" State="polTabs" Label="@Texts.Get("support.sla.policySections")" />
            <fieldset disabled="@busy">
                <legend class="h6">@(pol.Id is null ? Texts.Get("support.sla.newPolicy") : Texts.Get("support.sla.editPolicy"))</legend>
                <TabPanel State="polTabs" Key="form-genel">
                <div class="form-grid">
                    <div class="span-6">
                        <label class="form-label" for="pol-name">@Texts.Get("common.field.name")</label>
                        <input id="pol-name" class="form-control" maxlength="100" @bind="pol.Name" />
                        <FieldError Field="name" Errors="polErrors" />
                    </div>
                    <div class="span-3">
                        <label class="form-label" for="pol-prec">@Texts.Get("support.sla.precedence")</label>
                        <input id="pol-prec" type="number" min="0" max="1000" class="form-control" @bind="pol.Precedence" />
                        <FieldError Field="precedence" Errors="polErrors" />
                    </div>
                    <div class="span-3 form-check align-self-end">
                        <input id="pol-active" class="form-check-input" type="checkbox" @bind="pol.IsActive" />
                        <label class="form-check-label" for="pol-active">@Texts.Get("support.settings.enabled")</label>
                    </div>
                    <div class="span-12"><label class="form-label" for="pol-desc">@Texts.Get("common.field.description")</label><input id="pol-desc" class="form-control" maxlength="500" @bind="pol.Description" /></div>
                </div>
                </TabPanel>
                <TabPanel State="polTabs" Key="form-kapsam">
                <div class="form-grid">
                    <div class="span-12 form-check">
                        <input id="pol-default" class="form-check-input" type="checkbox" @bind="pol.IsDefault" />
                        <label class="form-check-label" for="pol-default">@Texts.Get("support.sla.defaultHelp")</label>
                        <FieldError Field="isDefault" Errors="polErrors" />
                    </div>
                    @if (!pol.IsDefault)
                    {
                        <div class="span-3">
                            <label class="form-label" for="pol-type">@Texts.Get("common.field.kind")</label>
                            <select id="pol-type" class="form-select" @bind="pol.TypeKey">
                                <option value="">@Texts.Get("support.all")</option>
                                @foreach (var t in Lookups.Choices(SupportLabels.TicketTypeList)) { <option value="@t.Key">@t.Label</option> }
                            </select>
                        </div>
                        <div class="span-3">
                            <label class="form-label" for="pol-priority">@Texts.Get("crm.leads.col.priority")</label>
                            <select id="pol-priority" class="form-select" @bind="pol.Priority">
                                <option value="">@Texts.Get("support.all")</option>
                                @foreach (var (key, label) in SupportLabels.Priorities) { <option value="@key">@label</option> }
                            </select>
                        </div>
                        <div class="span-3">
                            <label class="form-label" for="pol-category">@Texts.Get("crm.products.field.category")</label>
                            <LookupPicker Id="pol-category" LookupKey="support.sla-policy.category" @bind-Value="pol.CategoryId" Placeholder="@Texts.Get("support.all")" />
                        </div>
                        <div class="span-3">
                            <label class="form-label" for="pol-party">@Texts.Get("support.tickets.col.customer")</label>
                            <LookupPicker Id="pol-party" LookupKey="support.sla-policy.party" @bind-Value="pol.PartyId" Placeholder="@Texts.Get("support.all")" />
                        </div>
                        @if (contracts is not null)
                        {
                            <div class="span-3">
                                <label class="form-label" for="pol-contract">@Texts.Get("support.linksPanel.kind.contract")</label>
                                <select id="pol-contract" class="form-select" @bind="pol.ContractKey">
                                    <option value="">@Texts.Get("support.all")</option>
                                    @foreach (var c in contracts.Where(c => pol.PartyId is null || c.PartyId == pol.PartyId)) { <option value="@c.Id">@c.Number · @c.Title</option> }
                                </select>
                                <div class="form-text">@Texts.Get("support.sla.contractHelp")</div>
                            </div>
                        }
                    }
                </div>
                </TabPanel>
                <TabPanel State="polTabs" Key="form-hedef">
                <div class="form-grid">
                    <div class="span-3">
                        <label class="form-label" for="pol-fr">@Texts.Get("support.sla.firstResponseTarget")</label>
                        <input id="pol-fr" type="number" min="1" max="525600" class="form-control" @bind="pol.FirstResponseMinutes" />
                        <FieldError Field="firstResponseMinutes" Errors="polErrors" />
                    </div>
                    <div class="span-3">
                        <label class="form-label" for="pol-res">@Texts.Get("support.sla.resolutionTarget")</label>
                        <input id="pol-res" type="number" min="1" max="525600" class="form-control" @bind="pol.ResolutionMinutes" />
                        <FieldError Field="resolutionMinutes" Errors="polErrors" />
                    </div>
                    <div class="span-6">
                        <label class="form-label" for="pol-cal">@Texts.Get("support.sla.calendar")</label>
                        <LookupPicker Id="pol-cal" LookupKey="support.sla-policy.calendar" @bind-Value="pol.CalendarId" Placeholder="@Texts.Get("support.sla.noCalendar")" />
                        <FieldError Field="calendarId" Errors="polErrors" />
                    </div>
                    <div class="span-6 form-check">
                        <input id="pol-pc" class="form-check-input" type="checkbox" @bind="pol.PauseOnWaitingCustomer" />
                        <label class="form-check-label" for="pol-pc">@Texts.Get("support.sla.pauseCustomer")</label>
                    </div>
                    <div class="span-6 form-check">
                        <input id="pol-pi" class="form-check-input" type="checkbox" @bind="pol.PauseOnWaitingInternal" />
                        <label class="form-check-label" for="pol-pi">@Texts.Get("support.sla.pauseInternal")</label>
                    </div>

                    <div class="span-12">
                        <span class="form-label d-block">@Texts.Get("support.sla.escalationRules") <small class="text-muted">@Texts.Get("support.sla.escalationHelp")</small></span>
                        @for (var i = 0; i < pol.Rules.Count; i++)
                        {
                            var rule = pol.Rules[i];
                            var index = i;
                            <div class="border rounded p-2 mb-2">
                                <div class="d-flex flex-wrap gap-2 align-items-end">
                                    <div>
                                        <label class="form-label small" for="r-id-@index">@Texts.Get("support.sla.ruleId")</label>
                                        <input id="r-id-@index" class="form-control form-control-sm" style="max-width:8rem" maxlength="20" @bind="rule.Id" />
                                    </div>
                                    <div>
                                        <label class="form-label small" for="r-metric-@index">@Texts.Get("support.reports.col.metric")</label>
                                        <select id="r-metric-@index" class="form-select form-select-sm" @bind="rule.Metric">
                                            @foreach (var (key, label) in SlaLabels.Metrics) { <option value="@key">@label</option> }
                                        </select>
                                    </div>
                                    <div>
                                        <label class="form-label small" for="r-pct-@index">@Texts.Get("support.sla.percent")</label>
                                        <input id="r-pct-@index" type="number" min="1" max="500" class="form-control form-control-sm" style="max-width:6rem" @bind="rule.Percent" />
                                    </div>
                                    <div>
                                        <label class="form-label small" for="r-action-@index">@Texts.Get("support.routing.col.action")</label>
                                        <select id="r-action-@index" class="form-select form-select-sm" @bind="rule.Action">
                                            @foreach (var (key, label) in SlaLabels.Actions) { <option value="@key">@label</option> }
                                        </select>
                                    </div>
                                    @if (rule.Action is "NotifyUser" or "Reassign")
                                    {
                                        <div>
                                            <label class="form-label small" for="r-user-@index">@Texts.Get("support.sla.user")</label>
                                            <LookupPicker Id="@($"r-user-{index}")" LookupKey="support.ticket.owner" @bind-Value="rule.UserId" Placeholder="@Texts.Get("support.sla.chooseUser")" />
                                        </div>
                                    }
                                    @if (rule.Action == "Reassign")
                                    {
                                        <div>
                                            <label class="form-label small" for="r-queue-@index">@Texts.Get("support.queue")</label>
                                            <LookupPicker Id="@($"r-queue-{index}")" LookupKey="support.ticket.queue" @bind-Value="rule.QueueId" Placeholder="@Texts.Get("support.actionsPanel.chooseQueue")" />
                                        </div>
                                    }
                                    <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => pol.Rules.RemoveAt(index)">@Texts.Get("support.sla.removeRule")</button>
                                </div>
                            </div>
                        }
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="AddRule">@Texts.Get("support.routing.addRule")</button>
                        <FieldError Field="escalationRules" Errors="polErrors" />
                    </div>
                </div>
                </TabPanel>
            </fieldset>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary" disabled="@busy">@(pol.Id is null ? Texts.Get("support.sla.addPolicy") : Texts.Get("common.save"))</button>
                @if (pol.Id is not null) { <button type="button" class="btn btn-outline-secondary" @onclick="NewPolicy">@Texts.Get("common.dismiss")</button> }
            </div>
        </form>
    </section>

    <section aria-labelledby="prev-title">
        <h2 id="prev-title">@Texts.Get("support.sla.preview")</h2>
        <p class="small text-muted">@Texts.Get("support.sla.previewHelp")</p>
        <form class="record-form" novalidate @onsubmit="PreviewAsync" @onsubmit:preventDefault>
            <div class="form-grid">
                <div class="span-3">
                    <label class="form-label" for="pv-type">@Texts.Get("common.field.kind")</label>
                    <select id="pv-type" class="form-select" @bind="pv.TypeKey">
                        @foreach (var t in Lookups.Choices(SupportLabels.TicketTypeList)) { <option value="@t.Key">@t.Label</option> }
                    </select>
                </div>
                <div class="span-3">
                    <label class="form-label" for="pv-priority">@Texts.Get("crm.leads.col.priority")</label>
                    <select id="pv-priority" class="form-select" @bind="pv.Priority">
                        @foreach (var (key, label) in SupportLabels.Priorities) { <option value="@key">@label</option> }
                    </select>
                </div>
                <div class="span-3">
                    <label class="form-label" for="pv-category">@Texts.Get("crm.products.field.category")</label>
                    <LookupPicker Id="pv-category" LookupKey="support.sla-policy.category" @bind-Value="pv.CategoryId" Placeholder="@Texts.Get("support.routing.noCategory")" />
                </div>
                <div class="span-3">
                    <label class="form-label" for="pv-party">@Texts.Get("support.tickets.col.customer")</label>
                    <LookupPicker Id="pv-party" LookupKey="support.sla-policy.party" @bind-Value="pv.PartyId" Placeholder="@Texts.Get("support.routing.noCustomer")" />
                </div>
                <div class="span-4">
                    <label class="form-label" for="pv-start">@Texts.Get("support.sla.startAt")</label>
                    <input id="pv-start" type="datetime-local" class="form-control" @bind="pv.StartAt" />
                </div>
            </div>
            <div class="form-actions"><button type="submit" class="btn btn-outline-secondary" disabled="@busy">@Texts.Get("support.sla.previewButton")</button></div>
            <FieldError Field="typeKey" Errors="pvErrors" />
        </form>
        @if (preview is not null)
        {
            @if (!preview.Matched)
            {
                <div class="alert alert-warning" role="status">@Texts.Strong("support.sla.noMatch", Texts.Get("support.slaPanel.noTarget"))</div>
            }
            else
            {
                <div class="alert alert-info" role="status">
                    @Texts.Strong("support.sla.selectedPolicy", preview.PolicyName) @Texts.Get("support.sla.revisionParen", preview.PolicyRevision) · @(preview.AlwaysOpen ? "7/24" : preview.CalendarName) ·
                    @Texts.Get("support.sla.pauseSummary", preview.PauseOnWaitingCustomer ? Texts.Get("support.sla.pauses") : Texts.Get("support.sla.noPause"), preview.PauseOnWaitingInternal ? Texts.Get("support.sla.pauses") : Texts.Get("support.sla.noPause"))
                    <ul class="mb-0">
                        @foreach (var m in preview.Metrics)
                        {
                            <li>@SlaLabels.Label(SlaLabels.Metrics, m.Metric): @Texts.Get("support.sla.targetWork", SlaLabels.Duration(m.TargetMinutes)) → <strong>@CrmLabels.Time(m.DueAt)</strong>@(m.WarningAt is { } w ? " " + Texts.Get("support.sla.firstWarning", CrmLabels.Time(w)) : null)</li>
                        }
                        @foreach (var r in preview.Rules)
                        {
                            <li>@Texts.Get("support.sla.escalationLine", r.Id, SlaLabels.Label(SlaLabels.Metrics, r.Metric), Texts.Get("support.percent", r.Percent), SlaLabels.Label(SlaLabels.Actions, r.Action))</li>
                        }
                    </ul>
                </div>
            }
        }
    </section>
</AuthGate>

@code {
    private static readonly JsonSerializerOptions Json = new(JsonSerializerDefaults.Web);

    private List<SlaCalendarDto>? calendars;
    private List<SlaPolicyDto>? policies;
    private List<ContractDto>? contracts;
    private string? message;
    private bool failed;
    private bool busy;
    private CalForm cal = CalForm.New();
    private PolForm pol = new();
    private PreviewForm pv = new();
    private SlaPreviewDto? preview;
    private IReadOnlyDictionary<string, string[]>? calErrors;
    private IReadOnlyDictionary<string, string[]>? polErrors;

    // Her kayıt formu sekmelidir; hatalı alan içeren sekme "!" rozeti taşır, kayıt denemesinden sonra hatalı ilk sekme açılır.
    private readonly TabState polTabs = new("form-genel");

    private int PolErrorCount(params string[] fields) => polErrors is null ? 0 : fields.Count(polErrors.ContainsKey);

    private IReadOnlyList<TabItem> PolicyTabs =>
    [
        new("form-genel", Texts.Get("support.sla.tab.general"), Errors: PolErrorCount("name", "precedence")),
        new("form-kapsam", Texts.Get("support.sla.tab.scope"), Errors: PolErrorCount("isDefault", "typeKey", "priority", "categoryId", "partyId", "contractId")),
        new("form-hedef", Texts.Get("support.sla.tab.targets"), Errors: PolErrorCount("firstResponseMinutes", "resolutionMinutes", "calendarId", "escalationRules")),
    ];
    private IReadOnlyDictionary<string, string[]>? pvErrors;

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (!Session.Can(SupportAccess.SlaManage)) { return; }
        await Lookups.LoadAsync();
        pv.TypeKey = Lookups.DefaultOf(SupportLabels.TicketTypeList) ?? "Support";
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        calendars = (await Api.GetAsync<PagedResult<SlaCalendarDto>>("/api/support/sla-calendars?pageSize=200")).Value?.Items.ToList() ?? [];
        policies = (await Api.GetAsync<PagedResult<SlaPolicyDto>>("/api/support/sla-policies?pageSize=200")).Value?.Items.ToList() ?? [];
        // Sözleşme kısıtı yalnızca sözleşme modülü açık ve okuma izni olan yöneticide sunulur (liste sunucuda yetkiyle süzülür).
        contracts = Session.IsModuleEnabled(ContractsAccess.ModuleKey) && Session.Can(ContractsAccess.ContractsRead)
            ? (await Api.GetAsync<PagedResult<ContractDto>>("/api/contracts/contracts?pageSize=100")).Value?.Items.ToList()
            : null;
