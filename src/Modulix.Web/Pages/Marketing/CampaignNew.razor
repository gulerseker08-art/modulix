@page "/pazarlama/kampanyalar/yeni"
@inject ApiClient Api
@inject SessionState Session
@inject NavigationManager Navigation

<PageTitle>@Texts.Get("marketing.campaigns.new") · Modulix</PageTitle>

<AuthGate Module="@MarketingAccess.ModuleKey" Permission="@MarketingAccess.CampaignsWrite">
    <div class="page-header">
        <div>
            <h1>@Texts.Get("marketing.campaigns.new")</h1>
            <p class="text-muted mb-0">@Texts.Get("marketing.campaignNew.intro")</p>
        </div>
        <div class="header-actions"><a class="btn btn-outline-secondary" href="pazarlama/kampanyalar">@Texts.Get("crm.quoteDetail.backToList")</a></div>
    </div>

    <Notice Text="@message" Failed="true" />
    <ErrorSummary Errors="@errors" />

    <form class="record-form" novalidate @onsubmit="SaveAsync" @onsubmit:preventDefault>
        <TabBar Tabs="FormTabs" State="tabs" Label="@Texts.Get("marketing.campaignNew.formSections")" />
        <fieldset disabled="@busy">
            <TabPanel State="tabs" Key="form-genel">
                <div class="form-grid">
                    <div class="span-6">
                        <label class="form-label" for="k-name">@Texts.Get("common.field.name")</label>
                        <input id="k-name" class="form-control" maxlength="150" @bind="name" />
                        <FieldError Field="name" Errors="errors" />
                    </div>
                    <div class="span-6">
                        <label class="form-label" for="k-code">@Texts.Get("marketing.code")</label>
                        <input id="k-code" class="form-control" maxlength="40" placeholder="antrepo-2026" aria-describedby="k-code-help" @bind="code" />
                        <small id="k-code-help" class="text-muted">@Texts.Get("marketing.codeHelp")</small>
                        <FieldError Field="code" Errors="errors" />
                    </div>
                    <div class="span-12">
                        <label class="form-label" for="k-purpose">@Texts.Get("marketing.purpose")</label>
                        <input id="k-purpose" class="form-control" maxlength="200" placeholder="@Texts.Get("marketing.campaignNew.purposePlaceholder")" @bind="purpose" />
                        <FieldError Field="purpose" Errors="errors" />
                    </div>
                    <div class="span-12">
                        <label class="form-label" for="k-desc">@Texts.Get("common.field.description")</label>
                        <textarea id="k-desc" class="form-control" rows="3" maxlength="1000" @bind="description"></textarea>
                        <FieldError Field="description" Errors="errors" />
                    </div>
                </div>
            </TabPanel>
            <TabPanel State="tabs" Key="form-hedef">
                <div class="form-grid">
                    <div class="span-6">
                        <label class="form-label" for="k-target">@Texts.Get("marketing.targetType")</label>
                        <select id="k-target" class="form-select" @bind="target">
                            @foreach (var t in MarketingLabels.Targets) { <option value="@t.Key">@t.Label</option> }
                        </select>
                        <FieldError Field="target" Errors="errors" />
                    </div>
                    <div class="span-6">
                        <label class="form-label" for="k-channel">@Texts.Get("crm.contactPoint.channel")</label>
                        <select id="k-channel" class="form-select" @bind="channel">
                            @foreach (var c in MarketingLabels.Channels) { <option value="@c.Key">@c.Label</option> }
                        </select>
                        <FieldError Field="channel" Errors="errors" />
                    </div>
                    @if (target == "Company")
                    {
                        <div class="span-6">
                            <label class="form-label" for="k-rule">@Texts.Get("marketing.recipientRule")</label>
                            <select id="k-rule" class="form-select" @bind="rule">
                                @foreach (var r in MarketingLabels.RecipientRules) { <option value="@r.Key">@r.Label</option> }
                            </select>
                            <small class="text-muted">@Texts.Get("marketing.recipientRuleHelp")</small>
                            <FieldError Field="recipientRule" Errors="errors" />
                        </div>
                        @if (rule == "Role")
                        {
                            <div class="span-6">
                                <label class="form-label" for="k-role">@Texts.Get("marketing.role")</label>
                                <select id="k-role" class="form-select" @bind="role">
                                    <option value="">@Texts.Get("support.choose")</option>
                                    @foreach (var r in MarketingLabels.Roles) { <option value="@r.Key">@r.Label</option> }
                                </select>
                                <FieldError Field="recipientRole" Errors="errors" />
                            </div>
                        }
                    }
                    <div class="span-6">
                        <label class="form-label" for="k-max">@Texts.Get("marketing.maxPerTarget")</label>
                        <input id="k-max" class="form-control" type="number" min="1" max="1000" placeholder="@Texts.Get("marketing.noLimit")" @bind="maxPerTarget" />
                        <FieldError Field="maxPerTarget" Errors="errors" />
                    </div>
                </div>
            </TabPanel>
            <TabPanel State="tabs" Key="form-zaman">
                <div class="form-grid">
                    <div class="span-3">
                        <label class="form-label" for="k-start">@Texts.Get("support.reports.from")</label>
                        <input id="k-start" class="form-control" type="date" @bind="startsOn" />
                        <FieldError Field="startsOn" Errors="errors" />
                    </div>
                    <div class="span-3">
                        <label class="form-label" for="k-end">@Texts.Get("support.reports.to")</label>
                        <input id="k-end" class="form-control" type="date" @bind="endsOn" />
                        <FieldError Field="endsOn" Errors="errors" />
                    </div>
                </div>
            </TabPanel>
        </fieldset>
        <div class="form-actions"><button type="submit" class="btn btn-primary" disabled="@busy">@Texts.Get("marketing.create")</button></div>
    </form>
</AuthGate>

@code {
    private string name = string.Empty;
    private string code = string.Empty;
    private string target = "Company";
    private string channel = "Email";
    private string rule = "PrimaryContact";
    private string role = string.Empty;
    private int? maxPerTarget;
    private DateTime? startsOn;
    private DateTime? endsOn;
    private string purpose = string.Empty;
    private string description = string.Empty;
    private bool busy;
    private string? message;
    private IReadOnlyDictionary<string, string[]>? errors;

    // Her kayıt formu sekmelidir; hatalı alan içeren sekme "!" rozeti taşır ve kayıt denemesinden sonra açılır.
    private readonly TabState tabs = new("form-genel");

    private int ErrorCount(params string[] fields) => errors is null ? 0 : fields.Count(errors.ContainsKey);

    private IReadOnlyList<TabItem> FormTabs =>
    [
        new("form-genel", Texts.Get("crm.quoteDetail.tab.general"), Errors: ErrorCount("name", "code", "purpose", "description")),
        new("form-hedef", Texts.Get("marketing.campaignNew.tab.target"), Errors: ErrorCount("target", "channel", "recipientRule", "recipientRole", "maxPerTarget")),
        new("form-zaman", Texts.Get("marketing.campaignNew.tab.schedule"), Errors: ErrorCount("startsOn", "endsOn")),
    ];

    protected override Task OnInitializedAsync() => Session.EnsureLoadedAsync();

    private async Task SaveAsync()
    {
        busy = true;
        message = null;
        errors = null;
        var result = await Api.PostAsync<CampaignDto>("/api/marketing/campaigns", new SaveCampaignRequest(
            Code: code.Trim(),
            Name: name.Trim(),
            Description: Blank(description),
            Purpose: Blank(purpose),
            Target: target,
            Channel: channel,
            RecipientRule: target == "Company" ? rule : "PrimaryContact",
            RecipientRole: target == "Company" && rule == "Role" ? Blank(role) : null,
            MaxPerTarget: maxPerTarget,
            StartsOn: startsOn is { } s ? DateOnly.FromDateTime(s) : null,
            EndsOn: endsOn is { } e ? DateOnly.FromDateTime(e) : null));
        busy = false;
        if (result.IsSuccess)
        {
            Navigation.NavigateTo($"pazarlama/kampanyalar/{result.Value!.Id}");
            return;
        }

        message = result.FieldErrors.Count == 0 ? result.Error : null;
        errors = result.FieldErrors.Count == 0 ? null : result.FieldErrors;
        tabs.RevealFirstFailing(FormTabs);
    }

    private static string? Blank(string value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
}
