@page "/pazarlama/segmentler"
@inject ApiClient Api
@inject SessionState Session

<PageTitle>@Texts.Get("nav.app.marketing.segments") · Modulix</PageTitle>

<AuthGate Module="@MarketingAccess.ModuleKey" Permission="@MarketingAccess.SegmentsRead">
    <div class="page-header">
        <div>
            <h1>@Texts.Get("nav.app.marketing.segments")</h1>
            <p class="text-muted mb-0">@Texts.Get("marketing.segments.intro")</p>
        </div>
    </div>

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message <button type="button" class="btn btn-sm btn-outline-secondary ms-2" @onclick="() => LoadAsync(1)">@Texts.Get("crm.sales.retry")</button></div>
    }

    <ViewTabs Items="ViewOptions" Value="@view" ValueChanged="ChooseViewAsync" Label="@Texts.Get("marketing.segments.views")" NewView="StartNaming" />

    <div class="list-toolbar">
        <form class="search" @onsubmit="() => LoadAsync(1)" @onsubmit:preventDefault>
            <label class="visually-hidden" for="segment-search">@Texts.Get("marketing.segments.search")</label>
            <input id="segment-search" class="form-control" type="search" placeholder="@Texts.Get("marketing.searchPlaceholder")" @bind="search" />
        </form>
        <FilterToggle @bind-Open="filtersOpen" Count="ActiveFilters" />
        <GridColumnPicker State="grid" Changed="@(() => Task.CompletedTask)" />
        @if (Session.Can(MarketingAccess.SegmentsWrite))
        {
            <a class="btn btn-primary" href="pazarlama/segmentler/yeni"><AppIcon Name="plus" Size="16" /> @Texts.Get("marketing.segments.new")</a>
        }
    </div>

    @if (filtersOpen || ActiveFilters > 0)
    {
        <div class="filters">
            <label class="visually-hidden" for="status-filter">@Texts.Get("common.field.status")</label>
            <select id="status-filter" class="form-select form-select-sm filter-select" @bind="status" @bind:after="() => LoadAsync(1)">
                <option value="">@Texts.Get("common.allStatuses")</option>
                @foreach (var s in MarketingLabels.Statuses) { <option value="@s.Key">@s.Label</option> }
            </select>
            <label class="visually-hidden" for="target-filter">@Texts.Get("marketing.targetType")</label>
            <select id="target-filter" class="form-select form-select-sm filter-select" @bind="target" @bind:after="() => LoadAsync(1)">
                <option value="">@Texts.Get("marketing.allTargets")</option>
                @foreach (var t in MarketingLabels.Targets) { <option value="@t.Key">@t.Label</option> }
            </select>
            <label class="visually-hidden" for="kind-filter">@Texts.Get("common.field.kind")</label>
            <select id="kind-filter" class="form-select form-select-sm filter-select" @bind="kind" @bind:after="() => LoadAsync(1)">
                <option value="">@Texts.Get("marketing.segments.allKinds")</option>
                @foreach (var k in MarketingLabels.Kinds) { <option value="@k.Key">@k.Label</option> }
            </select>
        </div>
    }

    <PersonalViewBar Active="Active" Dirty="Dirty" Naming="views.Naming" NamingChanged="views.StartNaming" Error="@views.Error"
                     SaveAs="SaveAsAsync" UpdateView="UpdateViewAsync" DiscardChanges="DiscardAsync" DeleteView="DeleteViewAsync" />

    @if (list is null && message is null)
    {
        <LoadingState Kind="LoadingKind.Table" />
    }
    else if (list is not null && list.Items.Count == 0)
    {
        <p class="text-muted" role="status">@(Session.Can(MarketingAccess.SegmentsWrite) ? Texts.Get("marketing.segments.emptyCanCreate") : Texts.Get("marketing.segments.empty"))</p>
    }
    else if (list is not null)
    {
        <p class="visually-hidden" role="status" aria-live="polite">@Texts.Get("marketing.segments.listed", list.TotalCount)</p>
        <table class="table record-table">
            <caption class="visually-hidden">@Texts.Get("marketing.segments.caption")</caption>
            <thead>
                <tr>
                    @foreach (var column in grid.VisibleColumns)
                    {
                        <GridHeader Column="column" State="grid" SortChanged="SortAsync" />
                    }
                    <th scope="col" class="row-menu-cell"><span class="visually-hidden">@Texts.Get("common.actions")</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in list.Items)
                {
                    <tr>
                        @foreach (var column in grid.VisibleColumns)
                        {
                            @Cell(column, s)
                        }
                        <td class="row-menu-cell">
                            <RowMenu Label="@Texts.Get("common.rowActionsOf", s.Name)">
                                <a class="view-menu-item" role="menuitem" href="pazarlama/segmentler/@s.Id"><AppIcon Name="eye" Size="16" /> <span>@Texts.Get("common.open")</span></a>
                            </RowMenu>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager PageSizeChoice="true" Page="list.Page" PageSize="list.PageSize" TotalCount="list.TotalCount" PageChanged="LoadAsync" />
    }
</AuthGate>

@code {
    private const string AllViews = "all";
    private const string MineView = "mine";

    // Başlık tıklamasıyla sıralanan sütunlar sunucudaki sort anahtarlarıdır (SegmentRecordStore.SortKeys).
    private static GridColumnDef[] Columns =>
    [
        new("name", Texts.Get("marketing.segments.col.name"), "type", "name", "-name", Locked: true),
        new("target", Texts.Get("marketing.col.target"), "target", "target", "-target"),
        new("kind", Texts.Get("common.field.kind"), "layers", "kind", "-kind"),
        new("status", Texts.Get("common.field.status"), "tag", "status", "-status"),
        new("members", Texts.Get("marketing.segments.col.members"), "users", "lastMemberCount", "-lastMemberCount"),
        new("computed", Texts.Get("marketing.segments.col.computed"), "clock", "lastComputedAt", "-lastComputedAt"),
        new("version", Texts.Get("marketing.segments.col.version"), "hash", "publishedVersion", "-publishedVersion"),
    ];

    private readonly GridViewState grid = new("marketing.segments", "name");
    private PersonalGridViews views = default!;
    private bool filtersOpen;
    private PagedResult<SegmentDto>? list;
    private string? message;
    private string status = string.Empty;
    private string target = string.Empty;
    private string kind = string.Empty;
    private string search = string.Empty;
    private bool mine;
    private string view = AllViews;

    /// <summary>Etkin süzgeç sayısı ("Filtrele" rozeti); süzgeç satırı etkin süzgeç varken açık kalır.</summary>
    private int ActiveFilters => (status.Length > 0 ? 1 : 0) + (target.Length > 0 ? 1 : 0) + (kind.Length > 0 ? 1 : 0);

    protected override async Task OnInitializedAsync()
    {
        views = new PersonalGridViews(Api, "marketing.segments");
        grid.Define(Columns);
        await Session.EnsureLoadedAsync();
        if (Session.Can(MarketingAccess.SegmentsRead))
        {
            await views.LoadAsync();
            await LoadAsync(1);
        }
    }

    private GridViewDto? Active => views.Find(view);

    // Görünümler yalnızca süzgeçtir (Benim segmentlerim, Tümü, kişisel); kapsamı sunucu uygular.
    private IReadOnlyList<ViewOption> ViewOptions =>
    [
        new(MineView, Texts.Get("marketing.segments.view.mine"), Icon: "star"),
        new(AllViews, Texts.Get("marketing.segments.view.all"), Icon: "layers"),
        .. views.Options,
    ];

    private string? CurrentFilters => GridFilters.Build(
        mine ? ("ownerId", "me") : null,
        status.Length > 0 ? ("status", status) : null,
        target.Length > 0 ? ("target", target) : null,
        kind.Length > 0 ? ("kind", kind) : null);

    // Kaydedilmemiş değişiklik: sütunlar/sıralama ya da süzgeç açık görünümden farklı.
    private bool Dirty => grid.Differs(Active) || Canon(CurrentFilters) != Canon(Active?.Filters ?? (view == MineView ? "ownerId=me" : null));

    private static string Canon(string? filters) =>
        string.Join('&', GridFilters.Parse(filters).OrderBy(p => p.Key, StringComparer.Ordinal).Select(p => p.Key + "=" + p.Value));

    private async Task ChooseViewAsync(string key)
    {
        view = key;
        views.StartNaming(false);
        if (Active is { } saved)
        {
            grid.Apply(saved);
            ApplyFilters(GridFilters.Parse(saved.Filters));
        }
        else
        {
            grid.Reset();
            ApplyFilters(key == MineView ? new Dictionary<string, string> { ["ownerId"] = "me" } : new Dictionary<string, string>());
        }

        await LoadAsync(1);
    }

    private void ApplyFilters(Dictionary<string, string> filters)
    {
        mine = filters.GetValueOrDefault("ownerId") == "me";
        status = filters.GetValueOrDefault("status") ?? string.Empty;
        target = filters.GetValueOrDefault("target") ?? string.Empty;
        kind = filters.GetValueOrDefault("kind") ?? string.Empty;
    }

    private async Task SortAsync(string key)
    {
        grid.Sort = key;
        await LoadAsync(1);
    }

    private void StartNaming() => views.StartNaming(true);

    private async Task SaveAsAsync(string name)
    {
        if (await views.SaveAsAsync(grid.ToRequest(name, CurrentFilters)) is { } key)
        {
            view = key;
        }
    }

    private async Task UpdateViewAsync()
    {
        if (Active is { } current)
        {
            await views.UpdateAsync(current, grid.ToRequest(current.Name, CurrentFilters));
        }
    }

    private async Task DiscardAsync() => await ChooseViewAsync(view);

    private async Task DeleteViewAsync()
    {
        if (Active is { } current && await views.DeleteAsync(current))
        {
            await ChooseViewAsync(AllViews);
        }
    }

    private async Task LoadAsync(int pageNumber)
    {
        var parts = new List<string> { $"page={pageNumber}&pageSize={ListPaging.Size}" };
        if (!string.IsNullOrWhiteSpace(search)) { parts.Add($"search={Uri.EscapeDataString(search.Trim())}"); }
        if (grid.Sort != grid.DefaultSort) { parts.Add($"sort={Uri.EscapeDataString(grid.Sort)}"); }
        if (status != string.Empty) { parts.Add($"status={status}"); }
        if (target != string.Empty) { parts.Add($"target={target}"); }
        if (kind != string.Empty) { parts.Add($"kind={kind}"); }
        if (mine) { parts.Add("ownerId=me"); }

        var result = await Api.GetAsync<PagedResult<SegmentDto>>($"/api/marketing/segments?{string.Join('&', parts)}");
        list = result.Value;
        message = result.IsSuccess ? null : result.Error;
    }

    private RenderFragment Cell(GridColumnDef column, SegmentDto s) => @<td data-label="@column.Label" class="@(column.Key == "name" ? "primary" : null)">@CellContent(column.Key, s)</td>;

    private RenderFragment CellContent(string key, SegmentDto s) => key switch
    {
        "name" => @<text><a href="pazarlama/segmentler/@s.Id">@s.Name</a> <small class="text-muted">@s.Code</small></text>,
        "target" => @<text>@MarketingLabels.Label(MarketingLabels.Targets, s.Target)</text>,
        "kind" => @<text>@(s.Kind == "Static" ? Texts.Get("marketing.static") : Texts.Get("marketing.dynamic"))</text>,
        "status" => @<span class="badge stage-@MarketingLabels.StatusBadge(s.Status)">@MarketingLabels.Label(MarketingLabels.Statuses, s.Status)</span>,
        "members" => @<text>@(s.LastMemberCount?.ToString("N0") ?? "—")</text>,
        "computed" => @<text>@(s.LastComputedAt is { } at ? CrmLabels.Time(at) : "—")@if (s.LastError is not null) { <small class="text-danger d-block">@Texts.Get("marketing.segments.error", s.LastError)</small> }</text>,
        "version" => @<text>@(s.PublishedVersion == 0 ? "—" : "v" + s.PublishedVersion)</text>,
        _ => @<text></text>,
    };
}
