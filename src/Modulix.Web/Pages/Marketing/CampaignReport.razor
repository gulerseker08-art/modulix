@page "/pazarlama/rapor"
@inject ApiClient Api

<PageTitle>@Texts.Get("nav.app.marketing.report") · Modulix</PageTitle>

@* Kampanya raporu (ADR-0025, dilim 8). "Gönderildi" sağlayıcının kabul ettiği ve sonucu belirsiz iletilerdir; teslim edildi demek değildir. İlk dokunuş: lead açılan hedefe giden en eski ileti bu kampanyadandı.
   Son dokunuş: lead açılan yanıt bu kampanyanın iletisine verilmişti. Fırsat ve ciro atfı yoktur; maliyet para birimleri arasında toplanmaz. *@
<AuthGate Module="@MarketingAccess.ModuleKey" Permission="@MarketingAccess.ReportsRead">
    <a class="back-link" href="pazarlama/kampanyalar">← @Texts.Get("nav.app.marketing.campaigns")</a>
    <div class="page-header"><h1>@Texts.Get("nav.app.marketing.report")</h1></div>

    <form class="filters" @onsubmit="LoadAsync" @onsubmit:preventDefault>
        <label class="form-label" for="cr-channel">@Texts.Get("crm.contactPoint.channel")</label>
        <select id="cr-channel" class="form-select" @bind="channel">
            <option value="">@Texts.Get("marketing.all")</option>
            @foreach (var c in MarketingLabels.Channels) { <option value="@c.Key">@c.Label</option> }
        </select>
        <button type="submit" class="btn btn-primary" disabled="@busy">@Texts.Get("marketing.campaignReport.load")</button>
    </form>

    <Notice Text="@message" Failed="true" />
    @if (report is null)
    {
        <p class="text-muted" role="status">@(busy ? Texts.Get("common.loading") : Texts.Get("marketing.campaignReport.loadFailed"))</p>
    }
    else if (report.Rows.Count == 0)
    {
        <EmptyState Compact="true" Title="@Texts.Get("marketing.campaignReport.empty")" />
    }
    else
    {
        <p class="small text-muted">@(report.Truncated ? Texts.Get("marketing.campaignReport.generatedTruncated", CrmLabels.Time(report.GeneratedAt)) : Texts.Get("marketing.campaignReport.generated", CrmLabels.Time(report.GeneratedAt)))</p>
        <table class="table record-table">
            <caption class="visually-hidden">@Texts.Get("nav.app.marketing.report")</caption>
            <thead>
                <tr>
                    <th scope="col">@Texts.Get("marketing.campaigns.col.name")</th><th scope="col">@Texts.Get("marketing.campaignReport.col.sent")</th><th scope="col">@Texts.Get("marketing.campaignReport.col.failed")</th><th scope="col">@Texts.Get("marketing.campaignReport.col.skipped")</th><th scope="col">@Texts.Get("marketing.campaignReport.col.responses")</th>
                    <th scope="col">@Texts.Get("marketing.campaignReport.col.interest")</th><th scope="col">@Texts.Get("marketing.campaignReport.col.optOut")</th><th scope="col">@Texts.Get("marketing.campaignReport.col.leads")</th><th scope="col">@Texts.Get("marketing.campaignReport.col.firstTouch")</th><th scope="col">@Texts.Get("marketing.campaignReport.col.lastTouch")</th>
                    <th scope="col">@Texts.Get("marketing.campaignReport.col.cost")</th><th scope="col">@Texts.Get("marketing.campaignReport.col.perResponse")</th><th scope="col">@Texts.Get("marketing.campaignReport.col.perLead")</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in report.Rows)
                {
                    <tr>
                        <td data-label="@Texts.Get("marketing.campaigns.col.name")" class="primary"><a href="pazarlama/kampanyalar/@r.CampaignId">@r.Name</a> <small class="text-muted">@r.Code</small></td>
                        <td data-label="@Texts.Get("marketing.campaignReport.col.sent")">@r.Sent.ToString("N0")@(r.Unknown > 0 ? $" ({Texts.Get("marketing.campaignReport.unknown", r.Unknown)})" : null)</td>
                        <td data-label="@Texts.Get("marketing.campaignReport.col.failed")">@r.Failed.ToString("N0")</td>
                        <td data-label="@Texts.Get("marketing.campaignReport.col.skipped")">@r.Skipped.ToString("N0")</td>
                        <td data-label="@Texts.Get("marketing.campaignReport.col.responses")">@r.Responses.ToString("N0")</td>
                        <td data-label="@Texts.Get("marketing.campaignReport.col.interest")">@r.Interested.ToString("N0")</td>
                        <td data-label="@Texts.Get("marketing.campaignReport.col.optOut")">@r.OptOuts.ToString("N0")</td>
                        <td data-label="@Texts.Get("marketing.campaignReport.col.leads")">@r.Leads.ToString("N0")</td>
                        <td data-label="@Texts.Get("marketing.campaignReport.col.firstTouch")">@r.FirstTouchLeads.ToString("N0")</td>
                        <td data-label="@Texts.Get("marketing.campaignReport.col.lastTouch")">@r.LastTouchLeads.ToString("N0")</td>
                        <td data-label="@Texts.Get("marketing.campaignReport.col.cost")">@Money(r.ActualCost, r.Currency)</td>
                        <td data-label="@Texts.Get("marketing.campaignReport.col.perResponse")">@Money(r.CostPerResponse, r.Currency)</td>
                        <td data-label="@Texts.Get("marketing.campaignReport.col.perLead")">@Money(r.CostPerLead, r.Currency)</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</AuthGate>

@code {
    private CampaignReportDto? report;
    private string channel = string.Empty;
    private string? message;
    private bool busy;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        busy = true;
        message = null;
        var result = await Api.GetAsync<CampaignReportDto>(channel.Length == 0 ? "/api/marketing/reports/campaigns" : $"/api/marketing/reports/campaigns?channel={channel}");
        busy = false;
        report = result.Value;
        if (!result.IsSuccess) { message = result.Error; }
    }

    private static string Money(decimal? amount, string currency) => amount is null ? "—" : CrmLabels.Amount(amount.Value, currency);
}
