@page "/pazarlama/segmentler/yeni"
@inject ApiClient Api
@inject SessionState Session
@inject NavigationManager Navigation

<PageTitle>@Texts.Get("marketing.segments.new") · Modulix</PageTitle>

<AuthGate Module="@MarketingAccess.ModuleKey" Permission="@MarketingAccess.SegmentsWrite">
    <div class="page-header">
        <div>
            <h1>@Texts.Get("marketing.segments.new")</h1>
            <p class="text-muted mb-0">@Texts.Get("marketing.segmentNew.intro")</p>
        </div>
        <div class="header-actions"><a class="btn btn-outline-secondary" href="pazarlama/segmentler">@Texts.Get("crm.quoteDetail.backToList")</a></div>
    </div>

    <Notice Text="@message" Failed="true" />
    <ErrorSummary Errors="@errors" />

    <form class="record-form" novalidate @onsubmit="SaveAsync" @onsubmit:preventDefault>
        <TabBar Tabs="FormTabs" State="tabs" Label="@Texts.Get("marketing.segmentNew.formSections")" />
        <fieldset disabled="@busy">
            <TabPanel State="tabs" Key="form-genel">
                <div class="form-grid">
                    <div class="span-6">
                        <label class="form-label" for="s-name">@Texts.Get("common.field.name")</label>
                        <input id="s-name" class="form-control" maxlength="150" @bind="name" />
                        <FieldError Field="name" Errors="errors" />
                    </div>
                    <div class="span-6">
                        <label class="form-label" for="s-code">@Texts.Get("marketing.code")</label>
                        <input id="s-code" class="form-control" maxlength="40" placeholder="tekstil-marmara" aria-describedby="s-code-help" @bind="code" />
                        <small id="s-code-help" class="text-muted">@Texts.Get("marketing.codeHelp")</small>
                        <FieldError Field="code" Errors="errors" />
                    </div>
                    <div class="span-12">
                        <label class="form-label" for="s-purpose">@Texts.Get("marketing.purpose")</label>
                        <input id="s-purpose" class="form-control" maxlength="200" placeholder="@Texts.Get("marketing.segmentNew.purposePlaceholder")" @bind="purpose" />
                        <FieldError Field="purpose" Errors="errors" />
                    </div>
                    <div class="span-12">
                        <label class="form-label" for="s-desc">@Texts.Get("common.field.description")</label>
                        <textarea id="s-desc" class="form-control" rows="3" maxlength="1000" @bind="description"></textarea>
                        <FieldError Field="description" Errors="errors" />
                    </div>
                </div>
            </TabPanel>
            <TabPanel State="tabs" Key="form-hedef">
                <div class="form-grid">
                    <div class="span-6">
                        <label class="form-label" for="s-target">@Texts.Get("marketing.targetType")</label>
                        <select id="s-target" class="form-select" @bind="target">
                            @foreach (var t in MarketingLabels.Targets) { <option value="@t.Key">@t.Label</option> }
                        </select>
                        <FieldError Field="target" Errors="errors" />
                    </div>
                    <div class="span-6">
                        <label class="form-label" for="s-kind">@Texts.Get("common.field.kind")</label>
                        <select id="s-kind" class="form-select" @bind="kind">
                            @foreach (var k in MarketingLabels.Kinds) { <option value="@k.Key">@k.Label</option> }
                        </select>
                        <FieldError Field="kind" Errors="errors" />
                    </div>
                </div>
            </TabPanel>
        </fieldset>
        <div class="form-actions"><button type="submit" class="btn btn-primary" disabled="@busy">@Texts.Get("marketing.create")</button></div>
    </form>
</AuthGate>

@code {
    private string name = string.Empty;
    private string code = string.Empty;
    private string target = "Company";
    private string kind = "Dynamic";
    private string purpose = string.Empty;
    private string description = string.Empty;
    private bool busy;
    private string? message;
    private IReadOnlyDictionary<string, string[]>? errors;

    // Her kayıt formu sekmelidir; hatalı alan içeren sekme "!" rozeti taşır ve kayıt denemesinden sonra açılır.
    private readonly TabState tabs = new("form-genel");

    private int ErrorCount(params string[] fields) => errors is null ? 0 : fields.Count(errors.ContainsKey);

    private IReadOnlyList<TabItem> FormTabs =>
    [
        new("form-genel", Texts.Get("crm.quoteDetail.tab.general"), Errors: ErrorCount("name", "code", "purpose", "description")),
        new("form-hedef", Texts.Get("marketing.segmentNew.tab.target"), Errors: ErrorCount("target", "kind")),
    ];

    protected override Task OnInitializedAsync() => Session.EnsureLoadedAsync();

    private async Task SaveAsync()
    {
        busy = true;
        message = null;
        errors = null;
        var result = await Api.PostAsync<SegmentDto>("/api/marketing/segments", new SaveSegmentRequest(
            Code: code.Trim(),
            Name: name.Trim(),
            Description: Blank(description),
            Target: target,
            Kind: kind,
            Purpose: Blank(purpose)));
        busy = false;
        if (result.IsSuccess)
        {
            Navigation.NavigateTo($"pazarlama/segmentler/{result.Value!.Id}");
            return;
        }

        message = result.FieldErrors.Count == 0 ? result.Error : null;
        errors = result.FieldErrors.Count == 0 ? null : result.FieldErrors;
        tabs.RevealFirstFailing(FormTabs);
    }

    private static string? Blank(string value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
}
