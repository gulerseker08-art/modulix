@page "/pazarlama/kampanyalar"
@inject ApiClient Api
@inject SessionState Session

<PageTitle>@Texts.Get("nav.app.marketing.campaigns") · Modulix</PageTitle>

<AuthGate Module="@MarketingAccess.ModuleKey" Permission="@MarketingAccess.CampaignsRead">
    <div class="page-header">
        <div>
            <h1>@Texts.Get("nav.app.marketing.campaigns")</h1>
            <p class="text-muted mb-0">@Texts.Get("marketing.campaigns.intro")</p>
        </div>
    </div>

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message <button type="button" class="btn btn-sm btn-outline-secondary ms-2" @onclick="() => LoadAsync(1)">@Texts.Get("crm.sales.retry")</button></div>
    }

    <ViewTabs Items="ViewOptions" Value="@view" ValueChanged="ChooseViewAsync" Label="@Texts.Get("marketing.campaigns.views")" NewView="StartNaming" />

    <div class="list-toolbar">
        <form class="search" @onsubmit="() => LoadAsync(1)" @onsubmit:preventDefault>
            <label class="visually-hidden" for="c-search">@Texts.Get("marketing.campaigns.search")</label>
            <input id="c-search" class="form-control" type="search" placeholder="@Texts.Get("marketing.searchPlaceholder")" @bind="search" />
        </form>
        <FilterToggle @bind-Open="filtersOpen" Count="ActiveFilters" />
        <GridColumnPicker State="grid" Changed="@(() => Task.CompletedTask)" />
        @if (Session.Can(MarketingAccess.CampaignsWrite))
        {
            <a class="btn btn-primary" href="pazarlama/kampanyalar/yeni"><AppIcon Name="plus" Size="16" /> @Texts.Get("marketing.campaigns.new")</a>
        }
    </div>

    @if (filtersOpen || ActiveFilters > 0)
    {
        <div class="filters">
            <label class="visually-hidden" for="c-status">@Texts.Get("common.field.status")</label>
            <select id="c-status" class="form-select form-select-sm filter-select" @bind="status" @bind:after="() => LoadAsync(1)">
                <option value="">@Texts.Get("common.allStatuses")</option>
                @foreach (var s in MarketingLabels.CampaignStatuses) { <option value="@s.Key">@s.Label</option> }
            </select>
            <label class="visually-hidden" for="c-target">@Texts.Get("marketing.targetType")</label>
            <select id="c-target" class="form-select form-select-sm filter-select" @bind="target" @bind:after="() => LoadAsync(1)">
                <option value="">@Texts.Get("marketing.allTargets")</option>
                @foreach (var t in MarketingLabels.Targets) { <option value="@t.Key">@t.Label</option> }
            </select>
            <label class="visually-hidden" for="c-channel">@Texts.Get("crm.contactPoint.channel")</label>
            <select id="c-channel" class="form-select form-select-sm filter-select" @bind="channel" @bind:after="() => LoadAsync(1)">
                <option value="">@Texts.Get("marketing.allChannels")</option>
                @foreach (var c in MarketingLabels.Channels) { <option value="@c.Key">@c.Label</option> }
            </select>
        </div>
    }

    <PersonalViewBar Active="Active" Dirty="Dirty" Naming="views.Naming" NamingChanged="views.StartNaming" Error="@views.Error"
                     SaveAs="SaveAsAsync" UpdateView="UpdateViewAsync" DiscardChanges="DiscardAsync" DeleteView="DeleteViewAsync" />

    @if (list is null && message is null)
    {
        <LoadingState Kind="LoadingKind.Table" />
    }
    else if (list is not null && list.Items.Count == 0)
    {
        <p class="text-muted" role="status">@(Session.Can(MarketingAccess.CampaignsWrite) ? Texts.Get("marketing.campaigns.emptyCanCreate") : Texts.Get("marketing.campaigns.empty"))</p>
    }
    else if (list is not null)
    {
        <p class="visually-hidden" role="status" aria-live="polite">@Texts.Get("marketing.campaigns.listed", list.TotalCount)</p>
        <table class="table record-table">
            <caption class="visually-hidden">@Texts.Get("marketing.campaigns.caption")</caption>
            <thead>
                <tr>
                    @foreach (var column in grid.VisibleColumns)
                    {
                        <GridHeader Column="column" State="grid" SortChanged="SortAsync" />
                    }
                    <th scope="col" class="row-menu-cell"><span class="visually-hidden">@Texts.Get("common.actions")</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in list.Items)
                {
                    <tr>
                        @foreach (var column in grid.VisibleColumns)
                        {
                            @Cell(column, c)
                        }
                        <td class="row-menu-cell">
                            <RowMenu Label="@Texts.Get("common.rowActionsOf", c.Name)">
                                <a class="view-menu-item" role="menuitem" href="pazarlama/kampanyalar/@c.Id"><AppIcon Name="eye" Size="16" /> <span>@Texts.Get("common.open")</span></a>
                            </RowMenu>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager PageSizeChoice="true" Page="list.Page" PageSize="list.PageSize" TotalCount="list.TotalCount" PageChanged="LoadAsync" />
    }
</AuthGate>

@code {
    private const string AllViews = "all";
    private const string MineView = "mine";

    // Başlık tıklamasıyla sıralanan sütunlar sunucudaki sort anahtarlarıdır (CampaignRecordStore.SortKeys). Varsayılan sıra: en yeni önce.
    private static GridColumnDef[] Columns =>
    [
        new("name", Texts.Get("marketing.campaigns.col.name"), "type", "name", "-name", Locked: true),
        new("target", Texts.Get("marketing.col.target"), "target", "target", "-target"),
        new("channel", Texts.Get("crm.contactPoint.channel"), "mail", "channel", "-channel"),
        new("period", Texts.Get("marketing.campaigns.col.period"), "calendar", "startsOn", "-startsOn"),
        new("status", Texts.Get("common.field.status"), "tag", "status", "-status"),
        new("budget", Texts.Get("marketing.budget"), "coins", "budget", "-budget", DefaultVisible: false),
    ];

    private readonly GridViewState grid = new("marketing.campaigns", "-createdAt");
    private PersonalGridViews views = default!;
    private bool filtersOpen;
    private PagedResult<CampaignDto>? list;
    private string? message;
    private string status = string.Empty;
    private string target = string.Empty;
    private string channel = string.Empty;
    private string search = string.Empty;
    private bool mine;
    private string view = AllViews;

    /// <summary>Etkin süzgeç sayısı ("Filtrele" rozeti); süzgeç satırı etkin süzgeç varken açık kalır.</summary>
    private int ActiveFilters => (status.Length > 0 ? 1 : 0) + (target.Length > 0 ? 1 : 0) + (channel.Length > 0 ? 1 : 0);

    protected override async Task OnInitializedAsync()
    {
        views = new PersonalGridViews(Api, "marketing.campaigns");
        grid.Define(Columns);
        await Session.EnsureLoadedAsync();
        if (Session.Can(MarketingAccess.CampaignsRead))
        {
            await views.LoadAsync();
            await LoadAsync(1);
        }
    }

    private GridViewDto? Active => views.Find(view);

    // Görünümler yalnızca süzgeçtir (Benim kampanyalarım, Tümü, kişisel); kapsamı sunucu uygular.
    private IReadOnlyList<ViewOption> ViewOptions =>
    [
        new(MineView, Texts.Get("marketing.campaigns.view.mine"), Icon: "star"),
        new(AllViews, Texts.Get("marketing.campaigns.view.all"), Icon: "target"),
        .. views.Options,
    ];

    private string? CurrentFilters => GridFilters.Build(
        mine ? ("ownerId", "me") : null,
        status.Length > 0 ? ("status", status) : null,
        target.Length > 0 ? ("target", target) : null,
        channel.Length > 0 ? ("channel", channel) : null);

    // Kaydedilmemiş değişiklik: sütunlar/sıralama ya da süzgeç açık görünümden farklı.
    private bool Dirty => grid.Differs(Active) || Canon(CurrentFilters) != Canon(Active?.Filters ?? (view == MineView ? "ownerId=me" : null));

    private static string Canon(string? filters) =>
        string.Join('&', GridFilters.Parse(filters).OrderBy(p => p.Key, StringComparer.Ordinal).Select(p => p.Key + "=" + p.Value));

    private async Task ChooseViewAsync(string key)
    {
        view = key;
        views.StartNaming(false);
        if (Active is { } saved)
        {
            grid.Apply(saved);
            ApplyFilters(GridFilters.Parse(saved.Filters));
        }
        else
        {
            grid.Reset();
            ApplyFilters(key == MineView ? new Dictionary<string, string> { ["ownerId"] = "me" } : new Dictionary<string, string>());
        }

        await LoadAsync(1);
    }

    private void ApplyFilters(Dictionary<string, string> filters)
    {
        mine = filters.GetValueOrDefault("ownerId") == "me";
        status = filters.GetValueOrDefault("status") ?? string.Empty;
        target = filters.GetValueOrDefault("target") ?? string.Empty;
        channel = filters.GetValueOrDefault("channel") ?? string.Empty;
    }

    private async Task SortAsync(string key)
    {
        grid.Sort = key;
        await LoadAsync(1);
    }

    private void StartNaming() => views.StartNaming(true);

    private async Task SaveAsAsync(string name)
    {
        if (await views.SaveAsAsync(grid.ToRequest(name, CurrentFilters)) is { } key)
        {
            view = key;
        }
    }

    private async Task UpdateViewAsync()
    {
        if (Active is { } current)
        {
            await views.UpdateAsync(current, grid.ToRequest(current.Name, CurrentFilters));
        }
    }

    private async Task DiscardAsync() => await ChooseViewAsync(view);

    private async Task DeleteViewAsync()
    {
        if (Active is { } current && await views.DeleteAsync(current))
        {
            await ChooseViewAsync(AllViews);
        }
    }

    private async Task LoadAsync(int pageNumber)
    {
        var parts = new List<string> { $"page={pageNumber}&pageSize={ListPaging.Size}" };
        if (!string.IsNullOrWhiteSpace(search)) { parts.Add($"search={Uri.EscapeDataString(search.Trim())}"); }
        if (grid.Sort != grid.DefaultSort) { parts.Add($"sort={Uri.EscapeDataString(grid.Sort)}"); }
        if (status != string.Empty) { parts.Add($"status={status}"); }
        if (target != string.Empty) { parts.Add($"target={target}"); }
        if (channel != string.Empty) { parts.Add($"channel={channel}"); }
        if (mine) { parts.Add("ownerId=me"); }

        var result = await Api.GetAsync<PagedResult<CampaignDto>>($"/api/marketing/campaigns?{string.Join('&', parts)}");
        list = result.Value;
        message = result.IsSuccess ? null : result.Error;
    }

    private RenderFragment Cell(GridColumnDef column, CampaignDto c) => @<td data-label="@column.Label" class="@(column.Key == "name" ? "primary" : null)">@CellContent(column.Key, c)</td>;

    private RenderFragment CellContent(string key, CampaignDto c) => key switch
    {
        "name" => @<text><a href="pazarlama/kampanyalar/@c.Id">@c.Name</a> <small class="text-muted">@c.Code@(c.Purpose is null ? null : " · " + c.Purpose)</small></text>,
        "target" => @<text>@MarketingLabels.Label(MarketingLabels.Targets, c.Target)</text>,
        "channel" => @<text>@MarketingLabels.Label(MarketingLabels.Channels, c.Channel)</text>,
        "period" => @<text>@Period(c)</text>,
        "status" => @<span class="badge stage-@(c.Status == "Archived" ? "cancelled" : "lead")">@MarketingLabels.Label(MarketingLabels.CampaignStatuses, c.Status)</span>,
        "budget" => @<text>@Budget(c)</text>,
        _ => @<text></text>,
    };

    private static string Budget(CampaignDto c) => c.Budget is { } budget ? $"{budget:N2} {c.CostCurrency ?? "TRY"}" : "—";

    private static string Period(CampaignDto c) => (c.StartsOn, c.EndsOn) switch
    {
        ({ } s, { } e) => $"{s:dd.MM.yyyy} – {e:dd.MM.yyyy}",
        ({ } s, null) => $"{s:dd.MM.yyyy} –",
        (null, { } e) => $"– {e:dd.MM.yyyy}",
        _ => "—",
    };
}
