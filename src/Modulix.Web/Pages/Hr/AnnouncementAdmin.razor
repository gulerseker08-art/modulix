@page "/ik/duyuru-yonetimi"
@using System.Text.Json.Nodes
@inject ApiClient Api
@inject SessionState Session
@inject CrmLookups Lookups

<PageTitle>Duyuru yönetimi · Modulix</PageTitle>

@* Duyuru yönetimi (ADR-0042 dilim 6): taslak, yayında ve süresi geçmiş bütün duyurular; yazma, yayınlama, sabitleme, hedef departman ve kimin
   okuduğu. Okurlar duyuruları "Duyurular" akışında görür. *@
<AuthGate Module="@HrAccess.ModuleKey" Permission="@HrAccess.AnnouncementsManage">
    <PageHeader Title="Duyuru yönetimi" Icon="bell" Subtitle="@(page is null ? "Duyuru yazın, yayınlayın ve okunma durumunu izleyin." : $"{page.TotalCount} duyuru")" />

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }

    @if (editing)
    {
        <AnnouncementEditor @key="selected?.Id" Announcement="selected" Lookups="Lookups" Saved="SavedAsync" Cancelled="() => editing = false" />
        @if (selected is not null)
        {
            <AttachmentPanel EntityKey="@HrAccess.AnnouncementEntityKey" RecordId="selected.Id" CanWrite="true" Title="Ekler" EmptyText="Bu duyurunun eki yok." />
            <section aria-label="Okuyanlar">
                <div class="list-toolbar mt-3"><h3 class="h6 mb-0 me-auto">Okuyanlar</h3></div>
                @if (reads is null || reads.Count == 0)
                {
                    <EmptyState Compact="true" Icon="eye" Title="Henüz kimse okumadı." />
                }
                else
                {
                    <ul class="profile-cards list-unstyled">
                        @foreach (var read in reads)
                        {
                            <li class="profile-card">
                                <strong>@Lookups.MemberName(WarehouseLabels.Id(read, "userId"))</strong>
                                <span>@(DateTimeOffset.TryParse(WarehouseLabels.Text(read, "readAt"), out var at) ? at.LocalDateTime.ToString("dd.MM.yyyy HH:mm") : "")</span>
                            </li>
                        }
                    </ul>
                }
            </section>
        }
    }

    <ViewTabs Items="ViewOptions" Value="@view" ValueChanged="ChooseViewAsync" Label="Duyuru görünümleri" NewView="StartNaming" NewViewText="Görünüm" />

    <div class="list-toolbar">
        <form class="search" @onsubmit="() => LoadAsync(1)" @onsubmit:preventDefault>
            <input class="form-control" type="search" aria-label="Duyuru ara" placeholder="Başlık ya da metinde ara" @bind="search" />
        </form>
        <GridColumnPicker State="grid" Changed="ColumnsChanged" />
        @if (!editing)
        {
            <button type="button" class="btn btn-primary" @onclick="() => OpenAsync(null)"><AppIcon Name="plus" Size="16" /> Yeni duyuru</button>
        }
    </div>

    <PersonalViewBar Active="Active" Dirty="grid.Differs(Active)" Naming="views.Naming" NamingChanged="views.StartNaming" Error="@views.Error"
                     SaveAs="SaveAsAsync" UpdateView="UpdateViewAsync" DiscardChanges="DiscardAsync" DeleteView="DeleteViewAsync" />

    @if (page is null)
    {
        <LoadingState Kind="LoadingKind.Table" />
    }
    else if (page.Items.Count == 0)
    {
        <EmptyState Compact="true" Title="Bu görünüme uyan duyuru yok." />
    }
    else
    {
        <p class="visually-hidden" role="status" aria-live="polite">@(page.TotalCount) duyuru listelendi.</p>
        <table class="table record-table">
            <caption class="visually-hidden">Duyurular</caption>
            <thead>
                <tr>
                    @foreach (var column in grid.VisibleColumns)
                    {
                        <GridHeader Column="column" State="grid" SortChanged="SortAsync" />
                    }
                    <th scope="col" class="row-menu-cell"><span class="visually-hidden">Eylemler</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var announcement in page.Items)
                {
                    <tr>
                        @foreach (var column in grid.VisibleColumns)
                        {
                            @Cell(column, announcement)
                        }
                        <td class="row-menu-cell">
                            <RowMenu Label="@($"{WarehouseLabels.Text(announcement, "title")} eylemleri")">
                                <button type="button" class="view-menu-item" role="menuitem" @onclick="() => OpenAsync(announcement)"><AppIcon Name="pencil" Size="16" /> <span>Düzenle</span></button>
                                <button type="button" class="view-menu-item" role="menuitem" @onclick="() => DeleteAsync(announcement)"><AppIcon Name="x" Size="16" /> <span>Sil</span></button>
                            </RowMenu>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager PageSizeChoice="true" Page="page.Page" PageSize="page.PageSize" TotalCount="page.TotalCount" PageChanged="LoadAsync" />
    }
</AuthGate>

@code {
    private static readonly string Url = "/api/records/" + HrAccess.AnnouncementEntityKey;

    private const string AllViews = "all";

    // Sıralama anahtarları kayıt deposunun beyanıdır (AnnouncementRecordStore.SortKeys).
    private static readonly GridColumnDef[] BaseColumns =
    [
        new("title", "Başlık", "bell", "title", "-title", Locked: true),
        new("audience", "Hedef", "users"),
        new("publishOn", "Yayın aralığı", "calendar", "publishOn", "-publishOn"),
        new("readCount", "Okuyan", "eye"),
        new("status", "Durum", "tag"),
    ];

    private readonly GridViewState grid = new("hr.announcement-admin", "-publishOn");
    private PersonalGridViews views = default!;
    private string view = "active=true";
    private (string Key, string Value)? filter = ("active", "true");

    private RecordPageResponse? page;
    private List<RecordResponse>? reads;
    private RecordResponse? selected;
    private bool editing;
    private string? message;
    private string? search;

    private GridViewDto? Active => views.Find(view);

    private IReadOnlyList<ViewOption> ViewOptions =>
    [
        new("active=true", "Yayında", Icon: "bell"),
        new("isPublished=false", "Taslak", Icon: "pencil"),
        new("expired=true", "Süresi geçen", Icon: "history"),
        new("all", "Tüm duyurular", Icon: "list"),
        .. views.Options,
    ];

    protected override async Task OnInitializedAsync()
    {
        views = new PersonalGridViews(Api, "hr.announcement-admin");
        await Session.EnsureLoadedAsync();
        if (Session.Can(HrAccess.AnnouncementsManage))
        {
            await Lookups.LoadAsync();
            grid.Define([.. BaseColumns, .. Lookups.FieldsOf(HrAccess.AnnouncementEntityKey)
                .Select(f => new GridColumnDef("custom." + f.Key, f.Label, "type", DefaultVisible: f.ShowInList))]);
            await views.LoadAsync();
            await LoadAsync(1);
        }
    }

    private async Task ChooseViewAsync(string key)
    {
        view = key;
        views.StartNaming(false);
        if (Active is { } saved)
        {
            grid.Apply(saved);
            filter = GridFilters.Parse(saved.Filters).Select(p => ((string, string)?)(p.Key, p.Value)).FirstOrDefault();
        }
        else
        {
            grid.Reset();
            filter = key == AllViews ? null : (key.Split('=')[0], key.Split('=')[1]);
        }

        await LoadAsync(1);
    }

    private async Task SortAsync(string key)
    {
        grid.Sort = key;
        await LoadAsync(1);
    }

    private Task ColumnsChanged() => Task.CompletedTask;

    private string? CurrentFilters => GridFilters.Build(filter);

    private void StartNaming() => views.StartNaming(true);

    private async Task SaveAsAsync(string name)
    {
        if (await views.SaveAsAsync(grid.ToRequest(name, CurrentFilters)) is { } key)
        {
            view = key;
        }
    }

    private async Task UpdateViewAsync()
    {
        if (Active is { } current)
        {
            await views.UpdateAsync(current, grid.ToRequest(current.Name, CurrentFilters));
        }
    }

    private async Task DiscardAsync() => await ChooseViewAsync(view);

    private async Task DeleteViewAsync()
    {
        if (Active is { } current && await views.DeleteAsync(current))
        {
            await ChooseViewAsync(AllViews);
        }
    }

    private async Task LoadAsync(int pageNumber)
    {
        var url = $"{Url}?page={pageNumber}&pageSize={ListPaging.Size}&search={Uri.EscapeDataString(search ?? string.Empty)}";
        if (grid.Sort != grid.DefaultSort)
        {
            url += $"&sort={Uri.EscapeDataString(grid.Sort)}";
        }

        if (filter is { } f)
        {
            url += $"&{f.Key}={Uri.EscapeDataString(f.Value)}";
        }

        var result = await Api.GetAsync<RecordPageResponse>(url);
        page = result.Value;
        message = result.Error;
    }

    private RenderFragment Cell(GridColumnDef column, RecordResponse record) =>
        @<td data-label="@column.Label" class="@(column.Key == "title" ? "primary" : null)">@CellContent(column.Key, record)</td>;

    private RenderFragment CellContent(string key, RecordResponse record) => key switch
    {
        "title" => @<text>@WarehouseLabels.Text(record, "title") @if (WarehouseLabels.Flag(record, "isPinned")) { <span class="badge stage-qualified">Sabitlenmiş</span> }</text>,
        "audience" => @<text>@HrLabels.Audience(record, Lookups)</text>,
        "publishOn" => @<text>@HrLabels.Date(WarehouseLabels.Text(record, "publishOn")) – @(WarehouseLabels.Text(record, "expiresOn") is { Length: > 0 } e ? HrLabels.Date(e) : "süresiz")</text>,
        "readCount" => @<text>@WarehouseLabels.Number(record, "readCount")</text>,
        "status" => @<span class="badge @(WarehouseLabels.Flag(record, "isPublished") ? "status-customer" : "status-inactive")">@(WarehouseLabels.Flag(record, "isPublished") ? "Yayında" : "Taslak")</span>,
        _ when key.StartsWith("custom.", StringComparison.Ordinal) && Lookups.FieldsOf(HrAccess.AnnouncementEntityKey).FirstOrDefault(f => "custom." + f.Key == key) is { } field =>
            @<text>@CustomFieldText.Format(field, record.Values["custom"] as JsonObject)</text>,
        _ => @<text></text>,
    };

    private async Task OpenAsync(RecordResponse? announcement)
    {
        selected = announcement;
        editing = true;
        reads = null;
        if (announcement is not null)
        {
            var result = await Api.GetAsync<RecordPageResponse>($"/api/records/{HrAccess.AnnouncementReadEntityKey}?announcementId={announcement.Id}&pageSize=200");
            reads = result.Value?.Items.ToList() ?? [];
        }
    }

    private async Task SavedAsync(RecordResponse saved)
    {
        editing = false;
        await LoadAsync(page?.Page ?? 1);
    }

    private async Task DeleteAsync(RecordResponse announcement)
    {
        var result = await Api.DeleteAsync($"{Url}/{announcement.Id}?version={announcement.Version}");
        message = result.IsSuccess ? null : result.Error;
        if (result.IsSuccess && selected?.Id == announcement.Id)
        {
            editing = false;
        }

        await LoadAsync(page?.Page ?? 1);
    }
}
