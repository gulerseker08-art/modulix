@page "/ik/gorevlerim"
@inject SessionState Session

<PageTitle>Görevlerim · Modulix</PageTitle>

@* Kullanıcıya atanan işe giriş/çıkış görevleri (ADR-0042 dilim 5); süreç yönetimi izni olana ayrıca İK görevleri. Görünürlük sunucudadır. *@
<AuthGate Module="@HrAccess.ModuleKey" Permission="@HrAccess.ChecklistsRead">
    <PageHeader Title="Görevlerim" Icon="check-circle" Subtitle="İşe giriş ve işten çıkış süreçlerinde size düşen görevler." />

    @if (Session.User is { } user)
    {
        <ChecklistTaskList Title="Bana atanan açık görevler" EmptyText="Size atanmış açık görev yok." Query="@($"assigneeUserId={user.UserId}&status=open&sort=dueDate")" ShowEmployee="true" />
        @if (Session.Can(HrAccess.ChecklistsManage))
        {
            <ChecklistTaskList Title="İK görevleri" EmptyText="Açık İK görevi yok." Query="responsibleRole=hr&status=open&sort=dueDate" ShowEmployee="true" />
        }
    }
</AuthGate>
