@page "/ik/giris-cikis"
@inject ApiClient Api
@inject SessionState Session
@inject CrmLookups Lookups

<PageTitle>İşe giriş ve çıkış · Modulix</PageTitle>

@* İşe giriş/çıkış süreçleri (ADR-0042 dilim 5): başlatılan süreçler, ilerleme, görevler ve iptal. Süreç şablondan başlatılır (görevler tek işlemde
   açılır). Çıkış sürecindeki "zimmet iadesi" görevi açık zimmet varken tamamlanamaz. Görünürlük sunucudadır (kapsam + kendisine görev atanan). *@
<AuthGate Module="@HrAccess.ModuleKey" Permission="@HrAccess.ChecklistsRead">
    <PageHeader Title="İşe giriş ve çıkış" Icon="user-check" Subtitle="@(page is null ? "Çalışanların işe giriş ve işten çıkış süreçlerini izleyin." : $"{page.TotalCount} süreç")" />

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }

    @if (starting)
    {
        <form class="record-form" novalidate @onsubmit="StartAsync" @onsubmit:preventDefault aria-label="Süreç başlat">
            <div class="form-toolbar">
                <div><h2>Süreç başlat</h2><p>Şablonun adımları çalışana görev olarak açılır.</p></div>
                <div class="form-toolbar-actions">
                    <button type="button" class="btn btn-outline-secondary" @onclick="() => starting = false">İptal</button>
                    <button type="submit" class="btn btn-primary" disabled="@busy" aria-busy="@(busy ? "true" : null)">Başlat</button>
                </div>
            </div>
            <div class="form-grid">
                <div class="span-6">
                    <label class="form-label required" for="start-employee">Çalışan</label>
                    <LookupPicker Id="start-employee" LookupKey="@HrAccess.ChecklistEmployeeLookup" @bind-Value="startEmployee" Required="true" Placeholder="Çalışanı seçin…" Invalid="@(errors?.ContainsKey("employeeId") == true)" />
                    <FieldError Field="employeeId" Errors="errors" />
                </div>
                <div class="span-6">
                    <label class="form-label required" for="start-template">Şablon</label>
                    <LookupPicker Id="start-template" LookupKey="@HrAccess.ChecklistTemplateLookup" @bind-Value="startTemplate" Required="true" Placeholder="Etkin şablonu seçin…" Invalid="@(errors?.ContainsKey("templateId") == true)" />
                    <FieldError Field="templateId" Errors="errors" />
                </div>
                <div class="span-6">
                    <label class="form-label required" for="start-date">Başlangıç günü</label>
                    <input id="start-date" class="form-control" type="date" required aria-required="true" @bind="startDate" />
                    <FieldError Field="startDate" Errors="errors" />
                    <small class="text-muted">İşe girişte giriş tarihi, çıkışta ayrılış tarihi; görev son tarihleri buna göre hesaplanır.</small>
                </div>
            </div>
        </form>
    }

    @if (selected is not null)
    {
        <section class="record-form sectioned" aria-label="Süreç">
            <div class="form-toolbar">
                <div>
                    <h2>@WarehouseLabels.Text(selected, "name")</h2>
                    <p>@WarehouseLabels.Text(selected, "employeeName") · @HrLabels.ChecklistKind(WarehouseLabels.Text(selected, "kind")) · başlangıç @HrLabels.Date(WarehouseLabels.Text(selected, "startDate"))</p>
                </div>
                <div class="form-toolbar-actions">
                    <button type="button" class="btn btn-outline-secondary" @onclick="() => selected = null">Kapat</button>
                </div>
            </div>
            <LeaveActionsBar Record="selected" BaseUrl="/api/hr/employee-checklists" Changed="ChecklistChangedAsync" />
            <div class="stat-grid">
                <div class="stat-card"><span>İlerleme</span><strong>@WarehouseLabels.Number(selected, "closedCount") / @WarehouseLabels.Number(selected, "taskCount")</strong></div>
                <div class="stat-card"><span>Durum</span><strong><span class="badge @HrLabels.ChecklistStatusBadge(WarehouseLabels.Text(selected, "status"))">@HrLabels.ChecklistStatus(WarehouseLabels.Text(selected, "status"))</span></strong></div>
            </div>
            <ChecklistTaskList Title="Görevler" EmptyText="Bu süreçte görev yok." Query="@($"checklistId={selected.Id}")" Changed="RefreshSelectedAsync" />
        </section>
    }

    <ViewTabs Items="ViewOptions" Value="@view" ValueChanged="ChooseViewAsync" Label="Süreç görünümleri" />

    <div class="list-toolbar">
        <form class="search" @onsubmit="() => LoadAsync(1)" @onsubmit:preventDefault>
            <input class="form-control" type="search" aria-label="Süreç ara" placeholder="Çalışan adı ya da şablon ara" @bind="search" />
        </form>
        @if (Session.Can(HrAccess.ChecklistsManage) && !starting)
        {
            <button type="button" class="btn btn-primary" @onclick="OpenStart"><AppIcon Name="plus" Size="16" /> Süreç başlat</button>
        }
    </div>

    @if (page is null)
    {
        <p class="text-muted" role="status">Yükleniyor…</p>
    }
    else if (page.Items.Count == 0)
    {
        <p class="text-muted" role="status">Bu görünüme uyan süreç yok.</p>
    }
    else
    {
        <table class="table record-table">
            <caption class="visually-hidden">İşe giriş ve çıkış süreçleri</caption>
            <thead>
                <tr>
                    <th scope="col"><AppIcon Name="user" Size="14" /> Çalışan</th>
                    <th scope="col"><AppIcon Name="clipboard-list" Size="14" /> Süreç</th>
                    <th scope="col"><AppIcon Name="calendar" Size="14" /> Başlangıç</th>
                    <th scope="col"><AppIcon Name="check-circle" Size="14" /> İlerleme</th>
                    <th scope="col"><AppIcon Name="tag" Size="14" /> Durum</th>
                    <th scope="col" class="row-menu-cell"><span class="visually-hidden">Eylemler</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var checklist in page.Items)
                {
                    <tr>
                        <td data-label="Çalışan" class="primary">@WarehouseLabels.Text(checklist, "employeeName")</td>
                        <td data-label="Süreç">@HrLabels.ChecklistKind(WarehouseLabels.Text(checklist, "kind")) · @WarehouseLabels.Text(checklist, "name")</td>
                        <td data-label="Başlangıç">@HrLabels.Date(WarehouseLabels.Text(checklist, "startDate"))</td>
                        <td data-label="İlerleme">@WarehouseLabels.Number(checklist, "closedCount") / @WarehouseLabels.Number(checklist, "taskCount")</td>
                        <td data-label="Durum"><span class="badge @HrLabels.ChecklistStatusBadge(WarehouseLabels.Text(checklist, "status"))">@HrLabels.ChecklistStatus(WarehouseLabels.Text(checklist, "status"))</span></td>
                        <td class="row-menu-cell">
                            <RowMenu Label="@($"{WarehouseLabels.Text(checklist, "employeeName")} süreci eylemleri")">
                                <button type="button" class="view-menu-item" role="menuitem" @onclick="() => Open(checklist)"><AppIcon Name="eye" Size="16" /> <span>Aç</span></button>
                            </RowMenu>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager PageSizeChoice="true" Page="page.Page" PageSize="page.PageSize" TotalCount="page.TotalCount" PageChanged="LoadAsync" />
    }
</AuthGate>

@code {
    private static readonly string Url = "/api/records/" + HrAccess.EmployeeChecklistEntityKey;

    private RecordPageResponse? page;
    private RecordResponse? selected;
    private IReadOnlyDictionary<string, string[]>? errors;
    private string? message;
    private string? search;
    private string view = "open";
    private bool starting;
    private bool busy;
    private Guid? startEmployee;
    private Guid? startTemplate;
    private DateOnly? startDate;

    private static IReadOnlyList<ViewOption> ViewOptions { get; } =
    [
        new("open", "Süren süreçler", Icon: "hourglass"),
        new("open:onboarding", "İşe giriş", Icon: "user-check"),
        new("open:offboarding", "İşten çıkış", Icon: "log-out"),
        new("completed", "Tamamlanan", Icon: "check-circle"),
        new("all", "Tüm süreçler", Icon: "list"),
    ];

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (Session.Can(HrAccess.ChecklistsRead))
        {
            await Lookups.LoadAsync();
            await LoadAsync(1);
        }
    }

    private async Task ChooseViewAsync(string key)
    {
        view = key;
        await LoadAsync(1);
    }

    private async Task LoadAsync(int pageNumber)
    {
        var url = $"{Url}?page={pageNumber}&pageSize={ListPaging.Size}&search={Uri.EscapeDataString(search ?? string.Empty)}";
        var parts = view.Split(':');
        if (parts[0] != "all")
        {
            url += $"&status={parts[0]}";
        }

        if (parts.Length > 1)
        {
            url += $"&kind={parts[1]}";
        }

        var result = await Api.GetAsync<RecordPageResponse>(url);
        page = result.Value;
        message = result.Error;
    }

    private void OpenStart()
    {
        selected = null;
        starting = true;
        errors = null;
        startEmployee = startTemplate = null;
        startDate = DateOnly.FromDateTime(DateTime.Today);
    }

    private async Task StartAsync()
    {
        if (startEmployee is not { } employee || startTemplate is not { } template || startDate is not { } day)
        {
            errors = new Dictionary<string, string[]> { ["employeeId"] = ["Çalışan, şablon ve başlangıç günü zorunludur."] };
            return;
        }

        busy = true;
        message = null;
        errors = null;
        var result = await Api.PostAsync<RecordResponse>("/api/hr/employee-checklists/start", new StartChecklistRequest(employee, template, day));
        busy = false;
        if (!result.IsSuccess)
        {
            errors = result.FieldErrors;
            message = result.FieldErrors is { Count: > 0 } ? null : result.Error;
            return;
        }

        starting = false;
        selected = result.Value;
        await LoadAsync(1);
    }

    private void Open(RecordResponse checklist)
    {
        starting = false;
        selected = checklist;
    }

    private async Task ChecklistChangedAsync(RecordResponse changed)
    {
        selected = changed;
        await LoadAsync(page?.Page ?? 1);
    }

    /// <summary>Görev değişince sürecin ilerlemesi ve durumu sunucudan yeniden okunur.</summary>
    private async Task RefreshSelectedAsync()
    {
        if (selected is not null && (await Api.GetAsync<RecordResponse>($"{Url}/{selected.Id}")).Value is { } fresh)
        {
            selected = fresh;
        }

        await LoadAsync(page?.Page ?? 1);
    }
}
