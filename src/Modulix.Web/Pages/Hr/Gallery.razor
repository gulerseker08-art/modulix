@page "/ik/galeri"
@inject ApiClient Api
@inject SessionState Session

<PageTitle>Galeri · Modulix</PageTitle>

@* Fotoğraf galerisi (ADR-0042 dilim 8): yayındaki albümler, etkinlik gününe göre en yeni üstte; albüm açılınca fotoğrafları görünür. Fotoğraf
   erişimi albümün erişimidir (sunucu denetler). *@
<AuthGate Module="@HrAccess.ModuleKey" Permission="@HrAccess.GalleryRead">
    <PageHeader Title="Galeri" Icon="image" Subtitle="@(page is null ? "Etkinlik fotoğrafları." : $"{page.TotalCount} albüm")" />

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }

    @if (selected is not null)
    {
        <section class="summary-card mb-3" aria-label="@WarehouseLabels.Text(selected, "title")">
            <div class="list-toolbar mb-1">
                <h2 class="h6 mb-0 me-auto">@WarehouseLabels.Text(selected, "title")</h2>
                <button type="button" class="btn btn-outline-secondary" @onclick="() => selected = null">Kapat</button>
            </div>
            @if (WarehouseLabels.Text(selected, "description") is { Length: > 0 } description)
            {
                <p class="preline">@description</p>
            }
            <AlbumPhotos @key="selected.Id" AlbumId="selected.Id" Title="@(WarehouseLabels.Text(selected, "title") ?? "Albüm")" />
        </section>
    }

    @if (page is null)
    {
        <LoadingState />
    }
    else if (page.Items.Count == 0)
    {
        <EmptyState Compact="true" Title="Henüz yayında albüm yok." />
    }
    else
    {
        <ul class="profile-cards list-unstyled" aria-label="Albümler">
            @foreach (var album in page.Items)
            {
                <li>
                    <button type="button" class="profile-card w-100 @(selected?.Id == album.Id ? "active" : null)" aria-pressed="@(selected?.Id == album.Id ? "true" : "false")"
                            @onclick="() => selected = album">
                        <AppIcon Name="image" Size="20" />
                        <strong>@WarehouseLabels.Text(album, "title")</strong>
                        <span>@(WarehouseLabels.Text(album, "eventDate") is { Length: > 0 } day ? HrLabels.Date(day) : "Tarihsiz")</span>
                    </button>
                </li>
            }
        </ul>
        <Pager Page="page.Page" PageSize="page.PageSize" TotalCount="page.TotalCount" PageChanged="LoadAsync" />
    }
</AuthGate>

@code {
    private RecordPageResponse? page;
    private RecordResponse? selected;
    private string? message;

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (Session.Can(HrAccess.GalleryRead))
        {
            await LoadAsync(1);
        }
    }

    private async Task LoadAsync(int pageNumber)
    {
        var result = await Api.GetAsync<RecordPageResponse>($"/api/records/{HrAccess.PhotoAlbumEntityKey}?isPublished=true&page={pageNumber}&pageSize={ListPaging.Size}");
        page = result.Value;
        message = result.Error;
    }
}
