@page "/ik/organizasyon-semasi"
@inject ApiClient Api
@inject SessionState Session
@inject CrmLookups Lookups

<PageTitle>Organizasyon şeması · Modulix</PageTitle>

@* Organizasyon şeması (ADR-0042 dilim 1): ayrılmamış çalışanların yönetici bağından çizilen ağaç. Yöneticisi olmayan (ya da yöneticisi
   ayrılmış) çalışan köktür. Döngü sunucuda engellenir; yine de ziyaret edilen düğüm ikinci kez çizilmez. Departman süzgeci ağacı daraltmaz,
   yalnızca o departmandaki (alt departmanlar dahil; departmanlar Core'dan, bölüm 22) kişileri vurgular (yönetim zinciri bozulmasın diye). *@
<AuthGate Module="@HrAccess.ModuleKey" Permission="@HrAccess.EmployeesRead">
    <PageHeader Title="Organizasyon şeması" Icon="layers" Subtitle="@(employees is null ? "Yönetici bağlarına göre kurum yapısı." : $"{employees.Count} çalışan · {roots.Count} üst düzey")" />

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }

    <div class="list-toolbar">
        <div class="w-auto">
            <HrBusinessUnitSelect AriaLabel="Vurgulanacak departman" EmptyLabel="Departman vurgusu yok" Value="highlightUnit" ValueChanged="Highlight" Loaded="u => units = u" />
        </div>
    </div>

    @if (employees is null)
    {
        <LoadingState />
    }
    else if (employees.Count == 0)
    {
        <EmptyState Icon="layers" Title="Henüz çalışan kartı yok." Text="Şema, çalışan kartlarındaki yönetici bağlarından çizilir." />
    }
    else
    {
        @if (truncated)
        {
            <div class="alert alert-info" role="status">Şema ilk @MaxEmployees çalışanla çizildi; tamamı için Çalışanlar listesini kullanın.</div>
        }
        <ul class="org-tree" role="tree" aria-label="Organizasyon şeması">
            @foreach (var root in roots)
            {
                @Node(root, 1)
            }
        </ul>
    }
</AuthGate>

@code {
    private const int PageSize = 200;
    private const int MaxEmployees = 2000;
    private static readonly string Url = "/api/records/" + HrAccess.EmployeeEntityKey;

    private List<RecordResponse>? employees;
    private List<RecordResponse> roots = [];
    private ILookup<Guid, RecordResponse> reports = Enumerable.Empty<RecordResponse>().ToLookup(_ => Guid.Empty);
    private HashSet<Guid> drawn = [];
    private string? message;
    private IReadOnlyList<HrBusinessUnitDto> units = [];
    private Guid? highlightUnit;
    private HashSet<Guid> highlighted = [];
    private bool truncated;

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (!Session.Can(HrAccess.EmployeesRead))
        {
            return;
        }

        await Lookups.LoadAsync();
        var all = new List<RecordResponse>();
        for (var pageNumber = 1; all.Count < MaxEmployees; pageNumber++)
        {
            var result = await Api.GetAsync<RecordPageResponse>($"{Url}?page={pageNumber}&pageSize={PageSize}&current=true");
            if (result.Value is not { } page)
            {
                message = result.Error;
                break;
            }

            all.AddRange(page.Items);
            if (all.Count >= page.TotalCount || page.Items.Count == 0)
            {
                break;
            }
        }

        truncated = all.Count >= MaxEmployees;
        var ids = all.Select(e => e.Id).ToHashSet();
        reports = all.Where(e => WarehouseLabels.Id(e, "managerEmployeeId") is { } m && ids.Contains(m))
            .ToLookup(e => WarehouseLabels.Id(e, "managerEmployeeId")!.Value);
        roots = [.. all.Where(e => WarehouseLabels.Id(e, "managerEmployeeId") is not { } m || !ids.Contains(m)).OrderBy(HrLabels.Name)];
        employees = all;
    }

    protected override bool ShouldRender()
    {
        drawn = [];
        return true;
    }

    private RenderFragment Node(RecordResponse employee, int level) => __builder =>
    {
        if (!drawn.Add(employee.Id))
        {
            return;
        }

        var children = reports[employee.Id].OrderBy(HrLabels.Name).ToList();
        var department = WarehouseLabels.Text(employee, "businessUnitName");
        var active = WarehouseLabels.Id(employee, "businessUnitId") is { } unit && highlighted.Contains(unit);
        <li role="treeitem" aria-level="@level" aria-expanded="@(children.Count > 0 ? "true" : null)">
            <div class="org-node @(active ? "active" : null)">
                <span class="avatar avatar-tone-@(Math.Abs(employee.Id.GetHashCode()) % 5)" aria-hidden="true">@HrLabels.Initials(employee)</span>
                <span>
                    <strong>@HrLabels.Name(employee)</strong>
                    <small>@(string.IsNullOrWhiteSpace(WarehouseLabels.Text(employee, "jobTitle")) ? "Unvan girilmedi" : WarehouseLabels.Text(employee, "jobTitle"))@(department.Length > 0 ? $" · {department}" : "")@(children.Count > 0 ? $" · {children.Count} kişi bağlı" : "")</small>
                </span>
            </div>
            @if (children.Count > 0)
            {
                <ul role="group">
                    @foreach (var child in children)
                    {
                        @Node(child, level + 1)
                    }
                </ul>
            }
        </li>
    };

    /// <summary>Seçilen departman ve bütün alt departmanları vurgulanır.</summary>
    private void Highlight(Guid? unit)
    {
        highlightUnit = unit;
        highlighted = unit is { } root ? [root] : [];
        bool added;
        do
        {
            added = false;
            foreach (var child in units.Where(u => u.ParentId is { } parent && highlighted.Contains(parent)))
            {
                added |= highlighted.Add(child.Id);
            }
        }
        while (added);
    }
}
