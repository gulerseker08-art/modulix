@page "/ik/izin-talepleri"
@using System.Text.Json.Nodes
@inject ApiClient Api
@inject SessionState Session
@inject CrmLookups Lookups

<PageTitle>İzin talepleri · Modulix</PageTitle>

@* İzin talepleri (ADR-0042 dilim 2): yönetici onaylayanı olduğu talepleri, İK bütün talepleri görür (görünürlük sunucuda, veri kapsamı +
   onaylayan). "Onayımı bekleyenler" görünümü onaylayanı kullanıcının kendisi olan bekleyen taleplerdir. Satır açılınca talep özeti ve eylemler
   (onayla, reddet, iptal) gelir; talep değiştirilmez. *@
<AuthGate Module="@HrAccess.ModuleKey" Permission="@HrAccess.LeavesRead">
    <PageHeader Title="İzin talepleri" Icon="calendar" Subtitle="@(page is null ? "İzin taleplerini görün, onaylayın ya da reddedin." : $"{page.TotalCount} kayıt")" />

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }

    @if (creating)
    {
        <LeaveRequestEditor Lookups="Lookups" Saved="SavedAsync" Cancelled="() => creating = false" />
    }
    else if (selected is not null)
    {
        <LeaveRequestCard Request="selected" Changed="ChangedAsync" Closed="() => selected = null" />
    }

    <ViewTabs Items="ViewOptions" Value="@view" ValueChanged="ChooseViewAsync" Label="İzin talebi görünümleri" NewView="StartNaming" NewViewText="Görünüm" />

    <div class="list-toolbar">
        <form class="search" @onsubmit="() => LoadAsync(1)" @onsubmit:preventDefault>
            <input class="form-control" type="search" aria-label="İzin talebi ara" placeholder="Çalışan adı ya da açıklama ara" @bind="search" />
        </form>
        <FilterToggle @bind-Open="filtersOpen" Count="@(string.IsNullOrEmpty(leaveTypeKey) ? 0 : 1)" />
        <GridColumnPicker State="grid" Changed="ColumnsChanged" />
        @if (Session.Can(HrAccess.LeavesManage) && !creating)
        {
            <button type="button" class="btn btn-primary" @onclick="Create"><AppIcon Name="plus" Size="16" /> Yeni izin talebi</button>
        }
    </div>

    @if (filtersOpen || !string.IsNullOrEmpty(leaveTypeKey))
    {
        <div class="filters">
            <select class="form-select" aria-label="İzin türü" @bind="leaveTypeKey" @bind:after="() => LoadAsync(1)">
                <option value="">Tüm izin türleri</option>
                @foreach (var type in Lookups.ValuesOf(HrAccess.LeaveTypeList))
                {
                    <option value="@type.Key">@type.Label</option>
                }
            </select>
        </div>
    }

    <PersonalViewBar Active="Active" Dirty="grid.Differs(Active)" Naming="views.Naming" NamingChanged="views.StartNaming" Error="@views.Error"
                     SaveAs="SaveAsAsync" UpdateView="UpdateViewAsync" DiscardChanges="DiscardAsync" DeleteView="DeleteViewAsync" />

    @if (page is null)
    {
        <p class="text-muted" role="status">Yükleniyor…</p>
    }
    else if (page.Items.Count == 0)
    {
        <p class="text-muted" role="status">Bu görünüme uyan izin talebi yok.</p>
    }
    else
    {
        <p class="visually-hidden" role="status" aria-live="polite">@(page.TotalCount) izin talebi listelendi.</p>
        <table class="table record-table">
            <caption class="visually-hidden">İzin talepleri</caption>
            <thead>
                <tr>
                    @foreach (var column in grid.VisibleColumns)
                    {
                        <GridHeader Column="column" State="grid" SortChanged="SortAsync" />
                    }
                    <th scope="col" class="row-menu-cell"><span class="visually-hidden">Eylemler</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var request in page.Items)
                {
                    <tr>
                        @foreach (var column in grid.VisibleColumns)
                        {
                            @Cell(column, request)
                        }
                        <td class="row-menu-cell">
                            <RowMenu Label="@($"{WarehouseLabels.Text(request, "employeeName")} talebi eylemleri")">
                                <button type="button" class="view-menu-item" role="menuitem" @onclick="() => Open(request)"><AppIcon Name="eye" Size="16" /> <span>Aç ve karar ver</span></button>
                            </RowMenu>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager PageSizeChoice="true" Page="page.Page" PageSize="page.PageSize" TotalCount="page.TotalCount" PageChanged="LoadAsync" />
    }
</AuthGate>

@code {
    private static readonly string Url = "/api/records/" + HrAccess.LeaveRequestEntityKey;

    private const string MineToApprove = "toApprove";
    private const string PendingView = "pending";
    private const string ApprovedView = "approved";
    private const string RejectedView = "rejected";
    private const string AllViews = "all";

    // Sıralama anahtarları kayıt deposunun beyanıdır (LeaveRequestRecordStore.SortKeys).
    private static readonly GridColumnDef[] BaseColumns =
    [
        new("employee", "Çalışan", "user", "employee", "-employee", Locked: true),
        new("leaveType", "İzin türü", "tag", "leaveTypeKey", "-leaveTypeKey"),
        new("range", "Tarih", "calendar", "startDate", "-startDate"),
        new("days", "Süre", "clock", "days", "-days"),
        new("approver", "Onaylayan", "user-check"),
        new("status", "Durum", "check-circle", "status", "-status"),
    ];

    private readonly GridViewState grid = new("hr.leave-requests", "-startDate");
    private PersonalGridViews views = default!;
    private RecordPageResponse? page;
    private RecordResponse? selected;
    private bool creating;
    private bool filtersOpen;
    private string? message;
    private string? search;
    private string view = PendingView;
    private string? status = "pending";
    private bool toApprove;
    private string? leaveTypeKey;

    protected override async Task OnInitializedAsync()
    {
        views = new PersonalGridViews(Api, "hr.leave-requests");
        await Session.EnsureLoadedAsync();
        if (Session.Can(HrAccess.LeavesRead))
        {
            await Lookups.LoadAsync();
            grid.Define([.. BaseColumns, .. Lookups.FieldsOf(HrAccess.LeaveRequestEntityKey).Select(f => new GridColumnDef("custom." + f.Key, f.Label, "type", DefaultVisible: f.ShowInList))]);
            await views.LoadAsync();
            if (Session.Can(HrAccess.LeavesApprove) && !Session.Can(HrAccess.LeavesManage))
            {
                view = MineToApprove;
                toApprove = true;
            }

            await LoadAsync(1);
        }
    }

    private GridViewDto? Active => views.Find(view);

    private IReadOnlyList<ViewOption> ViewOptions =>
    [
        .. Session.Can(HrAccess.LeavesApprove) ? new[] { new ViewOption(MineToApprove, "Onayımı bekleyenler", Icon: "user-check") } : Array.Empty<ViewOption>(),
        new(PendingView, "Onay bekleyen", Icon: "hourglass"),
        new(ApprovedView, "Onaylanan", Icon: "check-circle"),
        new(RejectedView, "Reddedilen", Icon: "x"),
        new(AllViews, "Tüm talepler", Icon: "list"),
        .. views.Options,
    ];

    private async Task ChooseViewAsync(string key)
    {
        view = key;
        views.StartNaming(false);
        if (Active is { } saved)
        {
            grid.Apply(saved);
            var filters = GridFilters.Parse(saved.Filters);
            status = filters.GetValueOrDefault("status");
            toApprove = filters.GetValueOrDefault("approverUserId") is not null;
            leaveTypeKey = filters.GetValueOrDefault("leaveTypeKey");
        }
        else
        {
            grid.Reset();
            status = key switch { MineToApprove or PendingView => "pending", ApprovedView => "approved", RejectedView => "rejected", _ => null };
            toApprove = key == MineToApprove;
        }

        await LoadAsync(1);
    }

    private async Task SortAsync(string key)
    {
        grid.Sort = key;
        await LoadAsync(1);
    }

    private Task ColumnsChanged() => Task.CompletedTask;

    private Guid? Me => Session.User?.UserId;

    private string? CurrentFilters => GridFilters.Build(
        status is { } s ? ("status", s) : null,
        toApprove && Me is { } me ? ("approverUserId", me.ToString()) : null,
        string.IsNullOrEmpty(leaveTypeKey) ? null : ("leaveTypeKey", leaveTypeKey));

    private void StartNaming() => views.StartNaming(true);

    private async Task SaveAsAsync(string name)
    {
        if (await views.SaveAsAsync(grid.ToRequest(name, CurrentFilters)) is { } key)
        {
            view = key;
        }
    }

    private async Task UpdateViewAsync()
    {
        if (Active is { } current)
        {
            await views.UpdateAsync(current, grid.ToRequest(current.Name, CurrentFilters));
        }
    }

    private async Task DiscardAsync() => await ChooseViewAsync(view);

    private async Task DeleteViewAsync()
    {
        if (Active is { } current && await views.DeleteAsync(current))
        {
            await ChooseViewAsync(PendingView);
        }
    }

    private async Task LoadAsync(int pageNumber)
    {
        var url = $"{Url}?page={pageNumber}&pageSize={ListPaging.Size}&search={Uri.EscapeDataString(search ?? string.Empty)}";
        if (grid.Sort != grid.DefaultSort)
        {
            url += $"&sort={Uri.EscapeDataString(grid.Sort)}";
        }

        if (status is { } s)
        {
            url += $"&status={s}";
        }

        if (toApprove && Me is { } me)
        {
            url += $"&approverUserId={me}";
        }

        if (!string.IsNullOrEmpty(leaveTypeKey))
        {
            url += $"&leaveTypeKey={Uri.EscapeDataString(leaveTypeKey)}";
        }

        var result = await Api.GetAsync<RecordPageResponse>(url);
        page = result.Value;
        message = result.Error;
    }

    private RenderFragment Cell(GridColumnDef column, RecordResponse request) => @<td data-label="@column.Label" class="@(column.Key == "employee" ? "primary" : null)">@CellContent(column.Key, request)</td>;

    private RenderFragment CellContent(string key, RecordResponse request) => key switch
    {
        "employee" => @<text>@(WarehouseLabels.Text(request, "employeeName") is { Length: > 0 } name ? name : "—")</text>,
        "leaveType" => @<text>@Lookups.Label(HrAccess.LeaveTypeList, WarehouseLabels.Text(request, "leaveTypeKey"))</text>,
        "range" => @<text>@HrLabels.Range(request)</text>,
        "days" => @<text>@HrLabels.Days(HrLabels.Decimal(request, "days"))</text>,
        "approver" => @<text>@(WarehouseLabels.Id(request, "approverUserId") is { } approver ? Lookups.MemberName(approver) : "İK")</text>,
        "status" => @<span class="badge @HrLabels.LeaveStatusBadge(WarehouseLabels.Text(request, "status"))">@HrLabels.LeaveStatus(WarehouseLabels.Text(request, "status"))</span>,
        _ when key.StartsWith("custom.", StringComparison.Ordinal) && Lookups.FieldsOf(HrAccess.LeaveRequestEntityKey).FirstOrDefault(f => "custom." + f.Key == key) is { } field =>
            @<text>@CustomFieldText.Format(field, request.Values["custom"] as JsonObject)</text>,
        _ => @<text></text>,
    };

    private void Create()
    {
        selected = null;
        creating = true;
    }

    private void Open(RecordResponse request)
    {
        creating = false;
        selected = request;
    }

    private async Task SavedAsync(RecordResponse created)
    {
        creating = false;
        selected = created;
        await LoadAsync(1);
    }

    private async Task ChangedAsync(RecordResponse changed)
    {
        selected = changed;
        await LoadAsync(page?.Page ?? 1);
    }
}
