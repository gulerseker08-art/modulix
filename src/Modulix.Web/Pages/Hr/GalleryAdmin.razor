@page "/ik/galeri-yonetimi"
@using System.Text.Json.Nodes
@inject ApiClient Api
@inject SessionState Session
@inject CrmLookups Lookups

<PageTitle>Galeri yönetimi · Modulix</PageTitle>

@* Galeri yönetimi (ADR-0042 dilim 8): albüm açma, fotoğraf ekleme ve silme (ADR-0040 dosyaları; albüm başına en çok 20), yayınlama. Okurlar
   yayındaki albümleri "Galeri" ekranında görür. Albüm silinmeden önce fotoğrafları silinmelidir (kaydı silinen albümün dosyaları erişilemez kalır). *@
<AuthGate Module="@HrAccess.ModuleKey" Permission="@HrAccess.GalleryManage">
    <PageHeader Title="Galeri yönetimi" Icon="image" Subtitle="@(page is null ? "Albüm açın, fotoğraf ekleyin ve yayınlayın." : $"{page.TotalCount} albüm")" />

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }

    @if (editing)
    {
        <PhotoAlbumEditor @key="selected?.Id" Album="selected" Lookups="Lookups" Saved="SavedAsync" Cancelled="Close" />
        @if (selected is not null)
        {
            <AttachmentPanel EntityKey="@HrAccess.PhotoAlbumEntityKey" RecordId="selected.Id" CanWrite="true" Title="Fotoğraflar"
                             EmptyText="Henüz fotoğraf eklenmedi." CountChanged="PhotosChanged" />
            <AlbumPhotos AlbumId="selected.Id" Revision="revision" Title="@(WarehouseLabels.Text(selected, "title") ?? "Albüm")" />
        }
    }

    <ViewTabs Items="ViewOptions" Value="@view" ValueChanged="ChooseViewAsync" Label="Albüm görünümleri" NewView="StartNaming" NewViewText="Görünüm" />

    <div class="list-toolbar">
        <form class="search" @onsubmit="() => LoadAsync(1)" @onsubmit:preventDefault>
            <input class="form-control" type="search" aria-label="Albüm ara" placeholder="Başlık ya da açıklamada ara" @bind="search" />
        </form>
        <GridColumnPicker State="grid" Changed="ColumnsChanged" />
        @if (!editing)
        {
            <button type="button" class="btn btn-primary" @onclick="() => Open(null)"><AppIcon Name="plus" Size="16" /> Yeni albüm</button>
        }
    </div>

    <PersonalViewBar Active="Active" Dirty="grid.Differs(Active)" Naming="views.Naming" NamingChanged="views.StartNaming" Error="@views.Error"
                     SaveAs="SaveAsAsync" UpdateView="UpdateViewAsync" DiscardChanges="DiscardAsync" DeleteView="DeleteViewAsync" />

    @if (page is null)
    {
        <p class="text-muted" role="status">Yükleniyor…</p>
    }
    else if (page.Items.Count == 0)
    {
        <p class="text-muted" role="status">Bu görünüme uyan albüm yok.</p>
    }
    else
    {
        <p class="visually-hidden" role="status" aria-live="polite">@(page.TotalCount) albüm listelendi.</p>
        <table class="table record-table">
            <caption class="visually-hidden">Albümler</caption>
            <thead>
                <tr>
                    @foreach (var column in grid.VisibleColumns)
                    {
                        <GridHeader Column="column" State="grid" SortChanged="SortAsync" />
                    }
                    <th scope="col" class="row-menu-cell"><span class="visually-hidden">Eylemler</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var album in page.Items)
                {
                    <tr>
                        @foreach (var column in grid.VisibleColumns)
                        {
                            @Cell(column, album)
                        }
                        <td class="row-menu-cell">
                            <RowMenu Label="@($"{WarehouseLabels.Text(album, "title")} eylemleri")">
                                <button type="button" class="view-menu-item" role="menuitem" @onclick="() => Open(album)"><AppIcon Name="pencil" Size="16" /> <span>Aç</span></button>
                                <button type="button" class="view-menu-item" role="menuitem" @onclick="() => DeleteAsync(album)"><AppIcon Name="x" Size="16" /> <span>Sil</span></button>
                            </RowMenu>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager PageSizeChoice="true" Page="page.Page" PageSize="page.PageSize" TotalCount="page.TotalCount" PageChanged="LoadAsync" />
    }
</AuthGate>

@code {
    private static readonly string Url = "/api/records/" + HrAccess.PhotoAlbumEntityKey;

    private const string AllViews = "all";

    // Sıralama anahtarları kayıt deposunun beyanıdır (PhotoAlbumRecordStore.SortKeys).
    private static readonly GridColumnDef[] BaseColumns =
    [
        new("title", "Başlık", "image", "title", "-title", Locked: true),
        new("eventDate", "Etkinlik günü", "calendar", "eventDate", "-eventDate"),
        new("description", "Açıklama", "type", DefaultVisible: false),
        new("status", "Durum", "tag"),
    ];

    private readonly GridViewState grid = new("hr.gallery-admin", "-eventDate");
    private PersonalGridViews views = default!;
    private string view = "all";
    private (string Key, string Value)? filter = null;

    private RecordPageResponse? page;
    private RecordResponse? selected;
    private bool editing;
    private int revision;
    private string? message;
    private string? search;

    private GridViewDto? Active => views.Find(view);

    private IReadOnlyList<ViewOption> ViewOptions =>
    [
        new("all", "Tüm albümler", Icon: "list"),
        new("isPublished=true", "Yayında", Icon: "image"),
        new("isPublished=false", "Taslak", Icon: "pencil"),
        .. views.Options,
    ];

    protected override async Task OnInitializedAsync()
    {
        views = new PersonalGridViews(Api, "hr.gallery-admin");
        await Session.EnsureLoadedAsync();
        if (Session.Can(HrAccess.GalleryManage))
        {
            await Lookups.LoadAsync();
            grid.Define([.. BaseColumns, .. Lookups.FieldsOf(HrAccess.PhotoAlbumEntityKey)
                .Select(f => new GridColumnDef("custom." + f.Key, f.Label, "type", DefaultVisible: f.ShowInList))]);
            await views.LoadAsync();
            await LoadAsync(1);
        }
    }

    private async Task ChooseViewAsync(string key)
    {
        view = key;
        views.StartNaming(false);
        if (Active is { } saved)
        {
            grid.Apply(saved);
            filter = GridFilters.Parse(saved.Filters).Select(p => ((string, string)?)(p.Key, p.Value)).FirstOrDefault();
        }
        else
        {
            grid.Reset();
            filter = key == AllViews ? null : (key.Split('=')[0], key.Split('=')[1]);
        }

        await LoadAsync(1);
    }

    private async Task SortAsync(string key)
    {
        grid.Sort = key;
        await LoadAsync(1);
    }

    private Task ColumnsChanged() => Task.CompletedTask;

    private string? CurrentFilters => GridFilters.Build(filter);

    private void StartNaming() => views.StartNaming(true);

    private async Task SaveAsAsync(string name)
    {
        if (await views.SaveAsAsync(grid.ToRequest(name, CurrentFilters)) is { } key)
        {
            view = key;
        }
    }

    private async Task UpdateViewAsync()
    {
        if (Active is { } current)
        {
            await views.UpdateAsync(current, grid.ToRequest(current.Name, CurrentFilters));
        }
    }

    private async Task DiscardAsync() => await ChooseViewAsync(view);

    private async Task DeleteViewAsync()
    {
        if (Active is { } current && await views.DeleteAsync(current))
        {
            await ChooseViewAsync(AllViews);
        }
    }

    private async Task LoadAsync(int pageNumber)
    {
        var url = $"{Url}?page={pageNumber}&pageSize={ListPaging.Size}&search={Uri.EscapeDataString(search ?? string.Empty)}";
        if (grid.Sort != grid.DefaultSort)
        {
            url += $"&sort={Uri.EscapeDataString(grid.Sort)}";
        }

        if (filter is { } f)
        {
            url += $"&{f.Key}={Uri.EscapeDataString(f.Value)}";
        }

        var result = await Api.GetAsync<RecordPageResponse>(url);
        page = result.Value;
        message = result.Error;
    }

    private RenderFragment Cell(GridColumnDef column, RecordResponse record) =>
        @<td data-label="@column.Label" class="@(column.Key == "title" ? "primary" : null)">@CellContent(column.Key, record)</td>;

    private RenderFragment CellContent(string key, RecordResponse record) => key switch
    {
        "title" => @<text>@WarehouseLabels.Text(record, "title")</text>,
        "eventDate" => @<text>@(WarehouseLabels.Text(record, "eventDate") is { Length: > 0 } day ? HrLabels.Date(day) : "—")</text>,
        "description" => @<text>@(WarehouseLabels.Text(record, "description") is { Length: > 0 } d ? d : "—")</text>,
        "status" => @<span class="badge @(WarehouseLabels.Flag(record, "isPublished") ? "status-customer" : "status-inactive")">@(WarehouseLabels.Flag(record, "isPublished") ? "Yayında" : "Taslak")</span>,
        _ when key.StartsWith("custom.", StringComparison.Ordinal) && Lookups.FieldsOf(HrAccess.PhotoAlbumEntityKey).FirstOrDefault(f => "custom." + f.Key == key) is { } field =>
            @<text>@CustomFieldText.Format(field, record.Values["custom"] as JsonObject)</text>,
        _ => @<text></text>,
    };

    private void Open(RecordResponse? album)
    {
        selected = album;
        editing = true;
    }

    private void Close()
    {
        editing = false;
        selected = null;
    }

    private void PhotosChanged(int count) => revision++;

    private async Task SavedAsync(RecordResponse saved)
    {
        // Yeni albüm kaydedilince açık kalır: fotoğraf eklenebilsin.
        if (selected is null)
        {
            selected = saved;
        }
        else
        {
            Close();
        }

        await LoadAsync(page?.Page ?? 1);
    }

    private async Task DeleteAsync(RecordResponse album)
    {
        var photos = await Api.GetAsync<List<StoredFileDto>>($"/api/files?entityKey={Uri.EscapeDataString(HrAccess.PhotoAlbumEntityKey)}&recordId={album.Id}");
        if (photos.Value is { Count: > 0 })
        {
            message = "Albümü silmeden önce fotoğraflarını silin (albümü açıp Fotoğraflar bölümünden).";
            return;
        }

        var result = await Api.DeleteAsync($"{Url}/{album.Id}?version={album.Version}");
        message = result.IsSuccess ? null : result.Error;
        if (result.IsSuccess && selected?.Id == album.Id)
        {
            Close();
        }

        await LoadAsync(page?.Page ?? 1);
    }
}
