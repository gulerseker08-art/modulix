@page "/ik/surec-sablonlari"
@using System.Text.Json.Nodes
@inject ApiClient Api
@inject SessionState Session
@inject CrmLookups Lookups

<PageTitle>Süreç şablonları · Modulix</PageTitle>

@* İşe giriş/çıkış şablonları (ADR-0042 dilim 5): şablon ve adımları (başlık, sorumlu, gün farkı, görev türü). Şablon değişikliği yalnızca sonra
   başlatılan süreçleri etkiler; kullanılmış şablon silinmez, pasife alınır. *@
<AuthGate Module="@HrAccess.ModuleKey" Permission="@HrAccess.ChecklistsManage">
    <PageHeader Title="Süreç şablonları" Icon="clipboard-list" Subtitle="@(templates is null ? "İşe giriş ve işten çıkış adımlarını tanımlayın." : $"{templates.TotalCount} şablon")" />

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }

    @if (editing)
    {
        <ChecklistTemplateEditor @key="selected?.Id" Template="selected" Lookups="Lookups" Saved="SavedAsync" Cancelled="() => editing = false" />
        @if (selected is not null)
        {
            @if (editingItem)
            {
                <ChecklistItemEditor @key="selectedItem?.Id" TemplateId="selected.Id" Kind="@WarehouseLabels.Text(selected, "kind")" Item="selectedItem" Lookups="Lookups"
                                     Saved="ItemSavedAsync" Cancelled="() => editingItem = false" />
            }

            <div class="list-toolbar mt-3">
                <h3 class="h6 mb-0 me-auto">Adımlar</h3>
                @if (!editingItem)
                {
                    <button type="button" class="btn btn-tonal" @onclick="() => OpenItem(null)"><AppIcon Name="plus" Size="16" /> Adım ekle</button>
                }
            </div>
            @if (items is null || items.Count == 0)
            {
                <p class="text-muted" role="status">Henüz adım yok. Süreç başlatmak için en az bir adım ekleyin.</p>
            }
            else
            {
                <table class="table record-table">
                    <caption class="visually-hidden">Şablon adımları</caption>
                    <thead>
                        <tr>
                            <th scope="col"><AppIcon Name="hash" Size="14" /> Sıra</th>
                            <th scope="col"><AppIcon Name="check-circle" Size="14" /> Adım</th>
                            <th scope="col"><AppIcon Name="user-check" Size="14" /> Sorumlu</th>
                            <th scope="col"><AppIcon Name="calendar" Size="14" /> Gün farkı</th>
                            <th scope="col"><AppIcon Name="tag" Size="14" /> Tür</th>
                            <th scope="col" class="row-menu-cell"><span class="visually-hidden">Eylemler</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in items)
                        {
                            <tr>
                                <td data-label="Sıra">@WarehouseLabels.Number(item, "sequence")</td>
                                <td data-label="Adım" class="primary">@WarehouseLabels.Text(item, "title")</td>
                                <td data-label="Sorumlu">@HrLabels.Responsible(WarehouseLabels.Text(item, "responsibleRole"))</td>
                                <td data-label="Gün farkı">@WarehouseLabels.Number(item, "dueOffsetDays")</td>
                                <td data-label="Tür">@HrLabels.TaskType(WarehouseLabels.Text(item, "taskType"))</td>
                                <td class="row-menu-cell">
                                    <RowMenu Label="@($"{WarehouseLabels.Text(item, "title")} eylemleri")">
                                        <button type="button" class="view-menu-item" role="menuitem" @onclick="() => OpenItem(item)"><AppIcon Name="pencil" Size="16" /> <span>Düzenle</span></button>
                                        <button type="button" class="view-menu-item" role="menuitem" @onclick="() => DeleteItemAsync(item)"><AppIcon Name="x" Size="16" /> <span>Sil</span></button>
                                    </RowMenu>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        }
    }

    <ViewTabs Items="ViewOptions" Value="@view" ValueChanged="ChooseViewAsync" Label="Şablon görünümleri" NewView="StartNaming" NewViewText="Görünüm" />

    <div class="list-toolbar">
        <form class="search" @onsubmit="() => LoadAsync(1)" @onsubmit:preventDefault>
            <input class="form-control" type="search" aria-label="Şablon ara" placeholder="Şablon adı ara" @bind="search" />
        </form>
        <GridColumnPicker State="grid" Changed="ColumnsChanged" />
        @if (!editing)
        {
            <button type="button" class="btn btn-primary" @onclick="() => Open(null)"><AppIcon Name="plus" Size="16" /> Yeni şablon</button>
        }
    </div>

    <PersonalViewBar Active="Active" Dirty="grid.Differs(Active)" Naming="views.Naming" NamingChanged="views.StartNaming" Error="@views.Error"
                     SaveAs="SaveAsAsync" UpdateView="UpdateViewAsync" DiscardChanges="DiscardAsync" DeleteView="DeleteViewAsync" />

    @if (templates is null)
    {
        <LoadingState Kind="LoadingKind.Table" />
    }
    else if (templates.Items.Count == 0)
    {
        <p class="text-muted" role="status">Bu görünüme uyan şablon yok.</p>
    }
    else
    {
        <p class="visually-hidden" role="status" aria-live="polite">@(templates.TotalCount) şablon listelendi.</p>
        <table class="table record-table">
            <caption class="visually-hidden">Süreç şablonları</caption>
            <thead>
                <tr>
                    @foreach (var column in grid.VisibleColumns)
                    {
                        <GridHeader Column="column" State="grid" SortChanged="SortAsync" />
                    }
                    <th scope="col" class="row-menu-cell"><span class="visually-hidden">Eylemler</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var template in templates.Items)
                {
                    <tr>
                        @foreach (var column in grid.VisibleColumns)
                        {
                            @Cell(column, template)
                        }
                        <td class="row-menu-cell">
                            <RowMenu Label="@($"{WarehouseLabels.Text(template, "name")} eylemleri")">
                                <button type="button" class="view-menu-item" role="menuitem" @onclick="() => Open(template)"><AppIcon Name="pencil" Size="16" /> <span>Düzenle ve adımlar</span></button>
                                <button type="button" class="view-menu-item" role="menuitem" @onclick="() => DeleteAsync(template)"><AppIcon Name="x" Size="16" /> <span>Sil</span></button>
                            </RowMenu>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager PageSizeChoice="true" Page="templates.Page" PageSize="templates.PageSize" TotalCount="templates.TotalCount" PageChanged="LoadAsync" />
    }
</AuthGate>

@code {
    private static readonly string Url = "/api/records/" + HrAccess.ChecklistTemplateEntityKey;

    private const string AllViews = "all";

    // Sıralama anahtarları kayıt deposunun beyanıdır (ChecklistTemplateRecordStore.SortKeys); varsayılan sıra tür, sonra ad.
    private static readonly GridColumnDef[] BaseColumns =
    [
        new("name", "Ad", "clipboard-list", "name", "-name", Locked: true),
        new("kind", "Tür", "tag", "kind", "-kind"),
        new("description", "Açıklama", "type", DefaultVisible: false),
        new("active", "Durum", "check-circle"),
    ];

    private readonly GridViewState grid = new("hr.checklist-templates", "kind");
    private PersonalGridViews views = default!;
    private RecordPageResponse? templates;
    private List<RecordResponse>? items;
    private RecordResponse? selected;
    private RecordResponse? selectedItem;
    private bool editing;
    private bool editingItem;
    private string? message;
    private string? search;
    private string view = AllViews;
    private string? kind;
    private string? isActive;

    private GridViewDto? Active => views.Find(view);

    private IReadOnlyList<ViewOption> ViewOptions =>
    [
        new(AllViews, "Tüm şablonlar", Icon: "list"),
        new("onboarding", "İşe giriş", Icon: "user-check"),
        new("offboarding", "İşten çıkış", Icon: "log-out"),
        new("inactive", "Pasif", Icon: "x"),
        .. views.Options,
    ];

    protected override async Task OnInitializedAsync()
    {
        views = new PersonalGridViews(Api, "hr.checklist-templates");
        await Session.EnsureLoadedAsync();
        if (Session.Can(HrAccess.ChecklistsManage))
        {
            await Lookups.LoadAsync();
            grid.Define([.. BaseColumns, .. Lookups.FieldsOf(HrAccess.ChecklistTemplateEntityKey)
                .Select(f => new GridColumnDef("custom." + f.Key, f.Label, "type", DefaultVisible: f.ShowInList))]);
            await views.LoadAsync();
            await LoadAsync(1);
        }
    }

    private async Task ChooseViewAsync(string key)
    {
        view = key;
        views.StartNaming(false);
        if (Active is { } saved)
        {
            grid.Apply(saved);
            var filters = GridFilters.Parse(saved.Filters);
            kind = filters.GetValueOrDefault("kind");
            isActive = filters.GetValueOrDefault("isActive");
        }
        else
        {
            grid.Reset();
            kind = key is "onboarding" or "offboarding" ? key : null;
            isActive = key == "inactive" ? "false" : null;
        }

        await LoadAsync(1);
    }

    private async Task SortAsync(string key)
    {
        grid.Sort = key;
        await LoadAsync(1);
    }

    private Task ColumnsChanged() => Task.CompletedTask;

    private string? CurrentFilters => GridFilters.Build(kind is { } k ? ("kind", k) : null, isActive is { } a ? ("isActive", a) : null);

    private void StartNaming() => views.StartNaming(true);

    private async Task SaveAsAsync(string name)
    {
        if (await views.SaveAsAsync(grid.ToRequest(name, CurrentFilters)) is { } key)
        {
            view = key;
        }
    }

    private async Task UpdateViewAsync()
    {
        if (Active is { } current)
        {
            await views.UpdateAsync(current, grid.ToRequest(current.Name, CurrentFilters));
        }
    }

    private async Task DiscardAsync() => await ChooseViewAsync(view);

    private async Task DeleteViewAsync()
    {
        if (Active is { } current && await views.DeleteAsync(current))
        {
            await ChooseViewAsync(AllViews);
        }
    }

    private Task ReloadAsync() => LoadAsync(templates?.Page ?? 1);

    private async Task LoadAsync(int pageNumber)
    {
        var url = $"{Url}?page={pageNumber}&pageSize={ListPaging.Size}&search={Uri.EscapeDataString(search ?? string.Empty)}";
        if (grid.Sort != grid.DefaultSort)
        {
            url += $"&sort={Uri.EscapeDataString(grid.Sort)}";
        }

        if (kind is { } k)
        {
            url += $"&kind={Uri.EscapeDataString(k)}";
        }

        if (isActive is { } a)
        {
            url += $"&isActive={a}";
        }

        var result = await Api.GetAsync<RecordPageResponse>(url);
        templates = result.Value;
        message = result.Error;
    }

    private RenderFragment Cell(GridColumnDef column, RecordResponse template) =>
        @<td data-label="@column.Label" class="@(column.Key == "name" ? "primary" : null)">@CellContent(column.Key, template)</td>;

    private RenderFragment CellContent(string key, RecordResponse template) => key switch
    {
        "name" => @<text>@WarehouseLabels.Text(template, "name")</text>,
        "kind" => @<text>@HrLabels.ChecklistKind(WarehouseLabels.Text(template, "kind"))</text>,
        "description" => @<text>@(WarehouseLabels.Text(template, "description") is { Length: > 0 } d ? d : "—")</text>,
        "active" => @<span class="badge @WarehouseLabels.ActiveBadge(WarehouseLabels.Flag(template, "isActive", true))">@(WarehouseLabels.Flag(template, "isActive", true) ? "Etkin" : "Pasif")</span>,
        _ when key.StartsWith("custom.", StringComparison.Ordinal) && Lookups.FieldsOf(HrAccess.ChecklistTemplateEntityKey).FirstOrDefault(f => "custom." + f.Key == key) is { } field =>
            @<text>@CustomFieldText.Format(field, template.Values["custom"] as JsonObject)</text>,
        _ => @<text></text>,
    };

    private async Task LoadItemsAsync()
    {
        var result = await Api.GetAsync<RecordPageResponse>($"/api/records/{HrAccess.ChecklistTemplateItemEntityKey}?templateId={selected!.Id}&pageSize=200");
        items = result.Value?.Items.ToList() ?? [];
        message = result.Error;
    }

    private async Task Open(RecordResponse? template)
    {
        selected = template;
        editing = true;
        editingItem = false;
        items = null;
        if (template is not null)
        {
            await LoadItemsAsync();
        }
    }

    private async Task SavedAsync(RecordResponse saved)
    {
        selected = saved;
        await ReloadAsync();
        await LoadItemsAsync();
    }

    private void OpenItem(RecordResponse? item)
    {
        selectedItem = item;
        editingItem = true;
    }

    private async Task ItemSavedAsync()
    {
        editingItem = false;
        await LoadItemsAsync();
    }

    private async Task DeleteItemAsync(RecordResponse item)
    {
        var result = await Api.DeleteAsync($"/api/records/{HrAccess.ChecklistTemplateItemEntityKey}/{item.Id}?version={item.Version}");
        message = result.IsSuccess ? null : result.Error;
        await LoadItemsAsync();
    }

    private async Task DeleteAsync(RecordResponse template)
    {
        var result = await Api.DeleteAsync($"{Url}/{template.Id}?version={template.Version}");
        message = result.IsSuccess ? null : result.Error;
        if (result.IsSuccess && selected?.Id == template.Id)
        {
            editing = false;
        }

        await ReloadAsync();
    }
}
