@page "/ik/surec-sablonlari"
@inject ApiClient Api
@inject SessionState Session
@inject CrmLookups Lookups

<PageTitle>Süreç şablonları · Modulix</PageTitle>

@* İşe giriş/çıkış şablonları (ADR-0042 dilim 5): şablon ve adımları (başlık, sorumlu, gün farkı, görev türü). Şablon değişikliği yalnızca sonra
   başlatılan süreçleri etkiler; kullanılmış şablon silinmez, pasife alınır. *@
<AuthGate Module="@HrAccess.ModuleKey" Permission="@HrAccess.ChecklistsManage">
    <PageHeader Title="Süreç şablonları" Icon="clipboard-list" Subtitle="İşe giriş ve işten çıkış adımlarını tanımlayın." />

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }

    @if (editing)
    {
        <ChecklistTemplateEditor @key="selected?.Id" Template="selected" Lookups="Lookups" Saved="SavedAsync" Cancelled="() => editing = false" />
        @if (selected is not null)
        {
            @if (editingItem)
            {
                <ChecklistItemEditor @key="selectedItem?.Id" TemplateId="selected.Id" Kind="@WarehouseLabels.Text(selected, "kind")" Item="selectedItem" Lookups="Lookups"
                                     Saved="ItemSavedAsync" Cancelled="() => editingItem = false" />
            }

            <div class="list-toolbar mt-3">
                <h3 class="h6 mb-0 me-auto">Adımlar</h3>
                @if (!editingItem)
                {
                    <button type="button" class="btn btn-tonal" @onclick="() => OpenItem(null)"><AppIcon Name="plus" Size="16" /> Adım ekle</button>
                }
            </div>
            @if (items is null || items.Count == 0)
            {
                <p class="text-muted" role="status">Henüz adım yok. Süreç başlatmak için en az bir adım ekleyin.</p>
            }
            else
            {
                <table class="table record-table">
                    <caption class="visually-hidden">Şablon adımları</caption>
                    <thead>
                        <tr>
                            <th scope="col"><AppIcon Name="hash" Size="14" /> Sıra</th>
                            <th scope="col"><AppIcon Name="check-circle" Size="14" /> Adım</th>
                            <th scope="col"><AppIcon Name="user-check" Size="14" /> Sorumlu</th>
                            <th scope="col"><AppIcon Name="calendar" Size="14" /> Gün farkı</th>
                            <th scope="col"><AppIcon Name="tag" Size="14" /> Tür</th>
                            <th scope="col" class="row-menu-cell"><span class="visually-hidden">Eylemler</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in items)
                        {
                            <tr>
                                <td data-label="Sıra">@WarehouseLabels.Number(item, "sequence")</td>
                                <td data-label="Adım" class="primary">@WarehouseLabels.Text(item, "title")</td>
                                <td data-label="Sorumlu">@HrLabels.Responsible(WarehouseLabels.Text(item, "responsibleRole"))</td>
                                <td data-label="Gün farkı">@WarehouseLabels.Number(item, "dueOffsetDays")</td>
                                <td data-label="Tür">@HrLabels.TaskType(WarehouseLabels.Text(item, "taskType"))</td>
                                <td class="row-menu-cell">
                                    <RowMenu Label="@($"{WarehouseLabels.Text(item, "title")} eylemleri")">
                                        <button type="button" class="view-menu-item" role="menuitem" @onclick="() => OpenItem(item)"><AppIcon Name="pencil" Size="16" /> <span>Düzenle</span></button>
                                        <button type="button" class="view-menu-item" role="menuitem" @onclick="() => DeleteItemAsync(item)"><AppIcon Name="x" Size="16" /> <span>Sil</span></button>
                                    </RowMenu>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        }
    }

    <ViewTabs Items="ViewOptions" Value="@view" ValueChanged="ChooseViewAsync" Label="Şablon türleri" />

    <div class="list-toolbar">
        @if (!editing)
        {
            <button type="button" class="btn btn-primary ms-auto" @onclick="() => Open(null)"><AppIcon Name="plus" Size="16" /> Yeni şablon</button>
        }
    </div>

    @if (templates is null)
    {
        <p class="text-muted" role="status">Yükleniyor…</p>
    }
    else if (templates.Items.Count == 0)
    {
        <p class="text-muted" role="status">Henüz şablon yok.</p>
    }
    else
    {
        <table class="table record-table">
            <caption class="visually-hidden">Süreç şablonları</caption>
            <thead>
                <tr>
                    <th scope="col"><AppIcon Name="clipboard-list" Size="14" /> Ad</th>
                    <th scope="col"><AppIcon Name="tag" Size="14" /> Tür</th>
                    <th scope="col"><AppIcon Name="check-circle" Size="14" /> Durum</th>
                    <th scope="col" class="row-menu-cell"><span class="visually-hidden">Eylemler</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var template in templates.Items)
                {
                    <tr>
                        <td data-label="Ad" class="primary">@WarehouseLabels.Text(template, "name")</td>
                        <td data-label="Tür">@HrLabels.ChecklistKind(WarehouseLabels.Text(template, "kind"))</td>
                        <td data-label="Durum"><span class="badge @WarehouseLabels.ActiveBadge(WarehouseLabels.Flag(template, "isActive", true))">@(WarehouseLabels.Flag(template, "isActive", true) ? "Etkin" : "Pasif")</span></td>
                        <td class="row-menu-cell">
                            <RowMenu Label="@($"{WarehouseLabels.Text(template, "name")} eylemleri")">
                                <button type="button" class="view-menu-item" role="menuitem" @onclick="() => Open(template)"><AppIcon Name="pencil" Size="16" /> <span>Düzenle ve adımlar</span></button>
                                <button type="button" class="view-menu-item" role="menuitem" @onclick="() => DeleteAsync(template)"><AppIcon Name="x" Size="16" /> <span>Sil</span></button>
                            </RowMenu>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</AuthGate>

@code {
    private static readonly string Url = "/api/records/" + HrAccess.ChecklistTemplateEntityKey;

    private RecordPageResponse? templates;
    private List<RecordResponse>? items;
    private RecordResponse? selected;
    private RecordResponse? selectedItem;
    private bool editing;
    private bool editingItem;
    private string? message;
    private string view = "all";

    private static IReadOnlyList<ViewOption> ViewOptions { get; } =
    [
        new("all", "Tüm şablonlar", Icon: "list"),
        new("onboarding", "İşe giriş", Icon: "user-check"),
        new("offboarding", "İşten çıkış", Icon: "log-out"),
    ];

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (Session.Can(HrAccess.ChecklistsManage))
        {
            await Lookups.LoadAsync();
            await LoadAsync();
        }
    }

    private async Task ChooseViewAsync(string key)
    {
        view = key;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var result = await Api.GetAsync<RecordPageResponse>($"{Url}?pageSize=200{(view == "all" ? "" : $"&kind={view}")}");
        templates = result.Value;
        message = result.Error;
    }

    private async Task LoadItemsAsync()
    {
        var result = await Api.GetAsync<RecordPageResponse>($"/api/records/{HrAccess.ChecklistTemplateItemEntityKey}?templateId={selected!.Id}&pageSize=200");
        items = result.Value?.Items.ToList() ?? [];
        message = result.Error;
    }

    private async Task Open(RecordResponse? template)
    {
        selected = template;
        editing = true;
        editingItem = false;
        items = null;
        if (template is not null)
        {
            await LoadItemsAsync();
        }
    }

    private async Task SavedAsync(RecordResponse saved)
    {
        selected = saved;
        await LoadAsync();
        await LoadItemsAsync();
    }

    private void OpenItem(RecordResponse? item)
    {
        selectedItem = item;
        editingItem = true;
    }

    private async Task ItemSavedAsync()
    {
        editingItem = false;
        await LoadItemsAsync();
    }

    private async Task DeleteItemAsync(RecordResponse item)
    {
        var result = await Api.DeleteAsync($"/api/records/{HrAccess.ChecklistTemplateItemEntityKey}/{item.Id}?version={item.Version}");
        message = result.IsSuccess ? null : result.Error;
        await LoadItemsAsync();
    }

    private async Task DeleteAsync(RecordResponse template)
    {
        var result = await Api.DeleteAsync($"{Url}/{template.Id}?version={template.Version}");
        message = result.IsSuccess ? null : result.Error;
        if (result.IsSuccess && selected?.Id == template.Id)
        {
            editing = false;
        }

        await LoadAsync();
    }
}
