@page "/lojistik/tasiyici-anlasmalari"
@using System.Text.Json.Nodes
@inject ApiClient Api
@inject SessionState Session
@inject CrmLookups Lookups

<PageTitle>Taşıyıcı anlaşmaları · Modulix</PageTitle>

<AuthGate Module="@LogisticsAccess.ModuleKey" Permission="@LogisticsAccess.CarriersRead">
    <PageHeader Title="Taşıyıcı anlaşmaları" Icon="file-text" Subtitle="@(page is null ? "Taşeron taşıyıcılarla çalışma koşullarını, geçerlilik tarihlerini ve ödeme vadesini izleyin." : $"{page.TotalCount} kayıt")" />

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }

    @if (editing)
    {
        <CarrierTermsEditor Terms="selected" Lookups="Lookups" Saved="SavedAsync" Deleted="SavedAsync" Cancelled="Close" />
    }

    @* Görünümler sunucuda süzgeç olarak uygulanır; sayfalama ve toplam doğru kalır. *@
    <ViewTabs Items="ViewOptions" Value="@view" ValueChanged="ChooseViewAsync" Label="Anlaşma görünümleri" NewView="StartNaming" NewViewText="Görünüm" />

    <div class="list-toolbar">
        <form class="search" @onsubmit="() => LoadAsync(1)" @onsubmit:preventDefault>
            <input class="form-control" type="search" aria-label="Anlaşma ara" placeholder="Taşıyıcı, anlaşma adı veya numarası ara" @bind="search" />
        </form>
        <GridColumnPicker State="grid" Changed="ColumnsChanged" />
        @if (Session.Can(LogisticsAccess.CarriersWrite) && !editing)
        {
            <button type="button" class="btn btn-primary" @onclick="() => Open(null)"><AppIcon Name="plus" Size="16" /> Yeni anlaşma</button>
        }
    </div>

    <PersonalViewBar Active="Active" Dirty="grid.Differs(Active)" Naming="views.Naming" NamingChanged="views.StartNaming" Error="@views.Error"
                     SaveAs="SaveAsAsync" UpdateView="UpdateViewAsync" DiscardChanges="DiscardAsync" DeleteView="DeleteViewAsync" />

    @if (page is null)
    {
        <LoadingState Kind="LoadingKind.Table" />
    }
    else if (page.Items.Count == 0)
    {
        <p class="text-muted" role="status">Bu görünüme uyan anlaşma yok.</p>
    }
    else
    {
        <p class="visually-hidden" role="status" aria-live="polite">@(page.TotalCount) anlaşma listelendi.</p>
        <table class="table record-table">
            <caption class="visually-hidden">Taşıyıcı anlaşmaları</caption>
            <thead>
                <tr>
                    @foreach (var column in grid.VisibleColumns)
                    {
                        <GridHeader Column="column" State="grid" SortChanged="SortAsync" />
                    }
                    <th scope="col" class="row-menu-cell"><span class="visually-hidden">Eylemler</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var terms in page.Items)
                {
                    <tr>
                        @foreach (var column in grid.VisibleColumns)
                        {
                            @Cell(column, terms)
                        }
                        <td class="row-menu-cell">
                            @if (Session.Can(LogisticsAccess.CarriersWrite))
                            {
                                <RowMenu Label="@($"{WarehouseLabels.Text(terms, "title")} eylemleri")">
                                    <button type="button" class="view-menu-item" role="menuitem" @onclick="() => Open(terms)"><AppIcon Name="pencil" Size="16" /> <span>Düzenle</span></button>
                                </RowMenu>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager PageSizeChoice="true" Page="page.Page" PageSize="page.PageSize" TotalCount="page.TotalCount" PageChanged="LoadAsync" />
    }
</AuthGate>

@code {
    private static readonly string Url = "/api/records/" + LogisticsAccess.CarrierTermsEntityKey;

    private const string AllViews = "all";
    private const string CurrentView = "current";
    private const string ExpiredView = "expired";
    private const string PassiveView = "passive";

    // Sütunların sırası varsayılan sıradır; sıralama anahtarları kayıt deposunun beyanıdır (CarrierTermsRecordStore.SortKeys).
    private static readonly GridColumnDef[] BaseColumns =
    [
        new("carrier", "Taşıyıcı", "building", "carrier", "-carrier", Locked: true),
        new("title", "Anlaşma", "file-text", "title", "-title"),
        new("agreementNo", "No", "hash", DefaultVisible: false),
        new("validity", "Geçerlilik", "calendar", "validFrom", "-validFrom"),
        new("currency", "Para birimi", "coins"),
        new("paymentTermDays", "Ödeme vadesi", "clock", "paymentTermDays", "-paymentTermDays"),
        new("state", "Durum", "tag", "isActive", "-isActive"),
    ];

    private readonly GridViewState grid = new("logistics.carrier-terms", "carrier");
    private readonly Dictionary<Guid, string> carrierNames = [];
    private PersonalGridViews views = default!;
    private RecordPageResponse? page;
    private RecordResponse? selected;
    private bool editing;
    private string? message;
    private string? search;
    private string view = AllViews;
    private string? validOn;
    private string? expiredBefore;
    private string? isActive;

    private static DateOnly Today => DateOnly.FromDateTime(DateTime.Now);

    protected override async Task OnInitializedAsync()
    {
        views = new PersonalGridViews(Api, "logistics.carrier-terms");
        await Session.EnsureLoadedAsync();
        if (Session.Can(LogisticsAccess.CarriersRead))
        {
            await Lookups.LoadAsync();
            grid.Define([.. BaseColumns, .. Lookups.FieldsOf(LogisticsAccess.CarrierTermsEntityKey).Select(f => new GridColumnDef("custom." + f.Key, f.Label, "type", DefaultVisible: f.ShowInList))]);
            await views.LoadAsync();
            await LoadAsync(1);
        }
    }

    private GridViewDto? Active => views.Find(view);

    private IReadOnlyList<ViewOption> ViewOptions =>
    [
        new(AllViews, "Tüm anlaşmalar", Icon: "file-text"),
        new(CurrentView, "Bugün geçerli", Icon: "check-circle"),
        new(ExpiredView, "Süresi dolan", Icon: "alert-circle"),
        new(PassiveView, "Pasif", Icon: "clock"),
        .. views.Options,
    ];

    private async Task ChooseViewAsync(string key)
    {
        view = key;
        views.StartNaming(false);
        if (Active is { } saved)
        {
            grid.Apply(saved);
            var filters = GridFilters.Parse(saved.Filters);
            validOn = filters.GetValueOrDefault("validOn");
            expiredBefore = filters.GetValueOrDefault("expiredBefore");
            isActive = filters.GetValueOrDefault("isActive");
        }
        else
        {
            grid.Reset();
            var today = Today.ToString("yyyy-MM-dd");
            validOn = key == CurrentView ? today : null;
            expiredBefore = key == ExpiredView ? today : null;
            isActive = key == PassiveView ? "false" : null;
        }

        await LoadAsync(1);
    }

    private async Task SortAsync(string key)
    {
        grid.Sort = key;
        await LoadAsync(1);
    }

    private Task ColumnsChanged() => Task.CompletedTask;

    private string? CurrentFilters => GridFilters.Build(
        validOn is { } v ? ("validOn", v) : null, expiredBefore is { } e ? ("expiredBefore", e) : null, isActive is { } a ? ("isActive", a) : null);

    private void StartNaming() => views.StartNaming(true);

    private async Task SaveAsAsync(string name)
    {
        if (await views.SaveAsAsync(grid.ToRequest(name, CurrentFilters)) is { } key)
        {
            view = key;
        }
    }

    private async Task UpdateViewAsync()
    {
        if (Active is { } current)
        {
            await views.UpdateAsync(current, grid.ToRequest(current.Name, CurrentFilters));
        }
    }

    private async Task DiscardAsync() => await ChooseViewAsync(view);

    private async Task DeleteViewAsync()
    {
        if (Active is { } current && await views.DeleteAsync(current))
        {
            await ChooseViewAsync(AllViews);
        }
    }

    private async Task LoadAsync(int pageNumber)
    {
        var url = $"{Url}?page={pageNumber}&pageSize={ListPaging.Size}&search={Uri.EscapeDataString(search ?? string.Empty)}";
        if (grid.Sort != grid.DefaultSort)
        {
            url += $"&sort={Uri.EscapeDataString(grid.Sort)}";
        }

        foreach (var (name, value) in new[] { ("validOn", validOn), ("expiredBefore", expiredBefore), ("isActive", isActive) })
        {
            if (value is not null)
            {
                url += $"&{name}={value}";
            }
        }

        var result = await Api.GetAsync<RecordPageResponse>(url);
        page = result.Value;
        message = result.Error;
        if (page is not null)
        {
            await WarehouseLabels.ResolveNamesAsync(Api, LogisticsAccess.TermsCarrierLookup, page.Items.Select(t => WarehouseLabels.Id(t, "carrierPartyId")).OfType<Guid>(), carrierNames);
        }
    }

    private RenderFragment Cell(GridColumnDef column, RecordResponse terms) => @<td data-label="@column.Label" class="@(column.Key == "carrier" ? "primary" : null)">@CellContent(column.Key, terms)</td>;

    private RenderFragment CellContent(string key, RecordResponse terms) => key switch
    {
        "carrier" => @<text>@WarehouseLabels.NameOf(carrierNames, WarehouseLabels.Id(terms, "carrierPartyId"))</text>,
        "title" => @<text>@WarehouseLabels.Text(terms, "title")</text>,
        "agreementNo" => @<text>@(WarehouseLabels.Text(terms, "agreementNo") is { Length: > 0 } no ? no : "—")</text>,
        "validity" => @<text>@LogisticsLabels.Validity(terms)</text>,
        "currency" => @<text>@WarehouseLabels.Text(terms, "currency")</text>,
        "paymentTermDays" => @<text>@(terms.Values["paymentTermDays"]?.GetValue<int>() is { } days ? $"{days} gün" : "—")</text>,
        "state" => State(terms),
        _ when key.StartsWith("custom.", StringComparison.Ordinal) && Lookups.FieldsOf(LogisticsAccess.CarrierTermsEntityKey).FirstOrDefault(f => "custom." + f.Key == key) is { } field =>
            @<text>@CustomFieldText.Format(field, terms.Values["custom"] as JsonObject)</text>,
        _ => @<text></text>,
    };

    private static RenderFragment State(RecordResponse terms)
    {
        var (badge, text) = LogisticsLabels.TermsState(terms, Today);
        return @<span class="badge @badge">@text</span>;
    }

    private void Open(RecordResponse? terms)
    {
        selected = terms;
        editing = true;
        message = null;
    }

    private void Close() => editing = false;

    private async Task SavedAsync()
    {
        editing = false;
        await LoadAsync(page?.Page ?? 1);
    }
}
