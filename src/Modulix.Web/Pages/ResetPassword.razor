@page "/sifre-sifirla"
@inject ApiClient Api

<PageTitle>Şifre sıfırla · Modulix</PageTitle>

@* E-postadaki şifre sıfırlama bağlantısı. Bağlantı bir kez kullanılır; ardından yeni şifreyle giriş yapılır. *@
<div class="narrow">
    <h1>Yeni şifre belirle</h1>

    @if (done)
    {
        <div class="alert alert-success" role="status">Şifreniz değişti. Yeni şifrenizle giriş yapabilirsiniz.</div>
        <a class="btn btn-primary w-100" href="giris">Giriş yap</a>
    }
    else if (linkError is not null)
    {
        <div class="alert alert-danger" role="alert">@linkError</div>
        <a href="giris">Giriş sayfasına git</a>
    }
    else
    {
        @if (message is not null)
        {
            <div class="alert alert-danger" role="alert">@message</div>
        }

        <PasswordForm Errors="errors" Busy="busy" Submit="ResetAsync" ButtonText="Şifremi değiştir" />
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "kullanici")] public Guid? UserId { get; set; }

    [SupplyParameterFromQuery(Name = "token")] public string? Token { get; set; }

    private string? linkError;
    private string? message;
    private IReadOnlyDictionary<string, string[]>? errors;
    private bool busy;
    private bool done;

    protected override void OnInitialized()
    {
        if (UserId is null || string.IsNullOrEmpty(Token))
        {
            linkError = "Şifre sıfırlama bağlantısı eksik. E-postadaki bağlantıyı açın.";
        }
    }

    private async Task ResetAsync(string password)
    {
        busy = true;
        var result = await Api.PostAsync<bool>("/api/auth/reset-password", new ResetPasswordRequest(UserId!.Value, Token!, password));
        busy = false;

        if (result.IsSuccess)
        {
            done = true;
        }
        else if (result.Status == System.Net.HttpStatusCode.BadRequest)
        {
            linkError = result.Error;
        }
        else
        {
            message = result.Error;
            errors = result.FieldErrors;
        }
    }
}
