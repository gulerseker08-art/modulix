@using Modulix.Shared.Auth
@page "/onaylar"
@inject ApiClient Api
@inject SessionState Session
@inject NavigationManager Navigation

<PageTitle>Onay merkezi · Modulix</PageTitle>

@* Onay merkezi (ADR-0027 Dilim 4a): firmanın tanımladığı süreçlerdeki talepler. Pano sayıları ve liste sunucuda kişinin görebildiği taleplerle
   sınırlıdır; düğmeleri gizlemek yetki değildir, karar sunucuda yeniden denetlenir. Teklif ve sözleşme onayları kendi ekranlarındadır. *@
<AuthGate AnyPermission="@(new[] { CoreAccess.RequestApprovals, CoreAccess.DecideApprovals, CoreAccess.ManageApprovals })">
    <section class="hero-band" aria-labelledby="approvals-title">
        <div class="hero-band-text">
            <span class="hero-band-eyebrow"><AppIcon Name="check-circle" Size="16" /> Onay merkezi</span>
            <h1 id="approvals-title">@HeroTitle</h1>
            <p>@HeroText</p>
        </div>
        @if (overview is not null)
        {
            <div class="hero-band-stats">
                <button type="button" class="hero-stat" @onclick="@(() => SelectViewAsync("waiting"))"><strong>@Count(overview.WaitingForMe)</strong><span>Kararınızı bekliyor</span></button>
                <button type="button" class="hero-stat" @onclick="@(() => SelectViewAsync("mine"))"><strong>@Count(overview.MyOpen)</strong><span>Açık talebiniz</span></button>
                <div class="hero-stat"><strong>@Count(overview.Overdue)</strong><span>Süresi geçen</span></div>
                <div class="hero-stat"><strong>@AverageText</strong><span>Ortalama karar süresi</span></div>
            </div>
        }
    </section>

    <Notice Text="@message" Failed="true" />

    @if (overview is not null)
    {
        @if (overview.Orphaned > 0)
        {
            <div class="alert alert-warning" role="alert">
                <AppIcon Name="alert-circle" Size="16" /> @Count(overview.Orphaned) talebin bekleyen adımında etkin onaycı yok. Talebi açıp onaycıyı değiştirin; yoksa süreç ilerlemez.
            </div>
        }

        <div class="chart-grid">
            <section class="chart-card" aria-labelledby="trend-title">
                <h2 id="trend-title">Son 14 günün kararları</h2>
                @if (overview.ApprovedLast30Days + overview.RejectedLast30Days == 0)
                {
                    <p class="text-muted">Henüz sonuçlanan talep yok.</p>
                }
                else
                {
                    <LineChart Categories="TrendDays" Series="TrendSeries" Title="Son 14 günde onaylanan ve reddedilen talepler" />
                }
            </section>
            <section class="chart-card" aria-labelledby="process-title">
                <h2 id="process-title">Açık talepler · sürece göre</h2>
                @if (overview.OpenByProcess.Count == 0)
                {
                    <p class="text-muted">Açık talep yok.</p>
                }
                else
                {
                    <DonutChart Slices="ProcessSlices" Title="Açık taleplerin sürece göre dağılımı" Caption="açık talep" />
                }
            </section>
        </div>
    }

    <ViewTabs Items="ViewOptions" Value="@viewKey" ValueChanged="SelectViewAsync" Label="Onay görünümleri" NewView="StartNaming" NewViewText="Görünüm" />

    <div class="list-toolbar">
        <form class="search" @onsubmit="() => LoadAsync(1)" @onsubmit:preventDefault>
            <input class="form-control" type="search" aria-label="Talep ara" placeholder="Başlık ya da süreç ara" @bind="search" />
        </form>
        <GridColumnPicker State="grid" Changed="@(() => Task.CompletedTask)" />
        @if (Session.Can(CoreAccess.DecideApprovals) || Session.Can(CoreAccess.ManageApprovals))
        {
            <button type="button" class="btn btn-tonal" @onclick="OpenDelegationsAsync"><AppIcon Name="repeat" Size="16" /> Vekâlet</button>
        }
        @if (Session.Can(CoreAccess.RequestApprovals))
        {
            <button type="button" class="btn btn-primary" @onclick="OpenNewAsync"><AppIcon Name="plus" Size="16" /> Yeni talep</button>
        }
    </div>

    <PersonalViewBar Active="Active" Dirty="Dirty" Naming="views.Naming" NamingChanged="views.StartNaming" Error="@views.Error"
                     SaveAs="SaveAsAsync" UpdateView="UpdateViewAsync" DiscardChanges="DiscardAsync" DeleteView="DeleteViewAsync" />

    @if (result is null)
    {
        <p class="text-muted" role="status">Yükleniyor…</p>
    }
    else if (result.Items.Count == 0)
    {
        <p class="text-muted">@EmptyText</p>
    }
    else
    {
        <table class="table record-table">
            <caption class="visually-hidden">Onay talepleri</caption>
            <thead>
                <tr>
                    @foreach (var column in grid.VisibleColumns)
                    {
                        <GridHeader Column="column" State="grid" SortChanged="SortAsync" />
                    }
                    <th scope="col" class="row-menu-cell"><span class="visually-hidden">Eylemler</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in result.Items)
                {
                    <tr>
                        @foreach (var column in grid.VisibleColumns)
                        {
                            <td data-label="@column.Label" class="@(column.Key == "title" ? "primary" : null)">@CellContent(column.Key, item)</td>
                        }
                        <td class="row-menu-cell">
                            <RowMenu Label="@($"{item.Title} eylemleri")">
                                <button type="button" class="dropdown-item" role="menuitem" @onclick="() => OpenDetailAsync(item.Id)">Aç</button>
                            </RowMenu>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager Page="result.Page" PageSize="result.PageSize" TotalCount="result.TotalCount" PageChanged="LoadAsync" />
    }

    <Drawer Open="detail is not null" Label="Onay talebi" OnClose="CloseDetail">
        @if (detail is not null)
        {
            <div class="section-header">
                <div>
                    <h2>@detail.Title</h2>
                    <p class="text-muted">@detail.DefinitionName · @detail.RequesterName · @DateText(detail.SubmittedAt)</p>
                </div>
                <button type="button" class="btn btn-icon btn-ghost" aria-label="Kapat" @onclick="CloseDetail"><AppIcon Name="x" Size="18" /></button>
            </div>
            <div>
                <p><span class="badge @StatusClass(detail.Status)">@StatusText(detail.Status)</span> <strong>@AmountText(detail)</strong></p>
                @if (!string.IsNullOrWhiteSpace(detail.Description)) { <p>@detail.Description</p> }

                <h3 class="h6">Adımlar</h3>
                <ol class="step-track">
                    @foreach (var step in detail.Steps)
                    {
                        <li class="step-track-item @StepClass(step)">
                            <span class="step-track-dot"><AppIcon Name="@StepIcon(step)" Size="14" /></span>
                            <div>
                                <strong>@step.Name</strong>
                                <small>@step.ApproverName @StepNote(step)</small>
                                @if (step.IsOrphaned) { <span class="badge stage-lost">Etkin onaycı yok</span> }
                                @if (step.IsEscalated && step.Status == "Active") { <span class="badge stage-onhold">Süresi geçti@(step.EscalationName is { } target ? $" · {target}" : null)</span> }
                                @if (step.OnBehalfOfName is { } principal) { <small>@principal adına vekâleten</small> }
                                @if (!string.IsNullOrWhiteSpace(step.Comment)) { <p>@step.Comment</p> }
                                @if (step.Status == "Active" && Session.Can(CoreAccess.ManageApprovals) && options is not null)
                                {
                                    <div class="inline-form">
                                        <select class="form-select" aria-label="Yeni onaycı" @bind="reassignTo">
                                            <option value="">Onaycıyı değiştir…</option>
                                            @foreach (var person in options.People.Where(p => p.Id != detail.RequesterId)) { <option value="@person.Id">@person.Name</option> }
                                        </select>
                                        <button type="button" class="btn btn-tonal" disabled="@(busy || reassignTo is null)" @onclick="() => ReassignAsync(step)">Değiştir</button>
                                    </div>
                                }
                            </div>
                        </li>
                    }
                </ol>

                <Notice Text="@actionError" Failed="true" />

                @if (detail.CanDecide)
                {
                    <label class="form-label" for="decision-note">Not (ret için zorunlu)</label>
                    <textarea id="decision-note" class="form-control" rows="3" maxlength="1000" @bind="comment"></textarea>
                }
            </div>
            <div class="form-actions">
                @if (detail.CanWithdraw)
                {
                    <button type="button" class="btn btn-outline-danger" disabled="@busy" @onclick="WithdrawAsync">Geri çek</button>
                }
                @if (detail.CanDecide)
                {
                    <button type="button" class="btn btn-outline-danger" disabled="@busy" @onclick="() => DecideAsync(false)">Reddet</button>
                    <button type="button" class="btn btn-primary" disabled="@busy" @onclick="() => DecideAsync(true)">Onayla</button>
                }
            </div>
        }
    </Drawer>

    <Drawer Open="delegating" Label="Onay vekâleti" OnClose="() => delegating = false">
        <div class="section-header">
            <h2>Onay vekâleti</h2>
            <button type="button" class="btn btn-icon btn-ghost" aria-label="Kapat" @onclick="() => delegating = false"><AppIcon Name="x" Size="18" /></button>
        </div>
        <div>
            <p class="text-muted">İzinliyken size atanan adımlara vekiliniz karar versin. Role atanmış adımlar vekâlete girmez; vekil, talep sahibi olduğu talebe karar veremez.</p>
            @foreach (var delegation in delegations)
            {
                <div class="step-editor">
                    <strong>@delegation.PrincipalName → @delegation.DelegateName</strong>
                    <small class="d-block text-muted">@DateText(delegation.StartsAt) – @DateText(delegation.EndsAt)</small>
                    <span class="badge @(delegation.IsActive ? "stage-won" : "stage-cancelled")">@(delegation.RevokedAt is not null ? "Geri alındı" : delegation.IsActive ? "Etkin" : "Etkin değil")</span>
                    @if (delegation.RevokedAt is null && delegation.EndsAt > DateTimeOffset.UtcNow && (delegation.PrincipalUserId == Session.User?.UserId || Session.Can(CoreAccess.ManageApprovals)))
                    {
                        <button type="button" class="btn btn-ghost btn-sm" disabled="@busy" @onclick="() => RevokeDelegationAsync(delegation)">Geri al</button>
                    }
                </div>
            }
            <FormTabs Title="Yeni vekâlet">
                <FormSection Title="Vekil" Icon="user">
                    <div class="mb-3">
                        <label class="form-label" for="delegate-user">Vekil</label>
                        <select id="delegate-user" class="form-select" @bind="delegateId">
                            <option value="">Seçin…</option>
                            @foreach (var member in members.Where(m => m.UserId != Session.User?.UserId)) { <option value="@member.UserId">@member.DisplayName</option> }
                        </select>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label" for="delegate-from">Başlangıç</label>
                            <input id="delegate-from" class="form-control" type="date" @bind="delegateFrom" />
                        </div>
                        <div class="col-6">
                            <label class="form-label" for="delegate-to">Bitiş</label>
                            <input id="delegate-to" class="form-control" type="date" @bind="delegateTo" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="delegate-reason">Gerekçe</label>
                        <input id="delegate-reason" class="form-control" maxlength="300" @bind="delegateReason" />
                    </div>
                </FormSection>
            </FormTabs>
            <Notice Text="@actionError" Failed="true" />
        </div>
        <div class="form-actions">
            <button type="button" class="btn btn-outline-secondary" @onclick="() => delegating = false">Kapat</button>
            <button type="button" class="btn btn-primary" disabled="@(busy || delegateId is null)" @onclick="SaveDelegationAsync">Vekâleti aç</button>
        </div>
    </Drawer>

    <Drawer Open="creating" Label="Yeni onay talebi" OnClose="() => creating = false">
        <div class="section-header">
            <h2>Yeni onay talebi</h2>
            <button type="button" class="btn btn-icon btn-ghost" aria-label="Kapat" @onclick="() => creating = false"><AppIcon Name="x" Size="18" /></button>
        </div>
        <div>
            @if (definitions.Count == 0)
            {
                <p class="text-muted">Açık onay süreci yok. Yöneticiniz Yönetim → Onay süreçleri ekranından süreç tanımlayabilir.</p>
            }
            else
            {
                <FormTabs Title="Talep bilgileri">
                    <FormSection Title="Talep" Icon="file-text">
                        <div class="mb-3">
                            <label class="form-label" for="new-process">Süreç</label>
                            <select id="new-process" class="form-select" @bind="newDefinitionId">
                                @foreach (var definition in definitions) { <option value="@definition.Id">@definition.Name</option> }
                            </select>
                            @if (SelectedDefinition?.Description is { } about) { <small class="text-muted">@about</small> }
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="new-title">Başlık</label>
                            <input id="new-title" class="form-control" maxlength="200" @bind="newTitle" />
                        </div>
                        <div class="row g-2 mb-3">
                            <div class="col-8">
                                <label class="form-label" for="new-amount">Tutar</label>
                                <input id="new-amount" class="form-control" type="number" min="0" step="0.01" @bind="newAmount" />
                            </div>
                            <div class="col-4">
                                <label class="form-label" for="new-currency">Para birimi</label>
                                <input id="new-currency" class="form-control" maxlength="3" disabled="@(SelectedDefinition?.Currency is not null)" @bind="newCurrency" />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="new-description">Açıklama</label>
                            <textarea id="new-description" class="form-control" rows="4" maxlength="2000" @bind="newDescription"></textarea>
                        </div>
                    </FormSection>
                </FormTabs>
            }
            <Notice Text="@actionError" Failed="true" />
        </div>
        <div class="form-actions">
            <button type="button" class="btn btn-outline-secondary" @onclick="() => creating = false">İptal</button>
            <button type="button" class="btn btn-primary" disabled="@(busy || definitions.Count == 0)" @onclick="SubmitNewAsync">Onaya gönder</button>
        </div>
    </Drawer>
</AuthGate>

@code {
    private const string ScreenKey = "core.approvals";
    private const string DefaultSort = "-submitted";
    private const string DefaultView = "waiting";

    // Sistem görünümleri sunucunun view süzgecidir (Waiting, Mine, All); kişisel görünümler ardına eklenir ve süzgeci view=… ile saklar (ADR-0036).
    private static readonly IReadOnlyList<ViewOption> SystemViews =
    [
        new(DefaultView, "Kararımı bekleyenler", Icon: "hourglass"),
        new("mine", "Taleplerim", Icon: "user"),
        new("all", "Tümü", Icon: "clipboard-list"),
    ];

    // Sıralanabilir sütunlar sunucudaki sort anahtarlarıdır (title, process, amount, submitted).
    private static readonly GridColumnDef[] Columns =
    [
        new("title", "Talep", "type", "title", "-title", Locked: true),
        new("process", "Süreç", "layers", "process", "-process"),
        new("amount", "Tutar", "coins", "amount", "-amount"),
        new("requester", "Talep eden", "user"),
        new("progress", "İlerleme", "activity"),
        new("submitted", "Tarih", "calendar", "submitted", "-submitted"),
        new("status", "Durum", "tag"),
    ];

    [SupplyParameterFromQuery(Name = "talep")] public Guid? RequestId { get; set; }

    private readonly GridViewState grid = new(ScreenKey, DefaultSort);
    private PersonalGridViews views = default!;
    private ApprovalOverviewDto? overview;
    private ApprovalRequestPageDto? result;
    private ApprovalRequestDto? detail;
    private ApproverOptionsDto? options;
    private List<ApprovalDefinitionDto> definitions = [];
    private string viewKey = DefaultView;
    private string view = DefaultView;
    private string? search;
    private string? message;
    private string? actionError;
    private string? comment;
    private Guid? reassignTo;
    private bool busy;
    private bool creating;
    private Guid newDefinitionId;
    private string? newTitle;
    private string? newDescription;
    private decimal? newAmount;
    private string? newCurrency;

    private List<ApprovalDelegationDto> delegations = [];
    private List<TenantMemberResponse> members = [];
    private bool delegating;
    private Guid? delegateId;
    private DateOnly delegateFrom = DateOnly.FromDateTime(DateTime.Today);
    private DateOnly delegateTo = DateOnly.FromDateTime(DateTime.Today.AddDays(7));
    private string? delegateReason;

    private ApprovalDefinitionDto? SelectedDefinition => definitions.FirstOrDefault(d => d.Id == newDefinitionId);

    private string HeroTitle => overview switch
    {
        null => "Onay merkezi",
        { WaitingForMe: 0 } => "Masanız temiz",
        var o => $"{Count(o.WaitingForMe)} talep kararınızı bekliyor",
    };

    private string HeroText => overview is { Overdue: > 0 } o
        ? $"{Count(o.Overdue)} talebin süresi geçti; önce onlara bakın."
        : "Talepler adım adım ilerler, her karar kim verdi ve neden diye kayıt altına alınır.";

    private string AverageText => overview?.AverageDecisionHours is { } hours
        ? hours < 24 ? $"{hours.ToString("N1", Regional.Numbers)} sa" : $"{(hours / 24).ToString("N1", Regional.Numbers)} gün"
        : "—";

    private string EmptyText => view switch
    {
        "waiting" => "Kararınızı bekleyen talep yok.",
        "mine" => "Henüz talep açmadınız.",
        _ => "Görebildiğiniz talep yok.",
    };

    private IReadOnlyList<string> TrendDays => [.. overview!.Trend.Select(d => d.Day.ToString("dd.MM"))];

    private IReadOnlyList<LineSeries> TrendSeries =>
    [
        new("Onaylanan", [.. overview!.Trend.Select(d => (decimal?)d.Approved)]),
        new("Reddedilen", [.. overview!.Trend.Select(d => (decimal?)d.Rejected)]),
    ];

    private IReadOnlyList<ChartSlice> ProcessSlices => [.. overview!.OpenByProcess.Select(p => new ChartSlice(p.Name, p.Open))];

    protected override async Task OnInitializedAsync()
    {
        views = new PersonalGridViews(Api, ScreenKey);
        grid.Define(Columns);
        await Session.EnsureLoadedAsync();
        await views.LoadAsync();
        await RefreshAsync();
        if (Session.Can(CoreAccess.ManageApprovals))
        {
            options = (await Api.GetAsync<ApproverOptionsDto>("/api/approvals/approver-options")).Value;
        }

        if (RequestId is { } id)
        {
            await OpenDetailAsync(id);
        }
    }

    private async Task RefreshAsync()
    {
        var loaded = await Api.GetAsync<ApprovalOverviewDto>("/api/approvals/overview");
        overview = loaded.Value;
        message = loaded.IsSuccess ? null : loaded.Error;
        await LoadAsync(result?.Page ?? 1);
    }

    private async Task LoadAsync(int page)
    {
        var url = $"/api/approvals/requests?view={view}&sort={Uri.EscapeDataString(grid.Sort)}&page={page}&pageSize={ListPaging.Size}";
        if (!string.IsNullOrWhiteSpace(search))
        {
            url += $"&search={Uri.EscapeDataString(search)}";
        }

        var loaded = await Api.GetAsync<ApprovalRequestPageDto>(url);
        result = loaded.Value ?? new ApprovalRequestPageDto([], page, ListPaging.Size, 0);
        message = loaded.IsSuccess ? message : loaded.Error;
    }

    private GridViewDto? Active => views.Find(viewKey);

    private IReadOnlyList<ViewOption> ViewOptions => [.. SystemViews, .. views.Options];

    private string? CurrentFilters => GridFilters.Build(("view", view));

    private string? BaselineFilters => Active?.Filters ?? "view=" + viewKey;

    private bool Dirty => grid.Differs(Active) || (CurrentFilters ?? string.Empty) != (BaselineFilters ?? string.Empty);

    private async Task SelectViewAsync(string key)
    {
        viewKey = key;
        views.StartNaming(false);
        if (Active is { } saved)
        {
            grid.Apply(saved);
        }
        else
        {
            grid.Reset();
        }

        var wanted = GridFilters.Parse(BaselineFilters).GetValueOrDefault("view");
        view = SystemViews.Any(v => v.Key == wanted) ? wanted! : DefaultView;
        await LoadAsync(1);
    }

    private async Task SortAsync(string key)
    {
        grid.Sort = key;
        await LoadAsync(1);
    }

    private void StartNaming() => views.StartNaming(true);

    private async Task SaveAsAsync(string name)
    {
        if (await views.SaveAsAsync(grid.ToRequest(name, CurrentFilters)) is { } key)
        {
            viewKey = key;
        }
    }

    private async Task UpdateViewAsync()
    {
        if (Active is { } current)
        {
            await views.UpdateAsync(current, grid.ToRequest(current.Name, CurrentFilters));
        }
    }

    private async Task DiscardAsync() => await SelectViewAsync(viewKey);

    private async Task DeleteViewAsync()
    {
        if (Active is { } current && await views.DeleteAsync(current))
        {
            await SelectViewAsync(DefaultView);
        }
    }

    private RenderFragment CellContent(string key, ApprovalRequestDto item) => key switch
    {
        "title" => @<a href="onaylar?talep=@item.Id" @onclick:preventDefault @onclick="() => OpenDetailAsync(item.Id)">@item.Title</a>,
        "process" => @<text>@item.DefinitionName</text>,
        "amount" => @<text>@AmountText(item)</text>,
        "requester" => @<text>@item.RequesterName</text>,
        "progress" => @<span class="step-dots" aria-label="@ProgressText(item)">@foreach (var step in item.Steps) { <span class="step-dot @StepClass(step)"></span> }</span>,
        "status" => @<text><span class="badge @StatusClass(item.Status)">@StatusText(item.Status)</span>@if (item.Steps.Any(s => s.IsOverdue)) { <span class="badge stage-lost">Gecikti</span> }</text>,
        "submitted" => @<text>@DateText(item.SubmittedAt)</text>,
        _ => @<text></text>,
    };

    private async Task OpenDetailAsync(Guid id)
    {
        actionError = null;
        comment = null;
        reassignTo = null;
        var loaded = await Api.GetAsync<ApprovalRequestDto>($"/api/approvals/requests/{id}");
        detail = loaded.Value;
        message = loaded.IsSuccess ? null : loaded.Error;
    }

    private void CloseDetail()
    {
        detail = null;
        if (RequestId is not null)
        {
            Navigation.NavigateTo("onaylar", replace: true);
        }
    }

    private async Task DecideAsync(bool approve)
    {
        var action = approve ? "approve" : "reject";
        await ActAsync(() => Api.PostAsync<ApprovalRequestDto>($"/api/approvals/requests/{detail!.Id}/{action}", new DecideApprovalRequest(comment, detail.Version)));
    }

    private Task WithdrawAsync() =>
        ActAsync(() => Api.PostAsync<ApprovalRequestDto>($"/api/approvals/requests/{detail!.Id}/withdraw", new { }));

    private Task ReassignAsync(ApprovalStepDto step) =>
        ActAsync(() => Api.PostAsync<ApprovalRequestDto>($"/api/approvals/requests/{detail!.Id}/reassign", new ReassignApprovalStepRequest(step.Id, reassignTo, null, detail.Version)));

    private async Task ActAsync(Func<Task<ApiResult<ApprovalRequestDto>>> action)
    {
        busy = true;
        var done = await action();
        busy = false;
        actionError = done.IsSuccess ? null : done.Error;
        if (done.IsSuccess)
        {
            detail = done.Value;
            comment = null;
            reassignTo = null;
            await RefreshAsync();
        }
    }

    private async Task OpenNewAsync()
    {
        actionError = null;
        definitions = (await Api.GetAsync<List<ApprovalDefinitionDto>>("/api/approvals/definitions?activeOnly=true")).Value ?? [];
        newDefinitionId = definitions.FirstOrDefault()?.Id ?? Guid.Empty;
        newTitle = newDescription = newCurrency = null;
        newAmount = null;
        creating = true;
    }

    private async Task SubmitNewAsync()
    {
        busy = true;
        var currency = SelectedDefinition?.Currency ?? newCurrency;
        var done = await Api.PostAsync<ApprovalRequestDto>("/api/approvals/requests", new OpenApprovalRequest(newDefinitionId, newTitle ?? string.Empty, newDescription, newAmount, newAmount is null ? null : currency));
        busy = false;
        actionError = done.IsSuccess ? null : done.Error;
        if (done.IsSuccess)
        {
            creating = false;
            viewKey = view = "mine";
            await RefreshAsync();
        }
    }

    private async Task OpenDelegationsAsync()
    {
        actionError = null;
        delegateId = null;
        delegateReason = null;
        members = (await Api.GetAsync<List<TenantMemberResponse>>("/api/tenant/members")).Value ?? [];
        await LoadDelegationsAsync();
        delegating = true;
    }

    private async Task LoadDelegationsAsync() =>
        delegations = (await Api.GetAsync<List<ApprovalDelegationDto>>("/api/approvals/delegations")).Value ?? [];

    private async Task SaveDelegationAsync()
    {
        busy = true;
        var starts = new DateTimeOffset(delegateFrom.ToDateTime(TimeOnly.MinValue), Regional.ToTenant(DateTimeOffset.UtcNow).Offset);
        var ends = new DateTimeOffset(delegateTo.ToDateTime(TimeOnly.MaxValue), Regional.ToTenant(DateTimeOffset.UtcNow).Offset);
        var done = await Api.PostAsync<ApprovalDelegationDto>("/api/approvals/delegations", new CreateApprovalDelegationRequest(null, delegateId!.Value, starts, ends, delegateReason));
        busy = false;
        actionError = done.IsSuccess ? null : done.Error;
        if (done.IsSuccess)
        {
            delegateId = null;
            delegateReason = null;
            await LoadDelegationsAsync();
        }
    }

    private async Task RevokeDelegationAsync(ApprovalDelegationDto delegation)
    {
        busy = true;
        var done = await Api.PostAsync<ApprovalDelegationDto>($"/api/approvals/delegations/{delegation.Id}/revoke", new { });
        busy = false;
        actionError = done.IsSuccess ? null : done.Error;
        await LoadDelegationsAsync();
    }

    private static string Count(int value) => value.ToString("N0", Regional.Numbers);

    private static string DateText(DateTimeOffset value) => Regional.ToTenant(value).ToString("dd.MM.yyyy HH:mm");

    private static string AmountText(ApprovalRequestDto item) =>
        item.Amount is { } amount ? $"{amount.ToString("N2", Regional.Numbers)} {item.Currency}" : "—";

    private static string StatusText(string status) => status switch
    {
        "Pending" => "Bekliyor",
        "Approved" => "Onaylandı",
        "Rejected" => "Reddedildi",
        "Withdrawn" => "Geri çekildi",
        _ => status,
    };

    private static string StatusClass(string status) => status switch
    {
        "Pending" => "stage-open",
        "Approved" => "stage-won",
        "Rejected" => "stage-lost",
        _ => "stage-cancelled",
    };

    private static string StepClass(ApprovalStepDto step) => step.Status switch
    {
        "Approved" => "is-approved",
        "Rejected" => "is-rejected",
        "Active" => "is-active",
        "Cancelled" => "is-cancelled",
        _ => string.Empty,
    };

    private static string StepIcon(ApprovalStepDto step) => step.Status switch
    {
        "Approved" => "check",
        "Rejected" => "x",
        "Active" => "hourglass",
        _ => "clock",
    };

    private static string StepNote(ApprovalStepDto step) => step switch
    {
        { DecidedAt: { } at } => $"· {step.DecidedByName} · {DateText(at)}",
        { Status: "Active", DueAt: { } due } => $"· son tarih {DateText(due)}",
        _ => string.Empty,
    };

    private static string ProgressText(ApprovalRequestDto item) =>
        $"{item.Steps.Count} adımdan {item.Steps.Count(s => s.Status == "Approved")} tanesi onaylandı";
}
