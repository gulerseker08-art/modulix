@page "/platform/firmalar/{TenantId:guid}"
@inject ApiClient Api

<PageTitle>@(detail?.Tenant.Name ?? "Firma") · Platform · Modulix</PageTitle>

<PlatformGate>
    <a class="back-link" href="platform/firmalar">← Firmalar</a>

    @if (notice is not null)
    {
        <div class="alert alert-success" role="status">@notice</div>
    }

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }

    @if (detail is null)
    {
        @if (message is null)
        {
            <p class="text-muted">Yükleniyor…</p>
        }
    }
    else
    {
        var tenant = detail.Tenant;
        <div class="page-header">
            <div>
                <h1>@tenant.Name</h1>
                <div class="header-meta"><TenantStateBadge State="tenant.Status" /></div>
            </div>
        </div>

        <dl class="detail-grid">
            <div><dt>Kısa ad</dt><dd>@tenant.Slug</dd></div>
            <div><dt>Açılış</dt><dd>@CrmLabels.Time(tenant.CreatedAt)</dd></div>
            <div><dt>Etkin üye</dt><dd>@tenant.ActiveMemberCount</dd></div>
            <div><dt>Açık modüller</dt><dd>@ModuleNames(tenant.EnabledModules)</dd></div>
            <div><dt>Sektör profili</dt><dd>@ProfileName(tenant.ProfileKey)</dd></div>
        </dl>

        @if (modules is not null)
        {
            <section class="detail-section">
                <div class="section-header"><h2>Modüller</h2></div>
                <p class="text-muted">Değişiklik firmanın bir sonraki isteğinde geçerli olur ve firmanın denetim kaydına yazılır.</p>
                @foreach (var module in modules.Modules)
                {
                    <ModuleToggle TenantId="tenant.Id" TenantName="@tenant.Name" ModuleKey="@module.Key" ModuleName="@module.DisplayName"
                                  Enabled="tenant.EnabledModules.Contains(module.Key)" ShowLabel="true"
                                  Changed="error => ModuleChangedAsync(module, error)" />
                }

                <h3>Hak koşulları</h3>
                <p class="text-muted">Bitiş tarihi şimdilik yalnızca kayıttır; süre dolunca modül kendiliğinden kapanmaz.</p>
                @if (Conditions().Count > 0)
                {
                    <ul>
                        @foreach (var line in Conditions())
                        {
                            <li>@line</li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted">Açık modüllerin hepsi elle ve süresiz.</p>
                }

                @if (tenant.EnabledModules.Count > 0)
                {
                    <form class="inline-form" novalidate @onsubmit="SaveTermsAsync" @onsubmit:preventDefault>
                        <h3>Koşulları düzenle</h3>
                        <div class="form-grid">
                            <div>
                                <label class="form-label" for="termsModule">Modül</label>
                                <select id="termsModule" class="form-select" value="@termsModule" @onchange="e => ChooseTermsModule((string?)e.Value)">
                                    <option value="">Seçin</option>
                                    @foreach (var key in tenant.EnabledModules)
                                    {
                                        <option value="@key">@ModuleNames([key])</option>
                                    }
                                </select>
                            </div>
                            <div>
                                <label class="form-label" for="termsSource">Kaynak</label>
                                <select id="termsSource" class="form-select" @bind="termsSource">
                                    @foreach (var source in Enum.GetValues<LicenseSource>())
                                    {
                                        <option value="@source">@LicenseSourceText.Of(source)</option>
                                    }
                                </select>
                                <FieldError Field="source" Errors="termsErrors" />
                            </div>
                            <div>
                                <label class="form-label" for="termsUntil">Bitiş (boş: süresiz)</label>
                                <input id="termsUntil" class="form-control" type="date" @bind="termsUntil" />
                                <FieldError Field="validUntil" Errors="termsErrors" />
                            </div>
                            <div>
                                <label class="form-label" for="termsNote">Not @(termsSource == LicenseSource.Exception ? "*" : null)</label>
                                <input id="termsNote" class="form-control" maxlength="500" @bind="termsNote" @bind:event="oninput" />
                                <FieldError Field="note" Errors="termsErrors" />
                            </div>
                            <div>
                                <label class="form-label" for="termsReason">Gerekçe (süre uzatırken zorunlu)</label>
                                <input id="termsReason" class="form-control" maxlength="500" @bind="termsReason" @bind:event="oninput" />
                                <FieldError Field="reason" Errors="termsErrors" />
                            </div>
                        </div>
                        <div class="form-actions">
                            <button type="submit" class="btn btn-primary" disabled="@(busy || string.IsNullOrEmpty(termsModule))">Koşulları kaydet</button>
                        </div>
                    </form>
                }
            </section>
        }

        @if (profiles.Count > 0)
        {
            <section class="detail-section">
                <div class="section-header"><h2>Sektör profili</h2></div>
                <p class="text-muted">
                    Profil yalnızca ekler: eksik modülleri açar, eksik alanları ve liste değerlerini ekler. Firmanın mevcut alanları ve
                    değerleri değişmez. Uygulama firmanın denetim kaydına yazılır.
                </p>
                <div class="inline-form">
                    <div class="form-grid">
                        <div>
                            <label class="form-label" for="profileKey">Profil</label>
                            <select id="profileKey" class="form-select" value="@profileKey" @onchange="e => PreviewProfileAsync((string?)e.Value)">
                                <option value="">Seçin</option>
                                @foreach (var profile in profiles)
                                {
                                    <option value="@profile.Key">@profile.Name</option>
                                }
                            </select>
                        </div>
                    </div>
                    @if (plan is not null)
                    {
                        <ProfilePreview Plan="plan" />
                        <div class="form-actions">
                            <button type="button" class="btn btn-primary" disabled="@busy" @onclick="ApplyProfileAsync">Profili uygula</button>
                        </div>
                    }
                </div>
            </section>
        }

        <section class="detail-section">
            <div class="section-header"><h2>Yöneticiler</h2></div>
            @if (detail.Administrators.Count == 0)
            {
                <div class="alert alert-warning">Bu firmada yönetici yok. Firmayı yönetecek kişiyi davet edin.</div>
            }
            else
            {
                <table class="table record-table">
                    <thead><tr><th>Ad</th><th>E-posta</th><th>Durum</th></tr></thead>
                    <tbody>
                        @foreach (var administrator in detail.Administrators)
                        {
                            <tr>
                                <td data-label="Ad" class="primary">@administrator.DisplayName</td>
                                <td data-label="E-posta">@administrator.Email</td>
                                <td data-label="Durum">
                                    <span class="badge user-@administrator.Status.ToString().ToLowerInvariant()">@UserLabels.Of(administrator.Status)</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            @if (IsOperational(tenant.Status))
            {
                <form class="inline-form" novalidate @onsubmit="InviteAsync" @onsubmit:preventDefault>
                    <h3>Yönetici davet et</h3>
                    <div class="form-grid">
                        <div>
                            <label class="form-label" for="inviteEmail">E-posta *</label>
                            <input id="inviteEmail" class="form-control" type="email" autocomplete="off" @bind="inviteEmail" />
                            <FieldError Field="email" Errors="inviteErrors" />
                        </div>
                        <div>
                            <label class="form-label" for="inviteName">Ad soyad *</label>
                            <input id="inviteName" class="form-control" maxlength="200" @bind="inviteName" />
                            <FieldError Field="displayName" Errors="inviteErrors" />
                        </div>
                    </div>
                    <div class="form-actions">
                        <button type="submit" class="btn btn-primary" disabled="@busy">Davet gönder</button>
                    </div>
                </form>
            }
        </section>

        <section class="detail-section">
            <div class="section-header"><h2>Firma adı</h2></div>
            <form class="inline-form" novalidate @onsubmit="RenameAsync" @onsubmit:preventDefault>
                <div class="form-grid">
                    <div>
                        <label class="form-label" for="tenantName">Ad</label>
                        <input id="tenantName" class="form-control" maxlength="200" @bind="newName" />
                        <FieldError Field="name" Errors="renameErrors" />
                    </div>
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn btn-outline-primary" disabled="@(busy || newName == tenant.Name)">Adı kaydet</button>
                </div>
            </form>
        </section>

        <section class="detail-section">
            <div class="section-header"><h2>Durum</h2></div>
            @if (confirmingClose)
            {
                <div class="alert alert-warning confirm" role="alertdialog">
                    <p>
                        Firmanın @tenant.ActiveMemberCount kullanıcısı bir sonraki isteğinde erişimini kaybeder ve bekleyen
                        davetler çalışmaz. Veri silinmez; firmayı sonra yeniden açabilirsiniz.
                    </p>
                    <label class="form-label" for="closeReason">Gerekçe *</label>
                    <input id="closeReason" class="form-control" maxlength="500" @bind="closeReason" @bind:event="oninput" />
                    <button type="button" class="btn btn-danger" disabled="@(busy || string.IsNullOrWhiteSpace(closeReason))" @onclick="CloseAsync">Firmayı kapat</button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="() => confirmingClose = false">Vazgeç</button>
                </div>
            }
            else if (IsOperational(tenant.Status))
            {
                <div class="account-actions">
                    @if (tenant.Status == TenantState.Trial)
                    {
                        <div>
                            <button type="button" class="btn btn-outline-primary" disabled="@busy" @onclick="ActivateAsync">Denemeyi etkinleştir</button>
                            <small class="text-muted">Firma deneme durumundan açık duruma geçer. Deneme süresi henüz otomatik uygulanmaz.</small>
                        </div>
                    }
                    <div>
                        <button type="button" class="btn btn-outline-danger" disabled="@busy" @onclick="() => confirmingClose = true">Firmayı kapat</button>
                        <small class="text-muted">Kullanıcılar giriş yapamaz; veri silinmez.</small>
                    </div>
                </div>
                <form class="inline-form" novalidate @onsubmit="SuspendAsync" @onsubmit:preventDefault>
                    <h3>Askıya al</h3>
                    <p class="text-muted">Erişim geçici olarak durur; veri silinmez. Gerekçe platform denetim kaydına yazılır.</p>
                    <div class="form-grid">
                        <div>
                            <label class="form-label" for="suspendReason">Gerekçe *</label>
                            <input id="suspendReason" class="form-control" maxlength="500" @bind="suspendReason" @bind:event="oninput" />
                            <FieldError Field="reason" Errors="suspendErrors" />
                        </div>
                    </div>
                    <div class="form-actions">
                        <button type="submit" class="btn btn-outline-danger" disabled="@(busy || string.IsNullOrWhiteSpace(suspendReason))">Askıya al</button>
                    </div>
                </form>
            }
            else
            {
                <div class="account-actions">
                    <div>
                        <button type="button" class="btn btn-outline-primary" disabled="@busy" @onclick="ReopenAsync">
                            @(tenant.Status == TenantState.Suspended ? "Askıyı kaldır" : "Firmayı yeniden aç")
                        </button>
                        <small class="text-muted">Üyeler ve bekleyen davetler yeniden çalışır.</small>
                    </div>
                </div>
            }
        </section>

        <section class="detail-section">
            <div class="section-header"><h2>Lisans ve işlem geçmişi</h2></div>
            <p class="text-muted">Bu firmada platform yöneticilerinin yaptığı işlemler; en yeni üstte. Kayıt değiştirilemez.</p>
            <PlatformAuditList TenantId="TenantId" Version="auditVersion" />
        </section>
    }
</PlatformGate>

@code {
    [Parameter] public Guid TenantId { get; set; }

    private PlatformTenantDetailResponse? detail;
    private PlatformModulesResponse? modules;
    private IReadOnlyList<SectorProfileDto> profiles = [];
    private string? profileKey;
    private ProfilePlanDto? plan;
    private string newName = string.Empty;
    private string inviteEmail = string.Empty;
    private string inviteName = string.Empty;
    private IReadOnlyDictionary<string, string[]>? inviteErrors;
    private IReadOnlyDictionary<string, string[]>? renameErrors;
    private string suspendReason = string.Empty;
    private IReadOnlyDictionary<string, string[]>? suspendErrors;
    private string closeReason = string.Empty;
    private string? termsModule;
    private LicenseSource termsSource = LicenseSource.Manual;
    private DateOnly? termsUntil;
    private string termsNote = string.Empty;
    private string termsReason = string.Empty;
    private IReadOnlyDictionary<string, string[]>? termsErrors;
    private int auditVersion;
    private bool confirmingClose;
    private bool busy;
    private string? message;
    private string? notice;

    protected override async Task OnParametersSetAsync()
    {
        modules = (await Api.GetAsync<PlatformModulesResponse>("/api/platform/modules")).Value;
        profiles = (await Api.GetAsync<List<SectorProfileDto>>("/api/platform/profiles")).Value ?? [];
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var result = await Api.GetAsync<PlatformTenantDetailResponse>($"/api/platform/tenants/{TenantId}");
        detail = result.Value;
        message = result.Error;
        auditVersion++;
        newName = detail?.Tenant.Name ?? string.Empty;
    }

    private async Task InviteAsync()
    {
        busy = true;
        var result = await Api.PostAsync<InviteTenantAdministratorResponse>(
            $"/api/platform/tenants/{TenantId}/administrators", new InviteTenantAdministratorRequest(inviteEmail, inviteName));
        busy = false;
        inviteErrors = result.FieldErrors;
        if (!result.IsSuccess)
        {
            Show(error: result.Error);
            return;
        }

        var invited = result.Value!;
        inviteEmail = inviteName = string.Empty;
        await LoadAsync();
        Show(success: invited.ExistingAccount
            ? $"{invited.Administrator.DisplayName} zaten Modulix kullanıyordu; yönetici olarak eklendi ve bilgilendirildi."
            : $"{invited.Administrator.Email} adresine yönetici daveti gönderildi.");
    }

    private async Task RenameAsync()
    {
        busy = true;
        var result = await Api.PutAsync<bool>($"/api/platform/tenants/{TenantId}", new RenameTenantRequest(newName));
        busy = false;
        renameErrors = result.FieldErrors;
        if (!result.IsSuccess)
        {
            Show(error: result.Error);
            return;
        }

        await LoadAsync();
        Show(success: "Firma adı kaydedildi.");
    }

    private async Task CloseAsync()
    {
        await ChangeStateAsync("close", "Firma kapatıldı. Veri silinmedi.", closeReason);
        closeReason = string.Empty;
    }

    private Task ReopenAsync() => ChangeStateAsync("reopen", "Firma yeniden açıldı.");

    private Task ActivateAsync() => ChangeStateAsync("activate", "Deneme etkinleştirildi.");

    private async Task SuspendAsync()
    {
        await ChangeStateAsync("suspend", "Firma askıya alındı. Veri silinmedi.", suspendReason);
        if (suspendErrors is null || suspendErrors.Count == 0)
        {
            suspendReason = string.Empty;
        }
    }

    private static bool IsOperational(TenantState state) => state is TenantState.Active or TenantState.Trial;

    private async Task ChangeStateAsync(string action, string success, string? reason = null)
    {
        busy = true;
        var result = await Api.PostAsync<bool>($"/api/platform/tenants/{TenantId}/{action}", new TenantReasonRequest(reason));
        busy = false;
        confirmingClose = false;
        suspendErrors = result.FieldErrors;
        if (!result.IsSuccess)
        {
            Show(error: result.FieldErrors.Count > 0 ? null : result.Error);
            return;
        }

        await LoadAsync();
        Show(success: success);
    }

    private async Task ModuleChangedAsync(PlatformModuleDto module, string? error)
    {
        var wasEnabled = detail?.Tenant.EnabledModules.Contains(module.Key) == true;
        await LoadAsync();
        Show(success: error is null ? $"{module.DisplayName} {(wasEnabled ? "kapatıldı. Veri silinmedi." : "açıldı.")}" : null, error: error);
    }

    private async Task PreviewProfileAsync(string? key)
    {
        profileKey = string.IsNullOrEmpty(key) ? null : key;
        plan = null;
        if (profileKey is not null)
        {
            var result = await Api.GetAsync<ProfilePlanDto>($"/api/platform/tenants/{TenantId}/profile/{Uri.EscapeDataString(profileKey)}");
            plan = result.Value;
            Show(error: result.Error);
        }
    }

    private async Task ApplyProfileAsync()
    {
        busy = true;
        var result = await Api.PostAsync<ProfilePlanDto>($"/api/platform/tenants/{TenantId}/profile/{Uri.EscapeDataString(profileKey!)}", new { });
        busy = false;
        if (!result.IsSuccess)
        {
            Show(error: result.Error);
            return;
        }

        var applied = result.Value!;
        profileKey = null;
        plan = null;
        await LoadAsync();
        Show(success: applied.IsEmpty
            ? $"{applied.ProfileName} profili kaydedildi; eklenecek bir şey yoktu."
            : $"{applied.ProfileName} profili uygulandı: {Summary(applied)}.");
    }

    private static string Summary(ProfilePlanDto plan) => string.Join(", ", new[]
    {
        plan.ModulesToEnable.Count > 0 ? $"{plan.ModulesToEnable.Count} modül" : null,
        plan.Fields.Count > 0 ? $"{plan.Fields.Count} alan" : null,
        plan.ListValues.Count > 0 ? $"{plan.ListValues.Count} liste değeri" : null,
    }.Where(p => p is not null));

    // Yalnızca açık ve varsayılandan farklı koşullar (elle ve süresiz olmayanlar) listelenir.
    private List<string> Conditions() =>
        (detail?.Entitlements ?? [])
            .Where(e => e.IsEnabled && (e.Source != LicenseSource.Manual || e.ValidUntil is not null || !string.IsNullOrWhiteSpace(e.Note)))
            .Select(e => string.Join(" · ", new[]
            {
                modules?.Modules.FirstOrDefault(m => m.Key == e.ModuleKey)?.DisplayName ?? e.ModuleKey,
                LicenseSourceText.Of(e.Source),
                e.ValidUntil is { } until ? $"{CrmLabels.Time(until)} tarihine kadar" : null,
                e.Note,
            }.Where(p => !string.IsNullOrWhiteSpace(p))))
            .ToList();

    // Seçilen modülün mevcut koşulları forma yüklenir.
    private void ChooseTermsModule(string? key)
    {
        termsModule = string.IsNullOrEmpty(key) ? null : key;
        var current = detail?.Entitlements?.FirstOrDefault(e => e.ModuleKey == termsModule);
        termsSource = current?.Source ?? LicenseSource.Manual;
        termsUntil = current?.ValidUntil is { } until ? DateOnly.FromDateTime(until.UtcDateTime) : null;
        termsNote = current?.Note ?? string.Empty;
        termsReason = string.Empty;
        termsErrors = null;
    }

    // Bitiş günü dahildir: seçilen günün sonu (UTC).
    private async Task SaveTermsAsync()
    {
        busy = true;
        DateTimeOffset? validUntil = termsUntil is { } day ? new DateTimeOffset(day.ToDateTime(new TimeOnly(23, 59, 59)), TimeSpan.Zero) : null;
        var result = await Api.PutAsync<bool>(
            $"/api/platform/tenants/{TenantId}/modules/{termsModule}",
            new SetTenantModuleRequest(true, termsSource, validUntil, string.IsNullOrWhiteSpace(termsNote) ? null : termsNote, termsReason));
        busy = false;
        termsErrors = result.FieldErrors;
        if (!result.IsSuccess)
        {
            Show(error: result.FieldErrors.Count > 0 ? null : result.Error);
            return;
        }

        termsModule = null;
        termsReason = termsNote = string.Empty;
        await LoadAsync();
        Show(success: "Hak koşulları kaydedildi.");
    }

    private string ProfileName(
string? key) => key is null ? "—" : profiles.FirstOrDefault(p => p.Key == key)?.Name ?? key;

    private void Show(string? success = null, string? error = null)
    {
        notice = success;
        message = error;
    }

    private string ModuleNames(IReadOnlyList<string> keys) =>
        keys.Count == 0
            ? "—"
            : string.Join(", ", keys.Select(k => modules?.Modules.FirstOrDefault(m => m.Key == k)?.DisplayName ?? k));
}
