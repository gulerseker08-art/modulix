@page "/platform/olaylar"
@inject ApiClient Api

<PageTitle>@Texts.Get("nav.app.platform.events") · @Texts.Get("nav.app.platform") · Modulix</PageTitle>

@* Olay teslimleri (ADR-0007): bekleyen, bekletilen ve başarısız teslimler; yeniden dene ve atla. Olayın içeriği (payload) gösterilmez. *@
<PlatformGate>
    <a class="back-link" href="platform">← @Texts.Get("nav.app.platform")</a>
    <h1>@Texts.Get("nav.app.platform.events")</h1>
    <p class="text-muted">@Texts.Get("platform.events.intro")</p>

    @if (notice is not null)
    {
        <div class="alert alert-success" role="status">@notice</div>
    }

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }

    @if (summary is not null)
    {
        <div class="tiles">
            <div class="tile"><strong>@summary.Pending</strong><span>@Texts.Get("platform.health.pending")</span></div>
            <div class="tile"><strong>@summary.Held</strong><span>@Texts.Get("platform.events.held")</span></div>
            <div class="tile"><strong>@summary.Failed</strong><span>@Texts.Get("platform.health.failed")</span></div>
            <div class="tile"><strong>@Age(summary.OldestUndispatched)</strong><span>@Texts.Get("platform.events.oldestUndispatched")</span></div>
            <div class="tile"><strong>@Age(summary.OldestPending)</strong><span>@Texts.Get("platform.events.oldestPending")</span></div>
        </div>

        <div class="filters" role="group" aria-label="@Texts.Get("common.field.status")">
            <button type="button" class="chip @(state is null ? "active" : null)" @onclick="() => StateAsync(null)">@Texts.Get("support.all")</button>
            @foreach (var value in States)
            {
                <button type="button" class="chip @(state == value ? "active" : null)" @onclick="() => StateAsync(value)">@PlatformLabels.EventStateOf(value)</button>
            }
        </div>

        <form class="record-form audit-filters" @onsubmit="() => LoadAsync(1)" @onsubmit:preventDefault>
            <div class="row g-2">
                <div class="col-sm-6 col-lg-3">
                    <label class="form-label" for="eventTenant">@Texts.Get("platform.events.tenantId")</label>
                    <input id="eventTenant" class="form-control" @bind="tenantId" placeholder="@Texts.Get("support.all")" />
                </div>
                <div class="col-sm-6 col-lg-3">
                    <label class="form-label" for="eventSubscription">@Texts.Get("platform.events.subscription")</label>
                    <select id="eventSubscription" class="form-select" @bind="subscription">
                        <option value="">@Texts.Get("support.all")</option>
                        @foreach (var key in summary.Subscriptions)
                        {
                            <option value="@key">@key</option>
                        }
                    </select>
                </div>
                <div class="col-sm-6 col-lg-2">
                    <label class="form-label" for="eventType">@Texts.Get("platform.events.eventType")</label>
                    <select id="eventType" class="form-select" @bind="eventType">
                        <option value="">@Texts.Get("support.all")</option>
                        @foreach (var type in summary.EventTypes)
                        {
                            <option value="@type">@type</option>
                        }
                    </select>
                </div>
                <div class="col-sm-6 col-lg-2">
                    <label class="form-label" for="eventFrom">@Texts.Get("platform.events.from")</label>
                    <input id="eventFrom" class="form-control" type="date" @bind="from" />
                </div>
                <div class="col-sm-6 col-lg-2">
                    <label class="form-label" for="eventTo">@Texts.Get("platform.events.to")</label>
                    <input id="eventTo" class="form-control" type="date" @bind="to" />
                </div>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn-outline-secondary">@Texts.Get("platform.events.filter")</button>
                <button type="button" class="btn btn-outline-primary" disabled="@(busy || page is not { TotalCount: > 0 })" @onclick="() => ActAsync(Retry, null)">@Texts.Get("platform.events.retryFiltered")</button>
                <button type="button" class="btn btn-outline-danger" disabled="@(busy || page is not { TotalCount: > 0 })" @onclick="() => ActAsync(Skip, null)">@Texts.Get("platform.events.skipFiltered")</button>
            </div>
        </form>
    }

    @if (page is null)
    {
        @if (message is null)
        {
            <LoadingState Kind="LoadingKind.Table" />
        }
    }
    else if (page.Items.Count == 0)
    {
        <EmptyState Title="@Texts.Get("platform.events.empty")" />
    }
    else
    {
        <table class="table record-table">
            <thead>
                <tr>
                    <th scope="col"><SortHeader Label="@Texts.Get("platform.openedAt")" ColumnIcon="calendar" Asc="createdAt" Desc="-createdAt" Value="@sort" Default="-createdAt" ValueChanged="SortAsync" /></th>
                    <th scope="col"><SortHeader Label="@Texts.Get("platform.tenant")" ColumnIcon="building" Asc="tenant" Desc="-tenant" Value="@sort" Default="-createdAt" ValueChanged="SortAsync" /></th>
                    <th scope="col"><SortHeader Label="@Texts.Get("platform.events.subscription")" ColumnIcon="repeat" Asc="subscription" Desc="-subscription" Value="@sort" Default="-createdAt" ValueChanged="SortAsync" /></th>
                    <th scope="col">@Texts.Get("platform.health.event")</th>
                    <th scope="col">@Texts.Get("platform.events.record")</th>
                    <th scope="col">@Texts.Get("common.field.status")</th>
                    <th scope="col"><SortHeader Label="@Texts.Get("platform.events.attempts")" ColumnIcon="hash" Asc="attemptCount" Desc="-attemptCount" Value="@sort" Default="-createdAt" ValueChanged="SortAsync" /></th>
                    <th scope="col">@Texts.Get("platform.events.lastError")</th>
                    <th scope="col"><span class="visually-hidden">@Texts.Get("common.actions")</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var delivery in page.Items)
                {
                    <tr>
                        <td data-label="@Texts.Get("platform.openedAt")">@CrmLabels.Time(delivery.CreatedAt)</td>
                        <td data-label="@Texts.Get("platform.tenant")" class="primary"><a href="platform/firmalar/@delivery.TenantId">@delivery.TenantName</a></td>
                        <td data-label="@Texts.Get("platform.events.subscription")"><code>@delivery.Subscription</code></td>
                        <td data-label="@Texts.Get("platform.health.event")">@delivery.EventType <small class="text-muted">@delivery.EventId</small></td>
                        <td data-label="@Texts.Get("platform.events.record")">@delivery.EntityKey <small class="text-muted">@delivery.RecordId@(delivery.Sequence is { } seq ? $" · #{seq}" : null)</small></td>
                        <td data-label="@Texts.Get("common.field.status")">
                            @PlatformLabels.EventStateOf(delivery.State)
                            @if (delivery.HoldingBack > 0)
                            {
                                <span class="badge user-locked" title="@Texts.Get("platform.events.holdingTitle")">@Texts.Get("platform.events.holding", delivery.HoldingBack)</span>
                            }
                            @if (delivery.State == EventDeliveryStateDto.Pending && delivery.AttemptCount > 0)
                            {
                                <small class="text-muted d-block">@Texts.Get("platform.events.nextAttempt", CrmLabels.Time(delivery.NextAttemptAt))</small>
                            }
                        </td>
                        <td data-label="@Texts.Get("platform.events.attempts")">@delivery.AttemptCount</td>
                        <td data-label="@Texts.Get("platform.events.lastError")"><small>@delivery.LastError</small></td>
                        <td data-label="">
                            @if (delivery.State is EventDeliveryStateDto.Failed or EventDeliveryStateDto.Pending or EventDeliveryStateDto.Held)
                            {
                                <button type="button" class="btn btn-sm btn-outline-primary" disabled="@busy" @onclick="() => ActAsync(Retry, delivery.Id)">@Texts.Get("admin.automationRun.retry")</button>
                                <button type="button" class="btn btn-sm btn-outline-danger" disabled="@busy" @onclick="() => ActAsync(Skip, delivery.Id)">@Texts.Get("platform.events.skip")</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager PageSizeChoice="true" Page="page.Page" PageSize="page.PageSize" TotalCount="page.TotalCount" PageChanged="LoadAsync" />
    }
</PlatformGate>

@code {
    private static readonly EventDeliveryStateDto[] States =
    [
        EventDeliveryStateDto.Pending, EventDeliveryStateDto.Held, EventDeliveryStateDto.Failed,
        EventDeliveryStateDto.Succeeded, EventDeliveryStateDto.Skipped,
    ];

    private const string Retry = "retry";
    private const string Skip = "skip";

    private EventSummaryResponse? summary;
    private EventDeliveryPageResponse? page;
    private EventDeliveryStateDto? state = EventDeliveryStateDto.Failed;
    private string? tenantId;
    private string? subscription;
    private string? eventType;
    private DateOnly? from;
    private DateOnly? to;
    private bool busy;
    private string? message;
    private string? notice;

    protected override async Task OnInitializedAsync()
    {
        await LoadSummaryAsync();
        if (summary is not null)
        {
            await LoadAsync(1);
        }
    }

    private async Task LoadSummaryAsync()
    {
        var result = await Api.GetAsync<EventSummaryResponse>("/api/platform/events/summary");
        summary = result.Value ?? summary;
        message = result.Error;
    }

    private async Task StateAsync(EventDeliveryStateDto? value)
    {
        state = value;
        await LoadAsync(1);
    }

    // Günlük varsayılan olarak en yeni önce gelir; sıralama sunucudadır (EventDeliveryQuery.SortKeys).
    private const string DefaultSort = "-createdAt";

    private string sort = DefaultSort;

    private async Task SortAsync(string value)
    {
        sort = value;
        await LoadAsync(1);
    }

    private async Task LoadAsync(int pageNumber)
    {
        if (!string.IsNullOrWhiteSpace(tenantId) && !Guid.TryParse(tenantId, out _))
        {
            message = Texts.Get("platform.events.invalidTenant");
            return;
        }

        var filter = Filter();
        var query = new List<string> { $"page={pageNumber}&pageSize={ListPaging.Size}&sort={Uri.EscapeDataString(sort)}" };
        Add(query, "tenantId", filter.TenantId?.ToString());
        Add(query, "subscription", filter.Subscription);
        Add(query, "eventType", filter.EventType);
        Add(query, "state", filter.State?.ToString());
        Add(query, "from", filter.From?.ToString("yyyy-MM-dd"));
        Add(query, "to", filter.To?.ToString("yyyy-MM-dd"));

        var result = await Api.GetAsync<EventDeliveryPageResponse>($"/api/platform/events/deliveries?{string.Join('&', query)}");
        page = result.Value;
        message = result.Error;
    }

    private async Task ActAsync(string action, Guid? id)
    {
        busy = true;
        notice = null;
        var request = id is { } one ? new EventDeliveryActionRequest([one], null) : new EventDeliveryActionRequest(null, Filter());
        var result = await Api.PostAsync<EventDeliveryActionResponse>($"/api/platform/events/deliveries/{action}", request);
        busy = false;
        if (result.IsSuccess)
        {
            var changed = result.Value!.Changed;
            notice = changed == 0
                ? Texts.Get("platform.events.noChange")
                : Texts.Get(action == Retry ? "platform.events.retried" : "platform.events.skipped", changed);
            await LoadSummaryAsync();
            await LoadAsync(page?.Page ?? 1);
        }
        else
        {
            message = result.Error;
        }
    }

    private EventDeliveryFilterDto Filter() => new(
        Guid.TryParse(tenantId, out var tenant) ? tenant : null,
        string.IsNullOrEmpty(subscription) ? null : subscription,
        string.IsNullOrEmpty(eventType) ? null : eventType,
        state,
        from,
        to);

    private static void Add(List<string> query, string name, string? value)
    {
        if (!string.IsNullOrEmpty(value))
        {
            query.Add($"{name}={Uri.EscapeDataString(value)}");
        }
    }

    private static string Age(DateTimeOffset? since)
    {
        if (since is not { } at)
        {
            return "—";
        }

        var age = DateTimeOffset.UtcNow - at;
        return age.TotalMinutes < 1 ? Texts.Get("platform.age.lessThanMinute") : age.TotalHours < 1 ? Texts.Get("platform.age.minutes", age.TotalMinutes.ToString("0")) : Texts.Get("platform.age.hours", age.TotalHours.ToString("0.#"));
    }
}
