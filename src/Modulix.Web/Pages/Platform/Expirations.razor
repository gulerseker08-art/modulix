@page "/platform/sure-takvimi"
@inject ApiClient Api

<PageTitle>@Texts.Get("platform.expirations.title") · @Texts.Get("nav.app.platform") · Modulix</PageTitle>

@* Bitiş tarihi olan açık modül hakları (ADR-0028). Bitişten sonra ek süre başlar (yazma açık), ek süre de bitince modül salt okunur
   olur; veri silinmez. Geçmiş tarihliler en üstte görünür. *@
<PlatformGate>
    <a class="back-link" href="platform">← @Texts.Get("nav.app.platform")</a>
    <h1>@Texts.Get("platform.expirations.title")</h1>
    <p class="text-muted">@Texts.Get("platform.expirations.intro")</p>

    <div class="filters" role="group" aria-label="@Texts.Get("platform.expirations.window")">
        @foreach (var choice in Windows)
        {
            <button type="button" class="chip @(days == choice ? "active" : null)" @onclick="() => LoadAsync(choice)">@Texts.Get("platform.expirations.days", choice)</button>
        }
    </div>

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }

    @if (items is null)
    {
        @if (message is null)
        {
            <LoadingState Kind="LoadingKind.Table" />
        }
    }
    else if (items.Count == 0)
    {
        <EmptyState Title="@Texts.Get("platform.expirations.empty")" />
    }
    else
    {
        <table class="table record-table">
            <thead><tr><th>@Texts.Get("platform.tenant")</th><th>@Texts.Get("platform.module")</th><th>@Texts.Get("platform.source")</th><th>@Texts.Get("platform.until")</th><th>@Texts.Get("common.field.status")</th><th>@Texts.Get("platform.note")</th></tr></thead>
            <tbody>
                @foreach (var item in items)
                {
                    <tr>
                        <td data-label="@Texts.Get("platform.tenant")" class="primary">
                            <a href="platform/firmalar/@item.TenantId">@item.TenantName</a>
                            @if (item.TenantStatus != TenantState.Active)
                            {
                                <TenantStateBadge State="item.TenantStatus" />
                            }
                        </td>
                        <td data-label="@Texts.Get("platform.module")">@ModuleName(item.ModuleKey)</td>
                        <td data-label="@Texts.Get("platform.source")">@PlatformLabels.LicenseSourceOf(item.Source)</td>
                        <td data-label="@Texts.Get("platform.until")">@CrmLabels.Time(item.ValidUntil)</td>
                        <td data-label="@Texts.Get("common.field.status")">
                            @switch (item.Phase)
                            {
                                case LicensePhase.ReadOnly:
                                    <span class="badge user-locked">@Texts.Get("platform.expirations.readOnly")</span>
                                    break;
                                case LicensePhase.Grace:
                                    <span class="badge user-locked">@Texts.Get("platform.expirations.grace")</span>
                                    <small class="text-muted d-block">@Texts.Get("platform.expirations.graceEnds", CrmLabels.Time(item.GraceEndsAt))</small>
                                    break;
                                default:
                                    @Texts.Get("platform.expirations.daysLeft", Math.Ceiling((item.ValidUntil - DateTimeOffset.UtcNow).TotalDays).ToString("0", System.Globalization.CultureInfo.InvariantCulture))
                                    break;
                            }
                        </td>
                        <td data-label="@Texts.Get("platform.note")">@(item.Note ?? "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</PlatformGate>

@code {
    private static readonly int[] Windows = [30, 60, 90];

    private IReadOnlyList<PlatformExpirationDto>? items;
    private PlatformModulesResponse? modules;
    private int days = 90;
    private string? message;

    protected override async Task OnInitializedAsync()
    {
        modules = (await Api.GetAsync<PlatformModulesResponse>("/api/platform/modules")).Value;
        await LoadAsync(days);
    }

    private async Task LoadAsync(int window)
    {
        days = window;
        var result = await Api.GetAsync<List<PlatformExpirationDto>>($"/api/platform/expirations?days={window}");
        items = result.Value;
        message = result.Error;
    }

    private string ModuleName(string key) => modules?.Modules.FirstOrDefault(m => m.Key == key)?.DisplayName ?? key;
}
