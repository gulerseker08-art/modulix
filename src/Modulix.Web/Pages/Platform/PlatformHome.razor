@page "/platform"
@inject ApiClient Api

<PageTitle>Platform · Modulix</PageTitle>

@* Platform yönetiminin giriş sayfası (Y4). *@
<PlatformGate>
    <h1>Platform</h1>
    <p class="text-muted">Firmaları, modül haklarını, süreleri ve olay teslimlerini yönetin. Firmaların kayıtları burada görünmez.</p>

    @if (overview is not null)
    {
        <section class="detail-section" aria-label="Genel bakış">
            <div class="section-header"><h2>Genel bakış</h2></div>
            <dl class="detail-grid">
                @foreach (var count in overview.TenantCounts)
                {
                    <div><dt>@TenantStateText.Of(count.State)</dt><dd>@count.Count</dd></div>
                }
                <div><dt>Başarısız teslim</dt><dd><a href="platform/olaylar">@(failedDeliveries?.ToString() ?? "—")</a></dd></div>
            </dl>
            <p class="text-muted">
                Süresi yaklaşan haklar:
                <a href="platform/sure-takvimi">30 günde @overview.ExpiringIn30Days · 60 günde @overview.ExpiringIn60Days · 90 günde @overview.ExpiringIn90Days</a>
                @if (overview.Expired > 0)
                {
                    <span class="badge user-locked">@overview.Expired hakkın süresi geçti</span>
                }
            </p>
        </section>
    }

    <div class="tiles">
        <a class="tile" href="platform/firmalar"><strong>Firmalar</strong><span>Firma açma, kapatma, ilk yönetici</span></a>
        <a class="tile" href="platform/moduller"><strong>Modül hakları</strong><span>Firma × modül, aç/kapa</span></a>
        <a class="tile" href="platform/katalog"><strong>Modül kataloğu</strong><span>Modüller, izinler, hazır roller</span></a>
        <a class="tile" href="platform/sektorler"><strong>Sektörler ve faaliyetler</strong><span>Sektör → grup → faaliyet kataloğu, yetenekler</span></a>
        <a class="tile" href="platform/olaylar"><strong>Olaylar</strong><span>Başarısız teslimler, yeniden dene, atla</span></a>
        <a class="tile" href="platform/sure-takvimi"><strong>Süre takvimi</strong><span>Bitişi yaklaşan modül hakları</span></a>
        <a class="tile" href="platform/denetim"><strong>Platform denetimi</strong><span>Firmalar arası işlem kaydı</span></a>
    </div>

    @* Y7b: telefonunu ve kurtarma kodlarını kaybeden kişinin iki adımlı doğrulaması yalnızca buradan sıfırlanır. *@
    <form class="record-form settings-group mt-4" novalidate @onsubmit="ResetTwoFactorAsync" @onsubmit:preventDefault>
        <h2>İki adımlı doğrulamayı sıfırla</h2>
        <p class="text-muted">Telefonuna ve kurtarma kodlarına erişemeyen kişi için. Kimliğini doğruladıktan sonra kullanın: doğrulama kapanır, kişinin tüm oturumları kapatılır ve işlem denetim kaydına yazılır.</p>
        <Notice Text="@notice" Failed="failed" />
        <div class="mb-3">
            <label class="form-label" for="resetEmail">Kişinin e-postası</label>
            <input id="resetEmail" class="form-control" type="email" autocomplete="off" @bind="email" @bind:event="oninput" />
            <FieldError Field="email" Errors="errors" />
        </div>
        <div class="form-actions">
            <button type="submit" class="btn btn-outline-danger" disabled="@(busy || string.IsNullOrWhiteSpace(email))">Sıfırla</button>
        </div>
    </form>
</PlatformGate>

@code {
    private PlatformOverviewResponse? overview;
    private int? failedDeliveries;
    private string email = string.Empty;
    private string? notice;
    private bool failed;
    private bool busy;
    private IReadOnlyDictionary<string, string[]>? errors;

    protected override async Task OnInitializedAsync()
    {
        overview = (await Api.GetAsync<PlatformOverviewResponse>("/api/platform/overview")).Value;
        failedDeliveries = (await Api.GetAsync<EventSummaryResponse>("/api/platform/events/summary")).Value?.Failed;
    }

    private async Task ResetTwoFactorAsync()
    {
        busy = true;
        var target = email.Trim();
        var result = await Api.PostAsync<bool>("/api/platform/users/reset-two-factor", new ResetTwoFactorRequest(target));
        busy = false;
        errors = result.FieldErrors;
        if (result.IsSuccess)
        {
            (notice, failed, email) = ($"{target} için iki adımlı doğrulama kapatıldı ve oturumları sonlandırıldı.", false, string.Empty);
        }
        else
        {
            (notice, failed) = (result.FieldErrors.Count > 0 ? null : result.Error, true);
        }
    }
}
