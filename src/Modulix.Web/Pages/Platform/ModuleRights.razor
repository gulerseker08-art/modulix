@page "/platform/moduller"
@inject ApiClient Api

<PageTitle>@Texts.Get("nav.app.platform.modules") · @Texts.Get("nav.app.platform") · Modulix</PageTitle>

@* Firma × modül (Y4b). Açma ve kapama firmanın bir sonraki isteğinde geçerli olur ve firmanın denetim kaydına yazılır. *@
<PlatformGate>
    <a class="back-link" href="platform">← @Texts.Get("nav.app.platform")</a>
    <h1>@Texts.Get("nav.app.platform.modules")</h1>
    <p class="text-muted">@Texts.Get("platform.moduleRights.intro")</p>

    @if (notice is not null)
    {
        <div class="alert alert-success" role="status">@notice</div>
    }

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }

    <div class="filters" role="group" aria-label="@Texts.Get("common.field.status")">
        <button type="button" class="chip @(status is null ? "active" : null)" @onclick="() => FilterAsync(null)">@Texts.Get("support.all")</button>
        @foreach (var value in Enum.GetValues<TenantState>())
        {
            <button type="button" class="chip @(status == value ? "active" : null)" @onclick="() => FilterAsync(value)">@PlatformLabels.TenantStateOf(value)</button>
        }
    </div>

    <form class="search" @onsubmit="() => LoadAsync(1)" @onsubmit:preventDefault>
        <input class="form-control" type="search" aria-label="@Texts.Get("platform.tenants.search")" placeholder="@Texts.Get("platform.tenants.search")" @bind="search" />
        <button type="submit" class="btn btn-outline-secondary">@Texts.Get("common.search")</button>
    </form>

    @if (page is null || modules is null)
    {
        @if (message is null)
        {
            <LoadingState Kind="LoadingKind.Table" />
        }
    }
    else if (page.Items.Count == 0)
    {
        <EmptyState Title="@Texts.Get("platform.tenants.empty")" />
    }
    else
    {
        <table class="table record-table">
            <thead>
                <tr>
                    <th scope="col"><SortHeader Label="@Texts.Get("platform.tenant")" ColumnIcon="building" Asc="name" Desc="-name" Value="@sort" Default="" ValueChanged="SortAsync" /></th>
                    @foreach (var module in modules.Modules)
                    {
                        <th>@module.DisplayName</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var tenant in page.Items)
                {
                    <tr>
                        <td data-label="@Texts.Get("platform.tenant")" class="primary">
                            <a href="platform/firmalar/@tenant.Id">@tenant.Name</a>
                            @if (tenant.Status != TenantState.Active)
                            {
                                <TenantStateBadge State="tenant.Status" />
                            }
                        </td>
                        @foreach (var module in modules.Modules)
                        {
                            <td data-label="@module.DisplayName">
                                <ModuleToggle TenantId="tenant.Id" TenantName="@tenant.Name" ModuleKey="@module.Key" ModuleName="@module.DisplayName"
                                              Enabled="tenant.EnabledModules.Contains(module.Key)"
                                              Changed="error => ChangedAsync(tenant, module, error)" />
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
        <Pager PageSizeChoice="true" Page="page.Page" PageSize="page.PageSize" TotalCount="page.TotalCount" PageChanged="LoadAsync" />
    }
</PlatformGate>

@code {
    private PlatformTenantPageResponse? page;
    private PlatformModulesResponse? modules;
    private string? search;
    private TenantState? status;
    private string? message;
    private string? notice;

    protected override async Task OnInitializedAsync()
    {
        var result = await Api.GetAsync<PlatformModulesResponse>("/api/platform/modules");
        modules = result.Value;
        message = result.Error;
        if (result.IsSuccess)
        {
            await LoadAsync(1);
        }
    }

    private async Task FilterAsync(TenantState? value)
    {
        status = value;
        await LoadAsync(1);
    }

    // Sıralama sunucudadır (PlatformTenantQuery.SortKeys); boş değer varsayılan sıradır.
    private string sort = "";

    private async Task SortAsync(string value)
    {
        sort = value;
        await LoadAsync(1);
    }

    private async Task LoadAsync(int pageNumber)
    {
        var url = $"/api/platform/tenants?page={pageNumber}&pageSize={ListPaging.Size}&search={Uri.EscapeDataString(search ?? string.Empty)}";
        if (status is { } s)
        {
            url += $"&status={s}";
        }

        if (sort.Length > 0)
        {
            url += $"&sort={Uri.EscapeDataString(sort)}";
        }

        var result = await Api.GetAsync<PlatformTenantPageResponse>(url);
        page = result.Value;
        message = result.Error;
    }

    private async Task ChangedAsync(PlatformTenantDto tenant, PlatformModuleDto module, string? error)
    {
        var wasEnabled = tenant.EnabledModules.Contains(module.Key);
        await LoadAsync(page?.Page ?? 1);
        message = error;
        notice = error is null
            ? Texts.Get(wasEnabled ? "platform.moduleRights.disabled" : "platform.moduleRights.enabled", tenant.Name, module.DisplayName)
            : null;
    }
}
