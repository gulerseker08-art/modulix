@page "/platform/katalog"
@inject ApiClient Api

<PageTitle>@Texts.Get("nav.app.platform.catalog") · @Texts.Get("nav.app.platform") · Modulix</PageTitle>

@* Kayıtlı modüller, izinleri, hazır rolleri ve kaç firmada açık oldukları (Y4b). Salt okunur: modül eklemek kodla olur. *@
<PlatformGate>
    <a class="back-link" href="platform">← @Texts.Get("nav.app.platform")</a>
    <h1>@Texts.Get("nav.app.platform.catalog")</h1>
    <p class="text-muted">@Texts.Get("platform.catalog.intro")</p>

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }

    @if (catalog is null)
    {
        @if (message is null)
        {
            <LoadingState />
        }
    }
    else
    {
        @foreach (var module in catalog)
        {
            <section class="detail-section catalog-module">
                <div class="section-header">
                    <h2>@module.DisplayName <code>@module.Key</code></h2>
                    <span class="badge tag">
                        @(module.IsAlwaysEnabled ? Texts.Get("platform.catalog.always") : Texts.Get("platform.catalog.enabledIn", module.EnabledTenantCount))
                    </span>
                </div>

                <table class="table record-table">
                    <thead><tr><th>@Texts.Get("platform.catalog.resource")</th><th>@Texts.Get("platform.catalog.permission")</th><th>@Texts.Get("platform.plans.key")</th></tr></thead>
                    <tbody>
                        @foreach (var permission in module.Permissions)
                        {
                            <tr>
                                <td data-label="@Texts.Get("platform.catalog.resource")">@permission.ResourceName</td>
                                <td data-label="@Texts.Get("platform.catalog.permission")" class="primary">@permission.DisplayName</td>
                                <td data-label="@Texts.Get("platform.plans.key")"><code>@permission.Key</code></td>
                            </tr>
                        }
                    </tbody>
                </table>

                @if (module.Templates.Count > 0)
                {
                    <h3 class="h6">@Texts.Get("platform.templates")</h3>
                    <ul>
                        @foreach (var template in module.Templates)
                        {
                            <li>
                                <strong>@template.Name</strong> <span class="text-muted">@template.Description</span>
                                <small class="text-muted">@Texts.Get("platform.catalog.permissionCount", template.Permissions.Count)</small>
                            </li>
                        }
                    </ul>
                }
                else if (module.IsAlwaysEnabled)
                {
                    <p class="text-muted">@Texts.Get("platform.catalog.readOnlyRole")</p>
                }
            </section>
        }
    }
</PlatformGate>

@code {
    private IReadOnlyList<CatalogModuleDto>? catalog;
    private string? message;

    protected override async Task OnInitializedAsync()
    {
        var result = await Api.GetAsync<List<CatalogModuleDto>>("/api/platform/catalog");
        catalog = result.Value;
        message = result.Error;
    }
}
