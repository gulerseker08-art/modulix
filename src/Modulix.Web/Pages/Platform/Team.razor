@page "/platform/ekip"
@inject ApiClient Api
@inject SessionState Session

<PageTitle>@Texts.Get("platform.team.title") · @Texts.Get("nav.app.platform") · Modulix</PageTitle>

@* Platform ekibi ve rolleri (ADR-0028 Dilim 5). Yalnızca platform sahibi (Owner) yönetir; sunucu her istekte denetler.
   Hesap silinmez: rolleri boşaltmak yalnızca platform erişimini kapatır. Platform sahibi komut satırıyla atanır. *@
<PlatformGate>
    <a class="back-link" href="platform">← @Texts.Get("nav.app.platform")</a>
    <h1>@Texts.Get("platform.team.title")</h1>
    <p class="text-muted">
        @Texts.Strong("platform.team.intro", Texts.Get("platform.team.roleLabel", PlatformLabels.RoleOf(PlatformRoleNames.Support)),
            Texts.Get("platform.team.roleLabel", PlatformLabels.RoleOf(PlatformRoleNames.Operations)),
            Texts.Get("platform.team.roleLabel", PlatformLabels.RoleOf(PlatformRoleNames.Finance)))
    </p>

    @if (!Session.IsPlatformOwner)
    {
        <div class="alert alert-warning">@Texts.Get("platform.team.ownerOnly")</div>
    }
    else
    {
        <Notice Text="@notice" Failed="failed" />

        <form class="record-form settings-group" novalidate @onsubmit="AddAsync" @onsubmit:preventDefault>
            <h2>@Texts.Get("platform.team.add")</h2>
            <p class="text-muted">@Texts.Get("platform.team.addIntro")</p>
            <div class="form-grid">
                <div>
                    <label class="form-label" for="teamEmail">@Texts.Get("admin.invite.email")</label>
                    <input id="teamEmail" class="form-control" type="email" autocomplete="off" @bind="email" @bind:event="oninput" />
                    <FieldError Field="email" Errors="errors" />
                </div>
            </div>
            <fieldset class="mt-3">
                <legend class="form-label">@Texts.Get("nav.app.admin.roles")</legend>
                @foreach (var role in Assignable)
                {
                    <div class="form-check">
                        <input id="new-@role" class="form-check-input" type="checkbox" checked="@newRoles.Contains(role)" @onchange="e => Toggle(newRoles, role, (bool)e.Value!)" />
                        <label class="form-check-label" for="new-@role">@PlatformLabels.RoleOf(role)</label>
                    </div>
                }
                <FieldError Field="roles" Errors="errors" />
            </fieldset>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary" disabled="@(busy || string.IsNullOrWhiteSpace(email) || newRoles.Count == 0)">@Texts.Get("common.add")</button>
            </div>
        </form>

        @if (members is null)
        {
            <LoadingState Kind="LoadingKind.Table" />
        }
        else
        {
            <table class="table record-table">
                <thead><tr><th>@Texts.Get("common.field.name")</th><th>@Texts.Get("common.field.email")</th><th>@Texts.Get("nav.app.admin.roles")</th><th>@Texts.Get("admin.users.col.twoFactor")</th><th></th></tr></thead>
                <tbody>
                    @foreach (var member in members)
                    {
                        <tr>
                            <td data-label="@Texts.Get("common.field.name")" class="primary">@member.DisplayName</td>
                            <td data-label="@Texts.Get("common.field.email")">@member.Email</td>
                            <td data-label="@Texts.Get("nav.app.admin.roles")">
                                @if (member.Roles.Contains(PlatformRoleNames.Owner))
                                {
                                    <span class="badge user-active">@PlatformLabels.RoleOf(PlatformRoleNames.Owner)</span>
                                }
                                else
                                {
                                    @foreach (var role in Assignable)
                                    {
                                        <label class="me-2">
                                            <input type="checkbox" checked="@member.Roles.Contains(role)" disabled="@busy"
                                                   @onchange="e => ChangeAsync(member, role, (bool)e.Value!)" />
                                            @PlatformLabels.RoleOf(role)
                                        </label>
                                    }
                                }
                            </td>
                            <td data-label="@Texts.Get("admin.users.col.twoFactor")">
                                <span class="badge @(member.TwoFactorEnabled ? "user-active" : "user-locked")">@(member.TwoFactorEnabled ? Texts.Get("two-factor.on") : Texts.Get("two-factor.off"))</span>
                            </td>
                            <td class="actions">
                                @if (!member.Roles.Contains(PlatformRoleNames.Owner) && member.UserId != Session.User?.UserId)
                                {
                                    <ConfirmAction Disabled="@busy" OnConfirm="() => RemoveAsync(member)">@Texts.Get("platform.team.revoke")</ConfirmAction>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }
</PlatformGate>

@code {
    private static readonly string[] Assignable = [PlatformRoleNames.Support, PlatformRoleNames.Operations, PlatformRoleNames.Finance];

    private IReadOnlyList<PlatformTeamMemberDto>? members;
    private readonly HashSet<string> newRoles = [];
    private string email = string.Empty;
    private IReadOnlyDictionary<string, string[]>? errors;
    private string? notice;
    private bool failed;
    private bool busy;

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (Session.IsPlatformOwner)
        {
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        var result = await Api.GetAsync<List<PlatformTeamMemberDto>>("/api/platform/team");
        members = result.Value;
        if (!result.IsSuccess)
        {
            (notice, failed) = (result.Error, true);
        }
    }

    private static void Toggle(HashSet<string> set, string role, bool on)
    {
        if (on)
        {
            set.Add(role);
        }
        else
        {
            set.Remove(role);
        }
    }

    private async Task AddAsync()
    {
        busy = true;
        var result = await Api.PostAsync<PlatformTeamMemberDto>("/api/platform/team", new AddPlatformMemberRequest(email.Trim(), [.. newRoles]));
        busy = false;
        errors = result.FieldErrors;
        if (!result.IsSuccess)
        {
            (notice, failed) = (result.FieldErrors.Count > 0 ? null : result.Error, true);
            return;
        }

        (notice, failed, email) = (Texts.Get("platform.team.added", result.Value!.DisplayName), false, string.Empty);
        newRoles.Clear();
        await LoadAsync();
    }

    private async Task ChangeAsync(PlatformTeamMemberDto member, string role, bool on)
    {
        var roles = member.Roles.Where(r => r != role).ToList();
        if (on)
        {
            roles.Add(role);
        }

        await SaveAsync(member, roles, Texts.Get("platform.team.rolesUpdated", member.DisplayName));
    }

    private Task RemoveAsync(PlatformTeamMemberDto member) =>
        SaveAsync(member, [], Texts.Get("platform.team.removed", member.DisplayName));

    private async Task SaveAsync(PlatformTeamMemberDto member, IReadOnlyList<string> roles, string success)
    {
        busy = true;
        var result = await Api.PutAsync<PlatformTeamMemberDto>($"/api/platform/team/{member.UserId}", new SetPlatformRolesRequest(roles));
        busy = false;
        (notice, failed) = result.IsSuccess ? (success, false) : (result.Error, true);
        await LoadAsync();
    }
}
