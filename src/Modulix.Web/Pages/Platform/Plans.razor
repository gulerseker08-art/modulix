@page "/platform/planlar"
@inject ApiClient Api

<PageTitle>@Texts.Get("platform.plans.title") · @Texts.Get("nav.app.platform") · Modulix</PageTitle>

@* Satış paketleri (ADR-0028 Dilim 4): modül seti ve limitler. Plan silinmez, kapatılır; modül seti değişince geçerli abonelerin
   modül hakları da güncellenir (eklenen açılır, çıkan kapanır; veri silinmez), limitler hemen güncel plandan çözülür. *@
<PlatformGate>
    <a class="back-link" href="platform">← @Texts.Get("nav.app.platform")</a>
    <h1>@Texts.Get("platform.plans.title")</h1>
    <p class="text-muted">@Texts.Get("platform.plans.intro")</p>

    <Notice Text="@notice" Failed="failed" />

    <div class="list-toolbar">
        @if (editing is null)
        {
            <button type="button" class="btn btn-primary" @onclick="StartNew"><AppIcon Name="plus" Size="16" /> @Texts.Get("platform.plans.new")</button>
        }
    </div>

    @if (editing is not null && modules is not null)
    {
        <form class="record-form settings-group" novalidate @onsubmit="SaveAsync" @onsubmit:preventDefault>
            <h2>@(editing.Id is null ? Texts.Get("platform.plans.new") : Texts.Get("platform.plans.edit"))</h2>
            <div class="form-grid">
                <div>
                    <label class="form-label" for="planKey">@Texts.Get("platform.plans.keyRequired")</label>
                    <input id="planKey" class="form-control" maxlength="40" disabled="@(editing.Id is not null)" @bind="editing.Key" />
                    <FieldError Field="key" Errors="errors" />
                </div>
                <div>
                    <label class="form-label" for="planName">@Texts.Get("common.field.nameRequired")</label>
                    <input id="planName" class="form-control" maxlength="100" @bind="editing.Name" />
                    <FieldError Field="name" Errors="errors" />
                </div>
                <div>
                    <label class="form-label" for="planSeats">@Texts.Get("platform.plans.seats")</label>
                    <input id="planSeats" class="form-control" type="number" min="0" @bind="editing.Seats" />
                    <FieldError Field="limits" Errors="errors" />
                </div>
            </div>
            <fieldset class="mt-3">
                <legend class="form-label">@Texts.Get("platform.modules")</legend>
                @foreach (var module in modules.Modules)
                {
                    <div class="form-check">
                        <input id="pm-@module.Key" class="form-check-input" type="checkbox" checked="@editing.Modules.Contains(module.Key)"
                               @onchange="e => ToggleModule(module.Key, (bool)e.Value!)" />
                        <label class="form-check-label" for="pm-@module.Key">@module.DisplayName</label>
                    </div>
                }
                <FieldError Field="modules" Errors="errors" />
            </fieldset>
            <div class="form-check mt-3">
                <input id="planActive" class="form-check-input" type="checkbox" @bind="editing.IsActive" />
                <label class="form-check-label" for="planActive">@Texts.Get("platform.plans.activeHint")</label>
            </div>
            <div class="form-actions">
                <button type="button" class="btn btn-outline-secondary" @onclick="() => editing = null">@Texts.Get("common.cancel")</button>
                <button type="submit" class="btn btn-primary" disabled="@busy">@Texts.Get("common.save")</button>
            </div>
        </form>
    }

    @if (plans is null)
    {
        <LoadingState Kind="LoadingKind.Table" />
    }
    else if (plans.Count == 0)
    {
        <EmptyState Title="@Texts.Get("platform.plans.empty")" />
    }
    else
    {
        <table class="table record-table">
            <thead>
                <tr>
                    <th scope="col"><SortHeader Label="@Texts.Get("common.field.name")" ColumnIcon="type" Asc="name" Desc="-name" Value="@sort" Default="" ValueChanged="SortBy" /></th>
                    <th scope="col"><SortHeader Label="@Texts.Get("platform.plans.key")" ColumnIcon="hash" Asc="key" Desc="-key" Value="@sort" Default="" ValueChanged="SortBy" /></th>
                    <th scope="col">@Texts.Get("platform.modules")</th>
                    <th scope="col"><SortHeader Label="@Texts.Get("platform.plans.col.seats")" ColumnIcon="users" Asc="seats" Desc="-seats" Value="@sort" Default="" ValueChanged="SortBy" /></th>
                    <th scope="col"><SortHeader Label="@Texts.Get("platform.plans.col.subscribers")" ColumnIcon="building" Asc="subscribers" Desc="-subscribers" Value="@sort" Default="" ValueChanged="SortBy" /></th>
                    <th scope="col"><SortHeader Label="@Texts.Get("common.field.status")" ColumnIcon="tag" Asc="active" Desc="-active" Value="@sort" Default="" ValueChanged="SortBy" /></th>
                    <th scope="col" class="row-menu-cell"><span class="visually-hidden">@Texts.Get("common.actions")</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var plan in ClientSort.Apply(plans, sort, SortColumns))
                {
                    <tr>
                        <td data-label="@Texts.Get("common.field.name")" class="primary">@plan.Name</td>
                        <td data-label="@Texts.Get("platform.plans.key")">@plan.Key</td>
                        <td data-label="@Texts.Get("platform.modules")">@ModuleNames(plan.Modules)</td>
                        <td data-label="@Texts.Get("platform.plans.col.seats")">@(plan.Limits.TryGetValue("seats", out var seats) ? seats.ToString() : Texts.Get("platform.plans.unlimited"))</td>
                        <td data-label="@Texts.Get("platform.plans.col.subscribers")">@plan.SubscriberCount</td>
                        <td data-label="@Texts.Get("common.field.status")"><span class="badge @(plan.IsActive ? "user-active" : "user-disabled")">@(plan.IsActive ? Texts.Get("platform.plans.status.active") : Texts.Get("platform.plans.status.closed"))</span></td>
                        <td class="row-menu-cell">
                            <RowMenu Label="@Texts.Get("common.rowActionsOf", plan.Name)">
                                <button type="button" class="view-menu-item" role="menuitem" @onclick="() => Edit(plan)"><AppIcon Name="pencil" Size="16" /> <span>@Texts.Get("common.edit")</span></button>
                            </RowMenu>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</PlatformGate>

@code {
    private sealed class PlanEditor
    {
        public Guid? Id { get; set; }

        public string Key { get; set; } = string.Empty;

        public string Name { get; set; } = string.Empty;

        public int? Seats { get; set; }

        public bool IsActive { get; set; } = true;

        public HashSet<string> Modules { get; set; } = [];
    }

    private IReadOnlyList<PlanDto>? plans;

    // Liste tamamı yüklü geldiği için sıralama istemcidedir (ClientSort); boş değer sunucunun sırasıdır.
    private string sort = "";

    private void SortBy(string value) => sort = value;

    private static readonly Dictionary<string, Func<PlanDto, object?>> SortColumns = new()
    {
        ["name"] = p => p.Name,
        ["key"] = p => p.Key,
        ["seats"] = p => p.Limits.TryGetValue("seats", out var seats) ? seats : null,
        ["subscribers"] = p => p.SubscriberCount,
        ["active"] = p => p.IsActive,
    };
    private PlatformModulesResponse? modules;
    private PlanEditor? editing;
    private IReadOnlyDictionary<string, string[]>? errors;
    private string? notice;
    private bool failed;
    private bool busy;

    protected override async Task OnInitializedAsync()
    {
        modules = (await Api.GetAsync<PlatformModulesResponse>("/api/platform/modules")).Value;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var result = await Api.GetAsync<PlansResponse>("/api/platform/plans");
        plans = result.Value?.Plans;
        if (!result.IsSuccess)
        {
            (notice, failed) = (result.Error, true);
        }
    }

    private void StartNew()
    {
        editing = new PlanEditor();
        errors = null;
    }

    private void Edit(PlanDto plan)
    {
        editing = new PlanEditor
        {
            Id = plan.Id,
            Key = plan.Key,
            Name = plan.Name,
            IsActive = plan.IsActive,
            Seats = plan.Limits.TryGetValue("seats", out var seats) ? seats : null,
            Modules = [.. plan.Modules],
        };
        errors = null;
    }

    private void ToggleModule(string key, bool on)
    {
        if (on)
        {
            editing!.Modules.Add(key);
        }
        else
        {
            editing!.Modules.Remove(key);
        }
    }

    private async Task SaveAsync()
    {
        busy = true;
        var limits = editing!.Seats is { } seats ? new Dictionary<string, int> { ["seats"] = seats } : new Dictionary<string, int>();
        var request = new SavePlanRequest(editing.Key, editing.Name, [.. editing.Modules], limits, editing.IsActive);
        var result = editing.Id is { } id
            ? await Api.PutAsync<PlanDto>($"/api/platform/plans/{id}", request)
            : await Api.PostAsync<PlanDto>("/api/platform/plans", request);
        busy = false;
        errors = result.FieldErrors;
        if (!result.IsSuccess)
        {
            (notice, failed) = (result.FieldErrors.Count > 0 ? null : result.Error, true);
            return;
        }

        (notice, failed, editing) = (Texts.Get("platform.plans.saved"), false, null);
        await LoadAsync();
    }

    private string ModuleNames(IReadOnlyList<string> keys) =>
        keys.Count == 0 ? "—" : string.Join(", ", keys.Select(k => modules?.Modules.FirstOrDefault(m => m.Key == k)?.DisplayName ?? k));
}
