@page "/platform/firmalar"
@inject ApiClient Api

<PageTitle>Firmalar · Platform · Modulix</PageTitle>

<PlatformGate>
    <a class="back-link" href="platform">← Platform</a>

    <div class="page-header">
        <h1>Firmalar</h1>
        @if (!creating && modules is not null)
        {
            <button type="button" class="btn btn-primary" @onclick="() => creating = true">Firma aç</button>
        }
    </div>

    @if (notice is not null)
    {
        <div class="alert alert-success" role="status">@notice</div>
    }

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }

    @if (creating && modules is not null)
    {
        <CreateTenantForm Modules="modules" Profiles="profiles" Created="CreatedAsync" Cancelled="() => creating = false" />
    }

    <div class="filters" role="group" aria-label="Durum">
        <button type="button" class="chip @(status is null ? "active" : null)" @onclick="() => FilterAsync(null)">Tümü</button>
        @foreach (var value in Enum.GetValues<TenantState>())
        {
            <button type="button" class="chip @(status == value ? "active" : null)" @onclick="() => FilterAsync(value)">@TenantStateText.Of(value)</button>
        }
    </div>

    <form class="search" @onsubmit="() => LoadAsync(1)" @onsubmit:preventDefault>
        <input class="form-control" type="search" placeholder="Ad veya kısa ad ara" @bind="search" />
        <button type="submit" class="btn btn-outline-secondary">Ara</button>
    </form>

    @if (page is null)
    {
        @if (message is null)
        {
            <p class="text-muted">Yükleniyor…</p>
        }
    }
    else if (page.Items.Count == 0)
    {
        <p class="text-muted">Firma yok.</p>
    }
    else
    {
        <table class="table record-table">
            <thead>
                <tr><th>Ad</th><th>Kısa ad</th><th>Durum</th><th>Etkin üye</th><th>Yönetici</th><th>Modüller</th><th>Açılış</th></tr>
            </thead>
            <tbody>
                @foreach (var tenant in page.Items)
                {
                    <tr>
                        <td data-label="Ad" class="primary"><a href="platform/firmalar/@tenant.Id">@tenant.Name</a></td>
                        <td data-label="Kısa ad">@tenant.Slug</td>
                        <td data-label="Durum"><TenantStateBadge State="tenant.Status" /></td>
                        <td data-label="Etkin üye">@tenant.ActiveMemberCount</td>
                        <td data-label="Yönetici">
                            @if (tenant.AdministratorCount == 0)
                            {
                                <span class="badge user-locked" title="Firmada yönetici yok; firma detayından davet edin.">Yok</span>
                            }
                            else
                            {
                                @tenant.AdministratorCount
                            }
                        </td>
                        <td data-label="Modüller">@ModuleNames(tenant.EnabledModules)</td>
                        <td data-label="Açılış">@CrmLabels.Time(tenant.CreatedAt)</td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager Page="page.Page" PageSize="page.PageSize" TotalCount="page.TotalCount" PageChanged="LoadAsync" />
    }
</PlatformGate>

@code {
    private PlatformTenantPageResponse? page;
    private PlatformModulesResponse? modules;
    private IReadOnlyList<SectorProfileDto> profiles = [];
    private string? search;
    private TenantState? status;
    private bool creating;
    private string? message;
    private string? notice;

    protected override async Task OnInitializedAsync()
    {
        var result = await Api.GetAsync<PlatformModulesResponse>("/api/platform/modules");
        modules = result.Value;
        profiles = (await Api.GetAsync<List<SectorProfileDto>>("/api/platform/profiles")).Value ?? [];
        if (result.IsSuccess)
        {
            await LoadAsync(1);
        }
    }

    private async Task FilterAsync(TenantState? value)
    {
        status = value;
        await LoadAsync(1);
    }

    private async Task LoadAsync(int pageNumber)
    {
        var url = $"/api/platform/tenants?page={pageNumber}&search={Uri.EscapeDataString(search ?? string.Empty)}";
        if (status is { } s)
        {
            url += $"&status={s}";
        }

        var result = await Api.GetAsync<PlatformTenantPageResponse>(url);
        page = result.Value;
        message = result.Error;
    }

    private async Task CreatedAsync(CreateTenantResponse response)
    {
        creating = false;
        var tenant = response.Tenant.Tenant;
        var administrator = response.Tenant.Administrators.FirstOrDefault();
        notice = response.ExistingAccount
            ? $"{tenant.Name} açıldı. {administrator?.DisplayName} zaten Modulix kullanıyordu; yönetici olarak eklendi ve bilgilendirildi."
            : $"{tenant.Name} açıldı. {administrator?.Email} adresine yönetici daveti gönderildi.";
        await LoadAsync(1);
    }

    private string ModuleNames(IReadOnlyList<string> keys) =>
        keys.Count == 0
            ? "—"
            : string.Join(", ", keys.Select(k => modules?.Modules.FirstOrDefault(m => m.Key == k)?.DisplayName ?? k));
}
