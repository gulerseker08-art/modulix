@page "/platform/firmalar"
@inject ApiClient Api

<PageTitle>@Texts.Get("nav.app.platform.tenants") · @Texts.Get("nav.app.platform") · Modulix</PageTitle>

<PlatformGate>
    <a class="back-link" href="platform">← @Texts.Get("nav.app.platform")</a>

    <div class="page-header">
        <h1>@Texts.Get("nav.app.platform.tenants")</h1>
    </div>

    @if (notice is not null)
    {
        <div class="alert alert-success" role="status">@notice</div>
    }

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }

    @if (creating && modules is not null)
    {
        <CreateTenantForm Modules="modules" Profiles="profiles" Created="CreatedAsync" Cancelled="() => creating = false" />
    }

    @* Platform yöneticisi bir firma bağlamı olmadan çalışır; kişisel görünüm kaydı firma bağlamı ister (ADR-0036), bu yüzden yalnızca sistem görünümleri vardır. *@
    <ViewTabs Items="ViewOptions" Value="@view" ValueChanged="ChooseViewAsync" Label="@Texts.Get("platform.tenants.views")" />

    <div class="list-toolbar">
        <form class="search" @onsubmit="() => LoadAsync(1)" @onsubmit:preventDefault>
            <input class="form-control" type="search" aria-label="@Texts.Get("platform.tenants.search")" placeholder="@Texts.Get("platform.tenants.searchPlaceholder")" @bind="search" />
        </form>
        <GridColumnPicker State="grid" Changed="@(() => Task.CompletedTask)" />
        @if (!creating && modules is not null)
        {
            <button type="button" class="btn btn-primary" @onclick="() => creating = true"><AppIcon Name="plus" Size="16" /> @Texts.Get("platform.tenants.create")</button>
        }
    </div>

    @if (page is null)
    {
        @if (message is null)
        {
            <LoadingState Kind="LoadingKind.Table" />
        }
    }
    else if (page.Items.Count == 0)
    {
        <EmptyState Title="@Texts.Get("platform.tenants.empty")" />
    }
    else
    {
        <table class="table record-table">
            <thead>
                <tr>
                    @foreach (var column in grid.VisibleColumns)
                    {
                        <GridHeader Column="column" State="grid" SortChanged="SortAsync" />
                    }
                    <th scope="col" class="row-menu-cell"><span class="visually-hidden">@Texts.Get("common.actions")</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var tenant in page.Items)
                {
                    <tr>
                        @foreach (var column in grid.VisibleColumns)
                        {
                            @Cell(column, tenant)
                        }
                        <td class="row-menu-cell">
                            <RowMenu Label="@Texts.Get("common.rowActionsOf", tenant.Name)">
                                <a class="view-menu-item" role="menuitem" href="platform/firmalar/@tenant.Id"><AppIcon Name="eye" Size="16" /> <span>@Texts.Get("common.open")</span></a>
                            </RowMenu>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager PageSizeChoice="true" Page="page.Page" PageSize="page.PageSize" TotalCount="page.TotalCount" PageChanged="LoadAsync" />
    }
</PlatformGate>

@code {
    private const string AllViews = "all";

    // Başlık tıklamasıyla sıralanan sütunlar sunucudaki sort anahtarlarıdır (PlatformTenantQuery.SortKeys). Etkin üye ve modüller sayfa dışında hesaplandığı için sıralanamaz.
    // Özellik olarak tanımlıdır: metinler her okunuşta etkin dilden çözülür (ADR-0034).
    private static GridColumnDef[] Columns =>
    [
        new("name", Texts.Get("common.field.name"), "type", "name", "-name", Locked: true),
        new("slug", Texts.Get("platform.slug"), "hash", "slug", "-slug"),
        new("status", Texts.Get("common.field.status"), "tag", "status", "-status"),
        new("members", Texts.Get("platform.activeMembers"), "users"),
        new("modules", Texts.Get("platform.modules"), "layers"),
        new("created", Texts.Get("platform.openedAt"), "calendar", "createdAt", "-createdAt"),
    ];

    private readonly GridViewState grid = new("platform.tenants", "name");
    private PlatformTenantPageResponse? page;
    private PlatformModulesResponse? modules;
    private IReadOnlyList<SectorProfileDto> profiles = [];
    private string? search;
    private TenantState? status;
    private bool creating;
    private string? message;
    private string? notice;
    private string view = AllViews;

    protected override async Task OnInitializedAsync()
    {
        grid.Define(Columns);
        var result = await Api.GetAsync<PlatformModulesResponse>("/api/platform/modules");
        modules = result.Value;
        profiles = (await Api.GetAsync<List<SectorProfileDto>>("/api/platform/profiles")).Value ?? [];
        if (result.IsSuccess)
        {
            await LoadAsync(1);
        }
    }

    private IReadOnlyList<ViewOption> ViewOptions =>
        [new(AllViews, Texts.Get("platform.tenants.all"), Icon: "building"), .. Enum.GetValues<TenantState>().Select(v => new ViewOption(v.ToString(), PlatformLabels.TenantStateOf(v), Icon: "tag"))];

    private async Task ChooseViewAsync(string key)
    {
        view = key;
        status = key == AllViews ? null : Enum.Parse<TenantState>(key);
        await LoadAsync(1);
    }

    private async Task SortAsync(string key)
    {
        grid.Sort = key;
        await LoadAsync(1);
    }

    private async Task LoadAsync(int pageNumber)
    {
        var url = $"/api/platform/tenants?page={pageNumber}&pageSize={ListPaging.Size}&search={Uri.EscapeDataString(search ?? string.Empty)}";
        if (grid.Sort != grid.DefaultSort)
        {
            url += $"&sort={Uri.EscapeDataString(grid.Sort)}";
        }

        if (status is { } s)
        {
            url += $"&status={s}";
        }

        var result = await Api.GetAsync<PlatformTenantPageResponse>(url);
        page = result.Value;
        message = result.Error;
    }

    private async Task CreatedAsync(CreateTenantResponse response)
    {
        creating = false;
        var tenant = response.Tenant.Tenant;
        var administrator = response.Tenant.Administrators.FirstOrDefault();
        notice = response.ExistingAccount
            ? Texts.Get("platform.tenants.createdExisting", tenant.Name, administrator?.DisplayName)
            : Texts.Get("platform.tenants.createdInvited", tenant.Name, administrator?.Email);
        await LoadAsync(1);
    }

    private RenderFragment Cell(GridColumnDef column, PlatformTenantDto tenant) => @<td data-label="@column.Label" class="@(column.Key == "name" ? "primary" : null)">@CellContent(column.Key, tenant)</td>;

    private RenderFragment CellContent(string key, PlatformTenantDto tenant) => key switch
    {
        "name" => @<a href="platform/firmalar/@tenant.Id">@tenant.Name</a>,
        "slug" => @<text>@tenant.Slug</text>,
        "status" => @<TenantStateBadge State="tenant.Status" />,
        "members" => @<text>@tenant.ActiveMemberCount</text>,
        "modules" => @<text>@ModuleNames(tenant.EnabledModules)</text>,
        "created" => @<text>@CrmLabels.Time(tenant.CreatedAt)</text>,
        _ => @<text></text>,
    };

    private string ModuleNames(IReadOnlyList<string> keys) =>
        keys.Count == 0
            ? "—"
            : string.Join(", ", keys.Select(k => modules?.Modules.FirstOrDefault(m => m.Key == k)?.DisplayName ?? k));
}
