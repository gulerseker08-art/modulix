@page "/abonelik/{Tenant}"
@layout PublicLayout
@inject ApiClient Api
@inject NavigationManager Navigation

<PageTitle>İletişim tercihleri · Modulix</PageTitle>

@* Oturumsuz tercih merkezi (ADR-0025 dilim 6). Belirteç adresin # parçasındadır (#t=...): sunucuya, günlüklere ve Referer başlığına gitmez; API çağrılarında gövdede taşınır.
   Sayfa açılışta hiçbir değişiklik yapmaz: abonelikten çıkış yalnızca düğmeye basılınca olur (bağlantıyı önceden açan güvenlik tarayıcıları kimseyi çıkaramaz). Adres maskelidir. *@

@if (loading)
{
    <p class="text-muted" role="status">Yükleniyor…</p>
}
else if (invalid)
{
    <div class="alert alert-warning" role="alert">
        <h1 class="h5">Bağlantı geçersiz</h1>
        <p class="mb-0">Bu bağlantı geçersiz ya da kaldırılmış. Lütfen size ulaşan firmayla iletişime geçin.</p>
    </div>
}
else if (view is not null)
{
    <article class="public-quote" aria-labelledby="pref-heading">
        <h1 id="pref-heading" class="h4">İletişim tercihleriniz</h1>
        <p class="text-muted"><strong>@view.TenantName</strong> · @ChannelText(view.Channel) · @view.MaskedAddress</p>

        <Notice Text="@problem" Failed="true" />
        @if (done is not null)
        {
            <div class="alert alert-success" role="status">@done</div>
        }

        @switch (view.State)
        {
            case "subscribed":
                <p>Bu adrese @view.TenantName tarafından pazarlama iletileri gönderilebilir.</p>
                @if (view.Topics is { Count: > 0 })
                {
                    <fieldset class="mb-3" disabled="@busy">
                        <legend class="h6">Hangi konularda ileti almak istersiniz?</legend>
                        @foreach (var topic in view.Topics)
                        {
                            <div class="form-check">
                                <input id="topic-@topic.Key" class="form-check-input" type="checkbox" checked="@topic.Subscribed" disabled="@(!topic.CanChange)"
                                       @onchange="e => SetTopicAsync(topic, e.Value is true)" />
                                <label class="form-check-label" for="topic-@topic.Key">@topic.Name</label>
                            </div>
                        }
                        <p class="small text-muted mb-0">Bir konunun işaretini kaldırmak o konudaki iletileri durdurur. Tümünü durdurmak için aşağıdaki düğmeyi kullanın.</p>
                    </fieldset>
                }
                <div class="form-actions">
                    <button type="button" class="btn btn-primary" disabled="@busy" @onclick="UnsubscribeAsync">Abonelikten çık</button>
                </div>
                break;
            case "unsubscribed":
                <p>Abonelikten çıktınız. Bu adrese pazarlama iletisi gönderilmez.</p>
                @if (view.CanResubscribe)
                {
                    <p class="small text-muted">Yanlışlıkla çıktıysanız aboneliği yeniden açabilirsiniz.</p>
                    <div class="form-actions">
                        <button type="button" class="btn btn-outline-secondary" disabled="@busy" @onclick="ResubscribeAsync">Aboneliği yeniden aç</button>
                    </div>
                }
                break;
            default:
                <div class="alert alert-info" role="status">@view.Message</div>
                @if (view.CanUnsubscribe)
                {
                    <div class="form-actions">
                        <button type="button" class="btn btn-outline-secondary" disabled="@busy" @onclick="UnsubscribeAsync">İletişim istemiyorum</button>
                    </div>
                }
                break;
        }

        <p class="small text-muted mt-3">Bu tercih yalnızca pazarlama iletilerini etkiler; hesap, sipariş ve hizmet bildirimleri gönderilmeye devam edebilir.</p>
    </article>
}

@code {
    [Parameter] public string Tenant { get; set; } = string.Empty;

    private PublicCommunicationView? view;
    private string token = string.Empty;
    private string? problem;
    private string? done;
    private bool loading = true;
    private bool invalid;
    private bool busy;

    protected override async Task OnInitializedAsync()
    {
        token = Modulix.Web.Pages.Crm.PublicQuote.TokenFromFragment(Navigation.Uri);
        if (token.Length == 0)
        {
            loading = false;
            invalid = true;
            return;
        }

        var result = await Api.PostAsync<PublicCommunicationView>($"/api/public/communication/{Uri.EscapeDataString(Tenant)}/view", new PublicCommunicationTokenRequest(token));
        loading = false;
        view = result.Value;
        invalid = view is null;
    }

    private Task UnsubscribeAsync() => ActAsync("unsubscribe", "Tercihiniz kaydedildi.");

    private Task ResubscribeAsync() => ActAsync("resubscribe", "Tercihiniz kaydedildi.");

    private Task SetTopicAsync(PublicTopicDto topic, bool subscribed) =>
        ActAsync("topic", "Tercihiniz kaydedildi.", new PublicTopicRequest(token, topic.Key, subscribed));

    private async Task ActAsync(string action, string success, object? body = null)
    {
        if (busy) { return; }
        busy = true;
        problem = null;
        done = null;
        var result = await Api.PostAsync<PublicCommunicationView>(
            $"/api/public/communication/{Uri.EscapeDataString(Tenant)}/{action}", body ?? new PublicCommunicationTokenRequest(token));
        busy = false;
        if (result.Value is { } updated)
        {
            view = updated;
            done = success;
            return;
        }

        problem = result.Error ?? "İşlem yapılamadı.";
    }

    private static string ChannelText(string channel) => channel switch
    {
        "Email" => "E-posta",
        "Sms" => "SMS",
        "WhatsApp" => "WhatsApp",
        "Phone" => "Telefon",
        _ => channel,
    };
}
