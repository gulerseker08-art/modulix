@page "/crm/leadler"
@inject ApiClient Api
@inject SessionState Session
@inject CrmLookups Lookups
@inject Modulix.Web.Services.ActivityOptions Activities

<PageTitle>Müşteri adayları · Modulix</PageTitle>

<AuthGate Module="@CrmAccess.ModuleKey" Permission="@CrmAccess.LeadsRead">
    <div class="page-header">
        <h1>Müşteri adayları</h1>
        <div class="header-actions">
            @if (Session.Can(CrmAccess.LeadFormsManage))
            {
                <a class="btn btn-outline-secondary" href="crm/lead-formlari">Formlar</a>
            }
            @if (Session.Can(CrmAccess.LeadsExport))
            {
                <a class="btn btn-outline-secondary" href="@ExportUrl()" download="leadler.csv">CSV indir</a>
            }
            <button type="button" class="btn btn-outline-secondary" @onclick="ToggleReportAsync">@(showReport ? "Raporu gizle" : "Rapor")</button>
        </div>
    </div>

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }

    @if (editing)
    {
        <LeadEditor Lookups="Lookups" Saved="SavedAsync" Cancelled="() => editing = false" />
    }

    @if (showReport)
    {
        <LeadReportPanel Lookups="Lookups" />
    }

    <ViewTabs Items="ViewOptions" Value="@view" ValueChanged="ChooseViewAsync" Label="Müşteri adayı görünümleri" NewView="StartNaming" NewViewText="Görünüm" />

    <div class="list-toolbar">
        <form class="search" @onsubmit="() => LoadAsync(1)" @onsubmit:preventDefault>
            <input class="form-control" type="search" aria-label="Müşteri adayı ara" placeholder="Konu, no, ad, firma ya da e-posta ara" @bind="search" />
        </form>
        <FilterToggle @bind-Open="filtersOpen" Count="ActiveFilters" />
        <GridColumnPicker State="grid" Changed="@(() => Task.CompletedTask)" />
        @if (Session.Can(CrmAccess.LeadsCreate) && !editing)
        {
            <button type="button" class="btn btn-primary" @onclick="() => editing = true"><AppIcon Name="plus" Size="16" /> Yeni müşteri adayı</button>
        }
    </div>
    @if (filtersOpen || ActiveFilters > 0)
    {
        <div class="filters">
            <select class="form-select" aria-label="Durum" @bind="status" @bind:after="() => LoadAsync(1)">
                <option value="">Tüm durumlar</option>
                @foreach (var s in LeadStatus.All)
                {
                    <option value="@s">@LeadStatus.Label(s)</option>
                }
            </select>
            <select class="form-select" aria-label="Kaynak" @bind="source" @bind:after="() => LoadAsync(1)">
                <option value="">Tüm kaynaklar</option>
                @foreach (var s in Lookups.ValuesOf(CrmLeadLists.Source))
                {
                    <option value="@s.Key">@s.Label</option>
                }
            </select>
            <select class="form-select" aria-label="Öncelik" @bind="priority" @bind:after="() => LoadAsync(1)">
                <option value="">Tüm öncelikler</option>
                @foreach (var p in LeadPriority.All)
                {
                    <option value="@p">@LeadPriority.Label(p)</option>
                }
            </select>
            <select class="form-select" aria-label="Sorumlu" @bind="owner" @bind:after="() => LoadAsync(1)">
                <option value="">Tüm sorumlular</option>
                @foreach (var member in Lookups.Members)
                {
                    <option value="@member.UserId">@member.DisplayName</option>
                }
            </select>
            <select class="form-select" aria-label="Hizmet kapsamı" @bind="scope" @bind:after="() => LoadAsync(1)">
                <option value="">Tüm hizmet kapsamları</option>
                @foreach (var a in activities.Where(a => a.Kind == "Activity"))
                {
                    <option value="@a.Code">@Activities.PathOf(a)</option>
                }
            </select>
            <label class="form-label-inline">Geliş:<input class="form-control" type="date" aria-label="Başlangıç" @bind="from" @bind:after="() => LoadAsync(1)" /></label>
            <label class="form-label-inline">– <input class="form-control" type="date" aria-label="Bitiş" @bind="to" @bind:after="() => LoadAsync(1)" /></label>
        </div>
    }

    <PersonalViewBar Active="Active" Dirty="IsDirty" Naming="views.Naming" NamingChanged="views.StartNaming" Error="@views.Error"
                     SaveAs="SaveAsAsync" UpdateView="UpdateViewAsync" DiscardChanges="DiscardAsync" DeleteView="DeleteViewAsync" />

    @if (target is { } hours && current == "firstContactOverdue")
    {
        <p class="text-muted small">İlk temas hedefi @hours saat (takvim saati; iş saati değildir).</p>
    }

    @if (page is null)
    {
        <p class="text-muted">Yükleniyor…</p>
    }
    else if (page.Items.Count == 0)
    {
        <p class="text-muted">Bu görünümde müşteri adayı yok.</p>
    }
    else
    {
        <table class="table record-table">
            <thead>
                <tr>
                    @foreach (var column in grid.VisibleColumns)
                    {
                        <GridHeader Column="column" State="grid" SortChanged="SortAsync" />
                    }
                    <th scope="col" class="row-menu-cell"><span class="visually-hidden">Eylemler</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var lead in page.Items)
                {
                    <tr>
                        @foreach (var column in grid.VisibleColumns)
                        {
                            @Cell(column, lead)
                        }
                        <td class="row-menu-cell">
                            <RowMenu Label="@($"{lead.LeadNumber} eylemleri")">
                                <a class="view-menu-item" role="menuitem" href="crm/leadler/@lead.Id"><AppIcon Name="eye" Size="16" /> <span>Aç</span></a>
                            </RowMenu>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager PageSizeChoice="true" Page="page.Page" PageSize="page.PageSize" TotalCount="page.TotalCount" PageChanged="LoadAsync" />
    }
</AuthGate>

@code {
    private bool filtersOpen;

    /// <summary>Etkin süzgeç sayısı ("Filtrele" rozeti); süzgeç satırı etkin süzgeç varken açık kalır.</summary>
    private int ActiveFilters => (status.Length > 0 ? 1 : 0) + (source.Length > 0 ? 1 : 0) + (priority.Length > 0 ? 1 : 0) + (owner.Length > 0 ? 1 : 0) + (scope.Length > 0 ? 1 : 0) + (from is null ? 0 : 1) + (to is null ? 0 : 1);

    private const string Url = "/api/crm/leads";

    // Görünümler yalnızca süzgeçtir; kapsamı sunucu uygular (kimse yetkisi dışındaki Lead'i listeleyemez).
    private static readonly ViewDefinition[] Views =
    [
        new("mine", "Benim müşteri adaylarım", "star", _ => true),
        new("all", "Tüm müşteri adayları", "inbox", _ => true),
        new("team", "Ekip müşteri adayları", "users", s => s.Scope != RecordScope.Own),
        new("unassigned", "Atama bekleyenler", "user-check", s => s.Can(CrmAccess.LeadsAssign)),
        new("firstContactOverdue", "İlk temas gecikmiş", "clock", _ => true),
        new("followUpOverdue", "Takibi geciken", "alert-circle", _ => true),
        new("qualified", "Nitelikli, dönüşmemiş", "check-circle", _ => true),
    ];

    // Başlıklar sunucuda sıralanır (varsayılan: en yeni geliş önce). Sorumlu adı üyelik tablosundadır, sıralanamaz. "default" varsayılan sıranın
    // sunucuya gönderilmeyen belirtecidir (varsayılan zaten azalan geliş sırası olduğundan başlık döngüsü Geliş'te artan → azalan → varsayılan işler).
    private static readonly GridColumnDef[] Columns =
    [
        new("number", "No", "hash", "number", "-number"),
        new("subject", "Konu", "type", "subject", "-subject", Locked: true),
        new("requester", "Talep sahibi", "user", "requester", "-requester"),
        new("status", "Durum", "tag", "status", "-status"),
        new("priority", "Öncelik", "alert-circle", "priority", "-priority"),
        new("source", "Kaynak", "globe", "source", "-source"),
        new("owner", "Sorumlu", "user"),
        new("received", "Geliş", "calendar", "received", "-received"),
        new("firstContact", "İlk temas", "clock", "firstContact", "-firstContact"),
        new("company", "Firma", "building", "company", "-company", DefaultVisible: false),
        new("email", "E-posta", "mail", "email", "-email", DefaultVisible: false),
        new("phone", "Telefon", "phone", "phone", "-phone", DefaultVisible: false),
        new("city", "Şehir", "map-pin", "city", "-city", DefaultVisible: false),
        new("industry", "Sektör", "briefcase", "industry", "-industry", DefaultVisible: false),
        new("productInterest", "İlgilendiği ürün", "package", "productInterest", "-productInterest", DefaultVisible: false),
    ];

    private IReadOnlyList<ViewOption> ViewOptions =>
    [
        .. Views.Where(v => v.Visible(Session)).Select(v => new ViewOption(v.Key, v.Label, Icon: v.Icon)),
        .. views.Options,
    ];

    private readonly GridViewState grid = new("crm.leads", "default");
    private PersonalGridViews views = default!;
    private CrmPage<LeadDto>? page;
    private string view = "all";

    /// <summary>Etkin sistem görünümünün anahtarı (kişisel görünümde kaydedilen görünüm); sorgu buna göre kurulur.</summary>
    private string current = "all";
    private string? message;
    private string? search;
    private string status = string.Empty;
    private string source = string.Empty;
    private string priority = string.Empty;
    private string owner = string.Empty;
    private string scope = string.Empty;
    private IReadOnlyList<ActivityOptionDto> activities = [];
    private DateOnly? from;
    private DateOnly? to;
    private bool editing;
    private bool showReport;
    private int? target;

    protected override async Task OnInitializedAsync()
    {
        views = new PersonalGridViews(Api, "crm.leads");
        await Session.EnsureLoadedAsync();
        if (Session.Can(CrmAccess.LeadsRead))
        {
            await Lookups.LoadAsync(contacts: true);
            activities = await Activities.LoadAsync();
            grid.Define(Columns);
            await views.LoadAsync();
            target = (await Api.GetAsync<LeadSettingsDto>($"{Url}/settings")).Value?.FirstContactTargetHours;
            await LoadAsync(1);
        }
    }

    private GridViewDto? Active => views.Find(view);

    // Kayıtlı süzgeç: sistem görünümü + açık süzgeç satırı (durum, kaynak, öncelik, sorumlu, geliş aralığı). Sayfa içi anahtarlardır, API'ye gitmez.
    private string? CurrentFilters => GridFilters.Build(
        current != "all" ? ("view", current) : null,
        status.Length > 0 ? ("status", status) : null,
        source.Length > 0 ? ("source", source) : null,
        priority.Length > 0 ? ("priority", priority) : null,
        owner.Length > 0 ? ("owner", owner) : null,
        scope.Length > 0 ? ("serviceScope", scope) : null,
        from is { } f ? ("from", f.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)) : null,
        to is { } t ? ("to", t.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)) : null);

    // Kaydedilmemiş değişiklik: sütun/sıralama ya da (kişisel görünümde) süzgeç kayıtlı hâlden farklı.
    private bool IsDirty => grid.Differs(Active) || (Active is { } saved && CurrentFilters != (string.IsNullOrEmpty(saved.Filters) ? null : saved.Filters));

    private string Query(int pageNumber, bool withSort = true)
    {
        var parts = new List<string> { $"page={pageNumber}&pageSize={ListPaging.Size}", $"search={Uri.EscapeDataString(search ?? string.Empty)}" };
        if (withSort && grid.Sort != grid.DefaultSort)
        {
            parts.Add($"sort={Uri.EscapeDataString(grid.Sort)}");
        }

        Add(parts, "status", status);
        Add(parts, "source", source);
        Add(parts, "priority", priority);
        Add(parts, "ownerId", owner);
        Add(parts, "serviceScope", scope);
        if (from is { } f)
        {
            parts.Add($"receivedFrom={Uri.EscapeDataString(Regional.FromTenant(f.ToDateTime(TimeOnly.MinValue)).ToString("O"))}");
        }

        if (to is { } t)
        {
            parts.Add($"receivedBefore={Uri.EscapeDataString(Regional.FromTenant(t.AddDays(1).ToDateTime(TimeOnly.MinValue)).ToString("O"))}");
        }

        switch (current)
        {
            case "mine":
                parts.Add("ownerId=me");
                break;
            case "team":
                parts.Add("ownerNot=me");
                break;
            case "unassigned":
                parts.Add("unassigned=true");
                break;
            case "firstContactOverdue" when target is { } hours:
                parts.Add($"firstContactDueBefore={Uri.EscapeDataString(DateTimeOffset.UtcNow.AddHours(-hours).ToString("O"))}");
                break;
            case "firstContactOverdue":
                // Hedef tanımlı değilse "gecikmiş" kavramı yoktur; hiçbir kaydı gecikmiş göstermemek için geçmişe bir sınır konur.
                parts.Add("firstContactDueBefore=0001-01-02T00:00:00Z");
                break;
            case "followUpOverdue":
                parts.Add($"followUpDueBefore={Uri.EscapeDataString(DateTimeOffset.UtcNow.ToString("O"))}");
                break;
            case "qualified":
                parts.Add("qualifiedNotConverted=true");
                break;
        }

        return string.Join('&', parts);
    }

    private static void Add(List<string> parts, string name, string value)
    {
        if (!string.IsNullOrEmpty(value))
        {
            parts.Add($"{name}={Uri.EscapeDataString(value)}");
        }
    }

    // CSV dışa aktarma sıralama anahtarı kabul etmez; yalnızca süzgeçler gider.
    private string ExportUrl() => $"{Url}/export?{Query(1, withSort: false)}";

    private async Task ChooseViewAsync(string key)
    {
        view = key;
        views.StartNaming(false);
        if (Active is { } saved)
        {
            // Kişisel görünüm: sütunlar, sıralama ve süzgeç birlikte gelir. Bu kullanıcıya görünmeyen sistem görünümü "tümü"ne düşer.
            grid.Apply(saved);
            var filters = GridFilters.Parse(saved.Filters);
            var baseView = filters.GetValueOrDefault("view") ?? "all";
            current = Views.Any(v => v.Key == baseView && v.Visible(Session)) ? baseView : "all";
            status = filters.GetValueOrDefault("status") ?? string.Empty;
            source = filters.GetValueOrDefault("source") ?? string.Empty;
            priority = filters.GetValueOrDefault("priority") ?? string.Empty;
            owner = filters.GetValueOrDefault("owner") ?? string.Empty;
            scope = filters.GetValueOrDefault("serviceScope") ?? string.Empty;
            from = DateOnly.TryParse(filters.GetValueOrDefault("from"), out var f) ? f : null;
            to = DateOnly.TryParse(filters.GetValueOrDefault("to"), out var t) ? t : null;
        }
        else
        {
            grid.Reset();
            current = key;
        }

        await LoadAsync(1);
    }

    private async Task SortAsync(string key)
    {
        grid.Sort = key;
        await LoadAsync(1);
    }

    private void StartNaming() => views.StartNaming(true);

    private async Task SaveAsAsync(string name)
    {
        if (await views.SaveAsAsync(grid.ToRequest(name, CurrentFilters)) is { } key)
        {
            view = key;
        }
    }

    private async Task UpdateViewAsync()
    {
        if (Active is { } saved)
        {
            await views.UpdateAsync(saved, grid.ToRequest(saved.Name, CurrentFilters));
        }
    }

    private async Task DiscardAsync() => await ChooseViewAsync(view);

    private async Task DeleteViewAsync()
    {
        if (Active is { } saved && await views.DeleteAsync(saved))
        {
            await ChooseViewAsync("all");
        }
    }

    private async Task LoadAsync(int pageNumber)
    {
        var result = await Api.GetAsync<CrmPage<LeadDto>>($"{Url}?{Query(pageNumber)}");
        page = result.Value;
        message = result.Error;
    }

    private Task ToggleReportAsync()
    {
        showReport = !showReport;
        return Task.CompletedTask;
    }

    private async Task SavedAsync(LeadDto lead)
    {
        editing = false;
        await LoadAsync(1);
    }

    private RenderFragment Cell(GridColumnDef column, LeadDto lead) => @<td data-label="@column.Label" class="@(column.Key == "subject" ? "primary" : null)">@CellContent(column.Key, lead)</td>;

    private RenderFragment CellContent(string key, LeadDto lead) => key switch
    {
        "number" => @<a href="crm/leadler/@lead.Id">@lead.LeadNumber</a>,
        "subject" => @<text>@lead.Subject</text>,
        "requester" => @<text>@Requester(lead)</text>,
        "status" => @<span class="badge stage-@lead.Status.ToLowerInvariant()">@LeadStatus.Label(lead.Status)</span>,
        "priority" => @<text>@LeadPriority.Label(lead.Priority)</text>,
        "source" => @<text>@Lookups.Label(CrmLeadLists.Source, lead.Source)</text>,
        "owner" => OwnerPart(lead),
        "received" => @<text>@CrmLabels.Time(lead.FirstReceivedAt)</text>,
        "firstContact" => FirstContactPart(lead),
        "company" => @<text>@lead.CompanyName</text>,
        "email" => @<text>@lead.Email</text>,
        "phone" => @<text>@lead.Phone</text>,
        "city" => @<text>@lead.City</text>,
        "industry" => @<text>@lead.Industry</text>,
        "productInterest" => @<text>@lead.ProductInterest</text>,
        _ => @<text></text>,
    };

    private RenderFragment OwnerPart(LeadDto lead) =>
        @<text>@if (lead.OwnerId is null) { <span class="text-muted">Atanmadı</span> } else { <OwnerCell Name="@Lookups.MemberName(lead.OwnerId)" /> }</text>;

    private RenderFragment FirstContactPart(LeadDto lead) =>
        @<text>
            @if (lead.FirstContactAt is { } contact)
            {
                @CrmLabels.Time(contact)
            }
            else if (IsOverdue(lead))
            {
                <span class="badge stage-lost">Gecikti</span>
            }
            else
            {
                <span class="text-muted">—</span>
            }
        </text>;

    private bool IsOverdue(LeadDto lead) =>
        target is { } hours && LeadStatus.IsOpen(lead.Status) && lead.Status is LeadStatus.New or LeadStatus.Contacting
        && lead.FirstContactAt is null && DateTimeOffset.UtcNow - lead.FirstReceivedAt > TimeSpan.FromHours(hours);

    private static string Requester(LeadDto lead)
    {
        var name = string.Join(' ', new[] { lead.FirstName, lead.LastName }.Where(n => !string.IsNullOrWhiteSpace(n)));
        return string.Join(" · ", new[] { name, lead.CompanyName }.Where(n => !string.IsNullOrWhiteSpace(n)));
    }

    private sealed record ViewDefinition(string Key, string Label, string Icon, Func<SessionState, bool> Visible);
}
