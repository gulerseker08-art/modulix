@page "/crm/firmalar/{TargetId:guid}/birlestir"
@inject SessionState Session

<PageTitle>@Texts.Get("crm.company.mergeTitle") · Modulix</PageTitle>

<AuthGate Module="@CrmAccess.ModuleKey" Permission="@CrmAccess.CompaniesMerge">
    <MergeWizard Resource="companies" TargetId="TargetId" SourceId="SourceId" />
</AuthGate>

@code {
    [Parameter] public Guid TargetId { get; set; }

    [SupplyParameterFromQuery(Name = "kaynak")] public Guid? SourceId { get; set; }
}
