@page "/crm/satis-gorunumu"
@using System.Globalization
@using System.Net
@inject ApiClient Api
@inject SessionState Session
@inject CrmLookups Lookups

<PageTitle>@Texts.Get("crm.salesOverview.title") · Modulix</PageTitle>

<AuthGate Module="@CrmAccess.ModuleKey" Permission="@SalesAccess.ReportsRead">
    <div class="page-header">
        <div>
            <h1>@Texts.Get("crm.salesOverview.title")</h1>
            <p class="text-muted mb-0">
                @Texts.Get("crm.salesOverview.intro")
            </p>
        </div>
        <div class="header-actions">
            @if (Session.Can(SalesAccess.TargetsRead))
            {
                <a class="btn btn-outline-secondary" href="crm/satis-hedefleri">@Texts.Get("crm.salesOverview.targetsLink")</a>
            }
            @if (Session.Can(SalesAccess.ForecastsRead))
            {
                <a class="btn btn-outline-secondary" href="crm/satis-tahmini">@Texts.Get("crm.salesOverview.forecastLink")</a>
            }
        </div>
    </div>

    <div class="filters" role="group" aria-label="@Texts.Get("crm.sales.periodKind")">
        <div class="segmented">
            @foreach (var (key, label) in SalesLabels.PeriodKinds)
            {
                <button type="button" class="chip @(kind == key ? "active" : null)" aria-pressed="@(kind == key ? "true" : "false")" disabled="@loading" @onclick="() => ChooseKindAsync(key)">@label</button>
            }
        </div>
        <button type="button" class="btn btn-outline-secondary" disabled="@loading" @onclick="() => ShiftAsync(-1)">@Texts.Get("crm.sales.previousPeriod")</button>
        <button type="button" class="btn btn-outline-secondary" disabled="@loading" @onclick="TodayAsync">@Texts.Get("crm.sales.today")</button>
        <button type="button" class="btn btn-outline-secondary" disabled="@loading" @onclick="() => ShiftAsync(1)">@Texts.Get("crm.sales.nextPeriod")</button>
    </div>

    <form class="form-grid mb-3" @onsubmit="LoadAsync" @onsubmit:preventDefault aria-label="@Texts.Get("crm.salesOverview.filters")">
        <div class="span-3">
            <label class="form-label" for="so-date">@Texts.Get("crm.sales.anchorDay")</label>
            <input id="so-date" class="form-control" type="date" @bind="anchor" @bind:after="LoadAsync" />
        </div>
        <div class="span-4">
            <label class="form-label" for="so-owner">@Texts.Get("crm.sales.ownerFilter")</label>
            <select id="so-owner" class="form-select" @bind="owner" @bind:after="LoadAsync">
                <option value="">@Texts.Get("crm.sales.allUsers")</option>
                @foreach (var member in Lookups.Members)
                {
                    <option value="@member.UserId">@member.DisplayName</option>
                }
            </select>
        </div>
        <div class="span-3">
            <label class="form-label" for="so-currency">@Texts.Get("crm.sales.currency")</label>
            <input id="so-currency" class="form-control" maxlength="3" placeholder="@Regional.Currency" aria-describedby="so-currency-help" @bind="currency" @bind:after="LoadAsync" />
            <div id="so-currency-help" class="form-text">@Texts.Get("crm.sales.currencyHelp")</div>
        </div>
    </form>

    @if (loading)
    {
        <LoadingState />
    }

    @if (error is not null)
    {
        <div class="alert @(forbidden ? "alert-warning" : "alert-danger")" role="alert">
            @(forbidden ? Texts.Get("crm.salesOverview.forbidden") + " " : null)@error
            @if (!forbidden)
            {
                <button type="button" class="btn btn-outline-secondary btn-sm ms-2" disabled="@loading" @onclick="LoadAsync">@Texts.Get("crm.sales.retry")</button>
            }
        </div>
    }

    @if (report is not null)
    {
        var r = report;
        <p class="small text-muted" role="status">
            @SalesLabels.PeriodLine(r.PeriodLabel, r.PeriodStart, r.PeriodEnd, r.Today, r.Currency)
            @if (r.ScopeLimited)
            {
                <span class="badge tag">@Texts.Get("crm.sales.scopeLimitedBadge")</span>
            }
        </p>

        @if (r.ScopeLimited)
        {
            <div class="alert alert-info" role="status">@Texts.Get("crm.sales.scopeLimited")</div>
        }
        @if (!r.AmountsVisible)
        {
            <div class="alert alert-info" role="status">@Texts.Get("crm.salesOverview.noAmounts")</div>
        }
        @if (r.Truncated)
        {
            <div class="alert alert-warning" role="status">@Texts.Get("crm.salesOverview.truncated")</div>
        }
        @if (r.Warnings.Count > 0)
        {
            <div class="alert alert-warning" role="status">
                <strong>@Texts.Get("crm.sales.warnings")</strong>
                <ul class="mb-0">
                    @foreach (var warning in r.Warnings)
                    {
                        <li>@warning</li>
                    }
                </ul>
            </div>
        }

        @if (IsEmpty(r))
        {
            <EmptyState Compact="true" Title="@Texts.Get("crm.salesOverview.empty")" />
        }

        <div class="kpi-grid" role="group" aria-label="@Texts.Get("crm.salesOverview.summary")">
            <SalesKpiCard Label="@Texts.Get("crm.sales-card.realized")" Icon="check-circle" Tone="success" Value="@MoneyText(r.Realized, r)" Detail="@Texts.Get("crm.salesOverview.realizedDetail", r.Realized.Count)"
                          Partial="@(r.AmountsVisible && r.Realized.IsPartial)" PartialHint="@SalesLabels.PartialHint(r.Realized)"
                          Pressed="@(openCard == SalesCards.Realized)" Controls="so-detail" OnClick="() => OpenCardAsync(SalesCards.Realized)" />
            <SalesKpiCard Label="@Texts.Get("crm.sales-card.openpipeline")" Icon="layers" Tone="info" Value="@MoneyText(r.OpenPipeline, r)" Detail="@Texts.Get("crm.salesOverview.pipelineDetail", r.OpenPipeline.Count)"
                          Partial="@(r.AmountsVisible && r.OpenPipeline.IsPartial)" PartialHint="@SalesLabels.PartialHint(r.OpenPipeline)"
                          Pressed="@(openCard == SalesCards.OpenPipeline)" Controls="so-detail" OnClick="() => OpenCardAsync(SalesCards.OpenPipeline)" />
            <SalesKpiCard Label="@Texts.Get("crm.sales-card.expectedopen")" Icon="calendar" Tone="brand" Value="@MoneyText(r.ExpectedOpen, r)" Detail="@Texts.Get("crm.salesOverview.expectedDetail", r.ExpectedOpen.Count)"
                          Partial="@(r.AmountsVisible && r.ExpectedOpen.IsPartial)" PartialHint="@SalesLabels.PartialHint(r.ExpectedOpen)"
                          Pressed="@(openCard == SalesCards.ExpectedOpen)" Controls="so-detail" OnClick="() => OpenCardAsync(SalesCards.ExpectedOpen)" />
            <SalesKpiCard Label="@Texts.Get("crm.sales-card.weightedopen")" Icon="percent" Tone="brand" Value="@MoneyText(r.WeightedOpen, r)" Detail="@WeightedDetail(r)"
                          Partial="@(r.AmountsVisible && r.WeightedOpen.IsPartial)" PartialHint="@SalesLabels.PartialHint(r.WeightedOpen)"
                          Pressed="@(openCard == SalesCards.WeightedOpen)" Controls="so-detail" OnClick="() => OpenCardAsync(SalesCards.WeightedOpen)" />
            <SalesKpiCard Label="@Texts.Get("crm.salesOverview.outlook")" Icon="trending-up" Tone="info" Value="@(r.AmountsVisible ? CrmLabels.Amount(r.Outlook, r.Currency) : NoAmountText)"
                          Detail="@Texts.Get("crm.salesOverview.outlookDetail")"
                          Partial="@(r.AmountsVisible && (r.Realized.IsPartial || r.WeightedOpen.IsPartial))" PartialHint="@Texts.Get("crm.salesOverview.outlookPartial")" />
            <SalesKpiCard Label="@Texts.Get("crm.opportunityReport.winRate")" Icon="target" Tone="success" Value="@(r.WinRatePercent is { } rate ? SalesLabels.Percent(rate) : SalesAnalysisLabels.NoData)"
                          Detail="@WinRateDetail(r)" />
        </div>

        <div class="filters">
            <button type="button" class="btn btn-outline-secondary btn-sm" aria-pressed="@(openCard == SalesCards.Lost ? "true" : "false")" aria-controls="so-detail" disabled="@detailLoading"
                    @onclick="() => OpenCardAsync(SalesCards.Lost)">@Texts.Get("crm.salesOverview.listLost", r.LostCount)</button>
        </div>

        @if (openCard is not null)
        {
            <section id="so-detail" class="detail-section" aria-labelledby="so-detail-title" aria-busy="@(detailLoading ? "true" : "false")">
                <div class="section-header">
                    <h2 id="so-detail-title" tabindex="-1" @ref="detailHeading">@Texts.Get("crm.salesOverview.cardTitle", SalesLabels.Label(SalesLabels.Cards, openCard))</h2>
                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CloseDetail">@Texts.Get("common.close")</button>
                </div>
                @if (detailLoading)
                {
                    <p class="text-muted" role="status">@Texts.Get("crm.salesOverview.listLoading")</p>
                }
                else if (detailError is not null)
                {
                    <div class="alert alert-danger" role="alert">
                        @detailError
                        <button type="button" class="btn btn-outline-secondary btn-sm ms-2" @onclick="() => RetryDetailAsync(openCard)">@Texts.Get("crm.sales.retry")</button>
                    </div>
                }
                else if (detail is not null)
                {
                    var d = detail;
                    <p>
                        <strong>@d.PeriodLabel</strong> (@SalesLabels.Period(d.PeriodStart, d.PeriodEnd)) ·
                        @Texts.Get("crm.salesOverview.opportunityCount", d.RowCount)
                        @if (d.AmountsVisible)
                        {
                            <text> · @Texts.Strong("crm.salesOverview.total", CrmLabels.Amount(d.Total.Amount, d.Currency))</text>
                            @if (d.Total.IsPartial)
                            {
                                <text> </text><span class="badge stage-onhold">@Texts.Get("crm.sales.partial")</span><text> @SalesLabels.PartialHint(d.Total)</text>
                            }
                        }
                        else
                        {
                            <text> · @Texts.Get("crm.salesOverview.noAmountsShort")</text>
                        }
                    </p>
                    @if (d.Rows.Count > 0)
                    {
                        <SalesCardExportButtons Card="@d.Card" Query="@appliedQuery" />
                    }
                    @if (d.Truncated || d.RowCount > d.Rows.Count)
                    {
                        <div class="alert alert-warning" role="status">@Texts.Get("crm.salesOverview.listTruncated", d.Rows.Count, d.RowCount)</div>
                    }
                    @if (d.Rows.Count == 0)
                    {
                        <EmptyState Title="@Texts.Get("crm.salesOverview.cardEmpty")" />
                    }
                    else
                    {
                        <table class="table record-table">
                            <caption class="visually-hidden">@Texts.Get("crm.salesOverview.cardTitle", SalesLabels.Label(SalesLabels.Cards, d.Card))</caption>
                            <thead>
                                <tr>
                                    <th scope="col">@Texts.Get("crm.dataQuality.col.number")</th><th scope="col">@Texts.Get("crm.dataQuality.col.title")</th><th scope="col">@Texts.Get("common.field.owner")</th><th scope="col">@Texts.Get("crm.opportunities.col.stage")</th>
                                    @if (d.AmountsVisible)
                                    {
                                        <th scope="col">@Texts.Get("crm.salesOverview.col.sourceAmount")</th><th scope="col">@Texts.Get("crm.salesOverview.col.convertedIn", d.Currency)</th><th scope="col">@Texts.Get("crm.forecast-adjustment.probability")</th>
                                    }
                                    <th scope="col">@Texts.Get("crm.salesOverview.col.expectedClose")</th><th scope="col">@Texts.Get("crm.salesOverview.col.actualClose")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in d.Rows)
                                {
                                    <tr>
                                        <td data-label="@Texts.Get("crm.dataQuality.col.number")" class="primary"><a href="crm/firsatlar/@row.Id">@row.OpportunityNumber</a></td>
                                        <td data-label="@Texts.Get("crm.dataQuality.col.title")">@row.Title</td>
                                        <td data-label="@Texts.Get("common.field.owner")">@(row.OwnerId is null ? Texts.Get("crm.leads.unassigned") : Lookups.MemberName(row.OwnerId))</td>
                                        <td data-label="@Texts.Get("crm.opportunities.col.stage")">
                                            <span class="badge stage-@Lookups.Badge(CrmLists.OpportunityStage, row.Stage)">@Lookups.Label(CrmLists.OpportunityStage, row.Stage)</span>
                                            @if (row.Status != OpportunityStatus.Open)
                                            {
                                                <span class="badge stage-@row.Status.ToLowerInvariant()">@CrmText.OpportunityStatusName(row.Status)</span>
                                            }
                                        </td>
                                        @if (d.AmountsVisible)
                                        {
                                            <td data-label="@Texts.Get("crm.salesOverview.col.sourceAmount")">@(row.SourceAmount is { } source ? CrmLabels.Amount(source, row.SourceCurrency) : "—")</td>
                                            <td data-label="@Texts.Get("crm.salesOverview.col.converted")">
                                                @(row.Amount is { } converted ? CrmLabels.Amount(converted, d.Currency) : "—")
                                                @if (row.Issue is not null)
                                                {
                                                    <span class="badge stage-lost">@SalesLabels.Issue(row.Issue)</span>
                                                }
                                                @if (row.RateUsed is { } rateUsed)
                                                {
                                                    <small class="text-muted">@Texts.Get("crm.salesOverview.rate", rateUsed.ToString("0.####", Regional.Numbers))</small>
                                                }
                                            </td>
                                            <td data-label="@Texts.Get("crm.forecast-adjustment.probability")">@(row.Probability is { } probability ? $"%{probability}" : "—")</td>
                                        }
                                        <td data-label="@Texts.Get("crm.salesOverview.col.expectedClose")">@(row.ExpectedCloseDate is { } expected ? CrmLabels.Date(expected) : "—")</td>
                                        <td data-label="@Texts.Get("crm.salesOverview.col.actualClose")">@(row.ActualCloseDate is { } actual ? CrmLabels.Date(actual) : "—")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                }
            </section>
        }

        <section class="detail-section" aria-labelledby="so-targets">
            <div class="section-header"><h2 id="so-targets">@Texts.Get("crm.salesOverview.targets")</h2></div>
            <SalesTargetBlock Title="@Texts.Get("crm.salesOverview.amountTarget")" Block="r.AmountTarget" Hidden="@(r.AmountsVisible ? null : Texts.Get("crm.salesOverview.amountTargetHidden"))" />
            <SalesTargetBlock Title="@Texts.Get("crm.salesOverview.countTarget")" Block="r.CountTarget" />
        </section>

        <section class="detail-section" aria-labelledby="so-stage">
            <div class="section-header"><h2 id="so-stage">@Texts.Get("crm.salesOverview.byStage")</h2></div>
            @if (r.ByStage.Count == 0)
            {
                <p class="text-muted">@Texts.Get("crm.sales.noOpen")</p>
            }
            else
            {
                <BarChart Title="@(r.AmountsVisible ? Texts.Get("crm.salesOverview.stageChartAmount", r.Currency) : Texts.Get("crm.salesOverview.stageChartCount"))"
                          Slices="@r.ByStage.Select(s => new ChartSlice(Lookups.Label(CrmLists.OpportunityStage, s.Stage), r.AmountsVisible ? s.Amount : s.Count)).ToList()" />
                <table class="table record-table">
                    <caption class="visually-hidden">@Texts.Get("crm.salesOverview.stageCaption")</caption>
                    <thead>
                        <tr>
                            <th scope="col">@Texts.Get("crm.opportunities.col.stage")</th><th scope="col">@Texts.Get("crm.sales.col.count")</th>
                            @if (r.AmountsVisible) { <th scope="col">@Texts.Get("crm.sales.col.amount")</th><th scope="col">@Texts.Get("crm.salesOverview.col.weightedAmount")</th><th scope="col">@Texts.Get("crm.salesOverview.col.partialData")</th> }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in r.ByStage)
                        {
                            <tr>
                                <td data-label="@Texts.Get("crm.opportunities.col.stage")" class="primary">@Lookups.Label(CrmLists.OpportunityStage, s.Stage)</td>
                                <td data-label="@Texts.Get("crm.sales.col.count")">@s.Count</td>
                                @if (r.AmountsVisible)
                                {
                                    <td data-label="@Texts.Get("crm.sales.col.amount")">@CrmLabels.Amount(s.Amount, r.Currency)</td>
                                    <td data-label="@Texts.Get("crm.salesOverview.col.weightedAmount")">@CrmLabels.Amount(s.Weighted, r.Currency)</td>
                                    <td data-label="@Texts.Get("crm.salesOverview.col.partialData")">@(s.MissingAmountCount + s.MissingRateCount > 0 ? Texts.Get("crm.salesOverview.partialValue", s.MissingAmountCount, s.MissingRateCount) : "—")</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </section>

        <section class="detail-section" aria-labelledby="so-trend">
            <div class="section-header"><h2 id="so-trend">@Texts.Get("crm.salesOverview.trend", r.Trend.Count)</h2></div>
            @if (r.Trend.Count == 0)
            {
                <p class="text-muted">@Texts.Get("crm.salesOverview.noTrend")</p>
            }
            else
            {
                <BarChart Title="@(r.AmountsVisible ? Texts.Get("crm.salesOverview.trendChartAmount", r.Currency) : Texts.Get("crm.salesOverview.trendChartCount"))"
                          Slices="@r.Trend.Select(t => new ChartSlice(t.Partial ? Texts.Get("crm.salesOverview.partialLabel", t.Label) : t.Label, r.AmountsVisible ? t.Realized : t.WonCount)).ToList()" />
                <table class="table record-table">
                    <caption class="visually-hidden">@Texts.Get("crm.salesOverview.trendCaption")</caption>
                    <thead>
                        <tr><th scope="col">@Texts.Get("crm.salesOverview.col.period")</th><th scope="col">@Texts.Get("crm.salesOverview.col.dates")</th><th scope="col">@Texts.Get("crm.sales-metric.woncount")</th>@if (r.AmountsVisible) { <th scope="col">@Texts.Get("crm.salesOverview.col.realizedAmount")</th> }</tr>
                    </thead>
                    <tbody>
                        @foreach (var t in r.Trend)
                        {
                            <tr>
                                <td data-label="@Texts.Get("crm.salesOverview.col.period")" class="primary">@t.Label @(t.Partial ? Texts.Get("crm.salesOverview.partialData") : null)</td>
                                <td data-label="@Texts.Get("crm.salesOverview.col.dates")">@SalesLabels.Period(t.Start, t.End)</td>
                                <td data-label="@Texts.Get("crm.sales-metric.woncount")">@t.WonCount</td>
                                @if (r.AmountsVisible) { <td data-label="@Texts.Get("crm.salesOverview.col.realizedAmount")">@CrmLabels.Amount(t.Realized, r.Currency)</td> }
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </section>

        <section class="detail-section" aria-labelledby="so-overdue">
            <div class="section-header"><h2 id="so-overdue">@Texts.Get("crm.salesOverview.overdue", r.OverdueOpenCount)</h2></div>
            @if (r.Overdue.Count == 0)
            {
                <EmptyState Title="@Texts.Get("crm.salesOverview.noOverdue")" />
            }
            else
            {
                <table class="table record-table">
                    <caption class="visually-hidden">@Texts.Get("crm.salesOverview.overdueCaption")</caption>
                    <thead>
                        <tr><th scope="col">@Texts.Get("crm.dataQuality.col.number")</th><th scope="col">@Texts.Get("crm.dataQuality.col.title")</th><th scope="col">@Texts.Get("common.field.owner")</th><th scope="col">@Texts.Get("crm.salesOverview.col.expectedClose")</th>@if (r.AmountsVisible) { <th scope="col">@Texts.Get("crm.sales.col.amount")</th> }</tr>
                    </thead>
                    <tbody>
                        @foreach (var o in r.Overdue)
                        {
                            <tr>
                                <td data-label="@Texts.Get("crm.dataQuality.col.number")" class="primary"><a href="crm/firsatlar/@o.Id">@o.OpportunityNumber</a></td>
                                <td data-label="@Texts.Get("crm.dataQuality.col.title")">@o.Title</td>
                                <td data-label="@Texts.Get("common.field.owner")">@(o.OwnerId is null ? Texts.Get("crm.leads.unassigned") : Lookups.MemberName(o.OwnerId))</td>
                                <td data-label="@Texts.Get("crm.salesOverview.col.expectedClose")">@(o.ExpectedCloseDate is { } due ? CrmLabels.Date(due) : "—")</td>
                                @if (r.AmountsVisible) { <td data-label="@Texts.Get("crm.sales.col.amount")">@(o.Amount is { } amount ? CrmLabels.Amount(amount, o.Currency) : Texts.Get("crm.sales-issue.missingamount"))</td> }
                            </tr>
                        }
                    </tbody>
                </table>
                @if (r.OverdueOpenCount > r.Overdue.Count)
                {
                    <p class="small text-muted">@Texts.Get("crm.salesOverview.overdueTruncated", r.Overdue.Count, r.OverdueOpenCount)</p>
                }
            }
        </section>

        <details class="detail-section">
            <summary><strong>@Texts.Get("crm.sales.definitions")</strong></summary>
            <ul class="small text-muted mt-2">
                @foreach (var definition in r.Definitions)
                {
                    <li>@definition</li>
                }
            </ul>
        </details>
    }
</AuthGate>

@code {
    private static string NoAmountText => SalesAnalysisLabels.NoAmountPermission;

    private string kind = SalesPeriodKinds.Month;
    private DateOnly anchor = DateOnly.FromDateTime(Regional.Now.DateTime);
    private string owner = string.Empty;
    private string currency = string.Empty;

    private SalesOverviewDto? report;
    private string? error;
    private bool forbidden;
    private bool loading;
    private int requestId;
    private string appliedQuery = string.Empty;

    private string? openCard;
    private SalesCardDetailDto? detail;
    private string? detailError;
    private bool detailLoading;
    private int detailRequestId;
    private bool focusDetail;
    private ElementReference detailHeading;

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (Session.Can(SalesAccess.ReportsRead))
        {
            await Lookups.LoadAsync();
            await LoadAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusDetail && openCard is not null)
        {
            focusDetail = false;
            await detailHeading.FocusAsync();
        }
    }

    private static string Iso(DateOnly day) => day.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);

    private string BuildQuery()
    {
        var query = new List<string> { $"kind={kind}", $"date={Iso(anchor)}" };
        if (owner.Length > 0)
        {
            query.Add($"ownerId={Uri.EscapeDataString(owner)}");
        }

        // Yarım yazılmış para birimi gönderilmez (3 harf olunca uygulanır).
        if (currency.Trim().Length == 3)
        {
            query.Add($"currency={Uri.EscapeDataString(currency.Trim().ToUpperInvariant())}");
        }

        return string.Join('&', query);
    }

    private async Task LoadAsync()
    {
        var id = ++requestId;
        loading = true;
        error = null;
        forbidden = false;
        CloseDetail();
        appliedQuery = BuildQuery();

        var result = await Api.GetAsync<SalesOverviewDto>($"/api/crm/sales/overview?{appliedQuery}");
        if (id != requestId)
        {
            return;
        }

        loading = false;
        if (result.IsSuccess)
        {
            report = result.Value;
            return;
        }

        report = null;
        error = result.Error;
        forbidden = result.Status == HttpStatusCode.Forbidden;
    }

    private async Task ChooseKindAsync(string key)
    {
        kind = key;
        await LoadAsync();
    }

    private async Task ShiftAsync(int direction)
    {
        var (start, end) = report is { } r ? (r.PeriodStart, r.PeriodEnd) : SalesLabels.CalendarPeriod(kind, anchor);
        anchor = direction < 0 ? start.AddDays(-1) : end.AddDays(1);
        await LoadAsync();
    }

    private async Task TodayAsync()
    {
        anchor = DateOnly.FromDateTime(Regional.Now.DateTime);
        await LoadAsync();
    }

    private async Task OpenCardAsync(string card)
    {
        if (openCard == card)
        {
            CloseDetail();
            return;
        }

        var id = ++detailRequestId;
        openCard = card;
        detail = null;
        detailError = null;
        detailLoading = true;

        var result = await Api.GetAsync<SalesCardDetailDto>($"/api/crm/sales/overview/cards/{card}?{appliedQuery}");
        if (id != detailRequestId)
        {
            return;
        }

        detailLoading = false;
        detail = result.Value;
        detailError = result.Error;
        focusDetail = true;
    }

    private void CloseDetail()
    {
        detailRequestId++;
        openCard = null;
        detail = null;
        detailError = null;
        detailLoading = false;
    }

    private static bool IsEmpty(SalesOverviewDto r) =>
        r.OpenPipeline.Count == 0 && r.Realized.Count == 0 && r.WonCount == 0 && r.LostCount == 0 && r.ByStage.Count == 0;

    private static string MoneyText(MoneyTotalDto total, SalesOverviewDto r) =>
        r.AmountsVisible ? CrmLabels.Amount(total.Amount, r.Currency) : NoAmountText;

    private static string WeightedDetail(SalesOverviewDto r) =>
        Texts.Get("crm.salesOverview.opportunityCount", r.WeightedOpen.Count) + (r.WeightedMissingProbabilityCount > 0 ? " · " + Texts.Get("crm.salesOverview.missingProbability", r.WeightedMissingProbabilityCount) : null);

    private static string WinRateDetail(SalesOverviewDto r) =>
        r.WinRatePercent is null ? Texts.Get("crm.salesOverview.noClosed") : Texts.Get("crm.salesOverview.winRateDetail", r.WonCount, r.LostCount);

    private async Task RetryDetailAsync(string? card)
    {
        if (card is null)
        {
            return;
        }

        CloseDetail();
        await OpenCardAsync(card);
    }
}
