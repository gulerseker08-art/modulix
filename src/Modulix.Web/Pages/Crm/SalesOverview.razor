@page "/crm/satis-gorunumu"
@using System.Globalization
@using System.Net
@inject ApiClient Api
@inject SessionState Session
@inject CrmLookups Lookups

<PageTitle>Satış görünümü · Modulix</PageTitle>

<AuthGate Module="@CrmAccess.ModuleKey" Permission="@SalesAccess.ReportsRead">
    <div class="page-header">
        <div>
            <h1>Satış görünümü</h1>
            <p class="text-muted mb-0">
                Tutarlar raporlama para biriminde, vergi hariç net tutardır. Veriler yetkiniz ve veri kapsamınızla sınırlıdır; her kart, sayısını veren fırsat listesini açar.
            </p>
        </div>
        <div class="header-actions">
            @if (Session.Can(SalesAccess.TargetsRead))
            {
                <a class="btn btn-outline-secondary" href="crm/satis-hedefleri">Satış hedefleri</a>
            }
            @if (Session.Can(SalesAccess.ForecastsRead))
            {
                <a class="btn btn-outline-secondary" href="crm/satis-tahmini">Satış tahmini</a>
            }
        </div>
    </div>

    <div class="filters" role="group" aria-label="Dönem türü">
        <div class="segmented">
            @foreach (var (key, label) in SalesLabels.PeriodKinds)
            {
                <button type="button" class="chip @(kind == key ? "active" : null)" aria-pressed="@(kind == key ? "true" : "false")" disabled="@loading" @onclick="() => ChooseKindAsync(key)">@label</button>
            }
        </div>
        <button type="button" class="btn btn-outline-secondary" disabled="@loading" @onclick="() => ShiftAsync(-1)">← Önceki dönem</button>
        <button type="button" class="btn btn-outline-secondary" disabled="@loading" @onclick="TodayAsync">Bugün</button>
        <button type="button" class="btn btn-outline-secondary" disabled="@loading" @onclick="() => ShiftAsync(1)">Sonraki dönem →</button>
    </div>

    <form class="form-grid mb-3" @onsubmit="LoadAsync" @onsubmit:preventDefault aria-label="Görünüm süzgeçleri">
        <div class="span-3">
            <label class="form-label" for="so-date">Dönemdeki bir gün</label>
            <input id="so-date" class="form-control" type="date" @bind="anchor" @bind:after="LoadAsync" />
        </div>
        <div class="span-4">
            <label class="form-label" for="so-owner">Kullanıcı (sorumlu)</label>
            <select id="so-owner" class="form-select" @bind="owner" @bind:after="LoadAsync">
                <option value="">Tüm kullanıcılar</option>
                @foreach (var member in Lookups.Members)
                {
                    <option value="@member.UserId">@member.DisplayName</option>
                }
            </select>
        </div>
        <div class="span-3">
            <label class="form-label" for="so-currency">Para birimi</label>
            <input id="so-currency" class="form-control" maxlength="3" placeholder="@Regional.Currency" aria-describedby="so-currency-help" @bind="currency" @bind:after="LoadAsync" />
            <div id="so-currency-help" class="form-text">Boşsa firmanın raporlama para birimi (3 harf, ör. USD).</div>
        </div>
    </form>

    @if (loading)
    {
        <p class="text-muted" role="status">Yükleniyor…</p>
    }

    @if (error is not null)
    {
        <div class="alert @(forbidden ? "alert-warning" : "alert-danger")" role="alert">
            @(forbidden ? "Bu görünümü açma yetkiniz yok. " : null)@error
            @if (!forbidden)
            {
                <button type="button" class="btn btn-outline-secondary btn-sm ms-2" disabled="@loading" @onclick="LoadAsync">Tekrar dene</button>
            }
        </div>
    }

    @if (report is not null)
    {
        var r = report;
        <p class="small text-muted" role="status">
            <strong>@r.PeriodLabel</strong> (@SalesLabels.Period(r.PeriodStart, r.PeriodEnd)) · bugün @CrmLabels.Date(r.Today) · para birimi <strong>@r.Currency</strong>
            @if (r.ScopeLimited)
            {
                <span class="badge tag">Veri kapsamınız kısıtlı</span>
            }
        </p>

        @if (r.ScopeLimited)
        {
            <div class="alert alert-info" role="status">Veri kapsamınız kısıtlı: yalnızca yetkili olduğunuz fırsatlar hesaba katıldı.</div>
        }
        @if (!r.AmountsVisible)
        {
            <div class="alert alert-info" role="status">Tutarları görme yetkiniz yok; tutar toplamları gösterilmiyor, yalnızca adetler vardır.</div>
        }
        @if (r.Truncated)
        {
            <div class="alert alert-warning" role="status">Okuma sınırına ulaşıldı; toplamlar eksik olabilir. Kullanıcı ya da dönem seçerek daraltın.</div>
        }
        @if (r.Warnings.Count > 0)
        {
            <div class="alert alert-warning" role="status">
                <strong>Verilerle ilgili uyarılar</strong>
                <ul class="mb-0">
                    @foreach (var warning in r.Warnings)
                    {
                        <li>@warning</li>
                    }
                </ul>
            </div>
        }

        @if (IsEmpty(r))
        {
            <p class="text-muted">Bu dönem ve süzgeç için gösterilecek fırsat yok.</p>
        }

        <div class="kpi-grid" role="group" aria-label="Satış özeti">
            <SalesKpiCard Label="Gerçekleşen" Icon="check-circle" Tone="success" Value="@MoneyText(r.Realized, r)" Detail="@($"{r.Realized.Count} kazanılan fırsat")"
                          Partial="@(r.AmountsVisible && r.Realized.IsPartial)" PartialHint="@SalesLabels.PartialHint(r.Realized)"
                          Pressed="@(openCard == SalesCards.Realized)" Controls="so-detail" OnClick="() => OpenCardAsync(SalesCards.Realized)" />
            <SalesKpiCard Label="Açık pipeline" Icon="layers" Tone="info" Value="@MoneyText(r.OpenPipeline, r)" Detail="@($"{r.OpenPipeline.Count} açık fırsat (tüm kapanış tarihleri)")"
                          Partial="@(r.AmountsVisible && r.OpenPipeline.IsPartial)" PartialHint="@SalesLabels.PartialHint(r.OpenPipeline)"
                          Pressed="@(openCard == SalesCards.OpenPipeline)" Controls="so-detail" OnClick="() => OpenCardAsync(SalesCards.OpenPipeline)" />
            <SalesKpiCard Label="Bu dönem beklenen" Icon="calendar" Tone="brand" Value="@MoneyText(r.ExpectedOpen, r)" Detail="@($"{r.ExpectedOpen.Count} açık fırsat, kapanışı bu dönemde")"
                          Partial="@(r.AmountsVisible && r.ExpectedOpen.IsPartial)" PartialHint="@SalesLabels.PartialHint(r.ExpectedOpen)"
                          Pressed="@(openCard == SalesCards.ExpectedOpen)" Controls="so-detail" OnClick="() => OpenCardAsync(SalesCards.ExpectedOpen)" />
            <SalesKpiCard Label="Ağırlıklı tahmin" Icon="percent" Tone="brand" Value="@MoneyText(r.WeightedOpen, r)" Detail="@WeightedDetail(r)"
                          Partial="@(r.AmountsVisible && r.WeightedOpen.IsPartial)" PartialHint="@SalesLabels.PartialHint(r.WeightedOpen)"
                          Pressed="@(openCard == SalesCards.WeightedOpen)" Controls="so-detail" OnClick="() => OpenCardAsync(SalesCards.WeightedOpen)" />
            <SalesKpiCard Label="Dönem öngörüsü" Icon="trending-up" Tone="info" Value="@(r.AmountsVisible ? CrmLabels.Amount(r.Outlook, r.Currency) : NoAmountText)"
                          Detail="Gerçekleşen + ağırlıklı tahmin"
                          Partial="@(r.AmountsVisible && (r.Realized.IsPartial || r.WeightedOpen.IsPartial))" PartialHint="Gerçekleşen ya da ağırlıklı tahmin kısmi veriyle hesaplandı." />
            <SalesKpiCard Label="Kazanma oranı" Icon="target" Tone="success" Value="@(r.WinRatePercent is { } rate ? SalesLabels.Percent(rate) : "Veri yok")"
                          Detail="@WinRateDetail(r)" />
        </div>

        <div class="filters">
            <button type="button" class="btn btn-outline-secondary btn-sm" aria-pressed="@(openCard == SalesCards.Lost ? "true" : "false")" aria-controls="so-detail" disabled="@detailLoading"
                    @onclick="() => OpenCardAsync(SalesCards.Lost)">Kaybedilen fırsatları listele (@r.LostCount)</button>
        </div>

        @if (openCard is not null)
        {
            <section id="so-detail" class="detail-section" aria-labelledby="so-detail-title" aria-busy="@(detailLoading ? "true" : "false")">
                <div class="section-header">
                    <h2 id="so-detail-title" tabindex="-1" @ref="detailHeading">@SalesLabels.Label(SalesLabels.Cards, openCard) fırsatları</h2>
                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CloseDetail">Kapat</button>
                </div>
                @if (detailLoading)
                {
                    <p class="text-muted" role="status">Liste yükleniyor…</p>
                }
                else if (detailError is not null)
                {
                    <div class="alert alert-danger" role="alert">
                        @detailError
                        <button type="button" class="btn btn-outline-secondary btn-sm ms-2" @onclick="() => RetryDetailAsync(openCard)">Tekrar dene</button>
                    </div>
                }
                else if (detail is not null)
                {
                    var d = detail;
                    <p>
                        <strong>@d.PeriodLabel</strong> (@SalesLabels.Period(d.PeriodStart, d.PeriodEnd)) ·
                        @d.RowCount fırsat
                        @if (d.AmountsVisible)
                        {
                            <text> · toplam <strong>@CrmLabels.Amount(d.Total.Amount, d.Currency)</strong></text>
                            @if (d.Total.IsPartial)
                            {
                                <text> </text><span class="badge stage-onhold">Kısmi</span><text> @SalesLabels.PartialHint(d.Total)</text>
                            }
                        }
                        else
                        {
                            <text> · tutarları görme yetkiniz yok</text>
                        }
                    </p>
                    @if (d.Truncated || d.RowCount > d.Rows.Count)
                    {
                        <div class="alert alert-warning" role="status">Liste kısaltıldı: @d.Rows.Count satır gösteriliyor, toplam @d.RowCount fırsat. Kullanıcı ya da dönem seçerek daraltın.</div>
                    }
                    @if (d.Rows.Count == 0)
                    {
                        <p class="text-muted">Bu kartta fırsat yok.</p>
                    }
                    else
                    {
                        <table class="table record-table">
                            <caption class="visually-hidden">@SalesLabels.Label(SalesLabels.Cards, d.Card) fırsatları</caption>
                            <thead>
                                <tr>
                                    <th scope="col">No</th><th scope="col">Başlık</th><th scope="col">Sorumlu</th><th scope="col">Aşama</th>
                                    @if (d.AmountsVisible)
                                    {
                                        <th scope="col">Kaynak tutar</th><th scope="col">Dönüştürülen tutar (@d.Currency)</th><th scope="col">Olasılık</th>
                                    }
                                    <th scope="col">Beklenen kapanış</th><th scope="col">Gerçek kapanış</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in d.Rows)
                                {
                                    <tr>
                                        <td data-label="No" class="primary"><a href="crm/firsatlar/@row.Id">@row.OpportunityNumber</a></td>
                                        <td data-label="Başlık">@row.Title</td>
                                        <td data-label="Sorumlu">@(row.OwnerId is null ? "Atanmadı" : Lookups.MemberName(row.OwnerId))</td>
                                        <td data-label="Aşama">
                                            <span class="badge stage-@Lookups.Badge(CrmLists.OpportunityStage, row.Stage)">@Lookups.Label(CrmLists.OpportunityStage, row.Stage)</span>
                                            @if (row.Status != OpportunityStatus.Open)
                                            {
                                                <span class="badge stage-@row.Status.ToLowerInvariant()">@CrmText.OpportunityStatusName(row.Status)</span>
                                            }
                                        </td>
                                        @if (d.AmountsVisible)
                                        {
                                            <td data-label="Kaynak tutar">@(row.SourceAmount is { } source ? CrmLabels.Amount(source, row.SourceCurrency) : "—")</td>
                                            <td data-label="Dönüştürülen tutar">
                                                @(row.Amount is { } converted ? CrmLabels.Amount(converted, d.Currency) : "—")
                                                @if (row.Issue is not null)
                                                {
                                                    <span class="badge stage-lost">@SalesLabels.Issue(row.Issue)</span>
                                                }
                                                @if (row.RateUsed is { } rateUsed)
                                                {
                                                    <small class="text-muted">kur @rateUsed.ToString("0.####", Regional.Numbers)</small>
                                                }
                                            </td>
                                            <td data-label="Olasılık">@(row.Probability is { } probability ? $"%{probability}" : "—")</td>
                                        }
                                        <td data-label="Beklenen kapanış">@(row.ExpectedCloseDate is { } expected ? CrmLabels.Date(expected) : "—")</td>
                                        <td data-label="Gerçek kapanış">@(row.ActualCloseDate is { } actual ? CrmLabels.Date(actual) : "—")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                }
            </section>
        }

        <section class="detail-section" aria-labelledby="so-targets">
            <div class="section-header"><h2 id="so-targets">Hedefler</h2></div>
            <SalesTargetBlock Title="Tutar hedefi" Block="r.AmountTarget" Hidden="@(r.AmountsVisible ? null : "Tutarları görme yetkiniz olmadığından tutar hedefi gösterilmiyor.")" />
            <SalesTargetBlock Title="Adet hedefi" Block="r.CountTarget" />
        </section>

        <section class="detail-section" aria-labelledby="so-stage">
            <div class="section-header"><h2 id="so-stage">Aşama dağılımı (açık fırsatlar)</h2></div>
            @if (r.ByStage.Count == 0)
            {
                <p class="text-muted">Açık fırsat yok.</p>
            }
            else
            {
                <BarChart Title="@($"Aşamaya göre açık fırsat {(r.AmountsVisible ? $"tutarı ({r.Currency})" : "adedi")}")"
                          Slices="@r.ByStage.Select(s => new ChartSlice(Lookups.Label(CrmLists.OpportunityStage, s.Stage), r.AmountsVisible ? s.Amount : s.Count)).ToList()" />
                <table class="table record-table">
                    <caption class="visually-hidden">Aşama dağılımı</caption>
                    <thead>
                        <tr>
                            <th scope="col">Aşama</th><th scope="col">Adet</th>
                            @if (r.AmountsVisible) { <th scope="col">Tutar</th><th scope="col">Ağırlıklı tutar</th><th scope="col">Kısmi veri</th> }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in r.ByStage)
                        {
                            <tr>
                                <td data-label="Aşama" class="primary">@Lookups.Label(CrmLists.OpportunityStage, s.Stage)</td>
                                <td data-label="Adet">@s.Count</td>
                                @if (r.AmountsVisible)
                                {
                                    <td data-label="Tutar">@CrmLabels.Amount(s.Amount, r.Currency)</td>
                                    <td data-label="Ağırlıklı tutar">@CrmLabels.Amount(s.Weighted, r.Currency)</td>
                                    <td data-label="Kısmi veri">@(s.MissingAmountCount + s.MissingRateCount > 0 ? $"{s.MissingAmountCount} tutarsız, {s.MissingRateCount} kursuz fırsat" : "—")</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </section>

        <section class="detail-section" aria-labelledby="so-trend">
            <div class="section-header"><h2 id="so-trend">Son @r.Trend.Count dönemin gerçekleşeni</h2></div>
            @if (r.Trend.Count == 0)
            {
                <p class="text-muted">Trend verisi yok.</p>
            }
            else
            {
                <BarChart Title="@($"Dönemlere göre gerçekleşen {(r.AmountsVisible ? $"tutar ({r.Currency})" : "adet")}")"
                          Slices="@r.Trend.Select(t => new ChartSlice(t.Partial ? $"{t.Label} (kısmi)" : t.Label, r.AmountsVisible ? t.Realized : t.WonCount)).ToList()" />
                <table class="table record-table">
                    <caption class="visually-hidden">Dönemlere göre gerçekleşen</caption>
                    <thead>
                        <tr><th scope="col">Dönem</th><th scope="col">Tarihler</th><th scope="col">Kazanılan adet</th>@if (r.AmountsVisible) { <th scope="col">Gerçekleşen tutar</th> }</tr>
                    </thead>
                    <tbody>
                        @foreach (var t in r.Trend)
                        {
                            <tr>
                                <td data-label="Dönem" class="primary">@t.Label @(t.Partial ? "(kısmi veri)" : null)</td>
                                <td data-label="Tarihler">@SalesLabels.Period(t.Start, t.End)</td>
                                <td data-label="Kazanılan adet">@t.WonCount</td>
                                @if (r.AmountsVisible) { <td data-label="Gerçekleşen tutar">@CrmLabels.Amount(t.Realized, r.Currency)</td> }
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </section>

        <section class="detail-section" aria-labelledby="so-overdue">
            <div class="section-header"><h2 id="so-overdue">Gecikmiş açık fırsatlar (@r.OverdueOpenCount)</h2></div>
            @if (r.Overdue.Count == 0)
            {
                <p class="text-muted">Beklenen kapanış tarihi geçmiş açık fırsat yok.</p>
            }
            else
            {
                <table class="table record-table">
                    <caption class="visually-hidden">Beklenen kapanış tarihi geçmiş açık fırsatlar</caption>
                    <thead>
                        <tr><th scope="col">No</th><th scope="col">Başlık</th><th scope="col">Sorumlu</th><th scope="col">Beklenen kapanış</th>@if (r.AmountsVisible) { <th scope="col">Tutar</th> }</tr>
                    </thead>
                    <tbody>
                        @foreach (var o in r.Overdue)
                        {
                            <tr>
                                <td data-label="No" class="primary"><a href="crm/firsatlar/@o.Id">@o.OpportunityNumber</a></td>
                                <td data-label="Başlık">@o.Title</td>
                                <td data-label="Sorumlu">@(o.OwnerId is null ? "Atanmadı" : Lookups.MemberName(o.OwnerId))</td>
                                <td data-label="Beklenen kapanış">@(o.ExpectedCloseDate is { } due ? CrmLabels.Date(due) : "—")</td>
                                @if (r.AmountsVisible) { <td data-label="Tutar">@(o.Amount is { } amount ? CrmLabels.Amount(amount, o.Currency) : "Tutar yok")</td> }
                            </tr>
                        }
                    </tbody>
                </table>
                @if (r.OverdueOpenCount > r.Overdue.Count)
                {
                    <p class="small text-muted">En eski @r.Overdue.Count fırsat gösteriliyor; toplam @r.OverdueOpenCount.</p>
                }
            }
        </section>

        <details class="detail-section">
            <summary><strong>Hesap açıklaması</strong></summary>
            <ul class="small text-muted mt-2">
                @foreach (var definition in r.Definitions)
                {
                    <li>@definition</li>
                }
            </ul>
        </details>
    }
</AuthGate>

@code {
    private const string NoAmountText = "Yetkiniz yok";

    private string kind = SalesPeriodKinds.Month;
    private DateOnly anchor = DateOnly.FromDateTime(Regional.Now.DateTime);
    private string owner = string.Empty;
    private string currency = string.Empty;

    private SalesOverviewDto? report;
    private string? error;
    private bool forbidden;
    private bool loading;
    private int requestId;
    private string appliedQuery = string.Empty;

    private string? openCard;
    private SalesCardDetailDto? detail;
    private string? detailError;
    private bool detailLoading;
    private int detailRequestId;
    private bool focusDetail;
    private ElementReference detailHeading;

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (Session.Can(SalesAccess.ReportsRead))
        {
            await Lookups.LoadAsync();
            await LoadAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusDetail && openCard is not null)
        {
            focusDetail = false;
            await detailHeading.FocusAsync();
        }
    }

    private static string Iso(DateOnly day) => day.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);

    private string BuildQuery()
    {
        var query = new List<string> { $"kind={kind}", $"date={Iso(anchor)}" };
        if (owner.Length > 0)
        {
            query.Add($"ownerId={Uri.EscapeDataString(owner)}");
        }

        // Yarım yazılmış para birimi gönderilmez (3 harf olunca uygulanır).
        if (currency.Trim().Length == 3)
        {
            query.Add($"currency={Uri.EscapeDataString(currency.Trim().ToUpperInvariant())}");
        }

        return string.Join('&', query);
    }

    private async Task LoadAsync()
    {
        var id = ++requestId;
        loading = true;
        error = null;
        forbidden = false;
        CloseDetail();
        appliedQuery = BuildQuery();

        var result = await Api.GetAsync<SalesOverviewDto>($"/api/crm/sales/overview?{appliedQuery}");
        if (id != requestId)
        {
            return;
        }

        loading = false;
        if (result.IsSuccess)
        {
            report = result.Value;
            return;
        }

        report = null;
        error = result.Error;
        forbidden = result.Status == HttpStatusCode.Forbidden;
    }

    private async Task ChooseKindAsync(string key)
    {
        kind = key;
        await LoadAsync();
    }

    private async Task ShiftAsync(int direction)
    {
        var (start, end) = report is { } r ? (r.PeriodStart, r.PeriodEnd) : SalesLabels.CalendarPeriod(kind, anchor);
        anchor = direction < 0 ? start.AddDays(-1) : end.AddDays(1);
        await LoadAsync();
    }

    private async Task TodayAsync()
    {
        anchor = DateOnly.FromDateTime(Regional.Now.DateTime);
        await LoadAsync();
    }

    private async Task OpenCardAsync(string card)
    {
        if (openCard == card)
        {
            CloseDetail();
            return;
        }

        var id = ++detailRequestId;
        openCard = card;
        detail = null;
        detailError = null;
        detailLoading = true;

        var result = await Api.GetAsync<SalesCardDetailDto>($"/api/crm/sales/overview/cards/{card}?{appliedQuery}");
        if (id != detailRequestId)
        {
            return;
        }

        detailLoading = false;
        detail = result.Value;
        detailError = result.Error;
        focusDetail = true;
    }

    private void CloseDetail()
    {
        detailRequestId++;
        openCard = null;
        detail = null;
        detailError = null;
        detailLoading = false;
    }

    private static bool IsEmpty(SalesOverviewDto r) =>
        r.OpenPipeline.Count == 0 && r.Realized.Count == 0 && r.WonCount == 0 && r.LostCount == 0 && r.ByStage.Count == 0;

    private static string MoneyText(MoneyTotalDto total, SalesOverviewDto r) =>
        r.AmountsVisible ? CrmLabels.Amount(total.Amount, r.Currency) : NoAmountText;

    private static string WeightedDetail(SalesOverviewDto r) =>
        $"{r.WeightedOpen.Count} fırsat" + (r.WeightedMissingProbabilityCount > 0 ? $" · {r.WeightedMissingProbabilityCount} fırsatın olasılığı yok (toplama girmedi)" : null);

    private static string WinRateDetail(SalesOverviewDto r) =>
        r.WinRatePercent is null ? "Bu dönemde sonuçlanan fırsat yok" : $"Kazanılan {r.WonCount} · kaybedilen {r.LostCount}";

    private async Task RetryDetailAsync(string? card)
    {
        if (card is null)
        {
            return;
        }

        CloseDetail();
        await OpenCardAsync(card);
    }
}
