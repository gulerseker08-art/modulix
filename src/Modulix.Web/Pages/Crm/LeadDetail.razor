@page "/crm/leadler/{Id:guid}"
@inject ApiClient Api
@inject SessionState Session
@inject CrmLookups Lookups
@inject ActivityOptions ActivityNames

<PageTitle>@(lead?.LeadNumber ?? Texts.Get("crm.lead.fallbackTitle")) · Modulix</PageTitle>

<AuthGate Module="@CrmAccess.ModuleKey" Permission="@CrmAccess.LeadsRead">
    <a class="back-link" href="crm/leadler">← @Texts.Get("crm.leads.title")</a>

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }
    @if (actionErrors is { Count: > 0 })
    {
        <ul class="alert alert-danger">
            @foreach (var (_, texts) in actionErrors)
            {
                @foreach (var text in texts)
                {
                    <li>@text</li>
                }
            }
        </ul>
    }

    @if (lead is null)
    {
        @if (message is null)
        {
            <LoadingState />
        }
    }
    else if (editing)
    {
        <LeadEditor Lead="lead" Lookups="Lookups" Saved="LeadSaved" Deleted="LeadDeleted" Cancelled="() => editing = false" />
    }
    else
    {
        <div class="page-header">
            <div>
                <h1>@lead.Subject</h1>
                <div class="header-meta">
                    <span>@lead.LeadNumber</span>
                    <span class="badge stage-@lead.Status.ToLowerInvariant()">@CrmText.LeadStatusName(lead.Status)</span>
                    <span>@Texts.Get("crm.lead.priorityLine", CrmText.LeadPriorityName(lead.Priority))</span>
                    @if (FirstContactOverdue)
                    {
                        <span class="badge stage-lost">@Texts.Get("crm.lead.firstContactOverdue")</span>
                    }
                </div>
            </div>
            <div class="header-actions">
                @if (Session.Can(CrmAccess.LeadsUpdate) && lead.Status != LeadStatus.Converted)
                {
                    <button type="button" class="btn btn-outline-primary" @onclick="() => editing = true">@Texts.Get("common.edit")</button>
                }
            </div>
        </div>

        @if (lead.Status == LeadStatus.Converted)
        {
            <div class="alert alert-success" role="status">
                @Texts.Get("crm.lead.converted", lead.ConvertedAt is { } at ? CrmLabels.Time(at) : string.Empty)
                (@Lookups.MemberName(lead.ConvertedBy)):
                @if (lead.ConvertedCompanyId is { } company) { <a href="crm/firmalar/@company">@Texts.Get("crm.company.fallbackTitle")</a> }
                @if (lead.ConvertedContactId is { } contact) { <text> · </text><a href="crm/kisiler/@contact">@Texts.Get("crm.contact.fallbackTitle")</a> }
                @if (lead.ConvertedOpportunityId is not null) { <text> · </text><a href="crm/firsatlar">@Texts.Get("crm.opportunity.single")</a> }
            </div>
        }

        <FormSection Title="@Texts.Get("crm.lead.section.request")" Icon="inbox">
            <dl class="detail-grid">
                <div><dt>@Texts.Get("crm.leads.col.requester")</dt><dd>@(string.Join(' ', new[] { lead.FirstName, lead.LastName }.Where(n => !string.IsNullOrWhiteSpace(n))) is { Length: > 0 } name ? name : "—")</dd></div>
                <div><dt>@Texts.Get("crm.company.editor.nameFallback")</dt><dd>@(lead.CompanyName ?? "—")</dd></div>
                <div><dt>@Texts.Get("crm.contacts.col.title")</dt><dd>@(lead.JobTitle ?? "—")</dd></div>
                <div><dt>@Texts.Get("common.field.email")</dt><dd>@if (lead.Email is { } email) { <a href="mailto:@email">@email</a> } else { <text>—</text> }</dd></div>
                <div><dt>@Texts.Get("common.field.phone")</dt><dd>@if (lead.Phone is { } phone) { <a href="tel:@phone">@phone</a> } else { <text>—</text> }</dd></div>
                <div><dt>@Texts.Get("crm.merge.field.website")</dt><dd>@(lead.Website ?? "—")</dd></div>
                <div><dt>@Texts.Get("crm.lead.location")</dt><dd>@(string.Join(", ", new[] { lead.City, lead.Country }.Where(n => !string.IsNullOrWhiteSpace(n))) is { Length: > 0 } place ? place : "—")</dd></div>
                @if (lead.CompanyId is { } existingCompany)
                {
                    <div><dt>@Texts.Get("crm.lead.existingCompany")</dt><dd><a href="crm/firmalar/@existingCompany">@Lookups.CompanyName(existingCompany)</a></dd></div>
                }
                @if (lead.ContactId is { } existingContact)
                {
                    <div><dt>@Texts.Get("crm.lead.existingContact")</dt><dd><a href="crm/kisiler/@existingContact">@Lookups.ContactName(existingContact)</a></dd></div>
                }
                <div><dt>@Texts.Get("crm.lead.productInterest")</dt><dd>@(lead.ProductInterest ?? "—")</dd></div>
                @if (lead.ServiceScope is { Count: > 0 } serviceScope)
                {
                    <div class="span-all">
                        <dt>@Texts.Get("crm.leads.filter.scope")</dt>
                        <dd>
                            @foreach (var code in serviceScope)
                            {
                                <span class="badge tag">@ActivityNames.NameOf(code)</span>
                            }
                        </dd>
                    </div>
                }
                <div><dt>@Texts.Get("crm.lead.budget")</dt><dd>@(lead.EstimatedBudget is { } budget ? CrmLabels.Amount(budget, lead.Currency) : Texts.Get("crm.lead.unknown"))</dd></div>
                <div><dt>@Texts.Get("crm.lead.targetPurchase")</dt><dd>@(lead.TargetPurchaseDate is { } target ? CrmLabels.Date(target) : Texts.Get("crm.lead.unknown"))</dd></div>
                <div><dt>@Texts.Get("crm.companies.col.industry")</dt><dd>@(lead.IndustryName ?? lead.LegacyIndustry ?? "—")</dd></div>
                @if (lead.NeedDescription is { } need)
                {
                    <div class="span-all"><dt>@Texts.Get("crm.lead.need")</dt><dd class="notes">@need</dd></div>
                }
                @if (lead.Description is { } description)
                {
                    <div class="span-all"><dt>@Texts.Get("crm.lead.description")</dt><dd class="notes">@description</dd></div>
                }
                @if (lead.StatusReason is { } statusReason)
                {
                    <div class="span-all"><dt>@Texts.Get("crm.lead.statusReason")</dt><dd class="notes">@statusReason</dd></div>
                }
            </dl>
        </FormSection>

        <FormSection Title="@Texts.Get("crm.lead.section.source")" Icon="user-check">
            <dl class="detail-grid">
                <div><dt>@Texts.Get("crm.company.source")</dt><dd>@(lead.Source is null ? "—" : Lookups.Label(CrmLeadLists.Source, lead.Source))@(lead.SourceDetail is { } sd ? $" · {sd}" : null)</dd></div>
                <div><dt>@Texts.Get("crm.lead.firstReceived")</dt><dd>@CrmLabels.Time(lead.FirstReceivedAt)</dd></div>
                @if (lead.ExternalSource is { } external)
                {
                    <div><dt>@Texts.Get("crm.lead.externalSource")</dt><dd>@external</dd></div>
                }
                @if (lead.Referrer is { } referrer)
                {
                    <div><dt>@Texts.Get("crm.lead.referrer")</dt><dd>@referrer</dd></div>
                }
                @if (lead.UtmSource is not null || lead.UtmMedium is not null || lead.UtmCampaign is not null)
                {
                    <div><dt>UTM</dt><dd>@string.Join(" / ", new[] { lead.UtmSource, lead.UtmMedium, lead.UtmCampaign }.Where(u => !string.IsNullOrWhiteSpace(u)))</dd></div>
                }
                <div><dt>@Texts.Get("common.field.owner")</dt><dd>@(lead.OwnerId is null ? Texts.Get("crm.leads.unassigned") : Lookups.MemberName(lead.OwnerId))@(lead.AssignedAt is { } assigned ? $" · {CrmLabels.Time(assigned)}" : null)</dd></div>
                <div><dt>@Texts.Get("crm.leads.col.firstContact")</dt><dd>@(lead.FirstContactAt is { } first ? CrmLabels.Time(first) : Texts.Get("crm.lead.notYet"))</dd></div>
                @if (lead.FollowUpAt is { } follow)
                {
                    <div><dt>@Texts.Get("crm.lead.followUpDate")</dt><dd>@CrmLabels.Time(follow)</dd></div>
                }
                @if (lead.QualifiedAt is { } qualified)
                {
                    <div><dt>@Texts.Get("crm.lead.qualifiedAt")</dt><dd>@CrmLabels.Time(qualified)</dd></div>
                }
                @if (lead.DisqualifiedAt is { } disqualified)
                {
                    <div><dt>@Texts.Get("crm.lead.disqualifiedAt")</dt><dd>@CrmLabels.Time(disqualified) · @Lookups.Label(CrmLeadLists.DisqualificationReason, lead.DisqualificationReason)</dd></div>
                }
                @foreach (var field in Lookups.FieldsOf(CrmEntityKeys.Lead))
                {
                    var text = CustomFieldText.Format(field, lead.Custom);
                    @if (text.Length > 0)
                    {
                        <div><dt>@field.Label</dt><dd>@text</dd></div>
                    }
                }
            </dl>
        </FormSection>

        <section class="detail-section lead-actions">
            <div class="section-header"><h2>@Texts.Get("crm.lead.actions")</h2></div>
            @if (!anyAction)
            {
                <p class="text-muted">@Texts.Get("crm.lead.noActions")</p>
            }
            <div class="action-row">
                @if (CanAssign)
                {
                    <LookupPicker Id="lead-assignee" LookupKey="crm.lead.owner" @bind-Value="Assignee" Placeholder="@Texts.Get("crm.lead.chooseOwner")" />
                    <button type="button" class="btn btn-outline-primary" disabled="@(busy || assignee == Guid.Empty)" @onclick="AssignAsync">@Texts.Get("crm.lead.assign")</button>
                }
                @if (CanStartContacting)
                {
                    <button type="button" class="btn btn-outline-primary" disabled="@busy" @onclick="StartContactingAsync">@Texts.Get("crm.lead.startContacting")</button>
                }
                @if (CanQualify)
                {
                    <button type="button" class="btn btn-outline-success" disabled="@busy" @onclick="() => Toggle(PanelName.Qualify)">@Texts.Get("crm.lead.qualify")</button>
                }
                @if (CanNurture)
                {
                    <button type="button" class="btn btn-outline-secondary" disabled="@busy" @onclick="() => Toggle(PanelName.Nurture)">@Texts.Get("crm.lead.nurture")</button>
                }
                @if (CanDisqualify)
                {
                    <button type="button" class="btn btn-outline-danger" disabled="@busy" @onclick="() => Toggle(PanelName.Disqualify)">@Texts.Get("crm.lead.disqualify")</button>
                }
                @if (CanReopen)
                {
                    <button type="button" class="btn btn-outline-primary" disabled="@busy" @onclick="() => Toggle(PanelName.Reopen)">@Texts.Get("crm.lead.reopen")</button>
                }
                @if (CanConvert)
                {
                    <button type="button" class="btn btn-primary" disabled="@busy" @onclick="() => Toggle(PanelName.Convert)">@Texts.Get("crm.lead.convert")</button>
                }
            </div>

            @switch (panel)
            {
                case "qualify":
                    <div class="inline-form">
                        <label class="form-label" for="q-note">@Texts.Get("crm.lead.noteOptional")</label>
                        <textarea id="q-note" class="form-control" rows="2" maxlength="500" @bind="note"></textarea>
                        <small class="text-muted">@Texts.Get("crm.lead.qualifyHelp")</small>
                        <button type="button" class="btn btn-success" disabled="@busy" @onclick="QualifyAsync">@Texts.Get("crm.lead.qualifyDo")</button>
                    </div>
                    break;
                case "nurture":
                    <div class="inline-form">
                        <label class="form-label" for="n-date">@Texts.Get("crm.lead.followUpDate")</label>
                        <input id="n-date" class="form-control" type="datetime-local" @bind="followUp" />
                        <small class="text-muted">@Texts.Get("crm.lead.nurtureHelp")</small>
                        <label class="form-label" for="n-note">@Texts.Get("crm.party.note")</label>
                        <textarea id="n-note" class="form-control" rows="2" maxlength="500" @bind="note"></textarea>
                        <button type="button" class="btn btn-secondary" disabled="@busy" @onclick="NurtureAsync">@Texts.Get("crm.lead.nurtureDo")</button>
                    </div>
                    break;
                case "disqualify":
                    <div class="inline-form">
                        <label class="form-label" for="d-reason">@Texts.Get("crm.lead.disqualifyReason")</label>
                        <select id="d-reason" class="form-select" @bind="reason">
                            <option value="">@Texts.Get("common.choose")</option>
                            @foreach (var r in Lookups.Choices(CrmLeadLists.DisqualificationReason))
                            {
                                <option value="@r.Key">@r.Label</option>
                            }
                        </select>
                        <label class="form-label" for="d-note">@Texts.Get("crm.party.note")</label>
                        <textarea id="d-note" class="form-control" rows="2" maxlength="500" @bind="note"></textarea>
                        <button type="button" class="btn btn-danger" disabled="@(busy || string.IsNullOrEmpty(reason))" @onclick="DisqualifyAsync">@Texts.Get("crm.lead.disqualify")</button>
                    </div>
                    break;
                case "reopen":
                    <div class="inline-form">
                        <label class="form-label" for="r-reason">@Texts.Get("crm.lead.reopenReason")</label>
                        <textarea id="r-reason" class="form-control" rows="2" maxlength="500" @bind="note"></textarea>
                        <button type="button" class="btn btn-primary" disabled="@(busy || string.IsNullOrWhiteSpace(note))" @onclick="ReopenAsync">@Texts.Get("crm.lead.reopen")</button>
                    </div>
                    break;
                case "convert":
                    <LeadConvertPanel Lead="lead" Lookups="Lookups" Converted="ConvertedAsync" Cancelled="() => panel = null" />
                    break;
            }
        </section>

        @if (matches is { Count: > 0 })
        {
            <section class="detail-section">
                <div class="section-header"><h2>@Texts.Get("crm.lead.matches.title")</h2></div>
                <p class="text-muted small">@Texts.Get("crm.lead.matches.help")</p>
                <ul class="item-list">
                    @foreach (var match in matches)
                    {
                        <li>
                            <div class="item-main">
                                <a href="@MatchLink(match)">@match.Title</a>
                                <span class="text-muted">@MatchKind(match.Kind)@(match.Status is { } ms ? $" · {CrmText.LeadStatusName(ms)}" : null) · @string.Join(", ", match.Reasons)</span>
                            </div>
                        </li>
                    }
                </ul>
            </section>
        }

        <section class="detail-section">
            <div class="section-header">
                <h2>@Texts.Get("crm.activities.title")</h2>
                @if (Session.Can(CrmAccess.ActivitiesWrite) && !addingActivity && LeadStatus.IsOpen(lead.Status))
                {
                    <button type="button" class="btn btn-outline-primary btn-sm" @onclick="() => addingActivity = true">@Texts.Get("crm.company.acts.add")</button>
                }
            </div>
            @if (addingActivity)
            {
                <ActivityEditor Lookups="Lookups" FixedLeadId="Id" Saved="ActivitySavedAsync" Cancelled="() => addingActivity = false" />
            }
            @if (activities is null)
            {
                <LoadingState />
            }
            else if (activities.Count == 0)
            {
                <EmptyState Compact="true" Title="@Texts.Get("crm.lead.acts.none")" />
            }
            else
            {
                var nextPlanned = activities.Where(a => ActivityStatus.IsOpen(a.Status) && a.DueAt is not null).OrderBy(a => a.DueAt).FirstOrDefault();
                var lastDone = activities.Where(a => a.CompletedAt is not null).OrderByDescending(a => a.CompletedAt).FirstOrDefault();
                <p class="text-muted small">
                    @Texts.Get("crm.lead.acts.lastDone"): @(lastDone is null ? Texts.Get("common.none") : $"{lastDone.Subject} · {CrmLabels.Time(lastDone.CompletedAt!.Value)}")
                    · @Texts.Get("crm.lead.acts.nextPlanned"): @(nextPlanned is null ? Texts.Get("common.none") : $"{nextPlanned.Subject} · {CrmLabels.Time(nextPlanned.DueAt!.Value)}")
                </p>
                <ul class="item-list timeline">
                    @foreach (var a in activities.OrderByDescending(x => x.CompletedAt ?? x.DueAt ?? DateTimeOffset.MaxValue))
                    {
                        var overdue = a.IsOverdue(DateTimeOffset.UtcNow);
                        <li>
                            <div class="item-main">
                                <strong>@Lookups.Label(CrmLists.ActivityType, a.Type) · @a.Subject</strong>
                                <span class="text-muted">
                                    @(a.CompletedAt is { } done ? Texts.Get("crm.lead.acts.completedAt", CrmLabels.Time(done)) : a.DueAt is { } d ? Texts.Get("crm.lead.acts.plannedAt", CrmLabels.Time(d)) : Texts.Get("crm.lead.acts.undated"))
                                    @(a.Outcome is { } outcome ? $" · {CrmText.ActivityOutcomeName(outcome)}" : null)
                                    · @Lookups.MemberName(a.OwnerId)
                                </span>
                                @if (overdue) { <span class="badge stage-lost">@Texts.Get("crm.lead.acts.overdue")</span> }
                            </div>
                            @if (a.CompletedAt is null && Session.Can(CrmAccess.ActivitiesWrite))
                            {
                                <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@busy" @onclick="() => CompleteAsync(a)">@Texts.Get("crm.company.acts.complete")</button>
                            }
                        </li>
                    }
                </ul>
            }
        </section>

        <RecordHistory EntityKey="@CrmEntityKeys.Lead" RecordId="Id" Version="lead.Version" />
    }
</AuthGate>

@code {
    private LeadDto? lead;
    private IReadOnlyList<ActivityDto>? activities;
    private IReadOnlyList<LeadMatchDto>? matches;
    private IReadOnlyDictionary<string, string[]>? actionErrors;
    private string? message;
    private string? panel;
    private string? note;
    private string reason = string.Empty;
    private DateTime? followUp;
    private Guid assignee;

    private Guid? Assignee
    {
        get => assignee == Guid.Empty ? null : assignee;
        set => assignee = value ?? Guid.Empty;
    }
    private int? targetHours;
    private bool editing;
    private bool addingActivity;
    private bool busy;

    [Parameter] public Guid Id { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        await Session.EnsureLoadedAsync();
        if (!Session.Can(CrmAccess.LeadsRead))
        {
            return;
        }

        await Lookups.LoadAsync(contacts: true);
        await ActivityNames.LoadAsync();
        targetHours = (await Api.GetAsync<LeadSettingsDto>("/api/crm/leads/settings")).Value?.FirstContactTargetHours;
        await LoadAsync();
    }

    private bool CanAssign => lead is not null && Session.Can(CrmAccess.LeadsAssign) && LeadStatus.IsOpen(lead.Status);

    private bool CanStartContacting => lead is not null && Session.Can(CrmAccess.LeadsQualify) && lead.Status is LeadStatus.New or LeadStatus.Nurturing;

    private bool CanQualify => lead is not null && Session.Can(CrmAccess.LeadsQualify) && lead.Status is LeadStatus.New or LeadStatus.Contacting or LeadStatus.Nurturing;

    private bool CanNurture => lead is not null && Session.Can(CrmAccess.LeadsQualify) && lead.Status is LeadStatus.New or LeadStatus.Contacting or LeadStatus.Qualified;

    private bool CanDisqualify => lead is not null && Session.Can(CrmAccess.LeadsDisqualify) && LeadStatus.IsOpen(lead.Status);

    private bool CanReopen => lead is not null && Session.Can(CrmAccess.LeadsDisqualify) && lead.Status == LeadStatus.Disqualified;

    private bool CanConvert => lead is not null && Session.Can(CrmAccess.LeadsConvert) && lead.Status == LeadStatus.Qualified;

    private bool anyAction => CanAssign || CanStartContacting || CanQualify || CanNurture || CanDisqualify || CanReopen || CanConvert;

    private bool FirstContactOverdue =>
        lead is not null && targetHours is { } hours && lead.FirstContactAt is null && lead.Status is LeadStatus.New or LeadStatus.Contacting
        && DateTimeOffset.UtcNow - lead.FirstReceivedAt > TimeSpan.FromHours(hours);

    private static class PanelName
    {
        public const string Qualify = "qualify";
        public const string Nurture = "nurture";
        public const string Disqualify = "disqualify";
        public const string Reopen = "reopen";
        public const string Convert = "convert";
    }

    private void Toggle(string name) => panel = panel == name ? null : name;

    private async Task LoadAsync()
    {
        var result = await Api.GetAsync<LeadDto>($"/api/crm/leads/{Id}");
        lead = result.Value;
        message = result.Error;
        if (lead is null)
        {
            return;
        }

        matches = (await Api.GetAsync<List<LeadMatchDto>>($"/api/crm/leads/{Id}/duplicates")).Value;
        await LoadActivitiesAsync();
    }

    private async Task LoadActivitiesAsync()
    {
        activities = Session.Can(CrmAccess.ActivitiesRead)
            ? (await Api.GetAsync<CrmPage<ActivityDto>>($"/api/crm/activities?leadId={Id}&pageSize=100")).Value?.Items ?? []
            : [];
    }

    private async Task RunAsync(string action, object body)
    {
        busy = true;
        message = null;
        actionErrors = null;
        var result = await Api.PostAsync<LeadDto>($"/api/crm/leads/{Id}/{action}", body);
        busy = false;
        if (result.IsSuccess)
        {
            panel = null;
            note = null;
            reason = string.Empty;
            await LoadAsync();
            return;
        }

        message = result.Error;
        actionErrors = result.FieldErrors;
    }

    private Task AssignAsync() => RunAsync("assign", new AssignLeadRequest(assignee, lead!.Version));

    private Task StartContactingAsync() => RunAsync("start-contacting", new LeadVersionRequest(lead!.Version));

    private Task QualifyAsync() => RunAsync("qualify", new QualifyLeadRequest(lead!.Version, note));

    private Task NurtureAsync() =>
        RunAsync("nurture", new NurtureLeadRequest(lead!.Version, followUp is { } local ? Regional.FromTenant(local) : null, note));

    private Task DisqualifyAsync() => RunAsync("disqualify", new DisqualifyLeadRequest(lead!.Version, reason, note));

    private Task ReopenAsync() => RunAsync("reopen", new ReopenLeadRequest(lead!.Version, note ?? string.Empty));

    private async Task ConvertedAsync(ConvertLeadResultDto result)
    {
        panel = null;
        await LoadAsync();
    }

    private async Task CompleteAsync(ActivityDto activity)
    {
        busy = true;
        var result = await Api.PutAsync<ActivityDto>($"/api/crm/activities/{activity.Id}", CrmRequests.From(activity) with { CompletedAt = DateTimeOffset.UtcNow });
        busy = false;
        message = result.Error;
        // İlk temas olay aboneliğiyle (arka planda) işlenir; kısa bir gecikmeyle Lead'i yenilemek gerekebilir.
        await LoadAsync();
    }

    private async Task ActivitySavedAsync(ActivityDto activity)
    {
        addingActivity = false;
        await LoadAsync();
    }

    private async Task LeadSaved(LeadDto saved)
    {
        editing = false;
        await LoadAsync();
    }

    private Task LeadDeleted()
    {
        lead = null;
        message = Texts.Get("crm.lead.deleted");
        return Task.CompletedTask;
    }

    private static string MatchLink(LeadMatchDto match) => match.Kind switch
    {
        "Lead" => $"crm/leadler/{match.Id}",
        "Company" => $"crm/firmalar/{match.Id}",
        _ => $"crm/kisiler/{match.Id}",
    };

    private static string MatchKind(string kind) => kind switch { "Lead" => Texts.Get("crm.leads.single"), "Company" => Texts.Get("crm.company.fallbackTitle"), _ => Texts.Get("crm.contact.fallbackTitle") };
}
