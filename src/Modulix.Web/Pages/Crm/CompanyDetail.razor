@page "/crm/firmalar/{Id:guid}"
@inject ApiClient Api
@inject SessionState Session
@inject CrmLookups Lookups

<PageTitle>@(company?.Name ?? "Firma") · Modulix</PageTitle>

<AuthGate Module="@CrmAccess.ModuleKey" Permission="@CrmAccess.CompaniesRead">
    <a class="back-link" href="crm/firmalar">← Firmalar</a>

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }

    @if (company is null)
    {
        @if (message is null)
        {
            <p class="text-muted">Yükleniyor…</p>
        }
    }
    else if (editingCompany)
    {
        <CompanyEditor Company="company" Lookups="Lookups" Saved="CompanySaved" Deleted="CompanyDeleted" Cancelled="() => editingCompany = false" />
    }
    else
    {
        <div class="page-header">
            <div class="page-heading">
                <span class="page-icon" aria-hidden="true"><AppIcon Name="building" Size="24" /></span>
                <div>
                    <h1>@company.Name</h1>
                    @if (company.Industry is not null || company.City is not null)
                    {
                        <p class="page-subtitle">@(string.Join(" · ", new[] { company.Industry, company.City }.Where(x => !string.IsNullOrWhiteSpace(x))))</p>
                    }
                    <div class="header-meta">
                        <span class="badge status-@Lookups.Badge(CrmLists.CompanyStatus, company.Status)">@Lookups.Label(CrmLists.CompanyStatus, company.Status)</span>
                        @foreach (var tag in CrmLabels.Tags(company.Tags))
                        {
                            <span class="badge tag">@tag</span>
                        }
                    </div>
                </div>
            </div>
            <div class="header-actions">
                @if (Session.Can(CrmAccess.CompaniesMerge))
                {
                    <a class="btn btn-outline-secondary" href="@($"crm/firmalar/{Id}/birlestir")">Mükerrer firmayı birleştir</a>
                }
                @if (Session.Can(CrmAccess.CompaniesWrite))
                {
                    <button type="button" class="btn btn-primary" @onclick="() => editingCompany = true">Düzenle</button>
                }
            </div>
        </div>

        <div class="record-layout">
            @* Özet kartı: kimlik, sorumlu, satış özeti ve hızlı iletişim. *@
            <aside class="record-summary" aria-label="Firma özeti">
                <div class="summary-card">
                    <div class="summary-identity">
                        <span class="summary-avatar" aria-hidden="true">@Initials(company.Name)</span>
                        <strong class="summary-name">@company.Name</strong>
                        <span class="badge status-@Lookups.Badge(CrmLists.CompanyStatus, company.Status)">@Lookups.Label(CrmLists.CompanyStatus, company.Status)</span>
                    </div>

                    <dl class="summary-facts">
                        <div><dt>Sorumlu</dt><dd>@Lookups.MemberName(company.OwnerId)</dd></div>
                        @if (company.Industry is { } industry)
                        {
                            <div><dt>Sektör</dt><dd>@industry</dd></div>
                        }
                        @if (company.TaxNumber is { } taxNumber)
                        {
                            <div><dt>Vergi no</dt><dd>@taxNumber</dd></div>
                        }
                        @if (company.City is { } city)
                        {
                            <div><dt>Şehir</dt><dd>@city</dd></div>
                        }
                    </dl>

                    <h2 class="summary-heading">Satış özeti</h2>
                    <dl class="summary-facts summary-numbers">
                        <div>
                            <dt>Açık fırsatlar</dt>
                            <dd>
                                <strong>@Count(summary?.OpenOpportunities)</strong>
                                @if (summary?.OpenTotals is { Count: > 0 } openTotals) { <small>@Totals(openTotals)</small> }
                            </dd>
                        </div>
                        <div>
                            <dt>Kazanılan</dt>
                            <dd>
                                <strong>@Count(summary?.WonOpportunities)</strong>
                                @if (summary?.WonTotals is { Count: > 0 } wonTotals) { <small>@Totals(wonTotals)</small> }
                            </dd>
                        </div>
                        <div>
                            <dt>Açık aktiviteler</dt>
                            <dd>
                                <strong>@Count(summary?.OpenActivities)</strong>
                                @if (summary?.OverdueActivities is > 0 and var overdue) { <small class="overdue-note">@overdue geciken</small> }
                            </dd>
                        </div>
                    </dl>

                    @if (company.Phone is not null || company.Email is not null || company.Website is not null)
                    {
                        <h2 class="summary-heading">İletişim</h2>
                        <ul class="summary-contact">
                            @if (company.Phone is { } phone)
                            {
                                <li><AppIcon Name="phone" Size="16" /><a href="tel:@phone">@phone</a></li>
                            }
                            @if (company.Email is { } email)
                            {
                                <li><AppIcon Name="mail" Size="16" /><a href="mailto:@email">@email</a></li>
                            }
                            @if (company.Website is { } website)
                            {
                                <li><AppIcon Name="layers" Size="16" /><span>@website</span></li>
                            }
                        </ul>
                    }
                </div>
            </aside>

            <div class="record-main">
                <TabBar Tabs="CompanyTabs" State="tabs" Label="Firma bölümleri" Changed="_ => { }" />

                @if (tabs.Rendered(TabGeneral))
                {
                    <div role="tabpanel" id="tabpanel-@TabGeneral" aria-labelledby="tab-@TabGeneral" class="record-tabpanel" hidden="@tabs.Hidden(TabGeneral)">
                        @* Boş alanlar gösterilmez; telefonda kart kısa kalır. Kimlik ve iletişim özet kartındadır. *@
                        <FormSection Title="Genel bilgiler" Icon="info">
                        <dl class="detail-grid">
                            @if (company.Source is { } source)
                            {
                                <div><dt>Kaynak</dt><dd>@Lookups.Label(CrmLists.CompanySource, source)</dd></div>
                            }
                            @if (company.Address is { } address)
                            {
                                <div class="span-all"><dt>Adres</dt><dd>@address</dd></div>
                            }
                            @if (company.Notes is { } notes)
                            {
                                <div class="span-all"><dt>Notlar</dt><dd class="notes">@notes</dd></div>
                            }
                            @* Özel alanlar (Y9a): boş olanlar gösterilmez. *@
                            @foreach (var field in Lookups.FieldsOf(CrmEntityKeys.Company))
                            {
                                var text = CustomFieldText.Format(field, company.Custom);
                                @if (text.Length > 0)
                                {
                                    <div class="@(field.Type is CustomFieldType.MultilineText ? "span-all" : null)">
                                        <dt>@field.Label</dt><dd class="@(field.Type is CustomFieldType.MultilineText ? "notes" : null)">@text</dd>
                                    </div>
                                }
                            }
                        </dl>
                        </FormSection>

                        @* Adresler ve iletişim (ADR-0012): ana kayıtlar yukarıdaki telefon/e-posta/adres alanlarının kaynağıdır. *@
                        <FormSection Title="Adres ve iletişim" Icon="map-pin">
                            <AddressesSection CompanyId="Id" Title="Adresler" CanWrite="Session.Can(CrmAccess.CompaniesWrite)" Changed="ReloadCompanyAsync" />
                            <ContactPointsSection CompanyId="Id" Title="Telefon ve e-posta" CanWrite="Session.Can(CrmAccess.CompaniesWrite)" Changed="ReloadCompanyAsync" />
                        </FormSection>

                        <LocationsSection CompanyId="Id" CanWrite="Session.Can(CrmAccess.CompaniesWrite)" Lookups="Lookups" />
                    </div>
                }

                @if (tabs.Rendered(TabRelations))
                {
                    <div role="tabpanel" id="tabpanel-@TabRelations" aria-labelledby="tab-@TabRelations" class="record-tabpanel" hidden="@tabs.Hidden(TabRelations)">
                        @if (Session.Can(CrmAccess.ContactsRead))
                        {
                            <section class="detail-section">
                                <div class="section-header">
                                    <h2>Kişiler ve ilişki rolleri</h2>
                                    @if (Session.Can(CrmAccess.ContactsWrite) && !editingLink)
                                    {
                                        <button type="button" class="btn btn-primary btn-sm" @onclick="() => OpenLink(null)">Kişi ilişkilendir</button>
                                        <button type="button" class="btn btn-outline-primary btn-sm" @onclick="() => creatingPerson = true">Yeni kişi oluştur</button>
                                        <a class="btn btn-outline-secondary btn-sm" href="crm/kisiler">Kişilere git</a>
                                    }
                                </div>
                                @if (creatingPerson)
                                {
                                    <NewCompanyPerson CompanyId="Id" Saved="PersonCreated" Cancelled="() => creatingPerson = false" />
                                }
                                @if (editingLink)
                                {
                                    <CompanyContactEditor CompanyId="Id" Link="selectedLink" Lookups="Lookups" Saved="LinkSaved" Cancelled="() => editingLink = false" />
                                }
                                @if (links is { Count: > 0 })
                                {
                                    <ul class="item-list">
                                        @foreach (var link in links)
                                        {
                                            <li class="@(link.IsActive ? null : "done")">
                                                <div class="item-main">
                                                    <strong><a href="crm/kisiler/@link.ContactId">@link.ContactName</a></strong>
                                                    <span>
                                                        @if (link.IsPrimary) { <span class="badge status-customer">Ana irtibat</span><text> </text> }
                                                        @if (link.IsDecisionMaker) { <span class="badge tag">Karar verici</span><text> </text> }
                                                        @link.JobTitle
                                                        @if (link.Department is { } department) { <text> · @department</text> }
                                                        @foreach (var role in link.Roles) { <span class="badge tag">@CrmRelationshipRoles.Labels.GetValueOrDefault(role, role)</span><text> </text> }
                                                        @if (!link.IsActive) { <text> · Sona erdi: @link.EndDate</text> }
                                                    </span>
                                                </div>
                                                @if (Session.Can(CrmAccess.ContactsWrite))
                                                {
                                                    <button type="button" class="btn btn-link btn-sm" @onclick="() => OpenLink(link)">Düzenle</button>
                                                    @if (link.IsActive)
                                                    {
                                                        <button type="button" class="btn btn-link btn-sm" disabled="@busy" @onclick="() => EndLinkAsync(link)">Sonlandır</button>
                                                    }
                                                }
                                            </li>
                                        }
                                    </ul>
                                }
                                else if (links is not null)
                                {
                                    <p class="text-muted">Henüz kişi ilişkisi yok.</p>
                                }
                                <Pager Page="contactPage" PageSize="ListSize" TotalCount="contactTotal" PageChanged="ContactPageChanged" />
                            </section>
                        }

                            <CompanyRelationsSection CompanyId="Id" CanWrite="Session.Can(CrmAccess.CompaniesWrite)" Lookups="Lookups" />
                    </div>
                }

                @if (tabs.Rendered(TabSales))
                {
                    <div role="tabpanel" id="tabpanel-@TabSales" aria-labelledby="tab-@TabSales" class="record-tabpanel" hidden="@tabs.Hidden(TabSales)">
                        @if (Session.Can(CrmAccess.OpportunitiesRead))
                        {
                            <section class="detail-section">
                                <div class="section-header">
                                    <h2>Fırsatlar</h2>
                                    @if (Session.Can(CrmAccess.OpportunitiesWrite) && !editingOpportunity)
                                    {
                                        <button type="button" class="btn btn-primary btn-sm" @onclick="() => OpenOpportunity(null)">Fırsat ekle</button>
                                    }
                                </div>
                                @if (opportunities is { Count: > 0 })
                                {
                                    <ul class="item-list">
                                        @foreach (var opportunity in opportunities)
                                        {
                                            <li>
                                                <div class="item-main">
                                                    <a href="crm/firsatlar/@opportunity.Id"><strong>@opportunity.Title</strong></a>
                                                    <span>
                                                        <span class="badge stage-@Lookups.Badge(CrmLists.OpportunityStage, opportunity.Stage)">@Lookups.Label(CrmLists.OpportunityStage, opportunity.Stage)</span>
                                                        @if (opportunity.Status != OpportunityStatus.Open) { <span class="badge stage-@opportunity.Status.ToLowerInvariant()">@OpportunityStatus.Label(opportunity.Status)</span> }
                                                        @if (opportunity.Amount is { } amount) { <text> @CrmLabels.Amount(amount, opportunity.Currency)</text> }
                                                        @if (opportunity.Probability is { } probability) { <text> · %@probability</text> }
                                                        @if (opportunity.OwnerId is not null) { <text> · @Lookups.MemberName(opportunity.OwnerId)</text> }
                                                    </span>
                                                    @if (opportunity.Status == OpportunityStatus.Lost && opportunity.LossReason is { } lossReason)
                                                    {
                                                        <span>Neden: @Lookups.Label(CrmLists.OpportunityLossReason, lossReason)@(opportunity.LostReason is { } reason ? $" · {reason}" : null)</span>
                                                    }
                                                </div>
                                                @if (Session.Can(CrmAccess.OpportunitiesWrite))
                                                {
                                                    <button type="button" class="btn btn-link btn-sm" @onclick="() => OpenOpportunity(opportunity)">Düzenle</button>
                                                }
                                            </li>
                                        }
                                    </ul>
                                }
                                else if (opportunities is not null)
                                {
                                    <p class="text-muted">Henüz fırsat yok.</p>
                                }
                                <Pager Page="opportunityPage" PageSize="ListSize" TotalCount="opportunityTotal" PageChanged="OpportunityPageChanged" />
                            </section>
                        }

                            <RelatedLeads CompanyId="Id" />
                            <RelatedContracts Title="Sözleşmeler" PartyId="company.PartyId" />
                            <RelatedOrders Title="Siparişler" PartyId="company.PartyId" />
                            <RelatedTickets Title="Destek talepleri" PartyId="company.PartyId" />
                            <RelatedCampaigns TargetId="company.PartyId" />
                    </div>
                }

                @if (tabs.Rendered(TabActivities))
                {
                    <div role="tabpanel" id="tabpanel-@TabActivities" aria-labelledby="tab-@TabActivities" class="record-tabpanel" hidden="@tabs.Hidden(TabActivities)">
                        @if (Session.Can(CrmAccess.ActivitiesRead))
                        {
                            <section class="detail-section">
                                <div class="section-header">
                                    <h2>Aktiviteler</h2>
                                    @if (Session.Can(CrmAccess.ActivitiesWrite) && !editingActivity)
                                    {
                                        <button type="button" class="btn btn-primary btn-sm" @onclick="() => OpenActivity(null)">Aktivite ekle</button>
                                    }
                                </div>
                                @if (activities is { Count: > 0 })
                                {
                                    <ul class="item-list">
                                        @foreach (var activity in activities)
                                        {
                                            <li class="@ActivityClass(activity)">
                                                @if (Session.Can(CrmAccess.ActivitiesWrite) && !activity.Masked && ActivityStatus.IsOpen(activity.Status))
                                                {
                                                    <button type="button" class="btn btn-outline-secondary btn-sm check" title="Tamamla" aria-label="Tamamla"
                                                            disabled="@busy" @onclick="() => CompleteAsync(activity)">✓</button>
                                                }
                                                <div class="item-main">
                                                    <strong>@activity.Subject</strong>
                                                    <span>
                                                        @Lookups.Label(CrmLists.ActivityType, activity.Type)
                                                        @if (activity.DueAt is { } due) { <text> · @CrmLabels.Time(due)</text> }
                                                        @if (activity.OwnerId is not null) { <text> · @Lookups.MemberName(activity.OwnerId)</text> }
                                                        @if (!ActivityStatus.IsOpen(activity.Status)) { <text> · @ActivityLabels.Status(ActivityLabels.Family(Lookups, activity.Type), activity.Status)</text> }
                                                    </span>
                                                </div>
                                                @if (Session.Can(CrmAccess.ActivitiesWrite))
                                                {
                                                    <button type="button" class="btn btn-link btn-sm" @onclick="() => OpenActivity(activity)">Düzenle</button>
                                                }
                                            </li>
                                        }
                                    </ul>
                                }
                                else if (activities is not null)
                                {
                                    <p class="text-muted">Henüz aktivite yok.</p>
                                }
                                <Pager Page="activityPage" PageSize="ListSize" TotalCount="activityTotal" PageChanged="ActivityPageChanged" />
                            </section>
                        }
                    </div>
                }

                @if (tabs.Rendered(TabHistory))
                {
                    <div role="tabpanel" id="tabpanel-@TabHistory" aria-labelledby="tab-@TabHistory" class="record-tabpanel" hidden="@tabs.Hidden(TabHistory)">
                        <RecordHistory EntityKey="@CrmEntityKeys.Company" RecordId="Id" Version="company.Version" />
                    </div>
                }
            </div>
        </div>

        <Drawer Open="editingActivity" Label="@(selectedActivity is null ? "Yeni aktivite" : "Aktiviteyi düzenle")" OnClose="() => editingActivity = false">
            <ActivityEditor Activity="selectedActivity" FixedCompanyId="Id" Lookups="Lookups"
                            Saved="ActivitySaved" Deleted="ActivitySaved" Cancelled="() => editingActivity = false" />
        </Drawer>

        <Drawer Open="editingOpportunity" Label="@(selectedOpportunity is null ? "Yeni fırsat" : "Fırsatı düzenle")" OnClose="() => editingOpportunity = false">
            <OpportunityEditor Opportunity="selectedOpportunity" FixedCompanyId="Id" Lookups="Lookups"
                               Saved="OpportunitySaved" Deleted="OpportunitySaved" Cancelled="() => editingOpportunity = false" />
        </Drawer>
    }
</AuthGate>

@code {
    // Listeler sunucuda sayfalanır; özetler (sayı, toplam) sunucuda erişilebilir tüm kayıtlar üzerinden hesaplanır (ADR-0010).
    private const int ListSize = 20;

    private const string TabGeneral = "genel";
    private const string TabRelations = "iliskiler";
    private const string TabSales = "satis";
    private const string TabActivities = "aktiviteler";
    private const string TabHistory = "gecmis";

    private readonly TabState tabs = new(TabGeneral);

    private CompanySummaryDto? summary;
    private int contactPage = 1, contactTotal, opportunityPage = 1, opportunityTotal, activityPage = 1, activityTotal;

    private CompanyDto? company;
    private IReadOnlyList<CompanyContactDto>? links;
    private CompanyContactDto? selectedLink;
    private bool editingLink;
    private bool creatingPerson;
    private IReadOnlyList<OpportunityDto>? opportunities;
    private IReadOnlyList<ActivityDto>? activities;
    private ActivityDto? selectedActivity;
    private OpportunityDto? selectedOpportunity;
    private bool editingCompany;
    private bool editingActivity;
    private bool editingOpportunity;
    private bool busy;
    private string? message;

    [Parameter] public Guid Id { get; set; }

    [Inject] private NavigationManager Navigation { get; set; } = default!;

    protected override async Task OnParametersSetAsync()
    {
        await Session.EnsureLoadedAsync();
        if (Session.Can(CrmAccess.CompaniesRead))
        {
            await Lookups.LoadAsync(contacts: true, opportunities: true);
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        var result = await Api.GetAsync<CompanyDto>($"/api/crm/companies/{Id}");
        company = result.Value;
        message = result.Error;
        if (company is null)
        {
            // Birleştirilmiş eski kimlik (eski bağlantı/yer imi): hedef firmaya yönlendirilir (ADR-0013).
            if (result.Status == System.Net.HttpStatusCode.NotFound
                && (await Api.GetAsync<MergedRecordDto>($"/api/crm/companies/merged/{Id}")).Value is { } moved)
            {
                Navigation.NavigateTo($"crm/firmalar/{moved.TargetId}", replace: true);
            }

            return;
        }

        await Task.WhenAll(LoadSummaryAsync(), LoadContactsAsync(), LoadOpportunitiesAsync(), LoadActivitiesAsync());
    }

    private async Task LoadSummaryAsync() => summary = (await Api.GetAsync<CompanySummaryDto>($"/api/crm/companies/{Id}/summary")).Value;

    // Erişim olmayan bölüm sıfır gibi gösterilmez.
    private static string Count(int? value) => value?.ToString() ?? "—";

    /// <summary>Sekmeler: yalnızca kullanıcının görebildiği bölümler; sayılar sunucudaki toplamdır.</summary>
    private IReadOnlyList<TabItem> CompanyTabs
    {
        get
        {
            List<TabItem> list = [new(TabGeneral, "Genel bilgiler"), new(TabRelations, "Kişiler ve ilişkiler", Session.Can(CrmAccess.ContactsRead) ? (int?)contactTotal : null)];
            if (Session.Can(CrmAccess.OpportunitiesRead) || Session.Can(CrmAccess.LeadsRead))
            {
                list.Add(new(TabSales, "Fırsatlar ve leadler", Session.Can(CrmAccess.OpportunitiesRead) ? (int?)opportunityTotal : null));
            }

            if (Session.Can(CrmAccess.ActivitiesRead))
            {
                list.Add(new(TabActivities, "Aktiviteler", activityTotal));
            }

            list.Add(new(TabHistory, "Geçmiş"));
            return list;
        }
    }

    /// <summary>Özet kartındaki avatar için adın ilk iki kelimesinin baş harfleri.</summary>
    private static string Initials(string name) =>
        string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpper(p[0], new System.Globalization.CultureInfo("tr-TR"))));

    private void OpenLink(CompanyContactDto? link)
    {
        selectedLink = link;
        editingLink = true;
    }

    private async Task PersonCreated(string? warning)
    {
        creatingPerson = false;
        message = warning;
        await LoadContactsAsync();
    }

    // Ana adres/iletişim noktası değişince eski telefon, e-posta, şehir ve adres alanları da değişir.
    private async Task ReloadCompanyAsync()
    {
        var result = await Api.GetAsync<CompanyDto>($"/api/crm/companies/{Id}");
        company = result.Value ?? company;
    }

    private async Task LinkSaved()
    {
        editingLink = false;
        await LoadContactsAsync();
    }

    // İlişkiyi sonlandırmak kişiyi silmez; geçmiş aktivite ve fırsatlar korunur.
    private async Task EndLinkAsync(CompanyContactDto link)
    {
        busy = true;
        var result = await Api.PutAsync<CompanyContactDto>($"/api/crm/company-contacts/{link.Id}",
            new SaveCompanyContactRequest(link.CompanyId, link.ContactId, link.Department, link.JobTitle, link.Roles, false,
                link.IsDecisionMaker, link.StartDate, DateOnly.FromDateTime(DateTime.Today), link.Version));
        busy = false;
        message = result.Error;
        await LoadContactsAsync();
    }

    private async Task ContactPageChanged(int page)
    {
        contactPage = page;
        await LoadContactsAsync();
    }

    private async Task OpportunityPageChanged(int page)
    {
        opportunityPage = page;
        await LoadOpportunitiesAsync();
    }

    private async Task ActivityPageChanged(int page)
    {
        activityPage = page;
        await LoadActivitiesAsync();
    }

    private async Task LoadContactsAsync()
    {
        if (Session.Can(CrmAccess.ContactsRead))
        {
            var page = (await Api.GetAsync<CrmPage<CompanyContactDto>>($"/api/crm/company-contacts?companyId={Id}&page={contactPage}&pageSize={ListSize}")).Value;
            links = page?.Items ?? [];
            contactTotal = page?.TotalCount ?? 0;
        }
    }

    private async Task LoadOpportunitiesAsync()
    {
        if (Session.Can(CrmAccess.OpportunitiesRead))
        {
            var page = (await Api.GetAsync<CrmPage<OpportunityDto>>($"/api/crm/opportunities?companyId={Id}&page={opportunityPage}&pageSize={ListSize}")).Value;
            opportunities = page?.Items ?? [];
            opportunityTotal = page?.TotalCount ?? 0;
        }
    }

    private async Task LoadActivitiesAsync()
    {
        if (Session.Can(CrmAccess.ActivitiesRead))
        {
            var page = (await Api.GetAsync<CrmPage<ActivityDto>>($"/api/crm/activities?timeline=crm.company:{Id}&page={activityPage}&pageSize={ListSize}")).Value;
            activities = page?.Items ?? [];
            activityTotal = page?.TotalCount ?? 0;
        }
    }

    private static bool IsOverdue(ActivityDto activity) =>
        activity.IsOverdue(DateTimeOffset.UtcNow);

    private static string? ActivityClass(ActivityDto activity) =>
        ActivityLabels.Css(activity);

    // Para birimleri ayrı ayrı gösterilir; hiçbir zaman toplanıp tek tutar yapılmaz.
    private static string Totals(IEnumerable<CurrencyTotal> totals) =>
        string.Join(" + ", totals.Select(t => CrmLabels.Amount(t.Amount, t.Currency)));

    private void CompanySaved(CompanyDto saved)
    {
        company = saved;
        editingCompany = false;
    }

    private void CompanyDeleted() => Navigation.NavigateTo("crm/firmalar");

    private void OpenActivity(ActivityDto? activity)
    {
        selectedActivity = activity;
        editingActivity = true;
    }

    private async Task ActivitySaved()
    {
        editingActivity = false;
        await Task.WhenAll(LoadActivitiesAsync(), LoadSummaryAsync());
    }

    private void OpenOpportunity(OpportunityDto? opportunity)
    {
        selectedOpportunity = opportunity;
        editingOpportunity = true;
    }

    private async Task OpportunitySaved()
    {
        editingOpportunity = false;
        await Task.WhenAll(LoadOpportunitiesAsync(), LoadSummaryAsync());
    }

    private async Task CompleteAsync(ActivityDto activity)
    {
        busy = true;
        var result = await Api.PostAsync<CompleteActivityResultDto>(
            $"/api/crm/activities/{activity.Id}/complete", new CompleteActivityRequest(activity.Version));
        busy = false;
        message = result.Error;
        await Task.WhenAll(LoadActivitiesAsync(), LoadSummaryAsync());
    }
}
