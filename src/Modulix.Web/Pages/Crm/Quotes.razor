@page "/crm/teklifler"
@inject ApiClient Api
@inject SessionState Session
@inject CrmLookups Lookups
@inject NavigationManager Navigation

<PageTitle>@Texts.Get("crm.quotes.title") · Modulix</PageTitle>

<AuthGate Module="@CrmAccess.ModuleKey" Permission="@CrmAccess.QuotesRead">
    <div class="page-header">
        <h1>@Texts.Get("crm.quotes.title")</h1>
        <div class="header-actions">
            <a class="btn btn-outline-secondary" href="crm/teklif-raporu">@Texts.Get("crm.quotes.report")</a>
        </div>
    </div>

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }

    @* Görünümler sunucuda süzgeç olarak uygulanır; kapsamı sunucu uygular (kimse yetkisi dışındaki teklifi listeleyemez). *@
    <ViewTabs Items="ViewOptions" Value="@view" ValueChanged="ChooseViewAsync" Label="@Texts.Get("crm.quotes.viewsLabel")" NewView="StartNaming" />

    <div class="list-toolbar">
        <form class="search" @onsubmit="() => LoadAsync(1)" @onsubmit:preventDefault>
            <label class="visually-hidden" for="quote-search">@Texts.Get("crm.quotes.searchLabel")</label>
            <input id="quote-search" class="form-control" type="search" placeholder="@Texts.Get("crm.quotes.searchPlaceholder")" @bind="search" />
        </form>
        <GridColumnPicker State="grid" Changed="ColumnsChanged" />
        @if (Session.Can(CrmAccess.QuotesWrite))
        {
            <a class="btn btn-primary" href="crm/teklifler/yeni"><AppIcon Name="plus" Size="16" /> @Texts.Get("crm.quotes.new")</a>
        }
    </div>
    <div class="filters" role="group" aria-label="@Texts.Get("crm.quotes.filtersLabel")">
        <button type="button" class="chip @(latestOnly ? "active" : null)" aria-pressed="@(latestOnly ? "true" : "false")" @onclick="ToggleLatestAsync">@Texts.Get("crm.quotes.latestOnly")</button>
    </div>

    <PersonalViewBar Active="Active" Dirty="grid.Differs(Active) || FiltersDiffer" Naming="views.Naming" NamingChanged="views.StartNaming" Error="@views.Error"
                     SaveAs="SaveAsAsync" UpdateView="UpdateViewAsync" DiscardChanges="DiscardAsync" DeleteView="DeleteViewAsync" />

    @if (page is null)
    {
        <p class="text-muted">@Texts.Get("common.loading")</p>
    }
    else if (page.Items.Count == 0)
    {
        <p class="text-muted">@Texts.Get("crm.quotes.empty")</p>
    }
    else
    {
        <table class="table record-table">
            <caption class="visually-hidden">@Texts.Get("crm.quotes.caption")</caption>
            <thead>
                <tr>
                    @foreach (var column in grid.VisibleColumns)
                    {
                        <GridHeader Column="column" State="grid" SortChanged="SortAsync" Class="@(column.Key == "total" ? "text-end" : null)" />
                    }
                    <th scope="col" class="row-menu-cell"><span class="visually-hidden">@Texts.Get("common.actions")</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var quote in page.Items)
                {
                    <tr>
                        @foreach (var column in grid.VisibleColumns)
                        {
                            @Cell(column, quote)
                        }
                        <td class="row-menu-cell">
                            <RowMenu Label="@Texts.Get("common.rowActionsOf", quote.Title)">
                                <a class="view-menu-item" role="menuitem" href="crm/teklifler/@quote.Id"><AppIcon Name="eye" Size="16" /> <span>@Texts.Get("common.open")</span></a>
                            </RowMenu>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager PageSizeChoice="true" Page="page.Page" PageSize="page.PageSize" TotalCount="page.TotalCount" PageChanged="LoadAsync" />
    }
</AuthGate>

@code {
    private const string AllView = "all";
    private const string MineView = "mine";
    private const string PendingView = "pending";
    private const string ExpiringView = "expiring";
    private const string StatusPrefix = "status:";

    // Varsayılan sıra son oluşturulan teklif ("-createdAt"). Müşteri ve Sorumlu sütunları sunucuda sıralanamaz (adları firma/üyelik tablosundadır).
    private static GridColumnDef[] Columns =>
    [
        new("title", Texts.Get("crm.quotes.col.title"), "type", "title", "-title", Locked: true),
        new("company", Texts.Get("crm.quotes.col.company"), "building"),
        new("status", Texts.Get("common.field.status"), "tag", "status", "-status"),
        new("approval", Texts.Get("crm.quotes.col.approval"), "check-circle", "approvalStatus", "-approvalStatus"),
        new("total", Texts.Get("crm.quotes.col.total"), "coins", "grossTotal", "-grossTotal"),
        new("validUntil", Texts.Get("crm.quotes.col.validUntil"), "calendar", "validUntil", "-validUntil"),
        new("owner", Texts.Get("common.field.owner"), "user"),
        new("number", Texts.Get("crm.quotes.col.number"), "hash", "number", "-number", DefaultVisible: false),
        new("issueDate", Texts.Get("crm.quotes.col.issueDate"), "calendar", "issueDate", "-issueDate", DefaultVisible: false),
    ];

    // Görünüm sekmeleri yalnızca süzgeçtir.
    private static IReadOnlyList<ViewOption> SystemViews =>
    [
        new(AllView, Texts.Get("crm.quotes.view.all"), Icon: "file-text"),
        new(MineView, Texts.Get("crm.quotes.view.mine"), Icon: "star"),
        new(PendingView, Texts.Get("crm.quotes.view.pending"), Icon: "hourglass"),
        new(ExpiringView, Texts.Get("crm.quotes.view.expiring"), Icon: "clock"),
        new(StatusPrefix + "Draft", Texts.Get("crm.quotes.view.draft"), Icon: "tag"),
        new(StatusPrefix + "Presented", Texts.Get("crm.quotes.view.presented"), Icon: "tag"),
        new(StatusPrefix + "Accepted", Texts.Get("crm.quotes.view.accepted"), Icon: "tag"),
        new(StatusPrefix + "Rejected", Texts.Get("crm.quotes.view.rejected"), Icon: "tag"),
        new(StatusPrefix + "Expired", Texts.Get("crm.quotes.view.expired"), Icon: "tag"),
        new(StatusPrefix + "Cancelled", Texts.Get("crm.quotes.view.cancelled"), Icon: "tag"),
    ];

    private readonly GridViewState grid = new("crm.quotes", "-createdAt");
    private PersonalGridViews views = default!;
    private CrmPage<QuoteDto>? page;
    private string? message;
    private string view = AllView;
    private string search = string.Empty;

    // Süzgeç durumu (görünümle birlikte kaydedilir): sorumlu, onay, durum, "süresi yaklaşan", son revizyonlar.
    private bool mine;
    private bool pending;
    private bool expiring;
    private string? status;
    private bool latestOnly = true;

    protected override async Task OnInitializedAsync()
    {
        views = new PersonalGridViews(Api, "crm.quotes");
        grid.Define(Columns);
        await Session.EnsureLoadedAsync();
        if (Session.Can(CrmAccess.QuotesRead))
        {
            await Lookups.LoadAsync();
            await views.LoadAsync();
            await LoadAsync(1);
        }
    }

    private IReadOnlyList<ViewOption> ViewOptions => [.. SystemViews, .. views.Options];

    private GridViewDto? Active => views.Find(view);

    // Süzgeç metni kanonik sıradadır; açık görünümün süzgeciyle karşılaştırılarak kaydedilmemiş değişiklik bulunur.
    private string? CurrentFilters => GridFilters.Build(
        mine ? ("ownerId", "me") : null,
        pending ? ("approvalStatus", "Pending") : null,
        status is { } s ? ("status", s) : null,
        expiring ? ("expiring", "7") : null,
        latestOnly ? ("latestOnly", "true") : null);

    private string? BaselineFilters => Active is { } saved ? saved.Filters : TabFilters(view);

    private bool FiltersDiffer => (CurrentFilters ?? string.Empty) != (BaselineFilters ?? string.Empty);

    // Sistem sekmesinin süzgeci ("Yalnızca son revizyonlar" varsayılan açıktır).
    private static string? TabFilters(string key) => key switch
    {
        MineView => GridFilters.Build(("ownerId", "me"), ("latestOnly", "true")),
        PendingView => GridFilters.Build(("approvalStatus", "Pending"), ("latestOnly", "true")),
        ExpiringView => GridFilters.Build(("status", "Presented"), ("expiring", "7"), ("latestOnly", "true")),
        _ when key.StartsWith(StatusPrefix, StringComparison.Ordinal) => GridFilters.Build(("status", key[StatusPrefix.Length..]), ("latestOnly", "true")),
        _ => GridFilters.Build(("latestOnly", "true")),
    };

    private void ApplyFilters(string? filters)
    {
        var parsed = GridFilters.Parse(filters);
        mine = parsed.GetValueOrDefault("ownerId") == "me";
        pending = parsed.GetValueOrDefault("approvalStatus") == "Pending";
        status = parsed.GetValueOrDefault("status");
        expiring = parsed.ContainsKey("expiring");
        latestOnly = parsed.GetValueOrDefault("latestOnly") == "true";
    }

    // Görünüm değişince sayfalama başa döner; arama metni korunur.
    private async Task ChooseViewAsync(string key)
    {
        view = key;
        views.StartNaming(false);
        if (Active is { } saved)
        {
            grid.Apply(saved);
            ApplyFilters(saved.Filters);
        }
        else
        {
            grid.Reset();
            ApplyFilters(TabFilters(key));
        }

        await LoadAsync(1);
    }

    private async Task SortAsync(string key)
    {
        grid.Sort = key;
        await LoadAsync(1);
    }

    // Sütun seçimi/sırası değişince veri yeniden çekilmez; geri çağrı yalnızca sayfanın yeniden çizilmesini sağlar.
    private Task ColumnsChanged() => Task.CompletedTask;

    private void StartNaming() => views.StartNaming(true);

    private async Task SaveAsAsync(string name)
    {
        if (await views.SaveAsAsync(grid.ToRequest(name, CurrentFilters)) is { } key)
        {
            view = key;
        }
    }

    private async Task UpdateViewAsync()
    {
        if (Active is { } current)
        {
            await views.UpdateAsync(current, grid.ToRequest(current.Name, CurrentFilters));
        }
    }

    private async Task DiscardAsync() => await ChooseViewAsync(view);

    private async Task DeleteViewAsync()
    {
        if (Active is { } current && await views.DeleteAsync(current))
        {
            await ChooseViewAsync(AllView);
        }
    }

    private async Task LoadAsync(int pageNumber)
    {
        var url = $"/api/crm/quotes?page={pageNumber}&pageSize={ListPaging.Size}";
        if (!string.IsNullOrWhiteSpace(search)) { url += $"&search={Uri.EscapeDataString(search.Trim())}"; }

        if (grid.Sort != grid.DefaultSort) { url += $"&sort={Uri.EscapeDataString(grid.Sort)}"; }

        if (mine) { url += "&ownerId=me"; }

        if (pending) { url += "&approvalStatus=Pending"; }

        if (status is { } s) { url += $"&status={Uri.EscapeDataString(s)}"; }

        // Sunulmuş ve önümüzdeki 7 gün içinde (bugün dahil) sona erenler.
        if (expiring) { url += $"&validFrom={DateTime.UtcNow:yyyy-MM-dd}&validTo={DateTime.UtcNow.AddDays(7):yyyy-MM-dd}"; }

        if (latestOnly) { url += "&latestOnly=true"; }

        var result = await Api.GetAsync<CrmPage<QuoteDto>>(url);
        page = result.Value;
        message = result.Error;
    }

    private Task ToggleLatestAsync() { latestOnly = !latestOnly; return LoadAsync(1); }

    private RenderFragment Cell(GridColumnDef column, QuoteDto quote) => @<td data-label="@column.Label" class="@CellClass(column.Key)">@CellContent(column.Key, quote)</td>;

    private static string? CellClass(string key) => key switch
    {
        "title" => "primary",
        "total" => "text-end",
        _ => null,
    };

    private RenderFragment CellContent(string key, QuoteDto quote) => key switch
    {
        "title" => @<text><a href="crm/teklifler/@quote.Id">@quote.Title</a> <small class="text-muted">@quote.QuoteNumber · V@(quote.RevisionNo)</small></text>,
        "company" => @<a href="crm/firmalar/@quote.CompanyId">@Lookups.CompanyName(quote.CompanyId)</a>,
        "status" => @<text><span class="badge stage-@QuoteLabels.StatusBadge(quote.Status)">@QuoteLabels.Label(QuoteLabels.Statuses, quote.Status)</span> @(IsExpiringSoon(quote) ? ExpiringBadge : null) @(IsOverdue(quote) ? OverdueBadge : null)</text>,
        "approval" => @<span class="badge stage-@QuoteLabels.ApprovalBadge(quote.ApprovalStatus)">@QuoteLabels.Label(QuoteLabels.Approvals, quote.ApprovalStatus)</span>,
        "total" => @<text>@QuoteLabels.Money(quote.GrossTotal, quote.Currency)</text>,
        "validUntil" => @<text>@(quote.ValidUntil is { } until ? CrmLabels.Time(until) : "—")</text>,
        "owner" => @<OwnerCell Name="@Lookups.MemberName(quote.OwnerId)" />,
        "number" => @<text>@quote.QuoteNumber</text>,
        "issueDate" => @<text>@quote.IssueDate.ToString("yyyy-MM-dd")</text>,
        _ => @<text></text>,
    };

    private static RenderFragment ExpiringBadge => @<span class="badge stage-onhold">@Texts.Get("crm.quotes.expiringSoon")</span>;

    private static RenderFragment OverdueBadge => @<span class="badge stage-cancelled">@Texts.Get("crm.quotes.overdue")</span>;

    private static bool IsExpiringSoon(QuoteDto q) =>
        q.Status == "Presented" && q.ValidUntil is { } until && until > DateTimeOffset.UtcNow && until <= DateTimeOffset.UtcNow.AddDays(7);

    private static bool IsOverdue(QuoteDto q) => q.Status == "Presented" && q.ValidUntil is { } until && until <= DateTimeOffset.UtcNow;
}
