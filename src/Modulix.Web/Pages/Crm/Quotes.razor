@page "/crm/teklifler"
@inject ApiClient Api
@inject SessionState Session
@inject CrmLookups Lookups
@inject NavigationManager Navigation

<PageTitle>Teklifler · Modulix</PageTitle>

<AuthGate Module="@CrmAccess.ModuleKey" Permission="@CrmAccess.QuotesRead">
    <div class="page-header">
        <h1>Teklifler</h1>
        <div class="header-actions">
            <a class="btn btn-outline-secondary" href="crm/teklif-raporu">Rapor</a>
        </div>
    </div>

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }

    <div class="list-toolbar">
        <ViewSelector Items="ViewOptions" Value="@current" ValueChanged="SelectAsync" />
        <form class="search" @onsubmit="() => LoadAsync(1)" @onsubmit:preventDefault>
            <label class="visually-hidden" for="quote-search">Teklif ara</label>
            <input id="quote-search" class="form-control" type="search" placeholder="Başlık veya teklif no ara" @bind="search" />
            <button type="submit" class="btn btn-outline-secondary">Ara</button>
        </form>
        <ColumnPicker />
        @if (Session.Can(CrmAccess.QuotesWrite))
        {
            <a class="btn btn-primary" href="crm/teklifler/yeni"><AppIcon Name="plus" Size="16" /> Yeni teklif</a>
        }
    </div>
    <div class="filters" role="group" aria-label="Süzgeçler">
        <button type="button" class="chip @(latestOnly ? "active" : null)" aria-pressed="@(latestOnly ? "true" : "false")" @onclick="ToggleLatestAsync">Yalnızca son revizyonlar</button>
    </div>

    @if (page is null)
    {
        <p class="text-muted">Yükleniyor…</p>
    }
    else if (page.Items.Count == 0)
    {
        <p class="text-muted">Bu görünümde teklif yok.</p>
    }
    else
    {
        <table class="table record-table">
            <caption class="visually-hidden">Teklif listesi</caption>
            <thead>
                <tr>
                    <th scope="col">Teklif</th><th scope="col">Müşteri</th><th scope="col">Durum</th><th scope="col">Onay</th><th scope="col" class="text-end">Toplam</th><th scope="col">Geçerlilik</th><th scope="col">Sorumlu</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var quote in page.Items)
                {
                    <tr>
                        <td data-label="Teklif" class="primary">
                            <a href="crm/teklifler/@quote.Id">@quote.Title</a>
                            <small class="text-muted">@quote.QuoteNumber · V@(quote.RevisionNo)</small>
                        </td>
                        <td data-label="Müşteri"><a href="crm/firmalar/@quote.CompanyId">@Lookups.CompanyName(quote.CompanyId)</a></td>
                        <td data-label="Durum">
                            <span class="badge stage-@QuoteLabels.StatusBadge(quote.Status)">@QuoteLabels.Label(QuoteLabels.Statuses, quote.Status)</span>
                            @if (IsExpiringSoon(quote)) { <span class="badge stage-onhold">Süresi yaklaşıyor</span> }
                            @if (IsOverdue(quote)) { <span class="badge stage-cancelled">Süresi geçti</span> }
                        </td>
                        <td data-label="Onay"><span class="badge stage-@QuoteLabels.ApprovalBadge(quote.ApprovalStatus)">@QuoteLabels.Label(QuoteLabels.Approvals, quote.ApprovalStatus)</span></td>
                        <td data-label="Toplam" class="text-end">@QuoteLabels.Money(quote.GrossTotal, quote.Currency)</td>
                        <td data-label="Geçerlilik">@(quote.ValidUntil is { } until ? CrmLabels.Time(until) : "—")</td>
                        <td data-label="Sorumlu"><OwnerCell Name="@Lookups.MemberName(quote.OwnerId)" /></td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager PageSizeChoice="true" Page="page.Page" PageSize="page.PageSize" TotalCount="page.TotalCount" PageChanged="LoadAsync" />
    }
</AuthGate>

@code {
    // Görünümler yalnızca süzgeçtir; kapsamı sunucu uygular (kimse yetkisi dışındaki teklifi listeleyemez).
    private static readonly IReadOnlyList<ViewOption> ViewOptions =
    [
        new("all", "Tüm teklifler"),
        new("mine", "Tekliflerim"),
        new("pending", "Onay bekleyenler"),
        new("expiring", "Süresi yaklaşanlar (7 gün)"),
        new("status:Draft", "Taslaklar", "Duruma göre"),
        new("status:Presented", "Gönderilenler", "Duruma göre"),
        new("status:Accepted", "Kabul edilenler", "Duruma göre"),
        new("status:Rejected", "Reddedilenler", "Duruma göre"),
        new("status:Expired", "Süresi dolanlar", "Duruma göre"),
        new("status:Cancelled", "İptal edilenler", "Duruma göre"),
    ];

    private CrmPage<QuoteDto>? page;
    private string? message;
    private string current = "all";
    private string search = string.Empty;
    private bool latestOnly = true;

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (Session.Can(CrmAccess.QuotesRead))
        {
            await Lookups.LoadAsync();
            await LoadAsync(1);
        }
    }

    private async Task LoadAsync(int pageNumber)
    {
        var url = $"/api/crm/quotes?page={pageNumber}&pageSize={ListPaging.Size}";
        if (!string.IsNullOrWhiteSpace(search)) { url += $"&search={Uri.EscapeDataString(search.Trim())}"; }

        switch (current)
        {
            case "mine":
                url += "&ownerId=me";
                break;
            case "pending":
                url += "&approvalStatus=Pending";
                break;
            case "expiring":
                // Sunulmuş ve önümüzdeki 7 gün içinde (bugün dahil) sona erenler.
                url += $"&status=Presented&validFrom={DateTime.UtcNow:yyyy-MM-dd}&validTo={DateTime.UtcNow.AddDays(7):yyyy-MM-dd}";
                break;
            case var view when view.StartsWith("status:", StringComparison.Ordinal):
                url += $"&status={Uri.EscapeDataString(view["status:".Length..])}";
                break;
        }

        if (latestOnly) { url += "&latestOnly=true"; }

        var result = await Api.GetAsync<CrmPage<QuoteDto>>(url);
        page = result.Value;
        message = result.Error;
    }

    // Görünüm değişince sayfalama başa döner; arama metni ve "son revizyonlar" süzgeci korunur.
    private Task SelectAsync(string view)
    {
        current = view;
        return LoadAsync(1);
    }

    private Task ToggleLatestAsync() { latestOnly = !latestOnly; return LoadAsync(1); }

    private static bool IsExpiringSoon(QuoteDto q) =>
        q.Status == "Presented" && q.ValidUntil is { } until && until > DateTimeOffset.UtcNow && until <= DateTimeOffset.UtcNow.AddDays(7);

    private static bool IsOverdue(QuoteDto q) => q.Status == "Presented" && q.ValidUntil is { } until && until <= DateTimeOffset.UtcNow;
}
