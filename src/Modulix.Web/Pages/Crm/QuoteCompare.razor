@page "/crm/teklifler/{Id:guid}/karsilastir"
@inject ApiClient Api
@inject SessionState Session
@inject NavigationManager Navigation

<PageTitle>@Texts.Get("crm.quoteCompare.title") · Modulix</PageTitle>

<AuthGate Module="@CrmAccess.ModuleKey" Permission="@CrmAccess.QuotesRead">
    @if (notFound)
    {
        <div class="alert alert-warning" role="alert">@Texts.Get("crm.quoteCompare.notFound") <a href="crm/teklifler">@Texts.Get("crm.quoteCompare.backToList")</a></div>
    }
    else if (quote is null)
    {
        <LoadingState />
    }
    else
    {
        <div class="page-header">
            <div>
                <h1>@Texts.Get("crm.quoteCompare.title")</h1>
                <p class="text-muted mb-0">@quote.Title · @quote.QuoteNumber</p>
            </div>
            <div class="header-actions">
                <a class="btn btn-outline-secondary" href="crm/teklifler/@quote.Id">@Texts.Get("crm.quoteCompare.backToQuote")</a>
            </div>
        </div>

        @if (others.Count == 0)
        {
            <p class="text-muted">@Texts.Get("crm.quoteCompare.noOthers")</p>
        }
        else
        {
            <div class="filters">
                <label class="form-label" for="cmp-with">@Texts.Get("crm.quoteCompare.with")</label>
                <select id="cmp-with" class="form-select filter-select" value="@withId" @onchange="OnWithChanged">
                    @foreach (var other in others)
                    {
                        <option value="@other.Id">V@(other.RevisionNo) — @QuoteLabels.Label(QuoteLabels.Statuses, other.Status)</option>
                    }
                </select>
                <span class="text-muted">@Texts.Get("crm.quoteCompare.thisPage", quote.RevisionNo)</span>
            </div>

            <Notice Text="@message" Failed="true" />

            @if (comparison is not null)
            {
                <p class="text-muted">
                    @Texts.Strong("crm.quoteCompare.intro",
                        $"V{comparison.LeftRevision} ({QuoteLabels.Label(QuoteLabels.Statuses, comparison.LeftStatus)})",
                        $"V{comparison.RightRevision} ({QuoteLabels.Label(QuoteLabels.Statuses, comparison.RightStatus)})")
                </p>

                <section aria-labelledby="cmp-totals">
                    <h2 id="cmp-totals">@Texts.Get("crm.quoteCompare.totals")</h2>
                    @Changes(comparison.Totals, Texts.Get("crm.quoteCompare.totalsNone"))
                </section>

                <section aria-labelledby="cmp-header">
                    <h2 id="cmp-header">@Texts.Get("crm.quoteCompare.header")</h2>
                    @Changes(comparison.Header, Texts.Get("crm.quoteCompare.headerNone"))
                </section>

                <section aria-labelledby="cmp-lines">
                    <h2 id="cmp-lines">@Texts.Get("crm.quoteCompare.lines")</h2>
                    <p class="small text-muted">@Texts.Get("crm.quoteCompare.linesHelp")</p>
                    @if (comparison.Lines.Count == 0)
                    {
                        <p class="text-muted">@Texts.Get("crm.quoteCompare.noLines")</p>
                    }
                    else
                    {
                        <ul class="compare-lines">
                            @foreach (var line in comparison.Lines)
                            {
                                <li class="compare-line compare-@line.Change.ToLowerInvariant()">
                                    <span class="badge stage-@Badge(line.Change)">@ChangeLabel(line.Change)</span>
                                    <strong>@line.Name</strong>
                                    @if (line.Fields.Count > 0)
                                    {
                                        <ul class="small">
                                            @foreach (var field in line.Fields)
                                            {
                                                <li>@field.Label: @Value(field.Before) → @Value(field.After)</li>
                                            }
                                        </ul>
                                    }
                                </li>
                            }
                        </ul>
                    }
                </section>
            }
        }
    }
</AuthGate>

@code {
    [Parameter] public Guid Id { get; set; }

    private QuoteDto? quote;
    private List<QuoteDto> others = [];
    private QuoteComparisonDto? comparison;
    private Guid withId;
    private string? message;
    private bool notFound;

    protected override async Task OnParametersSetAsync()
    {
        await Session.EnsureLoadedAsync();
        if (!Session.Can(CrmAccess.QuotesRead))
        {
            return;
        }

        var loaded = (await Api.GetAsync<QuoteDto>($"/api/crm/quotes/{Id}")).Value;
        if (loaded is null)
        {
            notFound = true;
            return;
        }

        quote = loaded;
        var family = (await Api.GetAllAsync<QuoteDto>($"/api/crm/quotes?familyId={loaded.FamilyId}")).Items;
        others = [.. family.Where(q => q.Id != loaded.Id).OrderByDescending(q => q.RevisionNo)];

        // Varsayılan: bundan önceki en yakın revizyon; yoksa en yenisi.
        var query = System.Web.HttpUtility.ParseQueryString(new Uri(Navigation.Uri).Query);
        var requested = Guid.TryParse(query["with"], out var parsed) ? parsed : (Guid?)null;
        withId = others.FirstOrDefault(o => o.Id == requested)?.Id
            ?? others.FirstOrDefault(o => o.RevisionNo < loaded.RevisionNo)?.Id
            ?? others.FirstOrDefault()?.Id ?? Guid.Empty;
        await CompareAsync();
    }

    private async Task OnWithChanged(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var chosen))
        {
            withId = chosen;
            await CompareAsync();
        }
    }

    private async Task CompareAsync()
    {
        comparison = null;
        message = null;
        if (withId == Guid.Empty)
        {
            return;
        }

        var result = await Api.GetAsync<QuoteComparisonDto>($"/api/crm/quotes/{Id}/compare?with={withId}");
        comparison = result.Value;
        message = result.Error;
    }

    private RenderFragment Changes(IReadOnlyList<QuoteFieldChangeDto> changes, string empty) => builder =>
    {
        if (changes.Count == 0)
        {
            builder.OpenElement(0, "p");
            builder.AddAttribute(1, "class", "text-muted");
            builder.AddContent(2, empty);
            builder.CloseElement();
            return;
        }

        builder.OpenElement(3, "table");
        builder.AddAttribute(4, "class", "table record-table");
        builder.AddMarkupContent(19, "<caption class=\"visually-hidden\">" + System.Net.WebUtility.HtmlEncode(Texts.Get("crm.quoteCompare.caption")) + "</caption>");
        builder.OpenElement(5, "thead");
        builder.AddMarkupContent(6, "<tr><th scope=\"col\">" + System.Net.WebUtility.HtmlEncode(Texts.Get("crm.quoteCompare.col.field")) + "</th><th scope=\"col\">" + System.Net.WebUtility.HtmlEncode(Texts.Get("crm.quoteCompare.col.before")) + "</th><th scope=\"col\">" + System.Net.WebUtility.HtmlEncode(Texts.Get("crm.quoteCompare.col.after")) + "</th></tr>");
        builder.CloseElement();
        builder.OpenElement(7, "tbody");
        foreach (var change in changes)
        {
            builder.OpenElement(8, "tr");
            builder.OpenElement(9, "td");
            builder.AddAttribute(10, "data-label", Texts.Get("crm.quoteCompare.col.field"));
            builder.AddAttribute(11, "class", "primary");
            builder.AddContent(12, change.Label);
            builder.CloseElement();
            builder.OpenElement(13, "td");
            builder.AddAttribute(14, "data-label", Texts.Get("crm.quoteCompare.col.before"));
            builder.AddContent(15, Value(change.Before));
            builder.CloseElement();
            builder.OpenElement(16, "td");
            builder.AddAttribute(17, "data-label", Texts.Get("crm.quoteCompare.col.after"));
            builder.AddContent(18, Value(change.After));
            builder.CloseElement();
            builder.CloseElement();
        }

        builder.CloseElement();
        builder.CloseElement();
    };

    private static string Value(string? value) => string.IsNullOrEmpty(value) ? "—" : value;

    // Durum her zaman metinle de gösterilir (yalnızca renkle ifade edilmez).
    private static string ChangeLabel(string change) => change switch
    {
        "Added" => Texts.Get("crm.quoteCompare.change.added"),
        "Removed" => Texts.Get("crm.quoteCompare.change.removed"),
        "Changed" => Texts.Get("crm.quoteCompare.change.changed"),
        _ => Texts.Get("crm.quoteCompare.change.same"),
    };

    private static string Badge(string change) => change switch
    {
        "Added" => "won",
        "Removed" => "lost",
        "Changed" => "onhold",
        _ => "open",
    };
}
