@page "/crm/teklif-kurallari"
@inject ApiClient Api
@inject SessionState Session
@inject CrmLookups Lookups

<PageTitle>@Texts.Get("crm.quoteRules.title") · Modulix</PageTitle>

<AuthGate Module="@CrmAccess.ModuleKey" Permission="@CrmAccess.QuoteRulesManage">
    <div class="page-header">
        <h1>@Texts.Get("crm.quoteRules.title")</h1>
        @if (form is null)
        {
            <button type="button" class="btn btn-primary" @onclick="NewRule">@Texts.Get("crm.quoteRules.new")</button>
        }
    </div>

    <p class="text-muted">
        @Texts.Strong("crm.quoteRules.intro1", Texts.Get("crm.quoteRules.introAll"), Texts.Get("crm.quoteRules.introAny"))
        @Texts.Get("crm.quoteRules.intro2")
    </p>

    <Notice Text="@message" Failed="@(failed)" />

    @if (form is not null)
    {
        <form class="record-form" novalidate @onsubmit="SaveAsync" @onsubmit:preventDefault>
            <h2>@(form.Id is null ? Texts.Get("crm.quoteRules.new") : Texts.Get("crm.quoteRules.edit"))</h2>
            <FormTabs Title="@Texts.Get("crm.quoteRules.info")" Label="@Texts.Get("crm.quoteRules.formSections")">
            <div class="form-grid">
                <div>
                    <label class="form-label" for="r-name">@Texts.Get("common.field.nameRequired")</label>
                    <input id="r-name" class="form-control" maxlength="150" @bind="form.Name" />
                    <FieldError Field="name" Errors="errors" />
                </div>
                <div>
                    <label class="form-label" for="r-step">@Texts.Get("crm.quoteRules.field.step")</label>
                    <input id="r-step" class="form-control" type="number" min="1" max="9" @bind="form.Step" />
                    <FieldError Field="step" Errors="errors" />
                    <div class="form-text">@Texts.Get("crm.quoteRules.field.stepHelp")</div>
                </div>
                <div>
                    <label class="form-label" for="r-priority">@Texts.Get("crm.quoteRules.field.priority")</label>
                    <input id="r-priority" class="form-control" type="number" min="0" @bind="form.Priority" />
                    <FieldError Field="priority" Errors="errors" />
                </div>
                <div>
                    <label class="form-label" for="r-discount">@Texts.Get("crm.quoteRules.field.discount")</label>
                    <input id="r-discount" class="form-control" type="number" step="any" min="0" max="99.99" @bind="form.MinDiscountPercent" />
                    <FieldError Field="minDiscountPercent" Errors="errors" />
                </div>
                <div>
                    <label class="form-label" for="r-gross">@Texts.Get("crm.quoteRules.field.gross")</label>
                    <input id="r-gross" class="form-control" type="number" step="0.01" min="0" @bind="form.MinGrossTotal" />
                    <FieldError Field="minGrossTotal" Errors="errors" />
                </div>
                <div>
                    <label class="form-label" for="r-currency">@Texts.Get("crm.quoteRules.field.currency")</label>
                    <input id="r-currency" class="form-control" maxlength="3" placeholder="@Texts.Get("crm.quoteRules.field.currencyAll")" @bind="form.Currency" />
                    <FieldError Field="currency" Errors="errors" />
                </div>
                <div>
                    <label class="form-label" for="approverId">@Texts.Get("crm.quoteRules.field.approver")</label>
                    <LookupPicker Id="approverId" LookupKey="crm.quote-approval-rule.approver" @bind-Value="form.ApproverId" Placeholder="@Texts.Get("crm.quoteRules.anyApprover")"
                                  Invalid="@(errors?.ContainsKey("approverId") == true)" />
                    <FieldError Field="approverId" Errors="errors" />
                </div>
                <div class="form-check">
                    <input id="r-active" class="form-check-input" type="checkbox" @bind="form.IsActive" />
                    <label class="form-check-label" for="r-active">@Texts.Get("crm.quoteRules.field.active")</label>
                </div>
                <div class="wide">
                    <label class="form-label" for="r-description">@Texts.Get("crm.products.field.description")</label>
                    <textarea id="r-description" class="form-control" rows="2" maxlength="500" @bind="form.Description"></textarea>
                </div>
            </div>
            </FormTabs>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary" disabled="@busy">@Texts.Get("common.save")</button>
                <button type="button" class="btn btn-outline-secondary" @onclick="Cancel">@Texts.Get("common.dismiss")</button>
                @if (form.Id is not null)
                {
                    <button type="button" class="btn btn-outline-danger ms-auto" disabled="@busy" @onclick="DeleteAsync">@Texts.Get("common.delete")</button>
                }
            </div>
        </form>
    }

    @if (rules is null)
    {
        <LoadingState Kind="LoadingKind.Table" />
    }
    else if (rules.Count == 0)
    {
        <EmptyState Title="@Texts.Get("crm.quoteRules.none")" />
    }
    else
    {
        <table class="table record-table">
            <caption class="visually-hidden">@Texts.Get("crm.quoteRules.title")</caption>
            <thead><tr><th scope="col">@Texts.Get("crm.quoteRules.col.rule")</th><th scope="col">@Texts.Get("crm.quoteRules.col.step")</th><th scope="col">@Texts.Get("crm.quoteRules.col.conditionsAll")</th><th scope="col">@Texts.Get("crm.quoteRules.col.approver")</th><th scope="col">@Texts.Get("common.field.status")</th><th scope="col"></th></tr></thead>
            <tbody>
                @foreach (var rule in rules)
                {
                    <tr>
                        <td data-label="@Texts.Get("crm.quoteRules.col.rule")" class="primary">@rule.Name <small class="text-muted">@Texts.Get("crm.quoteRules.priorityVersion", rule.Priority, rule.Version)</small>
                            @if (!string.IsNullOrWhiteSpace(rule.Description)) { <div class="small text-muted">@rule.Description</div> }</td>
                        <td data-label="@Texts.Get("crm.quoteRules.col.step")">@rule.Step</td>
                        <td data-label="@Texts.Get("crm.quoteRules.col.conditions")">@Conditions(rule)</td>
                        <td data-label="@Texts.Get("crm.quoteRules.col.approver")">@(rule.ApproverId is null ? Texts.Get("crm.quoteRules.anyApprover") : Lookups.MemberName(rule.ApproverId))</td>
                        <td data-label="@Texts.Get("common.field.status")">@(rule.IsActive ? Texts.Get("crm.quoteRules.active") : Texts.Get("common.inactive"))</td>
                        <td class="actions">
                            <button type="button" class="btn btn-outline-primary btn-sm" @onclick="() => Edit(rule)">@Texts.Get("common.edit")</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</AuthGate>

@code {
    private const string Url = "/api/crm/quote-approval-rules";

    private List<QuoteApprovalRuleDto>? rules;
    private RuleForm? form;
    private IReadOnlyDictionary<string, string[]>? errors;
    private string? message;
    private bool failed;
    private bool busy;

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (Session.Can(CrmAccess.QuoteRulesManage))
        {
            await Lookups.LoadAsync();
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        var (loaded, error) = await Api.GetAllAsync<QuoteApprovalRuleDto>(Url);
        rules = loaded;
        Notify(error, error is not null);
    }

    private static string Conditions(QuoteApprovalRuleDto rule)
    {
        var parts = new List<string>();
        if (rule.MinDiscountPercent is { } percent)
        {
            parts.Add(Texts.Get("crm.quoteRules.cond.discount", percent.ToString("0.##")));
        }

        if (rule.MinGrossTotal is { } gross)
        {
            parts.Add(Texts.Get("crm.quoteRules.cond.gross", gross.ToString("N2"), rule.Currency ?? Texts.Get("crm.quoteRules.anyCurrency")));
        }

        return parts.Count == 2 ? Texts.Get("crm.quoteRules.cond.both", parts[0], parts[1]) : string.Join(string.Empty, parts);
    }

    private void NewRule()
    {
        form = new RuleForm();
        errors = null;
        Notify(null, false);
    }

    private void Edit(QuoteApprovalRuleDto rule)
    {
        form = new RuleForm
        {
            Id = rule.Id, Version = rule.Version, Name = rule.Name, Description = rule.Description, Priority = rule.Priority, IsActive = rule.IsActive,
            Currency = rule.Currency, MinDiscountPercent = rule.MinDiscountPercent, MinGrossTotal = rule.MinGrossTotal, ApproverId = rule.ApproverId, Step = rule.Step,
        };
        errors = null;
        Notify(null, false);
    }

    private void Cancel()
    {
        form = null;
        errors = null;
    }

    private async Task SaveAsync()
    {
        if (busy) { return; }
        busy = true;
        var f = form!;
        var request = new SaveQuoteApprovalRuleRequest(
            f.Name, Blank(f.Description), f.Priority, f.IsActive, Blank(f.Currency)?.ToUpperInvariant(), f.MinDiscountPercent, f.MinGrossTotal, f.ApproverId, f.Version, f.Step);
        var result = f.Id is { } id
            ? await Api.PutAsync<QuoteApprovalRuleDto>($"{Url}/{id}", request)
            : await Api.PostAsync<QuoteApprovalRuleDto>(Url, request);
        busy = false;
        if (result.IsSuccess)
        {
            form = null;
            errors = null;
            Notify(Texts.Get("crm.quoteRules.saved"), false);
            await LoadAsync();
            return;
        }

        errors = result.FieldErrors;
        Notify(result.Status == System.Net.HttpStatusCode.Conflict ? Texts.Get("crm.quoteDetail.conflictRetry", result.Error) : result.Error, true);
    }

    private async Task DeleteAsync()
    {
        if (busy) { return; }
        busy = true;
        var result = await Api.DeleteAsync($"{Url}/{form!.Id}?version={form.Version}");
        busy = false;
        Notify(result.IsSuccess ? Texts.Get("crm.quoteRules.deleted") : result.Error, !result.IsSuccess);
        if (result.IsSuccess)
        {
            form = null;
            await LoadAsync();
        }
    }

    private void Notify(string? text, bool isFailure)
    {
        message = text;
        failed = isFailure;
    }

    private static string? Blank(string? text) => string.IsNullOrWhiteSpace(text) ? null : text.Trim();

    private sealed class RuleForm
    {
        public Guid? Id { get; init; }

        public long? Version { get; init; }

        public string Name { get; set; } = string.Empty;

        public string? Description { get; set; }

        public int Priority { get; set; }

        public int Step { get; set; } = 1;

        public bool IsActive { get; set; } = true;

        public string? Currency { get; set; }

        public decimal? MinDiscountPercent { get; set; }

        public decimal? MinGrossTotal { get; set; }

        public Guid? ApproverId { get; set; }
    }
}
