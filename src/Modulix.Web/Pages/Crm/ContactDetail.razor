@page "/crm/kisiler/{Id:guid}"
@inject ApiClient Api
@inject SessionState Session
@inject CrmLookups Lookups

<PageTitle>@(contact is null ? Texts.Get("crm.contact.fallbackTitle") : $"{contact.FirstName} {contact.LastName}") · Modulix</PageTitle>

<AuthGate Module="@CrmAccess.ModuleKey" Permission="@CrmAccess.ContactsRead">
    <a class="back-link" href="crm/kisiler">← @Texts.Get("crm.contacts.title")</a>

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }

    @if (contact is null)
    {
        @if (message is null)
        {
            <p class="text-muted">@Texts.Get("common.loading")</p>
        }
    }
    else if (editing)
    {
        <ContactEditor Contact="contact" Lookups="Lookups" Saved="ContactSaved" Deleted="ContactDeleted" Cancelled="() => editing = false" />
    }
    else
    {
        <div class="page-header">
            <div class="page-heading">
                <span class="page-icon" aria-hidden="true"><AppIcon Name="user" Size="24" /></span>
                <div>
                    <h1>@contact.FirstName @contact.LastName</h1>
                    @if (contact.Title is not null || contact.CompanyId is not null)
                    {
                        <p class="page-subtitle">
                            @contact.Title
                            @if (contact.CompanyId is { } headerCompany)
                            {
                                <span>@(contact.Title is null ? null : " · ")<a href="crm/firmalar/@headerCompany">@Lookups.CompanyName(headerCompany)</a></span>
                            }
                        </p>
                    }
                    <div class="header-meta">
                        @if (activeLinks > 0) { <span class="badge status-customer">@Texts.Get("crm.contact.activeLinksBadge", activeLinks)</span> }
                    </div>
                </div>
            </div>
            <div class="header-actions">
                @if (Session.Can(CrmAccess.ContactsMerge))
                {
                    <a class="btn btn-outline-secondary" href="@($"crm/kisiler/{Id}/birlestir")">@Texts.Get("crm.contact.merge")</a>
                }
                @if (Session.Can(CrmAccess.ContactsWrite))
                {
                    <button type="button" class="btn btn-primary" @onclick="() => editing = true">@Texts.Get("common.edit")</button>
                }
            </div>
        </div>

        <div class="record-layout">
            <aside class="record-summary" aria-label="@Texts.Get("crm.contact.summary.aria")">
                <div class="summary-card">
                    <div class="summary-identity">
                        <span class="summary-avatar" aria-hidden="true">@Initials($"{contact.FirstName} {contact.LastName}")</span>
                        <strong class="summary-name">@contact.FirstName @contact.LastName</strong>
                        @if (contact.Title is { } title)
                        {
                            <span class="summary-sub">@title</span>
                        }
                    </div>

                    <dl class="summary-facts">
                        <div><dt>@Texts.Get("common.field.owner")</dt><dd>@Lookups.MemberName(contact.OwnerId)</dd></div>
                        @if (contact.CompanyId is { } primaryCompany)
                        {
                            <div><dt>@Texts.Get("crm.contact.primaryCompany")</dt><dd><a href="crm/firmalar/@primaryCompany">@Lookups.CompanyName(primaryCompany)</a></dd></div>
                        }
                        <div><dt>@Texts.Get("crm.contact.activeLinks")</dt><dd>@activeLinks</dd></div>
                    </dl>

                    @if (contact.Phone is not null || contact.Email is not null)
                    {
                        <h2 class="summary-heading">@Texts.Get("crm.company.contact")</h2>
                        <ul class="summary-contact">
                            @if (contact.Phone is { } phone)
                            {
                                <li><AppIcon Name="phone" Size="16" /><a href="tel:@phone">@phone</a></li>
                            }
                            @if (contact.Email is { } email)
                            {
                                <li><AppIcon Name="mail" Size="16" /><a href="mailto:@email">@email</a></li>
                            }
                        </ul>
                    }
                </div>
            </aside>

            <div class="record-main">
                <TabBar Tabs="ContactTabs" State="tabs" Label="@Texts.Get("crm.contact.tabs.aria")" Changed="_ => { }" />

                @if (tabs.Rendered(TabGeneral))
                {
                    <div role="tabpanel" id="tabpanel-@TabGeneral" aria-labelledby="tab-@TabGeneral" class="record-tabpanel" hidden="@tabs.Hidden(TabGeneral)">
                        <FormSection Title="@Texts.Get("crm.company.general")" Icon="info">
                        <dl class="detail-grid">
                            @if (contact.Notes is { } notes)
                            {
                                <div class="span-all"><dt>@Texts.Get("common.field.notes")</dt><dd class="notes">@notes</dd></div>
                            }
                            @foreach (var field in Lookups.FieldsOf(CrmEntityKeys.Contact))
                            {
                                var text = CustomFieldText.Format(field, contact.Custom);
                                @if (text.Length > 0)
                                {
                                    <div><dt>@field.Label</dt><dd>@text</dd></div>
                                }
                            }
                        </dl>
                        </FormSection>

                        <FormSection Title="@Texts.Get("crm.contact.contactInfo")" Icon="phone">
                            <ContactPointsSection ContactId="Id" Title="@Texts.Get("crm.contact.generalPhoneEmail")" CanWrite="Session.Can(CrmAccess.ContactsWrite)" Changed="ReloadContactAsync" />
                        </FormSection>
                    </div>
                }

                @if (tabs.Rendered(TabCompanies))
                {
                    <div role="tabpanel" id="tabpanel-@TabCompanies" aria-labelledby="tab-@TabCompanies" class="record-tabpanel" hidden="@tabs.Hidden(TabCompanies)">
                        <section class="detail-section">
                            <div class="section-header">
                                <h2>@Texts.Get("crm.contact.companies.title")</h2>
                            </div>
                            <p class="text-muted small">@Texts.Get("crm.contact.companies.help")</p>
                            @if (editingLink is not null)
                            {
                                <CompanyContactEditor CompanyId="editingLink.CompanyId" Link="editingLink" Lookups="Lookups" Saved="LinkSaved" Cancelled="() => editingLink = null" />
                            }
                            @if (links is { Count: > 0 })
                            {
                                <ul class="item-list">
                                    @foreach (var link in links)
                                    {
                                        <li class="@(link.IsActive ? null : "done")">
                                            <div class="item-main">
                                                <strong><a href="crm/firmalar/@link.CompanyId">@link.CompanyName</a></strong>
                                                <span>
                                                    @if (link.IsPrimary) { <span class="badge status-customer">@Texts.Get("crm.company.people.primary")</span><text> </text> }
                                                    @if (link.IsDecisionMaker) { <span class="badge tag">@Texts.Get("crm.company.people.decisionMaker")</span><text> </text> }
                                                    @link.JobTitle
                                                    @if (link.Department is { } department) { <text> · @department</text> }
                                                    @foreach (var role in link.Roles) { <span class="badge tag">@CrmRelationshipRoles.Labels.GetValueOrDefault(role, role)</span><text> </text> }
                                                    @if (link.StartDate is { } start) { <text> · @CrmLabels.Date(start)</text> }
                                                    @if (!link.IsActive && link.EndDate is { } end) { <text> – @Texts.Get("crm.company.people.ended", CrmLabels.Date(end))</text> }
                                                </span>
                                                @if (link.IsActive)
                                                {
                                                    <ContactPointsSection ContactId="Id" CompanyContactId="link.Id" Title="@Texts.Get("crm.contact.companies.contactFor", link.CompanyName)"
                                                                          CanWrite="Session.Can(CrmAccess.ContactsWrite)" />
                                                }
                                            </div>
                                            @if (Session.Can(CrmAccess.ContactsWrite))
                                            {
                                                <button type="button" class="btn btn-link btn-sm" @onclick="() => editingLink = link">@Texts.Get("common.edit")</button>
                                                @if (link.IsActive)
                                                {
                                                    <button type="button" class="btn btn-link btn-sm" disabled="@busy" @onclick="() => EndLinkAsync(link)">@Texts.Get("crm.company.people.end")</button>
                                                }
                                            }
                                        </li>
                                    }
                                </ul>
                            }
                            else if (links is not null)
                            {
                                <p class="text-muted">@Texts.Get("crm.contact.companies.none")</p>
                            }
                        </section>
                    </div>
                }

                @if (tabs.Rendered(TabActivities))
                {
                    <div role="tabpanel" id="tabpanel-@TabActivities" aria-labelledby="tab-@TabActivities" class="record-tabpanel" hidden="@tabs.Hidden(TabActivities)">
                        @if (Session.Can(CrmAccess.ActivitiesRead))
                        {
                            <section class="detail-section">
                                <div class="section-header">
                                    <h2>@Texts.Get("crm.activities.title")</h2>
                                </div>
                                @if (activities is { Count: > 0 })
                                {
                                    <ul class="item-list">
                                        @foreach (var activity in activities)
                                        {
                                            <li class="@(ActivityStatus.IsOpen(activity.Status) ? null : "done")">
                                                <div class="item-main">
                                                    <strong>@activity.Subject</strong>
                                                    <span>
                                                        @Lookups.Label(CrmLists.ActivityType, activity.Type)
                                                        @if (activity.DueAt is { } due) { <text> · @CrmLabels.Time(due)</text> }
                                                        @if (activity.CompanyId is { } company) { <text> · </text><a href="crm/firmalar/@company">@Lookups.CompanyName(company)</a> }
                                                        @if (!ActivityStatus.IsOpen(activity.Status)) { <text> · @ActivityLabels.Status(ActivityLabels.Family(Lookups, activity.Type), activity.Status)</text> }
                                                    </span>
                                                </div>
                                            </li>
                                        }
                                    </ul>
                                    <Pager Page="activityPage" PageSize="ListSize" TotalCount="activityTotal" PageChanged="ActivityPageChanged" />
                                }
                                else if (activities is not null)
                                {
                                    <p class="text-muted">@Texts.Get("crm.contact.acts.none")</p>
                                }
                            </section>
                        }
                    </div>
                }

                @if (tabs.Rendered(TabSales))
                {
                    <div role="tabpanel" id="tabpanel-@TabSales" aria-labelledby="tab-@TabSales" class="record-tabpanel" hidden="@tabs.Hidden(TabSales)">
                        @if (Session.Can(CrmAccess.OpportunitiesRead))
                        {
                            <section class="detail-section">
                                <div class="section-header">
                                    <h2>@Texts.Get("crm.opportunities.title")</h2>
                                </div>
                                @if (opportunities is { Count: > 0 })
                                {
                                    <ul class="item-list">
                                        @foreach (var opportunity in opportunities)
                                        {
                                            <li>
                                                <div class="item-main">
                                                    <strong>@opportunity.Title</strong>
                                                    <span>
                                                        <span class="badge stage-@Lookups.Badge(CrmLists.OpportunityStage, opportunity.Stage)">@Lookups.Label(CrmLists.OpportunityStage, opportunity.Stage)</span>
                                                        @if (opportunity.Amount is { } amount) { <text> @CrmLabels.Amount(amount, opportunity.Currency)</text> }
                                                        <text> · </text><a href="crm/firmalar/@opportunity.CompanyId">@Lookups.CompanyName(opportunity.CompanyId)</a>
                                                    </span>
                                                </div>
                                            </li>
                                        }
                                    </ul>
                                    <Pager Page="opportunityPage" PageSize="ListSize" TotalCount="opportunityTotal" PageChanged="OpportunityPageChanged" />
                                }
                                else if (opportunities is not null)
                                {
                                    <p class="text-muted">@Texts.Get("crm.contact.opps.none")</p>
                                }
                            </section>
                        }
                        <RelatedLeads ContactId="Id" />
                        <RelatedCampaigns TargetId="contact!.PersonId" />
                    </div>
                }

                @if (tabs.Rendered(TabHistory))
                {
                    <div role="tabpanel" id="tabpanel-@TabHistory" aria-labelledby="tab-@TabHistory" class="record-tabpanel" hidden="@tabs.Hidden(TabHistory)">
                        <RecordHistory EntityKey="@CrmEntityKeys.Contact" RecordId="Id" Version="contact.Version" />
                    </div>
                }
            </div>
        </div>
    }
</AuthGate>

@code {
    private const int ListSize = 20;

    private ContactDto? contact;
    private IReadOnlyList<CompanyContactDto>? links;
    private IReadOnlyList<ActivityDto>? activities;
    private IReadOnlyList<OpportunityDto>? opportunities;
    private CompanyContactDto? editingLink;
    private bool editing;
    private bool busy;
    private string? message;
    private int activityPage = 1, activityTotal, opportunityPage = 1, opportunityTotal;

    [Parameter] public Guid Id { get; set; }

    [Inject] private NavigationManager Navigation { get; set; } = default!;

    private int activeLinks => links?.Count(l => l.IsActive) ?? 0;

    private const string TabGeneral = "genel";
    private const string TabCompanies = "firmalar";
    private const string TabActivities = "aktiviteler";
    private const string TabSales = "satis";
    private const string TabHistory = "gecmis";

    private readonly TabState tabs = new(TabGeneral);

    /// <summary>Sekmeler: yalnızca kullanıcının görebildiği bölümler.</summary>
    private IReadOnlyList<TabItem> ContactTabs
    {
        get
        {
            List<TabItem> list = [new(TabGeneral, Texts.Get("crm.company.general")), new(TabCompanies, Texts.Get("crm.contact.companies.title"), links?.Count)];
            if (Session.Can(CrmAccess.ActivitiesRead))
            {
                list.Add(new(TabActivities, Texts.Get("crm.activities.title"), activityTotal));
            }

            if (Session.Can(CrmAccess.OpportunitiesRead) || Session.Can(CrmAccess.LeadsRead))
            {
                list.Add(new(TabSales, Texts.Get("crm.company.tab.sales"), Session.Can(CrmAccess.OpportunitiesRead) ? (int?)opportunityTotal : null));
            }

            list.Add(new(TabHistory, Texts.Get("common.history.tab")));
            return list;
        }
    }

    private static string Initials(string name) =>
        string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpper(p[0], new System.Globalization.CultureInfo("tr-TR"))));

    protected override async Task OnParametersSetAsync()
    {
        await Session.EnsureLoadedAsync();
        if (Session.Can(CrmAccess.ContactsRead))
        {
            await Lookups.LoadAsync(contacts: false, opportunities: false);
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        var result = await Api.GetAsync<ContactDto>($"/api/crm/contacts/{Id}");
        contact = result.Value;
        message = result.Error;
        if (contact is null)
        {
            if (result.Status == System.Net.HttpStatusCode.NotFound
                && (await Api.GetAsync<MergedRecordDto>($"/api/crm/contacts/merged/{Id}")).Value is { } moved)
            {
                Navigation.NavigateTo($"crm/kisiler/{moved.TargetId}", replace: true);
            }

            return;
        }

        await Task.WhenAll(LoadLinksAsync(), LoadActivitiesAsync(), LoadOpportunitiesAsync());
    }

    // Eski telefon/e-posta alanları ana noktanın aynasıdır; nokta değişince kişi yeniden okunur.
    private async Task ReloadContactAsync() => contact = (await Api.GetAsync<ContactDto>($"/api/crm/contacts/{Id}")).Value ?? contact;

    private async Task LoadLinksAsync() =>
        links = (await Api.GetAsync<CrmPage<CompanyContactDto>>($"/api/crm/company-contacts?contactId={Id}&pageSize=100")).Value?.Items ?? [];

    private async Task LoadActivitiesAsync()
    {
        if (Session.Can(CrmAccess.ActivitiesRead))
        {
            var page = (await Api.GetAsync<CrmPage<ActivityDto>>($"/api/crm/activities?related=crm.contact:{Id}&page={activityPage}&pageSize={ListSize}")).Value;
            activities = page?.Items ?? [];
            activityTotal = page?.TotalCount ?? 0;
        }
    }

    private async Task LoadOpportunitiesAsync()
    {
        if (Session.Can(CrmAccess.OpportunitiesRead))
        {
            var page = (await Api.GetAsync<CrmPage<OpportunityDto>>($"/api/crm/opportunities?contactId={Id}&page={opportunityPage}&pageSize={ListSize}")).Value;
            opportunities = page?.Items ?? [];
            opportunityTotal = page?.TotalCount ?? 0;
        }
    }

    private async Task ActivityPageChanged(int page)
    {
        activityPage = page;
        await LoadActivitiesAsync();
    }

    private async Task OpportunityPageChanged(int page)
    {
        opportunityPage = page;
        await LoadOpportunitiesAsync();
    }

    private async Task ContactSaved(ContactDto saved)
    {
        contact = saved;
        editing = false;
        await LoadLinksAsync();
    }

    private void ContactDeleted() => Navigation.NavigateTo("crm/kisiler");

    private async Task LinkSaved()
    {
        editingLink = null;
        await Task.WhenAll(LoadLinksAsync(), ReloadContactAsync());
    }

    private async Task EndLinkAsync(CompanyContactDto link)
    {
        busy = true;
        var result = await Api.PutAsync<CompanyContactDto>($"/api/crm/company-contacts/{link.Id}",
            new SaveCompanyContactRequest(link.CompanyId, link.ContactId, link.Department, link.JobTitle, link.Roles, false,
                link.IsDecisionMaker, link.StartDate, DateOnly.FromDateTime(DateTime.Today), link.Version));
        busy = false;
        message = result.Error;
        await Task.WhenAll(LoadLinksAsync(), ReloadContactAsync());
    }
}
