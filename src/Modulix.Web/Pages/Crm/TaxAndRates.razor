@page "/crm/vergi-kur"
@inject ApiClient Api
@inject SessionState Session

<PageTitle>@Texts.Get("crm.taxAndRates.pageTitle") · Modulix</PageTitle>

<AuthGate Module="@CrmAccess.ModuleKey" Permission="@CrmAccess.PricesRead">
    <div class="page-header">
        <h1>@Texts.Get("crm.taxAndRates.title")</h1>
    </div>

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }

    <section class="record-form">
        <div class="page-header">
            <h2>@Texts.Get("crm.taxAndRates.taxes")</h2>
            @if (Session.Can(CrmAccess.PricesWrite) && taxForm is null)
            {
                <button type="button" class="btn btn-primary btn-sm" @onclick="() => taxForm = new()">@Texts.Get("crm.taxAndRates.newTax")</button>
            }
        </div>
        <p class="text-muted">@Texts.Get("crm.taxAndRates.taxIntro")</p>

        @if (taxForm is not null)
        {
            <FormTabs Title="@Texts.Get("crm.taxAndRates.taxForm")" Label="@Texts.Get("crm.taxAndRates.taxFormSections")">
            <form class="form-grid" novalidate @onsubmit="SaveTaxAsync" @onsubmit:preventDefault>
                <div>
                    <label class="form-label" for="taxCode">@Texts.Get("crm.products.field.code")</label>
                    <input id="taxCode" class="form-control" maxlength="30" @bind="taxForm.Code" />
                    <FieldError Field="code" Errors="taxErrors" />
                </div>
                <div>
                    <label class="form-label" for="taxName">@Texts.Get("common.field.nameRequired")</label>
                    <input id="taxName" class="form-control" maxlength="100" @bind="taxForm.Name" />
                    <FieldError Field="name" Errors="taxErrors" />
                </div>
                <div>
                    <label class="form-label" for="taxRate">@Texts.Get("crm.taxAndRates.field.rate")</label>
                    <input id="taxRate" class="form-control" type="number" step="any" min="0" max="100" @bind="taxForm.Rate" />
                    <FieldError Field="ratePercent" Errors="taxErrors" />
                </div>
                <div>
                    <label class="form-label" for="taxFrom">@Texts.Get("crm.taxAndRates.field.validFrom")</label>
                    <input id="taxFrom" class="form-control" type="date" @bind="taxForm.ValidFrom" />
                    <FieldError Field="validFrom" Errors="taxErrors" />
                </div>
                <div>
                    <label class="form-label" for="taxTo">@Texts.Get("crm.taxAndRates.field.validTo")</label>
                    <input id="taxTo" class="form-control" type="date" @bind="taxForm.ValidTo" />
                    <FieldError Field="validTo" Errors="taxErrors" />
                </div>
                <div>
                    <label class="form-label" for="taxActive">@Texts.Get("common.field.status")</label>
                    <select id="taxActive" class="form-select" @bind="taxForm.IsActive">
                        <option value="True">@Texts.Get("common.active")</option>
                        <option value="False">@Texts.Get("common.inactive")</option>
                    </select>
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn btn-primary" disabled="@busy">@Texts.Get("common.save")</button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="() => taxForm = null">@Texts.Get("common.dismiss")</button>
                    @if (taxForm.Id is not null)
                    {
                        <button type="button" class="btn btn-outline-danger ms-auto" disabled="@busy" @onclick="DeleteTaxAsync">@Texts.Get("common.delete")</button>
                    }
                </div>
            </form>
            </FormTabs>
        }

        @if (taxes is null)
        {
            <LoadingState Kind="LoadingKind.Table" />
        }
        else if (taxes.Count == 0)
        {
            <EmptyState Title="@Texts.Get("crm.taxAndRates.noTaxes")" />
        }
        else
        {
            <table class="table record-table">
                <thead><tr><th>@Texts.Get("crm.products.col.code")</th><th>@Texts.Get("common.field.name")</th><th>@Texts.Get("crm.taxAndRates.col.rate")</th><th>@Texts.Get("crm.priceLists.col.period")</th><th>@Texts.Get("common.field.status")</th><th></th></tr></thead>
                <tbody>
                    @foreach (var tax in taxes)
                    {
                        <tr>
                            <td data-label="@Texts.Get("crm.products.col.code")" class="primary">@tax.Code</td>
                            <td data-label="@Texts.Get("common.field.name")">@tax.Name</td>
                            <td data-label="@Texts.Get("crm.taxAndRates.col.rate")">%@tax.RatePercent</td>
                            <td data-label="@Texts.Get("crm.priceLists.col.period")">@tax.ValidFrom.ToString("yyyy-MM-dd") → @(tax.ValidTo?.ToString("yyyy-MM-dd") ?? Texts.Get("crm.taxAndRates.openEnded"))</td>
                            <td data-label="@Texts.Get("common.field.status")">@(tax.IsActive ? Texts.Get("common.active") : Texts.Get("common.inactive"))</td>
                            <td class="actions">
                                @if (Session.Can(CrmAccess.PricesWrite))
                                {
                                    <button type="button" class="btn btn-outline-primary btn-sm" @onclick="() => EditTax(tax)">@Texts.Get("common.edit")</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>

    <section class="record-form">
        <div class="page-header">
            <h2>@Texts.Get("crm.taxAndRates.rates")</h2>
            @if (Session.Can(CrmAccess.PricesWrite) && rateForm is null)
            {
                <button type="button" class="btn btn-primary btn-sm" @onclick="() => rateForm = new()">@Texts.Get("crm.taxAndRates.newRate")</button>
            }
        </div>
        <p class="text-muted">@Texts.Get("crm.taxAndRates.rateIntro")</p>

        @if (rateForm is not null)
        {
            <FormTabs Title="@Texts.Get("crm.taxAndRates.rateForm")" Label="@Texts.Get("crm.taxAndRates.rateFormSections")">
            <form class="form-grid" novalidate @onsubmit="SaveRateAsync" @onsubmit:preventDefault>
                <div>
                    <label class="form-label" for="rateFrom">@Texts.Get("crm.taxAndRates.field.from")</label>
                    <input id="rateFrom" class="form-control" maxlength="3" @bind="rateForm.From" />
                    <FieldError Field="fromCurrency" Errors="rateErrors" />
                </div>
                <div>
                    <label class="form-label" for="rateTo">@Texts.Get("crm.taxAndRates.field.to")</label>
                    <input id="rateTo" class="form-control" maxlength="3" @bind="rateForm.To" />
                    <FieldError Field="toCurrency" Errors="rateErrors" />
                </div>
                <div>
                    <label class="form-label" for="rateValue">@Texts.Get("crm.taxAndRates.field.rateValue")</label>
                    <input id="rateValue" class="form-control" type="number" step="any" min="0" @bind="rateForm.Rate" />
                    <FieldError Field="rate" Errors="rateErrors" />
                </div>
                <div>
                    <label class="form-label" for="rateDay">@Texts.Get("crm.taxAndRates.field.validOn")</label>
                    <input id="rateDay" class="form-control" type="date" @bind="rateForm.ValidOn" />
                    <FieldError Field="validOn" Errors="rateErrors" />
                </div>
                <div>
                    <label class="form-label" for="rateSource">@Texts.Get("crm.taxAndRates.col.source")</label>
                    <select id="rateSource" class="form-select" @bind="rateForm.Source">
                        @foreach (var source in PricingLabels.RateSources)
                        {
                            <option value="@source.Key">@source.Label</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="form-label" for="rateNote">@Texts.Get("crm.taxAndRates.col.note")</label>
                    <input id="rateNote" class="form-control" maxlength="500" @bind="rateForm.Note" />
                    <FieldError Field="note" Errors="rateErrors" />
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn btn-primary" disabled="@busy">@Texts.Get("common.save")</button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="() => rateForm = null">@Texts.Get("common.dismiss")</button>
                    @if (rateForm.Id is not null)
                    {
                        <button type="button" class="btn btn-outline-danger ms-auto" disabled="@busy" @onclick="DeleteRateAsync">@Texts.Get("common.delete")</button>
                    }
                </div>
            </form>
            </FormTabs>
        }

        @if (rates is null)
        {
            <LoadingState Kind="LoadingKind.Table" />
        }
        else if (rates.Count == 0)
        {
            <EmptyState Title="@Texts.Get("crm.taxAndRates.noRates")" />
        }
        else
        {
            <table class="table record-table">
                <thead><tr><th>@Texts.Get("crm.taxAndRates.col.pair")</th><th>@Texts.Get("crm.taxAndRates.col.rateValue")</th><th>@Texts.Get("crm.taxAndRates.col.day")</th><th>@Texts.Get("crm.taxAndRates.col.source")</th><th>@Texts.Get("crm.taxAndRates.col.note")</th><th></th></tr></thead>
                <tbody>
                    @foreach (var rate in rates)
                    {
                        <tr>
                            <td data-label="@Texts.Get("crm.taxAndRates.col.pair")" class="primary">@rate.FromCurrency → @rate.ToCurrency</td>
                            <td data-label="@Texts.Get("crm.taxAndRates.col.rateValue")">@rate.Rate</td>
                            <td data-label="@Texts.Get("crm.taxAndRates.col.day")">@rate.ValidOn.ToString("yyyy-MM-dd")</td>
                            <td data-label="@Texts.Get("crm.taxAndRates.col.source")">@PricingLabels.Label(PricingLabels.RateSources, rate.Source)</td>
                            <td data-label="@Texts.Get("crm.taxAndRates.col.note")">@rate.Note</td>
                            <td class="actions">
                                @if (Session.Can(CrmAccess.PricesWrite))
                                {
                                    <button type="button" class="btn btn-outline-primary btn-sm" @onclick="() => EditRate(rate)">@Texts.Get("common.edit")</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>
</AuthGate>

@code {
    private const string TaxUrl = "/api/crm/tax-rates";
    private const string RateUrl = "/api/crm/exchange-rates";

    private List<TaxRateDto>? taxes;
    private List<ExchangeRateDto>? rates;
    private TaxForm? taxForm;
    private RateForm? rateForm;
    private IReadOnlyDictionary<string, string[]>? taxErrors;
    private IReadOnlyDictionary<string, string[]>? rateErrors;
    private string? message;
    private bool busy;

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (Session.Can(CrmAccess.PricesRead))
        {
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        var (loadedTaxes, taxError) = await Api.GetAllAsync<TaxRateDto>(TaxUrl);
        var (loadedRates, rateError) = await Api.GetAllAsync<ExchangeRateDto>(RateUrl);
        taxes = loadedTaxes;
        rates = loadedRates;
        message = taxError ?? rateError;
    }

    private void EditTax(TaxRateDto tax)
    {
        taxForm = new TaxForm
        {
            Id = tax.Id, Version = tax.Version, Code = tax.Code, Name = tax.Name, Rate = tax.RatePercent,
            ValidFrom = tax.ValidFrom.ToDateTime(TimeOnly.MinValue), ValidTo = tax.ValidTo?.ToDateTime(TimeOnly.MinValue), IsActive = tax.IsActive,
        };
        taxErrors = null;
    }

    private async Task SaveTaxAsync()
    {
        busy = true;
        var f = taxForm!;
        var request = new SaveTaxRateRequest(
            f.Code, f.Name, f.Rate, DateOnly.FromDateTime(f.ValidFrom), f.ValidTo is { } to ? DateOnly.FromDateTime(to) : null, f.IsActive, f.Version);
        var result = f.Id is { } id
            ? await Api.PutAsync<TaxRateDto>($"{TaxUrl}/{id}", request)
            : await Api.PostAsync<TaxRateDto>(TaxUrl, request);
        busy = false;

        if (result.IsSuccess)
        {
            taxForm = null;
            taxErrors = null;
            await LoadAsync();
            return;
        }

        taxErrors = result.FieldErrors;
        message = result.Error;
    }

    private async Task DeleteTaxAsync()
    {
        busy = true;
        var result = await Api.DeleteAsync($"{TaxUrl}/{taxForm!.Id}?version={taxForm.Version}");
        busy = false;
        message = result.Error;
        if (result.IsSuccess)
        {
            taxForm = null;
            await LoadAsync();
        }
    }

    private void EditRate(ExchangeRateDto rate)
    {
        rateForm = new RateForm
        {
            Id = rate.Id, Version = rate.Version, From = rate.FromCurrency, To = rate.ToCurrency, Rate = rate.Rate,
            ValidOn = rate.ValidOn.ToDateTime(TimeOnly.MinValue), Source = rate.Source, Note = rate.Note,
        };
        rateErrors = null;
    }

    private async Task SaveRateAsync()
    {
        busy = true;
        var f = rateForm!;
        var request = new SaveExchangeRateRequest(
            f.From, f.To, f.Rate, DateOnly.FromDateTime(f.ValidOn), f.Source, string.IsNullOrWhiteSpace(f.Note) ? null : f.Note, f.Version);
        var result = f.Id is { } id
            ? await Api.PutAsync<ExchangeRateDto>($"{RateUrl}/{id}", request)
            : await Api.PostAsync<ExchangeRateDto>(RateUrl, request);
        busy = false;

        if (result.IsSuccess)
        {
            rateForm = null;
            rateErrors = null;
            await LoadAsync();
            return;
        }

        rateErrors = result.FieldErrors;
        message = result.Error;
    }

    private async Task DeleteRateAsync()
    {
        busy = true;
        var result = await Api.DeleteAsync($"{RateUrl}/{rateForm!.Id}?version={rateForm.Version}");
        busy = false;
        message = result.Error;
        if (result.IsSuccess)
        {
            rateForm = null;
            await LoadAsync();
        }
    }

    private sealed class TaxForm
    {
        public Guid? Id { get; init; }

        public long? Version { get; init; }

        public string Code { get; set; } = string.Empty;

        public string Name { get; set; } = string.Empty;

        public decimal Rate { get; set; }

        public DateTime ValidFrom { get; set; } = DateTime.Today;

        public DateTime? ValidTo { get; set; }

        public bool IsActive { get; set; } = true;
    }

    private sealed class RateForm
    {
        public Guid? Id { get; init; }

        public long? Version { get; init; }

        public string From { get; set; } = "USD";

        public string To { get; set; } = "TRY";

        public decimal Rate { get; set; }

        public DateTime ValidOn { get; set; } = DateTime.Today;

        public string Source { get; set; } = "Manual";

        public string? Note { get; set; }
    }
}
