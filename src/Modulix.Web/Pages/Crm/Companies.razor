@page "/crm/firmalar"
@inject ApiClient Api
@inject SessionState Session
@inject CrmLookups Lookups

<PageTitle>Firmalar · Modulix</PageTitle>

<AuthGate Module="@CrmAccess.ModuleKey" Permission="@CrmAccess.CompaniesRead">
    <PageHeader Title="Firmalar" Icon="building" Subtitle="@(page is null ? "Müşteri, aday ve iş ortağı firmalarınızı yönetin." : $"{page.TotalCount} kayıt")" />

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }

    @if (editing)
    {
        <CompanyEditor Company="selected" Lookups="Lookups" Saved="SavedAsync" Deleted="SavedAsync" Cancelled="Close" />
    }

    <div class="list-toolbar">
        <ViewSelector Items="ViewOptions" Value="@CurrentView" ValueChanged="ChooseViewAsync" />
        <form class="search" @onsubmit="() => LoadAsync(1)" @onsubmit:preventDefault>
            <input class="form-control" type="search" aria-label="Firma ara" placeholder="Ad, vergi no, şehir veya etiket ara" @bind="search" />
            <button type="submit" class="btn btn-outline-secondary">Ara</button>
        </form>
        <FilterToggle @bind-Open="filtersOpen" Count="ActiveFilters" />
        <ColumnPicker />
        @if (Session.Can(CrmAccess.CompaniesWrite) && !editing)
        {
            <button type="button" class="btn btn-primary" @onclick="New"><AppIcon Name="plus" Size="16" /> Yeni firma</button>
        }
    </div>
    @if (filtersOpen || ActiveFilters > 0)
    {
        <div class="filters">
            <select class="form-select" aria-label="İlişki rolü" @bind="role" @bind:after="() => LoadAsync(1)">
                <option value="">Tüm ilişki rolleri</option>
                @foreach (var r in roles.Where(r => r.IsActive || r.Code == role))
                {
                    <option value="@r.Code">@r.Name</option>
                }
            </select>
            <select class="form-select" aria-label="Müşteri sektörü" @bind="sector" @bind:after="() => LoadAsync(1)">
                <option value="">Tüm müşteri sektörleri</option>
                @foreach (var a in activities)
                {
                    <option value="@a.Code">@ActivityPath(a)</option>
                }
            </select>
            <select class="form-select" aria-label="Hizmet ihtiyacı" @bind="need" @bind:after="() => LoadAsync(1)">
                <option value="">Tüm hizmet ihtiyaçları</option>
                @foreach (var a in activities)
                {
                    <option value="@a.Code">@ActivityPath(a)</option>
                }
            </select>
        </div>
    }

    @if (page is null)
    {
        <p class="text-muted">Yükleniyor…</p>
    }
    else if (page.Items.Count == 0)
    {
        <p class="text-muted">Kayıt yok.</p>
    }
    else
    {
        <table class="table record-table">
            <thead>
                <tr><th>Ad</th><th>Durum</th><th>Şehir</th><th>Sorumlu</th><th>Telefon</th>@foreach (var field in Lookups.ListFieldsOf(CrmEntityKeys.Company)) { <th>@field.Label</th> }<th></th></tr>
            </thead>
            <tbody>
                @foreach (var company in page.Items)
                {
                    <tr>
                        <td data-label="Ad" class="primary"><a href="crm/firmalar/@company.Id">@company.Name</a></td>
                        <td data-label="Durum"><span class="badge status-@Lookups.Badge(CrmLists.CompanyStatus, company.Status)">@Lookups.Label(CrmLists.CompanyStatus, company.Status)</span></td>
                        <td data-label="Şehir">@company.City</td>
                        <td data-label="Sorumlu"><OwnerCell Name="@Lookups.MemberName(company.OwnerId)" /></td>
                        <td data-label="Telefon">@company.Phone</td>
                        @foreach (var field in Lookups.ListFieldsOf(CrmEntityKeys.Company))
                        {
                            <td data-label="@field.Label">@CustomFieldText.Format(field, company.Custom)</td>
                        }
                        <td class="actions">
                            @if (Session.Can(CrmAccess.CompaniesWrite))
                            {
                                <button type="button" class="btn btn-outline-primary btn-sm" @onclick="() => Edit(company)">Düzenle</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager PageSizeChoice="true" Page="page.Page" PageSize="page.PageSize" TotalCount="page.TotalCount" PageChanged="LoadAsync" />
    }
</AuthGate>

@code {
    private const string Url = "/api/crm/companies";

    private CrmPage<CompanyDto>? page;
    private CompanyDto? selected;
    private bool editing;
    private string? message;
    private string? search;
    private string? status;
    private bool mine;
    private bool filtersOpen;
    private string role = "";
    private string sector = "";
    private string need = "";
    private List<RelationshipRoleDto> roles = [];
    private List<ActivityOptionDto> activities = [];

    // Aynı ad farklı sektörlerde tekrarlanabilir (ör. "Diğer"): üst düğümlerle birlikte gösterilir.
    private string ActivityPath(ActivityOptionDto option)
    {
        var names = new List<string> { option.Name };
        for (var parent = option.ParentCode; parent is not null && names.Count < 6;)
        {
            var node = activities.FirstOrDefault(a => a.Code == parent);
            if (node is null) { break; }
            names.Insert(0, node.Name);
            parent = node.ParentCode;
        }

        return string.Join(" › ", names);
    }

    private int ActiveFilters => (role.Length > 0 ? 1 : 0) + (sector.Length > 0 ? 1 : 0) + (need.Length > 0 ? 1 : 0);

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (Session.Can(CrmAccess.CompaniesRead))
        {
            await Lookups.LoadAsync();
            roles = (await Api.GetAsync<List<RelationshipRoleDto>>("/api/relationship-roles")).Value ?? [];
            activities = (await Api.GetAsync<List<ActivityOptionDto>>("/api/activity-options")).Value ?? [];
            await LoadAsync(1);
        }
    }

    private const string AllViews = "all";
    private const string MineView = "mine";
    private const string StatusPrefix = "status:";

    // Görünümler yalnızca süzgeçtir (Tümü, Benim firmalarım, durum); kapsamı sunucu uygular.
    private IReadOnlyList<ViewOption> ViewOptions =>
    [
        new(AllViews, "Tüm firmalar"),
        new(MineView, "Benim firmalarım"),
        .. Lookups.Choices(CrmLists.CompanyStatus, status).Select(v => new ViewOption(StatusPrefix + v.Key, v.Label, "Duruma göre")),
    ];

    private string CurrentView => mine ? MineView : status is { } s ? StatusPrefix + s : AllViews;

    private async Task ChooseViewAsync(string key)
    {
        mine = key == MineView;
        status = key.StartsWith(StatusPrefix, StringComparison.Ordinal) ? key[StatusPrefix.Length..] : null;
        await LoadAsync(1);
    }

    private async Task LoadAsync(int pageNumber)
    {
        var url = $"{Url}?page={pageNumber}&pageSize={ListPaging.Size}&search={Uri.EscapeDataString(search ?? string.Empty)}";
        if (status is { } s)
        {
            url += $"&status={Uri.EscapeDataString(s)}";
        }

        if (mine)
        {
            url += "&ownerId=me";
        }

        foreach (var (name, value) in new[] { ("relationshipRole", role), ("customerSector", sector), ("serviceNeed", need) })
        {
            if (value.Length > 0)
            {
                url += $"&{name}={Uri.EscapeDataString(value)}";
            }
        }

        var result = await Api.GetAsync<CrmPage<CompanyDto>>(url);
        page = result.Value;
        message = result.Error;
    }

    private void New() => Open(null);

    private void Edit(CompanyDto company) => Open(company);

    private void Open(CompanyDto? company)
    {
        selected = company;
        editing = true;
        message = null;
    }

    private void Close() => editing = false;

    private async Task SavedAsync()
    {
        editing = false;
        await LoadAsync(page?.Page ?? 1);
    }
}
