@page "/crm/firmalar"
@inject ApiClient Api
@inject SessionState Session
@inject CrmLookups Lookups

<PageTitle>Firmalar · Modulix</PageTitle>

<AuthGate Module="@CrmAccess.ModuleKey" Permission="@CrmAccess.CompaniesRead">
    <PageHeader Title="Firmalar" Icon="building" Subtitle="@(page is null ? "Müşteri, aday ve iş ortağı firmalarınızı yönetin." : $"{page.TotalCount} kayıt")" />

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }

    @if (editing)
    {
        <CompanyEditor Company="selected" Lookups="Lookups" Saved="SavedAsync" Deleted="SavedAsync" Cancelled="Close" />
    }

    <ViewTabs Items="ViewOptions" Value="@view" ValueChanged="ChooseViewAsync" Label="Firma görünümleri" NewView="StartNaming" NewViewText="Görünüm" />

    <div class="list-toolbar">
        <form class="search" @onsubmit="() => LoadAsync(1)" @onsubmit:preventDefault>
            <input class="form-control" type="search" aria-label="Firma ara" placeholder="Ad, vergi no, şehir veya etiket ara" @bind="search" />
        </form>
        <GridColumnPicker State="grid" Changed="ColumnsChanged" />
        @if (Session.Can(CrmAccess.CompaniesWrite) && !editing)
        {
            <button type="button" class="btn btn-primary" @onclick="New"><AppIcon Name="plus" Size="16" /> Yeni firma</button>
        }
    </div>

    <PersonalViewBar Active="Active" Dirty="grid.Differs(Active)" Naming="views.Naming" NamingChanged="views.StartNaming" Error="@views.Error"
                     SaveAs="SaveAsAsync" UpdateView="UpdateViewAsync" DiscardChanges="DiscardAsync" DeleteView="DeleteViewAsync" />

    @if (page is null)
    {
        <p class="text-muted">Yükleniyor…</p>
    }
    else if (page.Items.Count == 0)
    {
        <p class="text-muted">Kayıt yok.</p>
    }
    else
    {
        <table class="table record-table">
            <thead>
                <tr>
                    @foreach (var column in grid.VisibleColumns)
                    {
                        <GridHeader Column="column" State="grid" SortChanged="SortAsync" />
                    }
                    <th scope="col" class="row-menu-cell"><span class="visually-hidden">Eylemler</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var company in page.Items)
                {
                    <tr>
                        @foreach (var column in grid.VisibleColumns)
                        {
                            @Cell(column, company)
                        }
                        <td class="row-menu-cell">
                            <RowMenu Label="@($"{company.Name} eylemleri")">
                                <a class="view-menu-item" role="menuitem" href="crm/firmalar/@company.Id"><AppIcon Name="eye" Size="16" /> <span>Aç</span></a>
                                @if (Session.Can(CrmAccess.CompaniesWrite))
                                {
                                    <button type="button" class="view-menu-item" role="menuitem" @onclick="() => Edit(company)"><AppIcon Name="pencil" Size="16" /> <span>Düzenle</span></button>
                                }
                            </RowMenu>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager PageSizeChoice="true" Page="page.Page" PageSize="page.PageSize" TotalCount="page.TotalCount" PageChanged="LoadAsync" />
    }
</AuthGate>

@code {
    private const string Url = "/api/crm/companies";
    private const string AllViews = "all";
    private const string MineView = "mine";
    private const string StatusPrefix = "status:";

    // Sütunların sırası varsayılan sıradır; Sorumlu sütunu sunucuda sıralanamaz (adı üyelik tablosundadır).
    private static readonly GridColumnDef[] BaseColumns =
    [
        new("name", "Ad", "type", "name", "-name", Locked: true),
        new("status", "Durum", "tag", "status", "-status"),
        new("city", "Şehir", "map-pin", "city", "-city"),
        new("owner", "Sorumlu", "user"),
        new("phone", "Telefon", "phone", "phone", "-phone"),
        new("industry", "Sektör", "briefcase", "industry", "-industry", DefaultVisible: false),
        new("taxNumber", "Vergi no", "hash", "taxNumber", "-taxNumber", DefaultVisible: false),
        new("email", "E-posta", "mail", DefaultVisible: false),
        new("tags", "Etiketler", "tag", DefaultVisible: false),
    ];

    private readonly GridViewState grid = new("crm.companies", "name");
    private PersonalGridViews views = default!;
    private CrmPage<CompanyDto>? page;
    private CompanyDto? selected;
    private bool editing;
    private string? message;
    private string? search;
    private string? status;
    private bool mine;
    private string view = AllViews;

    protected override async Task OnInitializedAsync()
    {
        views = new PersonalGridViews(Api, "crm.companies");
        await Session.EnsureLoadedAsync();
        if (Session.Can(CrmAccess.CompaniesRead))
        {
            await Lookups.LoadAsync();
            grid.Define([.. BaseColumns, .. Lookups.FieldsOf(CrmEntityKeys.Company).Select(f => new GridColumnDef("custom." + f.Key, f.Label, "type", DefaultVisible: f.ShowInList))]);
            await views.LoadAsync();
            await LoadAsync(1);
        }
    }

    private GridViewDto? Active => views.Find(view);

    // Görünümler yalnızca süzgeçtir (Benim firmalarım, Tümü, durum, kişisel); kapsamı sunucu uygular.
    private IReadOnlyList<ViewOption> ViewOptions =>
    [
        new(MineView, "Benim firmalarım", Icon: "star"),
        new(AllViews, "Tüm firmalar", Icon: "building"),
        .. Lookups.Choices(CrmLists.CompanyStatus, status).Select(v => new ViewOption(StatusPrefix + v.Key, v.Label, Icon: "tag")),
        .. views.Options,
    ];

    private async Task ChooseViewAsync(string key)
    {
        view = key;
        views.StartNaming(false);
        if (Active is { } saved)
        {
            // Kişisel görünüm: sütunlar, sıralama ve süzgeç birlikte gelir.
            grid.Apply(saved);
            var filters = GridFilters.Parse(saved.Filters);
            mine = filters.GetValueOrDefault("ownerId") == "me";
            status = filters.GetValueOrDefault("status");
        }
        else
        {
            grid.Reset();
            mine = key == MineView;
            status = key.StartsWith(StatusPrefix, StringComparison.Ordinal) ? key[StatusPrefix.Length..] : null;
        }

        await LoadAsync(1);
    }

    private async Task SortAsync(string key)
    {
        grid.Sort = key;
        await LoadAsync(1);
    }

    // Sütun seçimi/sırası değişince veri yeniden çekilmez; olay işleyicisi sayfada olduğu için tablo yeniden çizilir.
    private Task ColumnsChanged() => Task.CompletedTask;

    private string? CurrentFilters => GridFilters.Build(mine ? ("ownerId", "me") : null, status is { } s ? ("status", s) : null);

    private void StartNaming() => views.StartNaming(true);

    private async Task SaveAsAsync(string name)
    {
        if (await views.SaveAsAsync(grid.ToRequest(name, CurrentFilters)) is { } key)
        {
            view = key;
        }
    }

    private async Task UpdateViewAsync()
    {
        if (Active is { } current)
        {
            await views.UpdateAsync(current, grid.ToRequest(current.Name, CurrentFilters));
        }
    }

    private async Task DiscardAsync() => await ChooseViewAsync(view);

    private async Task DeleteViewAsync()
    {
        if (Active is { } current && await views.DeleteAsync(current))
        {
            await ChooseViewAsync(AllViews);
        }
    }

    private async Task LoadAsync(int pageNumber)
    {
        var url = $"{Url}?page={pageNumber}&pageSize={ListPaging.Size}&search={Uri.EscapeDataString(search ?? string.Empty)}";
        if (grid.Sort != grid.DefaultSort)
        {
            url += $"&sort={Uri.EscapeDataString(grid.Sort)}";
        }

        if (status is { } s)
        {
            url += $"&status={Uri.EscapeDataString(s)}";
        }

        if (mine)
        {
            url += "&ownerId=me";
        }

        var result = await Api.GetAsync<CrmPage<CompanyDto>>(url);
        page = result.Value;
        message = result.Error;
    }

    private RenderFragment Cell(GridColumnDef column, CompanyDto company) => @<td data-label="@column.Label" class="@(column.Key == "name" ? "primary" : null)">@CellContent(column.Key, company)</td>;

    private RenderFragment CellContent(string key, CompanyDto company) => key switch
    {
        "name" => @<a href="crm/firmalar/@company.Id">@company.Name</a>,
        "status" => @<span class="badge status-@Lookups.Badge(CrmLists.CompanyStatus, company.Status)">@Lookups.Label(CrmLists.CompanyStatus, company.Status)</span>,
        "city" => @<text>@company.City</text>,
        "owner" => @<OwnerCell Name="@Lookups.MemberName(company.OwnerId)" />,
        "phone" => @<text>@company.Phone</text>,
        "industry" => @<text>@company.Industry</text>,
        "taxNumber" => @<text>@company.TaxNumber</text>,
        "email" => @<text>@company.Email</text>,
        "tags" => @<text>@company.Tags</text>,
        _ when key.StartsWith("custom.", StringComparison.Ordinal) && Lookups.FieldsOf(CrmEntityKeys.Company).FirstOrDefault(f => "custom." + f.Key == key) is { } field =>
            @<text>@CustomFieldText.Format(field, company.Custom)</text>,
        _ => @<text></text>,
    };

    private void New() => Open(null);

    private void Edit(CompanyDto company) => Open(company);

    private void Open(CompanyDto? company)
    {
        selected = company;
        editing = true;
        message = null;
    }

    private void Close() => editing = false;

    private async Task SavedAsync()
    {
        editing = false;
        await LoadAsync(page?.Page ?? 1);
    }
}
