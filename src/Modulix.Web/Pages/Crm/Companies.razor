@page "/crm/firmalar"
@inject ApiClient Api
@inject SessionState Session

<PageTitle>Firmalar · Modulix</PageTitle>

<AuthGate Module="@CrmAccess.ModuleKey" Permission="@CrmAccess.CompaniesRead">
    <div class="page-header">
        <h1>Firmalar</h1>
        @if (Session.Can(CrmAccess.CompaniesWrite) && form is null)
        {
            <button type="button" class="btn btn-primary" @onclick="New">Yeni firma</button>
        }
    </div>

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }

    @if (form is not null)
    {
        <form class="record-form" novalidate @onsubmit="SaveAsync" @onsubmit:preventDefault>
            <h2>@(form.Id is null ? "Yeni firma" : "Firmayı düzenle")</h2>
            <div class="form-grid">
                <div>
                    <label class="form-label" for="name">Ad *</label>
                    <input id="name" class="form-control" maxlength="@CrmLimits.NameMaxLength" @bind="form.Name" />
                    <FieldError Field="name" Errors="errors" />
                </div>
                <div>
                    <label class="form-label" for="taxNumber">Vergi no</label>
                    <input id="taxNumber" class="form-control" maxlength="@CrmLimits.TaxNumberMaxLength" @bind="form.TaxNumber" />
                    <FieldError Field="taxNumber" Errors="errors" />
                </div>
                <div>
                    <label class="form-label" for="phone">Telefon</label>
                    <input id="phone" class="form-control" type="tel" maxlength="@CrmLimits.PhoneMaxLength" @bind="form.Phone" />
                    <FieldError Field="phone" Errors="errors" />
                </div>
                <div>
                    <label class="form-label" for="email">E-posta</label>
                    <input id="email" class="form-control" type="email" maxlength="@CrmLimits.EmailMaxLength" @bind="form.Email" />
                    <FieldError Field="email" Errors="errors" />
                </div>
                <div>
                    <label class="form-label" for="website">Web sitesi</label>
                    <input id="website" class="form-control" maxlength="@CrmLimits.TextMaxLength" @bind="form.Website" />
                    <FieldError Field="website" Errors="errors" />
                </div>
                <div>
                    <label class="form-label" for="city">Şehir</label>
                    <input id="city" class="form-control" maxlength="@CrmLimits.CityMaxLength" @bind="form.City" />
                    <FieldError Field="city" Errors="errors" />
                </div>
                <div class="span-all">
                    <label class="form-label" for="notes">Notlar</label>
                    <textarea id="notes" class="form-control" rows="3" maxlength="@CrmLimits.NotesMaxLength" @bind="form.Notes"></textarea>
                    <FieldError Field="notes" Errors="errors" />
                </div>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary" disabled="@busy">Kaydet</button>
                <button type="button" class="btn btn-outline-secondary" @onclick="Cancel">Vazgeç</button>
                @if (form.Id is not null)
                {
                    <button type="button" class="btn btn-outline-danger ms-auto" disabled="@busy" @onclick="DeleteAsync">Sil</button>
                }
            </div>
        </form>
    }

    <form class="search" @onsubmit="() => LoadAsync(1)" @onsubmit:preventDefault>
        <input class="form-control" type="search" placeholder="Ad, vergi no veya şehir ara" @bind="search" />
        <button type="submit" class="btn btn-outline-secondary">Ara</button>
    </form>

    @if (page is null)
    {
        <p class="text-muted">Yükleniyor…</p>
    }
    else if (page.Items.Count == 0)
    {
        <p class="text-muted">Kayıt yok.</p>
    }
    else
    {
        <table class="table record-table">
            <thead>
                <tr><th>Ad</th><th>Şehir</th><th>Telefon</th><th>E-posta</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var company in page.Items)
                {
                    <tr>
                        <td data-label="Ad" class="primary">@company.Name</td>
                        <td data-label="Şehir">@company.City</td>
                        <td data-label="Telefon">@company.Phone</td>
                        <td data-label="E-posta">@company.Email</td>
                        <td class="actions">
                            @if (Session.Can(CrmAccess.CompaniesWrite))
                            {
                                <button type="button" class="btn btn-outline-primary btn-sm" @onclick="() => Edit(company)">Düzenle</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager Page="page.Page" PageSize="page.PageSize" TotalCount="page.TotalCount" PageChanged="LoadAsync" />
    }
</AuthGate>

@code {
    private const string Url = "/api/crm/companies";

    private CrmPage<CompanyDto>? page;
    private CompanyForm? form;
    private IReadOnlyDictionary<string, string[]>? errors;
    private string? message;
    private string? search;
    private bool busy;

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (Session.Can(CrmAccess.CompaniesRead))
        {
            await LoadAsync(1);
        }
    }

    private async Task LoadAsync(int pageNumber)
    {
        var result = await Api.GetAsync<CrmPage<CompanyDto>>($"{Url}?page={pageNumber}&search={Uri.EscapeDataString(search ?? string.Empty)}");
        page = result.Value;
        message = result.Error;
    }

    private void New() => Open(new CompanyForm());

    private void Edit(CompanyDto company) => Open(new CompanyForm
    {
        Id = company.Id,
        Version = company.Version,
        Name = company.Name,
        TaxNumber = company.TaxNumber,
        Phone = company.Phone,
        Email = company.Email,
        Website = company.Website,
        City = company.City,
        Notes = company.Notes,
    });

    private void Open(CompanyForm value)
    {
        form = value;
        errors = null;
        message = null;
    }

    private void Cancel() => form = null;

    private async Task SaveAsync()
    {
        busy = true;
        var request = new SaveCompanyRequest(form!.Name, form.TaxNumber, form.Phone, form.Email, form.Website, form.City, form.Notes, form.Version);
        var result = form.Id is { } id
            ? await Api.PutAsync<CompanyDto>($"{Url}/{id}", request)
            : await Api.PostAsync<CompanyDto>(Url, request);
        busy = false;

        if (result.IsSuccess)
        {
            form = null;
            await LoadAsync(page?.Page ?? 1);
            return;
        }

        errors = result.FieldErrors;
        message = result.Error;
    }

    private async Task DeleteAsync()
    {
        busy = true;
        var result = await Api.DeleteAsync($"{Url}/{form!.Id}?version={form.Version}");
        busy = false;

        if (result.IsSuccess)
        {
            form = null;
            await LoadAsync(1);
            return;
        }

        message = result.Error;
    }

    private sealed class CompanyForm
    {
        public Guid? Id { get; init; }

        public long? Version { get; init; }

        public string Name { get; set; } = string.Empty;

        public string? TaxNumber { get; set; }

        public string? Phone { get; set; }

        public string? Email { get; set; }

        public string? Website { get; set; }

        public string? City { get; set; }

        public string? Notes { get; set; }
    }
}
