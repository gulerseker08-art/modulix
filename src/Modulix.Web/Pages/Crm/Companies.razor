@page "/crm/firmalar"
@inject ApiClient Api
@inject SessionState Session
@inject CrmLookups Lookups

<PageTitle>Firmalar · Modulix</PageTitle>

<AuthGate Module="@CrmAccess.ModuleKey" Permission="@CrmAccess.CompaniesRead">
    <div class="page-header">
        <h1>Firmalar</h1>
        @if (Session.Can(CrmAccess.CompaniesWrite) && !editing)
        {
            <button type="button" class="btn btn-primary" @onclick="New">Yeni firma</button>
        }
    </div>

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }

    @if (editing)
    {
        <CompanyEditor Company="selected" Lookups="Lookups" Saved="SavedAsync" Deleted="SavedAsync" Cancelled="Close" />
    }

    <div class="filters" role="group" aria-label="Durum">
        <button type="button" class="chip @(status is null && !mine ? "active" : null)" @onclick="() => FilterAsync(null, false)">Tümü</button>
        <button type="button" class="chip @(mine ? "active" : null)" @onclick="() => FilterAsync(null, true)">Benim firmalarım</button>
        @foreach (var value in Enum.GetValues<CompanyStatus>())
        {
            <button type="button" class="chip @(status == value ? "active" : null)" @onclick="() => FilterAsync(value, false)">@CrmLabels.Of(value)</button>
        }
    </div>

    <form class="search" @onsubmit="() => LoadAsync(1)" @onsubmit:preventDefault>
        <input class="form-control" type="search" placeholder="Ad, vergi no, şehir veya etiket ara" @bind="search" />
        <button type="submit" class="btn btn-outline-secondary">Ara</button>
    </form>

    @if (page is null)
    {
        <p class="text-muted">Yükleniyor…</p>
    }
    else if (page.Items.Count == 0)
    {
        <p class="text-muted">Kayıt yok.</p>
    }
    else
    {
        <table class="table record-table">
            <thead>
                <tr><th>Ad</th><th>Durum</th><th>Şehir</th><th>Sorumlu</th><th>Telefon</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var company in page.Items)
                {
                    <tr>
                        <td data-label="Ad" class="primary"><a href="crm/firmalar/@company.Id">@company.Name</a></td>
                        <td data-label="Durum"><span class="badge status-@company.Status.ToString().ToLowerInvariant()">@CrmLabels.Of(company.Status)</span></td>
                        <td data-label="Şehir">@company.City</td>
                        <td data-label="Sorumlu">@Lookups.MemberName(company.OwnerId)</td>
                        <td data-label="Telefon">@company.Phone</td>
                        <td class="actions">
                            @if (Session.Can(CrmAccess.CompaniesWrite))
                            {
                                <button type="button" class="btn btn-outline-primary btn-sm" @onclick="() => Edit(company)">Düzenle</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager Page="page.Page" PageSize="page.PageSize" TotalCount="page.TotalCount" PageChanged="LoadAsync" />
    }
</AuthGate>

@code {
    private const string Url = "/api/crm/companies";

    private CrmPage<CompanyDto>? page;
    private CompanyDto? selected;
    private bool editing;
    private string? message;
    private string? search;
    private CompanyStatus? status;
    private bool mine;

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (Session.Can(CrmAccess.CompaniesRead))
        {
            await Lookups.LoadAsync();
            await LoadAsync(1);
        }
    }

    private async Task FilterAsync(CompanyStatus? value, bool onlyMine)
    {
        status = value;
        mine = onlyMine;
        await LoadAsync(1);
    }

    private async Task LoadAsync(int pageNumber)
    {
        var url = $"{Url}?page={pageNumber}&search={Uri.EscapeDataString(search ?? string.Empty)}";
        if (status is { } s)
        {
            url += $"&status={s}";
        }

        if (mine)
        {
            url += "&ownerId=me";
        }

        var result = await Api.GetAsync<CrmPage<CompanyDto>>(url);
        page = result.Value;
        message = result.Error;
    }

    private void New() => Open(null);

    private void Edit(CompanyDto company) => Open(company);

    private void Open(CompanyDto? company)
    {
        selected = company;
        editing = true;
        message = null;
    }

    private void Close() => editing = false;

    private async Task SavedAsync()
    {
        editing = false;
        await LoadAsync(page?.Page ?? 1);
    }
}
