@page "/crm/indirimler"
@inject ApiClient Api
@inject SessionState Session

<PageTitle>@Texts.Get("crm.discountPolicies.title") · Modulix</PageTitle>

<AuthGate Module="@CrmAccess.ModuleKey" Permission="@CrmAccess.PricesRead">
    <div class="page-header">
        <h1>@Texts.Get("crm.discountPolicies.title")</h1>
        @if (Session.Can(CrmAccess.PricesWrite) && form is null)
        {
            <button type="button" class="btn btn-primary" @onclick="() => form = new()">@Texts.Get("crm.discountPolicies.newButton")</button>
        }
    </div>

    <p class="text-muted">@Texts.Get("crm.discountPolicies.help")</p>

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }

    @if (form is not null)
    {
        <form class="record-form" novalidate @onsubmit="SaveAsync" @onsubmit:preventDefault>
            <h2>@(form.Id is null ? Texts.Get("crm.discountPolicies.new") : Texts.Get("crm.discountPolicies.edit"))</h2>
            <FormTabs Title="@Texts.Get("crm.discountPolicies.info")" Label="@Texts.Get("crm.discountPolicies.formSections")">
            <div class="form-grid">
                <div>
                    <label class="form-label" for="name">@Texts.Get("common.field.nameRequired")</label>
                    <input id="name" class="form-control" maxlength="150" @bind="form.Name" />
                    <FieldError Field="name" Errors="errors" />
                </div>
                <div>
                    <label class="form-label" for="kind">@Texts.Get("common.field.kind")</label>
                    <select id="kind" class="form-select" @bind="form.ByAmount">
                        <option value="False">@Texts.Get("crm.discountPolicies.kind.percent")</option>
                        <option value="True">@Texts.Get("crm.quote-discount.amount")</option>
                    </select>
                </div>
                @if (form.ByAmount)
                {
                    <div>
                        <label class="form-label" for="amount">@Texts.Get("crm.discountPolicies.field.amount")</label>
                        <input id="amount" class="form-control" type="number" step="0.01" min="0" @bind="form.Amount" />
                        <FieldError Field="amount" Errors="errors" />
                    </div>
                    <div>
                        <label class="form-label" for="currency">@Texts.Get("common.field.currencyRequired")</label>
                        <input id="currency" class="form-control" maxlength="3" @bind="form.Currency" />
                        <FieldError Field="currency" Errors="errors" />
                    </div>
                }
                else
                {
                    <div>
                        <label class="form-label" for="percent">@Texts.Get("crm.discountPolicies.field.percent")</label>
                        <input id="percent" class="form-control" type="number" step="any" min="0" max="100" @bind="form.Percent" />
                        <FieldError Field="percent" Errors="errors" />
                    </div>
                }
                <div>
                    <label class="form-label" for="priority">@Texts.Get("crm.discountPolicies.field.priority")</label>
                    <input id="priority" class="form-control" type="number" min="0" @bind="form.Priority" />
                    <FieldError Field="priority" Errors="errors" />
                </div>
                <div>
                    <label class="form-label" for="stackable">@Texts.Get("crm.discountPolicies.field.stackable")</label>
                    <select id="stackable" class="form-select" @bind="form.Stackable">
                        <option value="True">@Texts.Get("common.yes")</option>
                        <option value="False">@Texts.Get("common.no")</option>
                    </select>
                </div>
                <div>
                    <label class="form-label" for="maxTotal">@Texts.Get("crm.discountPolicies.field.maxTotal")</label>
                    <input id="maxTotal" class="form-control" type="number" step="any" min="0" max="100" @bind="form.MaxTotalPercent" />
                    <FieldError Field="maxTotalPercent" Errors="errors" />
                </div>
                <div>
                    <label class="form-label" for="approval">@Texts.Get("crm.discountPolicies.field.approval")</label>
                    <input id="approval" class="form-control" type="number" step="any" min="0" max="100" @bind="form.ApprovalAbovePercent" />
                    <FieldError Field="approvalAbovePercent" Errors="errors" />
                </div>
                <div>
                    <label class="form-label" for="from">@Texts.Get("crm.priceLists.field.validFrom")</label>
                    <input id="from" class="form-control" type="date" @bind="form.ValidFrom" />
                    <FieldError Field="validFrom" Errors="errors" />
                </div>
                <div>
                    <label class="form-label" for="to">@Texts.Get("crm.discountPolicies.field.validTo")</label>
                    <input id="to" class="form-control" type="date" @bind="form.ValidTo" />
                    <FieldError Field="validTo" Errors="errors" />
                </div>
                <div>
                    <label class="form-label" for="active">@Texts.Get("common.field.status")</label>
                    <select id="active" class="form-select" @bind="form.IsActive">
                        <option value="True">@Texts.Get("common.active")</option>
                        <option value="False">@Texts.Get("common.inactive")</option>
                    </select>
                </div>
            </div>
            </FormTabs>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary" disabled="@busy">@Texts.Get("common.save")</button>
                <button type="button" class="btn btn-outline-secondary" @onclick="() => form = null">@Texts.Get("common.dismiss")</button>
                @if (form.Id is not null)
                {
                    <button type="button" class="btn btn-outline-danger ms-auto" disabled="@busy" @onclick="DeleteAsync">@Texts.Get("common.delete")</button>
                }
            </div>
        </form>
    }

    @if (policies is null)
    {
        <p class="text-muted">@Texts.Get("common.loading")</p>
    }
    else if (policies.Count == 0)
    {
        <p class="text-muted">@Texts.Get("crm.discountPolicies.none")</p>
    }
    else
    {
        <table class="table record-table">
            <thead><tr><th>@Texts.Get("common.field.name")</th><th>@Texts.Get("crm.discountPolicies.col.discount")</th><th>@Texts.Get("crm.discountPolicies.col.priority")</th><th>@Texts.Get("crm.discountPolicies.col.limits")</th><th>@Texts.Get("common.field.status")</th><th></th></tr></thead>
            <tbody>
                @foreach (var policy in policies)
                {
                    <tr>
                        <td data-label="@Texts.Get("common.field.name")" class="primary">@policy.Name</td>
                        <td data-label="@Texts.Get("crm.discountPolicies.col.discount")">@(policy.Percent is { } p ? $"%{p}" : $"{policy.Amount} {policy.Currency}")</td>
                        <td data-label="@Texts.Get("crm.discountPolicies.col.priority")">@policy.Priority@(policy.Stackable ? null : " · " + Texts.Get("crm.discountPolicies.notStackable"))</td>
                        <td data-label="@Texts.Get("crm.discountPolicies.col.limits")">@Limits(policy)</td>
                        <td data-label="@Texts.Get("common.field.status")">@(policy.IsActive ? Texts.Get("common.active") : Texts.Get("common.inactive"))</td>
                        <td class="actions">
                            @if (Session.Can(CrmAccess.PricesWrite))
                            {
                                <button type="button" class="btn btn-outline-primary btn-sm" @onclick="() => Edit(policy)">@Texts.Get("common.edit")</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</AuthGate>

@code {
    private const string Url = "/api/crm/discount-policies";

    private List<DiscountPolicyDto>? policies;
    private PolicyForm? form;
    private IReadOnlyDictionary<string, string[]>? errors;
    private string? message;
    private bool busy;

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (Session.Can(CrmAccess.PricesRead))
        {
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        var (loaded, error) = await Api.GetAllAsync<DiscountPolicyDto>(Url);
        policies = loaded;
        message = error;
    }

    private static string Limits(DiscountPolicyDto policy)
    {
        var parts = new List<string>();
        if (policy.MaxTotalPercent is { } max)
        {
            parts.Add(Texts.Get("crm.discountPolicies.limit.max", max.ToString()));
        }

        if (policy.ApprovalAbovePercent is { } approval)
        {
            parts.Add(Texts.Get("crm.discountPolicies.limit.approval", approval.ToString()));
        }

        if (policy.ValidFrom is not null || policy.ValidTo is not null)
        {
            parts.Add($"{policy.ValidFrom?.ToString("yyyy-MM-dd") ?? "…"} → {policy.ValidTo?.ToString("yyyy-MM-dd") ?? "…"}");
        }

        return parts.Count == 0 ? "—" : string.Join(" · ", parts);
    }

    private void Edit(DiscountPolicyDto policy)
    {
        form = new PolicyForm
        {
            Id = policy.Id, Version = policy.Version, Name = policy.Name, ByAmount = policy.Amount is not null, Percent = policy.Percent,
            Amount = policy.Amount, Currency = policy.Currency ?? "TRY", Priority = policy.Priority, Stackable = policy.Stackable,
            MaxTotalPercent = policy.MaxTotalPercent, ApprovalAbovePercent = policy.ApprovalAbovePercent,
            ValidFrom = policy.ValidFrom?.ToDateTime(TimeOnly.MinValue), ValidTo = policy.ValidTo?.ToDateTime(TimeOnly.MinValue), IsActive = policy.IsActive,
        };
        errors = null;
        message = null;
    }

    private async Task SaveAsync()
    {
        busy = true;
        var f = form!;
        var request = new SaveDiscountPolicyRequest(
            f.Name, f.ByAmount ? null : f.Percent, f.ByAmount ? f.Amount : null, f.ByAmount ? f.Currency : null, f.Priority, f.Stackable,
            f.MaxTotalPercent, f.ApprovalAbovePercent, f.ValidFrom is { } from ? DateOnly.FromDateTime(from) : null,
            f.ValidTo is { } to ? DateOnly.FromDateTime(to) : null, f.IsActive, f.Version);
        var result = f.Id is { } id
            ? await Api.PutAsync<DiscountPolicyDto>($"{Url}/{id}", request)
            : await Api.PostAsync<DiscountPolicyDto>(Url, request);
        busy = false;

        if (result.IsSuccess)
        {
            form = null;
            errors = null;
            message = null;
            await LoadAsync();
            return;
        }

        errors = result.FieldErrors;
        message = result.Error;
    }

    private async Task DeleteAsync()
    {
        busy = true;
        var result = await Api.DeleteAsync($"{Url}/{form!.Id}?version={form.Version}");
        busy = false;
        message = result.Error;
        if (result.IsSuccess)
        {
            form = null;
            await LoadAsync();
        }
    }

    private sealed class PolicyForm
    {
        public Guid? Id { get; init; }

        public long? Version { get; init; }

        public string Name { get; set; } = string.Empty;

        public bool ByAmount { get; set; }

        public decimal? Percent { get; set; }

        public decimal? Amount { get; set; }

        public string Currency { get; set; } = "TRY";

        public int Priority { get; set; }

        public bool Stackable { get; set; } = true;

        public decimal? MaxTotalPercent { get; set; }

        public decimal? ApprovalAbovePercent { get; set; }

        public DateTime? ValidFrom { get; set; }

        public DateTime? ValidTo { get; set; }

        public bool IsActive { get; set; } = true;
    }
}
