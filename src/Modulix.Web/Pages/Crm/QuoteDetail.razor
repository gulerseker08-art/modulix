@page "/crm/teklifler/yeni"
@page "/crm/teklifler/{Id:guid}"
@using System.Text.Json
@inject ApiClient Api
@inject SessionState Session
@inject CrmLookups Lookups
@inject NavigationManager Navigation
@inject IJSRuntime Js

<PageTitle>@(quote?.Title ?? Texts.Get("crm.quotes.new")) · Modulix</PageTitle>

<NavigationLock ConfirmExternalNavigation="@(dirty || lineDirty)" OnBeforeInternalNavigation="ConfirmLeaveAsync" />

<AuthGate Module="@CrmAccess.ModuleKey" Permission="@CrmAccess.QuotesRead">
    @if (notFound)
    {
        <div class="alert alert-warning" role="alert">@Texts.Get("crm.quoteCompare.notFound") <a href="crm/teklifler">@Texts.Get("crm.quoteCompare.backToList")</a></div>
    }
    else if (Id is not null && quote is null)
    {
        <LoadingState />
    }
    else
    {
        <div class="page-header">
            <div>
                <h1>@(quote?.Title ?? Texts.Get("crm.quotes.new"))</h1>
                @if (quote is not null)
                {
                    <p class="text-muted mb-0">
                        @if (isPrimaryQuote) { <span class="badge stage-won">@Texts.Get("crm.quoteDetail.primaryBadge")</span> }
                        @quote.QuoteNumber · @Texts.Get("crm.quoteDetail.revision", quote.RevisionNo)
                        <span class="badge stage-@QuoteLabels.StatusBadge(quote.Status)">@QuoteLabels.Label(QuoteLabels.Statuses, quote.Status)</span>
                        <span class="badge stage-@QuoteLabels.ApprovalBadge(quote.ApprovalStatus)">@QuoteLabels.Label(QuoteLabels.Approvals, quote.ApprovalStatus)</span>
                        <span class="badge stage-open">@QuoteLabels.Label(QuoteLabels.Deliveries, quote.DeliveryStatus)</span>
                    </p>
                }
            </div>
            <div class="header-actions">
                <a class="btn btn-outline-secondary" href="crm/teklifler">@Texts.Get("crm.quoteDetail.backToList")</a>
            </div>
        </div>

        <Notice Text="@notice" Failed="@noticeFailed" />

        @if (quote is not null && !Draft)
        {
            <div class="alert alert-info" role="status">
                @Texts.Strong("crm.quoteDetail.readOnly", QuoteLabels.Label(QuoteLabels.Statuses, quote.Status).ToLowerInvariant())
                @Texts.Get("crm.quoteDetail.readOnlyHelp")
                @if (!string.IsNullOrWhiteSpace(quote.StatusReason)) { <span> @Texts.Get("crm.quoteShare.reason", quote.StatusReason)</span> }
            </div>
        }

        <form class="record-form" novalidate @onsubmit="SaveAsync" @onsubmit:preventDefault>
            <TabBar Tabs="HeaderTabs" State="headerTabs" Label="@Texts.Get("crm.quoteDetail.formSections")" />
            <fieldset disabled="@(!CanEditHeader || busy)">
                <legend class="visually-hidden">@Texts.Get("crm.quoteDetail.generalInfo")</legend>
                @if (errors is { Count: > 0 })
                {
                    <div class="alert alert-danger" role="alert">
                        <strong>@Texts.Get("common.errorSummary")</strong>
                        <ul class="mb-0">
                            @foreach (var (field, messages) in errors)
                            {
                                foreach (var text in messages) { <li>@text</li> }
                            }
                        </ul>
                    </div>
                }
                <TabPanel State="headerTabs" Key="form-genel">
                <div class="form-grid" @oninput="() => dirty = true">
                    <div class="span-all">
                        <label class="form-label" for="q-title">@Texts.Get("crm.quoteDetail.field.title")</label>
                        <input id="q-title" class="form-control" maxlength="200" @bind="form.Title" aria-invalid="@(errors?.ContainsKey("title") == true)" />
                        <FieldError Field="title" Errors="errors" />
                    </div>
                    <div>
                        <label class="form-label" for="companyId">@Texts.Get("crm.quoteDetail.field.company")</label>
                        <LookupPicker Id="companyId" LookupKey="crm.quote.company" @bind-Value="form.CompanyId" Required="true"
                                      Invalid="@(errors?.ContainsKey("companyId") == true)" ReadOnly="@(!CanEditHeader)" />
                        <FieldError Field="companyId" Errors="errors" />
                    </div>
                    <div>
                        <label class="form-label" for="contactId">@Texts.Get("crm.quoteDetail.field.contact")</label>
                        <LookupPicker Id="contactId" LookupKey="crm.quote.contact" @bind-Value="form.ContactId" ParentId="form.CompanyId" Placeholder="—"
                                      Invalid="@(errors?.ContainsKey("contactId") == true)" ReadOnly="@(!CanEditHeader)" />
                        <FieldError Field="contactId" Errors="errors" />
                    </div>
                    <div>
                        <label class="form-label" for="opportunityId">@Texts.Get("crm.quoteDetail.field.opportunity")</label>
                        <LookupPicker Id="opportunityId" LookupKey="crm.quote.opportunity" @bind-Value="form.OpportunityId" ParentId="form.CompanyId" Placeholder="—"
                                      Invalid="@(errors?.ContainsKey("opportunityId") == true)" ReadOnly="@(!CanEditHeader)" />
                        <FieldError Field="opportunityId" Errors="errors" />
                    </div>
                    <div>
                        <label class="form-label" for="ownerId">@Texts.Get("common.field.owner")</label>
                        <LookupPicker Id="ownerId" LookupKey="crm.quote.owner" @bind-Value="form.OwnerId" Placeholder="@(quote is null ? Texts.Get("common.me") : "—")" ReadOnly="@(!CanEditHeader)" />
                    </div>
                </div>
                </TabPanel>
                <TabPanel State="headerTabs" Key="form-fiyat">
                <div class="form-grid" @oninput="() => dirty = true">
                    <div>
                        <label class="form-label" for="priceListId">@Texts.Get("crm.quoteDetail.field.priceList")</label>
                        <LookupPicker Id="priceListId" LookupKey="crm.quote.price-list" @bind-Value="form.PriceListId" Placeholder="@Texts.Get("crm.quoteDetail.field.priceListPlaceholder")"
                                      Invalid="@(errors?.ContainsKey("priceListId") == true)" ReadOnly="@(!CanEditHeader)" />
                        <FieldError Field="priceListId" Errors="errors" />
                    </div>
                    <div>
                        <label class="form-label" for="q-currency">@Texts.Get("crm.quoteDetail.field.currency")</label>
                        <input id="q-currency" class="form-control" maxlength="3" @bind="form.Currency" />
                        <FieldError Field="currency" Errors="errors" />
                    </div>
                    <div>
                        <label class="form-label" for="q-valid">@Texts.Get("crm.quoteDetail.field.validUntil")</label>
                        <input id="q-valid" type="datetime-local" class="form-control" @bind="form.ValidUntil" />
                        <FieldError Field="validUntil" Errors="errors" />
                        @if (quote is null && defaultValidityDays > 0) { <small class="text-muted">@Texts.Get("crm.quoteDetail.validityHint", defaultValidityDays)</small> }
                    </div>
                    <div>
                        <label class="form-label" for="q-tax">@Texts.Get("crm.quoteDetail.field.pricing")</label>
                        <select id="q-tax" class="form-select" @bind="form.PriceIncludesTax">
                            <option value="@false">@Texts.Get("crm.quoteDetail.taxExcluded")</option>
                            <option value="@true">@Texts.Get("crm.quoteDetail.taxIncluded")</option>
                        </select>
                        <FieldError Field="priceIncludesTax" Errors="errors" />
                    </div>
                    @if (Session.Can(CrmAccess.QuotesDiscount) || (quote?.DocumentDiscountKind ?? "None") != "None")
                    {
                        <div>
                            <label class="form-label" for="q-dk">@Texts.Get("crm.quoteDetail.field.documentDiscount")</label>
                            <select id="q-dk" class="form-select" @bind="form.DocumentDiscountKind" disabled="@(!Session.Can(CrmAccess.QuotesDiscount))">
                                @foreach (var kind in QuoteLabels.DiscountKinds) { <option value="@kind.Key">@kind.Label</option> }
                            </select>
                        </div>
                        <div>
                            <label class="form-label" for="q-dv">@Texts.Get("crm.quoteDetail.field.documentDiscountValue")</label>
                            <input id="q-dv" type="number" step="0.01" min="0" class="form-control" @bind="form.DocumentDiscountValue"
                                   disabled="@(!Session.Can(CrmAccess.QuotesDiscount) || form.DocumentDiscountKind == "None")" />
                            <FieldError Field="documentDiscountValue" Errors="errors" />
                        </div>
                    }
                </div>
                </TabPanel>
                <TabPanel State="headerTabs" Key="form-kosul">
                <div class="form-grid" @oninput="() => dirty = true">
                    <div class="span-all">
                        <label class="form-label" for="q-pay">@Texts.Get("crm.quoteDetail.field.paymentTerms")</label>
                        <textarea id="q-pay" class="form-control" rows="2" maxlength="4000" @bind="form.PaymentTerms"></textarea>
                    </div>
                    <div class="span-all">
                        <label class="form-label" for="q-del">@Texts.Get("crm.quoteDetail.field.deliveryTerms")</label>
                        <textarea id="q-del" class="form-control" rows="2" maxlength="4000" @bind="form.DeliveryTerms"></textarea>
                    </div>
                    <div class="span-all">
                        <label class="form-label" for="q-com">@Texts.Get("crm.quoteDetail.field.commercialTerms")</label>
                        <textarea id="q-com" class="form-control" rows="3" maxlength="4000" @bind="form.CommercialTerms"></textarea>
                    </div>
                    <div class="span-all">
                        <label class="form-label" for="q-int">@Texts.Get("crm.quoteDetail.field.internalNotes") <small class="text-muted">@Texts.Get("crm.quoteDetail.field.internalNotesHint")</small></label>
                        <textarea id="q-int" class="form-control" rows="2" maxlength="4000" @bind="form.InternalNotes"></textarea>
                    </div>
                </div>
                </TabPanel>
            </fieldset>
            @if (CanEditHeader)
            {
                <div class="form-actions">
                    <button type="submit" class="btn btn-primary" disabled="@busy">@(quote is null ? Texts.Get("crm.quoteDetail.createDraft") : Texts.Get("common.save"))</button>
                    @if (dirty) { <span class="text-muted" role="status">@Texts.Get("crm.quoteDetail.unsaved")</span> }
                </div>
            }
        </form>

        @if (quote is not null)
        {
            <section aria-labelledby="lines-title">
                <h2 id="lines-title">@Texts.Get("crm.quoteCompare.lines")</h2>
                @if (Draft && Session.Can(CrmAccess.QuotesWrite) && lineForm is null)
                {
                    <button type="button" class="btn btn-outline-primary" @onclick="NewLine">@Texts.Get("crm.quoteDetail.addLine")</button>
                }

                @if (lineForm is not null)
                {
                    <form class="record-form" novalidate @onsubmit="SaveLineAsync" @onsubmit:preventDefault>
                        <h3>@(lineForm.Id is null ? Texts.Get("crm.quoteDetail.newLine") : Texts.Get("crm.quoteDetail.editLine"))</h3>
                        @if (lineMessage is not null) { <div class="alert alert-danger" role="alert">@lineMessage</div> }
                        <TabBar Tabs="LineTabs" State="lineTabs" Label="@Texts.Get("crm.quoteDetail.lineSections")" />
                        <TabPanel State="lineTabs" Key="line-kalem">
                        <div class="form-grid" @oninput="() => lineDirty = true">
                            <div>
                                <label class="form-label" for="l-kind">@Texts.Get("crm.quoteDetail.line.kind")</label>
                                <select id="l-kind" class="form-select" @bind="lineForm.Kind">
                                    @foreach (var kind in QuoteLabels.LineKinds.Where(k => k.Key != "Free" || Session.Can(CrmAccess.QuotesManualPrice)))
                                    {
                                        <option value="@kind.Key">@kind.Label</option>
                                    }
                                </select>
                                <FieldError Field="kind" Errors="lineErrors" />
                            </div>
                            @if (lineForm.Kind != "Free")
                            {
                                <div>
                                    <label class="form-label" for="l-product">@Texts.Get("crm.quoteDetail.line.product")</label>
                                    <LookupPicker Id="l-product" LookupKey="crm.quote-line.product" @bind-Value="lineForm.ProductId" Placeholder="@Texts.Get("crm.quoteDetail.line.productPlaceholder")"
                                                  Invalid="@(lineErrors?.ContainsKey("productId") == true)" />
                                    <FieldError Field="productId" Errors="lineErrors" />
                                </div>
                            }
                            <div>
                                <label class="form-label" for="l-name">@(lineForm.ProductId is null ? Texts.Get("crm.quoteDetail.line.nameRequired") : Texts.Get("crm.quoteDetail.line.nameFromProduct"))</label>
                                <input id="l-name" class="form-control" maxlength="200" @bind="lineForm.Name" />
                                <FieldError Field="name" Errors="lineErrors" />
                            </div>
                            <div>
                                <label class="form-label" for="l-qty">@Texts.Get("crm.quoteDetail.line.quantity")</label>
                                <input id="l-qty" type="number" step="any" min="0" class="form-control" @bind="lineForm.Quantity" />
                                <FieldError Field="quantity" Errors="lineErrors" />
                            </div>
                            <div>
                                <label class="form-label" for="l-price">@(lineForm.ProductId is not null ? Texts.Get("crm.quoteDetail.line.unitPriceFromList") : Texts.Get("crm.quoteDetail.line.unitPriceRequired"))</label>
                                <input id="l-price" type="number" step="any" min="0" class="form-control" @bind="lineForm.UnitPrice"
                                       disabled="@(lineForm.ProductId is not null && !Session.Can(CrmAccess.QuotesManualPrice))" />
                                <FieldError Field="unitPrice" Errors="lineErrors" />
                            </div>
                            <div class="span-all">
                                <label class="form-label" for="l-desc">@Texts.Get("crm.quoteDetail.line.description")</label>
                                <textarea id="l-desc" class="form-control" rows="2" maxlength="2000" @bind="lineForm.Description"></textarea>
                            </div>
                        </div>
                        </TabPanel>
                        <TabPanel State="lineTabs" Key="line-vergi">
                        <div class="form-grid" @oninput="() => lineDirty = true">
                            <div>
                                <label class="form-label" for="l-tax">@Texts.Get("crm.quoteDetail.line.taxRate")</label>
                                <input id="l-tax" type="number" step="any" min="0" max="100" class="form-control" @bind="lineForm.TaxRatePercent"
                                       disabled="@(lineForm.ProductId is not null)" />
                                <FieldError Field="taxRatePercent" Errors="lineErrors" />
                            </div>
                            @if (Session.Can(CrmAccess.QuotesDiscount))
                            {
                                <div>
                                    <label class="form-label" for="l-dk">@Texts.Get("crm.quoteDetail.line.discount")</label>
                                    <select id="l-dk" class="form-select" @bind="lineForm.DiscountKind">
                                        @foreach (var kind in QuoteLabels.DiscountKinds) { <option value="@kind.Key">@kind.Label</option> }
                                    </select>
                                </div>
                                <div>
                                    <label class="form-label" for="l-dv">@Texts.Get("crm.quoteDetail.line.discountValue")</label>
                                    <input id="l-dv" type="number" step="0.01" min="0" class="form-control" @bind="lineForm.DiscountValue" disabled="@(lineForm.DiscountKind == "None")" />
                                    <FieldError Field="discountValue" Errors="lineErrors" />
                                </div>
                            }
                            <div>
                                <label class="form-label" for="l-period">@Texts.Get("crm.quoteDetail.line.billing")</label>
                                <select id="l-period" class="form-select" @bind="lineForm.RecurringPeriod">
                                    @foreach (var period in QuoteLabels.Periods) { <option value="@period.Key">@period.Label</option> }
                                </select>
                                <FieldError Field="recurringPeriod" Errors="lineErrors" />
                            </div>
                            @if (Session.Can(CrmAccess.QuoteCostsRead))
                            {
                                <div>
                                    <label class="form-label" for="l-cost">@Texts.Get("crm.quoteDetail.line.unitCost") <small class="text-muted">@Texts.Get("crm.quoteDetail.line.authorizedOnly")</small></label>
                                    <input id="l-cost" type="number" step="any" min="0" class="form-control" @bind="lineForm.UnitCost" />
                                </div>
                            }
                        </div>
                        </TabPanel>
                        <TabPanel State="lineTabs" Key="line-rol">
                        <div class="form-grid" @oninput="() => lineDirty = true">
                            <div>
                                <label class="form-label" for="l-role">@Texts.Get("crm.quoteDetail.line.role")</label>
                                <select id="l-role" class="form-select" @bind="lineForm.Role">
                                    @foreach (var role in QuoteLabels.Roles) { <option value="@role.Key">@role.Label</option> }
                                </select>
                            </div>
                            @if (lineForm.Role == "PackageChild")
                            {
                                <div>
                                    <label class="form-label" for="l-parent">@Texts.Get("crm.quoteDetail.line.parent")</label>
                                    <select id="l-parent" class="form-select" @bind="lineForm.ParentStableKey">
                                        <option value="">—</option>
                                        @foreach (var package in lines.Where(l => l.Role != "PackageChild" && l.Id != lineForm.Id))
                                        {
                                            <option value="@package.StableKey">@package.Name</option>
                                        }
                                    </select>
                                    <FieldError Field="parentStableKey" Errors="lineErrors" />
                                </div>
                            }
                            @if (lineForm.Role is "Optional" or "Alternative")
                            {
                                <div class="form-check">
                                    <input id="l-sel" type="checkbox" class="form-check-input" @bind="lineForm.IsSelected" />
                                    <label class="form-check-label" for="l-sel">@Texts.Get("crm.quoteDetail.line.selected")</label>
                                </div>
                            }
                        </div>
                        </TabPanel>
                        <div class="form-actions">
                            <button type="submit" class="btn btn-primary" disabled="@busy">@Texts.Get("crm.quoteDetail.line.save")</button>
                            <button type="button" class="btn btn-outline-secondary" @onclick="CancelLine">@Texts.Get("common.dismiss")</button>
                        </div>
                    </form>
                }

                @if (lines.Count == 0)
                {
                    <EmptyState Title="@Texts.Get("crm.quoteDetail.noLines")" />
                }
                else
                {
                    <table class="table record-table">
                        <caption class="visually-hidden">@Texts.Get("crm.quoteDetail.linesCaption")</caption>
                        <thead>
                            <tr>
                                <th scope="col">#</th><th scope="col">@Texts.Get("crm.quoteDetail.col.line")</th><th scope="col" class="text-end">@Texts.Get("crm.quoteDetail.col.quantity")</th><th scope="col" class="text-end">@Texts.Get("crm.quoteDetail.col.unitPrice")</th>
                                <th scope="col" class="text-end">@Texts.Get("crm.quoteDetail.line.discount")</th><th scope="col" class="text-end">@Texts.Get("crm.quoteDetail.col.tax")</th><th scope="col" class="text-end">@Texts.Get("crm.quoteDetail.col.net")</th>
                                <th scope="col" class="text-end">@Texts.Get("crm.quotes.col.total")</th>
                                @if (ShowCost) { <th scope="col" class="text-end">@Texts.Get("crm.quoteDetail.col.cost")</th> }
                                <th scope="col"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var line in lines)
                            {
                                <tr class="@(line.Included ? null : "text-muted")">
                                    <td data-label="#">@line.Position</td>
                                    <td data-label="@Texts.Get("crm.quoteDetail.col.line")" class="primary">
                                        @if (line.Role == "PackageChild") { <span aria-hidden="true">↳ </span> }
                                        @line.Name
                                        @if (!string.IsNullOrWhiteSpace(line.ProductCode)) { <small class="text-muted">@line.ProductCode</small> }
                                        @if (line.Role != "Standard" && line.Role != "PackageChild")
                                        {
                                            <span class="badge stage-onhold">@QuoteLabels.Label(QuoteLabels.Roles, line.Role) · @(line.Included ? Texts.Get("crm.quoteDetail.selectedBadge") : Texts.Get("crm.quoteDetail.notInTotalBadge"))</span>
                                        }
                                        @if (line.Role == "PackageChild") { <span class="badge stage-open">@Texts.Get("crm.quoteDetail.packageChildBadge")</span> }
                                        @if (!string.IsNullOrEmpty(line.RecurringPeriod)) { <span class="badge stage-qualified">@QuoteLabels.Label(QuoteLabels.Periods, line.RecurringPeriod)</span> }
                                        @if (!string.IsNullOrWhiteSpace(line.Description)) { <div class="small text-muted">@line.Description</div> }
                                    </td>
                                    <td data-label="@Texts.Get("crm.quoteDetail.col.quantity")" class="text-end">@line.Quantity.ToString("0.######")@(string.IsNullOrWhiteSpace(line.UnitName) ? null : " " + line.UnitName)</td>
                                    <td data-label="@Texts.Get("crm.quoteDetail.col.unitPrice")" class="text-end">@line.UnitPrice.ToString("N2")</td>
                                    <td data-label="@Texts.Get("crm.quoteDetail.line.discount")" class="text-end">@((line.LineDiscount + line.DocumentDiscountShare).ToString("N2"))</td>
                                    <td data-label="@Texts.Get("crm.quoteDetail.col.tax")" class="text-end">@line.TaxRatePercent.ToString("0.##")</td>
                                    <td data-label="@Texts.Get("crm.quoteDetail.col.net")" class="text-end">@(line.Role == "PackageChild" ? "—" : line.Net.ToString("N2"))</td>
                                    <td data-label="@Texts.Get("crm.quotes.col.total")" class="text-end">@(line.Role == "PackageChild" ? "—" : line.Gross.ToString("N2"))</td>
                                    @if (ShowCost) { <td data-label="@Texts.Get("crm.quoteDetail.col.cost")" class="text-end">@(line.UnitCost is { } cost ? cost.ToString("N2") : "—")</td> }
                                    <td class="actions">
                                        @if (Draft && Session.Can(CrmAccess.QuotesWrite))
                                        {
                                            <button type="button" class="btn btn-outline-primary btn-sm" @onclick="() => EditLine(line)" aria-label="@Texts.Get("crm.quoteDetail.editLineOf", line.Name)">@Texts.Get("common.edit")</button>
                                            <ConfirmAction Disabled="@busy" AriaLabel="@Texts.Get("crm.quoteDetail.deleteLineOf", line.Name)" OnConfirm="() => DeleteLineAsync(line)">@Texts.Get("common.delete")</ConfirmAction>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </section>

            <section aria-labelledby="totals-title" class="quote-totals">
                <h2 id="totals-title">@Texts.Get("crm.quoteDetail.totals.title") <small class="text-muted">@Texts.Get("crm.quoteDetail.totals.note", quote.Currency)</small></h2>
                <dl class="summary-list">
                    <div><dt>@Texts.Get("crm.quoteDetail.totals.list")</dt><dd>@QuoteLabels.Money(quote.ListTotal, quote.Currency)</dd></div>
                    <div><dt>@Texts.Get("crm.quoteDetail.totals.discounts")</dt><dd>@QuoteLabels.Money(quote.DiscountTotal, quote.Currency)</dd></div>
                    <div><dt>@Texts.Get("crm.quoteDetail.totals.net")</dt><dd>@QuoteLabels.Money(quote.NetTotal, quote.Currency)</dd></div>
                    <div><dt>@Texts.Get("crm.quoteDetail.totals.tax")</dt><dd>@QuoteLabels.Money(quote.TaxTotal, quote.Currency)</dd></div>
                    <div><dt><strong>@Texts.Get("crm.quoteDetail.totals.gross")</strong></dt><dd><strong>@QuoteLabels.Money(quote.GrossTotal, quote.Currency)</strong></dd></div>
                    @if (quote.OptionalNet > 0)
                    {
                        <div><dt>@Texts.Get("crm.quoteDetail.totals.optional")</dt><dd>@QuoteLabels.Money(quote.OptionalNet, quote.Currency)</dd></div>
                    }
                    @foreach (var period in Recurring())
                    {
                        <div><dt>@Texts.Get("crm.quoteDetail.totals.recurring", QuoteLabels.Label(QuoteLabels.Periods, period.Period))</dt><dd>@QuoteLabels.Money(period.Gross, quote.Currency)</dd></div>
                    }
                </dl>
                @if (quote.CalculatedAt is { } calculated) { <small class="text-muted">@Texts.Get("crm.quoteDetail.totals.calculatedAt", CrmLabels.Time(calculated))</small> }
            </section>

            @* Hizmet kapsamı (ADR-0029 Dilim F3): sunum anında bağlı fırsattan, adlarıyla sabitlenir; sonradan fırsat ya da katalog değişse de aynı kalır. *@
            @if (quote.ServiceScopeSnapshot is { Count: > 0 } scopeSnapshot)
            {
                <section aria-labelledby="scope-title">
                    <h2 id="scope-title">@Texts.Get("crm.quoteDetail.scope.title") <small class="text-muted">@Texts.Get("crm.quoteDetail.scope.note")</small></h2>
                    <p>
                        @foreach (var item in scopeSnapshot)
                        {
                            <span class="badge tag">@item.Name</span>
                        }
                    </p>
                </section>
            }

            <section aria-labelledby="actions-title">
                <h2 id="actions-title">@Texts.Get("crm.quoteDetail.actions.title")</h2>
                @if (requirement is { Required: true })
                {
                    <div class="alert alert-info" role="status">
                        <strong>@Texts.Get("crm.quoteDetail.approvalRequired")</strong>
                        <ul class="mb-0">
                            @foreach (var match in requirement.Matches)
                            {
                                <li>@match.Name — @match.Reason</li>
                            }
                            @if (requirement.ThresholdReason is not null) { <li>@requirement.ThresholdReason</li> }
                        </ul>
                        @if (requirement.Steps.Count > 1)
                        {
                            <div class="small">@Texts.Get("crm.quoteDetail.approvalSteps", string.Join(" → ", requirement.Steps.Select(s => $"{s.Step}. {(s.Approvers.Count == 0 ? Texts.Get("crm.quoteDetail.anyone") : string.Join("/", s.Approvers.Select(a => Lookups.MemberName(a))))}{(s.Completed ? " ✓" : string.Empty)}")))</div>
                        }
                        @if (requirement.Note is not null) { <div class="small">@requirement.Note</div> }
                    </div>
                }
                @if (reasonAction is not null)
                {
                    <form class="record-form" novalidate @onsubmit="ConfirmReasonAsync" @onsubmit:preventDefault>
                        <label class="form-label" for="reason">@Texts.Get("crm.quoteDetail.reasonFor", reasonAction == "revise" ? Texts.Get("crm.quoteDetail.revise") : QuoteLabels.Action(reasonAction))</label>
                        <textarea id="reason" class="form-control" rows="2" maxlength="500" @bind="reasonText"></textarea>
                        <div class="form-actions">
                            <button type="submit" class="btn btn-primary" disabled="@busy">@Texts.Get("crm.quoteDetail.confirm")</button>
                            <button type="button" class="btn btn-outline-secondary" @onclick="() => reasonAction = null">@Texts.Get("common.dismiss")</button>
                        </div>
                    </form>
                }
                <div class="header-actions" role="group" aria-label="@Texts.Get("crm.quoteDetail.actions.label")">
                    @foreach (var action in actions.Where(a => a.Allowed))
                    {
                        <button type="button" class="btn @(action.Action is "present" or "approve" ? "btn-primary" : "btn-outline-secondary")" disabled="@busy"
                                @onclick="() => RunAsync(action.Action)">@QuoteLabels.Action(action.Action)</button>
                    }
                    @if (Session.Can(CrmAccess.QuotesWrite) && CanRevise)
                    {
                        <button type="button" class="btn btn-outline-primary" disabled="@busy" @onclick="StartRevise">@Texts.Get("crm.quoteDetail.revise")</button>
                    }
                    @if (Session.Can(CrmAccess.QuotesWrite))
                    {
                        <button type="button" class="btn btn-outline-secondary" disabled="@busy" @onclick="DuplicateAsync">@Texts.Get("crm.quoteDetail.duplicate")</button>
                    }
                </div>
                @if (actions.Any(a => !a.Allowed))
                {
                    <ul class="small text-muted action-reasons">
                        @foreach (var action in actions.Where(a => !a.Allowed))
                        {
                            <li><strong>@QuoteLabels.Action(action.Action):</strong> @action.Message</li>
                        }
                    </ul>
                }
            </section>

            @if (quote.Status != "Draft")
            {
                <QuoteSharingPanel Quote="quote" OnChanged="() => LoadAsync(quote.Id)" />
            }

            @if (quote.Status == "Accepted" && Session.IsModuleEnabled(ContractsAccess.ModuleKey) && Session.Can(ContractsAccess.ContractsWrite) && Session.Can(ContractsAccess.FinancialsRead))
            {
                <section aria-labelledby="quote-contract-title">
                    <h2 id="quote-contract-title">@Texts.Get("crm.quoteDetail.contract.title")</h2>
                    <p class="text-muted">@Texts.Get("crm.quoteDetail.contract.note")</p>
                    <a class="btn btn-primary" href="sozlesmeler/tekliften/@quote.Id">@Texts.Get("crm.quoteDetail.contract.create")</a>
                </section>
            }

            @if (quote.Status == "Accepted" && Session.IsModuleEnabled(OrdersAccess.ModuleKey) && Session.Can(OrdersAccess.OrdersCreate) && Session.Can(OrdersAccess.FinancialsRead))
            {
                <section aria-labelledby="quote-order-title">
                    <h2 id="quote-order-title">@Texts.Get("crm.quoteDetail.order.title")</h2>
                    <p class="text-muted">@Texts.Get("crm.quoteDetail.order.note")</p>
                    <a class="btn btn-primary" href="siparisler/tekliften/@quote.Id">@Texts.Get("crm.quoteDetail.order.create")</a>
                </section>
            }

            @if (family.Count > 1)
            {
                <section aria-labelledby="rev-title">
                    <h2 id="rev-title">@Texts.Get("crm.quoteDetail.revisions")</h2>
                    <ul>
                        @foreach (var revision in family.OrderByDescending(r => r.RevisionNo))
                        {
                            <li>
                                <a href="crm/teklifler/@revision.Id">V@(revision.RevisionNo)</a>
                                — <span class="badge stage-@QuoteLabels.StatusBadge(revision.Status)">@QuoteLabels.Label(QuoteLabels.Statuses, revision.Status)</span>
                                @QuoteLabels.Money(revision.GrossTotal, revision.Currency)
                                @if (revision.Id == quote.Id) { <text>@Texts.Get("crm.quoteDetail.thisPage")</text> }
                                else { <a href="crm/teklifler/@quote.Id/karsilastir?with=@revision.Id">@Texts.Get("crm.quoteDetail.compareWith")</a> }
                            </li>
                        }
                    </ul>
                </section>
            }

            <section aria-labelledby="hist-title">
                <h2 id="hist-title">@Texts.Get("common.history.tab")</h2>
                @if (history.Count == 0)
                {
                    <EmptyState Compact="true" />
                }
                else
                {
                    <ol class="timeline">
                        @foreach (var item in history)
                        {
                            <li>
                                <strong>@QuoteLabels.EventLabel(item.Kind)</strong>
                                <span class="text-muted">@CrmLabels.Time(item.At) · @Lookups.MemberName(item.ActorId)</span>
                                @if (item.FromStatus is not null && item.FromStatus != item.ToStatus && item.ToStatus is not null) { <span>(@QuoteLabels.Label(QuoteLabels.Statuses, item.FromStatus) → @QuoteLabels.Label(QuoteLabels.Statuses, item.ToStatus))</span> }
                                @if (!string.IsNullOrWhiteSpace(item.Reason)) { <div class="small">@item.Reason</div> }
                            </li>
                        }
                    </ol>
                }
            </section>
        }
    }
</AuthGate>

@code {
    [Parameter] public Guid? Id { get; set; }

    private QuoteDto? quote;
    private List<QuoteLineDto> lines = [];
    private List<QuoteActionStateDto> actions = [];
    private List<QuoteHistoryDto> history = [];
    private QuoteApprovalRequirementDto? requirement;
    private bool isPrimaryQuote;
    private List<QuoteDto> family = [];
    private QuoteForm form = new();
    private LineForm? lineForm;

    // Her kayıt formu sekmelidir; hatalı alan içeren sekme "!" rozeti taşır, kayıt denemesinden sonra hatalı ilk sekme açılır.
    private readonly TabState headerTabs = new("form-genel");
    private readonly TabState lineTabs = new("line-kalem");

    private static int ErrorCount(IReadOnlyDictionary<string, string[]>? source, params string[] fields) => source is null ? 0 : fields.Count(source.ContainsKey);

    private IReadOnlyList<TabItem> HeaderTabs =>
    [
        new("form-genel", Texts.Get("crm.quoteDetail.tab.general"), Errors: ErrorCount(errors, "title", "companyId", "contactId", "opportunityId")),
        new("form-fiyat", Texts.Get("crm.quoteDetail.tab.pricing"), Errors: ErrorCount(errors, "priceListId", "currency", "validUntil", "priceIncludesTax", "documentDiscountValue")),
        new("form-kosul", Texts.Get("crm.quoteDetail.tab.terms"), Errors: ErrorCount(errors, "paymentTerms", "deliveryTerms", "commercialTerms", "internalNotes")),
    ];

    private IReadOnlyList<TabItem> LineTabs =>
    [
        new("line-kalem", Texts.Get("crm.quoteDetail.col.line"), Errors: ErrorCount(lineErrors, "kind", "productId", "name", "quantity", "unitPrice", "description")),
        new("line-vergi", Texts.Get("crm.quoteDetail.tab.lineTax"), Errors: ErrorCount(lineErrors, "taxRatePercent", "discountValue", "recurringPeriod")),
        new("line-rol", Texts.Get("crm.quoteDetail.tab.lineRole"), Errors: ErrorCount(lineErrors, "parentStableKey")),
    ];
    private IReadOnlyDictionary<string, string[]>? errors;
    private IReadOnlyDictionary<string, string[]>? lineErrors;
    private string? notice;
    private bool noticeFailed;
    private string? lineMessage;
    private string? reasonAction;
    private string reasonText = string.Empty;
    private bool busy;
    private bool dirty;
    private bool lineDirty;
    private bool notFound;
    private int defaultValidityDays;

    private bool Draft => quote?.Status == "Draft";

    private bool CanEditHeader => quote is null ? Session.Can(CrmAccess.QuotesWrite) : Draft && Session.Can(CrmAccess.QuotesWrite);

    private bool ShowCost => Session.Can(CrmAccess.QuoteCostsRead) && lines.Any(l => l.UnitCost is not null);

    private bool CanRevise => quote?.Status is "Presented" or "Rejected" or "Expired" && !family.Any(r => r.Status == "Draft");

    protected override async Task OnParametersSetAsync()
    {
        await Session.EnsureLoadedAsync();
        if (!Session.Can(CrmAccess.QuotesRead))
        {
            return;
        }

        await Lookups.LoadAsync();
        if (Id is null)
        {
            quote = null;
            form = new QuoteForm();
            var settings = await Api.GetAsync<QuoteSettings>("/api/crm/quotes/settings");
            defaultValidityDays = settings.Value?.DefaultValidityDays ?? 30;
            form.ValidUntil = DateTime.Now.AddDays(defaultValidityDays);
            return;
        }

        await LoadAsync(Id.Value);
    }

    private async Task LoadAsync(Guid id)
    {
        var result = await Api.GetAsync<QuoteDto>($"/api/crm/quotes/{id}");
        if (result.Value is not { } loaded)
        {
            notFound = true;
            return;
        }

        quote = loaded;
        form = QuoteForm.From(loaded);
        dirty = false;
        lines = (await Api.GetAllAsync<QuoteLineDto>($"/api/crm/quote-lines?quoteId={id}")).Items;
        actions = (await Api.GetAsync<List<QuoteActionStateDto>>($"/api/crm/quotes/{id}/actions")).Value ?? [];
        history = (await Api.GetAsync<List<QuoteHistoryDto>>($"/api/crm/quotes/{id}/history")).Value ?? [];
        requirement = loaded.Status == "Draft" ? (await Api.GetAsync<QuoteApprovalRequirementDto>($"/api/crm/quotes/{id}/approval-requirements")).Value : null;
        isPrimaryQuote = loaded.OpportunityId is { } oppId && Session.Can(CrmAccess.OpportunitiesRead)
            && (await Api.GetAsync<OpportunityDto>($"/api/crm/opportunities/{oppId}")).Value?.PrimaryQuoteId == loaded.Id;
        family = (await Api.GetAllAsync<QuoteDto>($"/api/crm/quotes?familyId={loaded.FamilyId}")).Items;
    }

    private async Task ConfirmLeaveAsync(LocationChangingContext context)
    {
        if ((dirty || lineDirty) && !await Js.InvokeAsync<bool>("confirm", Texts.Get("crm.quoteDetail.leaveConfirm")))
        {
            context.PreventNavigation();
        }
    }

    private async Task SaveAsync()
    {
        if (busy) { return; }
        busy = true;
        var request = new SaveQuoteRequest(
            form.Title, form.CompanyId ?? Guid.Empty, Blank(form.Description), form.ContactId, form.OpportunityId, form.PriceListId, form.OwnerId, null,
            form.ValidUntil is { } until ? new DateTimeOffset(until) : null, form.Currency, null, null, null, form.PriceIncludesTax,
            form.DocumentDiscountKind, form.DocumentDiscountValue, Blank(form.PaymentTerms), Blank(form.DeliveryTerms), Blank(form.CommercialTerms),
            Blank(form.InternalNotes), quote?.Version);
        var result = quote is { } current
            ? await Api.PutAsync<QuoteDto>($"/api/crm/quotes/{current.Id}", request)
            : await Api.PostAsync<QuoteDto>("/api/crm/quotes", request);
        busy = false;

        if (!result.IsSuccess)
        {
            errors = result.FieldErrors;
            headerTabs.RevealFirstFailing(HeaderTabs);
            Notify(result.Status == System.Net.HttpStatusCode.Conflict ? Texts.Get("crm.quoteDetail.conflictRetry", result.Error) : result.Error, failed: true);
            return;
        }

        errors = null;
        dirty = false;
        if (quote is null)
        {
            Navigation.NavigateTo($"crm/teklifler/{result.Value!.Id}");
            return;
        }

        quote = result.Value;
        Notify(Texts.Get("crm.quoteDetail.draftSaved"));
        await LoadAsync(quote!.Id);
    }

    private void NewLine()
    {
        lineForm = new LineForm();
        lineTabs.Select("line-kalem");
        lineErrors = null;
        lineMessage = null;
        lineDirty = false;
    }

    private void EditLine(QuoteLineDto line)
    {
        lineForm = LineForm.From(line);
        lineTabs.Select("line-kalem");
        lineErrors = null;
        lineMessage = null;
        lineDirty = false;
    }

    private void CancelLine()
    {
        lineForm = null;
        lineDirty = false;
    }

    private async Task SaveLineAsync()
    {
        if (busy || lineForm is not { } f || quote is null) { return; }
        busy = true;
        var request = new SaveQuoteLineRequest(
            quote.Id, Blank(f.Name), f.Kind, f.ProductId, f.Quantity, f.UnitPrice, null, f.DiscountKind, f.DiscountValue, f.TaxRatePercent, null, f.Role,
            f.IsSelected, f.Role == "PackageChild" ? f.ParentStableKey : null, Blank(f.RecurringPeriod), Blank(f.Description), null, f.Position,
            Session.Can(CrmAccess.QuoteCostsRead) ? f.UnitCost : null, f.Version);
        var result = f.Id is { } id
            ? await Api.PutAsync<QuoteLineDto>($"/api/crm/quote-lines/{id}", request)
            : await Api.PostAsync<QuoteLineDto>("/api/crm/quote-lines", request);
        busy = false;

        if (!result.IsSuccess)
        {
            lineErrors = result.FieldErrors;
            lineMessage = result.Error;
            lineTabs.RevealFirstFailing(LineTabs);
            return;
        }

        lineForm = null;
        lineDirty = false;
        Notify(Texts.Get("crm.quoteDetail.lineSaved"));
        await LoadAsync(quote.Id);
    }

    private async Task DeleteLineAsync(QuoteLineDto line)
    {
        if (busy || quote is null) { return; }
        busy = true;
        var result = await Api.DeleteAsync($"/api/crm/quote-lines/{line.Id}?version={line.Version}");
        busy = false;
        Notify(result.IsSuccess ? Texts.Get("crm.quoteDetail.lineDeleted") : result.Error, failed: !result.IsSuccess);
        await LoadAsync(quote.Id);
    }

    private async Task RunAsync(string action)
    {
        if (QuoteLabels.NeedsReason(action))
        {
            reasonAction = action;
            reasonText = string.Empty;
            return;
        }

        await TransitionAsync(action, null);
    }

    private async Task ConfirmReasonAsync()
    {
        if (string.IsNullOrWhiteSpace(reasonText))
        {
            Notify(Texts.Get("crm.quoteDetail.reasonRequired"), failed: true);
            return;
        }

        var action = reasonAction!;
        reasonAction = null;
        if (action == "revise")
        {
            await ReviseAsync(reasonText.Trim());
            return;
        }

        await TransitionAsync(action, reasonText.Trim());
    }

    private async Task TransitionAsync(string action, string? reason)
    {
        if (busy || quote is null) { return; }
        busy = true;
        var result = await Api.PostAsync<QuoteDto>($"/api/crm/quotes/{quote.Id}/{QuoteLabels.Route(action)}", new QuoteTransitionRequest(quote.Version, reason));
        busy = false;
        if (result.IsSuccess)
        {
            Notify(Texts.Get("crm.quoteApprovals.done", QuoteLabels.Action(action)));
        }
        else
        {
            Notify(result.Status == System.Net.HttpStatusCode.Conflict
                ? Texts.Get("crm.quoteDetail.conflictReloaded", result.Error)
                : result.Error, failed: true);
        }

        await LoadAsync(quote.Id);
    }

    private void StartRevise()
    {
        reasonAction = "revise";
        reasonText = string.Empty;
    }

    private async Task ReviseAsync(string reason)
    {
        if (busy || quote is null) { return; }
        busy = true;
        var result = await Api.PostAsync<QuoteDto>($"/api/crm/quotes/{quote.Id}/revise", new ReviseQuoteRequest(reason));
        busy = false;
        if (result.IsSuccess)
        {
            Navigation.NavigateTo($"crm/teklifler/{result.Value!.Id}");
            return;
        }

        Notify(result.Error, failed: true);
    }

    private async Task DuplicateAsync()
    {
        if (busy || quote is null) { return; }
        busy = true;
        var result = await Api.PostAsync<QuoteDto>($"/api/crm/quotes/{quote.Id}/duplicate", new { });
        busy = false;
        if (result.IsSuccess)
        {
            Navigation.NavigateTo($"crm/teklifler/{result.Value!.Id}");
            return;
        }

        Notify(result.Error, failed: true);
    }

    private IEnumerable<(string Period, decimal Gross)> Recurring()
    {
        if (string.IsNullOrWhiteSpace(quote?.RecurringSummary)) { yield break; }
        using var doc = JsonDocument.Parse(quote.RecurringSummary);
        foreach (var item in doc.RootElement.EnumerateArray())
        {
            yield return (item.GetProperty("period").GetString() ?? string.Empty, item.GetProperty("gross").GetDecimal());
        }
    }

    private void Notify(string? text, bool failed = false)
    {
        notice = text;
        noticeFailed = failed;
    }

    private static string? Blank(string? text) => string.IsNullOrWhiteSpace(text) ? null : text.Trim();

    private sealed record QuoteSettings(decimal? ApprovalDiscountPercent, decimal? ApprovalGrossAbove, int DefaultValidityDays, bool AllowSelfApproval);

    private sealed class QuoteForm
    {
        public string Title { get; set; } = string.Empty;
        public Guid? CompanyId { get; set; }
        public Guid? ContactId { get; set; }
        public Guid? OpportunityId { get; set; }
        public Guid? OwnerId { get; set; }
        public Guid? PriceListId { get; set; }
        public string Currency { get; set; } = "TRY";
        public DateTime? ValidUntil { get; set; }
        public bool PriceIncludesTax { get; set; }
        public string DocumentDiscountKind { get; set; } = "None";
        public decimal DocumentDiscountValue { get; set; }
        public string? Description { get; set; }
        public string? PaymentTerms { get; set; }
        public string? DeliveryTerms { get; set; }
        public string? CommercialTerms { get; set; }
        public string? InternalNotes { get; set; }

        public static QuoteForm From(QuoteDto q) => new()
        {
            Title = q.Title, CompanyId = q.CompanyId, ContactId = q.ContactId, OpportunityId = q.OpportunityId, OwnerId = q.OwnerId, PriceListId = q.PriceListId,
            Currency = q.Currency, ValidUntil = q.ValidUntil?.LocalDateTime, PriceIncludesTax = q.PriceIncludesTax, DocumentDiscountKind = q.DocumentDiscountKind,
            DocumentDiscountValue = q.DocumentDiscountValue, Description = q.Description, PaymentTerms = q.PaymentTerms, DeliveryTerms = q.DeliveryTerms,
            CommercialTerms = q.CommercialTerms, InternalNotes = q.InternalNotes,
        };
    }

    private sealed class LineForm
    {
        public Guid? Id { get; set; }
        public long? Version { get; set; }
        public int Position { get; set; }
        public string Kind { get; set; } = "Product";
        public Guid? ProductId { get; set; }
        public string? Name { get; set; }
        public decimal Quantity { get; set; } = 1m;
        public decimal? UnitPrice { get; set; }
        public decimal TaxRatePercent { get; set; }
        public string DiscountKind { get; set; } = "None";
        public decimal DiscountValue { get; set; }
        public string Role { get; set; } = "Standard";
        public bool IsSelected { get; set; }
        public Guid? ParentStableKey { get; set; }
        public string? RecurringPeriod { get; set; }
        public decimal? UnitCost { get; set; }
        public string? Description { get; set; }

        public static LineForm From(QuoteLineDto l) => new()
        {
            Id = l.Id, Version = l.Version, Position = l.Position, Kind = l.Kind, ProductId = l.ProductId, Name = l.Name, Quantity = l.Quantity,
            UnitPrice = l.UnitPrice, TaxRatePercent = l.TaxRatePercent, DiscountKind = l.DiscountKind, DiscountValue = l.DiscountValue, Role = l.Role,
            IsSelected = l.IsSelected, ParentStableKey = l.ParentStableKey, RecurringPeriod = l.RecurringPeriod ?? string.Empty, UnitCost = l.UnitCost,
            Description = l.Description,
        };
    }
}
