@page "/crm/satis-tahmini"
@using System.Globalization
@inject ApiClient Api
@inject SessionState Session
@inject CrmLookups Lookups
@inject NavigationManager Navigation

<PageTitle>@Texts.Get("crm.salesForecasts.title") · Modulix</PageTitle>

<AuthGate Module="@CrmAccess.ModuleKey" Permission="@SalesAccess.ForecastsRead">
    <a class="back-link" href="crm/satis-gorunumu">← @Texts.Get("crm.salesOverview.title")</a>
    <div class="page-header">
        <div>
            <h1>@Texts.Get("crm.salesForecasts.title")</h1>
            <p class="text-muted mb-0">
                @Texts.Get("crm.salesForecasts.intro")
            </p>
        </div>
        @if (CanWrite && !creating)
        {
            <div class="header-actions"><button type="button" class="btn btn-primary" @onclick="StartCreate">@Texts.Get("crm.salesForecasts.newDraft")</button></div>
        }
    </div>

    @if (creating)
    {
        <form class="record-form" novalidate @onsubmit="CreateAsync" @onsubmit:preventDefault aria-labelledby="sf-new-title">
            <h2 id="sf-new-title">@Texts.Get("crm.salesForecasts.newTitle")</h2>
            <p class="small text-muted">@Texts.Get("crm.salesForecasts.newHelp")</p>
            <ErrorSummary Errors="createErrors" />
            @if (createMessage is not null)
            {
                <div class="alert alert-danger" role="alert">@createMessage</div>
            }
            <FormTabs Title="@Texts.Get("crm.salesForecasts.info")" Label="@Texts.Get("crm.salesForecasts.formSections")">
            <div class="form-grid">
                <div class="span-3">
                    <label class="form-label required" for="sf-kind">@Texts.Get("crm.sales.periodKind")</label>
                    <select id="sf-kind" class="form-select" required aria-required="true" @bind="newKind">
                        @foreach (var (key, label) in SalesLabels.PeriodKinds) { <option value="@key">@label</option> }
                    </select>
                    <FieldError Field="kind" Errors="createErrors" />
                </div>
                <div class="span-3">
                    <label class="form-label" for="sf-anchor">@Texts.Get("crm.sales.anchorDay")</label>
                    <input id="sf-anchor" class="form-control" type="date" @bind="newAnchor" />
                    <FieldError Field="anchor" Errors="createErrors" />
                </div>
                <div class="span-3">
                    <label class="form-label required" for="sf-scope">@Texts.Get("crm.salesForecasts.scope")</label>
                    <select id="sf-scope" class="form-select" required aria-required="true" @bind="newScope" @bind:after="ScopeChanged">
                        @foreach (var (key, label) in SalesLabels.Scopes) { <option value="@key">@label</option> }
                    </select>
                    <FieldError Field="scopeType" Errors="createErrors" />
                </div>
                @if (newScope == SalesTargetScopes.User)
                {
                    <div class="span-3">
                        <label class="form-label required" for="sf-user">@Texts.Get("crm.sales-scope.user")</label>
                        <select id="sf-user" class="form-select" required aria-required="true" @bind="newUser">
                            <option value="">@Texts.Get("common.choose")</option>
                            @foreach (var member in Lookups.Members) { <option value="@member.UserId">@member.DisplayName</option> }
                        </select>
                        <FieldError Field="scopeUserId" Errors="createErrors" />
                    </div>
                }
                <div class="span-3">
                    <label class="form-label" for="sf-currency">@Texts.Get("crm.sales.currency")</label>
                    <input id="sf-currency" class="form-control" maxlength="3" placeholder="@Regional.Currency" aria-describedby="sf-currency-help" @bind="newCurrency" />
                    <div id="sf-currency-help" class="form-text">@Texts.Get("crm.salesForecasts.currencyHelp")</div>
                    <FieldError Field="currency" Errors="createErrors" />
                </div>
            </div>
            </FormTabs>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary" disabled="@busy">
                    @if (busy) { <span class="spinner-border spinner-border-sm" aria-hidden="true"></span> }
                    @Texts.Get("crm.salesForecasts.create")
                </button>
                <button type="button" class="btn btn-outline-secondary" disabled="@busy" @onclick="CancelCreate">@Texts.Get("common.dismiss")</button>
            </div>
        </form>
    }

    <form class="form-grid mb-3" @onsubmit="LoadAsync" @onsubmit:preventDefault aria-label="@Texts.Get("crm.salesForecasts.filters")">
        <div class="span-3">
            <label class="form-label" for="sff-from">@Texts.Get("crm.salesForecasts.filterFrom")</label>
            <input id="sff-from" class="form-control" type="date" @bind="from" @bind:after="LoadAsync" />
        </div>
        <div class="span-3">
            <label class="form-label" for="sff-to">@Texts.Get("crm.salesForecasts.filterTo")</label>
            <input id="sff-to" class="form-control" type="date" @bind="to" @bind:after="LoadAsync" />
        </div>
        <div class="span-3">
            <label class="form-label" for="sff-status">@Texts.Get("common.field.status")</label>
            <select id="sff-status" class="form-select" @bind="status" @bind:after="LoadAsync">
                <option value="">@Texts.Get("crm.salesForecasts.all")</option>
                @foreach (var (key, label) in SalesLabels.Statuses) { <option value="@key">@label</option> }
            </select>
        </div>
    </form>

    @if (error is not null)
    {
        <div class="alert alert-danger" role="alert">
            @error
            <button type="button" class="btn btn-outline-secondary btn-sm ms-2" disabled="@loading" @onclick="LoadAsync">@Texts.Get("crm.sales.retry")</button>
        </div>
    }

    @if (loading && items is null)
    {
        <LoadingState Kind="LoadingKind.Table" />
    }
    else if (items is not null)
    {
        @if (items.Count == 0)
        {
            <p class="text-muted">@(CanWrite ? Texts.Get("crm.salesForecasts.noneCanCreate") : Texts.Get("crm.salesForecasts.none"))</p>
        }
        else
        {
            <table class="table record-table" aria-busy="@(loading ? "true" : "false")">
                <caption class="visually-hidden">@Texts.Get("crm.salesForecasts.caption")</caption>
                <thead>
                    <tr>
                        <th scope="col">@Texts.Get("crm.salesOverview.col.period")</th><th scope="col">@Texts.Get("crm.salesForecasts.scope")</th><th scope="col">@Texts.Get("crm.sales.currency")</th><th scope="col">@Texts.Get("crm.salesForecasts.col.version")</th><th scope="col">@Texts.Get("common.field.status")</th>
                        <th scope="col">@Texts.Get("crm.salesForecasts.col.changed")</th><th scope="col"><span class="visually-hidden">@Texts.Get("common.open")</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var forecast in items)
                    {
                        <tr>
                            <td data-label="@Texts.Get("crm.salesOverview.col.period")" class="primary">@SalesLabels.PeriodKind(forecast.PeriodKind) · @SalesLabels.Period(forecast.PeriodStart, forecast.PeriodEnd)</td>
                            <td data-label="@Texts.Get("crm.salesForecasts.scope")">@(forecast.ScopeType == SalesTargetScopes.User ? Texts.Get("crm.salesForecasts.userScope", Lookups.MemberName(forecast.ScopeUserId)) : Texts.Get("crm.sales-scope.tenant"))</td>
                            <td data-label="@Texts.Get("crm.sales.currency")">@forecast.ReportingCurrency</td>
                            <td data-label="@Texts.Get("crm.salesForecasts.col.version")">@Texts.Get("crm.salesForecasts.versionNo", forecast.VersionNo)</td>
                            <td data-label="@Texts.Get("common.field.status")"><span class="badge stage-@SalesLabels.StatusBadge(forecast.Status)">@SalesLabels.Status(forecast.Status)</span></td>
                            <td data-label="@Texts.Get("crm.salesForecasts.col.changed")">@(forecast.ChangedAt is { } changed ? CrmLabels.Time(changed) : "—")</td>
                            <td class="actions"><a class="btn btn-outline-primary btn-sm" href="crm/satis-tahmini/@forecast.Id" aria-label="@Texts.Get("crm.salesForecasts.openAria", SalesLabels.Period(forecast.PeriodStart, forecast.PeriodEnd), forecast.VersionNo)">@Texts.Get("common.open")</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }
</AuthGate>

@code {
    private IReadOnlyList<ForecastHeaderDto>? items;
    private string? error;
    private bool loading;
    private int requestId;

    private DateOnly? from;
    private DateOnly? to;
    private string status = string.Empty;

    private bool creating;
    private bool busy;
    private string newKind = SalesPeriodKinds.Month;
    private DateOnly? newAnchor = DateOnly.FromDateTime(Regional.Now.DateTime);
    private string newScope = SalesTargetScopes.Tenant;
    private string newUser = string.Empty;
    private string newCurrency = string.Empty;
    private IReadOnlyDictionary<string, string[]>? createErrors;
    private string? createMessage;

    private bool CanWrite => Session.Can(SalesAccess.ForecastsWrite);

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (Session.Can(SalesAccess.ForecastsRead))
        {
            var year = Regional.Now.Year;
            from = new DateOnly(year, 1, 1);
            to = new DateOnly(year, 12, 31);
            await Lookups.LoadAsync();
            await LoadAsync();
        }
    }

    private static string Iso(DateOnly day) => day.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);

    private async Task LoadAsync()
    {
        var id = ++requestId;
        loading = true;
        error = null;

        var query = new List<string>();
        if (from is { } f) { query.Add($"from={Iso(f)}"); }
        if (to is { } t) { query.Add($"to={Iso(t)}"); }
        if (status.Length > 0) { query.Add($"status={status}"); }

        var result = await Api.GetAsync<List<ForecastHeaderDto>>($"/api/crm/sales/forecasts?{string.Join('&', query)}");
        if (id != requestId)
        {
            return;
        }

        loading = false;
        if (result.IsSuccess)
        {
            items = result.Value ?? [];
        }
        else
        {
            error = result.Error;
        }
    }

    private void StartCreate()
    {
        creating = true;
        createErrors = null;
        createMessage = null;
    }

    private void CancelCreate() => creating = false;

    private void ScopeChanged()
    {
        if (newScope == SalesTargetScopes.Tenant)
        {
            newUser = string.Empty;
        }
    }

    private async Task CreateAsync()
    {
        if (busy)
        {
            return;
        }

        busy = true;
        createMessage = null;
        var request = new CreateForecastRequestDto(
            newKind,
            newAnchor,
            newScope,
            newScope == SalesTargetScopes.User && Guid.TryParse(newUser, out var userId) ? userId : null,
            string.IsNullOrWhiteSpace(newCurrency) ? null : newCurrency.Trim().ToUpperInvariant());

        var result = await Api.PostAsync<ForecastDetailDto>("/api/crm/sales/forecasts", request);
        busy = false;

        if (result.IsSuccess && result.Value is { } created)
        {
            Navigation.NavigateTo($"crm/satis-tahmini/{created.Header.Id}");
            return;
        }

        createErrors = result.FieldErrors;
        createMessage = result.FieldErrors.Count == 0 ? result.Error : null;
    }
}
