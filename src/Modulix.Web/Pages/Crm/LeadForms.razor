@page "/crm/lead-formlari"
@inject ApiClient Api
@inject SessionState Session
@inject CrmLookups Lookups
@inject NavigationManager Navigation

<PageTitle>@Texts.Get("crm.leadForms.pageTitle") · Modulix</PageTitle>

<AuthGate Module="@CrmAccess.ModuleKey" Permission="@CrmAccess.LeadFormsManage">
    <a class="back-link" href="crm/leadler">← @Texts.Get("crm.leads.title")</a>
    <div class="page-header">
        <h1>@Texts.Get("crm.leadForms.title")</h1>
        @if (!editing)
        {
            <button type="button" class="btn btn-primary" @onclick="() => Open(null)">@Texts.Get("crm.leadForms.new")</button>
        }
    </div>

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }

    @if (secret is not null)
    {
        <div class="alert alert-warning" role="alert">
            <strong>@Texts.Get("crm.leadForms.secretTitle")</strong>
            <code class="d-block user-select-all">@secret</code>
            @Texts.Get("crm.leadForms.secretHelp")
        </div>
    }

    <p class="text-muted small">
        @Texts.Get("crm.leadForms.help1")
        @Texts.Get("crm.leadForms.help2")
    </p>

    @if (editing)
    {
        <form class="record-form" novalidate @onsubmit="SaveAsync" @onsubmit:preventDefault>
            <h2>@Texts.Get(selected is null ? "crm.leadForms.new" : "crm.leadForms.edit")</h2>
            <FormTabs Title="@Texts.Get("crm.leadForms.info")" Label="@Texts.Get("crm.lead.editor.tabs")">
            <div class="form-grid">
                <div class="span-all">
                    <label class="form-label" for="form-name">@Texts.Get("crm.person.firstName")</label>
                    <input id="form-name" class="form-control" maxlength="100" @bind="name" />
                    <FieldError Field="name" Errors="errors" />
                </div>
                <div>
                    <label class="form-label" for="form-owner">@Texts.Get("crm.leadForms.defaultOwner")</label>
                    <select id="form-owner" class="form-select" @bind="ownerId">
                        <option value="">@Texts.Get("crm.leadForms.pool")</option>
                        @foreach (var member in Lookups.Members)
                        {
                            <option value="@member.UserId">@member.DisplayName</option>
                        }
                    </select>
                    <small class="text-muted">@Texts.Get("crm.leadForms.ownerHint")</small>
                    <FieldError Field="defaultOwnerId" Errors="errors" />
                </div>
                <div class="span-all">
                    <label class="form-label" for="form-origins">@Texts.Get("crm.leadForms.origins")</label>
                    <textarea id="form-origins" class="form-control" rows="2" placeholder="@Texts.Get("crm.leadForms.originsPlaceholder")" @bind="origins"></textarea>
                    <FieldError Field="allowedOrigins" Errors="errors" />
                </div>
                <div class="form-check-row">
                    <input id="form-active" class="form-check-input" type="checkbox" @bind="active" />
                    <label class="form-check-label" for="form-active">@Texts.Get("common.active")</label>
                </div>
                <div class="form-check-row">
                    <input id="form-server" class="form-check-input" type="checkbox" @bind="serverOnly" />
                    <label class="form-check-label" for="form-server">@Texts.Get("crm.leadForms.serverOnly")</label>
                </div>
            </div>
            </FormTabs>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary" disabled="@busy">@Texts.Get("common.save")</button>
                <button type="button" class="btn btn-outline-secondary" @onclick="() => editing = false">@Texts.Get("common.dismiss")</button>
                @if (selected is not null)
                {
                    <button type="button" class="btn btn-outline-danger ms-auto" disabled="@busy" @onclick="DeleteAsync">@Texts.Get("common.delete")</button>
                }
            </div>
        </form>
    }

    @if (forms is null)
    {
        <p class="text-muted">@Texts.Get("common.loading")</p>
    }
    else if (forms.Count == 0)
    {
        <p class="text-muted">@Texts.Get("crm.leadForms.none")</p>
    }
    else
    {
        @foreach (var form in forms)
        {
            <section class="detail-section">
                <div class="section-header">
                    <h2>@form.Name @(form.IsActive ? null : $"({Texts.Get("common.inactiveLower")})")</h2>
                    <div class="header-actions">
                        <button type="button" class="btn btn-outline-primary btn-sm" @onclick="() => Open(form)">@Texts.Get("common.edit")</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@busy" @onclick="() => RotateAsync(form)">
                            @Texts.Get(form.SecretRotatedAt is null ? "crm.leadForms.secretCreate" : "crm.leadForms.secretRotate")
                        </button>
                    </div>
                </div>
                <dl class="detail-grid">
                    <div><dt>@Texts.Get("crm.leadForms.formKey")</dt><dd><code>@form.FormKey</code></dd></div>
                    <div><dt>@Texts.Get("crm.leadForms.defaultOwner")</dt><dd>@(form.DefaultOwnerId is null ? Texts.Get("crm.leadForms.poolShort") : Lookups.MemberName(form.DefaultOwnerId))</dd></div>
                    <div><dt>@Texts.Get("crm.leadForms.originsShort")</dt><dd>@(string.IsNullOrWhiteSpace(form.AllowedOrigins) ? "—" : form.AllowedOrigins)</dd></div>
                    <div><dt>@Texts.Get("crm.leadForms.secret")</dt><dd>@(form.SecretRotatedAt is { } at ? Texts.Get("crm.leadForms.generated", CrmLabels.Time(at)) : Texts.Get("common.none"))@(form.ServerOnly ? $" · {Texts.Get("crm.leadForms.browserOff")}" : null)</dd></div>
                </dl>
                <details>
                    <summary>@Texts.Get("crm.leadForms.example")</summary>
                    <pre class="code-sample">POST @Endpoint(form)
Content-Type: application/json
Origin: @(FirstOrigin(form))
@(form.SecretRotatedAt is null ? null : "X-Lead-Form-Secret: <sunucuda saklanan sır>  (yalnızca sunucudan sunucuya)\n")
{
  "submissionId": "benzersiz-gonderim-kimligi",
  "firstName": "Mehmet", "lastName": "Kaya",
  "email": "mehmet@ornek.com", "phone": "0532 111 22 33",
  "message": "Filo bakımı için teklif istiyoruz.",
  "website2": ""
}</pre>
                    <p class="text-muted small">
                        @Texts.Get("crm.leadForms.exampleHelp1")
                        @Texts.Get("crm.leadForms.exampleHelp2")
                    </p>
                </details>
            </section>
        }
    }
</AuthGate>

@code {
    private const string Url = "/api/crm/lead-forms";

    private IReadOnlyList<LeadFormDto>? forms;
    private LeadFormDto? selected;
    private IReadOnlyDictionary<string, string[]>? errors;
    private string? message;
    private string? secret;
    private string name = string.Empty;
    private Guid? ownerId;
    private string? origins;
    private bool active = true;
    private bool serverOnly;
    private bool editing;
    private bool busy;

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (Session.Can(CrmAccess.LeadFormsManage))
        {
            await Lookups.LoadAsync();
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        var result = await Api.GetAsync<CrmPage<LeadFormDto>>($"{Url}?pageSize=100");
        forms = result.Value?.Items;
        message = result.Error;
    }

    private string Endpoint(LeadFormDto form)
    {
        var slug = Session.User?.Memberships.FirstOrDefault(m => m.TenantId == Session.User.ActiveTenantId)?.TenantSlug ?? "{firma-kisa-adi}";
        return $"{Navigation.BaseUri.TrimEnd('/')}/api/public/lead-forms/{slug}/{form.FormKey}";
    }

    private static string FirstOrigin(LeadFormDto form) =>
        (form.AllowedOrigins ?? string.Empty).Split(['\n', ',', ' ', ';'], StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "https://www.ornek.com";

    private void Open(LeadFormDto? form)
    {
        selected = form;
        name = form?.Name ?? string.Empty;
        ownerId = form?.DefaultOwnerId;
        origins = form?.AllowedOrigins;
        active = form?.IsActive ?? true;
        serverOnly = form?.ServerOnly ?? false;
        errors = null;
        message = null;
        editing = true;
    }

    private async Task SaveAsync()
    {
        busy = true;
        var request = new SaveLeadFormRequest(name, active, ownerId, string.IsNullOrWhiteSpace(origins) ? null : origins.Trim(), serverOnly, selected?.Version);
        var result = selected is { } existing
            ? await Api.PutAsync<LeadFormDto>($"{Url}/{existing.Id}", request)
            : await Api.PostAsync<LeadFormDto>(Url, request);
        busy = false;
        if (result.IsSuccess)
        {
            editing = false;
            await LoadAsync();
            return;
        }

        errors = result.FieldErrors;
        message = result.Error;
    }

    private async Task DeleteAsync()
    {
        busy = true;
        var result = await Api.DeleteAsync($"{Url}/{selected!.Id}?version={selected.Version}");
        busy = false;
        if (result.IsSuccess)
        {
            editing = false;
            await LoadAsync();
            return;
        }

        message = result.Error;
    }

    private async Task RotateAsync(LeadFormDto form)
    {
        busy = true;
        secret = null;
        var result = await Api.PostAsync<LeadFormSecretDto>($"{Url}/{form.Id}/secret", new LeadVersionRequest(form.Version));
        busy = false;
        message = result.Error;
        secret = result.Value?.Secret;
        await LoadAsync();
    }
}
