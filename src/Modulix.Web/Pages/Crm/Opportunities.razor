@page "/crm/firsatlar"
@inject ApiClient Api
@inject SessionState Session
@inject CrmLookups Lookups
@inject NavigationManager Navigation

<PageTitle>Fırsatlar · Modulix</PageTitle>

<AuthGate Module="@CrmAccess.ModuleKey" Permission="@CrmAccess.OpportunitiesRead">
    <PageHeader Title="Fırsatlar" Icon="target" Subtitle="Satış fırsatlarınızı aşama aşama takip edin.">
        <a class="btn btn-outline-secondary" href="crm/firsat-raporu">Rapor</a>
    </PageHeader>

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }

    @if (editing)
    {
        <OpportunityEditor Opportunity="selected" Lookups="Lookups" Saved="SavedAsync" Deleted="SavedAsync" Cancelled="SavedAsync" />
    }

    <div class="filters">
        <div class="segmented" role="group" aria-label="Görünüm">
            <button type="button" class="chip @(board ? "active" : null)" @onclick="() => SwitchAsync(true)">Satış hunisi</button>
            <button type="button" class="chip @(!board ? "active" : null)" @onclick="() => SwitchAsync(false)">Liste</button>
        </div>
        <button type="button" class="chip @(mine ? "active" : null)" aria-pressed="@(mine ? "true" : "false")" @onclick="ToggleMineAsync">Yalnızca benimkiler</button>
        <button type="button" class="chip @(overdue ? "active" : null)" aria-pressed="@(overdue ? "true" : "false")" @onclick="ToggleOverdueAsync">Kapanışı geçenler</button>
        <button type="button" class="chip @(noAction ? "active" : null)" aria-pressed="@(noAction ? "true" : "false")" @onclick="ToggleNoActionAsync">Aksiyonsuz</button>
        <label class="visually-hidden" for="status-filter">Durum</label>
        <select id="status-filter" class="form-select form-select-sm filter-select" @bind="status" @bind:after="() => LoadAsync(1)">
            <option value="">Tüm durumlar</option>
            @foreach (var s in OpportunityStatus.All)
            {
                <option value="@s">@OpportunityStatus.Label(s)</option>
            }
        </select>
    </div>

    <div class="list-toolbar">
        <form class="search" @onsubmit="() => LoadAsync(1)" @onsubmit:preventDefault>
            <input class="form-control" type="search" aria-label="Fırsat ara" placeholder="Başlık ara" @bind="search" />
            <button type="submit" class="btn btn-outline-secondary">Ara</button>
        </form>
        @if (!board)
        {
            <ColumnPicker />
        }
        @if (Session.Can(CrmAccess.OpportunitiesWrite) && !editing)
        {
            <button type="button" class="btn btn-primary" @onclick="() => Open(null)"><AppIcon Name="plus" Size="16" /> Yeni fırsat</button>
        }
    </div>

    @if (board)
    {
        @if (columns is null)
        {
            <p class="text-muted">Yükleniyor…</p>
        }
        else
        {
            <p class="text-muted small board-hint">
                @(CanMove ? "Kartı sürükleyerek veya kartın altındaki listeden aşamasını değiştirin. Kazanıldı/Kaybedildi sütununa bırakmak fırsat sayfasını açar (kapanış bilgisi istenir)." : null)
            </p>
            <div class="board">
                @foreach (var column in columns)
                {
                    <section class="board-column @(dropTarget == column.Stage ? "drop" : null)"
                             @ondragover="() => dropTarget = column.Stage" @ondragover:preventDefault
                             @ondragleave="() => dropTarget = null"
                             @ondrop="() => DropAsync(column.Stage)">
                        <header>
                            <span class="badge stage-@Lookups.Badge(CrmLists.OpportunityStage, column.Stage)">@Lookups.Label(CrmLists.OpportunityStage, column.Stage)</span>
                            <span class="count">@column.Page.TotalCount</span>
                            @if (ShowAmounts)
                            {
                                <small>@Totals(column.Page.Items)</small>
                            }
                        </header>
                        @foreach (var opportunity in column.Page.Items)
                        {
                            <article class="board-card" draggable="@(CanMove && opportunity.Status == OpportunityStatus.Open ? "true" : "false")"
                                     @ondragstart="() => dragged = opportunity">
                                <a href="crm/firsatlar/@opportunity.Id"><strong>@opportunity.Title</strong></a>
                                @if (opportunity.Status != OpportunityStatus.Open)
                                {
                                    <span class="badge stage-@opportunity.Status.ToLowerInvariant()">@OpportunityStatus.Label(opportunity.Status)</span>
                                }
                                @if (opportunity.SourceLeadId is { } cardLead && Session.Can(CrmAccess.LeadsRead)) { <a class="small" href="crm/leadler/@cardLead">Kaynak müşteri adayı</a> }
                                <a href="crm/firmalar/@opportunity.CompanyId">@Lookups.CompanyName(opportunity.CompanyId)</a>
                                @if (ShowAmounts)
                                {
                                    <span>
                                        @FormatAmount(opportunity)
                                        @if (opportunity.Probability is { } probability) { <text> · %@probability</text> }
                                    </span>
                                }
                                @if (opportunity.OwnerId is not null)
                                {
                                    <span class="owner">@Lookups.MemberName(opportunity.OwnerId)</span>
                                }
                                @if (CanMove && opportunity.Status == OpportunityStatus.Open)
                                {
                                    <div class="card-actions">
                                        <select class="form-select form-select-sm" aria-label="Aşama" value="@opportunity.Stage"
                                                @onchange="e => MoveAsync(opportunity, (string)e.Value!)">
                                            @foreach (var stage in Lookups.Choices(CrmLists.OpportunityStage, opportunity.Stage))
                                            {
                                                <option value="@stage.Key">@stage.Label</option>
                                            }
                                        </select>
                                        <button type="button" class="btn btn-link btn-sm" @onclick="() => Open(opportunity)">Düzenle</button>
                                    </div>
                                }
                            </article>
                        }
                        @if (column.Page.TotalCount > column.Page.Items.Count)
                        {
                            <p class="text-muted small">İlk @column.Page.Items.Count kayıt gösteriliyor; listeyi kullanın.</p>
                        }
                    </section>
                }
            </div>
        }
    }
    else if (page is null)
    {
        <p class="text-muted">Yükleniyor…</p>
    }
    else if (page.Items.Count == 0)
    {
        <p class="text-muted">Kayıt yok.</p>
    }
    else
    {
        <table class="table record-table">
            <thead>
                <tr>
                    <th>Başlık</th><th>Firma</th><th>Aşama</th>
                    @if (ShowAmounts)
                    {
                        <th class="text-end">Tutar</th><th>Olasılık</th>
                    }
                    <th>Sorumlu</th><th>Kapanış</th>@foreach (var field in Lookups.ListFieldsOf(CrmEntityKeys.Opportunity)) { <th>@field.Label</th> }<th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var opportunity in page.Items)
                {
                    <tr>
                        <td data-label="Başlık" class="primary"><a href="crm/firsatlar/@opportunity.Id">@opportunity.Title</a> <small class="text-muted">@opportunity.OpportunityNumber</small>
                            @if (opportunity.SourceLeadId is { } sourceLead && Session.Can(CrmAccess.LeadsRead))
                            {
                                <a class="small d-block" href="crm/leadler/@sourceLead">Kaynak müşteri adayı</a>
                            }
                        </td>
                        <td data-label="Firma"><a href="crm/firmalar/@opportunity.CompanyId">@Lookups.CompanyName(opportunity.CompanyId)</a></td>
                        <td data-label="Aşama"><span class="badge stage-@Lookups.Badge(CrmLists.OpportunityStage, opportunity.Stage)">@Lookups.Label(CrmLists.OpportunityStage, opportunity.Stage)</span> @if (opportunity.Status != OpportunityStatus.Open) { <span class="badge stage-@opportunity.Status.ToLowerInvariant()">@OpportunityStatus.Label(opportunity.Status)</span> }</td>
                        @if (ShowAmounts)
                        {
                            <td data-label="Tutar" class="text-end">@FormatAmount(opportunity)</td>
                            <td data-label="Olasılık">@(opportunity.Probability is { } p ? $"%{p}" : null)</td>
                        }
                        <td data-label="Sorumlu"><OwnerCell Name="@Lookups.MemberName(opportunity.OwnerId)" /></td>
                        <td data-label="Kapanış">@(opportunity.ExpectedCloseDate is { } date ? CrmLabels.Date(date) : null)</td>
                        @foreach (var field in Lookups.ListFieldsOf(CrmEntityKeys.Opportunity))
                        {
                            <td data-label="@field.Label">@CustomFieldText.Format(field, opportunity.Custom)</td>
                        }
                        <td class="actions">
                            @if (Session.Can(CrmAccess.OpportunitiesWrite))
                            {
                                <button type="button" class="btn btn-outline-primary btn-sm" @onclick="() => Open(opportunity)">Düzenle</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager PageSizeChoice="true" Page="page.Page" PageSize="page.PageSize" TotalCount="page.TotalCount" PageChanged="LoadAsync" />
    }
</AuthGate>

@code {
    private const string Url = "/api/crm/opportunities";

    // Panoda her aşamadan en fazla bu kadar kart yüklenir; aşama başlığındaki sayı tüm kayıtları sayar.
    private const int ColumnSize = 50;

    private CrmPage<OpportunityDto>? page;
    private IReadOnlyList<BoardColumn>? columns;
    private OpportunityDto? selected;
    private OpportunityDto? dragged;
    private string? dropTarget;
    private bool editing;
    private bool board = true;
    private bool mine;
    private bool overdue;
    private bool noAction;
    private string status = string.Empty;
    private string? message;
    private string? search;

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (Session.Can(CrmAccess.OpportunitiesRead))
        {
            await Lookups.LoadAsync(contacts: true);
            await LoadAsync(1);
        }
    }

    // Tutar ve olasılık hassas alandır (Y8b); izni olmayan için sunucu göndermez, sütunlar ve toplamlar gösterilmez.
    private bool ShowAmounts => Session.Can(CrmAccess.OpportunityAmountsRead);

    private static string FormatAmount(OpportunityDto opportunity) =>
        opportunity.Amount is { } amount ? CrmLabels.Amount(amount, opportunity.Currency) : string.Empty;

    private static string Totals(IEnumerable<OpportunityDto> items) =>
        string.Join(" + ", items
            .Where(o => o.Amount is not null)
            .GroupBy(o => o.Currency)
            .Select(g => CrmLabels.Amount(g.Sum(o => o.Amount!.Value), g.Key)));

    private string Filters()
    {
        var filters = $"&search={Uri.EscapeDataString(search ?? string.Empty)}";
        if (mine) { filters += "&ownerId=me"; }
        if (overdue) { filters += $"&closeOverdueBefore={DateOnly.FromDateTime(DateTime.UtcNow):yyyy-MM-dd}"; }
        if (noAction) { filters += "&noNextAction=true"; }
        if (status.Length > 0) { filters += $"&status={status}"; }
        return filters;
    }

    private async Task SwitchAsync(bool toBoard)
    {
        board = toBoard;
        await LoadAsync(1);
    }

    private async Task ToggleMineAsync()
    {
        mine = !mine;
        await LoadAsync(1);
    }

    private async Task ToggleOverdueAsync()
    {
        overdue = !overdue;
        await LoadAsync(1);
    }

    private async Task ToggleNoActionAsync()
    {
        noAction = !noAction;
        await LoadAsync(1);
    }

    // Aşama değiştirme ve kapatma ayrı izinlerdir (yazma izni de kabul edilir); kural ve yetki sunucuda uygulanır.
    private bool CanMove => Session.Can(CrmAccess.OpportunitiesChangeStage) || Session.Can(CrmAccess.OpportunitiesWrite);

    private async Task LoadAsync(int pageNumber)
    {
        if (board)
        {
            // Sütunlar firmanın aşama sırasıyla (Y9b); pasif aşama yalnızca üzerinde fırsat varsa görünür.
            var stages = Lookups.ValuesOf(CrmLists.OpportunityStage);
            var results = await Task.WhenAll(stages.Select(async stage =>
                (Stage: stage, Result: await Api.GetAsync<CrmPage<OpportunityDto>>(
                    $"{Url}?stage={Uri.EscapeDataString(stage.Key)}&pageSize={ColumnSize}{Filters()}"))));
            message = results.Select(r => r.Result.Error).FirstOrDefault(e => e is not null);
            columns = results
                .Where(r => r.Stage.Active || r.Result.Value?.TotalCount > 0)
                .Select(r => new BoardColumn(r.Stage.Key, r.Result.Value ?? new CrmPage<OpportunityDto>([], 1, ColumnSize, 0)))
                .ToList();
            return;
        }

        var result = await Api.GetAsync<CrmPage<OpportunityDto>>($"{Url}?page={pageNumber}&pageSize={ListPaging.Size}{Filters()}");
        page = result.Value;
        message = result.Error;
    }

    private async Task DropAsync(string stage)
    {
        dropTarget = null;
        if (dragged is { } opportunity)
        {
            dragged = null;
            await MoveAsync(opportunity, stage);
        }
    }

    /// <summary>
    /// Aşamayı değiştirir; pano ve fırsat sayfası aynı sunucu kuralını (koşullar, durum, olasılık) kullanır. Kazanıldı/Kaybedildi aşamasına
    /// bırakma kapanış bilgisi gerektirir: fırsat sayfası açılır, aşama burada değişmez.
    /// </summary>
    private async Task MoveAsync(OpportunityDto opportunity, string stage)
    {
        if (opportunity.Stage == stage)
        {
            return;
        }

        if (Lookups.IsClosed(stage))
        {
            Navigation.NavigateTo($"crm/firsatlar/{opportunity.Id}");
            return;
        }

        var result = await Api.PostAsync<OpportunityActionResultDto>($"{Url}/{opportunity.Id}/stage", new ChangeOpportunityStageRequest(opportunity.Version, stage));
        message = result.IsSuccess ? null : string.Join(" ", new[] { result.Error }.Concat(result.FieldErrors.Values.SelectMany(v => v)).Where(m => !string.IsNullOrWhiteSpace(m)).Distinct());
        await LoadAsync(1);
    }

    private void Open(OpportunityDto? opportunity)
    {
        selected = opportunity;
        editing = true;
        message = null;
    }

    private async Task SavedAsync()
    {
        editing = false;
        await LoadAsync(page?.Page ?? 1);
    }

    private sealed record BoardColumn(string Stage, CrmPage<OpportunityDto> Page);
}
