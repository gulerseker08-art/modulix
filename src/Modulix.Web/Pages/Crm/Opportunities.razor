@page "/crm/firsatlar"
@inject ApiClient Api
@inject SessionState Session
@inject CrmLookups Lookups
@inject NavigationManager Navigation

<PageTitle>Fırsatlar · Modulix</PageTitle>

<AuthGate Module="@CrmAccess.ModuleKey" Permission="@CrmAccess.OpportunitiesRead">
    <PageHeader Title="Fırsatlar" Icon="target" Subtitle="Satış fırsatlarınızı aşama aşama takip edin.">
        <a class="btn btn-outline-secondary" href="crm/firsat-raporu">Rapor</a>
    </PageHeader>

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }

    @if (editing)
    {
        <OpportunityEditor Opportunity="selected" Lookups="Lookups" Saved="SavedAsync" Deleted="SavedAsync" Cancelled="SavedAsync" />
    }

    <ViewTabs Items="ViewOptions" Value="@view" ValueChanged="ChooseViewAsync" Label="Fırsat görünümleri" NewView="StartNamingAsync" NewViewText="Görünüm" />

    <div class="filters">
        <div class="segmented" role="group" aria-label="Gösterim">
            <button type="button" class="chip @(board ? "active" : null)" @onclick="() => SwitchAsync(true)">Satış hunisi</button>
            <button type="button" class="chip @(!board ? "active" : null)" @onclick="() => SwitchAsync(false)">Liste</button>
        </div>
        <label class="visually-hidden" for="status-filter">Durum</label>
        <select id="status-filter" class="form-select form-select-sm filter-select" @bind="status" @bind:after="() => LoadAsync(1)">
            <option value="">Tüm durumlar</option>
            @foreach (var s in OpportunityStatus.All)
            {
                <option value="@s">@OpportunityStatus.Label(s)</option>
            }
        </select>
    </div>

    <div class="list-toolbar">
        <form class="search" @onsubmit="() => LoadAsync(1)" @onsubmit:preventDefault>
            <input class="form-control" type="search" aria-label="Fırsat ara" placeholder="Başlık ara" @bind="search" />
        </form>
        @if (!board)
        {
            <GridColumnPicker State="grid" Changed="@(() => Task.CompletedTask)" />
        }
        @if (Session.Can(CrmAccess.OpportunitiesWrite) && !editing)
        {
            <button type="button" class="btn btn-primary" @onclick="() => Open(null)"><AppIcon Name="plus" Size="16" /> Yeni fırsat</button>
        }
    </div>

    @if (!board)
    {
        <PersonalViewBar Active="Active" Dirty="IsDirty" Naming="views.Naming" NamingChanged="views.StartNaming" Error="@views.Error"
                         SaveAs="SaveAsAsync" UpdateView="UpdateViewAsync" DiscardChanges="DiscardAsync" DeleteView="DeleteViewAsync" />
    }

    @if (board)
    {
        @if (columns is null)
        {
            <p class="text-muted">Yükleniyor…</p>
        }
        else
        {
            <p class="text-muted small board-hint">
                @(CanMove ? "Kartı sürükleyerek veya kartın altındaki listeden aşamasını değiştirin. Kazanıldı/Kaybedildi sütununa bırakmak fırsat sayfasını açar (kapanış bilgisi istenir)." : null)
            </p>
            <div class="board">
                @foreach (var column in columns)
                {
                    <section class="board-column @(dropTarget == column.Stage ? "drop" : null)"
                             @ondragover="() => dropTarget = column.Stage" @ondragover:preventDefault
                             @ondragleave="() => dropTarget = null"
                             @ondrop="() => DropAsync(column.Stage)">
                        <header>
                            <span class="badge stage-@Lookups.Badge(CrmLists.OpportunityStage, column.Stage)">@Lookups.Label(CrmLists.OpportunityStage, column.Stage)</span>
                            <span class="count">@column.Page.TotalCount</span>
                            @if (ShowAmounts)
                            {
                                <small>@Totals(column.Page.Items)</small>
                            }
                        </header>
                        @foreach (var opportunity in column.Page.Items)
                        {
                            <article class="board-card" draggable="@(CanMove && opportunity.Status == OpportunityStatus.Open ? "true" : "false")"
                                     @ondragstart="() => dragged = opportunity">
                                <a href="crm/firsatlar/@opportunity.Id"><strong>@opportunity.Title</strong></a>
                                @if (opportunity.Status != OpportunityStatus.Open)
                                {
                                    <span class="badge stage-@opportunity.Status.ToLowerInvariant()">@OpportunityStatus.Label(opportunity.Status)</span>
                                }
                                @if (opportunity.SourceLeadId is { } cardLead && Session.Can(CrmAccess.LeadsRead)) { <a class="small" href="crm/leadler/@cardLead">Kaynak müşteri adayı</a> }
                                <a href="crm/firmalar/@opportunity.CompanyId">@Lookups.CompanyName(opportunity.CompanyId)</a>
                                @if (ShowAmounts)
                                {
                                    <span>
                                        @FormatAmount(opportunity)
                                        @if (opportunity.Probability is { } probability) { <text> · %@probability</text> }
                                    </span>
                                }
                                @if (opportunity.OwnerId is not null)
                                {
                                    <span class="owner">@Lookups.MemberName(opportunity.OwnerId)</span>
                                }
                                @if (CanMove && opportunity.Status == OpportunityStatus.Open)
                                {
                                    <div class="card-actions">
                                        <select class="form-select form-select-sm" aria-label="Aşama" value="@opportunity.Stage"
                                                @onchange="e => MoveAsync(opportunity, (string)e.Value!)">
                                            @foreach (var stage in Lookups.Choices(CrmLists.OpportunityStage, opportunity.Stage))
                                            {
                                                <option value="@stage.Key">@stage.Label</option>
                                            }
                                        </select>
                                        <button type="button" class="btn btn-link btn-sm" @onclick="() => Open(opportunity)">Düzenle</button>
                                    </div>
                                }
                            </article>
                        }
                        @if (column.Page.TotalCount > column.Page.Items.Count)
                        {
                            <p class="text-muted small">İlk @column.Page.Items.Count kayıt gösteriliyor; listeyi kullanın.</p>
                        }
                    </section>
                }
            </div>
        }
    }
    else if (page is null)
    {
        <p class="text-muted">Yükleniyor…</p>
    }
    else if (page.Items.Count == 0)
    {
        <p class="text-muted">Kayıt yok.</p>
    }
    else
    {
        <table class="table record-table">
            <thead>
                <tr>
                    @foreach (var column in grid.VisibleColumns)
                    {
                        <GridHeader Column="column" State="grid" SortChanged="SortAsync" Class="@(column.Key == "amount" ? "text-end" : null)" />
                    }
                    <th scope="col" class="row-menu-cell"><span class="visually-hidden">Eylemler</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var opportunity in page.Items)
                {
                    <tr>
                        @foreach (var column in grid.VisibleColumns)
                        {
                            @Cell(column, opportunity)
                        }
                        <td class="row-menu-cell">
                            <RowMenu Label="@($"{opportunity.Title} eylemleri")">
                                <a class="view-menu-item" role="menuitem" href="crm/firsatlar/@opportunity.Id"><AppIcon Name="eye" Size="16" /> <span>Aç</span></a>
                                @if (Session.Can(CrmAccess.OpportunitiesWrite))
                                {
                                    <button type="button" class="view-menu-item" role="menuitem" @onclick="() => Open(opportunity)"><AppIcon Name="pencil" Size="16" /> <span>Düzenle</span></button>
                                }
                            </RowMenu>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager PageSizeChoice="true" Page="page.Page" PageSize="page.PageSize" TotalCount="page.TotalCount" PageChanged="LoadAsync" />
    }
</AuthGate>

@code {
    private const string Url = "/api/crm/opportunities";
    private const string AllView = "all";
    private const string MineView = "mine";
    private const string OverdueView = "overdue";
    private const string NoActionView = "noAction";

    // Panoda her aşamadan en fazla bu kadar kart yüklenir; aşama başlığındaki sayı tüm kayıtları sayar.
    private const int ColumnSize = 50;

    // Başlıklar sunucuda sıralanır (varsayılan: en yeni önce, "default" sunucuya gönderilmeyen belirteçtir). Firma/sorumlu adı ilişki ve üyelik
    // tablosunda olduğundan, tutar ve olasılık hassas alan olduğundan (sıralama değeri sezdirir) bu sütunlar sıralanamaz.
    private static readonly GridColumnDef[] BaseColumns =
    [
        new("title", "Başlık", "type", "title", "-title", Locked: true),
        new("company", "Firma", "building"),
        new("stage", "Aşama", "tag", "stage", "-stage"),
        new("amount", "Tutar", "coins"),
        new("probability", "Olasılık", "percent"),
        new("owner", "Sorumlu", "user"),
        new("closeDate", "Kapanış", "calendar", "closeDate", "-closeDate"),
        new("number", "No", "hash", "number", "-number", DefaultVisible: false),
        new("priority", "Öncelik", "alert-circle", "priority", "-priority", DefaultVisible: false),
        new("type", "Tür", "tag", "type", "-type", DefaultVisible: false),
        new("source", "Kaynak", "globe", "source", "-source", DefaultVisible: false),
        new("nextActionDate", "Sonraki aksiyon", "clock", "nextActionDate", "-nextActionDate", DefaultVisible: false),
    ];

    private readonly GridViewState grid = new("crm.opportunities", "default");
    private PersonalGridViews views = default!;
    private CrmPage<OpportunityDto>? page;
    private IReadOnlyList<BoardColumn>? columns;
    private OpportunityDto? selected;
    private OpportunityDto? dragged;
    private string? dropTarget;
    private bool editing;
    private bool board = true;
    private string view = AllView;

    /// <summary>Etkin sistem görünümü (kişisel görünümde kayıtlı olan): tümü, benim, kapanışı geçenler, aksiyonsuz.</summary>
    private string current = AllView;
    private string status = string.Empty;
    private string? message;
    private string? search;

    protected override async Task OnInitializedAsync()
    {
        views = new PersonalGridViews(Api, "crm.opportunities");
        await Session.EnsureLoadedAsync();
        if (Session.Can(CrmAccess.OpportunitiesRead))
        {
            await Lookups.LoadAsync(contacts: true);
            grid.Define([
                .. BaseColumns.Where(c => ShowAmounts || c.Key is not ("amount" or "probability")),
                .. Lookups.FieldsOf(CrmEntityKeys.Opportunity).Select(f => new GridColumnDef("custom." + f.Key, f.Label, "type", DefaultVisible: f.ShowInList)),
            ]);
            await views.LoadAsync();
            await LoadAsync(1);
        }
    }

    // Tutar ve olasılık hassas alandır (Y8b); izni olmayan için sunucu göndermez, sütunlar ve toplamlar gösterilmez.
    private bool ShowAmounts => Session.Can(CrmAccess.OpportunityAmountsRead);

    private GridViewDto? Active => views.Find(view);

    // Görünümler yalnızca süzgeçtir (Benim, Tümü, Kapanışı geçenler, Aksiyonsuz, kişisel); kapsamı sunucu uygular.
    private IReadOnlyList<ViewOption> ViewOptions =>
    [
        new(MineView, "Benim fırsatlarım", Icon: "star"),
        new(AllView, "Tüm fırsatlar", Icon: "target"),
        new(OverdueView, "Kapanışı geçenler", Icon: "clock"),
        new(NoActionView, "Aksiyonsuz", Icon: "alert-circle"),
        .. views.Options,
    ];

    // Kayıtlı süzgeç: sistem görünümü + durum. Sayfa içi anahtarlardır, API'ye gitmez.
    private string? CurrentFilters => GridFilters.Build(
        current != AllView ? ("view", current) : null,
        status.Length > 0 ? ("status", status) : null);

    // Kaydedilmemiş değişiklik: sütun/sıralama ya da (kişisel görünümde) süzgeç kayıtlı hâlden farklı.
    private bool IsDirty => grid.Differs(Active) || (Active is { } saved && CurrentFilters != (string.IsNullOrEmpty(saved.Filters) ? null : saved.Filters));

    private static string FormatAmount(OpportunityDto opportunity) =>
        opportunity.Amount is { } amount ? CrmLabels.Amount(amount, opportunity.Currency) : string.Empty;

    private static string Totals(IEnumerable<OpportunityDto> items) =>
        string.Join(" + ", items
            .Where(o => o.Amount is not null)
            .GroupBy(o => o.Currency)
            .Select(g => CrmLabels.Amount(g.Sum(o => o.Amount!.Value), g.Key)));

    private string Filters()
    {
        var filters = $"&search={Uri.EscapeDataString(search ?? string.Empty)}";
        if (current == MineView) { filters += "&ownerId=me"; }
        if (current == OverdueView) { filters += $"&closeOverdueBefore={DateOnly.FromDateTime(DateTime.UtcNow):yyyy-MM-dd}"; }
        if (current == NoActionView) { filters += "&noNextAction=true"; }
        if (status.Length > 0) { filters += $"&status={status}"; }
        return filters;
    }

    private async Task SwitchAsync(bool toBoard)
    {
        board = toBoard;
        await LoadAsync(1);
    }

    private async Task ChooseViewAsync(string key)
    {
        view = key;
        views.StartNaming(false);
        if (Active is { } saved)
        {
            // Kişisel görünüm sütunlu listeye aittir: liste gösterimine geçer; sütunlar, sıralama ve süzgeç birlikte gelir.
            board = false;
            grid.Apply(saved);
            var filters = GridFilters.Parse(saved.Filters);
            current = filters.GetValueOrDefault("view") is { } baseView && baseView is MineView or OverdueView or NoActionView ? baseView : AllView;
            status = filters.GetValueOrDefault("status") ?? string.Empty;
        }
        else
        {
            grid.Reset();
            current = key;
        }

        await LoadAsync(1);
    }

    private async Task SortAsync(string key)
    {
        grid.Sort = key;
        await LoadAsync(1);
    }

    // "+ Görünüm" sütunlu listeyi kaydeder; pano açıkken önce liste gösterimine geçilir.
    private async Task StartNamingAsync()
    {
        if (board)
        {
            await SwitchAsync(false);
        }

        views.StartNaming(true);
    }

    private async Task SaveAsAsync(string name)
    {
        if (await views.SaveAsAsync(grid.ToRequest(name, CurrentFilters)) is { } key)
        {
            view = key;
        }
    }

    private async Task UpdateViewAsync()
    {
        if (Active is { } saved)
        {
            await views.UpdateAsync(saved, grid.ToRequest(saved.Name, CurrentFilters));
        }
    }

    private async Task DiscardAsync() => await ChooseViewAsync(view);

    private async Task DeleteViewAsync()
    {
        if (Active is { } saved && await views.DeleteAsync(saved))
        {
            await ChooseViewAsync(AllView);
        }
    }

    // Aşama değiştirme ve kapatma ayrı izinlerdir (yazma izni de kabul edilir); kural ve yetki sunucuda uygulanır.
    private bool CanMove => Session.Can(CrmAccess.OpportunitiesChangeStage) || Session.Can(CrmAccess.OpportunitiesWrite);

    private async Task LoadAsync(int pageNumber)
    {
        if (board)
        {
            // Sütunlar firmanın aşama sırasıyla (Y9b); pasif aşama yalnızca üzerinde fırsat varsa görünür.
            var stages = Lookups.ValuesOf(CrmLists.OpportunityStage);
            var results = await Task.WhenAll(stages.Select(async stage =>
                (Stage: stage, Result: await Api.GetAsync<CrmPage<OpportunityDto>>(
                    $"{Url}?stage={Uri.EscapeDataString(stage.Key)}&pageSize={ColumnSize}{Filters()}"))));
            message = results.Select(r => r.Result.Error).FirstOrDefault(e => e is not null);
            columns = results
                .Where(r => r.Stage.Active || r.Result.Value?.TotalCount > 0)
                .Select(r => new BoardColumn(r.Stage.Key, r.Result.Value ?? new CrmPage<OpportunityDto>([], 1, ColumnSize, 0)))
                .ToList();
            return;
        }

        var sort = grid.Sort != grid.DefaultSort ? $"&sort={Uri.EscapeDataString(grid.Sort)}" : string.Empty;
        var result = await Api.GetAsync<CrmPage<OpportunityDto>>($"{Url}?page={pageNumber}&pageSize={ListPaging.Size}{Filters()}{sort}");
        page = result.Value;
        message = result.Error;
    }

    private RenderFragment Cell(GridColumnDef column, OpportunityDto opportunity) =>
        @<td data-label="@column.Label" class="@(column.Key == "title" ? "primary" : column.Key == "amount" ? "text-end" : null)">@CellContent(column.Key, opportunity)</td>;

    private RenderFragment CellContent(string key, OpportunityDto opportunity) => key switch
    {
        "title" => TitlePart(opportunity),
        "company" => @<a href="crm/firmalar/@opportunity.CompanyId">@Lookups.CompanyName(opportunity.CompanyId)</a>,
        "stage" => StagePart(opportunity),
        "amount" => @<text>@FormatAmount(opportunity)</text>,
        "probability" => @<text>@(opportunity.Probability is { } p ? $"%{p}" : null)</text>,
        "owner" => @<OwnerCell Name="@Lookups.MemberName(opportunity.OwnerId)" />,
        "closeDate" => @<text>@(opportunity.ExpectedCloseDate is { } date ? CrmLabels.Date(date) : null)</text>,
        "number" => @<text>@opportunity.OpportunityNumber</text>,
        "priority" => @<text>@LeadPriority.Label(opportunity.Priority)</text>,
        "type" => @<text>@Lookups.Label(CrmLists.OpportunityType, opportunity.Type)</text>,
        "source" => @<text>@Lookups.Label(CrmLeadLists.Source, opportunity.Source)</text>,
        "nextActionDate" => @<text>@(opportunity.NextActionDate is { } next ? CrmLabels.Date(next) : null)</text>,
        _ when key.StartsWith("custom.", StringComparison.Ordinal) && Lookups.FieldsOf(CrmEntityKeys.Opportunity).FirstOrDefault(f => "custom." + f.Key == key) is { } field =>
            @<text>@CustomFieldText.Format(field, opportunity.Custom)</text>,
        _ => @<text></text>,
    };

    private RenderFragment TitlePart(OpportunityDto opportunity) =>
        @<text>
            <a href="crm/firsatlar/@opportunity.Id">@opportunity.Title</a> <small class="text-muted">@opportunity.OpportunityNumber</small>
            @if (opportunity.SourceLeadId is { } sourceLead && Session.Can(CrmAccess.LeadsRead))
            {
                <a class="small d-block" href="crm/leadler/@sourceLead">Kaynak müşteri adayı</a>
            }
        </text>;

    private RenderFragment StagePart(OpportunityDto opportunity) =>
        @<text>
            <span class="badge stage-@Lookups.Badge(CrmLists.OpportunityStage, opportunity.Stage)">@Lookups.Label(CrmLists.OpportunityStage, opportunity.Stage)</span>
            @if (opportunity.Status != OpportunityStatus.Open)
            {
                <span class="badge stage-@opportunity.Status.ToLowerInvariant()">@OpportunityStatus.Label(opportunity.Status)</span>
            }
        </text>;

    private async Task DropAsync(string stage)
    {
        dropTarget = null;
        if (dragged is { } opportunity)
        {
            dragged = null;
            await MoveAsync(opportunity, stage);
        }
    }

    /// <summary>
    /// Aşamayı değiştirir; pano ve fırsat sayfası aynı sunucu kuralını (koşullar, durum, olasılık) kullanır. Kazanıldı/Kaybedildi aşamasına
    /// bırakma kapanış bilgisi gerektirir: fırsat sayfası açılır, aşama burada değişmez.
    /// </summary>
    private async Task MoveAsync(OpportunityDto opportunity, string stage)
    {
        if (opportunity.Stage == stage)
        {
            return;
        }

        if (Lookups.IsClosed(stage))
        {
            Navigation.NavigateTo($"crm/firsatlar/{opportunity.Id}");
            return;
        }

        var result = await Api.PostAsync<OpportunityActionResultDto>($"{Url}/{opportunity.Id}/stage", new ChangeOpportunityStageRequest(opportunity.Version, stage));
        message = result.IsSuccess ? null : string.Join(" ", new[] { result.Error }.Concat(result.FieldErrors.Values.SelectMany(v => v)).Where(m => !string.IsNullOrWhiteSpace(m)).Distinct());
        await LoadAsync(1);
    }

    private void Open(OpportunityDto? opportunity)
    {
        selected = opportunity;
        editing = true;
        message = null;
    }

    private async Task SavedAsync()
    {
        editing = false;
        await LoadAsync(page?.Page ?? 1);
    }

    private sealed record BoardColumn(string Stage, CrmPage<OpportunityDto> Page);
}
