@page "/crm/firsatlar"
@inject ApiClient Api
@inject SessionState Session
@inject CrmLookups Lookups

<PageTitle>Fırsatlar · Modulix</PageTitle>

<AuthGate Module="@CrmAccess.ModuleKey" Permission="@CrmAccess.OpportunitiesRead">
    <div class="page-header">
        <h1>Fırsatlar</h1>
        @if (Session.Can(CrmAccess.OpportunitiesWrite) && form is null)
        {
            <button type="button" class="btn btn-primary" @onclick="New">Yeni fırsat</button>
        }
    </div>

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }

    @if (form is not null)
    {
        <form class="record-form" novalidate @onsubmit="SaveAsync" @onsubmit:preventDefault>
            <h2>@(form.Id is null ? "Yeni fırsat" : "Fırsatı düzenle")</h2>
            <div class="form-grid">
                <div class="span-all">
                    <label class="form-label" for="title">Başlık *</label>
                    <input id="title" class="form-control" maxlength="@CrmLimits.TextMaxLength" @bind="form.Title" />
                    <FieldError Field="title" Errors="errors" />
                </div>
                <div>
                    <label class="form-label" for="companyId">Firma *</label>
                    <select id="companyId" class="form-select" @bind="form.CompanyId">
                        <option value="">Seçin</option>
                        @foreach (var company in Lookups.Companies)
                        {
                            <option value="@company.Id">@company.Name</option>
                        }
                    </select>
                    <FieldError Field="companyId" Errors="errors" />
                </div>
                <div>
                    <label class="form-label" for="contactId">Kişi</label>
                    <select id="contactId" class="form-select" @bind="form.ContactId">
                        <option value="">—</option>
                        @foreach (var contact in Lookups.Contacts.Where(c => form.CompanyId is null || c.CompanyId == form.CompanyId))
                        {
                            <option value="@contact.Id">@contact.FirstName @contact.LastName</option>
                        }
                    </select>
                    <FieldError Field="contactId" Errors="errors" />
                </div>
                <div>
                    <label class="form-label" for="stage">Aşama</label>
                    <select id="stage" class="form-select" @bind="form.Stage">
                        @foreach (var stage in Enum.GetValues<OpportunityStage>())
                        {
                            <option value="@stage">@CrmLabels.Of(stage)</option>
                        }
                    </select>
                    <FieldError Field="stage" Errors="errors" />
                </div>
                <div>
                    <label class="form-label" for="expectedCloseDate">Beklenen kapanış</label>
                    <input id="expectedCloseDate" class="form-control" type="date" @bind="form.ExpectedCloseDate" />
                    <FieldError Field="expectedCloseDate" Errors="errors" />
                </div>
                <div>
                    <label class="form-label" for="amount">Tutar</label>
                    <input id="amount" class="form-control" type="number" min="0" step="0.01" inputmode="decimal" @bind="form.Amount" />
                    <FieldError Field="amount" Errors="errors" />
                </div>
                <div>
                    <label class="form-label" for="currency">Para birimi</label>
                    <input id="currency" class="form-control" maxlength="3" @bind="form.Currency" />
                    <FieldError Field="currency" Errors="errors" />
                </div>
                <div class="span-all">
                    <label class="form-label" for="notes">Notlar</label>
                    <textarea id="notes" class="form-control" rows="3" maxlength="@CrmLimits.NotesMaxLength" @bind="form.Notes"></textarea>
                    <FieldError Field="notes" Errors="errors" />
                </div>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary" disabled="@busy">Kaydet</button>
                <button type="button" class="btn btn-outline-secondary" @onclick="Cancel">Vazgeç</button>
                @if (form.Id is not null)
                {
                    <button type="button" class="btn btn-outline-danger ms-auto" disabled="@busy" @onclick="DeleteAsync">Sil</button>
                }
            </div>
        </form>
    }

    <form class="search" @onsubmit="() => LoadAsync(1)" @onsubmit:preventDefault>
        <input class="form-control" type="search" placeholder="Başlık ara" @bind="search" />
        <button type="submit" class="btn btn-outline-secondary">Ara</button>
    </form>

    @if (page is null)
    {
        <p class="text-muted">Yükleniyor…</p>
    }
    else if (page.Items.Count == 0)
    {
        <p class="text-muted">Kayıt yok.</p>
    }
    else
    {
        <table class="table record-table">
            <thead>
                <tr><th>Başlık</th><th>Firma</th><th>Aşama</th><th class="text-end">Tutar</th><th>Kapanış</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var opportunity in page.Items)
                {
                    <tr>
                        <td data-label="Başlık" class="primary">@opportunity.Title</td>
                        <td data-label="Firma">@Lookups.CompanyName(opportunity.CompanyId)</td>
                        <td data-label="Aşama"><span class="badge stage-@opportunity.Stage.ToString().ToLowerInvariant()">@CrmLabels.Of(opportunity.Stage)</span></td>
                        <td data-label="Tutar" class="text-end">@FormatAmount(opportunity)</td>
                        <td data-label="Kapanış">@(opportunity.ExpectedCloseDate is { } date ? CrmLabels.Date(date) : null)</td>
                        <td class="actions">
                            @if (Session.Can(CrmAccess.OpportunitiesWrite))
                            {
                                <button type="button" class="btn btn-outline-primary btn-sm" @onclick="() => Edit(opportunity)">Düzenle</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager Page="page.Page" PageSize="page.PageSize" TotalCount="page.TotalCount" PageChanged="LoadAsync" />
    }
</AuthGate>

@code {
    private const string Url = "/api/crm/opportunities";

    private CrmPage<OpportunityDto>? page;
    private OpportunityForm? form;
    private IReadOnlyDictionary<string, string[]>? errors;
    private string? message;
    private string? search;
    private bool busy;

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (Session.Can(CrmAccess.OpportunitiesRead))
        {
            await Lookups.LoadAsync(contacts: true);
            await LoadAsync(1);
        }
    }

    private static string FormatAmount(OpportunityDto opportunity) =>
        opportunity.Amount is { } amount ? CrmLabels.Amount(amount, opportunity.Currency) : string.Empty;

    private async Task LoadAsync(int pageNumber)
    {
        var result = await Api.GetAsync<CrmPage<OpportunityDto>>($"{Url}?page={pageNumber}&search={Uri.EscapeDataString(search ?? string.Empty)}");
        page = result.Value;
        message = result.Error;
    }

    private void New() => Open(new OpportunityForm());

    private void Edit(OpportunityDto opportunity) => Open(new OpportunityForm
    {
        Id = opportunity.Id,
        Version = opportunity.Version,
        Title = opportunity.Title,
        CompanyId = opportunity.CompanyId,
        ContactId = opportunity.ContactId,
        Stage = opportunity.Stage,
        Amount = opportunity.Amount,
        Currency = opportunity.Currency,
        ExpectedCloseDate = opportunity.ExpectedCloseDate,
        Notes = opportunity.Notes,
    });

    private void Open(OpportunityForm value)
    {
        form = value;
        errors = null;
        message = null;
    }

    private void Cancel() => form = null;

    private async Task SaveAsync()
    {
        if (form!.CompanyId is not { } companyId)
        {
            errors = new Dictionary<string, string[]> { ["companyId"] = ["Bu alan zorunludur."] };
            return;
        }

        busy = true;
        var request = new SaveOpportunityRequest(
            form.Title, companyId, form.ContactId, form.Stage, form.Amount, form.Currency, form.ExpectedCloseDate, form.Notes, form.Version);
        var result = form.Id is { } id
            ? await Api.PutAsync<OpportunityDto>($"{Url}/{id}", request)
            : await Api.PostAsync<OpportunityDto>(Url, request);
        busy = false;

        if (result.IsSuccess)
        {
            form = null;
            await LoadAsync(page?.Page ?? 1);
            return;
        }

        errors = result.FieldErrors;
        message = result.Error;
    }

    private async Task DeleteAsync()
    {
        busy = true;
        var result = await Api.DeleteAsync($"{Url}/{form!.Id}?version={form.Version}");
        busy = false;

        if (result.IsSuccess)
        {
            form = null;
            await LoadAsync(1);
            return;
        }

        message = result.Error;
    }

    private sealed class OpportunityForm
    {
        public Guid? Id { get; init; }

        public long? Version { get; init; }

        public string Title { get; set; } = string.Empty;

        public Guid? CompanyId { get; set; }

        public Guid? ContactId { get; set; }

        public OpportunityStage Stage { get; set; } = OpportunityStage.Lead;

        public decimal? Amount { get; set; }

        public string Currency { get; set; } = "TRY";

        public DateOnly? ExpectedCloseDate { get; set; }

        public string? Notes { get; set; }
    }
}
