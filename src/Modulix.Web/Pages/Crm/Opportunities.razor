@page "/crm/firsatlar"
@inject ApiClient Api
@inject SessionState Session
@inject CrmLookups Lookups

<PageTitle>Fırsatlar · Modulix</PageTitle>

<AuthGate Module="@CrmAccess.ModuleKey" Permission="@CrmAccess.OpportunitiesRead">
    <div class="page-header">
        <h1>Fırsatlar</h1>
        @if (Session.Can(CrmAccess.OpportunitiesWrite) && !editing)
        {
            <button type="button" class="btn btn-primary" @onclick="() => Open(null)">Yeni fırsat</button>
        }
    </div>

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }

    @if (editing)
    {
        <OpportunityEditor Opportunity="selected" Lookups="Lookups" Saved="SavedAsync" Deleted="SavedAsync" Cancelled="SavedAsync" />
    }

    <div class="filters">
        <div class="segmented" role="group" aria-label="Görünüm">
            <button type="button" class="chip @(board ? "active" : null)" @onclick="() => SwitchAsync(true)">Satış hunisi</button>
            <button type="button" class="chip @(!board ? "active" : null)" @onclick="() => SwitchAsync(false)">Liste</button>
        </div>
        <button type="button" class="chip @(mine ? "active" : null)" aria-pressed="@mine" @onclick="ToggleMineAsync">Yalnızca benimkiler</button>
    </div>

    <form class="search" @onsubmit="() => LoadAsync(1)" @onsubmit:preventDefault>
        <input class="form-control" type="search" placeholder="Başlık ara" @bind="search" />
        <button type="submit" class="btn btn-outline-secondary">Ara</button>
    </form>

    @if (board)
    {
        @if (columns is null)
        {
            <p class="text-muted">Yükleniyor…</p>
        }
        else
        {
            <p class="text-muted small board-hint">
                @(Session.Can(CrmAccess.OpportunitiesWrite) ? "Kartı sürükleyerek veya kartın altındaki listeden aşamasını değiştirin." : null)
            </p>
            <div class="board">
                @foreach (var column in columns)
                {
                    <section class="board-column @(dropTarget == column.Stage ? "drop" : null)"
                             @ondragover="() => dropTarget = column.Stage" @ondragover:preventDefault
                             @ondragleave="() => dropTarget = null"
                             @ondrop="() => DropAsync(column.Stage)">
                        <header>
                            <span class="badge stage-@column.Stage.ToString().ToLowerInvariant()">@CrmLabels.Of(column.Stage)</span>
                            <span class="count">@column.Page.TotalCount</span>
                            <small>@Totals(column.Page.Items)</small>
                        </header>
                        @foreach (var opportunity in column.Page.Items)
                        {
                            <article class="board-card" draggable="@(Session.Can(CrmAccess.OpportunitiesWrite) ? "true" : "false")"
                                     @ondragstart="() => dragged = opportunity">
                                <strong>@opportunity.Title</strong>
                                <a href="crm/firmalar/@opportunity.CompanyId">@Lookups.CompanyName(opportunity.CompanyId)</a>
                                <span>
                                    @FormatAmount(opportunity)
                                    @if (opportunity.Probability is { } probability) { <text> · %@probability</text> }
                                </span>
                                @if (opportunity.OwnerId is not null)
                                {
                                    <span class="owner">@Lookups.MemberName(opportunity.OwnerId)</span>
                                }
                                @if (Session.Can(CrmAccess.OpportunitiesWrite))
                                {
                                    <div class="card-actions">
                                        <select class="form-select form-select-sm" aria-label="Aşama" value="@opportunity.Stage"
                                                @onchange="e => MoveAsync(opportunity, Enum.Parse<OpportunityStage>((string)e.Value!))">
                                            @foreach (var stage in Enum.GetValues<OpportunityStage>())
                                            {
                                                <option value="@stage">@CrmLabels.Of(stage)</option>
                                            }
                                        </select>
                                        <button type="button" class="btn btn-link btn-sm" @onclick="() => Open(opportunity)">Düzenle</button>
                                    </div>
                                }
                            </article>
                        }
                        @if (column.Page.TotalCount > column.Page.Items.Count)
                        {
                            <p class="text-muted small">İlk @column.Page.Items.Count kayıt gösteriliyor; listeyi kullanın.</p>
                        }
                    </section>
                }
            </div>
        }
    }
    else if (page is null)
    {
        <p class="text-muted">Yükleniyor…</p>
    }
    else if (page.Items.Count == 0)
    {
        <p class="text-muted">Kayıt yok.</p>
    }
    else
    {
        <table class="table record-table">
            <thead>
                <tr><th>Başlık</th><th>Firma</th><th>Aşama</th><th class="text-end">Tutar</th><th>Olasılık</th><th>Sorumlu</th><th>Kapanış</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var opportunity in page.Items)
                {
                    <tr>
                        <td data-label="Başlık" class="primary">@opportunity.Title</td>
                        <td data-label="Firma"><a href="crm/firmalar/@opportunity.CompanyId">@Lookups.CompanyName(opportunity.CompanyId)</a></td>
                        <td data-label="Aşama"><span class="badge stage-@opportunity.Stage.ToString().ToLowerInvariant()">@CrmLabels.Of(opportunity.Stage)</span></td>
                        <td data-label="Tutar" class="text-end">@FormatAmount(opportunity)</td>
                        <td data-label="Olasılık">@(opportunity.Probability is { } p ? $"%{p}" : null)</td>
                        <td data-label="Sorumlu">@Lookups.MemberName(opportunity.OwnerId)</td>
                        <td data-label="Kapanış">@(opportunity.ExpectedCloseDate is { } date ? CrmLabels.Date(date) : null)</td>
                        <td class="actions">
                            @if (Session.Can(CrmAccess.OpportunitiesWrite))
                            {
                                <button type="button" class="btn btn-outline-primary btn-sm" @onclick="() => Open(opportunity)">Düzenle</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager Page="page.Page" PageSize="page.PageSize" TotalCount="page.TotalCount" PageChanged="LoadAsync" />
    }
</AuthGate>

@code {
    private const string Url = "/api/crm/opportunities";

    // Panoda her aşamadan en fazla bu kadar kart yüklenir; aşama başlığındaki sayı tüm kayıtları sayar.
    private const int ColumnSize = 50;

    private CrmPage<OpportunityDto>? page;
    private IReadOnlyList<BoardColumn>? columns;
    private OpportunityDto? selected;
    private OpportunityDto? dragged;
    private OpportunityStage? dropTarget;
    private bool editing;
    private bool board = true;
    private bool mine;
    private string? message;
    private string? search;

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (Session.Can(CrmAccess.OpportunitiesRead))
        {
            await Lookups.LoadAsync(contacts: true);
            await LoadAsync(1);
        }
    }

    private static string FormatAmount(OpportunityDto opportunity) =>
        opportunity.Amount is { } amount ? CrmLabels.Amount(amount, opportunity.Currency) : string.Empty;

    private static string Totals(IEnumerable<OpportunityDto> items) =>
        string.Join(" + ", items
            .Where(o => o.Amount is not null)
            .GroupBy(o => o.Currency)
            .Select(g => CrmLabels.Amount(g.Sum(o => o.Amount!.Value), g.Key)));

    private string Filters()
    {
        var filters = $"&search={Uri.EscapeDataString(search ?? string.Empty)}";
        return mine ? filters + "&ownerId=me" : filters;
    }

    private async Task SwitchAsync(bool toBoard)
    {
        board = toBoard;
        await LoadAsync(1);
    }

    private async Task ToggleMineAsync()
    {
        mine = !mine;
        await LoadAsync(1);
    }

    private async Task LoadAsync(int pageNumber)
    {
        if (board)
        {
            var results = await Task.WhenAll(Enum.GetValues<OpportunityStage>().Select(async stage =>
                (Stage: stage, Result: await Api.GetAsync<CrmPage<OpportunityDto>>($"{Url}?stage={stage}&pageSize={ColumnSize}{Filters()}"))));
            message = results.Select(r => r.Result.Error).FirstOrDefault(e => e is not null);
            columns = results
                .Select(r => new BoardColumn(r.Stage, r.Result.Value ?? new CrmPage<OpportunityDto>([], 1, ColumnSize, 0)))
                .ToList();
            return;
        }

        var result = await Api.GetAsync<CrmPage<OpportunityDto>>($"{Url}?page={pageNumber}{Filters()}");
        page = result.Value;
        message = result.Error;
    }

    private async Task DropAsync(OpportunityStage stage)
    {
        dropTarget = null;
        if (dragged is { } opportunity)
        {
            dragged = null;
            await MoveAsync(opportunity, stage);
        }
    }

    /// <summary>Aşamayı değiştirir. Kaybedildi'ye taşınan fırsat için nedeni sormak üzere form açılır.</summary>
    private async Task MoveAsync(OpportunityDto opportunity, OpportunityStage stage)
    {
        if (opportunity.Stage == stage)
        {
            return;
        }

        if (stage == OpportunityStage.Lost)
        {
            Open(opportunity with { Stage = stage });
            return;
        }

        var result = await Api.PutAsync<OpportunityDto>($"{Url}/{opportunity.Id}", CrmRequests.From(opportunity) with { Stage = stage });
        message = result.Error;
        await LoadAsync(1);
    }

    private void Open(OpportunityDto? opportunity)
    {
        selected = opportunity;
        editing = true;
        message = null;
    }

    private async Task SavedAsync()
    {
        editing = false;
        await LoadAsync(page?.Page ?? 1);
    }

    private sealed record BoardColumn(OpportunityStage Stage, CrmPage<OpportunityDto> Page);
}
