@page "/crm/teklif-raporu"
@inject ApiClient Api
@inject SessionState Session
@inject CrmLookups Lookups

<PageTitle>@Texts.Get("crm.quoteReport.title") · Modulix</PageTitle>

<AuthGate Module="@CrmAccess.ModuleKey" Permission="@CrmAccess.QuotesRead">
    <a class="back-link" href="crm/teklifler">← @Texts.Get("crm.quotes.title")</a>
    <div class="page-header">
        <h1>@Texts.Get("crm.quoteReport.title")</h1>
        @if (Session.Can(CrmAccess.QuotesExport))
        {
            <a class="btn btn-outline-secondary" href="api/crm/quotes/export?latestOnly=true" download="teklifler.csv">@Texts.Get("crm.quoteReport.csv")</a>
        }
    </div>

    <form class="filters" @onsubmit="LoadAsync" @onsubmit:preventDefault>
        <label class="form-label" for="qr-from">@Texts.Get("crm.quoteReport.from")</label>
        <input id="qr-from" class="form-control" type="date" @bind="from" />
        <label class="form-label" for="qr-to">@Texts.Get("crm.quoteReport.to")</label>
        <input id="qr-to" class="form-control" type="date" @bind="to" />
        <button type="submit" class="btn btn-primary" disabled="@busy">@Texts.Get("crm.sales.runReport")</button>
    </form>

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }

    @if (report is null)
    {
        @if (message is null)
        {
            <LoadingState />
        }
    }
    else
    {
        @if (report.Truncated)
        {
            <div class="alert alert-warning" role="status">@Texts.Get("crm.sales.reportTruncated")</div>
        }

        <section class="detail-section" aria-labelledby="qr-now">
            <div class="section-header"><h2 id="qr-now">@Texts.Get("crm.quoteReport.now")</h2></div>
            <dl class="detail-grid">
                <div><dt>@Texts.Get("crm.forecast-status.draft")</dt><dd>@report.DraftCount</dd></div>
                <div><dt>@Texts.Get("crm.quoteReport.awaitingApproval")</dt><dd>@report.PendingApprovalCount</dd></div>
                <div><dt>@Texts.Get("crm.quoteReport.waiting")</dt><dd>@report.WaitingCount</dd></div>
            </dl>
            <h3 class="h6">@Texts.Get("crm.quoteReport.waitingAmount")</h3>
            @Totals(report.WaitingTotals)
        </section>

        <section class="detail-section" aria-labelledby="qr-period">
            <div class="section-header"><h2 id="qr-period">@Texts.Get("crm.quoteReport.period", CrmLabels.Date(report.From), CrmLabels.Date(report.To))</h2></div>
            <dl class="detail-grid">
                <div><dt>@Texts.Get("crm.quoteReport.presented")</dt><dd>@report.PresentedCount</dd></div>
                <div><dt>@Texts.Get("crm.quoteReport.accepted")</dt><dd>@report.AcceptedCount</dd></div>
                <div><dt>@Texts.Get("crm.quoteReport.rejected")</dt><dd>@report.RejectedCount</dd></div>
                <div><dt>@Texts.Get("crm.quoteReport.cancelled")</dt><dd>@report.CancelledCount</dd></div>
                <div><dt>@Texts.Get("crm.salesAnalysis.outcome.expired")</dt><dd>@report.ExpiredCount</dd></div>
                <div><dt>@Texts.Get("crm.salesAnalysis.q.acceptanceRate")</dt><dd>@(report.AcceptanceRate is { } rate ? $"%{(rate * 100).ToString("0.#", Regional.Numbers)}" : "—")</dd></div>
                <div><dt>@Texts.Get("crm.quoteReport.avgDecision")</dt><dd>@Number(report.AverageDaysToDecision)</dd></div>
                <div><dt>@Texts.Get("crm.quoteReport.avgDiscount")</dt><dd>@(report.AverageDiscountPercent is { } d ? $"%{d.ToString("0.##", Regional.Numbers)}" : "—")</dd></div>
                <div><dt>@Texts.Get("crm.quoteReport.avgRevisions")</dt><dd>@Number(report.AverageRevisionsToAccept)</dd></div>
            </dl>
            <h3 class="h6">@Texts.Get("crm.quoteReport.presentedAmount")</h3>
            @Totals(report.PresentedTotals)
            <h3 class="h6">@Texts.Get("crm.quoteReport.acceptedAmount")</h3>
            @Totals(report.AcceptedTotals)
        </section>

        <section class="detail-section" aria-labelledby="qr-owner">
            <div class="section-header"><h2 id="qr-owner">@Texts.Get("crm.sales.byOwner")</h2></div>
            @if (report.ByOwner.Count == 0)
            {
                <EmptyState Title="@Texts.Get("crm.quoteReport.noOwnerRows")" />
            }
            else
            {
                <table class="table record-table">
                    <caption class="visually-hidden">@Texts.Get("crm.quoteReport.ownerCaption")</caption>
                    <thead><tr><th scope="col">@Texts.Get("common.field.owner")</th><th scope="col">@Texts.Get("crm.quoteReport.presented")</th><th scope="col">@Texts.Get("crm.quoteReport.accepted")</th><th scope="col">@Texts.Get("crm.quoteReport.rejected")</th><th scope="col">@Texts.Get("crm.quoteReport.acceptedAmount")</th></tr></thead>
                    <tbody>
                        @foreach (var o in report.ByOwner)
                        {
                            <tr>
                                <td data-label="@Texts.Get("common.field.owner")" class="primary">@(o.OwnerId is null ? Texts.Get("crm.leads.unassigned") : Lookups.MemberName(o.OwnerId))</td>
                                <td data-label="@Texts.Get("crm.quoteReport.presented")">@o.Presented</td>
                                <td data-label="@Texts.Get("crm.quoteReport.accepted")">@o.Accepted</td>
                                <td data-label="@Texts.Get("crm.quoteReport.rejected")">@o.Rejected</td>
                                <td data-label="@Texts.Get("crm.quoteReport.acceptedAmount")">@Amounts(o.AcceptedTotals)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </section>

        @Attention(Texts.Get("crm.quoteReport.expiringSoon"), "qr-soon", report.ExpiringSoon, Texts.Get("crm.quoteReport.validity"))
        @Attention(Texts.Get("crm.quoteReport.overdue"), "qr-over", report.Overdue, Texts.Get("crm.quoteReport.validity"))
        @Attention(Texts.Get("crm.quoteReport.awaitingApproval"), "qr-appr", report.AwaitingApproval, null)
        @Attention(Texts.Get("crm.quoteReport.notDelivered"), "qr-deliv", report.NotDelivered, Texts.Get("crm.quoteReport.delivery"))

        @if (Session.Can(CrmAccess.QuoteCostsRead))
        {
            <section class="detail-section" aria-labelledby="qr-margin">
                <div class="section-header"><h2 id="qr-margin">@Texts.Get("crm.quoteReport.margin")</h2></div>
                @if (margin is null)
                {
                    <p class="text-muted">@(marginError ?? Texts.Get("common.loading"))</p>
                }
                else
                {
                    <h3 class="h6">@Texts.Get("crm.quoteReport.marginPresented")</h3>
                    @MarginTable(margin.PresentedTotals)
                    <h3 class="h6">@Texts.Get("crm.quoteReport.marginAccepted")</h3>
                    @MarginTable(margin.AcceptedTotals)
                    @if (margin.ByOwner.Count > 0)
                    {
                        <h3 class="h6">@Texts.Get("crm.quoteReport.marginByOwner")</h3>
                        <ul>
                            @foreach (var o in margin.ByOwner)
                            {
                                <li>@(o.OwnerId is null ? Texts.Get("crm.leads.unassigned") : Lookups.MemberName(o.OwnerId)): @MarginLine(o.Totals)</li>
                            }
                        </ul>
                    }
                    @if (margin.LowestMargin.Count > 0)
                    {
                        <h3 class="h6">@Texts.Get("crm.quoteReport.lowestMargin")</h3>
                        <ul>
                            @foreach (var item in margin.LowestMargin.Take(10))
                            {
                                <li><a href="crm/teklifler/@item.Id">@item.Title (@item.QuoteNumber · V@(item.RevisionNo))</a> — @Texts.Get("crm.quoteReport.marginValue", QuoteLabels.Money(item.Margin, item.Currency), Number(item.MarginPercent))@(item.LinesWithoutCost > 0 ? " · " + Texts.Get("crm.quoteReport.linesWithoutCost", item.LinesWithoutCost) : null)</li>
                            }
                        </ul>
                    }
                    @if (margin.MissingCost.Count > 0)
                    {
                        <h3 class="h6">@Texts.Get("crm.quoteReport.missingCost", margin.MissingCost.Count)</h3>
                        <ul>
                            @foreach (var item in margin.MissingCost.Take(10))
                            {
                                <li><a href="crm/teklifler/@item.Id">@item.Title (@item.QuoteNumber)</a> — @Texts.Get("crm.quoteReport.lineCount", item.LinesWithoutCost)</li>
                            }
                        </ul>
                    }
                    <ul class="small text-muted">
                        @foreach (var definition in margin.Definitions) { <li>@definition</li> }
                    </ul>
                }
            </section>
        }

        <section class="detail-section" aria-labelledby="qr-defs">
            <div class="section-header"><h2 id="qr-defs">@Texts.Get("crm.sales.definitionsTitle")</h2></div>
            <ul class="small text-muted">
                @foreach (var definition in report.Definitions)
                {
                    <li>@definition</li>
                }
            </ul>
        </section>
    }
</AuthGate>

@code {
    private QuoteReportDto? report;
    private QuoteMarginReportDto? margin;
    private string? marginError;
    private DateTime? from = new(DateTime.UtcNow.Year, DateTime.UtcNow.Month, 1);
    private DateTime? to = DateTime.UtcNow.Date;
    private string? message;
    private bool busy;

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (Session.Can(CrmAccess.QuotesRead))
        {
            await Lookups.LoadAsync();
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        if (busy) { return; }
        busy = true;
        var query = new List<string>();
        if (from is { } f) { query.Add($"from={DateOnly.FromDateTime(f):yyyy-MM-dd}"); }
        if (to is { } t) { query.Add($"to={DateOnly.FromDateTime(t):yyyy-MM-dd}"); }
        var result = await Api.GetAsync<QuoteReportDto>($"/api/crm/quotes/report?{string.Join('&', query)}");
        busy = false;
        report = result.Value;
        message = result.Error;
        if (Session.Can(CrmAccess.QuoteCostsRead))
        {
            var m = await Api.GetAsync<QuoteMarginReportDto>($"/api/crm/quotes/margin-report?{string.Join('&', query)}");
            margin = m.Value;
            marginError = m.Error;
        }
    }

    private RenderFragment Totals(IReadOnlyList<QuoteCurrencyTotalDto> totals) => builder =>
    {
        builder.OpenElement(0, "p");
        builder.AddContent(1, Amounts(totals));
        builder.CloseElement();
    };

    private static string Amounts(IReadOnlyList<QuoteCurrencyTotalDto> totals) =>
        totals.Count == 0 ? "—" : string.Join(" · ", totals.Select(t => Texts.Get("crm.quoteReport.amountWithCount", QuoteLabels.Money(t.Gross, t.Currency), t.Count)));

    private RenderFragment MarginTable(IReadOnlyList<QuoteMarginTotalDto> totals) => builder =>
    {
        builder.OpenElement(0, "p");
        builder.AddContent(1, MarginLine(totals));
        builder.CloseElement();
    };

    private static string MarginLine(IReadOnlyList<QuoteMarginTotalDto> totals) =>
        totals.Count == 0 ? "—" : string.Join(" · ", totals.Select(t => Texts.Get("crm.quoteReport.marginLine", t.Currency, t.Net.ToString("N2", Regional.Numbers), t.Cost.ToString("N2", Regional.Numbers), t.Margin.ToString("N2", Regional.Numbers), Number(t.MarginPercent), t.LinesWithoutCost > 0 ? ", " + Texts.Get("crm.quoteReport.linesWithoutCost", t.LinesWithoutCost) : string.Empty, t.Count)));

    private static string Number(double? value) => value is { } v ? v.ToString("0.##", Regional.Numbers) : "—";

    private RenderFragment Attention(string title, string id, IReadOnlyList<QuoteReportItemDto> items, string? dateLabel) => builder =>
    {
        builder.OpenElement(0, "section");
        builder.AddAttribute(1, "class", "detail-section");
        builder.AddAttribute(2, "aria-labelledby", id);
        builder.AddMarkupContent(3, $"<div class=\"section-header\"><h2 id=\"{id}\">{System.Net.WebUtility.HtmlEncode(title)} ({items.Count})</h2></div>");
        if (items.Count == 0)
        {
            builder.AddMarkupContent(4, $"<p class=\"text-muted\">{System.Net.WebUtility.HtmlEncode(Texts.Get("common.noRecords"))}</p>");
        }
        else
        {
            builder.OpenElement(5, "ul");
            foreach (var item in items)
            {
                builder.OpenElement(6, "li");
                builder.OpenElement(7, "a");
                builder.AddAttribute(8, "href", $"crm/teklifler/{item.Id}");
                builder.AddContent(9, $"{item.Title} ({item.QuoteNumber} · V{item.RevisionNo})");
                builder.CloseElement();
                builder.AddContent(10, $" — {QuoteLabels.Money(item.Gross, item.Currency)}"
                    + (item.OwnerId is null ? string.Empty : $" · {Lookups.MemberName(item.OwnerId)}")
                    + (item.Date is { } d && dateLabel is not null ? $" · {dateLabel}: {CrmLabels.Date(d)}" : string.Empty)
                    + (item.Note is not null ? $" · {QuoteLabels.Label(QuoteLabels.Deliveries, item.Note)}" : string.Empty));
                builder.CloseElement();
            }

            builder.CloseElement();
        }

        builder.CloseElement();
    };
}
