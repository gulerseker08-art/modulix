@page "/crm/teklif-onaylari"
@inject ApiClient Api
@inject SessionState Session
@inject CrmLookups Lookups

<PageTitle>@Texts.Get("nav.app.crm.quote-approvals") · Modulix</PageTitle>

<AuthGate Module="@CrmAccess.ModuleKey" Permission="@CrmAccess.QuotesApprove">
    <div class="page-header">
        <h1>@Texts.Get("nav.app.crm.quote-approvals")</h1>
    </div>
    <p class="text-muted">@Texts.Get("crm.quoteApprovals.intro")</p>

    <Notice Text="@notice" Failed="@noticeFailed" />

    @if (items is null)
    {
        <LoadingState Kind="LoadingKind.Table" />
    }
    else if (items.Count == 0)
    {
        <EmptyState Title="@Texts.Get("crm.quoteApprovals.empty")" />
    }
    else
    {
        <table class="table record-table">
            <caption class="visually-hidden">@Texts.Get("crm.quoteApprovals.caption")</caption>
            <thead>
                <tr><th scope="col">@Texts.Get("crm.quotes.col.title")</th><th scope="col">@Texts.Get("crm.quotes.col.company")</th><th scope="col" class="text-end">@Texts.Get("crm.quotes.col.total")</th><th scope="col">@Texts.Get("crm.quoteApprovals.col.discount")</th><th scope="col">@Texts.Get("crm.approval.waiting")</th><th scope="col">@Texts.Get("crm.quoteApprovals.col.action")</th></tr>
            </thead>
            <tbody>
                @foreach (var quote in items)
                {
                    <tr>
                        <td data-label="@Texts.Get("crm.quotes.col.title")" class="primary"><a href="crm/teklifler/@quote.Id">@quote.Title</a> <small class="text-muted">@quote.QuoteNumber · V@(quote.RevisionNo)</small></td>
                        <td data-label="@Texts.Get("crm.quotes.col.company")">@Lookups.CompanyName(quote.CompanyId)</td>
                        <td data-label="@Texts.Get("crm.quotes.col.total")" class="text-end">@QuoteLabels.Money(quote.GrossTotal, quote.Currency)</td>
                        <td data-label="@Texts.Get("crm.quoteApprovals.col.discount")">@(quote.ListTotal > 0 ? $"%{(quote.DiscountTotal * 100m / quote.ListTotal):0.##}" : "—")</td>
                        <td data-label="@Texts.Get("crm.approval.waiting")">@Waiting(quote)</td>
                        <td class="actions">
                            @if (active?.Id == quote.Id)
                            {
                                <form @onsubmit="() => DecideAsync(quote)" @onsubmit:preventDefault>
                                    @if (requirement is not null)
                                    {
                                        <div class="small approval-reasons">
                                            <strong>@Texts.Get("crm.quoteApprovals.reasons")</strong>
                                            @if (requirement.Steps.Count > 1)
                                            {
                                                <div>@Texts.Get("crm.quoteApprovals.steps") @foreach (var step in requirement.Steps) { <span class="badge stage-@(step.Completed ? "won" : step.Step == requirement.CurrentStep ? "qualified" : "open")">@Texts.Get(step.Completed ? "crm.quoteApprovals.stepDone" : step.Step == requirement.CurrentStep ? "crm.quoteApprovals.stepCurrent" : "crm.quoteApprovals.stepQueued", step.Step) · @(step.Approvers.Count == 0 ? Texts.Get("crm.quoteApprovals.anyApprover") : string.Join(", ", step.Approvers.Select(a => Lookups.MemberName(a))))</span> }</div>
                                            }
                                            @if (requirement.ActingAsDelegate) { <div class="text-muted">@Texts.Get("crm.quoteApprovals.asDelegate")</div> }
                                            @foreach (var match in requirement.Matches) { <div>@match.Name — @match.Reason</div> }
                                            @if (requirement.ThresholdReason is not null) { <div>@requirement.ThresholdReason</div> }
                                            @if (requirement.Note is not null) { <div class="text-danger">@requirement.Note</div> }
                                        </div>
                                    }
                                    <label class="visually-hidden" for="reason-@quote.Id">@Texts.Get("crm.quoteApprovals.reasonLabel")</label>
                                    <input id="reason-@quote.Id" class="form-control form-control-sm" placeholder="@Texts.Get("crm.quoteApprovals.reasonPlaceholder")" maxlength="500" @bind="reason" />
                                    <button type="button" class="btn btn-primary btn-sm" disabled="@(busy || cannotDecide)" @onclick='() => DecideAsync(quote, "approve")'>@Texts.Get("crm.quoteApprovals.approve")</button>
                                    <button type="button" class="btn btn-outline-danger btn-sm" disabled="@(busy || cannotDecide)" @onclick='() => DecideAsync(quote, "reject-approval")'>@Texts.Get("crm.quoteApprovals.reject")</button>
                                    <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@(busy || cannotDecide)" @onclick='() => DecideAsync(quote, "request-changes")'>@Texts.Get("crm.quoteApprovals.requestChanges")</button>
                                    <button type="button" class="btn btn-link btn-sm" @onclick="() => active = null">@Texts.Get("common.dismiss")</button>
                                </form>
                            }
                            else
                            {
                                <button type="button" class="btn btn-outline-primary btn-sm" @onclick="() => Open(quote)">@Texts.Get("crm.approval.review")</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</AuthGate>

@code {
    private List<QuoteDto>? items;
    private QuoteDto? active;
    private QuoteApprovalRequirementDto? requirement;

    private bool cannotDecide => requirement is { CanDecide: false };
    private string reason = string.Empty;
    private string? notice;
    private bool noticeFailed;
    private bool busy;

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (Session.Can(CrmAccess.QuotesApprove))
        {
            await Lookups.LoadAsync();
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        var (loaded, error) = await Api.GetAllAsync<QuoteDto>("/api/crm/quotes?approvalStatus=Pending&status=Draft");
        items = loaded;
        Notify(error, error is not null);
    }

    private async Task Open(QuoteDto quote)
    {
        active = quote;
        reason = string.Empty;
        requirement = (await Api.GetAsync<QuoteApprovalRequirementDto>($"/api/crm/quotes/{quote.Id}/approval-requirements")).Value;
    }

    private async Task DecideAsync(QuoteDto quote, string action = "approve")
    {
        if (busy) { return; }
        if (action != "approve" && string.IsNullOrWhiteSpace(reason))
        {
            Notify(Texts.Get("crm.quoteApprovals.reasonRequired"), true);
            return;
        }

        busy = true;
        var result = await Api.PostAsync<QuoteDto>($"/api/crm/quotes/{quote.Id}/{action}", new QuoteTransitionRequest(quote.Version, Blank(reason)));
        busy = false;
        Notify(result.IsSuccess ? Texts.Get("crm.quoteApprovals.done", QuoteLabels.Action(action)) : result.Error, !result.IsSuccess);
        active = null;
        await LoadAsync();
    }

    private static string Waiting(QuoteDto quote)
    {
        var span = DateTimeOffset.UtcNow - (quote.CalculatedAt ?? DateTimeOffset.UtcNow);
        return QuoteLabels.Waiting(span);
    }

    private void Notify(string? text, bool failed)
    {
        notice = text;
        noticeFailed = failed;
    }

    private static string? Blank(string? text) => string.IsNullOrWhiteSpace(text) ? null : text.Trim();
}
