@page "/crm/firsat-raporu"
@inject ApiClient Api
@inject SessionState Session
@inject CrmLookups Lookups

<PageTitle>@Texts.Get("crm.opportunityReport.title") · Modulix</PageTitle>

<AuthGate Module="@CrmAccess.ModuleKey" Permission="@CrmAccess.OpportunitiesRead">
    <a class="back-link" href="crm/firsatlar">@Texts.Get("crm.opportunityReport.back")</a>
    <div class="page-header">
        <h1>@Texts.Get("crm.opportunityReport.title")</h1>
        @if (Session.Can(CrmAccess.OpportunitiesExport))
        {
            <a class="btn btn-outline-secondary" href="api/crm/opportunities/export" download="firsatlar.csv">@Texts.Get("crm.opportunityReport.csv")</a>
        }
    </div>

    <form class="filters" @onsubmit="LoadAsync" @onsubmit:preventDefault>
        <label class="form-label" for="rp-from">@Texts.Get("crm.opportunityReport.from")</label>
        <input id="rp-from" class="form-control" type="date" @bind="from" />
        <label class="form-label" for="rp-to">@Texts.Get("crm.opportunityReport.to")</label>
        <input id="rp-to" class="form-control" type="date" @bind="to" />
        <button type="submit" class="btn btn-primary" disabled="@busy">@Texts.Get("crm.sales.runReport")</button>
    </form>

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }

    @if (report is null)
    {
        @if (message is null)
        {
            <p class="text-muted">@Texts.Get("common.loading")</p>
        }
    }
    else
    {
        @if (report.Truncated)
        {
            <div class="alert alert-warning" role="status">@Texts.Get("crm.sales.reportTruncated")</div>
        }
        @if (!report.AmountsVisible)
        {
            <div class="alert alert-info" role="status">@Texts.Get("crm.opportunityReport.noAmounts")</div>
        }

        <section class="detail-section">
            <div class="section-header"><h2>@Texts.Get("crm.opportunityReport.open")</h2></div>
            <p>@Texts.Get("crm.opportunityReport.openSummary", report.OpenCount, report.OnHoldCount)</p>
            @TotalsTable(report.OpenTotals)
        </section>

        <section class="detail-section">
            <div class="section-header"><h2>@Texts.Get("crm.opportunityReport.byStage")</h2></div>
            <table class="table record-table">
                <thead><tr><th>@Texts.Get("crm.opportunities.col.stage")</th><th>@Texts.Get("crm.sales.col.count")</th><th>@Texts.Get("crm.sales.col.amount")</th><th>@Texts.Get("crm.opportunityReport.col.avgDays")</th></tr></thead>
                <tbody>
                    @foreach (var s in report.ByStage)
                    {
                        <tr>
                            <td data-label="@Texts.Get("crm.opportunities.col.stage")">@Lookups.Label(CrmLists.OpportunityStage, s.Stage)</td>
                            <td data-label="@Texts.Get("crm.sales.col.count")">@s.Count</td>
                            <td data-label="@Texts.Get("crm.sales.col.amount")">@Amounts(s.Totals)</td>
                            <td data-label="@Texts.Get("crm.opportunityReport.col.avgDaysShort")">@(s.AverageDaysInStage?.ToString("0.#") ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>

        <section class="detail-section">
            <div class="section-header"><h2>@Texts.Get("crm.sales.byOwner")</h2></div>
            <table class="table record-table">
                <thead><tr><th>@Texts.Get("common.field.owner")</th><th>@Texts.Get("crm.opportunityReport.col.open")</th><th>@Texts.Get("crm.opportunityReport.col.openAmount")</th><th>@Texts.Get("crm.opportunityReport.won")</th><th>@Texts.Get("crm.opportunityReport.lost")</th></tr></thead>
                <tbody>
                    @foreach (var o in report.ByOwner)
                    {
                        <tr>
                            <td data-label="@Texts.Get("common.field.owner")">@(o.OwnerId is null ? Texts.Get("crm.leads.unassigned") : Lookups.MemberName(o.OwnerId))</td>
                            <td data-label="@Texts.Get("crm.opportunityReport.col.open")">@o.OpenCount</td>
                            <td data-label="@Texts.Get("crm.opportunityReport.col.openAmount")">@Amounts(o.OpenTotals)</td>
                            <td data-label="@Texts.Get("crm.opportunityReport.won")">@o.WonCount</td>
                            <td data-label="@Texts.Get("crm.opportunityReport.lost")">@o.LostCount</td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>

        <section class="detail-section">
            <div class="section-header"><h2>@Texts.Get("crm.opportunityReport.forecast")</h2></div>
            <table class="table record-table">
                <thead><tr><th>@Texts.Get("crm.opportunityReport.col.month")</th><th>@Texts.Get("crm.opportunityReport.col.amountWeighted")</th></tr></thead>
                <tbody>
                    @foreach (var m in report.Forecast)
                    {
                        <tr><td data-label="@Texts.Get("crm.opportunityReport.col.month")">@m.Month</td><td data-label="@Texts.Get("crm.sales.col.amount")">@Amounts(m.Totals, weighted: true)</td></tr>
                    }
                </tbody>
            </table>
            <p class="text-muted small">@Texts.Get("crm.opportunityReport.forecastNote")</p>
        </section>

        <section class="detail-section">
            <div class="section-header"><h2>@Texts.Get("crm.opportunityReport.closings", CrmLabels.Date(report.From), CrmLabels.Date(report.To))</h2></div>
            <dl class="detail-grid">
                <div><dt>@Texts.Get("crm.opportunityReport.won")</dt><dd>@report.WonCount</dd></div>
                <div><dt>@Texts.Get("crm.opportunityReport.lost")</dt><dd>@report.LostCount</dd></div>
                <div><dt>@Texts.Get("crm.opportunityReport.cancelled")</dt><dd>@Texts.Get("crm.opportunityReport.cancelledValue", report.CancelledCount)</dd></div>
                <div><dt>@Texts.Get("crm.opportunityReport.winRate")</dt><dd>@(report.WinRate is { } rate ? $"%{rate * 100:0.#}" : Texts.Get("crm.opportunityReport.winRateUndefined"))</dd></div>
                <div><dt>@Texts.Get("crm.opportunityReport.avgCycle")</dt><dd>@(report.AverageCycleDays is { } cycle ? Texts.Get("crm.sales.days", $"{cycle:0.#}") : "—")</dd></div>
                <div><dt>@Texts.Get("crm.opportunityReport.wonAmount")</dt><dd>@Amounts(report.WonTotals)</dd></div>
            </dl>
            @if (report.LossReasons.Count > 0)
            {
                <h3>@Texts.Get("crm.opportunityReport.lossReasons")</h3>
                <ul class="item-list">
                    @foreach (var r in report.LossReasons)
                    {
                        <li><div class="item-main">@Lookups.Label(CrmLists.OpportunityLossReason, r.Key) <span class="text-muted">@r.Count</span></div></li>
                    }
                </ul>
            }
            @if (report.CompetitorLosses.Count > 0)
            {
                <h3>@Texts.Get("crm.opportunityReport.competitorLosses")</h3>
                <ul class="item-list">
                    @foreach (var c in report.CompetitorLosses)
                    {
                        <li><div class="item-main">@(c.Name ?? Texts.Get("crm.opportunityReport.unknownCompetitor")) <span class="text-muted">@c.Count</span></div></li>
                    }
                </ul>
            }
        </section>

        <section class="detail-section">
            <div class="section-header"><h2>@Texts.Get("crm.opportunityReport.attention")</h2></div>
            @AttentionList(Texts.Get("crm.opportunityReport.overdue"), report.Overdue)
            @AttentionList(Texts.Get("crm.opportunityReport.noNextAction"), report.NoNextAction)
            @AttentionList(Texts.Get("crm.opportunityReport.inactive"), report.Inactive)
            <h3>@Texts.Get("crm.opportunityReport.postponed")</h3>
            @if (report.Postponed.Count == 0)
            {
                <p class="text-muted">@Texts.Get("crm.opportunityReport.none")</p>
            }
            else
            {
                <ul class="item-list">
                    @foreach (var p in report.Postponed)
                    {
                        <li><div class="item-main"><a href="crm/firsatlar/@p.Id">@p.Title</a> <span class="text-muted">@(p.ExpectedCloseDate is { } d ? Texts.Get("crm.opportunityReport.changedNow", p.ChangeCount, CrmLabels.Date(d)) : Texts.Get("crm.opportunityReport.changed", p.ChangeCount))</span></div></li>
                    }
                </ul>
            }
        </section>

        <section class="detail-section">
            <div class="section-header"><h2>@Texts.Get("crm.sales.definitionsTitle")</h2></div>
            <ul>
                @foreach (var definition in report.Definitions)
                {
                    <li>@definition</li>
                }
            </ul>
        </section>
    }
</AuthGate>

@code {
    private OpportunityReportDto? report;
    private string? message;
    private bool busy;
    private DateOnly from = new(DateTime.UtcNow.Year, DateTime.UtcNow.Month, 1);
    private DateOnly to = DateOnly.FromDateTime(DateTime.UtcNow);

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (Session.Can(CrmAccess.OpportunitiesRead))
        {
            await Lookups.LoadAsync();
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        busy = true;
        var result = await Api.GetAsync<OpportunityReportDto>($"/api/crm/opportunities/report?from={from:yyyy-MM-dd}&to={to:yyyy-MM-dd}");
        busy = false;
        report = result.Value;
        message = result.Error;
    }

    // Para birimleri ayrı ayrı gösterilir; farklı birimler toplanmaz.
    private string Amounts(IReadOnlyList<OpportunityCurrencyTotal> totals, bool weighted = false)
    {
        if (totals.Count == 0)
        {
            return "—";
        }

        return string.Join(" + ", totals.Select(t => t.Amount is null
            ? Texts.Get("crm.sales.countUnit", t.Count)
            : weighted && t.Weighted is { } w
                ? Texts.Get("crm.opportunityReport.withWeighted", CrmLabels.Amount(t.Amount.Value, t.Currency), CrmLabels.Amount(w, t.Currency))
                : CrmLabels.Amount(t.Amount.Value, t.Currency)));
    }

    // Ham HTML tablosuna giren sözlük metni kodlanır.
    private static string Html(string key) => System.Net.WebUtility.HtmlEncode(Texts.Get(key));

    private RenderFragment TotalsTable(IReadOnlyList<OpportunityCurrencyTotal> totals) => builder =>
    {
        if (totals.Count == 0)
        {
            builder.AddMarkupContent(0, $"<p class=\"text-muted\">{Html("crm.sales.noOpen")}</p>");
            return;
        }

        var html = $"<table class=\"table record-table\"><thead><tr><th>{Html("crm.sales.currency")}</th><th>{Html("crm.sales.col.count")}</th><th>{Html("crm.sales.col.amount")}</th><th>{Html("crm.opportunityReport.col.weighted")}</th><th>{Html("crm.opportunityReport.col.unknownAmount")}</th><th>{Html("crm.opportunityReport.col.unknownProbability")}</th></tr></thead><tbody>"
            + string.Concat(totals.Select(t =>
                $"<tr><td data-label=\"{Html("crm.sales.currency")}\">{System.Net.WebUtility.HtmlEncode(t.Currency)}</td><td data-label=\"{Html("crm.sales.col.count")}\">{t.Count}</td>"
                + $"<td data-label=\"{Html("crm.sales.col.amount")}\">{(t.Amount is { } a ? CrmLabels.Amount(a, t.Currency) : "—")}</td>"
                + $"<td data-label=\"{Html("crm.opportunityReport.col.weighted")}\">{(t.Weighted is { } w ? CrmLabels.Amount(w, t.Currency) : "—")}</td>"
                + $"<td data-label=\"{Html("crm.opportunityReport.col.unknownAmount")}\">{t.UnknownAmountCount}</td><td data-label=\"{Html("crm.opportunityReport.col.unknownProbability")}\">{t.NoProbabilityCount}</td></tr>"))
            + "</tbody></table>";
        builder.AddMarkupContent(0, html);
    };

    private RenderFragment AttentionList(string title, IReadOnlyList<AttentionItem> items) => builder =>
    {
        var seq = 0;
        builder.OpenElement(seq++, "h3");
        builder.AddContent(seq++, title);
        builder.CloseElement();
        if (items.Count == 0)
        {
            builder.OpenElement(seq++, "p");
            builder.AddAttribute(seq++, "class", "text-muted");
            builder.AddContent(seq++, Texts.Get("crm.opportunityReport.none"));
            builder.CloseElement();
            return;
        }

        builder.OpenElement(seq++, "ul");
        builder.AddAttribute(seq++, "class", "item-list");
        foreach (var item in items)
        {
            builder.OpenElement(seq++, "li");
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "item-main");
            builder.OpenElement(seq++, "a");
            builder.AddAttribute(seq++, "href", $"crm/firsatlar/{item.Id}");
            builder.AddContent(seq++, $"{item.OpportunityNumber} · {item.Title}");
            builder.CloseElement();
            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "class", "text-muted");
            builder.AddContent(seq++, $" {Lookups.MemberName(item.OwnerId)}{(item.Date is { } d ? $" · {CrmLabels.Date(d)}" : null)}");
            builder.CloseElement();
            builder.CloseElement();
            builder.CloseElement();
        }

        builder.CloseElement();
    };
}
