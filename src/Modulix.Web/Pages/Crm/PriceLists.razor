@page "/crm/fiyat-listeleri"
@inject ApiClient Api
@inject SessionState Session

<PageTitle>@Texts.Get("crm.priceLists.title") · Modulix</PageTitle>

<AuthGate Module="@CrmAccess.ModuleKey" Permission="@CrmAccess.PricesRead">
    <div class="page-header">
        <h1>@Texts.Get("crm.priceLists.title")</h1>
    </div>

    <p class="text-muted">@Texts.Get("crm.priceLists.help")</p>

    <ViewTabs Items="ViewOptions" Value="@view" ValueChanged="ChooseViewAsync" Label="@Texts.Get("crm.priceLists.views")" NewView="StartNaming" />

    <div class="list-toolbar">
        <form class="search" @onsubmit="() => LoadAsync(1)" @onsubmit:preventDefault>
            <input class="form-control" type="search" aria-label="@Texts.Get("crm.priceLists.searchLabel")" placeholder="@Texts.Get("crm.priceLists.searchPlaceholder")" @bind="search" />
        </form>
        <GridColumnPicker State="grid" Changed="ColumnsChanged" />
        @if (Session.Can(CrmAccess.PricesWrite) && form is null)
        {
            <button type="button" class="btn btn-primary" @onclick="New"><AppIcon Name="plus" Size="16" /> @Texts.Get("crm.priceLists.newButton")</button>
        }
    </div>

    <PersonalViewBar Active="Active" Dirty="grid.Differs(Active)" Naming="views.Naming" NamingChanged="views.StartNaming" Error="@views.Error"
                     SaveAs="SaveAsAsync" UpdateView="UpdateViewAsync" DiscardChanges="DiscardAsync" DeleteView="DeleteViewAsync" />

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }

    @if (form is not null)
    {
        <form class="record-form" novalidate @onsubmit="SaveAsync" @onsubmit:preventDefault>
            <h2>@(form.Id is null ? Texts.Get("crm.priceLists.new") : Texts.Get("crm.priceLists.edit"))</h2>
            <TabBar Tabs="FormTabs" State="tabs" Label="@Texts.Get("crm.priceLists.formSections")" />
            <TabPanel State="tabs" Key="form-genel">
            <div class="form-grid">
                <div>
                    <label class="form-label" for="name">@Texts.Get("common.field.nameRequired")</label>
                    <input id="name" class="form-control" maxlength="150" @bind="form.Name" />
                    <FieldError Field="name" Errors="errors" />
                </div>
                <div>
                    <label class="form-label" for="currency">@Texts.Get("common.field.currencyRequired")</label>
                    <input id="currency" class="form-control" maxlength="3" @bind="form.Currency" />
                    <FieldError Field="currency" Errors="errors" />
                </div>
                <div>
                    <label class="form-label" for="scope">@Texts.Get("crm.priceLists.field.scope")</label>
                    <select id="scope" class="form-select" @bind="form.Scope">
                        @foreach (var scope in PricingLabels.Scopes)
                        {
                            <option value="@scope.Key">@scope.Label</option>
                        }
                    </select>
                    <FieldError Field="scope" Errors="errors" />
                </div>
                @if (form.Scope == "Customer")
                {
                    <div>
                        <label class="form-label" for="company">@Texts.Get("crm.priceLists.field.company")</label>
                        <select id="company" class="form-select" @bind="form.CompanyId">
                            <option value="">—</option>
                            @foreach (var company in companies)
                            {
                                <option value="@company.Id">@company.Name</option>
                            }
                        </select>
                        <FieldError Field="companyId" Errors="errors" />
                    </div>
                }
                @if (form.Scope == "Segment")
                {
                    <div>
                        <label class="form-label" for="segment">@Texts.Get("crm.priceLists.field.segment")</label>
                        <input id="segment" class="form-control" maxlength="100" @bind="form.Segment" />
                        <FieldError Field="segment" Errors="errors" />
                    </div>
                }
            </div>
            </TabPanel>
            <TabPanel State="tabs" Key="form-gecerlilik">
            <div class="form-grid">
                <div>
                    <label class="form-label" for="method">@Texts.Get("crm.priceLists.field.tierMethod")</label>
                    <select id="method" class="form-select" @bind="form.TierMethod">
                        @foreach (var method in PricingLabels.TierMethods)
                        {
                            <option value="@method.Key">@method.Label</option>
                        }
                    </select>
                    <FieldError Field="tierMethod" Errors="errors" />
                </div>
                <div>
                    <label class="form-label" for="from">@Texts.Get("crm.priceLists.field.validFrom")</label>
                    <input id="from" class="form-control" type="datetime-local" @bind="form.ValidFrom" />
                    <FieldError Field="validFrom" Errors="errors" />
                </div>
                <div>
                    <label class="form-label" for="to">@Texts.Get("crm.priceLists.field.validTo")</label>
                    <input id="to" class="form-control" type="datetime-local" @bind="form.ValidTo" />
                    <FieldError Field="validTo" Errors="errors" />
                </div>
            </div>
            </TabPanel>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary" disabled="@busy">@Texts.Get("common.save")</button>
                <button type="button" class="btn btn-outline-secondary" @onclick="() => form = null">@Texts.Get("common.dismiss")</button>
                @if (form.Id is not null)
                {
                    <button type="button" class="btn btn-outline-danger ms-auto" disabled="@busy" @onclick="DeleteAsync">@Texts.Get("common.delete")</button>
                }
            </div>
        </form>
    }

    @if (opened is not null)
    {
        <section class="record-form">
            <h2>@Texts.Get("crm.priceLists.itemsTitle", opened.Name) <span class="badge status-@PricingLabels.ListBadge(opened.Status)">@PricingLabels.Label(PricingLabels.ListStatuses, opened.Status)</span></h2>
            @if (items is null)
            {
                <LoadingState Kind="LoadingKind.Table" />
            }
            else if (items.Count == 0)
            {
                <EmptyState Title="@Texts.Get("crm.priceLists.noItems")" />
            }
            else
            {
                <table class="table record-table">
                    <thead><tr><th>@Texts.Get("crm.priceLists.col.product")</th><th>@Texts.Get("crm.priceLists.col.min")</th><th>@Texts.Get("crm.priceLists.col.max")</th><th>@Texts.Get("crm.priceLists.col.unitPrice")</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var item in items)
                        {
                            <tr>
                                <td data-label="@Texts.Get("crm.priceLists.col.product")" class="primary">@item.ProductCode — @item.ProductName</td>
                                <td data-label="@Texts.Get("crm.priceLists.col.min")">@item.MinQuantity.ToString("0.######")</td>
                                <td data-label="@Texts.Get("crm.priceLists.col.maxShort")">@(item.MaxQuantity?.ToString("0.######") ?? Texts.Get("crm.priceLists.unlimited"))</td>
                                <td data-label="@Texts.Get("crm.priceLists.col.unitPrice")">@(item.IsFree ? Texts.Get("crm.priceLists.free") : $"{item.UnitPrice.ToString("0.00####")} {opened.Currency}")</td>
                                <td class="actions">
                                    @if (opened.Status == "Draft" && Session.Can(CrmAccess.PricesWrite))
                                    {
                                        <ConfirmAction OnConfirm="() => DeleteItemAsync(item)">@Texts.Get("common.delete")</ConfirmAction>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            @if (itemMessage is not null)
            {
                <div class="alert alert-danger" role="alert">@itemMessage</div>
            }

            @if (opened.Status == "Draft" && Session.Can(CrmAccess.PricesWrite))
            {
                <form class="form-grid" novalidate @onsubmit="AddItemAsync" @onsubmit:preventDefault>
                    <div>
                        <label class="form-label" for="itemProduct">@Texts.Get("crm.priceLists.item.product")</label>
                        <select id="itemProduct" class="form-select" @bind="itemForm.ProductId">
                            <option value="@Guid.Empty">—</option>
                            @foreach (var product in products)
                            {
                                <option value="@product.Id">@product.Code — @product.Name</option>
                            }
                        </select>
                        <FieldError Field="productId" Errors="itemErrors" />
                    </div>
                    <div>
                        <label class="form-label" for="itemMin">@Texts.Get("crm.priceLists.item.min")</label>
                        <input id="itemMin" class="form-control" type="number" step="any" min="0" @bind="itemForm.Min" />
                        <FieldError Field="minQuantity" Errors="itemErrors" />
                    </div>
                    <div>
                        <label class="form-label" for="itemMax">@Texts.Get("crm.priceLists.col.max")</label>
                        <input id="itemMax" class="form-control" type="number" step="any" min="0" @bind="itemForm.Max" />
                        <FieldError Field="maxQuantity" Errors="itemErrors" />
                    </div>
                    <div>
                        <label class="form-label" for="itemPrice">@Texts.Get("crm.priceLists.item.unitPrice")</label>
                        <input id="itemPrice" class="form-control" type="number" step="any" min="0" disabled="@itemForm.IsFree" @bind="itemForm.Price" />
                        <FieldError Field="unitPrice" Errors="itemErrors" />
                    </div>
                    <div>
                        <label class="form-label" for="itemFree">@Texts.Get("crm.priceLists.item.free")</label>
                        <select id="itemFree" class="form-select" @bind="itemForm.IsFree">
                            <option value="False">@Texts.Get("common.no")</option>
                            <option value="True">@Texts.Get("common.yes")</option>
                        </select>
                    </div>
                    <div class="form-actions">
                        <button type="submit" class="btn btn-outline-primary" disabled="@busy">@Texts.Get("crm.priceLists.addItem")</button>
                    </div>
                </form>
            }

            <div class="form-actions">
                @if (opened.Status == "Draft" && Session.Can(CrmAccess.PricesWrite))
                {
                    <button type="button" class="btn btn-primary" disabled="@busy" @onclick='() => ChangeStatusAsync(opened, "Published")'>@Texts.Get("crm.priceLists.publish")</button>
                }
                @if (opened.Status != "Archived" && Session.Can(CrmAccess.PricesWrite))
                {
                    <button type="button" class="btn btn-outline-secondary" disabled="@busy" @onclick='() => ChangeStatusAsync(opened, "Archived")'>@Texts.Get("crm.priceLists.archive")</button>
                }
                <button type="button" class="btn btn-outline-secondary" @onclick="CloseItems">@Texts.Get("common.close")</button>
            </div>
        </section>
    }

    @if (page is null)
    {
        <LoadingState Kind="LoadingKind.Table" />
    }
    else if (page.Items.Count == 0)
    {
        <EmptyState Title="@Texts.Get("crm.priceLists.none")" />
    }
    else
    {
        <table class="table record-table">
            <thead>
                <tr>
                    @foreach (var column in grid.VisibleColumns)
                    {
                        <GridHeader Column="column" State="grid" SortChanged="SortAsync" />
                    }
                    <th scope="col" class="row-menu-cell"><span class="visually-hidden">@Texts.Get("common.actions")</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var list in page.Items)
                {
                    <tr>
                        @foreach (var column in grid.VisibleColumns)
                        {
                            @Cell(column, list)
                        }
                        <td class="row-menu-cell">
                            <RowMenu Label="@Texts.Get("common.rowActionsOf", list.Name)">
                                <button type="button" class="view-menu-item" role="menuitem" @onclick="() => OpenItemsAsync(list)"><AppIcon Name="list" Size="16" /> <span>@Texts.Get("crm.priceLists.items")</span></button>
                                @if (list.Status == "Draft" && Session.Can(CrmAccess.PricesWrite))
                                {
                                    <button type="button" class="view-menu-item" role="menuitem" @onclick="() => Edit(list)"><AppIcon Name="pencil" Size="16" /> <span>@Texts.Get("common.edit")</span></button>
                                }
                            </RowMenu>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager PageSizeChoice="true" Page="page.Page" PageSize="page.PageSize" TotalCount="page.TotalCount" PageChanged="LoadAsync" />
    }
</AuthGate>

@code {
    private const string Url = "/api/crm/price-lists";
    private const string ItemsUrl = "/api/crm/price-list-items";

    // Varsayılan sıra durum + ad ("status"); Kapsam sütunu (ad + segment + firma birleşimi) kapsam türüne göre sıralanır.
    // Özellik olarak tanımlıdır: başlıklar sınıf yüklenirken değil, sayfa açılırken sözlükten çözülür (ADR-0034).
    private static GridColumnDef[] Columns =>
    [
        new("name", Texts.Get("common.field.name"), "type", "name", "-name", Locked: true),
        new("status", Texts.Get("common.field.status"), "tag", "status", "-status"),
        new("scope", Texts.Get("crm.priceLists.field.scope"), "globe", "scope", "-scope"),
        new("currency", Texts.Get("crm.priceLists.col.currency"), "coins", "currency", "-currency"),
        new("period", Texts.Get("crm.priceLists.col.period"), "calendar", "validFrom", "-validFrom"),
        new("validTo", Texts.Get("crm.priceLists.col.validTo"), "calendar", "validTo", "-validTo", DefaultVisible: false),
    ];

    private readonly GridViewState grid = new("crm.price-lists", "status");
    private PersonalGridViews views = default!;
    private string view = AllView;
    private string? search;
    private CrmPage<PriceListDto>? page;
    private List<CompanyDto> companies = [];
    private List<ProductDto> products = [];
    private PriceListDto? opened;
    private List<PriceListItemDto>? items;
    private ListForm? form;

    // Her kayıt formu sekmelidir; hatalı alan içeren sekme "!" rozeti taşır, kayıt denemesinden sonra hatalı ilk sekme açılır.
    private readonly TabState tabs = new("form-genel");

    private int ErrorCount(params string[] fields) => errors is null ? 0 : fields.Count(errors.ContainsKey);

    private IReadOnlyList<TabItem> FormTabs =>
    [
        new("form-genel", Texts.Get("crm.priceLists.tab.general"), Errors: ErrorCount("name", "currency", "scope", "companyId", "segment")),
        new("form-gecerlilik", Texts.Get("crm.priceLists.tab.validity"), Errors: ErrorCount("tierMethod", "validFrom", "validTo")),
    ];
    private ItemForm itemForm = new();
    private IReadOnlyDictionary<string, string[]>? errors;
    private IReadOnlyDictionary<string, string[]>? itemErrors;
    private string? message;
    private string? itemMessage;
    private string? status;
    private bool busy;

    protected override async Task OnInitializedAsync()
    {
        views = new PersonalGridViews(Api, "crm.price-lists");
        grid.Define(Columns);
        await Session.EnsureLoadedAsync();
        if (Session.Can(CrmAccess.PricesRead))
        {
            await views.LoadAsync();
            await LoadAsync(1);
        }
    }

    private const string AllView = "all";
    private const string StatusPrefix = "status:";

    // Görünümler yalnızca süzgeçtir (tümü, durum, kişisel); kapsamı sunucu uygular.
    private IReadOnlyList<ViewOption> ViewOptions =>
    [
        new(AllView, Texts.Get("crm.priceLists.view.all"), Icon: "coins"),
        .. PricingLabels.ListStatuses.Select(s => new ViewOption(StatusPrefix + s.Key, s.Label, Icon: "tag")),
        .. views.Options,
    ];

    private GridViewDto? Active => views.Find(view);

    private async Task ChooseViewAsync(string key)
    {
        view = key;
        views.StartNaming(false);
        if (Active is { } saved)
        {
            grid.Apply(saved);
            status = GridFilters.Parse(saved.Filters).GetValueOrDefault("status");
        }
        else
        {
            grid.Reset();
            status = key.StartsWith(StatusPrefix, StringComparison.Ordinal) ? key[StatusPrefix.Length..] : null;
        }

        await LoadAsync(1);
    }

    private async Task SortAsync(string key)
    {
        grid.Sort = key;
        await LoadAsync(1);
    }

    // Sütun seçimi/sırası değişince veri yeniden çekilmez; geri çağrı yalnızca sayfanın yeniden çizilmesini sağlar.
    private Task ColumnsChanged() => Task.CompletedTask;

    private string? CurrentFilters => GridFilters.Build(status is { } s ? ("status", s) : null);

    private void StartNaming() => views.StartNaming(true);

    private async Task SaveAsAsync(string name)
    {
        if (await views.SaveAsAsync(grid.ToRequest(name, CurrentFilters)) is { } key)
        {
            view = key;
        }
    }

    private async Task UpdateViewAsync()
    {
        if (Active is { } current)
        {
            await views.UpdateAsync(current, grid.ToRequest(current.Name, CurrentFilters));
        }
    }

    private async Task DiscardAsync() => await ChooseViewAsync(view);

    private async Task DeleteViewAsync()
    {
        if (Active is { } current && await views.DeleteAsync(current))
        {
            await ChooseViewAsync(AllView);
        }
    }

    private RenderFragment Cell(GridColumnDef column, PriceListDto list) => @<td data-label="@column.Label" class="@(column.Key == "name" ? "primary" : null)">@CellContent(column.Key, list)</td>;

    private RenderFragment CellContent(string key, PriceListDto list) => key switch
    {
        "name" => @<text>@list.Name</text>,
        "status" => @<span class="badge status-@PricingLabels.ListBadge(list.Status)">@PricingLabels.Label(PricingLabels.ListStatuses, list.Status)</span>,
        "scope" => @<text>@PricingLabels.Label(PricingLabels.Scopes, list.Scope)@(list.Segment is null ? null : $" · {list.Segment}")@(CompanyName(list.CompanyId))</text>,
        "currency" => @<text>@list.Currency</text>,
        "period" => @<text>@Period(list)</text>,
        "validTo" => @<text>@(list.ValidTo is { } to ? to.ToLocalTime().ToString("yyyy-MM-dd HH:mm") : "—")</text>,
        _ => @<text></text>,
    };

    private async Task LoadAsync(int pageNumber)
    {
        var url = $"{Url}?page={pageNumber}&pageSize={ListPaging.Size}";
        if (!string.IsNullOrWhiteSpace(search))
        {
            url += $"&search={Uri.EscapeDataString(search.Trim())}";
        }

        if (grid.Sort != grid.DefaultSort)
        {
            url += $"&sort={Uri.EscapeDataString(grid.Sort)}";
        }

        if (status is not null)
        {
            url += $"&status={Uri.EscapeDataString(status)}";
        }

        var result = await Api.GetAsync<CrmPage<PriceListDto>>(url);
        page = result.Value;
        message = result.Error;
    }

    private async Task EnsureLookupsAsync()
    {
        if (products.Count == 0 && Session.Can(CrmAccess.ProductsRead))
        {
            products = (await Api.GetAllAsync<ProductDto>("/api/crm/products")).Items;
        }

        if (companies.Count == 0 && Session.Can(CrmAccess.CompaniesRead))
        {
            companies = (await Api.GetAllAsync<CompanyDto>("/api/crm/companies")).Items;
        }
    }

    private string CompanyName(Guid? id) => id is { } value && companies.FirstOrDefault(c => c.Id == value) is { } company ? $" · {company.Name}" : string.Empty;

    private static string Period(PriceListDto list) => list.ValidFrom is null && list.ValidTo is null
        ? Texts.Get("crm.priceLists.noPeriod")
        : $"{list.ValidFrom?.ToLocalTime():yyyy-MM-dd HH:mm} → {(list.ValidTo is { } to ? to.ToLocalTime().ToString("yyyy-MM-dd HH:mm") : "…")}";

    private async Task New()
    {
        await EnsureLookupsAsync();
        form = new ListForm();
        tabs.Select("form-genel");
        errors = null;
        message = null;
    }

    private async Task Edit(PriceListDto list)
    {
        await EnsureLookupsAsync();
        form = new ListForm
        {
            Id = list.Id, Version = list.Version, Name = list.Name, Currency = list.Currency, Scope = list.Scope, CompanyId = list.CompanyId,
            Segment = list.Segment, TierMethod = list.TierMethod, Status = list.Status,
            ValidFrom = list.ValidFrom?.LocalDateTime, ValidTo = list.ValidTo?.LocalDateTime,
        };
        tabs.Select("form-genel");
        errors = null;
        message = null;
    }

    private async Task SaveAsync()
    {
        busy = true;
        var f = form!;
        var request = new SavePriceListRequest(
            f.Name, f.Currency, f.Scope, f.Scope == "Customer" ? f.CompanyId : null, f.Scope == "Segment" ? f.Segment : null,
            f.ValidFrom is { } from ? new DateTimeOffset(from) : null, f.ValidTo is { } to ? new DateTimeOffset(to) : null, f.Status, f.TierMethod, f.Version);
        var result = f.Id is { } id
            ? await Api.PutAsync<PriceListDto>($"{Url}/{id}", request)
            : await Api.PostAsync<PriceListDto>(Url, request);
        busy = false;

        if (result.IsSuccess)
        {
            form = null;
            errors = null;
            message = null;
            await LoadAsync(page?.Page ?? 1);
            return;
        }

        errors = result.FieldErrors;
        message = result.Error;
        tabs.RevealFirstFailing(FormTabs);
    }

    private async Task DeleteAsync()
    {
        busy = true;
        var result = await Api.DeleteAsync($"{Url}/{form!.Id}?version={form.Version}");
        busy = false;

        if (result.IsSuccess)
        {
            form = null;
            await LoadAsync(page?.Page ?? 1);
            return;
        }

        message = result.Error;
    }

    private async Task OpenItemsAsync(PriceListDto list)
    {
        await EnsureLookupsAsync();
        opened = list;
        itemForm = new ItemForm();
        itemErrors = null;
        itemMessage = null;
        await ReloadItemsAsync();
    }

    private void CloseItems()
    {
        opened = null;
        items = null;
    }

    private async Task ReloadItemsAsync()
    {
        var (loaded, error) = await Api.GetAllAsync<PriceListItemDto>($"{ItemsUrl}?priceListId={opened!.Id}");
        items = loaded;
        itemMessage = error;
    }

    private async Task AddItemAsync()
    {
        busy = true;
        var f = itemForm;
        var result = await Api.PostAsync<PriceListItemDto>(ItemsUrl,
            new SavePriceListItemRequest(opened!.Id, f.ProductId, f.Min, f.IsFree ? 0m : f.Price, f.Max, f.IsFree));
        busy = false;

        if (result.IsSuccess)
        {
            itemForm = new ItemForm { ProductId = f.ProductId };
            itemErrors = null;
            itemMessage = null;
            await ReloadItemsAsync();
            return;
        }

        itemErrors = result.FieldErrors;
        itemMessage = result.Error;
    }

    private async Task DeleteItemAsync(PriceListItemDto item)
    {
        var result = await Api.DeleteAsync($"{ItemsUrl}/{item.Id}?version={item.Version}");
        if (result.IsSuccess)
        {
            await ReloadItemsAsync();
            return;
        }

        itemMessage = result.Error;
    }

    private async Task ChangeStatusAsync(PriceListDto list, string newStatus)
    {
        busy = true;
        var request = new SavePriceListRequest(
            list.Name, list.Currency, list.Scope, list.CompanyId, list.Segment, list.ValidFrom, list.ValidTo, newStatus, list.TierMethod, list.Version);
        var result = await Api.PutAsync<PriceListDto>($"{Url}/{list.Id}", request);
        busy = false;

        if (result.IsSuccess)
        {
            opened = result.Value;
            itemMessage = null;
            await LoadAsync(page?.Page ?? 1);
            return;
        }

        itemMessage = result.Error ?? string.Join(" ", result.FieldErrors?.SelectMany(e => e.Value) ?? []);
    }

    private sealed class ListForm
    {
        public Guid? Id { get; init; }

        public long? Version { get; init; }

        public string Name { get; set; } = string.Empty;

        public string Currency { get; set; } = "TRY";

        public string Scope { get; set; } = "Default";

        public Guid? CompanyId { get; set; }

        public string? Segment { get; set; }

        public string TierMethod { get; set; } = "Volume";

        public string Status { get; set; } = "Draft";

        public DateTime? ValidFrom { get; set; }

        public DateTime? ValidTo { get; set; }
    }

    private sealed class ItemForm
    {
        public Guid ProductId { get; set; }

        public decimal Min { get; set; } = 1m;

        public decimal? Max { get; set; }

        public decimal Price { get; set; }

        public bool IsFree { get; set; }
    }
}
