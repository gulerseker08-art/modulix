@page "/crm/kisiler/{TargetId:guid}/birlestir"
@inject SessionState Session

<PageTitle>@Texts.Get("crm.contact.mergeTitle") · Modulix</PageTitle>

<AuthGate Module="@CrmAccess.ModuleKey" Permission="@CrmAccess.ContactsMerge">
    <MergeWizard Resource="contacts" TargetId="TargetId" SourceId="SourceId" />
</AuthGate>

@code {
    [Parameter] public Guid TargetId { get; set; }

    [SupplyParameterFromQuery(Name = "kaynak")] public Guid? SourceId { get; set; }
}
