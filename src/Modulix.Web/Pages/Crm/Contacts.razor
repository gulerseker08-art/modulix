@page "/crm/kisiler"
@inject ApiClient Api
@inject SessionState Session
@inject CrmLookups Lookups

<PageTitle>Kişiler · Modulix</PageTitle>

<AuthGate Module="@CrmAccess.ModuleKey" Permission="@CrmAccess.ContactsRead">
    <PageHeader Title="Kişiler" Icon="user" Subtitle="Firmalardaki ilgili kişileri ve iletişim bilgilerini yönetin.">
        @if (Session.Can(CrmAccess.ContactsWrite) && !editing)
        {
            <button type="button" class="btn btn-primary" @onclick="() => Open(null)"><span aria-hidden="true">+</span> Yeni kişi</button>
        }
    </PageHeader>

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }

    @if (editing)
    {
        <ContactEditor Contact="selected" Lookups="Lookups" Saved="SavedAsync" Deleted="SavedAsync" Cancelled="Close" />
    }

    @* Filtreler sunucuda uygulanır; sayfalama ve toplam doğru kalır. *@
    <div class="filters" role="group" aria-label="Filtre">
        <button type="button" class="chip @(role is null && !withoutCompany && !mine ? "active" : null)" @onclick="() => FilterAsync(null, false, false)">Tümü</button>
        <button type="button" class="chip @(mine ? "active" : null)" @onclick="() => FilterAsync(null, false, true)">Benim kişilerim</button>
        <button type="button" class="chip @(withoutCompany ? "active" : null)" @onclick="() => FilterAsync(null, true, false)">Firmasız</button>
        @foreach (var (key, label) in CrmRelationshipRoles.Labels)
        {
            <button type="button" class="chip @(role == key ? "active" : null)" @onclick="() => FilterAsync(key, false, false)">@label</button>
        }
    </div>

    <form class="search" @onsubmit="() => LoadAsync(1)" @onsubmit:preventDefault>
        <input class="form-control" type="search" placeholder="Ad, soyad, e-posta veya telefon ara" @bind="search" />
        <button type="submit" class="btn btn-outline-secondary">Ara</button>
    </form>

    @if (page is null)
    {
        <p class="text-muted">Yükleniyor…</p>
    }
    else if (page.Items.Count == 0)
    {
        <p class="text-muted">Kayıt yok.</p>
    }
    else
    {
        <table class="table record-table">
            <thead>
                <tr><th>Ad soyad</th><th>Firma</th><th>Unvan</th><th>Telefon</th><th>E-posta</th>@foreach (var field in Lookups.ListFieldsOf(CrmEntityKeys.Contact)) { <th>@field.Label</th> }<th></th></tr>
            </thead>
            <tbody>
                @foreach (var contact in page.Items)
                {
                    <tr>
                        <td data-label="Ad soyad" class="primary"><a href="crm/kisiler/@contact.Id">@contact.FirstName @contact.LastName</a></td>
                        <td data-label="Firma">
                            @if (contact.CompanyId is { } companyId)
                            {
                                <a href="crm/firmalar/@companyId">@Lookups.CompanyName(companyId)</a>
                            }
                        </td>
                        <td data-label="Unvan">@contact.Title</td>
                        <td data-label="Telefon">@contact.Phone</td>
                        <td data-label="E-posta">@contact.Email</td>
                        @foreach (var field in Lookups.ListFieldsOf(CrmEntityKeys.Contact))
                        {
                            <td data-label="@field.Label">@CustomFieldText.Format(field, contact.Custom)</td>
                        }
                        <td class="actions">
                            @if (Session.Can(CrmAccess.ContactsWrite))
                            {
                                <button type="button" class="btn btn-outline-primary btn-sm" @onclick="() => Open(contact)">Düzenle</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager Page="page.Page" PageSize="page.PageSize" TotalCount="page.TotalCount" PageChanged="LoadAsync" />
    }
</AuthGate>

@code {
    private const string Url = "/api/crm/contacts";

    private CrmPage<ContactDto>? page;
    private ContactDto? selected;
    private bool editing;
    private string? message;
    private string? search;
    private string? role;
    private bool withoutCompany;
    private bool mine;

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (Session.Can(CrmAccess.ContactsRead))
        {
            await Lookups.LoadAsync();
            await LoadAsync(1);
        }
    }

    private async Task FilterAsync(string? roleKey, bool noCompany, bool onlyMine)
    {
        role = roleKey;
        withoutCompany = noCompany;
        mine = onlyMine;
        await LoadAsync(1);
    }

    private async Task LoadAsync(int pageNumber)
    {
        var url = $"{Url}?page={pageNumber}&search={Uri.EscapeDataString(search ?? string.Empty)}";
        if (role is { } r)
        {
            url += $"&role={Uri.EscapeDataString(r)}";
        }

        if (withoutCompany)
        {
            url += "&withoutCompany=true";
        }

        if (mine)
        {
            url += "&ownerId=me";
        }

        var result = await Api.GetAsync<CrmPage<ContactDto>>(url);
        page = result.Value;
        message = result.Error;
    }

    private void Open(ContactDto? contact)
    {
        selected = contact;
        editing = true;
        message = null;
    }

    private void Close() => editing = false;

    private async Task SavedAsync()
    {
        editing = false;
        await LoadAsync(page?.Page ?? 1);
    }
}
