@page "/crm/kisiler"
@inject ApiClient Api
@inject SessionState Session
@inject CrmLookups Lookups

<PageTitle>Kişiler · Modulix</PageTitle>

<AuthGate Module="@CrmAccess.ModuleKey" Permission="@CrmAccess.ContactsRead">
    <PageHeader Title="Kişiler" Icon="user" Subtitle="@(page is null ? "Firmalardaki ilgili kişileri ve iletişim bilgilerini yönetin." : $"{page.TotalCount} kayıt")" />

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }

    @if (editing)
    {
        <ContactEditor Contact="selected" Lookups="Lookups" Saved="SavedAsync" Deleted="SavedAsync" Cancelled="Close" />
    }

    @* Görünümler sunucuda süzgeç olarak uygulanır; sayfalama ve toplam doğru kalır. *@
    <div class="list-toolbar">
        <ViewSelector Items="ViewOptions" Value="@CurrentView" ValueChanged="ChooseViewAsync" />
        <form class="search" @onsubmit="() => LoadAsync(1)" @onsubmit:preventDefault>
            <input class="form-control" type="search" aria-label="Kişi ara" placeholder="Ad, soyad, e-posta veya telefon ara" @bind="search" />
            <button type="submit" class="btn btn-outline-secondary">Ara</button>
        </form>
        <ColumnPicker />
        @if (Session.Can(CrmAccess.ContactsWrite) && !editing)
        {
            <button type="button" class="btn btn-primary" @onclick="() => Open(null)"><AppIcon Name="plus" Size="16" /> Yeni kişi</button>
        }
    </div>

    @if (page is null)
    {
        <p class="text-muted">Yükleniyor…</p>
    }
    else if (page.Items.Count == 0)
    {
        <p class="text-muted">Kayıt yok.</p>
    }
    else
    {
        <table class="table record-table">
            <thead>
                <tr><th>Ad soyad</th><th>Firma</th><th>Unvan</th><th>Telefon</th><th>E-posta</th>@foreach (var field in Lookups.ListFieldsOf(CrmEntityKeys.Contact)) { <th>@field.Label</th> }<th></th></tr>
            </thead>
            <tbody>
                @foreach (var contact in page.Items)
                {
                    <tr>
                        <td data-label="Ad soyad" class="primary"><a href="crm/kisiler/@contact.Id">@contact.FirstName @contact.LastName</a></td>
                        <td data-label="Firma">
                            @if (contact.CompanyId is { } companyId)
                            {
                                <a href="crm/firmalar/@companyId">@Lookups.CompanyName(companyId)</a>
                            }
                        </td>
                        <td data-label="Unvan">@contact.Title</td>
                        <td data-label="Telefon">@contact.Phone</td>
                        <td data-label="E-posta">@contact.Email</td>
                        @foreach (var field in Lookups.ListFieldsOf(CrmEntityKeys.Contact))
                        {
                            <td data-label="@field.Label">@CustomFieldText.Format(field, contact.Custom)</td>
                        }
                        <td class="actions">
                            @if (Session.Can(CrmAccess.ContactsWrite))
                            {
                                <button type="button" class="btn btn-outline-primary btn-sm" @onclick="() => Open(contact)">Düzenle</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager Page="page.Page" PageSize="page.PageSize" TotalCount="page.TotalCount" PageChanged="LoadAsync" />
    }
</AuthGate>

@code {
    private const string Url = "/api/crm/contacts";

    private CrmPage<ContactDto>? page;
    private ContactDto? selected;
    private bool editing;
    private string? message;
    private string? search;
    private string? role;
    private bool withoutCompany;
    private bool mine;

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (Session.Can(CrmAccess.ContactsRead))
        {
            await Lookups.LoadAsync();
            await LoadAsync(1);
        }
    }

    private const string AllViews = "all";
    private const string MineView = "mine";
    private const string WithoutCompanyView = "no-company";
    private const string RolePrefix = "role:";

    // Görünümler yalnızca süzgeçtir (Tümü, Benim kişilerim, Firmasız, ilişki rolü); kapsamı sunucu uygular.
    private IReadOnlyList<ViewOption> ViewOptions =>
    [
        new(AllViews, "Tüm kişiler"),
        new(MineView, "Benim kişilerim"),
        new(WithoutCompanyView, "Firmasız"),
        .. CrmRelationshipRoles.Labels.Select(r => new ViewOption(RolePrefix + r.Key, r.Value, "İlişki rolüne göre")),
    ];

    private string CurrentView => mine ? MineView : withoutCompany ? WithoutCompanyView : role is { } r ? RolePrefix + r : AllViews;

    private async Task ChooseViewAsync(string key)
    {
        mine = key == MineView;
        withoutCompany = key == WithoutCompanyView;
        role = key.StartsWith(RolePrefix, StringComparison.Ordinal) ? key[RolePrefix.Length..] : null;
        await LoadAsync(1);
    }

    private async Task LoadAsync(int pageNumber)
    {
        var url = $"{Url}?page={pageNumber}&search={Uri.EscapeDataString(search ?? string.Empty)}";
        if (role is { } r)
        {
            url += $"&role={Uri.EscapeDataString(r)}";
        }

        if (withoutCompany)
        {
            url += "&withoutCompany=true";
        }

        if (mine)
        {
            url += "&ownerId=me";
        }

        var result = await Api.GetAsync<CrmPage<ContactDto>>(url);
        page = result.Value;
        message = result.Error;
    }

    private void Open(ContactDto? contact)
    {
        selected = contact;
        editing = true;
        message = null;
    }

    private void Close() => editing = false;

    private async Task SavedAsync()
    {
        editing = false;
        await LoadAsync(page?.Page ?? 1);
    }
}
