@page "/crm/kisiler"
@inject ApiClient Api
@inject SessionState Session
@inject CrmLookups Lookups

<PageTitle>@Texts.Get("crm.contacts.title") · Modulix</PageTitle>

<AuthGate Module="@CrmAccess.ModuleKey" Permission="@CrmAccess.ContactsRead">
    <PageHeader Title="@Texts.Get("crm.contacts.title")" Icon="user" Subtitle="@(page is null ? Texts.Get("crm.contacts.subtitle") : Texts.Get("common.records", page.TotalCount))" />

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }

    @if (editing)
    {
        <ContactEditor Contact="selected" Lookups="Lookups" Saved="SavedAsync" Deleted="SavedAsync" Cancelled="Close" />
    }

    @* Görünümler sunucuda süzgeç olarak uygulanır; sayfalama ve toplam doğru kalır. *@
    <ViewTabs Items="ViewOptions" Value="@view" ValueChanged="ChooseViewAsync" Label="@Texts.Get("crm.contacts.views")" NewView="StartNaming" />

    <div class="list-toolbar">
        <form class="search" @onsubmit="() => LoadAsync(1)" @onsubmit:preventDefault>
            <input class="form-control" type="search" aria-label="@Texts.Get("crm.contacts.search.aria")" placeholder="@Texts.Get("crm.contacts.search.placeholder")" @bind="search" />
        </form>
        <GridColumnPicker State="grid" Changed="@(() => Task.CompletedTask)" />
        @if (Session.Can(CrmAccess.ContactsWrite) && !editing)
        {
            <button type="button" class="btn btn-primary" @onclick="() => Open(null)"><AppIcon Name="plus" Size="16" /> @Texts.Get("crm.contacts.new")</button>
        }
    </div>

    <PersonalViewBar Active="Active" Dirty="grid.Differs(Active)" Naming="views.Naming" NamingChanged="views.StartNaming" Error="@views.Error"
                     SaveAs="SaveAsAsync" UpdateView="UpdateViewAsync" DiscardChanges="DiscardAsync" DeleteView="DeleteViewAsync" />

    @if (page is null)
    {
        <p class="text-muted">@Texts.Get("common.loading")</p>
    }
    else if (page.Items.Count == 0)
    {
        <p class="text-muted">@Texts.Get("common.noRecords")</p>
    }
    else
    {
        <table class="table record-table">
            <thead>
                <tr>
                    @foreach (var column in grid.VisibleColumns)
                    {
                        <GridHeader Column="column" State="grid" SortChanged="SortAsync" />
                    }
                    <th scope="col" class="row-menu-cell"><span class="visually-hidden">@Texts.Get("common.actions")</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var contact in page.Items)
                {
                    <tr>
                        @foreach (var column in grid.VisibleColumns)
                        {
                            @Cell(column, contact)
                        }
                        <td class="row-menu-cell">
                            <RowMenu Label="@Texts.Get("common.rowActionsOf", $"{contact.FirstName} {contact.LastName}")">
                                <a class="view-menu-item" role="menuitem" href="crm/kisiler/@contact.Id"><AppIcon Name="eye" Size="16" /> <span>@Texts.Get("common.open")</span></a>
                                @if (Session.Can(CrmAccess.ContactsWrite))
                                {
                                    <button type="button" class="view-menu-item" role="menuitem" @onclick="() => Open(contact)"><AppIcon Name="pencil" Size="16" /> <span>@Texts.Get("common.edit")</span></button>
                                }
                            </RowMenu>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager PageSizeChoice="true" Page="page.Page" PageSize="page.PageSize" TotalCount="page.TotalCount" PageChanged="LoadAsync" />
    }
</AuthGate>

@code {
    private const string Url = "/api/crm/contacts";
    private const string AllViews = "all";
    private const string MineView = "mine";
    private const string WithoutCompanyView = "no-company";
    private const string RolePrefix = "role:";

    // Firma sütunu sunucuda sıralanamaz (firma adı ilişki üzerindedir); sorumlu adı üyelik tablosundadır.
    private static GridColumnDef[] BaseColumns =>
    [
        new("name", Texts.Get("crm.contacts.col.fullName"), "type", "name", "-name", Locked: true),
        new("company", Texts.Get("crm.contacts.col.company"), "building"),
        new("title", Texts.Get("crm.contacts.col.title"), "briefcase", "title", "-title"),
        new("phone", Texts.Get("common.field.phone"), "phone", "phone", "-phone"),
        new("email", Texts.Get("common.field.email"), "mail", "email", "-email"),
        new("owner", Texts.Get("common.field.owner"), "user", DefaultVisible: false),
    ];

    private readonly GridViewState grid = new("crm.contacts", "name");
    private PersonalGridViews views = default!;
    private CrmPage<ContactDto>? page;
    private ContactDto? selected;
    private bool editing;
    private string? message;
    private string? search;
    private string? role;
    private bool withoutCompany;
    private bool mine;
    private string view = AllViews;

    protected override async Task OnInitializedAsync()
    {
        views = new PersonalGridViews(Api, "crm.contacts");
        await Session.EnsureLoadedAsync();
        if (Session.Can(CrmAccess.ContactsRead))
        {
            await Lookups.LoadAsync();
            grid.Define([.. BaseColumns, .. Lookups.FieldsOf(CrmEntityKeys.Contact).Select(f => new GridColumnDef("custom." + f.Key, f.Label, "type", DefaultVisible: f.ShowInList))]);
            await views.LoadAsync();
            await LoadAsync(1);
        }
    }

    private GridViewDto? Active => views.Find(view);

    // Görünümler yalnızca süzgeçtir (Benim kişilerim, Tümü, Firmasız, ilişki rolü, kişisel); kapsamı sunucu uygular.
    private IReadOnlyList<ViewOption> ViewOptions =>
    [
        new(MineView, Texts.Get("crm.contacts.view.mine"), Icon: "star"),
        new(AllViews, Texts.Get("crm.contacts.view.all"), Icon: "user"),
        new(WithoutCompanyView, Texts.Get("crm.contacts.view.withoutCompany"), Icon: "building"),
        .. RelationshipRoleNames.All().Select(r => new ViewOption(RolePrefix + r.Key, r.Value, Icon: "tag")),
        .. views.Options,
    ];

    private async Task ChooseViewAsync(string key)
    {
        view = key;
        views.StartNaming(false);
        if (Active is { } saved)
        {
            // Kişisel görünüm: sütunlar, sıralama ve süzgeç birlikte gelir.
            grid.Apply(saved);
            var filters = GridFilters.Parse(saved.Filters);
            mine = filters.GetValueOrDefault("ownerId") == "me";
            withoutCompany = filters.GetValueOrDefault("withoutCompany") == "true";
            role = filters.GetValueOrDefault("role");
        }
        else
        {
            grid.Reset();
            mine = key == MineView;
            withoutCompany = key == WithoutCompanyView;
            role = key.StartsWith(RolePrefix, StringComparison.Ordinal) ? key[RolePrefix.Length..] : null;
        }

        await LoadAsync(1);
    }

    private async Task SortAsync(string key)
    {
        grid.Sort = key;
        await LoadAsync(1);
    }

    private string? CurrentFilters => GridFilters.Build(
        mine ? ("ownerId", "me") : null,
        withoutCompany ? ("withoutCompany", "true") : null,
        role is { } r ? ("role", r) : null);

    private void StartNaming() => views.StartNaming(true);

    private async Task SaveAsAsync(string name)
    {
        if (await views.SaveAsAsync(grid.ToRequest(name, CurrentFilters)) is { } key)
        {
            view = key;
        }
    }

    private async Task UpdateViewAsync()
    {
        if (Active is { } current)
        {
            await views.UpdateAsync(current, grid.ToRequest(current.Name, CurrentFilters));
        }
    }

    private async Task DiscardAsync() => await ChooseViewAsync(view);

    private async Task DeleteViewAsync()
    {
        if (Active is { } current && await views.DeleteAsync(current))
        {
            await ChooseViewAsync(AllViews);
        }
    }

    private async Task LoadAsync(int pageNumber)
    {
        var url = $"{Url}?page={pageNumber}&pageSize={ListPaging.Size}&search={Uri.EscapeDataString(search ?? string.Empty)}";
        if (grid.Sort != grid.DefaultSort)
        {
            url += $"&sort={Uri.EscapeDataString(grid.Sort)}";
        }

        if (role is { } r)
        {
            url += $"&role={Uri.EscapeDataString(r)}";
        }

        if (withoutCompany)
        {
            url += "&withoutCompany=true";
        }

        if (mine)
        {
            url += "&ownerId=me";
        }

        var result = await Api.GetAsync<CrmPage<ContactDto>>(url);
        page = result.Value;
        message = result.Error;
    }

    private RenderFragment Cell(GridColumnDef column, ContactDto contact) => @<td data-label="@column.Label" class="@(column.Key == "name" ? "primary" : null)">@CellContent(column.Key, contact)</td>;

    private RenderFragment CellContent(string key, ContactDto contact) => key switch
    {
        "name" => @<a href="crm/kisiler/@contact.Id">@contact.FirstName @contact.LastName</a>,
        "company" => CompanyLink(contact),
        "title" => @<text>@contact.Title</text>,
        "phone" => @<text>@contact.Phone</text>,
        "email" => @<text>@contact.Email</text>,
        "owner" => @<OwnerCell Name="@Lookups.MemberName(contact.OwnerId)" />,
        _ when key.StartsWith("custom.", StringComparison.Ordinal) && Lookups.FieldsOf(CrmEntityKeys.Contact).FirstOrDefault(f => "custom." + f.Key == key) is { } field =>
            @<text>@CustomFieldText.Format(field, contact.Custom)</text>,
        _ => @<text></text>,
    };

    private RenderFragment CompanyLink(ContactDto contact) => @<text>@if (contact.CompanyId is { } companyId) { <a href="crm/firmalar/@companyId">@Lookups.CompanyName(companyId)</a> }</text>;

    private void Open(ContactDto? contact)
    {
        selected = contact;
        editing = true;
        message = null;
    }

    private void Close() => editing = false;

    private async Task SavedAsync()
    {
        editing = false;
        await LoadAsync(page?.Page ?? 1);
    }
}
