@page "/crm/satis-analizi"
@using System.Globalization
@using System.Net
@inject ApiClient Api
@inject SessionState Session
@inject CrmLookups Lookups

<PageTitle>Satış analizi · Modulix</PageTitle>

<AuthGate Module="@CrmAccess.ModuleKey" Permission="@SalesAccess.ReportsRead">
    <div class="page-header">
        <div>
            <h1>Satış analizi</h1>
            <p class="text-muted mb-0">
                Teklif ve lead kohortları ile aşama dönüşümü. Kohort, seçili dönemde oluşan kayıtların sonradan nereye vardığını izler; güncel durum dağılımı değildir.
                Veriler yetkiniz ve veri kapsamınızla sınırlıdır.
            </p>
        </div>
        <div class="header-actions">
            <a class="btn btn-outline-secondary" href="crm/satis-gorunumu">Satış görünümü</a>
            <a class="btn btn-outline-secondary" href="crm/ekip-performansi">Ekip performansı</a>
            <a class="btn btn-outline-secondary" href="crm/veri-kalitesi">Veri kalitesi</a>
        </div>
    </div>

    <div class="filters" role="group" aria-label="Dönem türü">
        <div class="segmented">
            @foreach (var (key, label) in SalesLabels.PeriodKinds)
            {
                <button type="button" class="chip @(kind == key ? "active" : null)" aria-pressed="@(kind == key ? "true" : "false")" disabled="@Busy" @onclick="() => ChooseKindAsync(key)">@label</button>
            }
        </div>
        <button type="button" class="btn btn-outline-secondary" disabled="@Busy" @onclick="() => ShiftAsync(-1)">← Önceki dönem</button>
        <button type="button" class="btn btn-outline-secondary" disabled="@Busy" @onclick="TodayAsync">Bugün</button>
        <button type="button" class="btn btn-outline-secondary" disabled="@Busy" @onclick="() => ShiftAsync(1)">Sonraki dönem →</button>
    </div>

    <form class="form-grid mb-3" @onsubmit="ReloadAsync" @onsubmit:preventDefault aria-label="Analiz süzgeçleri">
        <div class="span-3">
            <label class="form-label" for="sa-date">Dönemdeki bir gün</label>
            <input id="sa-date" class="form-control" type="date" @bind="anchor" @bind:after="ReloadAsync" />
        </div>
        <div class="span-3">
            <label class="form-label" for="sa-asof">Kesim günü</label>
            <input id="sa-asof" class="form-control" type="date" aria-describedby="sa-asof-help" @bind="asOf" @bind:after="ReloadAsync" />
            <div id="sa-asof-help" class="form-text">İsteğe bağlı. Boşsa şimdiki durum; geçmiş bir gün verirseniz sonuçlar o güne kadarki verilerle hesaplanır.</div>
        </div>
        <div class="span-4">
            <label class="form-label" for="sa-owner">Kullanıcı (sorumlu)</label>
            <select id="sa-owner" class="form-select" @bind="owner" @bind:after="ReloadAsync">
                <option value="">Tüm kullanıcılar</option>
                @foreach (var member in Lookups.Members)
                {
                    <option value="@member.UserId">@member.DisplayName</option>
                }
            </select>
        </div>
        <div class="span-3">
            <label class="form-label" for="sa-currency">Para birimi</label>
            <input id="sa-currency" class="form-control" maxlength="3" placeholder="@Regional.Currency" aria-describedby="sa-currency-help" @bind="currency" @bind:after="ReloadAsync" />
            <div id="sa-currency-help" class="form-text">Boşsa firmanın raporlama para birimi (3 harf, ör. USD).</div>
        </div>
    </form>

    <TabBar Tabs="Tabs" State="tabs" Label="Analiz bölümleri" Changed="OnTabChangedAsync" />

    @if (tabs.Active == QuotesTab)
    {
        <div id="tabpanel-quotes" role="tabpanel" aria-labelledby="tab-quotes" aria-busy="@(quotes.Loading ? "true" : "false")">
            <AnalyticsStatus Loading="quotes.Loading" Error="quotes.Error" Forbidden="quotes.Forbidden" OnRetry="() => LoadAsync(quotes, QuotesTab)" />
            @if (quotes.Report is { } qr)
            {
                var q = qr.Data;
                <AnalyticsFrame T="QuoteCohortDto" Report="qr">
                    <p class="small text-muted">
                        Teklif ailesi, aynı teklifin revizyonlarının bütünüdür; aile, ilk sunulduğu dönemin kohortuna girer. Kesim zamanı: @CrmLabels.Time(q.AsOf).
                    </p>
                    @if (!q.Mature)
                    {
                        <div class="alert alert-warning" role="status"><strong>Kohort olgun değil.</strong> Dönem henüz bitmedi ya da kesim günü dönem sonundan önce; bekleyen teklifler sonradan kabul edilebilir, oranlar değişebilir.</div>
                    }

                    @if (q.Families == 0)
                    {
                        <p class="text-muted">Bu dönemde sunulan teklif yok.</p>
                    }
                    else
                    {
                        <div class="kpi-grid" role="group" aria-label="Teklif kohortu özeti">
                            <SalesKpiCard Label="Teklif ailesi" Icon="file-text" Tone="info" Value="@SalesLabels.Count(q.Families)" Detail="@($"{q.Accepted} kabul edildi, {q.Pending} beklemede")" />
                            <SalesKpiCard Label="Kabul oranı" Icon="percent" Tone="success" Value="@SalesAnalysisLabels.Rate(q.AcceptanceRatePercent)"
                                          Detail="@(q.AcceptanceRatePercent is null ? "Oran hesaplanamadı" : $"Kabul edilen aile {q.Accepted} / {q.Families}")" />
                            <SalesKpiCard Label="Kabul süresi" Icon="calendar" Tone="brand" Value="@SalesAnalysisLabels.Days(q.AverageDaysToAccept)"
                                          Detail="@($"Ortalama · medyan {SalesAnalysisLabels.Days(q.MedianDaysToAccept)}")" />
                            <SalesKpiCard Label="Kabul edilen net tutar" Icon="coins" Tone="success"
                                          Value="@(qr.AmountsVisible ? CrmLabels.Amount(q.AcceptedNet.Amount, qr.Currency) : SalesAnalysisLabels.NoAmountPermission)"
                                          Detail="@(qr.AmountsVisible ? $"{q.AcceptedNet.Count} kabul edilen teklif (vergi hariç)" : "Bu değer tutar iznini ister")"
                                          Partial="@(qr.AmountsVisible && q.AcceptedNet.IsPartial)" PartialHint="@SalesLabels.PartialHint(q.AcceptedNet)" />
                        </div>

                        <section class="detail-section" aria-labelledby="sa-q-outcome">
                            <div class="section-header"><h2 id="sa-q-outcome">Sonuç dağılımı (teklif ailesi)</h2></div>
                            <table class="table record-table">
                                <caption class="visually-hidden">Teklif ailelerinin sonuçlara göre dağılımı</caption>
                                <thead>
                                    <tr><th scope="col">Sonuç</th><th scope="col">Aile sayısı</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var (outcomeLabel, outcomeCount) in SalesAnalysisLabels.QuoteOutcomes(q))
                                    {
                                        <tr>
                                            <td data-label="Sonuç" class="primary">@outcomeLabel</td>
                                            <td data-label="Aile sayısı">@SalesLabels.Count(outcomeCount)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </section>

                        <section class="detail-section" aria-labelledby="sa-q-revision">
                            <div class="section-header"><h2 id="sa-q-revision">Revizyonlar ve kabul oranı</h2></div>
                            <table class="table record-table">
                                <caption class="visually-hidden">Revizyon sayıları ve kabul oranları</caption>
                                <thead>
                                    <tr><th scope="col">Ölçüt</th><th scope="col">Değer</th></tr>
                                </thead>
                                <tbody>
                                    <tr><td data-label="Ölçüt" class="primary">Müşteriye sunulan revizyon</td><td data-label="Değer">@SalesLabels.Count(q.PresentedRevisions)</td></tr>
                                    <tr>
                                        <td data-label="Ölçüt" class="primary">Aile başına ortalama revizyon</td>
                                        <td data-label="Değer">@(q.AverageRevisionsPerFamily is { } perFamily ? perFamily.ToString("0.##", Regional.Numbers) : SalesAnalysisLabels.NoData)</td>
                                    </tr>
                                    <tr><td data-label="Ölçüt" class="primary">Aile kabul oranı</td><td data-label="Değer">@SalesAnalysisLabels.Rate(q.AcceptanceRatePercent)</td></tr>
                                    <tr><td data-label="Ölçüt" class="primary">Revizyon kabul oranı</td><td data-label="Değer">@SalesAnalysisLabels.Rate(q.RevisionAcceptanceRatePercent)</td></tr>
                                </tbody>
                            </table>
                            <p class="small text-muted mt-2">
                                Aile kabul oranı, teklif ailelerinden kabul edilenlerin payıdır; revizyon kabul oranı ise sunulan her revizyonu ayrı sayar.
                                Bir teklif kabul edilmeden önce çok revizyon gerektiriyorsa revizyon oranı genellikle aile oranının altında kalır; ikisi arasındaki fark, revizyonların kabulü nasıl etkilediğini gösterir.
                            </p>
                        </section>

                        <section class="detail-section" aria-labelledby="sa-q-owner">
                            <div class="section-header"><h2 id="sa-q-owner">Sorumlu bazında</h2></div>
                            @if (q.ByOwner.Count == 0)
                            {
                                <p class="text-muted">Sorumlu kırılımı yok.</p>
                            }
                            else
                            {
                                <table class="table record-table">
                                    <caption class="visually-hidden">Teklif kohortunun sorumluya göre dağılımı</caption>
                                    <thead>
                                        <tr><th scope="col">Sorumlu</th><th scope="col">Teklif ailesi</th><th scope="col">Kabul edilen</th><th scope="col">Kabul oranı</th></tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var row in q.ByOwner)
                                        {
                                            <tr>
                                                <td data-label="Sorumlu" class="primary">@SalesAnalysisLabels.Owner(Lookups, row.OwnerId)</td>
                                                <td data-label="Teklif ailesi">@SalesLabels.Count(row.Families)</td>
                                                <td data-label="Kabul edilen">@SalesLabels.Count(row.Accepted)</td>
                                                <td data-label="Kabul oranı">@SalesAnalysisLabels.Rate(row.AcceptanceRatePercent)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                        </section>
                    }
                </AnalyticsFrame>
            }
        </div>
    }

    @if (tabs.Active == LeadsTab)
    {
        <div id="tabpanel-leads" role="tabpanel" aria-labelledby="tab-leads" aria-busy="@(leads.Loading ? "true" : "false")">
            <AnalyticsStatus Loading="leads.Loading" Error="leads.Error" Forbidden="leads.Forbidden" OnRetry="() => LoadAsync(leads, LeadsTab)" />
            @if (leads.Report is { } lr)
            {
                var l = lr.Data;
                <AnalyticsFrame T="LeadCohortDto" Report="lr">
                    <p class="small text-muted">Kohort: seçili dönemde alınan müşteri adayları. Kesim zamanı: @CrmLabels.Time(l.AsOf).</p>
                    @if (!l.Mature)
                    {
                        <div class="alert alert-warning" role="status">
                            <strong>Kohort olgun değil.</strong> Dönem bitişinden sonra @l.MaturityDays gün geçmedi; dönüşüm oranı sonradan artabilir. Bu oranı kesin sonuç gibi yorumlamayın.
                        </div>
                    }

                    @if (l.Leads == 0)
                    {
                        <p class="text-muted">Bu dönemde alınan müşteri adayı yok.</p>
                    }
                    else
                    {
                        <div class="kpi-grid" role="group" aria-label="Müşteri adayı kohortu özeti">
                            <SalesKpiCard Label="Kohort" Icon="inbox" Tone="info" Value="@SalesLabels.Count(l.Leads)" Detail="Dönemde alınan müşteri adayı" />
                            <SalesKpiCard Label="Dönüşen" Icon="check-circle" Tone="success" Value="@SalesLabels.Count(l.Converted)" Detail="Fırsata dönüşen" />
                            <SalesKpiCard Label="Elenen" Icon="shield" Tone="danger" Value="@SalesLabels.Count(l.Disqualified)" Detail="Uygun değil diye elenen" />
                            <SalesKpiCard Label="Açık" Icon="layers" Tone="brand" Value="@SalesLabels.Count(l.Open)" Detail="Henüz sonuçlanmamış" />
                            <SalesKpiCard Label="Uygun müşteri adayı" Icon="user-check" Tone="info" Value="@SalesLabels.Count(l.Eligible)" Detail="Elenenler hariç kohort" />
                        </div>

                        <section class="detail-section" aria-labelledby="sa-l-rates">
                            <div class="section-header"><h2 id="sa-l-rates">Dönüşüm oranı</h2></div>
                            <div class="kpi-grid" role="group" aria-label="Müşteri adayı dönüşüm oranları">
                                <SalesKpiCard Label="Tüm kohorta göre" Icon="percent" Tone="success" Value="@SalesAnalysisLabels.Rate(l.RateOfAllPercent)"
                                              Detail="@($"Dönüşen {l.Converted} / kohort {l.Leads}")" />
                                <SalesKpiCard Label="Uygun müşteri adaylarına göre" Icon="percent" Tone="success" Value="@SalesAnalysisLabels.Rate(l.RateOfEligiblePercent)"
                                              Detail="@(l.Eligible == 0 ? "Uygun müşteri adayı yok" : $"Dönüşen {l.Converted} / uygun {l.Eligible}")" />
                                <SalesKpiCard Label="Dönüşme süresi" Icon="calendar" Tone="brand" Value="@SalesAnalysisLabels.Days(l.AverageDaysToConvert)"
                                              Detail="@($"Ortalama · medyan {SalesAnalysisLabels.Days(l.MedianDaysToConvert)}")" />
                            </div>
                        </section>

                        <section class="detail-section" aria-labelledby="sa-l-source">
                            <div class="section-header"><h2 id="sa-l-source">Kaynak bazında</h2></div>
                            @if (l.BySource.Count == 0)
                            {
                                <p class="text-muted">Kaynak kırılımı yok.</p>
                            }
                            else
                            {
                                <table class="table record-table">
                                    <caption class="visually-hidden">Müşteri adayı kohortunun kaynağa göre dağılımı</caption>
                                    <thead>
                                        <tr><th scope="col">Kaynak</th><th scope="col">Müşteri adayı</th><th scope="col">Dönüşen</th><th scope="col">Dönüşüm oranı</th></tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var row in l.BySource)
                                        {
                                            <tr>
                                                <td data-label="Kaynak" class="primary">@(string.IsNullOrWhiteSpace(row.Source) ? "Kaynak yok" : Lookups.Label(CrmLeadLists.Source, row.Source))</td>
                                                <td data-label="Lead">@SalesLabels.Count(row.Leads)</td>
                                                <td data-label="Dönüşen">@SalesLabels.Count(row.Converted)</td>
                                                <td data-label="Dönüşüm oranı">@SalesAnalysisLabels.Rate(row.RatePercent)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                        </section>
                    }
                </AnalyticsFrame>
            }
        </div>
    }

    @if (tabs.Active == StagesTab)
    {
        <div id="tabpanel-stages" role="tabpanel" aria-labelledby="tab-stages" aria-busy="@(stages.Loading ? "true" : "false")">
            <AnalyticsStatus Loading="stages.Loading" Error="stages.Error" Forbidden="stages.Forbidden" OnRetry="() => LoadAsync(stages, StagesTab)" />
            @if (stages.Report is { } sr)
            {
                var s = sr.Data;
                <AnalyticsFrame T="StageFlowDto" Report="sr">
                    <div class="alert alert-info" role="note">
                        <strong>Bu, güncel aşama dağılımı değildir.</strong> Seçili dönemde oluşturulan fırsatların (kohort) aşamalar arasındaki tarihsel dönüşümüdür; kohort dışındaki açık fırsatlar burada görünmez.
                        Güncel dağılım için Satış görünümü sayfasına bakın.
                    </div>
                    <p class="small text-muted">
                        Kohort büyüklüğü: <strong>@SalesLabels.Count(s.Cohort)</strong> fırsat ·
                        Tarihçe izlemesi başlangıcı: <strong>@(s.TrackingStart is { } tracking ? SalesAnalysisLabels.TrackingStart(tracking) : "izleme başlamadı")</strong> ·
                        Kesim zamanı: @CrmLabels.Time(s.AsOf)
                    </p>

                    @if (s.Cohort == 0 || s.Rows.Count == 0)
                    {
                        <div class="alert alert-secondary" role="status">
                            <strong>Veri yok</strong> — tarihçe izlemesi başlamadan önce açılan fırsatlar için dönüşüm üretilmez. Bu dönemde izlenen fırsat bulunamadı.
                        </div>
                    }
                    else
                    {
                        var ordered = s.Rows.OrderBy(r => r.Order).ToList();
                        <section class="detail-section" aria-labelledby="sa-s-chart">
                            <div class="section-header"><h2 id="sa-s-chart">Aşama akışı</h2></div>
                            <BarChart Title="Aşamaya giren tekil fırsat adedi"
                                      Slices="@ordered.Select(r => new ChartSlice(Lookups.Label(CrmLists.OpportunityStage, r.Stage), r.Entered)).ToList()" />
                            <BarChart Title="Bir sonraki aşamaya ilerleyen fırsat adedi"
                                      Slices="@ordered.Select(r => new ChartSlice(Lookups.Label(CrmLists.OpportunityStage, r.Stage), r.Advanced)).ToList()" />
                            <p class="small text-muted">İlk grafik her aşamaya girmiş tekil fırsatları, ikincisi o aşamadan sonraki aşamaya geçenleri gösterir. Ayrıntılar aşağıdaki tablodadır.</p>
                        </section>

                        <section class="detail-section" aria-labelledby="sa-s-table">
                            <div class="section-header"><h2 id="sa-s-table">Aşama dönüşüm tablosu</h2></div>
                            <div class="table-responsive">
                                <table class="table record-table">
                                    <caption class="visually-hidden">Oluşturulma kohortunun aşamalara göre tarihsel dönüşümü</caption>
                                    <thead>
                                        <tr>
                                            <th scope="col">Aşama</th><th scope="col">Girmiş tekil fırsat</th><th scope="col">İlerleyen</th><th scope="col">İlerleme</th>
                                            <th scope="col">Bu aşamadan kaybedilen</th><th scope="col">Bu aşamadan kazanılan</th><th scope="col">Şu an burada</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var row in ordered)
                                        {
                                            <tr>
                                                <td data-label="Aşama" class="primary">@Lookups.Label(CrmLists.OpportunityStage, row.Stage)</td>
                                                <td data-label="Girmiş tekil fırsat">@SalesLabels.Count(row.Entered)</td>
                                                <td data-label="İlerleyen">@SalesLabels.Count(row.Advanced)</td>
                                                <td data-label="İlerleme">@SalesAnalysisLabels.Rate(row.AdvanceRatePercent)</td>
                                                <td data-label="Bu aşamadan kaybedilen">@SalesLabels.Count(row.LostFrom)</td>
                                                <td data-label="Bu aşamadan kazanılan">@SalesLabels.Count(row.WonFrom)</td>
                                                <td data-label="Şu an burada">@SalesLabels.Count(row.StillHere)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </section>
                    }
                </AnalyticsFrame>
            }
        </div>
    }
</AuthGate>

@code {
    private const string QuotesTab = "quotes";
    private const string LeadsTab = "leads";
    private const string StagesTab = "stages";

    /// <summary>Bir sekmenin yükleme durumu; her sekme kendi uç noktasını ilk açıldığında çağırır.</summary>
    private sealed class Panel<T>
    {
        public AnalyticsDto<T>? Report { get; set; }

        public string? Error { get; set; }

        public bool Forbidden { get; set; }

        public bool Loading { get; set; }

        public bool Loaded { get; set; }

        public int RequestId { get; set; }
    }

    private static readonly IReadOnlyList<TabItem> Tabs =
    [
        new(QuotesTab, "Teklif kohortu"), new(LeadsTab, "Müşteri adayı dönüşümü"), new(StagesTab, "Aşama dönüşümü"),
    ];

    private readonly TabState tabs = new(QuotesTab);
    private readonly Panel<QuoteCohortDto> quotes = new();
    private readonly Panel<LeadCohortDto> leads = new();
    private readonly Panel<StageFlowDto> stages = new();

    private string kind = SalesPeriodKinds.Month;
    private DateOnly anchor = DateOnly.FromDateTime(Regional.Now.DateTime);
    private DateOnly? asOf;
    private string owner = string.Empty;
    private string currency = string.Empty;

    private bool Busy => quotes.Loading || leads.Loading || stages.Loading;

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (Session.Can(SalesAccess.ReportsRead))
        {
            await Lookups.LoadAsync();
            await LoadActiveAsync();
        }
    }

    private static string Iso(DateOnly day) => day.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);

    private string BuildQuery()
    {
        var query = new List<string> { $"kind={kind}", $"date={Iso(anchor)}" };
        if (asOf is { } cutoff)
        {
            query.Add($"asOf={Iso(cutoff)}");
        }

        if (owner.Length > 0)
        {
            query.Add($"ownerId={Uri.EscapeDataString(owner)}");
        }

        // Yarım yazılmış para birimi gönderilmez (3 harf olunca uygulanır).
        if (currency.Trim().Length == 3)
        {
            query.Add($"currency={Uri.EscapeDataString(currency.Trim().ToUpperInvariant())}");
        }

        return string.Join('&', query);
    }

    private async Task LoadAsync<T>(Panel<T> panel, string path)
    {
        var id = ++panel.RequestId;
        panel.Loading = true;
        panel.Error = null;
        panel.Forbidden = false;

        var result = await Api.GetAsync<AnalyticsDto<T>>($"/api/crm/sales/analytics/{path}?{BuildQuery()}");
        if (id != panel.RequestId)
        {
            return;
        }

        panel.Loading = false;
        panel.Loaded = true;
        panel.Report = result.IsSuccess ? result.Value : null;
        panel.Error = result.Error;
        panel.Forbidden = result.Status == HttpStatusCode.Forbidden;
    }

    private static void Reset<T>(Panel<T> panel)
    {
        // Süzgeç değişince bekleyen yanıt geçersiz sayılır ve sekme bir sonraki açılışta yeniden yüklenir.
        panel.RequestId++;
        panel.Report = null;
        panel.Error = null;
        panel.Forbidden = false;
        panel.Loading = false;
        panel.Loaded = false;
    }

    private Task LoadActiveAsync() => tabs.Active switch
    {
        LeadsTab => leads.Loaded ? Task.CompletedTask : LoadAsync(leads, LeadsTab),
        StagesTab => stages.Loaded ? Task.CompletedTask : LoadAsync(stages, StagesTab),
        _ => quotes.Loaded ? Task.CompletedTask : LoadAsync(quotes, QuotesTab),
    };

    private async Task OnTabChangedAsync(string key) => await LoadActiveAsync();

    private async Task ReloadAsync()
    {
        Reset(quotes);
        Reset(leads);
        Reset(stages);
        await LoadActiveAsync();
    }

    private async Task ChooseKindAsync(string key)
    {
        kind = key;
        await ReloadAsync();
    }

    private async Task ShiftAsync(int direction)
    {
        var (start, end) = ActivePeriod() ?? SalesLabels.CalendarPeriod(kind, anchor);
        anchor = direction < 0 ? start.AddDays(-1) : end.AddDays(1);
        await ReloadAsync();
    }

    // Sunucunun hesapladığı dönem (mali yıl ayarını bilir); henüz yoksa takvim dönemi kullanılır.
    private (DateOnly Start, DateOnly End)? ActivePeriod() => tabs.Active switch
    {
        LeadsTab => leads.Report is { } l ? (l.PeriodStart, l.PeriodEnd) : null,
        StagesTab => stages.Report is { } s ? (s.PeriodStart, s.PeriodEnd) : null,
        _ => quotes.Report is { } q ? (q.PeriodStart, q.PeriodEnd) : null,
    };

    private async Task TodayAsync()
    {
        anchor = DateOnly.FromDateTime(Regional.Now.DateTime);
        await ReloadAsync();
    }
}
