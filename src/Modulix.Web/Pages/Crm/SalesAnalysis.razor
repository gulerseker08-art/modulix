@page "/crm/satis-analizi"
@using System.Globalization
@using System.Net
@inject ApiClient Api
@inject SessionState Session
@inject CrmLookups Lookups

<PageTitle>@Texts.Get("crm.salesAnalysis.title") · Modulix</PageTitle>

<AuthGate Module="@CrmAccess.ModuleKey" Permission="@SalesAccess.ReportsRead">
    <div class="page-header">
        <div>
            <h1>@Texts.Get("crm.salesAnalysis.title")</h1>
            <p class="text-muted mb-0">
                @Texts.Get("crm.salesAnalysis.intro")
                @Texts.Get("crm.sales.scopeNote")
            </p>
        </div>
        <div class="header-actions">
            <a class="btn btn-outline-secondary" href="crm/satis-gorunumu">@Texts.Get("crm.salesOverview.title")</a>
            <a class="btn btn-outline-secondary" href="crm/ekip-performansi">@Texts.Get("crm.salesTeam.title")</a>
            <a class="btn btn-outline-secondary" href="crm/veri-kalitesi">@Texts.Get("crm.dataQuality.title")</a>
        </div>
    </div>

    <div class="filters" role="group" aria-label="@Texts.Get("crm.sales.periodKind")">
        <div class="segmented">
            @foreach (var (key, label) in SalesLabels.PeriodKinds)
            {
                <button type="button" class="chip @(kind == key ? "active" : null)" aria-pressed="@(kind == key ? "true" : "false")" disabled="@Busy" @onclick="() => ChooseKindAsync(key)">@label</button>
            }
        </div>
        <button type="button" class="btn btn-outline-secondary" disabled="@Busy" @onclick="() => ShiftAsync(-1)">@Texts.Get("crm.sales.previousPeriod")</button>
        <button type="button" class="btn btn-outline-secondary" disabled="@Busy" @onclick="TodayAsync">@Texts.Get("crm.sales.today")</button>
        <button type="button" class="btn btn-outline-secondary" disabled="@Busy" @onclick="() => ShiftAsync(1)">@Texts.Get("crm.sales.nextPeriod")</button>
    </div>

    <form class="form-grid mb-3" @onsubmit="ReloadAsync" @onsubmit:preventDefault aria-label="@Texts.Get("crm.salesAnalysis.filters")">
        <div class="span-3">
            <label class="form-label" for="sa-date">@Texts.Get("crm.sales.anchorDay")</label>
            <input id="sa-date" class="form-control" type="date" @bind="anchor" @bind:after="ReloadAsync" />
        </div>
        <div class="span-3">
            <label class="form-label" for="sa-asof">@Texts.Get("crm.salesAnalysis.asOf")</label>
            <input id="sa-asof" class="form-control" type="date" aria-describedby="sa-asof-help" @bind="asOf" @bind:after="ReloadAsync" />
            <div id="sa-asof-help" class="form-text">@Texts.Get("crm.salesAnalysis.asOfHelp")</div>
        </div>
        <div class="span-4">
            <label class="form-label" for="sa-owner">@Texts.Get("crm.sales.ownerFilter")</label>
            <select id="sa-owner" class="form-select" @bind="owner" @bind:after="ReloadAsync">
                <option value="">@Texts.Get("crm.sales.allUsers")</option>
                @foreach (var member in Lookups.Members)
                {
                    <option value="@member.UserId">@member.DisplayName</option>
                }
            </select>
        </div>
        <div class="span-3">
            <label class="form-label" for="sa-currency">@Texts.Get("crm.sales.currency")</label>
            <input id="sa-currency" class="form-control" maxlength="3" placeholder="@Regional.Currency" aria-describedby="sa-currency-help" @bind="currency" @bind:after="ReloadAsync" />
            <div id="sa-currency-help" class="form-text">@Texts.Get("crm.sales.currencyHelp")</div>
        </div>
    </form>

    <TabBar Tabs="Tabs" State="tabs" Label="@Texts.Get("crm.salesAnalysis.sections")" Changed="OnTabChangedAsync" />

    @if (tabs.Active == QuotesTab)
    {
        <div id="tabpanel-quotes" role="tabpanel" aria-labelledby="tab-quotes" aria-busy="@(quotes.Loading ? "true" : "false")">
            <AnalyticsStatus Loading="quotes.Loading" Error="quotes.Error" Forbidden="quotes.Forbidden" OnRetry="() => LoadAsync(quotes, QuotesTab)" />
            @if (quotes.Report is { } qr)
            {
                var q = qr.Data;
                <AnalyticsFrame T="QuoteCohortDto" Report="qr">
                    <p class="small text-muted">
                        @Texts.Get("crm.salesAnalysis.q.intro", CrmLabels.Time(q.AsOf))
                    </p>
                    @if (!q.Mature)
                    {
                        <div class="alert alert-warning" role="status"><strong>@Texts.Get("crm.salesAnalysis.immature")</strong> @Texts.Get("crm.salesAnalysis.q.immature")</div>
                    }

                    @if (q.Families == 0)
                    {
                        <p class="text-muted">@Texts.Get("crm.salesAnalysis.q.empty")</p>
                    }
                    else
                    {
                        <div class="kpi-grid" role="group" aria-label="@Texts.Get("crm.salesAnalysis.q.summary")">
                            <SalesKpiCard Label="@Texts.Get("crm.salesAnalysis.q.families")" Icon="file-text" Tone="info" Value="@SalesLabels.Count(q.Families)" Detail="@Texts.Get("crm.salesAnalysis.q.familiesDetail", q.Accepted, q.Pending)" />
                            <SalesKpiCard Label="@Texts.Get("crm.salesAnalysis.q.acceptanceRate")" Icon="percent" Tone="success" Value="@SalesAnalysisLabels.Rate(q.AcceptanceRatePercent)"
                                          Detail="@(q.AcceptanceRatePercent is null ? Texts.Get("crm.salesAnalysis.rateUnavailable") : Texts.Get("crm.salesAnalysis.q.acceptedOf", q.Accepted, q.Families))" />
                            <SalesKpiCard Label="@Texts.Get("crm.salesAnalysis.q.timeToAccept")" Icon="calendar" Tone="brand" Value="@SalesAnalysisLabels.Days(q.AverageDaysToAccept)"
                                          Detail="@Texts.Get("crm.salesAnalysis.averageMedian", SalesAnalysisLabels.Days(q.MedianDaysToAccept))" />
                            <SalesKpiCard Label="@Texts.Get("crm.salesAnalysis.q.acceptedNet")" Icon="coins" Tone="success"
                                          Value="@(qr.AmountsVisible ? CrmLabels.Amount(q.AcceptedNet.Amount, qr.Currency) : SalesAnalysisLabels.NoAmountPermission)"
                                          Detail="@(qr.AmountsVisible ? Texts.Get("crm.salesAnalysis.q.acceptedNetDetail", q.AcceptedNet.Count) : Texts.Get("crm.sales.needsAmountPermission"))"
                                          Partial="@(qr.AmountsVisible && q.AcceptedNet.IsPartial)" PartialHint="@SalesLabels.PartialHint(q.AcceptedNet)" />
                        </div>

                        <section class="detail-section" aria-labelledby="sa-q-outcome">
                            <div class="section-header"><h2 id="sa-q-outcome">@Texts.Get("crm.salesAnalysis.q.outcomes")</h2></div>
                            <table class="table record-table">
                                <caption class="visually-hidden">@Texts.Get("crm.salesAnalysis.q.outcomesCaption")</caption>
                                <thead>
                                    <tr><th scope="col">@Texts.Get("crm.salesAnalysis.col.outcome")</th><th scope="col">@Texts.Get("crm.salesAnalysis.col.familyCount")</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var (outcomeLabel, outcomeCount) in SalesAnalysisLabels.QuoteOutcomes(q))
                                    {
                                        <tr>
                                            <td data-label="@Texts.Get("crm.salesAnalysis.col.outcome")" class="primary">@outcomeLabel</td>
                                            <td data-label="@Texts.Get("crm.salesAnalysis.col.familyCount")">@SalesLabels.Count(outcomeCount)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </section>

                        <section class="detail-section" aria-labelledby="sa-q-revision">
                            <div class="section-header"><h2 id="sa-q-revision">@Texts.Get("crm.salesAnalysis.q.revisions")</h2></div>
                            <table class="table record-table">
                                <caption class="visually-hidden">@Texts.Get("crm.salesAnalysis.q.revisionsCaption")</caption>
                                <thead>
                                    <tr><th scope="col">@Texts.Get("crm.salesAnalysis.col.measure")</th><th scope="col">@Texts.Get("crm.salesAnalysis.col.value")</th></tr>
                                </thead>
                                <tbody>
                                    <tr><td data-label="@Texts.Get("crm.salesAnalysis.col.measure")" class="primary">@Texts.Get("crm.salesAnalysis.q.presentedRevisions")</td><td data-label="@Texts.Get("crm.salesAnalysis.col.value")">@SalesLabels.Count(q.PresentedRevisions)</td></tr>
                                    <tr>
                                        <td data-label="@Texts.Get("crm.salesAnalysis.col.measure")" class="primary">@Texts.Get("crm.salesAnalysis.q.revisionsPerFamily")</td>
                                        <td data-label="@Texts.Get("crm.salesAnalysis.col.value")">@(q.AverageRevisionsPerFamily is { } perFamily ? perFamily.ToString("0.##", Regional.Numbers) : SalesAnalysisLabels.NoData)</td>
                                    </tr>
                                    <tr><td data-label="@Texts.Get("crm.salesAnalysis.col.measure")" class="primary">@Texts.Get("crm.salesAnalysis.q.familyRate")</td><td data-label="@Texts.Get("crm.salesAnalysis.col.value")">@SalesAnalysisLabels.Rate(q.AcceptanceRatePercent)</td></tr>
                                    <tr><td data-label="@Texts.Get("crm.salesAnalysis.col.measure")" class="primary">@Texts.Get("crm.salesAnalysis.q.revisionRate")</td><td data-label="@Texts.Get("crm.salesAnalysis.col.value")">@SalesAnalysisLabels.Rate(q.RevisionAcceptanceRatePercent)</td></tr>
                                </tbody>
                            </table>
                            <p class="small text-muted mt-2">
                                @Texts.Get("crm.salesAnalysis.q.rateNote1")
                                @Texts.Get("crm.salesAnalysis.q.rateNote2")
                            </p>
                        </section>

                        <section class="detail-section" aria-labelledby="sa-q-owner">
                            <div class="section-header"><h2 id="sa-q-owner">@Texts.Get("crm.sales.byOwner")</h2></div>
                            @if (q.ByOwner.Count == 0)
                            {
                                <EmptyState Title="@Texts.Get("crm.salesAnalysis.noOwnerBreakdown")" />
                            }
                            else
                            {
                                <table class="table record-table">
                                    <caption class="visually-hidden">@Texts.Get("crm.salesAnalysis.q.ownerCaption")</caption>
                                    <thead>
                                        <tr><th scope="col">@Texts.Get("common.field.owner")</th><th scope="col">@Texts.Get("crm.salesAnalysis.q.families")</th><th scope="col">@Texts.Get("crm.salesAnalysis.outcome.accepted")</th><th scope="col">@Texts.Get("crm.salesAnalysis.q.acceptanceRate")</th></tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var row in q.ByOwner)
                                        {
                                            <tr>
                                                <td data-label="@Texts.Get("common.field.owner")" class="primary">@SalesAnalysisLabels.Owner(Lookups, row.OwnerId)</td>
                                                <td data-label="@Texts.Get("crm.salesAnalysis.q.families")">@SalesLabels.Count(row.Families)</td>
                                                <td data-label="@Texts.Get("crm.salesAnalysis.outcome.accepted")">@SalesLabels.Count(row.Accepted)</td>
                                                <td data-label="@Texts.Get("crm.salesAnalysis.q.acceptanceRate")">@SalesAnalysisLabels.Rate(row.AcceptanceRatePercent)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                        </section>
                    }
                </AnalyticsFrame>
            }
        </div>
    }

    @if (tabs.Active == LeadsTab)
    {
        <div id="tabpanel-leads" role="tabpanel" aria-labelledby="tab-leads" aria-busy="@(leads.Loading ? "true" : "false")">
            <AnalyticsStatus Loading="leads.Loading" Error="leads.Error" Forbidden="leads.Forbidden" OnRetry="() => LoadAsync(leads, LeadsTab)" />
            @if (leads.Report is { } lr)
            {
                var l = lr.Data;
                <AnalyticsFrame T="LeadCohortDto" Report="lr">
                    <p class="small text-muted">@Texts.Get("crm.salesAnalysis.l.intro", CrmLabels.Time(l.AsOf))</p>
                    @if (!l.Mature)
                    {
                        <div class="alert alert-warning" role="status">
                            <strong>@Texts.Get("crm.salesAnalysis.immature")</strong> @Texts.Get("crm.salesAnalysis.l.immature", l.MaturityDays)
                        </div>
                    }

                    @if (l.Leads == 0)
                    {
                        <p class="text-muted">@Texts.Get("crm.salesAnalysis.l.empty")</p>
                    }
                    else
                    {
                        <div class="kpi-grid" role="group" aria-label="@Texts.Get("crm.salesAnalysis.l.summary")">
                            <SalesKpiCard Label="@Texts.Get("crm.salesAnalysis.l.cohort")" Icon="inbox" Tone="info" Value="@SalesLabels.Count(l.Leads)" Detail="@Texts.Get("crm.salesAnalysis.l.cohortDetail")" />
                            <SalesKpiCard Label="@Texts.Get("crm.salesAnalysis.l.converted")" Icon="check-circle" Tone="success" Value="@SalesLabels.Count(l.Converted)" Detail="@Texts.Get("crm.salesAnalysis.l.convertedDetail")" />
                            <SalesKpiCard Label="@Texts.Get("crm.salesAnalysis.l.disqualified")" Icon="shield" Tone="danger" Value="@SalesLabels.Count(l.Disqualified)" Detail="@Texts.Get("crm.salesAnalysis.l.disqualifiedDetail")" />
                            <SalesKpiCard Label="@Texts.Get("crm.opportunityReport.col.open")" Icon="layers" Tone="brand" Value="@SalesLabels.Count(l.Open)" Detail="@Texts.Get("crm.salesAnalysis.l.openDetail")" />
                            <SalesKpiCard Label="@Texts.Get("crm.salesAnalysis.l.eligible")" Icon="user-check" Tone="info" Value="@SalesLabels.Count(l.Eligible)" Detail="@Texts.Get("crm.salesAnalysis.l.eligibleDetail")" />
                        </div>

                        <section class="detail-section" aria-labelledby="sa-l-rates">
                            <div class="section-header"><h2 id="sa-l-rates">@Texts.Get("crm.salesAnalysis.l.rate")</h2></div>
                            <div class="kpi-grid" role="group" aria-label="@Texts.Get("crm.salesAnalysis.l.rates")">
                                <SalesKpiCard Label="@Texts.Get("crm.salesAnalysis.l.rateOfAll")" Icon="percent" Tone="success" Value="@SalesAnalysisLabels.Rate(l.RateOfAllPercent)"
                                              Detail="@Texts.Get("crm.salesAnalysis.l.rateOfAllDetail", l.Converted, l.Leads)" />
                                <SalesKpiCard Label="@Texts.Get("crm.salesAnalysis.l.rateOfEligible")" Icon="percent" Tone="success" Value="@SalesAnalysisLabels.Rate(l.RateOfEligiblePercent)"
                                              Detail="@(l.Eligible == 0 ? Texts.Get("crm.salesAnalysis.l.noEligible") : Texts.Get("crm.salesAnalysis.l.rateOfEligibleDetail", l.Converted, l.Eligible))" />
                                <SalesKpiCard Label="@Texts.Get("crm.salesAnalysis.l.timeToConvert")" Icon="calendar" Tone="brand" Value="@SalesAnalysisLabels.Days(l.AverageDaysToConvert)"
                                              Detail="@Texts.Get("crm.salesAnalysis.averageMedian", SalesAnalysisLabels.Days(l.MedianDaysToConvert))" />
                            </div>
                        </section>

                        <section class="detail-section" aria-labelledby="sa-l-source">
                            <div class="section-header"><h2 id="sa-l-source">@Texts.Get("crm.salesAnalysis.l.bySource")</h2></div>
                            @if (l.BySource.Count == 0)
                            {
                                <EmptyState Title="@Texts.Get("crm.salesAnalysis.l.noSourceBreakdown")" />
                            }
                            else
                            {
                                <table class="table record-table">
                                    <caption class="visually-hidden">@Texts.Get("crm.salesAnalysis.l.sourceCaption")</caption>
                                    <thead>
                                        <tr><th scope="col">@Texts.Get("crm.salesAnalysis.col.source")</th><th scope="col">@Texts.Get("crm.salesAnalysis.col.lead")</th><th scope="col">@Texts.Get("crm.salesAnalysis.l.converted")</th><th scope="col">@Texts.Get("crm.salesAnalysis.l.rate")</th></tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var row in l.BySource)
                                        {
                                            <tr>
                                                <td data-label="@Texts.Get("crm.salesAnalysis.col.source")" class="primary">@(string.IsNullOrWhiteSpace(row.Source) ? Texts.Get("crm.salesAnalysis.noSource") : Lookups.Label(CrmLeadLists.Source, row.Source))</td>
                                                <td data-label="@Texts.Get("crm.salesAnalysis.col.lead")">@SalesLabels.Count(row.Leads)</td>
                                                <td data-label="@Texts.Get("crm.salesAnalysis.l.converted")">@SalesLabels.Count(row.Converted)</td>
                                                <td data-label="@Texts.Get("crm.salesAnalysis.l.rate")">@SalesAnalysisLabels.Rate(row.RatePercent)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                        </section>
                    }
                </AnalyticsFrame>
            }
        </div>
    }

    @if (tabs.Active == StagesTab)
    {
        <div id="tabpanel-stages" role="tabpanel" aria-labelledby="tab-stages" aria-busy="@(stages.Loading ? "true" : "false")">
            <AnalyticsStatus Loading="stages.Loading" Error="stages.Error" Forbidden="stages.Forbidden" OnRetry="() => LoadAsync(stages, StagesTab)" />
            @if (stages.Report is { } sr)
            {
                var s = sr.Data;
                <AnalyticsFrame T="StageFlowDto" Report="sr">
                    <div class="alert alert-info" role="note">
                        <strong>@Texts.Get("crm.salesAnalysis.s.notCurrent")</strong> @Texts.Get("crm.salesAnalysis.s.notCurrentNote")
                        @Texts.Get("crm.salesAnalysis.s.seeOverview")
                    </div>
                    <p class="small text-muted">
                        @Texts.Strong("crm.salesAnalysis.s.cohortSize", SalesLabels.Count(s.Cohort)) ·
                        @Texts.Strong("crm.salesAnalysis.s.trackingStart", s.TrackingStart is { } tracking ? SalesAnalysisLabels.TrackingStart(tracking) : Texts.Get("crm.salesAnalysis.s.notTracking")) ·
                        @Texts.Get("crm.salesAnalysis.asOfTime", CrmLabels.Time(s.AsOf))
                    </p>

                    @if (s.Cohort == 0 || s.Rows.Count == 0)
                    {
                        <div class="alert alert-secondary" role="status">
                            <strong>@SalesAnalysisLabels.NoData</strong> — @Texts.Get("crm.salesAnalysis.s.empty")
                        </div>
                    }
                    else
                    {
                        var ordered = s.Rows.OrderBy(r => r.Order).ToList();
                        <section class="detail-section" aria-labelledby="sa-s-chart">
                            <div class="section-header"><h2 id="sa-s-chart">@Texts.Get("crm.salesAnalysis.s.flow")</h2></div>
                            <BarChart Title="@Texts.Get("crm.salesAnalysis.s.enteredChart")"
                                      Slices="@ordered.Select(r => new ChartSlice(Lookups.Label(CrmLists.OpportunityStage, r.Stage), r.Entered)).ToList()" />
                            <BarChart Title="@Texts.Get("crm.salesAnalysis.s.advancedChart")"
                                      Slices="@ordered.Select(r => new ChartSlice(Lookups.Label(CrmLists.OpportunityStage, r.Stage), r.Advanced)).ToList()" />
                            <p class="small text-muted">@Texts.Get("crm.salesAnalysis.s.chartNote")</p>
                        </section>

                        <section class="detail-section" aria-labelledby="sa-s-table">
                            <div class="section-header"><h2 id="sa-s-table">@Texts.Get("crm.salesAnalysis.s.table")</h2></div>
                            <div class="table-responsive">
                                <table class="table record-table">
                                    <caption class="visually-hidden">@Texts.Get("crm.salesAnalysis.s.tableCaption")</caption>
                                    <thead>
                                        <tr>
                                            <th scope="col">@Texts.Get("crm.opportunities.col.stage")</th><th scope="col">@Texts.Get("crm.salesAnalysis.s.entered")</th><th scope="col">@Texts.Get("crm.salesAnalysis.s.advanced")</th><th scope="col">@Texts.Get("crm.salesAnalysis.s.advanceRate")</th>
                                            <th scope="col">@Texts.Get("crm.salesAnalysis.s.lostFrom")</th><th scope="col">@Texts.Get("crm.salesAnalysis.s.wonFrom")</th><th scope="col">@Texts.Get("crm.salesAnalysis.s.stillHere")</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var row in ordered)
                                        {
                                            <tr>
                                                <td data-label="@Texts.Get("crm.opportunities.col.stage")" class="primary">@Lookups.Label(CrmLists.OpportunityStage, row.Stage)</td>
                                                <td data-label="@Texts.Get("crm.salesAnalysis.s.entered")">@SalesLabels.Count(row.Entered)</td>
                                                <td data-label="@Texts.Get("crm.salesAnalysis.s.advanced")">@SalesLabels.Count(row.Advanced)</td>
                                                <td data-label="@Texts.Get("crm.salesAnalysis.s.advanceRate")">@SalesAnalysisLabels.Rate(row.AdvanceRatePercent)</td>
                                                <td data-label="@Texts.Get("crm.salesAnalysis.s.lostFrom")">@SalesLabels.Count(row.LostFrom)</td>
                                                <td data-label="@Texts.Get("crm.salesAnalysis.s.wonFrom")">@SalesLabels.Count(row.WonFrom)</td>
                                                <td data-label="@Texts.Get("crm.salesAnalysis.s.stillHere")">@SalesLabels.Count(row.StillHere)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </section>
                    }
                </AnalyticsFrame>
            }
        </div>
    }
</AuthGate>

@code {
    private const string QuotesTab = "quotes";
    private const string LeadsTab = "leads";
    private const string StagesTab = "stages";

    /// <summary>Bir sekmenin yükleme durumu; her sekme kendi uç noktasını ilk açıldığında çağırır.</summary>
    private sealed class Panel<T>
    {
        public AnalyticsDto<T>? Report { get; set; }

        public string? Error { get; set; }

        public bool Forbidden { get; set; }

        public bool Loading { get; set; }

        public bool Loaded { get; set; }

        public int RequestId { get; set; }
    }

    private static IReadOnlyList<TabItem> Tabs =>
    [
        new(QuotesTab, Texts.Get("crm.salesAnalysis.tab.quotes")), new(LeadsTab, Texts.Get("crm.salesAnalysis.tab.leads")), new(StagesTab, Texts.Get("crm.salesAnalysis.tab.stages")),
    ];

    private readonly TabState tabs = new(QuotesTab);
    private readonly Panel<QuoteCohortDto> quotes = new();
    private readonly Panel<LeadCohortDto> leads = new();
    private readonly Panel<StageFlowDto> stages = new();

    private string kind = SalesPeriodKinds.Month;
    private DateOnly anchor = DateOnly.FromDateTime(Regional.Now.DateTime);
    private DateOnly? asOf;
    private string owner = string.Empty;
    private string currency = string.Empty;

    private bool Busy => quotes.Loading || leads.Loading || stages.Loading;

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (Session.Can(SalesAccess.ReportsRead))
        {
            await Lookups.LoadAsync();
            await LoadActiveAsync();
        }
    }

    private static string Iso(DateOnly day) => day.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);

    private string BuildQuery()
    {
        var query = new List<string> { $"kind={kind}", $"date={Iso(anchor)}" };
        if (asOf is { } cutoff)
        {
            query.Add($"asOf={Iso(cutoff)}");
        }

        if (owner.Length > 0)
        {
            query.Add($"ownerId={Uri.EscapeDataString(owner)}");
        }

        // Yarım yazılmış para birimi gönderilmez (3 harf olunca uygulanır).
        if (currency.Trim().Length == 3)
        {
            query.Add($"currency={Uri.EscapeDataString(currency.Trim().ToUpperInvariant())}");
        }

        return string.Join('&', query);
    }

    private async Task LoadAsync<T>(Panel<T> panel, string path)
    {
        var id = ++panel.RequestId;
        panel.Loading = true;
        panel.Error = null;
        panel.Forbidden = false;

        var result = await Api.GetAsync<AnalyticsDto<T>>($"/api/crm/sales/analytics/{path}?{BuildQuery()}");
        if (id != panel.RequestId)
        {
            return;
        }

        panel.Loading = false;
        panel.Loaded = true;
        panel.Report = result.IsSuccess ? result.Value : null;
        panel.Error = result.Error;
        panel.Forbidden = result.Status == HttpStatusCode.Forbidden;
    }

    private static void Reset<T>(Panel<T> panel)
    {
        // Süzgeç değişince bekleyen yanıt geçersiz sayılır ve sekme bir sonraki açılışta yeniden yüklenir.
        panel.RequestId++;
        panel.Report = null;
        panel.Error = null;
        panel.Forbidden = false;
        panel.Loading = false;
        panel.Loaded = false;
    }

    private Task LoadActiveAsync() => tabs.Active switch
    {
        LeadsTab => leads.Loaded ? Task.CompletedTask : LoadAsync(leads, LeadsTab),
        StagesTab => stages.Loaded ? Task.CompletedTask : LoadAsync(stages, StagesTab),
        _ => quotes.Loaded ? Task.CompletedTask : LoadAsync(quotes, QuotesTab),
    };

    private async Task OnTabChangedAsync(string key) => await LoadActiveAsync();

    private async Task ReloadAsync()
    {
        Reset(quotes);
        Reset(leads);
        Reset(stages);
        await LoadActiveAsync();
    }

    private async Task ChooseKindAsync(string key)
    {
        kind = key;
        await ReloadAsync();
    }

    private async Task ShiftAsync(int direction)
    {
        var (start, end) = ActivePeriod() ?? SalesLabels.CalendarPeriod(kind, anchor);
        anchor = direction < 0 ? start.AddDays(-1) : end.AddDays(1);
        await ReloadAsync();
    }

    // Sunucunun hesapladığı dönem (mali yıl ayarını bilir); henüz yoksa takvim dönemi kullanılır.
    private (DateOnly Start, DateOnly End)? ActivePeriod() => tabs.Active switch
    {
        LeadsTab => leads.Report is { } l ? (l.PeriodStart, l.PeriodEnd) : null,
        StagesTab => stages.Report is { } s ? (s.PeriodStart, s.PeriodEnd) : null,
        _ => quotes.Report is { } q ? (q.PeriodStart, q.PeriodEnd) : null,
    };

    private async Task TodayAsync()
    {
        anchor = DateOnly.FromDateTime(Regional.Now.DateTime);
        await ReloadAsync();
    }
}
