@page "/crm/satis-hedefleri"
@using System.Globalization
@using System.Net
@inject ApiClient Api
@inject SessionState Session
@inject CrmLookups Lookups

<PageTitle>@Texts.Get("crm.salesTargets.title") · Modulix</PageTitle>

<AuthGate Module="@CrmAccess.ModuleKey" Permission="@SalesAccess.TargetsRead">
    <a class="back-link" href="crm/satis-gorunumu">← @Texts.Get("crm.salesOverview.title")</a>
    <div class="page-header">
        <div>
            <h1>@Texts.Get("crm.salesTargets.title")</h1>
            <p class="text-muted mb-0">
                @Texts.Get("crm.salesTargets.intro")
            </p>
        </div>
        @if (CanManage && form is null)
        {
            <div class="header-actions"><button type="button" class="btn btn-primary" @onclick="StartCreate">@Texts.Get("crm.salesTargets.new")</button></div>
        }
    </div>

    <Notice Text="@success" />
    <Notice Text="@pageNotice" Failed="true" />

    @if (form is not null)
    {
        <form class="record-form" novalidate @onsubmit="SaveAsync" @onsubmit:preventDefault aria-labelledby="st-form-title">
            <h2 id="st-form-title">@(form.Id is null ? Texts.Get("crm.salesTargets.new") : Texts.Get("crm.salesTargets.edit"))</h2>
            <ErrorSummary Errors="errors" />
            @if (formMessage is not null)
            {
                <div class="alert alert-danger" role="alert">@formMessage</div>
            }

            <FormTabs Title="@Texts.Get("crm.salesTargets.info")" Label="@Texts.Get("crm.salesTargets.formSections")">
            @if (form.Id is null)
            {
                <fieldset class="mb-3">
                    <legend class="h6">@Texts.Get("crm.salesTargets.quickFill")</legend>
                    <div class="form-grid">
                        <div class="span-3">
                            <label class="form-label" for="st-fill-kind">@Texts.Get("crm.sales.periodKind")</label>
                            <select id="st-fill-kind" class="form-select" @bind="fillKind">
                                @foreach (var (key, label) in SalesLabels.PeriodKinds) { <option value="@key">@label</option> }
                            </select>
                        </div>
                        <div class="span-3">
                            <label class="form-label" for="st-fill-date">@Texts.Get("crm.sales.anchorDay")</label>
                            <input id="st-fill-date" class="form-control" type="date" @bind="fillDate" />
                        </div>
                        <div class="span-3">
                            <label class="form-label" for="st-fill-go">&nbsp;</label>
                            <button id="st-fill-go" type="button" class="btn btn-outline-secondary" disabled="@busy" @onclick="FillPeriodAsync">@Texts.Get("crm.salesTargets.fillPeriod")</button>
                        </div>
                    </div>
                    <p class="form-text mb-0">@Texts.Get("crm.salesTargets.fillHelp")</p>
                </fieldset>
            }

            <div class="form-grid">
                <div class="span-3">
                    <label class="form-label required" for="st-metric">@Texts.Get("crm.salesTargets.metric")</label>
                    <select id="st-metric" class="form-select" required aria-required="true" disabled="@(form.Id is not null)" @bind="form.Metric" @bind:after="MetricChanged">
                        @foreach (var (key, label) in SalesLabels.Metrics) { <option value="@key">@label</option> }
                    </select>
                    <FieldError Field="metric" Errors="errors" />
                </div>
                <div class="span-3">
                    <label class="form-label required" for="st-scope">@Texts.Get("crm.salesForecasts.scope")</label>
                    <select id="st-scope" class="form-select" required aria-required="true" disabled="@(form.Id is not null)" @bind="form.Scope" @bind:after="ScopeChanged">
                        @foreach (var (key, label) in SalesLabels.Scopes) { <option value="@key">@label</option> }
                    </select>
                    <FieldError Field="scopeType" Errors="errors" />
                </div>
                @if (form.Scope == SalesTargetScopes.User)
                {
                    <div class="span-3">
                        <label class="form-label required" for="st-user">@Texts.Get("crm.sales-scope.user")</label>
                        <select id="st-user" class="form-select" required aria-required="true" disabled="@(form.Id is not null)" @bind="form.UserId">
                            <option value="">@Texts.Get("common.choose")</option>
                            @foreach (var member in Lookups.Members) { <option value="@member.UserId">@member.DisplayName</option> }
                        </select>
                        <FieldError Field="scopeUserId" Errors="errors" />
                    </div>
                }
                @if (form.Metric == SalesTargetMetrics.WonAmount)
                {
                    <div class="span-3">
                        <label class="form-label required" for="st-currency">@Texts.Get("crm.sales.currency")</label>
                        <input id="st-currency" class="form-control" maxlength="3" required aria-required="true" disabled="@(form.Id is not null)" @bind="form.Currency" />
                        <FieldError Field="currency" Errors="errors" />
                    </div>
                }
                <div class="span-3">
                    <label class="form-label required" for="st-start">@Texts.Get("crm.salesTargets.periodStart")</label>
                    <input id="st-start" class="form-control" type="date" required aria-required="true" disabled="@(form.Id is not null)" @bind="form.PeriodStart" />
                    <FieldError Field="periodStart" Errors="errors" />
                </div>
                <div class="span-3">
                    <label class="form-label required" for="st-end">@Texts.Get("crm.salesTargets.periodEnd")</label>
                    <input id="st-end" class="form-control" type="date" required aria-required="true" disabled="@(form.Id is not null)" @bind="form.PeriodEnd" />
                    <FieldError Field="periodEnd" Errors="errors" />
                </div>
                <div class="span-3">
                    <label class="form-label required" for="st-value">@(form.Metric == SalesTargetMetrics.WonAmount ? Texts.Get("crm.salesTargets.valueAmount") : Texts.Get("crm.salesTargets.valueCount"))</label>
                    <input id="st-value" class="form-control" type="number" min="0" step="@(form.Metric == SalesTargetMetrics.WonCount ? "1" : "any")" inputmode="decimal"
                           required aria-required="true" @bind="form.Value" />
                    <FieldError Field="value" Errors="errors" />
                </div>
                @if (form.Id is not null && ValueEdited)
                {
                    <div class="span-12">
                        <label class="form-label required" for="st-reason">@Texts.Get("crm.salesTargets.reason")</label>
                        <input id="st-reason" class="form-control" maxlength="500" required aria-required="true" aria-describedby="st-reason-help" @bind="form.Reason" />
                        <div id="st-reason-help" class="form-text">@Texts.Get("crm.salesTargets.reasonHelp")</div>
                        <FieldError Field="changeReason" Errors="errors" />
                    </div>
                }
                <div class="span-12">
                    <label class="form-label" for="st-note">@Texts.Get("crm.salesTargets.note")</label>
                    <textarea id="st-note" class="form-control" rows="2" maxlength="1000" @bind="form.Note"></textarea>
                    <FieldError Field="note" Errors="errors" />
                </div>
            </div>
            </FormTabs>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary" disabled="@busy">
                    @if (busy) { <span class="spinner-border spinner-border-sm" aria-hidden="true"></span> }
                    @Texts.Get("common.save")
                </button>
                <button type="button" class="btn btn-outline-secondary" disabled="@busy" @onclick="CancelForm">@Texts.Get("common.dismiss")</button>
                @if (form.Id is not null && confirmDelete)
                {
                    <span class="confirm ms-auto" role="alert">
                        <span>@Texts.Get("crm.salesTargets.deleteConfirm")</span>
                        <button type="button" class="btn btn-danger btn-sm" disabled="@busy" @onclick="DeleteAsync">@Texts.Get("common.view.deleteYes")</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@busy" @onclick="() => confirmDelete = false">@Texts.Get("common.dismiss")</button>
                    </span>
                }
                else if (form.Id is not null)
                {
                    <button type="button" class="btn btn-outline-danger ms-auto" disabled="@busy" @onclick="() => confirmDelete = true">@Texts.Get("common.delete")</button>
                }
            </div>
        </form>
    }

    <form class="form-grid mb-3" @onsubmit="ApplyFiltersAsync" @onsubmit:preventDefault aria-label="@Texts.Get("crm.salesTargets.filters")">
        <div class="span-3">
            <label class="form-label" for="stf-from">@Texts.Get("crm.salesForecasts.filterFrom")</label>
            <input id="stf-from" class="form-control" type="date" @bind="from" @bind:after="ApplyFiltersAsync" />
        </div>
        <div class="span-3">
            <label class="form-label" for="stf-to">@Texts.Get("crm.salesForecasts.filterTo")</label>
            <input id="stf-to" class="form-control" type="date" @bind="to" @bind:after="ApplyFiltersAsync" />
        </div>
        <div class="span-3">
            <label class="form-label" for="stf-metric">@Texts.Get("crm.salesTargets.metric")</label>
            <select id="stf-metric" class="form-select" @bind="filterMetric" @bind:after="ApplyFiltersAsync">
                <option value="">@Texts.Get("crm.salesForecasts.all")</option>
                @foreach (var (key, label) in SalesLabels.Metrics) { <option value="@key">@label</option> }
            </select>
        </div>
        <div class="span-3">
            <label class="form-label" for="stf-scope">@Texts.Get("crm.salesForecasts.scope")</label>
            <select id="stf-scope" class="form-select" @bind="filterScope" @bind:after="ApplyFiltersAsync">
                <option value="">@Texts.Get("crm.salesForecasts.all")</option>
                @foreach (var (key, label) in SalesLabels.Scopes) { <option value="@key">@label</option> }
            </select>
        </div>
        @if (filterScope == SalesTargetScopes.User)
        {
            <div class="span-3">
                <label class="form-label" for="stf-user">@Texts.Get("crm.sales-scope.user")</label>
                <select id="stf-user" class="form-select" @bind="filterUser" @bind:after="ApplyFiltersAsync">
                    <option value="">@Texts.Get("crm.sales.allUsers")</option>
                    @foreach (var member in Lookups.Members) { <option value="@member.UserId">@member.DisplayName</option> }
                </select>
            </div>
        }
    </form>

    @if (listError is not null)
    {
        <div class="alert alert-danger" role="alert">
            @listError
            <button type="button" class="btn btn-outline-secondary btn-sm ms-2" disabled="@loading" @onclick="() => LoadAsync(page?.Page ?? 1)">@Texts.Get("crm.sales.retry")</button>
        </div>
    }

    @if (loading && page is null)
    {
        <LoadingState Kind="LoadingKind.Table" />
    }
    else if (page is not null)
    {
        @if (page.Items.Count == 0)
        {
            <p class="text-muted">@(CanManage ? Texts.Get("crm.salesTargets.noneCanCreate") : Texts.Get("crm.salesTargets.none"))</p>
        }
        else
        {
            <table class="table record-table" aria-busy="@(loading ? "true" : "false")">
                <caption class="visually-hidden">@Texts.Get("crm.salesTargets.title")</caption>
                <thead>
                    <tr>
                        <th scope="col"><SortHeader Label="@Texts.Get("crm.salesOverview.col.period")" ColumnIcon="calendar" Asc="periodStart" Desc="-periodStart" Value="@sort" Default="" ValueChanged="SortAsync" /></th>
                        <th scope="col"><SortHeader Label="@Texts.Get("crm.salesTargets.metric")" ColumnIcon="target" Asc="metric" Desc="-metric" Value="@sort" Default="" ValueChanged="SortAsync" /></th>
                        <th scope="col"><SortHeader Label="@Texts.Get("crm.salesForecasts.scope")" ColumnIcon="users" Asc="scopeType" Desc="-scopeType" Value="@sort" Default="" ValueChanged="SortAsync" /></th>
                        <th scope="col"><SortHeader Label="@Texts.Get("crm.salesTarget.target")" ColumnIcon="coins" Asc="value" Desc="-value" Value="@sort" Default="" ValueChanged="SortAsync" /></th>
                        <th scope="col"><SortHeader Label="@Texts.Get("crm.salesTargets.col.revision")" ColumnIcon="history" Asc="revisionNo" Desc="-revisionNo" Value="@sort" Default="" ValueChanged="SortAsync" /></th>
                        <th scope="col">@Texts.Get("crm.salesTargets.note")</th>
                        @if (CanManage) { <th scope="col"><span class="visually-hidden">@Texts.Get("crm.lead.actions")</span></th> }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var target in page.Items)
                    {
                        <tr>
                            <td data-label="@Texts.Get("crm.salesOverview.col.period")" class="primary">@SalesLabels.Period(target.PeriodStart, target.PeriodEnd)</td>
                            <td data-label="@Texts.Get("crm.salesTargets.metric")">@SalesLabels.Metric(target.Metric)</td>
                            <td data-label="@Texts.Get("crm.salesForecasts.scope")">@(target.ScopeType == SalesTargetScopes.User ? Texts.Get("crm.salesForecasts.userScope", Lookups.MemberName(target.ScopeUserId)) : Texts.Get("crm.sales-scope.tenant"))</td>
                            <td data-label="@Texts.Get("crm.salesTarget.target")">@ValueText(target)</td>
                            <td data-label="@Texts.Get("crm.salesTargets.col.revision")">@(target.RevisionNo > 0 ? Texts.Get("crm.salesTargets.revisionNo", target.RevisionNo) : Texts.Get("crm.salesTargets.firstValue"))</td>
                            <td data-label="@Texts.Get("crm.salesTargets.note")">@(target.Note ?? "—")</td>
                            @if (CanManage)
                            {
                                <td class="actions"><button type="button" class="btn btn-outline-primary btn-sm" aria-label="@Texts.Get("crm.salesTargets.editAria", SalesLabels.Period(target.PeriodStart, target.PeriodEnd))" @onclick="() => StartEdit(target)">@Texts.Get("common.edit")</button></td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
            <Pager Page="page.Page" PageSize="page.PageSize" TotalCount="page.TotalCount" PageChanged="LoadAsync" />
        }
    }
</AuthGate>

@code {
    private const string Url = "/api/crm/sales-targets";

    private CrmPage<SalesTargetDto>? page;
    private TargetForm? form;
    private IReadOnlyDictionary<string, string[]>? errors;
    private string? formMessage;
    private string? listError;
    private string? success;
    private string? pageNotice;
    private bool loading;
    private bool busy;
    private bool confirmDelete;
    private int requestId;

    private DateOnly? from;
    private DateOnly? to;
    private string filterMetric = string.Empty;
    private string filterScope = string.Empty;
    private string filterUser = string.Empty;

    private string fillKind = SalesPeriodKinds.Month;
    private DateOnly? fillDate = DateOnly.FromDateTime(Regional.Now.DateTime);

    private bool CanManage => Session.Can(SalesAccess.TargetsManage);

    private bool ValueEdited => form is { OriginalValue: { } original } && form.Value != original;

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (Session.Can(SalesAccess.TargetsRead))
        {
            var year = Regional.Now.Year;
            from = new DateOnly(year, 1, 1);
            to = new DateOnly(year, 12, 31);
            await Lookups.LoadAsync();
            await LoadAsync(1);
        }
    }

    private static string Iso(DateOnly day) => day.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);

    private Task ApplyFiltersAsync() => LoadAsync(1);

    // Sıralama sunucudadır (SalesTargetRecordStore.SortKeys); boş değer varsayılan sıradır (en yeni dönem önce).
    private string sort = "";

    private async Task SortAsync(string value)
    {
        sort = value;
        await LoadAsync(1);
    }

    private async Task LoadAsync(int pageNumber)
    {
        var id = ++requestId;
        loading = true;
        listError = null;

        var query = new List<string> { $"page={pageNumber}" };
        if (from is { } f) { query.Add($"from={Iso(f)}"); }
        if (to is { } t) { query.Add($"to={Iso(t)}"); }
        if (filterMetric.Length > 0) { query.Add($"metric={filterMetric}"); }
        if (filterScope.Length > 0) { query.Add($"scopeType={filterScope}"); }
        if (filterScope == SalesTargetScopes.User && filterUser.Length > 0) { query.Add($"scopeUserId={Uri.EscapeDataString(filterUser)}"); }

        if (sort.Length > 0) { query.Add($"sort={Uri.EscapeDataString(sort)}"); }

        var result = await Api.GetAsync<CrmPage<SalesTargetDto>>($"{Url}?{string.Join('&', query)}");
        if (id != requestId)
        {
            return;
        }

        loading = false;
        if (result.IsSuccess)
        {
            page = result.Value;
        }
        else
        {
            listError = result.Error;
        }
    }

    private static string ValueText(SalesTargetDto target) =>
        target.Metric == SalesTargetMetrics.WonAmount && target.Currency is { } currency
            ? CrmLabels.Amount(target.Value, currency)
            : target.Value.ToString("N0", Regional.Numbers);

    private void StartCreate()
    {
        form = new TargetForm { Currency = Regional.Currency };
        ResetFormState();
    }

    private void StartEdit(SalesTargetDto target)
    {
        form = new TargetForm
        {
            Id = target.Id,
            Version = target.Version,
            Metric = target.Metric,
            Scope = target.ScopeType,
            UserId = target.ScopeUserId?.ToString() ?? string.Empty,
            Currency = target.Currency ?? string.Empty,
            PeriodStart = target.PeriodStart,
            PeriodEnd = target.PeriodEnd,
            Value = target.Value,
            OriginalValue = target.Value,
            Note = target.Note ?? string.Empty,
        };
        ResetFormState();
    }

    private void ResetFormState()
    {
        errors = null;
        formMessage = null;
        success = null;
        pageNotice = null;
        confirmDelete = false;
    }

    private void CancelForm()
    {
        form = null;
        ResetFormState();
    }

    private void MetricChanged()
    {
        if (form is { Id: null })
        {
            form.Currency = form.Metric == SalesTargetMetrics.WonAmount ? Regional.Currency : string.Empty;
        }
    }

    private void ScopeChanged()
    {
        if (form is { Scope: SalesTargetScopes.Tenant })
        {
            form.UserId = string.Empty;
        }
    }

    private async Task FillPeriodAsync()
    {
        if (form is null)
        {
            return;
        }

        var day = fillDate ?? DateOnly.FromDateTime(Regional.Now.DateTime);
        var (start, end) = SalesLabels.CalendarPeriod(fillKind, day);

        // Mali yıl ayarı sunucudadır; dönemi oradan al, ulaşılamazsa takvim dönemi kalır.
        if (Session.Can(SalesAccess.ReportsRead))
        {
            busy = true;
            var result = await Api.GetAsync<SalesOverviewDto>($"/api/crm/sales/overview?kind={fillKind}&date={Iso(day)}");
            busy = false;
            if (result.IsSuccess && result.Value is { } overview)
            {
                (start, end) = (overview.PeriodStart, overview.PeriodEnd);
            }
        }

        form.PeriodStart = start;
        form.PeriodEnd = end;
    }

    private async Task SaveAsync()
    {
        if (form is null || busy)
        {
            return;
        }

        busy = true;
        formMessage = null;
        var isAmount = form.Metric == SalesTargetMetrics.WonAmount;
        var request = new SaveSalesTargetRequest(
            form.Metric,
            form.Scope,
            form.Scope == SalesTargetScopes.User && Guid.TryParse(form.UserId, out var userId) ? userId : null,
            isAmount ? form.Currency.Trim().ToUpperInvariant() : null,
            form.PeriodStart ?? default,
            form.PeriodEnd ?? default,
            form.Value ?? 0m,
            string.IsNullOrWhiteSpace(form.Note) ? null : form.Note.Trim(),
            ValueEdited ? form.Reason.Trim() : null,
            form.Version);

        var result = form.Id is { } id
            ? await Api.PutAsync<SalesTargetDto>($"{Url}/{id}", request)
            : await Api.PostAsync<SalesTargetDto>(Url, request);
        busy = false;

        if (result.IsSuccess)
        {
            var created = form.Id is null;
            form = null;
            ResetFormState();
            success = created ? Texts.Get("crm.salesTargets.added") : Texts.Get("crm.salesTargets.updated");
            await LoadAsync(created ? 1 : page?.Page ?? 1);
            return;
        }

        if (result.Status == HttpStatusCode.Conflict)
        {
            // Başkası değiştirmiş: güncel liste yüklenir, form kapanır; kullanıcı güncel değerle yeniden düzenler.
            form = null;
            ResetFormState();
            await LoadAsync(page?.Page ?? 1);
            pageNotice = Texts.Get("crm.salesTargets.conflict");
            return;
        }

        errors = result.FieldErrors;
        formMessage = result.FieldErrors.Count == 0 ? result.Error : null;
    }

    private async Task DeleteAsync()
    {
        if (form?.Id is not { } id || busy)
        {
            return;
        }

        busy = true;
        var result = await Api.DeleteAsync($"{Url}/{id}?version={form.Version}");
        busy = false;

        if (result.IsSuccess)
        {
            form = null;
            ResetFormState();
            success = Texts.Get("crm.salesTargets.deleted");
            await LoadAsync(1);
            return;
        }

        confirmDelete = false;
        formMessage = result.Error;
    }

    private sealed class TargetForm
    {
        public Guid? Id { get; init; }

        public long? Version { get; init; }

        public string Metric { get; set; } = SalesTargetMetrics.WonAmount;

        public string Scope { get; set; } = SalesTargetScopes.Tenant;

        public string UserId { get; set; } = string.Empty;

        public string Currency { get; set; } = string.Empty;

        public DateOnly? PeriodStart { get; set; }

        public DateOnly? PeriodEnd { get; set; }

        public decimal? Value { get; set; }

        public decimal? OriginalValue { get; init; }

        public string Note { get; set; } = string.Empty;

        public string Reason { get; set; } = string.Empty;
    }
}
