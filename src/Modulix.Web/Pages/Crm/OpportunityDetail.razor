@page "/crm/firsatlar/{Id:guid}"
@inject ApiClient Api
@inject SessionState Session
@inject CrmLookups Lookups
@inject ActivityOptions ActivityNames

<PageTitle>@(opportunity?.OpportunityNumber ?? Texts.Get("crm.opportunity.single")) · Modulix</PageTitle>

<AuthGate Module="@CrmAccess.ModuleKey" Permission="@CrmAccess.OpportunitiesRead">
    <a class="back-link" href="crm/firsatlar">← @Texts.Get("crm.opportunities.title")</a>

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }
    @if (actionErrors is { Count: > 0 })
    {
        <ul class="alert alert-danger">
            @foreach (var (_, texts) in actionErrors)
            {
                @foreach (var text in texts)
                {
                    <li>@text</li>
                }
            }
        </ul>
    }
    @if (notice is not null)
    {
        <div class="alert alert-info" role="status">@notice</div>
    }

    @if (opportunity is null)
    {
        @if (message is null)
        {
            <LoadingState />
        }
    }
    else if (editing)
    {
        <OpportunityEditor Opportunity="opportunity" Lookups="Lookups" Saved="SavedAsync" Deleted="DeletedAsync" Cancelled="() => editing = false" />
    }
    else
    {
        <div class="page-header">
            <div class="page-heading">
                <span class="page-icon" aria-hidden="true"><AppIcon Name="target" Size="24" /></span>
                <div>
                    <h1>@opportunity.Title</h1>
                    <p class="page-subtitle">
                        <a href="crm/firmalar/@opportunity.CompanyId">@Lookups.CompanyName(opportunity.CompanyId)</a>
                        @if (opportunity.ContactId is not null)
                        {
                            <span> · @Lookups.ContactName(opportunity.ContactId)</span>
                        }
                        @if (opportunity.OwnerId is not null)
                        {
                            <span> · @Texts.Get("crm.opp.ownerLine", Lookups.MemberName(opportunity.OwnerId))</span>
                        }
                    </p>
                    <div class="header-meta">
                        <span>@opportunity.OpportunityNumber</span>
                        <span class="badge stage-@opportunity.Status.ToLowerInvariant()">@CrmText.OpportunityStatusName(opportunity.Status)</span>
                        <span class="badge stage-@Lookups.Badge(CrmLists.OpportunityStage, opportunity.Stage)">@Lookups.Label(CrmLists.OpportunityStage, opportunity.Stage)</span>
                        <span>@Texts.Get("crm.lead.priorityLine", CrmText.LeadPriorityName(opportunity.Priority))</span>
                        @if (opportunity.Status == OpportunityStatus.Open && opportunity.ExpectedCloseDate is { } due && due < Today)
                        {
                            <span class="badge stage-lost">@Texts.Get("crm.opp.closeOverdue")</span>
                        }
                        @if (opportunity.Status == OpportunityStatus.OnHold && opportunity.HoldReviewDate is { } holdDue && holdDue <= Today)
                        {
                            <span class="badge stage-negotiation">@Texts.Get("crm.opp.reviewDue")</span>
                        }
                        @if (opportunity.Status == OpportunityStatus.Open && InactiveDays is { } days)
                        {
                            <span class="badge stage-negotiation">@Texts.Get("crm.opp.inactiveDays", days)</span>
                        }
                    </div>
                </div>
            </div>
            <div class="header-actions">
                @if (Session.Can(CrmAccess.OpportunitiesWrite))
                {
                    <button type="button" class="btn btn-outline-secondary" @onclick="() => editing = true">@Texts.Get("common.edit")</button>
                }
                @if (Session.Can(CrmAccess.QuotesWrite) && opportunity.Status == OpportunityStatus.Open)
                {
                    <a class="btn btn-primary" href="crm/teklifler/yeni?opportunityId=@Id&companyId=@opportunity.CompanyId"><span aria-hidden="true">+</span> @Texts.Get("crm.opp.newQuote")</a>
                }
            </div>
        </div>

        @if (opportunity.StatusReason is { } statusReason && opportunity.Status is OpportunityStatus.OnHold or OpportunityStatus.Cancelled)
        {
            <div class="alert alert-warning" role="status">@CrmText.OpportunityStatusName(opportunity.Status): @statusReason</div>
        }

        @* Satış hunisi: aşamaya tıklamak işlem panelini açar; aşama kuralları ve doğrulamalar o işlemle sunucuda çalışır. *@
        <SalesPipeline Stages="PipelineStages" Current="@opportunity.Stage" Status="@opportunity.Status"
                       CanChangeStage="CanStage" CanClose="CanClose" OnChoose="ChooseStage" />

        <div class="kpi-strip" role="group" aria-label="@Texts.Get("crm.opp.kpi.aria")">
            @if (ShowAmounts)
            {
                <div class="kpi-item">
                    <span class="kpi-item-icon tone-brand" aria-hidden="true"><AppIcon Name="wallet" Size="20" /></span>
                    <span><span class="kpi-item-label">@Texts.Get("crm.opp.kpi.amount")</span><strong>@(opportunity.Amount is { } kpiAmount ? CrmLabels.Amount(kpiAmount, opportunity.Currency) : Texts.Get("crm.lead.unknown"))</strong></span>
                </div>
                <div class="kpi-item">
                    <span class="kpi-item-icon tone-info" aria-hidden="true"><AppIcon Name="percent" Size="20" /></span>
                    <span><span class="kpi-item-label">@Texts.Get("crm.opportunities.col.probability")</span><strong>@(opportunity.Probability is { } kpiP ? $"%{kpiP}" : Texts.Get("crm.lead.unknown"))</strong><small>@Texts.Get(opportunity.ProbabilityManual ? "crm.opp.probManual" : "crm.opp.probDefault")</small></span>
                </div>
            }
            <div class="kpi-item">
                <span class="kpi-item-icon tone-warning" aria-hidden="true"><AppIcon Name="calendar" Size="20" /></span>
                <span><span class="kpi-item-label">@Texts.Get("crm.opp.kpi.expectedClose")</span><strong>@(opportunity.ExpectedCloseDate is { } kpiClose ? CrmLabels.Date(kpiClose) : "—")</strong></span>
            </div>
            @if (ShowAmounts)
            {
                <div class="kpi-item">
                    <span class="kpi-item-icon tone-success" aria-hidden="true"><AppIcon Name="trending-up" Size="20" /></span>
                    <span><span class="kpi-item-label">@Texts.Get("crm.opp.kpi.weighted")</span><strong>@(Weighted is { } kpiW ? CrmLabels.Amount(kpiW, opportunity.Currency) : "—")</strong><small>@Texts.Get("crm.opp.kpi.weightedHint")</small></span>
                </div>
            }
            <div class="kpi-item">
                <span class="kpi-item-icon tone-violet" aria-hidden="true"><AppIcon Name="hourglass" Size="20" /></span>
                <span><span class="kpi-item-label">@Texts.Get("crm.opp.kpi.stageDuration")</span><strong>@(StageDays is { } kpiDays ? Texts.Get("crm.lead.report.daysValue", kpiDays) : "—")</strong></span>
            </div>
        </div>

        <div class="detail-layout">
            <div class="detail-main">

            <TabBar Tabs="OpportunityTabs" State="tabs" Label="@Texts.Get("crm.opp.tabs.aria")" Changed="_ => { }" />

            @if (tabs.Rendered(TabGeneral))
            {
            <div role="tabpanel" id="tabpanel-@TabGeneral" aria-labelledby="tab-@TabGeneral" class="record-tabpanel" hidden="@tabs.Hidden(TabGeneral)">

            <FormSection Title="@Texts.Get("crm.opp.section.basic")" Icon="target">
                <dl class="detail-grid">
                    <div><dt>@Texts.Get("crm.contacts.col.company")</dt><dd><a href="crm/firmalar/@opportunity.CompanyId">@Lookups.CompanyName(opportunity.CompanyId)</a></dd></div>
                    <div><dt>@Texts.Get("crm.opp.mainContact")</dt><dd>@(opportunity.ContactId is null ? "—" : Lookups.ContactName(opportunity.ContactId))</dd></div>
                    <div><dt>@Texts.Get("common.field.owner")</dt><dd>@(opportunity.OwnerId is null ? "—" : Lookups.MemberName(opportunity.OwnerId))</dd></div>
                    <div><dt>@Texts.Get("crm.company.editor.kind")</dt><dd>@(opportunity.Type is null ? "—" : Lookups.Label(CrmLists.OpportunityType, opportunity.Type))</dd></div>
                    <div><dt>@Texts.Get("crm.opp.acquisition")</dt><dd>@(opportunity.Source is null ? "—" : Lookups.Label(CrmLeadLists.Source, opportunity.Source))</dd></div>
                    @if (opportunity.SourceLeadId is { } leadId && Session.Can(CrmAccess.LeadsRead))
                    {
                        <div><dt>@Texts.Get("crm.opportunities.sourceLead")</dt><dd><a href="crm/leadler/@leadId">@Texts.Get("crm.opp.openLead")</a></dd></div>
                    }
                    @if (ShowAmounts)
                    {
                        <div><dt>@Texts.Get("crm.opp.kpi.amount")</dt><dd>@(opportunity.Amount is { } amount ? CrmLabels.Amount(amount, opportunity.Currency) : Texts.Get("crm.lead.unknown"))</dd></div>
                        <div><dt>@Texts.Get("crm.opportunities.col.probability")</dt><dd>@(opportunity.Probability is { } p ? $"%{p}" : Texts.Get("crm.lead.unknown"))@($" ({Texts.Get(opportunity.ProbabilityManual ? "crm.opp.probManual" : "crm.opp.probDefault")})")</dd></div>
                        <div><dt>@Texts.Get("crm.opp.weightedAmount")</dt><dd>@(Weighted is { } w ? CrmLabels.Amount(w, opportunity.Currency) : "—")</dd></div>
                        <div><dt>@Texts.Get("crm.opp.customerBudget")</dt><dd>@(opportunity.CustomerBudget is { } budget ? CrmLabels.Amount(budget, opportunity.Currency) : Texts.Get("crm.lead.unknown")) · @CrmText.OpportunityBudgetStatusName(opportunity.BudgetStatus)</dd></div>
                    }
                    <div><dt>@Texts.Get("crm.opp.kpi.expectedClose")</dt><dd>@(opportunity.ExpectedCloseDate is { } close ? CrmLabels.Date(close) : "—")@(opportunity.CloseDateChangeCount > 0 ? $" · {Texts.Get("crm.opp.changedTimes", opportunity.CloseDateChangeCount)}" : null)</dd></div>
                    <div><dt>@Texts.Get("crm.opp.targetDecision")</dt><dd>@(opportunity.TargetDecisionDate is { } decision ? CrmLabels.Date(decision) : "—")</dd></div>
                    <div><dt>@Texts.Get("crm.opportunities.col.nextAction")</dt><dd>@(opportunity.NextAction ?? Texts.Get("crm.opp.undefined"))@(opportunity.NextActionDate is { } nad ? $" · {CrmLabels.Date(nad)}" : null)</dd></div>
                    <div><dt>@Texts.Get("crm.opp.lastInteraction")</dt><dd>@(opportunity.LastInteractionAt is { } last ? CrmLabels.Time(last) : Texts.Get("crm.lead.notYet"))</dd></div>
                    <div><dt>@Texts.Get("crm.opp.stageEntered")</dt><dd>@(opportunity.StageEnteredAt is { } entered ? Texts.Get("crm.opp.stageEnteredValue", CrmLabels.Time(entered), (int)(DateTimeOffset.UtcNow - entered).TotalDays) : "—")</dd></div>
                    @if (opportunity.Status == OpportunityStatus.OnHold && opportunity.HoldReviewDate is { } holdReview)
                    {
                        <div><dt>@Texts.Get("crm.opp.holdReview")</dt><dd>@CrmLabels.Date(holdReview)</dd></div>
                    }
                    @if (OpportunityStatus.IsClosed(opportunity.Status))
                    {
                        <div><dt>@Texts.Get("crm.opp.actualClose")</dt><dd>@(opportunity.ActualCloseDate is { } actual ? CrmLabels.Date(actual) : "—")</dd></div>
                        @if (opportunity.Status == OpportunityStatus.Won && ShowAmounts)
                        {
                            <div><dt>@Texts.Get("crm.opp.wonAmount")</dt><dd>@(opportunity.WonAmount is { } won ? CrmLabels.Amount(won, opportunity.WonCurrency ?? opportunity.Currency) : "—")</dd></div>
                        }
                        @if (opportunity.WinReason is { } winReason)
                        {
                            <div><dt>@Texts.Get("crm.opp.winReason")</dt><dd>@winReason</dd></div>
                        }
                        @if (opportunity.HandoverNote is { } handover)
                        {
                            <div class="span-all"><dt>@Texts.Get("crm.opp.handoverNote")</dt><dd class="notes">@handover</dd></div>
                        }
                        @if (opportunity.LossReason is { } lossReason)
                        {
                            <div><dt>@Texts.Get("crm.opp.lossReason")</dt><dd>@Lookups.Label(CrmLists.OpportunityLossReason, lossReason)@(opportunity.LostReason is { } note ? $" · {note}" : null)</dd></div>
                        }
                        @if (opportunity.WinningCompetitorId is { } winner)
                        {
                            <div><dt>@Texts.Get("crm.opp.winner")</dt><dd>@(competitors?.FirstOrDefault(c => c.Id == winner)?.Name ?? "—")</dd></div>
                        }
                        @if (opportunity.RecontactDate is { } recontact)
                        {
                            <div><dt>@Texts.Get("crm.opp.recontact")</dt><dd>@CrmLabels.Date(recontact)</dd></div>
                        }
                        @if (opportunity.WinningCompetitorId is null && opportunity.Status == OpportunityStatus.Lost && opportunity.LossReason is not null)
                        {
                            <div><dt>@Texts.Get("crm.opp.lostToCompetitor")</dt><dd>@Texts.Get(Lookups.CategoryOf(CrmLists.OpportunityLossReason, opportunity.LossReason) == "competitor" ? "crm.opp.yesNoCompetitor" : "common.no")</dd></div>
                        }
                    }
                    @foreach (var field in Lookups.FieldsOf(CrmEntityKeys.Opportunity))
                    {
                        var text = CustomFieldText.Format(field, opportunity.Custom);
                        @if (text.Length > 0)
                        {
                            <div><dt>@field.Label</dt><dd>@text</dd></div>
                        }
                    }
                    @if (opportunity.Description is { } description)
                    {
                        <div class="span-all"><dt>@Texts.Get("crm.lead.description")</dt><dd class="notes">@description</dd></div>
                    }
                    @if (opportunity.Notes is { } notes)
                    {
                        <div class="span-all"><dt>@Texts.Get("common.field.notes")</dt><dd class="notes">@notes</dd></div>
                    }
                </dl>
            </FormSection>

            <section class="detail-section opportunity-actions">
                <div class="section-header"><h2>@Texts.Get("crm.lead.actions")</h2></div>
                @if (!AnyAction)
                {
                    <p class="text-muted">@Texts.Get("crm.lead.noActions")</p>
                }
                <div class="action-row">
                    @if (CanStage && opportunity.Status == OpportunityStatus.Open)
                    {
                        <button type="button" class="btn btn-outline-primary" disabled="@busy" @onclick="() => Toggle(Panel.Stage)">@Texts.Get("crm.opp.changeStage")</button>
                        <button type="button" class="btn btn-outline-secondary" disabled="@busy" @onclick="() => Toggle(Panel.Hold)">@Texts.Get("crm.opp.hold")</button>
                    }
                    @if (CanStage && opportunity.Status == OpportunityStatus.OnHold)
                    {
                        <button type="button" class="btn btn-outline-primary" disabled="@busy" @onclick="ResumeAsync">@Texts.Get("crm.opp.resume")</button>
                    }
                    @if (CanClose && opportunity.Status == OpportunityStatus.Open)
                    {
                        <button type="button" class="btn btn-outline-success" disabled="@busy" @onclick="() => Toggle(Panel.Win)">@Texts.Get("crm.opportunity-status.won")</button>
                        <button type="button" class="btn btn-outline-danger" disabled="@busy" @onclick="() => Toggle(Panel.Lose)">@Texts.Get("crm.opportunity-status.lost")</button>
                        <button type="button" class="btn btn-outline-secondary" disabled="@busy" @onclick="() => Toggle(Panel.Cancel)">@Texts.Get("crm.opp.cancel")</button>
                    }
                    @if (CanReopen && OpportunityStatus.IsClosed(opportunity.Status))
                    {
                        <button type="button" class="btn btn-outline-primary" disabled="@busy" @onclick="() => Toggle(Panel.Reopen)">@Texts.Get("crm.lead.reopen")</button>
                    }
                </div>

                @switch (panel)
                {
                    case Panel.Stage:
                        <div class="inline-form">
                            <label class="form-label" for="o-stage">@Texts.Get("crm.opp.newStage")</label>
                            <select id="o-stage" class="form-select" @ref="panelFirst" @bind="stage">
                                @foreach (var s in OpenStages(opportunity.Stage))
                                {
                                    <option value="@s.Key">@s.Label</option>
                                }
                            </select>
                            <label class="form-label" for="o-stage-note">@Texts.Get("crm.opp.reasonOptional")</label>
                            <textarea id="o-stage-note" class="form-control" rows="2" maxlength="1000" @bind="note"></textarea>
                            <small class="text-muted">@Texts.Get("crm.opp.stageHelp")</small>
                            <button type="button" class="btn btn-primary" disabled="@(busy || stage == opportunity.Stage)" @onclick="ChangeStageAsync">@Texts.Get("crm.opp.changeStageDo")</button>
                        </div>
                        break;
                    case Panel.Hold:
                        <div class="inline-form">
                            <label class="form-label" for="h-reason">@Texts.Get("crm.opp.holdReason")</label>
                            <textarea id="h-reason" class="form-control" rows="2" maxlength="500" @bind="note"></textarea>
                            <label class="form-label" for="h-date">@Texts.Get("crm.opp.holdReviewDate")</label>
                            <input id="h-date" class="form-control" type="date" @bind="reviewDate" />
                            <small class="text-muted">@Texts.Get("crm.opp.holdHelp")</small>
                            <button type="button" class="btn btn-secondary" disabled="@(busy || string.IsNullOrWhiteSpace(note) || reviewDate is null)" @onclick="HoldAsync">@Texts.Get("crm.opp.hold")</button>
                        </div>
                        break;
                    case Panel.Win:
                        <div class="inline-form">
                            <label class="form-label" for="w-date">@Texts.Get("crm.opp.actualCloseDate")</label>
                            <input id="w-date" class="form-control" type="date" @ref="panelFirst" max="@Today.ToString("yyyy-MM-dd")" @bind="closeDate" />
                            @if (ShowAmounts)
                            {
                                <label class="form-label" for="w-amount">@Texts.Get("crm.opp.wonAmount")</label>
                                <input id="w-amount" class="form-control" type="number" min="0" step="0.01" inputmode="decimal" @bind="wonAmount" />
                                <label class="form-label" for="w-currency">@Texts.Get("crm.lead.convertPanel.currency")</label>
                                <input id="w-currency" class="form-control" maxlength="3" @bind="wonCurrency" />
                                <small class="text-muted">@Texts.Get("crm.opp.wonHelp", opportunity.Amount is { } a ? CrmLabels.Amount(a, opportunity.Currency) : Texts.Get("crm.opp.unknownLower"))</small>
                            }
                            <label class="form-label" for="w-reason">@Texts.Get("crm.opp.winReason")</label>
                            <input id="w-reason" class="form-control" maxlength="500" @bind="note" />
                            <label class="form-label" for="w-handover">@Texts.Get("crm.opp.handoverLabel")</label>
                            <textarea id="w-handover" class="form-control" rows="2" maxlength="4000" @bind="handover"></textarea>
                            <button type="button" class="btn btn-success" disabled="@busy" @onclick="WinAsync">@Texts.Get("crm.opp.winDo")</button>
                        </div>
                        break;
                    case Panel.Lose:
                        <div class="inline-form">
                            <label class="form-label" for="l-reason">@Texts.Get("crm.opp.lossReasonReq")</label>
                            <select id="l-reason" class="form-select" @ref="panelFirst" @bind="lossReason">
                                <option value="">@Texts.Get("common.choose")</option>
                                @foreach (var r in Lookups.Choices(CrmLists.OpportunityLossReason))
                                {
                                    <option value="@r.Key">@r.Label</option>
                                }
                            </select>
                            <label class="form-label" for="l-note">@Texts.Get("crm.lead.description") @(Lookups.CategoryOf(CrmLists.OpportunityLossReason, lossReason) == "other" ? "*" : null)</label>
                            <textarea id="l-note" class="form-control" rows="2" maxlength="500" @bind="note"></textarea>
                            @if (Lookups.CategoryOf(CrmLists.OpportunityLossReason, lossReason) == "competitor")
                            {
                                <label class="form-label" for="l-competitor">@Texts.Get("crm.opp.winner")</label>
                                <select id="l-competitor" class="form-select" @bind="winnerId">
                                    <option value="">@Texts.Get("crm.opp.unspecified")</option>
                                    @foreach (var c in competitors ?? [])
                                    {
                                        <option value="@c.Id">@c.Name</option>
                                    }
                                </select>
                                <small class="text-muted">@Texts.Get("crm.opp.competitorHint")</small>
                            }
                            <label class="form-label" for="l-recontact">@Texts.Get("crm.opp.recontactDate")</label>
                            <input id="l-recontact" class="form-control" type="date" @bind="reviewDate" />
                            @if (Session.Can(CrmAccess.ActivitiesWrite))
                            {
                                <label class="form-check"><input type="checkbox" class="form-check-input" @bind="followUp" /> @Texts.Get("crm.opp.followUpActivity")</label>
                            }
                            <button type="button" class="btn btn-danger" disabled="@(busy || string.IsNullOrEmpty(lossReason))" @onclick="LoseAsync">@Texts.Get("crm.opp.loseDo")</button>
                        </div>
                        break;
                    case Panel.Cancel:
                        <div class="inline-form">
                            <label class="form-label" for="c-reason">@Texts.Get("crm.opp.cancelReason")</label>
                            <textarea id="c-reason" class="form-control" rows="2" maxlength="500" @bind="note"></textarea>
                            <small class="text-muted">@Texts.Get("crm.opp.cancelHelp")</small>
                            <button type="button" class="btn btn-secondary" disabled="@(busy || string.IsNullOrWhiteSpace(note))" @onclick="CancelAsync">@Texts.Get("crm.opp.cancel")</button>
                        </div>
                        break;
                    case Panel.Reopen:
                        <div class="inline-form">
                            <label class="form-label" for="r-reason">@Texts.Get("crm.lead.reopenReason")</label>
                            <textarea id="r-reason" class="form-control" rows="2" maxlength="1000" @bind="note"></textarea>
                            <label class="form-label" for="r-stage">@Texts.Get("crm.opp.newStageReq")</label>
                            <select id="r-stage" class="form-select" @bind="stage">
                                @foreach (var s in OpenStages(null))
                                {
                                    <option value="@s.Key">@s.Label</option>
                                }
                            </select>
                            <label class="form-label" for="r-date">@Texts.Get("crm.opp.newClose")</label>
                            <input id="r-date" class="form-control" type="date" min="@Today.ToString("yyyy-MM-dd")" @bind="reviewDate" />
                            @if (ShowAmounts)
                            {
                                <label class="form-label" for="r-prob">@Texts.Get("crm.opp.probabilityPct")</label>
                                <input id="r-prob" class="form-control" type="number" min="0" max="100" step="5" @bind="reopenProbability" />
                            }
                            <small class="text-muted">@Texts.Get("crm.opp.reopenHelp")</small>
                            <button type="button" class="btn btn-primary" disabled="@(busy || string.IsNullOrWhiteSpace(note) || reviewDate is null)" @onclick="ReopenAsync">@Texts.Get("crm.lead.reopen")</button>
                        </div>
                        break;
                }
            </section>

            @if (HasNeedAnalysis)
            {
                <FormSection Title="@Texts.Get("crm.opp.details")" Icon="clipboard-list" Description="@Texts.Get("crm.opp.needAnalysis")">
                    <dl class="detail-grid">
                        @foreach (var (label, text) in NeedFields)
                        {
                            if (!string.IsNullOrWhiteSpace(text))
                            {
                                <div class="span-all"><dt>@label</dt><dd class="notes">@text</dd></div>
                            }
                        }
                        @if (opportunity?.ServiceScope is { Count: > 0 } serviceScope)
                        {
                            <div class="span-all">
                                <dt>@Texts.Get("crm.leads.filter.scope")</dt>
                                <dd>
                                    @foreach (var code in serviceScope)
                                    {
                                        <span class="badge tag">@ActivityNames.NameOf(code)</span>
                                    }
                                </dd>
                            </div>
                        }
                    </dl>
                </FormSection>
            }

            @if (Session.Can(CrmAccess.QuotesRead) && PrimaryQuote is { } lineQuote)
            {
                <FormSection Title="@Texts.Get("crm.opp.lines")" Icon="package">
                    <Actions>
                        <a class="btn btn-outline-primary btn-sm" href="crm/teklifler/@lineQuote.Id">@Texts.Get("crm.opp.editInQuote")</a>
                    </Actions>
                    <ChildContent>
                    <p class="text-muted small">@Texts.Get("crm.opp.linesHelp", $"{lineQuote.QuoteNumber} · V{lineQuote.RevisionNo}")</p>
                    @if (primaryLines is null)
                    {
                        <LoadingState Kind="LoadingKind.Table" />
                    }
                    else if (!primaryLines.Any(l => l.Included && l.Role != "PackageChild"))
                    {
                        <p class="text-muted">@Texts.Get("crm.opp.noLines")</p>
                    }
                    else
                    {
                        <table class="table record-table line-table">
                            <caption class="visually-hidden">@Texts.Get("crm.opp.linesCaption")</caption>
                            <thead>
                                <tr>
                                    <th scope="col">@Texts.Get("crm.opp.line.product")</th><th scope="col" class="text-end">@Texts.Get("crm.opp.line.quantity")</th><th scope="col">@Texts.Get("crm.opp.line.unit")</th>
                                    <th scope="col" class="text-end">@Texts.Get("crm.opp.line.unitPrice")</th><th scope="col" class="text-end">@Texts.Get("crm.opp.line.discount")</th>
                                    <th scope="col" class="text-end">@Texts.Get("crm.opp.line.tax")</th><th scope="col" class="text-end">@Texts.Get("crm.opp.line.total")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var line in primaryLines.Where(l => l.Included && l.Role != "PackageChild").OrderBy(l => l.Position))
                                {
                                    <tr>
                                        <td data-label="@Texts.Get("crm.opp.line.product")" class="primary">@line.Name @if (!string.IsNullOrWhiteSpace(line.ProductCode)) { <small class="text-muted">@line.ProductCode</small> }</td>
                                        <td data-label="@Texts.Get("crm.opp.line.quantity")" class="text-end">@line.Quantity.ToString("0.######", Regional.Numbers)</td>
                                        <td data-label="@Texts.Get("crm.opp.line.unit")">@(line.UnitName ?? "—")</td>
                                        <td data-label="@Texts.Get("crm.opp.line.unitPrice")" class="text-end">@QuoteLabels.Money(line.UnitPrice, lineQuote.Currency)</td>
                                        <td data-label="@Texts.Get("crm.opp.line.discount")" class="text-end">@QuoteLabels.Money(line.LineDiscount + line.DocumentDiscountShare, lineQuote.Currency)</td>
                                        <td data-label="@Texts.Get("crm.opp.line.tax")" class="text-end">%@(line.TaxRatePercent.ToString("0.##", Regional.Numbers))</td>
                                        <td data-label="@Texts.Get("crm.opp.line.total")" class="text-end">@QuoteLabels.Money(line.Gross, lineQuote.Currency)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    </ChildContent>
                </FormSection>
            }

            </div>
            }

            @if (tabs.Rendered(TabContacts))
            {
            <div role="tabpanel" id="tabpanel-@TabContacts" aria-labelledby="tab-@TabContacts" class="record-tabpanel" hidden="@tabs.Hidden(TabContacts)">
            <FormSection Title="@Texts.Get("crm.contacts.title")" Icon="users">
                <Actions>
                    @if (Session.Can(CrmAccess.OpportunitiesWrite) && !addingContact)
                    {
                        <button type="button" class="btn btn-outline-primary btn-sm" @onclick="() => addingContact = true">@Texts.Get("crm.opp.linkContact")</button>
                    }
                </Actions>
                <ChildContent>
                @if (addingContact)
                {
                    <div class="inline-form">
                        <label class="form-label" for="oc-contact">@Texts.Get("crm.contact.fallbackTitle")</label>
                        <LookupPicker Id="oc-contact" LookupKey="crm.opportunity.contact" @bind-Value="newContact" ParentId="opportunity.CompanyId" Placeholder="@Texts.Get("crm.opp.chooseContact")" />
                        <fieldset>
                            <legend class="form-label">@Texts.Get("crm.opp.contactRoles")</legend>
                            @foreach (var role in OpportunityContactRoles.All)
                            {
                                <label class="form-check form-check-inline">
                                    <input type="checkbox" class="form-check-input" checked="@newRoles.Contains(role)" @onchange="e => ToggleRole(role, (bool)e.Value!)" /> @CrmText.OpportunityContactRoleName(role)
                                </label>
                            }
                        </fieldset>
                        <label class="form-check"><input type="checkbox" class="form-check-input" @bind="newPrimary" /> @Texts.Get("crm.company.people.primary")</label>
                        <button type="button" class="btn btn-primary" disabled="@(busy || newContact is null)" @onclick="AddContactAsync">@Texts.Get("crm.opp.link")</button>
                        <button type="button" class="btn btn-outline-secondary" @onclick="() => addingContact = false">@Texts.Get("common.dismiss")</button>
                    </div>
                }
                @if (contacts is null)
                {
                    <LoadingState />
                }
                else if (contacts.Count == 0)
                {
                    <p class="text-muted">@Texts.Get("crm.opp.noContacts")</p>
                }
                else
                {
                    <ul class="item-list">
                        @foreach (var link in contacts)
                        {
                            <li>
                                <div class="item-main">
                                    <a href="crm/kisiler/@link.ContactId">@link.ContactName</a>@(link.IsPrimary ? $" · {Texts.Get("crm.opp.primaryLower")}" : null)
                                    <span class="text-muted">@(link.Roles.Count == 0 ? Texts.Get("crm.opp.noRole") : string.Join(", ", link.Roles.Select(CrmText.OpportunityContactRoleName)))@(link.Note is { } cn ? $" · {cn}" : null)</span>
                                </div>
                                @if (Session.Can(CrmAccess.OpportunitiesWrite))
                                {
                                    <ConfirmAction Disabled="@busy" OnConfirm="() => RemoveAsync(ContactsPath, link.Id, link.Version)">@Texts.Get("crm.opp.remove")</ConfirmAction>
                                }
                            </li>
                        }
                    </ul>
                }
                </ChildContent>
            </FormSection>

            </div>
            }

            @if (tabs.Rendered(TabCompetitors))
            {
            <div role="tabpanel" id="tabpanel-@TabCompetitors" aria-labelledby="tab-@TabCompetitors" class="record-tabpanel" hidden="@tabs.Hidden(TabCompetitors)">
            <FormSection Title="@Texts.Get("crm.opp.competitors")" Icon="shield">
                <Actions>
                    @if (Session.Can(CrmAccess.OpportunitiesWrite) && !addingCompetitor)
                    {
                        <button type="button" class="btn btn-outline-primary btn-sm" @onclick="() => addingCompetitor = true">@Texts.Get("crm.opp.addCompetitor")</button>
                    }
                </Actions>
                <ChildContent>
                @if (addingCompetitor)
                {
                    <div class="inline-form">
                        <label class="form-label" for="cp-name">@Texts.Get("crm.person.firstName")</label>
                        <input id="cp-name" class="form-control" maxlength="200" @bind="competitorName" />
                        <label class="form-label" for="cp-strengths">@Texts.Get("crm.opp.strengths")</label>
                        <textarea id="cp-strengths" class="form-control" rows="2" maxlength="4000" @bind="strengths"></textarea>
                        <label class="form-label" for="cp-weaknesses">@Texts.Get("crm.opp.weaknesses")</label>
                        <textarea id="cp-weaknesses" class="form-control" rows="2" maxlength="4000" @bind="weaknesses"></textarea>
                        @if (ShowAmounts)
                        {
                            <label class="form-label" for="cp-amount">@Texts.Get("crm.opp.altAmount")</label>
                            <input id="cp-amount" class="form-control" type="number" min="0" step="0.01" inputmode="decimal" @bind="altAmount" />
                            <label class="form-label" for="cp-currency">@Texts.Get("crm.lead.convertPanel.currency")</label>
                            <input id="cp-currency" class="form-control" maxlength="3" @bind="altCurrency" />
                        }
                        <button type="button" class="btn btn-primary" disabled="@(busy || string.IsNullOrWhiteSpace(competitorName))" @onclick="AddCompetitorAsync">@Texts.Get("common.add")</button>
                        <button type="button" class="btn btn-outline-secondary" @onclick="() => addingCompetitor = false">@Texts.Get("common.dismiss")</button>
                    </div>
                }
                @if (competitors is null)
                {
                    <LoadingState />
                }
                else if (competitors.Count == 0)
                {
                    <p class="text-muted">@Texts.Get("crm.opp.noCompetitors")</p>
                }
                else
                {
                    <ul class="item-list">
                        @foreach (var c in competitors)
                        {
                            <li>
                                <div class="item-main">
                                    <strong>@c.Name</strong>@(opportunity.WinningCompetitorId == c.Id ? $" · {Texts.Get("crm.opp.winnerLower")}" : null)
                                    <span class="text-muted">
                                        @(c.Strengths is { } s ? Texts.Get("crm.opp.strengthsLine", s) : null)
                                        @(c.Weaknesses is { } w ? $" · {Texts.Get("crm.opp.weaknessesLine", w)}" : null)
                                        @(c.AlternativeAmount is { } alt && c.AlternativeCurrency is { } cur && ShowAmounts ? $" · {Texts.Get("crm.opp.altLine", CrmLabels.Amount(alt, cur))}" : null)
                                    </span>
                                </div>
                                @if (Session.Can(CrmAccess.OpportunitiesWrite))
                                {
                                    <ConfirmAction Disabled="@busy" OnConfirm="() => RemoveAsync(CompetitorsPath, c.Id, c.Version)">@Texts.Get("crm.opp.remove")</ConfirmAction>
                                }
                            </li>
                        }
                    </ul>
                }
                </ChildContent>
            </FormSection>

            </div>
            }

            @if (tabs.Rendered(TabQuotes))
            {
            <div role="tabpanel" id="tabpanel-@TabQuotes" aria-labelledby="tab-@TabQuotes" class="record-tabpanel" hidden="@tabs.Hidden(TabQuotes)">
            <FormSection Title="@Texts.Get("crm.quotes.title")" Icon="file-text">
                <Actions>
                    @if (Session.Can(CrmAccess.QuotesWrite) && opportunity.Status == OpportunityStatus.Open)
                    {
                        <a class="btn btn-outline-primary btn-sm" href="crm/teklifler/yeni?opportunityId=@Id&companyId=@opportunity.CompanyId">@Texts.Get("crm.opp.newQuote")</a>
                    }
                </Actions>
                <ChildContent>
                @if (!Session.Can(CrmAccess.QuotesRead))
                {
                    <p class="text-muted">@Texts.Get("crm.opp.noQuotePermission")</p>
                }
                else if (quotes is null)
                {
                    <LoadingState />
                }
                else if (quotes.Count == 0)
                {
                    <p class="text-muted">@Texts.Get("crm.opp.noQuotes")</p>
                }
                else
                {
                    <p class="text-muted small">
                        @Texts.Get("crm.opp.primaryHelp")
                        @(opportunity.PrimaryQuoteId is null ? Texts.Get("crm.opp.noPrimary") : null)
                    </p>
                    <Notice Text="@quoteNotice" Failed="@quoteNoticeFailed" />
                    <table class="table record-table">
                        <caption class="visually-hidden">@Texts.Get("crm.opp.quotesCaption")</caption>
                        <thead><tr><th scope="col">@Texts.Get("crm.opp.quote.quote")</th><th scope="col">@Texts.Get("common.field.status")</th><th scope="col" class="text-end">@Texts.Get("crm.opp.quote.net")</th><th scope="col">@Texts.Get("crm.opp.quote.validity")</th><th scope="col">@Texts.Get("crm.opp.quote.primary")</th><th scope="col"></th></tr></thead>
                        <tbody>
                            @foreach (var quote in quotes)
                            {
                                var isPrimary = quote.Id == opportunity.PrimaryQuoteId;
                                <tr>
                                    <td data-label="@Texts.Get("crm.opp.quote.quote")" class="primary"><a href="crm/teklifler/@quote.Id">@quote.Title</a> <small class="text-muted">@quote.QuoteNumber · V@(quote.RevisionNo)</small></td>
                                    <td data-label="@Texts.Get("common.field.status")"><span class="badge stage-@QuoteLabels.StatusBadge(quote.Status)">@QuoteLabels.Label(QuoteLabels.Statuses, quote.Status)</span></td>
                                    <td data-label="@Texts.Get("crm.opp.quote.net")" class="text-end">@QuoteLabels.Money(quote.NetTotal, quote.Currency)</td>
                                    <td data-label="@Texts.Get("crm.opp.quote.validity")">@(quote.ValidUntil is { } until ? CrmLabels.Time(until) : "—")</td>
                                    <td data-label="@Texts.Get("crm.opp.quote.primary")">@(isPrimary ? Texts.Get("crm.opp.primaryQuote") : "—")</td>
                                    <td class="actions">
                                        @if (Session.Can(CrmAccess.OpportunitiesWrite) && !isPrimary && quote.Status is "Presented" or "Accepted")
                                        {
                                            <button type="button" class="btn btn-outline-primary btn-sm" disabled="@busy" @onclick="() => SetPrimaryAsync(quote.Id)">@Texts.Get("crm.opp.makePrimary")</button>
                                        }
                                        else if (Session.Can(CrmAccess.OpportunitiesWrite) && isPrimary)
                                        {
                                            <button type="button" class="btn btn-link btn-sm" disabled="@busy" @onclick="() => SetPrimaryAsync(null)">@Texts.Get("crm.opp.removePrimary")</button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                </ChildContent>
            </FormSection>

            <RelatedContracts Title="@Texts.Get("crm.company.contracts")" SourceOpportunityId="Id" />
            <RelatedOrders Title="@Texts.Get("crm.company.orders")" SourceOpportunityId="Id" />

            </div>
            }

            @if (tabs.Rendered(TabHistory))
            {
            <div role="tabpanel" id="tabpanel-@TabHistory" aria-labelledby="tab-@TabHistory" class="record-tabpanel" hidden="@tabs.Hidden(TabHistory)">
            <FormSection Title="@Texts.Get("crm.opp.history")" Icon="history">
                @if (history is null)
                {
                    <LoadingState Kind="LoadingKind.Table" />
                }
                else
                {
                    <table class="table record-table">
                        <thead><tr><th>@Texts.Get("crm.opp.history.time")</th><th>@Texts.Get("crm.company.editor.kind")</th><th>@Texts.Get("crm.opp.history.change")</th><th>@Texts.Get("crm.opp.history.cycle")</th><th>@Texts.Get("crm.opp.history.user")</th><th>@Texts.Get("crm.opp.history.reason")</th></tr></thead>
                        <tbody>
                            @foreach (var h in history.OrderByDescending(x => x.At))
                            {
                                <tr>
                                    <td data-label="@Texts.Get("crm.opp.history.time")">@CrmLabels.Time(h.At)</td>
                                    <td data-label="@Texts.Get("crm.company.editor.kind")">@HistoryKind(h.Kind)</td>
                                    <td data-label="@Texts.Get("crm.opp.history.change")">@HistoryChange(h)</td>
                                    <td data-label="@Texts.Get("crm.opp.history.cycle")">@h.Cycle</td>
                                    <td data-label="@Texts.Get("crm.opp.history.user")">@Lookups.MemberName(h.ChangedBy)</td>
                                    <td data-label="@Texts.Get("crm.opp.history.reason")">@h.Reason</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </FormSection>

            <RecordHistory EntityKey="@CrmEntityKeys.Opportunity" RecordId="Id" Version="opportunity.Version" />
            </div>
            }
            </div>

            <aside class="detail-side" aria-label="@Texts.Get("crm.opp.side.aria")">
                <RecordApprovalPanel EntityKey="@CrmEntityKeys.Opportunity" RecordId="Id" />
                <FormSection Title="@Texts.Get("crm.opp.timeline")" Icon="calendar" Class="side-card">
                    <Actions>
                        @if (Session.Can(CrmAccess.ActivitiesWrite) && opportunity.Status is OpportunityStatus.Open or OpportunityStatus.OnHold)
                        {
                            <button type="button" class="btn btn-outline-primary btn-sm" @onclick="() => addingActivity = true"><span aria-hidden="true">+</span> @Texts.Get("crm.company.acts.add")</button>
                        }
                    </Actions>
                    <ChildContent>
                    @if (activities is null)
                    {
                        <LoadingState />
                    }
                    else if (activities.Count == 0)
                    {
                        <p class="text-muted">@Texts.Get("crm.opp.noActivities")</p>
                    }
                    else
                    {
                        var nextPlanned = activities.Where(a => ActivityStatus.IsOpen(a.Status) && a.DueAt is not null).OrderBy(a => a.DueAt).FirstOrDefault();
                        var lastDone = activities.Where(a => a.CompletedAt is not null).OrderByDescending(a => a.CompletedAt).FirstOrDefault();
                        <dl class="timeline-summary">
                            <div><dt>@Texts.Get("crm.lead.acts.lastDone")</dt><dd>@(lastDone is null ? Texts.Get("common.noneLower") : $"{lastDone.Subject} · {CrmLabels.Time(lastDone.CompletedAt!.Value)}")</dd></div>
                            <div><dt>@Texts.Get("crm.lead.acts.nextPlanned")</dt><dd>@(nextPlanned is null ? Texts.Get("common.noneLower") : $"{nextPlanned.Subject} · {CrmLabels.Time(nextPlanned.DueAt!.Value)}")</dd></div>
                        </dl>
                        <ol class="activity-timeline">
                            @foreach (var a in activities.OrderByDescending(x => x.CompletedAt ?? x.DueAt ?? DateTimeOffset.MaxValue))
                            {
                                var family = ActivityLabels.Family(Lookups, a.Type);
                                <li class="timeline-item fam-@family @ActivityLabels.Css(a)">
                                    <span class="timeline-icon" aria-hidden="true"><AppIcon Name="@ActivityLabels.Icon(family)" Size="16" /></span>
                                    <div class="timeline-body">
                                        <strong>@a.Subject</strong>
                                        <span class="timeline-meta">@Lookups.Label(CrmLists.ActivityType, a.Type) · @Lookups.MemberName(a.OwnerId)</span>
                                        <span class="timeline-meta">
                                            @(a.CompletedAt is { } done ? Texts.Get("crm.lead.acts.completedAt", CrmLabels.Time(done)) : a.DueAt is { } d ? Texts.Get("crm.lead.acts.plannedAt", CrmLabels.Time(d)) : Texts.Get("crm.lead.acts.undated"))
                                        </span>
                                        @if (a.IsOverdue(DateTimeOffset.UtcNow)) { <span class="badge stage-lost">@Texts.Get("crm.lead.acts.overdue")</span> }
                                    </div>
                                </li>
                            }
                        </ol>
                    }
                    @if (OpportunityStatus.IsClosed(opportunity.Status))
                    {
                        <p class="text-muted small">@Texts.Get("crm.opp.closedActivitiesNote")</p>
                    }
                    </ChildContent>
                </FormSection>

                @if (ShowAmounts && Session.Can(CrmAccess.QuotesRead))
                {
                    <FormSection Title="@Texts.Get("crm.opp.finance")" Icon="wallet" Class="side-card">
                        @if (PrimaryQuote is { } pq)
                        {
                            <p class="text-muted small">@Texts.Get("crm.opp.primaryQuoteLabel") <a href="crm/teklifler/@pq.Id">@pq.QuoteNumber · V@(pq.RevisionNo)</a></p>
                            <dl class="finance-list">
                                <div><dt>@Texts.Get("crm.opp.finance.list")</dt><dd>@QuoteLabels.Money(pq.ListTotal, pq.Currency)</dd></div>
                                <div><dt>@Texts.Get("crm.opp.line.discount")</dt><dd>−@(QuoteLabels.Money(pq.DiscountTotal, pq.Currency))</dd></div>
                                <div><dt>@Texts.Get("crm.opp.finance.net")</dt><dd>@QuoteLabels.Money(pq.NetTotal, pq.Currency)</dd></div>
                                <div><dt>@Texts.Get("crm.opp.line.tax")</dt><dd>@QuoteLabels.Money(pq.TaxTotal, pq.Currency)</dd></div>
                                <div class="finance-total"><dt>@Texts.Get("crm.opp.finance.gross")</dt><dd>@QuoteLabels.Money(pq.GrossTotal, pq.Currency)</dd></div>
                            </dl>
                        }
                        else
                        {
                            <p class="text-muted small">@Texts.Get("crm.opp.noPrimaryManual")</p>
                            <dl class="finance-list">
                                <div class="finance-total"><dt>@Texts.Get("crm.opp.kpi.amount")</dt><dd>@(opportunity.Amount is { } manual ? CrmLabels.Amount(manual, opportunity.Currency) : Texts.Get("crm.lead.unknown"))</dd></div>
                            </dl>
                        }
                    </FormSection>
                }
            </aside>
        </div>

        <Drawer Open="addingActivity" Label="@Texts.Get("crm.activities.new")" OnClose="() => addingActivity = false">
            <ActivityEditor Lookups="Lookups" FixedCompanyId="opportunity.CompanyId" FixedOpportunityId="Id" Saved="ActivitySavedAsync" Cancelled="() => addingActivity = false" />
        </Drawer>
    }
</AuthGate>

@code {
    private OpportunityDto? opportunity;
    private IReadOnlyList<OpportunityContactDto>? contacts;
    private IReadOnlyList<OpportunityCompetitorDto>? competitors;
    private IReadOnlyList<ActivityDto>? activities;
    private IReadOnlyList<QuoteDto>? quotes;
    private IReadOnlyList<QuoteLineDto>? primaryLines;
    private ElementReference panelFirst;
    private bool focusPanel;
    private string? quoteNotice;
    private bool quoteNoticeFailed;
    private IReadOnlyList<OpportunityHistoryDto>? history;

    // Sekmeler (docs/design-system/form-standards.md → Sekmeler): Genel bilgiler, Kişiler, Rakipler, Teklifler, Geçmiş.
    private const string TabGeneral = "genel";
    private const string TabContacts = "kisiler";
    private const string TabCompetitors = "rakipler";
    private const string TabQuotes = "teklifler";
    private const string TabHistory = "gecmis";
    private readonly TabState tabs = new(TabGeneral);

    /// <summary>Teklif izni yoksa Teklifler sekmesi hiç eklenmez (sunucu yine denetler); sayılar yüklenen listelerden gelir.</summary>
    private IReadOnlyList<TabItem> OpportunityTabs
    {
        get
        {
            List<TabItem> list = [new(TabGeneral, Texts.Get("crm.company.general")), new(TabContacts, Texts.Get("crm.contacts.title"), contacts?.Count), new(TabCompetitors, Texts.Get("crm.opp.competitors"), competitors?.Count)];
            if (Session.Can(CrmAccess.QuotesRead))
            {
                list.Add(new(TabQuotes, Texts.Get("crm.quotes.title"), quotes?.Count));
            }

            list.Add(new(TabHistory, Texts.Get("common.history.tab")));
            return list;
        }
    }
    private IReadOnlyDictionary<string, string[]>? actionErrors;
    private string? message;
    private string? notice;
    private string? panel;
    private string? note;
    private string? handover;
    private string stage = string.Empty;
    private string lossReason = string.Empty;
    private string wonCurrency = Regional.Currency;
    private decimal? wonAmount;
    private DateOnly? closeDate;
    private DateOnly? reviewDate;
    private int? reopenProbability;
    private string winnerId = string.Empty;
    private bool followUp;
    private bool editing;
    private bool addingContact;
    private bool addingCompetitor;
    private bool addingActivity;
    private bool busy;
    private int staleDays = 30;

    private Guid? newContact;
    private bool newPrimary;
    private readonly HashSet<string> newRoles = [];
    private string competitorName = string.Empty;
    private string? strengths;
    private string? weaknesses;
    private decimal? altAmount;
    private string altCurrency = Regional.Currency;

    private static class Panel
    {
        public const string Stage = "stage";
        public const string Hold = "hold";
        public const string Win = "win";
        public const string Lose = "lose";
        public const string Cancel = "cancel";
        public const string Reopen = "reopen";
    }

    private const string ContactsPath = "opportunity-contacts";
    private const string CompetitorsPath = "opportunity-competitors";

    [Parameter] public Guid Id { get; set; }

    private static DateOnly Today => DateOnly.FromDateTime(DateTime.UtcNow);

    private bool ShowAmounts => Session.Can(CrmAccess.OpportunityAmountsRead);

    // Aşama/bekletme ve kapatma ayrı izinlerdir; yazma izni de kabul edilir (sunucu aynı kuralı uygular). Yeniden açma yalnızca kendi iziyle.
    private bool CanStage => Session.Can(CrmAccess.OpportunitiesChangeStage) || Session.Can(CrmAccess.OpportunitiesWrite);

    private bool CanClose => Session.Can(CrmAccess.OpportunitiesClose) || Session.Can(CrmAccess.OpportunitiesWrite);

    private bool CanReopen => Session.Can(CrmAccess.OpportunitiesReopen);

    private bool AnyAction => opportunity is not null && (opportunity.Status switch
    {
        OpportunityStatus.Open => CanStage || CanClose,
        OpportunityStatus.OnHold => CanStage,
        _ => CanReopen,
    });

    private decimal? Weighted => opportunity is { Amount: { } a, Probability: { } p } ? decimal.Round(a * p / 100m, 2, MidpointRounding.AwayFromZero) : null;

    private int? InactiveDays
    {
        get
        {
            var since = opportunity?.LastInteractionAt ?? history?.FirstOrDefault()?.At;
            return since is { } at && (DateTimeOffset.UtcNow - at).TotalDays >= staleDays ? (int)(DateTimeOffset.UtcNow - at).TotalDays : null;
        }
    }

    private QuoteDto? PrimaryQuote => opportunity?.PrimaryQuoteId is { } primaryId ? quotes?.FirstOrDefault(q => q.Id == primaryId) : null;

    /// <summary>Huni aşamaları: tenant'ın aşama listesi (sıra ve kategori yönetici ayarı), pasifler hariç, güncel aşama dahil.</summary>
    private IReadOnlyList<Modulix.Shared.Customization.ChoiceValueDto> PipelineStages =>
        opportunity is null ? [] : Lookups.Choices(CrmLists.OpportunityStage, opportunity.Stage).ToList();

    private int? StageDays => opportunity?.StageEnteredAt is { } entered ? (int)(DateTimeOffset.UtcNow - entered).TotalDays : null;

    /// <summary>Hunide bir aşama seçildi: aşamayı doğrudan değiştirmez, ilgili işlem panelini açar (doğrulama oradan çalışır).</summary>
    private void ChooseStage(Modulix.Shared.Customization.ChoiceValueDto step)
    {
        var category = step.Category ?? CrmLists.StageCategories.Open;
        var target = category == CrmLists.StageCategories.Won ? Panel.Win : category == CrmLists.StageCategories.Lost ? Panel.Lose : Panel.Stage;
        if (panel != target)
        {
            Toggle(target);
        }

        if (target == Panel.Stage)
        {
            stage = step.Key;
        }

        focusPanel = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusPanel && panel is not null)
        {
            focusPanel = false;
            try
            {
                await panelFirst.FocusAsync();
            }
            catch (InvalidOperationException)
            {
                // Panelin ilk alanı henüz çizilmediyse odak taşınmaz.
            }
        }
    }

    private bool HasNeedAnalysis => opportunity?.ServiceScope is { Count: > 0 } || NeedFields.Any(f => !string.IsNullOrWhiteSpace(f.Text));

    private IEnumerable<(string Label, string? Text)> NeedFields =>
    [
        (Texts.Get("crm.lead.need"), opportunity?.NeedDescription), (Texts.Get("crm.opp.currentProblem"), opportunity?.CurrentProblem), (Texts.Get("crm.opp.expectedBenefit"), opportunity?.ExpectedBenefit),
        (Texts.Get("crm.opp.scope"), opportunity?.Scope), (Texts.Get("crm.opp.successCriteria"), opportunity?.SuccessCriteria), (Texts.Get("crm.opp.risks"), opportunity?.Risks),
        (Texts.Get("crm.opp.decisionProcess"), opportunity?.DecisionProcess),
    ];

    protected override async Task OnParametersSetAsync()
    {
        await Session.EnsureLoadedAsync();
        if (!Session.Can(CrmAccess.OpportunitiesRead))
        {
            return;
        }

        await Lookups.LoadAsync(contacts: true);
        await ActivityNames.LoadAsync();
        staleDays = (await Api.GetAsync<OpportunitySettingsDto>("/api/crm/opportunities/settings")).Value?.StaleDays ?? 30;
        await LoadAsync();
    }

    private IEnumerable<Modulix.Shared.Customization.ChoiceValueDto> OpenStages(string? current) =>
        Lookups.Choices(CrmLists.OpportunityStage, current).Where(s => s.Category == CrmLists.StageCategories.Open);

    private void Toggle(string name)
    {
        panel = panel == name ? null : name;
        note = null;
        stage = opportunity is null ? string.Empty : panel == Panel.Reopen ? OpenStages(null).FirstOrDefault()?.Key ?? string.Empty : opportunity.Stage;
    }

    private async Task LoadAsync()
    {
        var result = await Api.GetAsync<OpportunityDto>($"/api/crm/opportunities/{Id}");
        opportunity = result.Value;
        message = result.Error;
        if (opportunity is null)
        {
            return;
        }

        stage = opportunity.Stage;
        contacts = (await Api.GetAsync<CrmPage<OpportunityContactDto>>($"/api/crm/opportunity-contacts?opportunityId={Id}&pageSize=100")).Value?.Items ?? [];
        competitors = (await Api.GetAsync<CrmPage<OpportunityCompetitorDto>>($"/api/crm/opportunity-competitors?opportunityId={Id}&pageSize=100")).Value?.Items ?? [];
        history = (await Api.GetAsync<List<OpportunityHistoryDto>>($"/api/crm/opportunities/{Id}/history")).Value ?? [];
        activities = Session.Can(CrmAccess.ActivitiesRead)
            ? (await Api.GetAsync<CrmPage<ActivityDto>>($"/api/crm/activities?opportunityId={Id}&pageSize=100")).Value?.Items ?? []
            : [];
        quotes = Session.Can(CrmAccess.QuotesRead)
            ? (await Api.GetAsync<CrmPage<QuoteDto>>($"/api/crm/quotes?opportunityId={Id}&pageSize=100")).Value?.Items ?? []
            : [];
        primaryLines = opportunity.PrimaryQuoteId is { } primaryQuoteId && Session.Can(CrmAccess.QuotesRead)
            ? (await Api.GetAllAsync<QuoteLineDto>($"/api/crm/quote-lines?quoteId={primaryQuoteId}")).Items
            : null;
    }

    private async Task SetPrimaryAsync(Guid? quoteId)
    {
        if (busy || opportunity is null) { return; }
        busy = true;
        var result = await Api.PostAsync<OpportunityDto>($"/api/crm/opportunities/{Id}/primary-quote", new SetPrimaryQuoteRequest(opportunity.Version, quoteId));
        busy = false;
        quoteNotice = result.IsSuccess ? Texts.Get(quoteId is null ? "crm.opp.primaryRemoved" : "crm.opp.primaryUpdated") : result.Error;
        quoteNoticeFailed = !result.IsSuccess;
        await LoadAsync();
    }

    private async Task RunAsync(string action, object body)
    {
        busy = true;
        message = null;
        notice = null;
        actionErrors = null;
        var result = await Api.PostAsync<OpportunityActionResultDto>($"/api/crm/opportunities/{Id}/{action}", body);
        busy = false;
        if (result.IsSuccess)
        {
            panel = null;
            note = null;
            handover = null;
            lossReason = string.Empty;
            followUp = false;
            reviewDate = null;
            notice = ActionNotice(result.Value!);
            await LoadAsync();
            return;
        }

        message = result.Error;
        actionErrors = result.FieldErrors;
    }

    private static string? ActionNotice(OpportunityActionResultDto result)
    {
        var parts = new List<string>();
        if (result.OpenActivities > 0)
        {
            parts.Add(Texts.Get("crm.opp.openActivities", result.OpenActivities));
        }

        if (result.FollowUpWarning is not null)
        {
            parts.Add(result.FollowUpWarning);
        }

        return parts.Count == 0 ? null : string.Join(' ', parts);
    }

    private Task ChangeStageAsync() => RunAsync("stage", new ChangeOpportunityStageRequest(opportunity!.Version, stage, note));

    private Task HoldAsync() => RunAsync("hold", new HoldOpportunityRequest(opportunity!.Version, note ?? string.Empty, reviewDate ?? default));

    private Task ResumeAsync() => RunAsync("resume", new ResumeOpportunityRequest(opportunity!.Version));

    private Task WinAsync() => RunAsync("win", new WinOpportunityRequestDto(
        opportunity!.Version, closeDate, ShowAmounts ? wonAmount : null, ShowAmounts && wonAmount is not null ? wonCurrency : null, note, handover));

    private Task LoseAsync() => RunAsync("lose", new LoseOpportunityRequestDto(
        opportunity!.Version, lossReason, note, Guid.TryParse(winnerId, out var winner) ? winner : null, reviewDate, followUp && reviewDate is not null));

    private Task CancelAsync() => RunAsync("cancel", new CancelOpportunityRequest(opportunity!.Version, note ?? string.Empty));

    private Task ReopenAsync() => RunAsync("reopen", new ReopenOpportunityRequestDto(
        opportunity!.Version, note ?? string.Empty, stage, reviewDate ?? default, ShowAmounts ? reopenProbability : null));

    private void ToggleRole(string role, bool on)
    {
        if (on) { newRoles.Add(role); } else { newRoles.Remove(role); }
    }

    private async Task AddContactAsync()
    {
        busy = true;
        message = null;
        var result = await Api.PostAsync<OpportunityContactDto>("/api/crm/opportunity-contacts",
            new SaveOpportunityContactRequest(Id, newContact!.Value, [.. newRoles], newPrimary));
        busy = false;
        if (result.IsSuccess)
        {
            addingContact = false;
            newContact = null;
            newRoles.Clear();
            newPrimary = false;
            await LoadAsync();
            return;
        }

        message = string.Join(" ", result.FieldErrors.Values.SelectMany(v => v).Prepend(result.Error ?? string.Empty).Where(m => m.Length > 0).Distinct());
    }

    private async Task AddCompetitorAsync()
    {
        busy = true;
        message = null;
        var result = await Api.PostAsync<OpportunityCompetitorDto>("/api/crm/opportunity-competitors", new SaveOpportunityCompetitorRequest(
            Id, competitorName, strengths, weaknesses, ShowAmounts ? altAmount : null, ShowAmounts && altAmount is not null ? altCurrency : null));
        busy = false;
        if (result.IsSuccess)
        {
            addingCompetitor = false;
            competitorName = string.Empty;
            strengths = weaknesses = null;
            altAmount = null;
            await LoadAsync();
            return;
        }

        message = string.Join(" ", result.FieldErrors.Values.SelectMany(v => v).Prepend(result.Error ?? string.Empty).Where(m => m.Length > 0).Distinct());
    }

    private async Task RemoveAsync(string path, Guid id, long version)
    {
        busy = true;
        var result = await Api.DeleteAsync($"/api/crm/{path}/{id}?version={version}");
        busy = false;
        message = result.Error;
        await LoadAsync();
    }

    private async Task ActivitySavedAsync(ActivityDto saved)
    {
        addingActivity = false;
        await LoadAsync();
    }

    private async Task SavedAsync(OpportunityDto saved)
    {
        editing = false;
        await LoadAsync();
    }

    private Task DeletedAsync()
    {
        opportunity = null;
        editing = false;
        message = Texts.Get("crm.opp.deleted");
        return Task.CompletedTask;
    }

    private static string HistoryKind(string kind) => kind switch
    {
        "Created" => Texts.Get("crm.opp.history.created"),
        "Stage" => Texts.Get("crm.opportunities.col.stage"),
        "Status" => Texts.Get("common.field.status"),
        "CloseDate" => Texts.Get("crm.opp.history.closeDate"),
        _ => kind,
    };

    private string HistoryChange(OpportunityHistoryDto h) => h.Kind switch
    {
        "CloseDate" => $"{(h.FromCloseDate is { } f ? CrmLabels.Date(f) : "—")} → {(h.ToCloseDate is { } t ? CrmLabels.Date(t) : "—")}",
        "Created" => $"{Lookups.Label(CrmLists.OpportunityStage, h.ToStage)} ({CrmText.OpportunityStatusName(h.ToStatus ?? OpportunityStatus.Open)})",
        "Status" => $"{CrmText.OpportunityStatusName(h.FromStatus ?? string.Empty)} → {CrmText.OpportunityStatusName(h.ToStatus ?? string.Empty)} · {Lookups.Label(CrmLists.OpportunityStage, h.ToStage)}",
        _ => $"{Lookups.Label(CrmLists.OpportunityStage, h.FromStage)} → {Lookups.Label(CrmLists.OpportunityStage, h.ToStage)}",
    };
}
