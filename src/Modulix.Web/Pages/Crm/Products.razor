@page "/crm/urunler"
@inject ApiClient Api
@inject SessionState Session

<PageTitle>@Texts.Get("crm.products.title") · Modulix</PageTitle>

<AuthGate Module="@CrmAccess.ModuleKey" Permission="@CrmAccess.ProductsRead">
    <div class="page-header">
        <h1>@Texts.Get("crm.products.title")</h1>
    </div>

    <p class="text-muted">
        <a href="crm/urun-kategorileri">@Texts.Get("crm.products.link.categories")</a> · <a href="crm/birimler">@Texts.Get("crm.products.link.units")</a> · <a href="crm/fiyat-listeleri">@Texts.Get("crm.priceLists.title")</a> · <a href="crm/vergi-kur">@Texts.Get("crm.products.link.taxRates")</a> · <a href="crm/indirimler">@Texts.Get("crm.products.link.discounts")</a> · <a href="crm/fiyat-hesapla">@Texts.Get("crm.priceCalculator.title")</a>    </p>

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }

    @if (form is not null)
    {
        <div class="record-form">
            <h2>@(form.Id is null ? Texts.Get("crm.products.new") : Texts.Get("crm.products.edit"))</h2>
            <TabBar Tabs="FormTabs" State="tabs" Label="@Texts.Get("crm.products.formSections")" Changed="_ => { }" />
            <form novalidate @onsubmit="SaveAsync" @onsubmit:preventDefault hidden="@(tabs.Active == PackageTab)">
                <TabPanel State="tabs" Key="form-genel">
                    <div class="form-grid">
                        <div>
                            <label class="form-label" for="code">@Texts.Get("crm.products.field.code")</label>
                            <input id="code" class="form-control" maxlength="50" @bind="form.Code" />
                            <FieldError Field="code" Errors="errors" />
                        </div>
                        <div>
                            <label class="form-label" for="name">@Texts.Get("common.field.nameRequired")</label>
                            <input id="name" class="form-control" maxlength="200" @bind="form.Name" />
                            <FieldError Field="name" Errors="errors" />
                        </div>
                        <div>
                            <label class="form-label" for="kind">@Texts.Get("common.field.kind")</label>
                            <select id="kind" class="form-select" @bind="form.Kind">
                                @foreach (var kind in CatalogLabels.Kinds)
                                {
                                    <option value="@kind.Key">@kind.Label</option>
                                }
                            </select>
                            <FieldError Field="kind" Errors="errors" />
                        </div>
                        <div>
                            <label class="form-label" for="status">@Texts.Get("common.field.status")</label>
                            <select id="status" class="form-select" @bind="form.Status">
                                @foreach (var status in CatalogLabels.Statuses)
                                {
                                    <option value="@status.Key">@status.Label</option>
                                }
                            </select>
                            <FieldError Field="status" Errors="errors" />
                        </div>
                        <div>
                            <label class="form-label" for="category">@Texts.Get("crm.products.field.category")</label>
                            <select id="category" class="form-select" @bind="form.CategoryId">
                                <option value="">—</option>
                                @foreach (var category in categories)
                                {
                                    <option value="@category.Id">@category.Name</option>
                                }
                            </select>
                            <FieldError Field="categoryId" Errors="errors" />
                        </div>
                        <div>
                            <label class="form-label" for="unit">@Texts.Get("crm.products.field.baseUnit")</label>
                            <select id="unit" class="form-select" @bind="form.BaseUnitId">
                                <option value="@Guid.Empty">—</option>
                                @foreach (var unit in units)
                                {
                                    <option value="@unit.Id">@unit.Code — @unit.Name</option>
                                }
                            </select>
                            <FieldError Field="baseUnitId" Errors="errors" />
                        </div>
                        <div>
                            <label class="form-label" for="precision">@Texts.Get("crm.products.field.precision")</label>
                            <input id="precision" class="form-control" type="number" min="0" max="4" @bind="form.QuantityPrecision" />
                            <FieldError Field="quantityPrecision" Errors="errors" />
                        </div>
                    </div>
                </TabPanel>
                <TabPanel State="tabs" Key="form-fiyat">
                    <div class="form-grid">
                        <div>
                            <label class="form-label" for="taxCategory">@Texts.Get("crm.products.field.taxCategory")</label>
                            <input id="taxCategory" class="form-control" maxlength="30" @bind="form.TaxCategory" />
                            <FieldError Field="taxCategory" Errors="errors" />
                        </div>
                        <div>
                            <label class="form-label" for="includesTax">@Texts.Get("crm.products.field.prices")</label>
                            <select id="includesTax" class="form-select" @bind="form.PriceIncludesTax">
                                <option value="False">@Texts.Get("crm.products.taxExcluded")</option>
                                <option value="True">@Texts.Get("crm.products.taxIncluded")</option>
                            </select>
                        </div>
                        <div>
                            <label class="form-label" for="chargeType">@Texts.Get("crm.products.field.chargeType")</label>
                            <select id="chargeType" class="form-select" @bind="form.ChargeType">
                                @foreach (var charge in CatalogLabels.ChargeTypes)
                                {
                                    <option value="@charge.Key">@charge.Label</option>
                                }
                            </select>
                            <FieldError Field="chargeType" Errors="errors" />
                        </div>
                        @if (form.ChargeType == "Recurring")
                        {
                            <div>
                                <label class="form-label" for="period">@Texts.Get("crm.products.field.period")</label>
                                <select id="period" class="form-select" @bind="form.RecurringPeriod">
                                    <option value="">—</option>
                                    @foreach (var period in CatalogLabels.RecurringPeriods)
                                    {
                                        <option value="@period.Key">@period.Label</option>
                                    }
                                </select>
                                <FieldError Field="recurringPeriod" Errors="errors" />
                            </div>
                        }
                        <div>
                            <label class="form-label" for="saleStart">@Texts.Get("crm.products.field.saleStart")</label>
                            <input id="saleStart" class="form-control" type="date" @bind="form.SaleStart" />
                            <FieldError Field="saleStart" Errors="errors" />
                        </div>
                        <div>
                            <label class="form-label" for="saleEnd">@Texts.Get("crm.products.field.saleEnd")</label>
                            <input id="saleEnd" class="form-control" type="date" @bind="form.SaleEnd" />
                            <FieldError Field="saleEnd" Errors="errors" />
                        </div>
                        @if (Session.Can(CrmAccess.ProductCostsRead))
                        {
                            <div>
                                <label class="form-label" for="cost">@Texts.Get("crm.products.field.cost")</label>
                                <input id="cost" class="form-control" type="number" step="any" min="0" @bind="form.Cost" />
                                <FieldError Field="cost" Errors="errors" />
                            </div>
                            <div>
                                <label class="form-label" for="costCurrency">@Texts.Get("crm.products.field.costCurrency")</label>
                                <input id="costCurrency" class="form-control" maxlength="3" @bind="form.CostCurrency" />
                                <FieldError Field="costCurrency" Errors="errors" />
                            </div>
                        }
                    </div>
                </TabPanel>
                <TabPanel State="tabs" Key="form-detay">
                    <div class="form-grid">
                        @if (form.Kind == "Service")
                        {
                            <div>
                                <label class="form-label" for="duration">@Texts.Get("crm.products.field.duration")</label>
                                <input id="duration" class="form-control" type="number" min="1" @bind="form.ServiceDurationMinutes" />
                                <FieldError Field="serviceDurationMinutes" Errors="errors" />
                            </div>
                            <div>
                                <label class="form-label" for="delivery">@Texts.Get("crm.products.field.delivery")</label>
                                <select id="delivery" class="form-select" @bind="form.DeliveryMode">
                                    <option value="">—</option>
                                    @foreach (var mode in CatalogLabels.DeliveryModes)
                                    {
                                        <option value="@mode.Key">@mode.Label</option>
                                    }
                                </select>
                                <FieldError Field="deliveryMode" Errors="errors" />
                            </div>
                        }
                        <div>
                            <label class="form-label" for="barcode">@Texts.Get("crm.products.field.barcode")</label>
                            <input id="barcode" class="form-control" maxlength="50" @bind="form.Barcode" />
                            <FieldError Field="barcode" Errors="errors" />
                        </div>
                        <div>
                            <label class="form-label" for="externalCode">@Texts.Get("crm.products.field.externalCode")</label>
                            <input id="externalCode" class="form-control" maxlength="50" @bind="form.ExternalCode" />
                            <FieldError Field="externalCode" Errors="errors" />
                        </div>
                        <div>
                            <label class="form-label" for="brand">@Texts.Get("crm.products.field.brand")</label>
                            <input id="brand" class="form-control" maxlength="100" @bind="form.Brand" />
                            <FieldError Field="brand" Errors="errors" />
                        </div>
                        <div>
                            <label class="form-label" for="model">@Texts.Get("crm.products.field.model")</label>
                            <input id="model" class="form-control" maxlength="100" @bind="form.Model" />
                            <FieldError Field="model" Errors="errors" />
                        </div>
                        <div class="span-all">
                            <label class="form-label" for="tags">@Texts.Get("common.field.tags")</label>
                            <input id="tags" class="form-control" maxlength="500" placeholder="@Texts.Get("crm.products.field.tagsPlaceholder")" @bind="form.Tags" />
                            <FieldError Field="tags" Errors="errors" />
                        </div>
                        <div class="span-all">
                            <label class="form-label" for="description">@Texts.Get("crm.products.field.description")</label>
                            <textarea id="description" class="form-control" rows="3" maxlength="4000" @bind="form.Description"></textarea>
                            <FieldError Field="description" Errors="errors" />
                        </div>
                    </div>
                </TabPanel>
                <div class="form-actions">
                    <button type="submit" class="btn btn-primary" disabled="@busy">@Texts.Get("common.save")</button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="Close">@Texts.Get("common.dismiss")</button>
                    @if (form.Id is not null)
                    {
                        <button type="button" class="btn btn-outline-danger ms-auto" disabled="@busy" @onclick="DeleteAsync">@Texts.Get("common.delete")</button>
                    }
                </div>
            </form>
            @if (form.Id is { } packageId)
            {
                <TabPanel State="tabs" Key="form-paket">
            <h3>@Texts.Get("crm.products.components.title")</h3>
            <p class="text-muted">@Texts.Get("crm.products.components.help")</p>
            @if (components.Count == 0)
            {
                <p class="text-muted">@Texts.Get("crm.products.components.none")</p>
            }
            else
            {
                <table class="table record-table">
                    <thead><tr><th>@Texts.Get("crm.products.components.col.component")</th><th>@Texts.Get("crm.products.components.col.quantity")</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var component in components)
                        {
                            <tr>
                                <td data-label="@Texts.Get("crm.products.components.col.component")" class="primary">@component.ComponentCode — @component.ComponentName</td>
                                <td data-label="@Texts.Get("crm.quoteDetail.col.quantity")">@component.Quantity</td>
                                <td class="actions">
                                    @if (Session.Can(CrmAccess.ProductsWrite))
                                    {
                                        <button type="button" class="btn btn-outline-danger btn-sm" @onclick="() => DeleteComponentAsync(component)">@Texts.Get("common.delete")</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            @if (componentMessage is not null)
            {
                <div class="alert alert-danger" role="alert">@componentMessage</div>
            }

            @if (Session.Can(CrmAccess.ProductsWrite))
            {
                <form class="form-grid" novalidate @onsubmit="() => AddComponentAsync(packageId)" @onsubmit:preventDefault>
                    <div>
                        <label class="form-label" for="componentProduct">@Texts.Get("crm.products.components.product")</label>
                        <select id="componentProduct" class="form-select" @bind="componentForm.ComponentId">
                            <option value="@Guid.Empty">—</option>
                            @foreach (var candidate in allProducts.Where(p => p.Id != packageId))
                            {
                                <option value="@candidate.Id">@candidate.Code — @candidate.Name</option>
                            }
                        </select>
                        <FieldError Field="componentId" Errors="componentErrors" />
                    </div>
                    <div>
                        <label class="form-label" for="componentQty">@Texts.Get("crm.products.components.quantity")</label>
                        <input id="componentQty" class="form-control" type="number" step="any" min="0" @bind="componentForm.Quantity" />
                        <FieldError Field="quantity" Errors="componentErrors" />
                    </div>
                    <div class="form-actions">
                        <button type="submit" class="btn btn-outline-primary" disabled="@busy">@Texts.Get("crm.products.components.add")</button>
                    </div>
                </form>
            }
                </TabPanel>
            }
        </div>
    }

    @* Görünümler sunucuda süzgeç olarak uygulanır (tür); durum süzgeci "Filtrele" satırındadır ve görünümle birlikte kaydedilir. *@
    <ViewTabs Items="ViewOptions" Value="@view" ValueChanged="ChooseViewAsync" Label="@Texts.Get("crm.products.views")" NewView="StartNaming" />

    <div class="list-toolbar">
        <form class="search" @onsubmit="() => LoadAsync(1)" @onsubmit:preventDefault>
            <input class="form-control" type="search" aria-label="@Texts.Get("crm.products.searchLabel")" placeholder="@Texts.Get("crm.products.searchPlaceholder")" @bind="search" />
        </form>
        <FilterToggle @bind-Open="filtersOpen" Count="status is null ? 0 : 1" />
        <GridColumnPicker State="grid" Changed="ColumnsChanged" />
        @if (Session.Can(CrmAccess.ProductsWrite) && form is null)
        {
            <button type="button" class="btn btn-primary" @onclick="New"><AppIcon Name="plus" Size="16" /> @Texts.Get("crm.products.new")</button>
        }
    </div>

    @if (filtersOpen || status is not null)
    {
        <div class="filters">
            <label class="visually-hidden" for="status-filter">@Texts.Get("common.field.status")</label>
            <select id="status-filter" class="form-select form-select-sm filter-select" @bind="statusValue" @bind:after="() => LoadAsync(1)">
                <option value="">@Texts.Get("common.allStatuses")</option>
                @foreach (var s in CatalogLabels.Statuses)
                {
                    <option value="@s.Key">@s.Label</option>
                }
            </select>
        </div>
    }

    <PersonalViewBar Active="Active" Dirty="grid.Differs(Active) || FiltersDiffer" Naming="views.Naming" NamingChanged="views.StartNaming" Error="@views.Error"
                     SaveAs="SaveAsAsync" UpdateView="UpdateViewAsync" DiscardChanges="DiscardAsync" DeleteView="DeleteViewAsync" />

    @if (page is null)
    {
        <p class="text-muted">@Texts.Get("common.loading")</p>
    }
    else if (page.Items.Count == 0)
    {
        <p class="text-muted">@Texts.Get("common.noRecords")</p>
    }
    else
    {
        <table class="table record-table">
            <thead>
                <tr>
                    @foreach (var column in grid.VisibleColumns)
                    {
                        <GridHeader Column="column" State="grid" SortChanged="SortAsync" />
                    }
                    <th scope="col" class="row-menu-cell"><span class="visually-hidden">@Texts.Get("common.actions")</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in page.Items)
                {
                    <tr>
                        @foreach (var column in grid.VisibleColumns)
                        {
                            @Cell(column, product)
                        }
                        <td class="row-menu-cell">
                            @if (Session.Can(CrmAccess.ProductsWrite))
                            {
                                <RowMenu Label="@Texts.Get("common.rowActionsOf", product.Name)">
                                    <button type="button" class="view-menu-item" role="menuitem" @onclick="() => Edit(product)"><AppIcon Name="pencil" Size="16" /> <span>@Texts.Get("common.edit")</span></button>
                                </RowMenu>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager PageSizeChoice="true" Page="page.Page" PageSize="page.PageSize" TotalCount="page.TotalCount" PageChanged="LoadAsync" />
    }
</AuthGate>

@code {
    private const string Url = "/api/crm/products";

    // Sütunların sırası varsayılan sıradır; Birim ve Barkod sunucuda sıralanamaz (ilişkili tablo / sıralama anahtarı yok).
    // Özellik olarak tanımlıdır: başlıklar sınıf yüklenirken değil, sayfa açılırken sözlükten çözülür (ADR-0034).
    private static GridColumnDef[] Columns =>
    [
        new("code", Texts.Get("crm.products.col.code"), "hash", "code", "-code", Locked: true),
        new("name", Texts.Get("common.field.name"), "type", "name", "-name"),
        new("kind", Texts.Get("common.field.kind"), "layers", "kind", "-kind"),
        new("status", Texts.Get("common.field.status"), "tag", "status", "-status"),
        new("category", Texts.Get("crm.products.field.category"), "list", "category", "-category"),
        new("unit", Texts.Get("crm.products.col.unit"), "percent"),
        new("brand", Texts.Get("crm.products.field.brand"), "briefcase", "brand", "-brand", DefaultVisible: false),
        new("tags", Texts.Get("common.field.tags"), "tag", "tags", "-tags", DefaultVisible: false),
        new("barcode", Texts.Get("crm.products.field.barcode"), "hash", DefaultVisible: false),
    ];

    private readonly GridViewState grid = new("crm.products", "code");
    private PersonalGridViews views = default!;
    private string view = AllView;
    private bool filtersOpen;
    private CrmPage<ProductDto>? page;
    private List<ProductCategoryDto> categories = [];
    private List<MeasureUnitDto> units = [];
    private ProductForm? form;

    // Her kayıt formu sekmelidir; hatalı alan içeren sekme "!" rozeti taşır, kayıt denemesinden sonra hatalı ilk sekme açılır.
    private const string PackageTab = "form-paket";
    private readonly TabState tabs = new("form-genel");

    private int ErrorCount(params string[] fields) => errors is null ? 0 : fields.Count(errors.ContainsKey);

    private IReadOnlyList<TabItem> FormTabs
    {
        get
        {
            List<TabItem> items =
            [
                new("form-genel", Texts.Get("crm.products.tab.general"), Errors: ErrorCount("code", "name", "kind", "status", "categoryId", "baseUnitId", "quantityPrecision")),
                new("form-fiyat", Texts.Get("crm.products.tab.pricing"), Errors: ErrorCount("taxCategory", "chargeType", "recurringPeriod", "saleStart", "saleEnd", "cost", "costCurrency")),
                new("form-detay", Texts.Get("crm.products.tab.details"), Errors: ErrorCount("serviceDurationMinutes", "deliveryMode", "barcode", "externalCode", "brand", "model", "tags", "description")),
            ];
            if (form?.Id is not null)
            {
                items.Add(new(PackageTab, Texts.Get("crm.products.components.title"), Count: components.Count));
            }

            return items;
        }
    }
    private List<ProductComponentDto> components = [];
    private List<ProductDto> allProducts = [];
    private ComponentForm componentForm = new();
    private IReadOnlyDictionary<string, string[]>? componentErrors;
    private string? componentMessage;
    private IReadOnlyDictionary<string, string[]>? errors;
    private string? message;
    private string? search;
    private string? status;
    private string? kind;
    private bool busy;

    protected override async Task OnInitializedAsync()
    {
        views = new PersonalGridViews(Api, "crm.products");
        grid.Define(Columns);
        await Session.EnsureLoadedAsync();
        if (Session.Can(CrmAccess.ProductsRead))
        {
            categories = await LoadAllAsync<ProductCategoryDto>("/api/crm/product-categories");
            units = await LoadAllAsync<MeasureUnitDto>("/api/crm/units");
            await views.LoadAsync();
            await LoadAsync(1);
        }
    }

    private async Task<List<T>> LoadAllAsync<T>(string url)
    {
        var items = new List<T>();
        for (var pageNumber = 1; ; pageNumber++)
        {
            var result = await Api.GetAsync<CrmPage<T>>($"{url}?page={pageNumber}&pageSize=100");
            if (result.Value is not { } chunk)
            {
                message = result.Error;
                break;
            }

            items.AddRange(chunk.Items);
            if (items.Count >= chunk.TotalCount || chunk.Items.Count == 0)
            {
                break;
            }
        }

        return items;
    }

    private const string AllView = "all";
    private const string KindPrefix = "kind:";

    // Görünümler yalnızca süzgeçtir (tüm kayıtlar, tür, kişisel); kapsamı sunucu uygular.
    private IReadOnlyList<ViewOption> ViewOptions =>
    [
        new(AllView, Texts.Get("crm.products.view.all"), Icon: "package"),
        .. CatalogLabels.Kinds.Select(k => new ViewOption(KindPrefix + k.Key, k.Label, Icon: "layers")),
        .. views.Options,
    ];

    private GridViewDto? Active => views.Find(view);

    // Durum süzgeci seçimi; boş = tümü.
    private string statusValue
    {
        get => status ?? string.Empty;
        set => status = string.IsNullOrEmpty(value) ? null : value;
    }

    private string? CurrentFilters => GridFilters.Build(kind is { } k ? ("kind", k) : null, status is { } s ? ("status", s) : null);

    // Açık görünümün kendi süzgeci (kişisel görünümde kayıtlı, tür sekmesinde türün kendisi); farklıysa kaydedilmemiş değişiklik vardır.
    private string? BaselineFilters => Active is { } saved
        ? saved.Filters
        : view.StartsWith(KindPrefix, StringComparison.Ordinal) ? GridFilters.Build(("kind", view[KindPrefix.Length..])) : null;

    private bool FiltersDiffer => (CurrentFilters ?? string.Empty) != (BaselineFilters ?? string.Empty);

    private async Task ChooseViewAsync(string key)
    {
        view = key;
        views.StartNaming(false);
        if (Active is { } saved)
        {
            grid.Apply(saved);
            var filters = GridFilters.Parse(saved.Filters);
            kind = filters.GetValueOrDefault("kind");
            status = filters.GetValueOrDefault("status");
        }
        else
        {
            grid.Reset();
            kind = key.StartsWith(KindPrefix, StringComparison.Ordinal) ? key[KindPrefix.Length..] : null;
            status = null;
        }

        await LoadAsync(1);
    }

    private async Task SortAsync(string key)
    {
        grid.Sort = key;
        await LoadAsync(1);
    }

    // Sütun seçimi/sırası değişince veri yeniden çekilmez; geri çağrı yalnızca sayfanın yeniden çizilmesini sağlar.
    private Task ColumnsChanged() => Task.CompletedTask;

    private void StartNaming() => views.StartNaming(true);

    private async Task SaveAsAsync(string name)
    {
        if (await views.SaveAsAsync(grid.ToRequest(name, CurrentFilters)) is { } key)
        {
            view = key;
        }
    }

    private async Task UpdateViewAsync()
    {
        if (Active is { } current)
        {
            await views.UpdateAsync(current, grid.ToRequest(current.Name, CurrentFilters));
        }
    }

    private async Task DiscardAsync() => await ChooseViewAsync(view);

    private async Task DeleteViewAsync()
    {
        if (Active is { } current && await views.DeleteAsync(current))
        {
            await ChooseViewAsync(AllView);
        }
    }

    private RenderFragment Cell(GridColumnDef column, ProductDto product) => @<td data-label="@column.Label" class="@(column.Key == "code" ? "primary" : null)">@CellContent(column.Key, product)</td>;

    private RenderFragment CellContent(string key, ProductDto product) => key switch
    {
        "code" => @<text>@product.Code</text>,
        "name" => @<text>@product.Name</text>,
        "kind" => @<text>@CatalogLabels.Label(CatalogLabels.Kinds, product.Kind)</text>,
        "status" => @<span class="badge status-@CatalogLabels.Badge(product.Status)">@CatalogLabels.Label(CatalogLabels.Statuses, product.Status)</span>,
        "category" => @<text>@product.CategoryName</text>,
        "unit" => @<text>@product.BaseUnitCode</text>,
        "brand" => @<text>@product.Brand</text>,
        "tags" => @<text>@product.Tags</text>,
        "barcode" => @<text>@product.Barcode</text>,
        _ => @<text></text>,
    };

    private async Task LoadAsync(int pageNumber)
    {
        var url = $"{Url}?page={pageNumber}&pageSize={ListPaging.Size}&search={Uri.EscapeDataString(search ?? string.Empty)}";
        if (grid.Sort != grid.DefaultSort)
        {
            url += $"&sort={Uri.EscapeDataString(grid.Sort)}";
        }

        if (status is not null)
        {
            url += $"&status={Uri.EscapeDataString(status)}";
        }

        if (kind is not null)
        {
            url += $"&kind={Uri.EscapeDataString(kind)}";
        }

        var result = await Api.GetAsync<CrmPage<ProductDto>>(url);
        page = result.Value;
        message = result.Error;
    }

    private void New()
    {
        form = new ProductForm();
        tabs.Select("form-genel");
        errors = null;
        message = null;
    }

    private async Task LoadComponentsAsync(Guid packageId)
    {
        var (loaded, error) = await Api.GetAllAsync<ProductComponentDto>($"/api/crm/product-components?packageId={packageId}");
        components = loaded;
        componentMessage = error;
        if (allProducts.Count == 0)
        {
            allProducts = (await Api.GetAllAsync<ProductDto>(Url)).Items;
        }
    }

    private async Task AddComponentAsync(Guid packageId)
    {
        busy = true;
        var result = await Api.PostAsync<ProductComponentDto>("/api/crm/product-components",
            new SaveProductComponentRequest(packageId, componentForm.ComponentId, componentForm.Quantity));
        busy = false;

        if (result.IsSuccess)
        {
            componentForm = new ComponentForm();
            componentErrors = null;
            await LoadComponentsAsync(packageId);
            return;
        }

        componentErrors = result.FieldErrors;
        componentMessage = result.Error;
    }

    private async Task DeleteComponentAsync(ProductComponentDto component)
    {
        var result = await Api.DeleteAsync($"/api/crm/product-components/{component.Id}?version={component.Version}");
        if (result.IsSuccess)
        {
            await LoadComponentsAsync(component.PackageId);
            return;
        }

        componentMessage = result.Error;
    }

    private async Task Edit(ProductDto p)
    {
        form = new ProductForm
        {
            Id = p.Id, Version = p.Version, Code = p.Code, Name = p.Name, Description = p.Description, Kind = p.Kind, Status = p.Status,
            CategoryId = p.CategoryId, BaseUnitId = p.BaseUnitId, ExternalCode = p.ExternalCode, Barcode = p.Barcode, Brand = p.Brand,
            Model = p.Model, Tags = p.Tags, SaleStart = p.SaleStart?.ToDateTime(TimeOnly.MinValue), SaleEnd = p.SaleEnd?.ToDateTime(TimeOnly.MinValue),
            TaxCategory = p.TaxCategory, PriceIncludesTax = p.PriceIncludesTax, QuantityPrecision = p.QuantityPrecision, Cost = p.Cost,
            CostCurrency = p.CostCurrency ?? "TRY", ServiceDurationMinutes = p.ServiceDurationMinutes, DeliveryMode = p.DeliveryMode,
            ChargeType = p.ChargeType, RecurringPeriod = p.RecurringPeriod,
        };
        tabs.Select("form-genel");
        errors = null;
        message = null;
        componentForm = new ComponentForm();
        componentErrors = null;
        await LoadComponentsAsync(p.Id);
    }

    private void Close() => form = null;

    private async Task SaveAsync()
    {
        busy = true;
        var f = form!;
        var request = new SaveProductRequest(
            f.Code, f.Name, f.BaseUnitId, f.Kind, f.Status, Blank(f.Description), f.CategoryId, Blank(f.ExternalCode), Blank(f.Barcode),
            Blank(f.Brand), Blank(f.Model), Blank(f.Tags),
            f.SaleStart is { } start ? DateOnly.FromDateTime(start) : null, f.SaleEnd is { } end ? DateOnly.FromDateTime(end) : null,
            Blank(f.TaxCategory), f.PriceIncludesTax, f.QuantityPrecision, f.Cost, string.IsNullOrWhiteSpace(f.CostCurrency) ? "TRY" : f.CostCurrency,
            f.Kind == "Service" ? f.ServiceDurationMinutes : null, f.Kind == "Service" ? Blank(f.DeliveryMode) : null,
            f.ChargeType, f.ChargeType == "Recurring" ? Blank(f.RecurringPeriod) : null, f.Version);
        var result = f.Id is { } id
            ? await Api.PutAsync<ProductDto>($"{Url}/{id}", request)
            : await Api.PostAsync<ProductDto>(Url, request);
        busy = false;

        if (result.IsSuccess)
        {
            form = null;
            errors = null;
            message = null;
            await LoadAsync(page?.Page ?? 1);
            return;
        }

        errors = result.FieldErrors;
        message = result.Error;
        tabs.RevealFirstFailing(FormTabs);
    }

    private async Task DeleteAsync()
    {
        busy = true;
        var result = await Api.DeleteAsync($"{Url}/{form!.Id}?version={form.Version}");
        busy = false;

        if (result.IsSuccess)
        {
            form = null;
            await LoadAsync(page?.Page ?? 1);
            return;
        }

        message = result.Error;
    }

    private static string? Blank(string? value) => string.IsNullOrWhiteSpace(value) ? null : value;

    private sealed class ComponentForm
    {
        public Guid ComponentId { get; set; }

        public decimal Quantity { get; set; } = 1m;
    }

    private sealed class ProductForm
    {
        public Guid? Id { get; init; }

        public long? Version { get; init; }

        public string Code { get; set; } = string.Empty;

        public string Name { get; set; } = string.Empty;

        public string? Description { get; set; }

        public string Kind { get; set; } = "Product";

        public string Status { get; set; } = "Draft";

        public Guid? CategoryId { get; set; }

        public Guid BaseUnitId { get; set; }

        public string? ExternalCode { get; set; }

        public string? Barcode { get; set; }

        public string? Brand { get; set; }

        public string? Model { get; set; }

        public string? Tags { get; set; }

        public DateTime? SaleStart { get; set; }

        public DateTime? SaleEnd { get; set; }

        public string? TaxCategory { get; set; }

        public bool PriceIncludesTax { get; set; }

        public int QuantityPrecision { get; set; }

        public decimal? Cost { get; set; }

        public string CostCurrency { get; set; } = "TRY";

        public int? ServiceDurationMinutes { get; set; }

        public string? DeliveryMode { get; set; }

        public string ChargeType { get; set; } = "OneTime";

        public string? RecurringPeriod { get; set; }
    }
}
