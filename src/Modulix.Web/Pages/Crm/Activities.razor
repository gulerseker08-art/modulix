@page "/crm/aktiviteler"
@inject ApiClient Api
@inject SessionState Session
@inject CrmLookups Lookups
@inject IJSRuntime Js

<PageTitle>Aktiviteler · Modulix</PageTitle>

<AuthGate Module="@CrmAccess.ModuleKey" Permission="@CrmAccess.ActivitiesRead">
    <PageHeader Title="Aktiviteler" Icon="activity" Subtitle="Tüm görev, arama, e-posta, toplantı ve ziyaretlerinizi yönetin.">
        @if (Session.Can(CrmAccess.ActivitiesWrite) && !editing)
        {
            <button type="button" class="btn btn-primary" @onclick="() => Open(null, null)"><span aria-hidden="true">+</span> Yeni aktivite</button>
        }
    </PageHeader>

    <Notice Text="@message" Failed="true" />
    <Notice Text="@bulkMessage" Failed="@bulkFailed" />

    @* Özet kartları: her kart, sayısını verdiği görünümü açar (sayı ile açılan liste aynı süzgeçtir). *@
    <div class="kpi-grid" role="group" aria-label="Aktivite özeti">
        <button type="button" class="stat-card kpi-card tone-brand" @onclick="() => ApplyKpiAsync(Mode.List, QuickFilter.Today, null)">
            <span class="stat-icon" aria-hidden="true"><AppIcon Name="calendar" Size="22" /></span>
            <span class="kpi-text"><span class="kpi-label">Bugün</span><strong>@KpiText(kpiToday)</strong><small>açık aktivite</small></span>
        </button>
        <button type="button" class="stat-card kpi-card tone-danger" @onclick="() => ApplyKpiAsync(Mode.List, QuickFilter.Overdue, null)">
            <span class="stat-icon" aria-hidden="true"><AppIcon Name="alert-circle" Size="22" /></span>
            <span class="kpi-text"><span class="kpi-label">Geciken</span><strong>@KpiText(kpiOverdue)</strong><small>aktivite</small></span>
        </button>
        <button type="button" class="stat-card kpi-card tone-success" @onclick="() => ApplyKpiAsync(Mode.Week, QuickFilter.Mine, null)">
            <span class="stat-icon" aria-hidden="true"><AppIcon Name="check-circle" Size="22" /></span>
            <span class="kpi-text"><span class="kpi-label">Bu hafta</span><strong>@KpiText(kpiWeek)</strong><small>aktivite</small></span>
        </button>
        <button type="button" class="stat-card kpi-card tone-info" @onclick="() => ApplyKpiAsync(Mode.Week, QuickFilter.Mine, ActivityStatus.Completed)">
            <span class="stat-icon" aria-hidden="true"><AppIcon Name="layers" Size="22" /></span>
            <span class="kpi-text"><span class="kpi-label">Tamamlanan</span><strong>@KpiText(kpiDone)</strong><small>bu hafta</small></span>
        </button>
    </div>

    <div class="activity-toolbar">
        <div class="segmented" role="group" aria-label="Görünüm">
            @foreach (var (value, label) in Modes)
            {
                <button type="button" class="chip @(mode == value ? "active" : null)" aria-pressed="@((mode == value) ? "true" : "false")" @onclick="() => SwitchModeAsync(value)">@label</button>
            }
        </div>
    </div>

    <div class="filters" role="group" aria-label="Hızlı filtre">
        @foreach (var (value, label) in Quick)
        {
            @if (value != QuickFilter.Team || Session.Can(CrmAccess.ActivitiesManageCalendar))
            {
                <button type="button" class="chip @(quick == value ? "active" : null)" aria-pressed="@((quick == value) ? "true" : "false")" @onclick="() => SwitchQuickAsync(value)">@label</button>
            }
        }
    </div>

    <form class="filters" @onsubmit="() => ReloadAsync()" @onsubmit:preventDefault>
        <input class="form-control" type="search" placeholder="Konu ara" aria-label="Konu ara" @bind="search" />
        <select class="form-select" aria-label="Durum" @bind="status">
            <option value="">Tüm durumlar</option>
            @foreach (var s in new[] { ActivityStatus.Open, ActivityStatus.InProgress, ActivityStatus.Blocked, ActivityStatus.Completed, ActivityStatus.NoAnswer, ActivityStatus.NoShow, ActivityStatus.Cancelled })
            {
                <option value="@s">@ActivityLabels.Status(ActivityFamily.Task, s)</option>
            }
        </select>
        <select class="form-select" aria-label="Tür" @bind="type">
            <option value="">Tüm türler</option>
            @foreach (var t in Lookups.Choices(CrmLists.ActivityType))
            {
                <option value="@t.Key">@t.Label</option>
            }
        </select>
        <select class="form-select" aria-label="Öncelik" @bind="priority">
            <option value="">Tüm öncelikler</option>
            @foreach (var p in new[] { ActivityPriority.Low, ActivityPriority.Normal, ActivityPriority.High, ActivityPriority.Urgent })
            {
                <option value="@p">@ActivityLabels.Priority(p)</option>
            }
        </select>
        <button type="submit" class="btn btn-outline-secondary">Uygula</button>
        <button type="button" class="btn btn-link" @onclick="SaveViewAsync">Görünümü kaydet</button>
    </form>

    @if (savedViews.Count > 0)
    {
        <div class="filters" role="group" aria-label="Kayıtlı görünümler">
            @foreach (var saved in savedViews)
            {
                <span class="chip-group">
                    <button type="button" class="chip" @onclick="() => ApplyViewAsync(saved)">@saved.Name</button>
                    <button type="button" class="chip" aria-label="@(saved.Name) görünümünü sil" @onclick="() => DeleteViewAsync(saved)">×</button>
                </span>
            }
        </div>
    }

    <div class="activity-layout @(mode != Mode.List ? "with-panel" : null)">
        <div class="activity-main">
            @if (mode != Mode.List)
            {
                <div class="cal-nav" role="group" aria-label="Tarih gezintisi">
                    <button type="button" class="btn btn-outline-secondary btn-sm cal-nav-step" aria-label="Önceki" title="Önceki" @onclick="() => MoveAsync(-1)"><AppIcon Name="chevron-left" Size="18" /></button>
                    <button type="button" class="btn btn-outline-secondary btn-sm cal-nav-step" aria-label="Sonraki" title="Sonraki" @onclick="() => MoveAsync(1)"><AppIcon Name="chevron-right" Size="18" /></button>
                    <strong class="cal-nav-title" aria-live="polite">@Title()</strong>
                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="TodayAsync">Bugün</button>
                </div>
            }

            @if (items is null)
            {
                <p class="text-muted">Yükleniyor…</p>
            }
            else if (mode == Mode.List)
            {
                @if (items.Count == 0)
                {
                    <p class="text-muted">Bu listede aktivite yok.</p>
                }
                else
                {
                    @if (picked.Count > 0 && Session.Can(CrmAccess.ActivitiesWrite))
                    {
                        <div class="filters" role="group" aria-label="Toplu işlem">
                            <strong>@picked.Count seçili</strong>
                            <button type="button" class="btn btn-outline-primary btn-sm" disabled="@busy" @onclick='() => BulkAsync("complete")'>Tamamla</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@busy" @onclick='() => BulkAsync("reschedule-by-days")'>@bulkDays gün ertele</button>
                            <input class="form-control" type="number" min="1" max="366" aria-label="Ertelenecek gün" @bind="bulkDays" style="width:6rem" />
                            <input class="form-control" placeholder="Gerekçe (iptal / erteleme)" aria-label="Toplu işlem gerekçesi" @bind="bulkReason" />
                            <button type="button" class="btn btn-outline-danger btn-sm" disabled="@busy" @onclick='() => BulkAsync("cancel")'>İptal et</button>
                        </div>
                    }
                    <table class="table record-table">
                        <thead>
                            <tr><th><span class="visually-hidden">Seç</span></th><th>Konu</th><th>Tür</th><th>Durum</th><th>Zaman</th><th>Öncelik</th><th>Firma</th><th>Sorumlu</th>@foreach (var field in Lookups.ListFieldsOf(CrmEntityKeys.Activity)) { <th>@field.Label</th> }</tr>
                        </thead>
                        <tbody>
                            @foreach (var activity in items)
                            {
                                <tr class="@ActivityLabels.Css(activity)">
                                    <td class="check-cell">
                                        @if (!activity.Masked && ActivityStatus.IsOpen(activity.Status) && Session.Can(CrmAccess.ActivitiesWrite))
                                        {
                                            <input type="checkbox" aria-label="@activity.Subject seç" checked="@picked.Contains(activity.Id)" @onchange="e => Pick(activity, e)" />
                                        }
                                    </td>
                                    <td data-label="Konu" class="primary"><button type="button" class="btn btn-link" @onclick="() => Select(activity)">@activity.Subject</button></td>
                                    <td data-label="Tür">@(activity.Masked ? null : Lookups.Label(CrmLists.ActivityType, activity.Type))</td>
                                    <td data-label="Durum">@ActivityLabels.Status(ActivityLabels.Family(Lookups, activity.Type), activity.Status)@(ActivityLabels.IsOverdue(activity) ? " · gecikti" : null)</td>
                                    <td data-label="Zaman">@WhenText(activity)</td>
                                    <td data-label="Öncelik">@(activity.Masked ? null : ActivityLabels.Priority(activity.Priority))</td>
                                    <td data-label="Firma">
                                        @if (activity.CompanyId is { } companyId)
                                        {
                                            <a href="crm/firmalar/@companyId">@Lookups.CompanyName(companyId)</a>
                                        }
                                    </td>
                                    <td data-label="Sorumlu">@Lookups.MemberName(activity.OwnerId)</td>
                                    @foreach (var field in Lookups.ListFieldsOf(CrmEntityKeys.Activity))
                                    {
                                        <td data-label="@field.Label">@(activity.Masked ? null : CustomFieldText.Format(field, activity.Custom))</td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                    <Pager Page="pageNumber" PageSize="PageSize" TotalCount="total" PageChanged="LoadPageAsync" />
                }
            }
            else
            {
                @if (total > items.Count)
                {
                    <Notice Text="@($"Bu aralıkta {total} aktivite var, ilk {items.Count} tanesi gösteriliyor. Filtreleri daraltın veya aralığı küçültün.")" Failed="true" />
                }
                <ActivityCalendar Mode="CalendarModeOf(mode)" Anchor="anchor" Items="items" CanMove="CanMove" FamilyOf="FamilyOf"
                                  OnSelect="Select" OnCreate="day => Open(null, day)" OnDayChosen="ChooseDayAsync" OnMove="MoveActivityAsync" />
            }
        </div>
        @if (mode != Mode.List)
        {
            <TodayActivities Items="todayItems" Error="@todayError" Lookups="Lookups" OnSelect="Select" />
        }
    </div>

    @if (conflictMove is not null)
    {
        <div class="alert alert-danger" role="alert">
            @conflictMessage
            <button type="button" class="btn btn-outline-danger btn-sm" @onclick="ForceMoveAsync">Çakışmaya rağmen taşı</button>
            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => conflictMove = null">Vazgeç</button>
        </div>
    }

    @* Detay ve düzenleme sağdan açılan çekmecede; arkadaki takvim/liste yerinde kalır. *@
    <Drawer Open="@(selected is not null && !editing)" Label="Aktivite detayı" OnClose="() => selected = null">
        @if (selected is not null)
        {
            <ActivityActions Activity="selected" Changed="ChangedAsync" Closed="() => selected = null" EditRequested="a => Open(a, null)" />
        }
    </Drawer>

    <Drawer Open="editing" Label="@(editTarget is null ? "Yeni aktivite" : "Aktiviteyi düzenle")" OnClose="() => editing = false">
        <ActivityEditor Activity="editTarget" InitialDay="initialDay" Lookups="Lookups" Saved="SavedAsync" Deleted="SavedAsync" Cancelled="() => editing = false" />
    </Drawer>
</AuthGate>

@code {
    private const string Url = "/api/crm/activities";
    private const string ViewsKey = "modulix.activity-views";
    private const int PageSize = 50;
    private const int CalendarSize = 200;

    private enum Mode
    {
        List,
        Day,
        Week,
        Month,
        Agenda,
    }

    private enum QuickFilter
    {
        Today,
        Overdue,
        Mine,
        Team,
        AllOpen,
        All,
    }

    private sealed record SavedView(string Name, Mode Mode, QuickFilter Quick, string? Status, string? Type, string? Priority);

    private static readonly (Mode Value, string Label)[] Modes =
    [
        (Mode.List, "Liste"), (Mode.Day, "Gün"), (Mode.Week, "Hafta"), (Mode.Month, "Ay"), (Mode.Agenda, "Ajanda"),
    ];

    private static readonly (QuickFilter Value, string Label)[] Quick =
    [
        (QuickFilter.Today, "Bugün"), (QuickFilter.Overdue, "Gecikenler"), (QuickFilter.Mine, "Bana atananlar"),
        (QuickFilter.Team, "Ekip"), (QuickFilter.AllOpen, "Tüm açıklar"), (QuickFilter.All, "Tümü"),
    ];

    private List<ActivityDto>? itemsBacking;
    private IReadOnlyList<ActivityDto>? items;
    private int total;
    private int pageNumber = 1;
    private ActivityDto? selected;
    private ActivityDto? editTarget;
    private DateOnly? initialDay;
    private bool editing;
    private bool busy;
    private Mode mode = Mode.Week;
    private QuickFilter quick = QuickFilter.Today;
    private DateOnly anchor = DateOnly.FromDateTime(Regional.Now.DateTime);
    private string? message;
    private string? bulkMessage;
    private bool bulkFailed;
    private string? search;
    private string? status;
    private string? type;
    private string? priority;
    private readonly HashSet<Guid> picked = [];
    private int bulkDays = 1;
    private string? bulkReason;
    private List<SavedView> savedViews = [];
    private (ActivityDto Activity, DateOnly Day)? conflictMove;
    private int? kpiToday;
    private int? kpiOverdue;
    private int? kpiWeek;
    private int? kpiDone;
    private IReadOnlyList<ActivityDto>? todayItems;
    private string? todayError;
    private string? conflictMessage;

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (Session.Can(CrmAccess.ActivitiesRead))
        {
            await Lookups.LoadAsync(contacts: true, opportunities: true);
            await LoadViewsAsync();
            await Task.WhenAll(ReloadAsync(), LoadOverviewAsync());
        }
    }

    // ---- Süzgeçler

    private static CalendarMode CalendarModeOf(Mode value) => value switch
    {
        Mode.Day => CalendarMode.Day,
        Mode.Week => CalendarMode.Week,
        Mode.Agenda => CalendarMode.Agenda,
        _ => CalendarMode.Month,
    };

    /// <summary>Gün sınırları firmanın saat dilimine göre hesaplanır. "Bugün" gecikenleri de içerir.</summary>
    private static string QuickQuery(QuickFilter value)
    {
        var now = Regional.Now;
        var endOfToday = Regional.FromTenant(now.Date.AddDays(1));
        return value switch
        {
            QuickFilter.Today => $"&open=true&ownerId=me&dueBefore={Uri.EscapeDataString(endOfToday.ToString("O"))}",
            QuickFilter.Overdue => $"&overdue={Uri.EscapeDataString(DateTimeOffset.UtcNow.ToString("O"))}&ownerId=me",
            QuickFilter.Mine => "&open=true&ownerId=me",
            QuickFilter.Team => "&open=true",
            QuickFilter.AllOpen => "&open=true",
            _ => string.Empty,
        };
    }

    private string Filters()
    {
        var filters = QuickQuery(quick);
        if (mode != Mode.List)
        {
            var (from, to) = ActivityCalendar.Window(CalendarModeOf(mode), anchor);
            filters = $"&range={Uri.EscapeDataString(ActivityLabels.Range(from, to))}" + (quick is QuickFilter.Mine or QuickFilter.Today or QuickFilter.Overdue ? "&ownerId=me" : string.Empty);
        }

        return filters
            + (string.IsNullOrEmpty(status) ? null : $"&status={status}")
            + (string.IsNullOrEmpty(type) ? null : $"&type={type}")
            + (string.IsNullOrEmpty(priority) ? null : $"&priority={priority}");
    }

    private async Task ReloadAsync()
    {
        pageNumber = 1;
        await LoadPageAsync(1);
    }

    private async Task LoadPageAsync(int page)
    {
        pageNumber = page;
        var size = mode == Mode.List ? PageSize : CalendarSize;
        var result = await Api.GetAsync<CrmPage<ActivityDto>>(
            $"{Url}?page={page}&pageSize={size}&search={Uri.EscapeDataString(search ?? string.Empty)}{Filters()}");
        itemsBacking = result.Value?.Items.ToList();
        items = itemsBacking;
        total = result.Value?.TotalCount ?? 0;
        message = result.Error;
        picked.Clear();
    }

    private async Task SwitchModeAsync(Mode value)
    {
        mode = value;
        if (mode != Mode.List && quick is QuickFilter.AllOpen or QuickFilter.All)
        {
            quick = QuickFilter.Mine;
        }

        await ReloadAsync();
    }

    private async Task SwitchQuickAsync(QuickFilter value)
    {
        quick = value;
        await ReloadAsync();
    }

    private async Task MoveAsync(int direction)
    {
        anchor = mode switch
        {
            Mode.Day => anchor.AddDays(direction),
            Mode.Week => anchor.AddDays(7 * direction),
            Mode.Agenda => anchor.AddDays(30 * direction),
            _ => anchor.AddMonths(direction),
        };
        await ReloadAsync();
    }

    private async Task TodayAsync()
    {
        anchor = DateOnly.FromDateTime(Regional.Now.DateTime);
        await ReloadAsync();
    }

    private async Task ChooseDayAsync(DateOnly day)
    {
        anchor = day;
        mode = Mode.Day;
        await ReloadAsync();
    }

    private string Title()
    {
        var tr = System.Globalization.CultureInfo.GetCultureInfo("tr-TR");
        var (from, to) = ActivityCalendar.Window(CalendarModeOf(mode), anchor);
        return mode switch
        {
            Mode.Day => from.ToString("d MMMM yyyy dddd", tr),
            Mode.Month => anchor.ToString("MMMM yyyy", tr),
            _ => $"{from.ToString("d MMM", tr)} – {to.ToString("d MMM yyyy", tr)}",
        };
    }

    private static string WhenText(ActivityDto a) =>
        a.StartAt is not null || a.IsAllDay
            ? $"{ActivityLabels.Days(a).FirstOrDefault().ToString("d MMM", System.Globalization.CultureInfo.GetCultureInfo("tr-TR"))} {ActivityLabels.TimeText(a)}"
            : a.DueAt is { } due ? CrmLabels.Time(due) : string.Empty;

    // ---- Seçim, düzenleme

    private void Select(ActivityDto activity)
    {
        selected = activity;
        editing = false;
    }

    private void Open(ActivityDto? activity, DateOnly? day)
    {
        editTarget = activity;
        initialDay = day;
        editing = true;
        selected = null;
        message = null;
    }

    private async Task SavedAsync()
    {
        editing = false;
        await RefreshAsync();
    }

    private async Task ChangedAsync(ActivityDto updated)
    {
        selected = updated;
        await RefreshAsync();
    }

    private bool CanMove(ActivityDto activity) => Session.Can(CrmAccess.ActivitiesWrite);

    private string FamilyOf(ActivityDto activity) => ActivityLabels.Family(Lookups, activity.Type);

    // ---- Özet kartları ve "Bugünün aktiviteleri": kullanıcının kendi aktiviteleri, liste süzgeçleriyle aynı sorgular.

    private static DateOnly TodayDate => DateOnly.FromDateTime(Regional.Now.DateTime);

    private static string KpiText(int? value) => value?.ToString(Regional.Numbers) ?? "–";

    private async Task RefreshAsync() => await Task.WhenAll(LoadPageAsync(pageNumber), LoadOverviewAsync());

    private async Task LoadOverviewAsync()
    {
        var (weekFrom, weekTo) = ActivityCalendar.Window(CalendarMode.Week, TodayDate);
        var week = $"&range={Uri.EscapeDataString(ActivityLabels.Range(weekFrom, weekTo))}&ownerId=me";
        var today = $"&range={Uri.EscapeDataString(ActivityLabels.Range(TodayDate, TodayDate))}&ownerId=me";

        var todayTask = Api.GetAsync<CrmPage<ActivityDto>>($"{Url}?page=1&pageSize=50{today}");
        var counts = await Task.WhenAll(
            CountAsync(QuickQuery(QuickFilter.Today)),
            CountAsync(QuickQuery(QuickFilter.Overdue)),
            CountAsync(week),
            CountAsync($"{week}&status={ActivityStatus.Completed}"));
        (kpiToday, kpiOverdue, kpiWeek, kpiDone) = (counts[0], counts[1], counts[2], counts[3]);

        var list = await todayTask;
        todayItems = list.Value?.Items.OrderBy(a => a.IsAllDay ? 0 : 1).ThenBy(a => a.StartAt ?? a.DueAt).ToList()
            ?? new List<ActivityDto>();
        todayError = list.Error;
    }

    private async Task<int?> CountAsync(string filters)
    {
        var result = await Api.GetAsync<CrmPage<ActivityDto>>($"{Url}?page=1&pageSize=1{filters}");
        return result.Value?.TotalCount;
    }

    private async Task ApplyKpiAsync(Mode targetMode, QuickFilter targetQuick, string? targetStatus)
    {
        (mode, quick, status) = (targetMode, targetQuick, targetStatus);
        anchor = TodayDate;
        await ReloadAsync();
    }

    // ---- Sürükle-bırak ile yeniden planlama: yerel saat korunarak yalnızca gün değişir; çakışmayı sunucu bildirir.

    private async Task MoveActivityAsync((ActivityDto Activity, DateOnly Day) move) => await RescheduleToAsync(move.Activity, move.Day, allowConflict: false);

    private async Task ForceMoveAsync()
    {
        if (conflictMove is { } move)
        {
            conflictMove = null;
            await RescheduleToAsync(move.Activity, move.Day, allowConflict: true);
        }
    }

    private async Task RescheduleToAsync(ActivityDto activity, DateOnly day, bool allowConflict)
    {
        var current = ActivityLabels.Days(activity).FirstOrDefault();
        if (current == default || current == day)
        {
            return;
        }

        var delta = day.DayNumber - current.DayNumber;
        DateTimeOffset? Shift(DateTimeOffset? value) =>
            value is { } v ? Regional.FromTenant(Regional.ToTenant(v).DateTime.AddDays(delta)) : null;

        var body = new RescheduleActivityRequest(
            activity.Version, "Takvimde taşındı", Shift(activity.DueAt), activity.IsAllDay ? null : Shift(activity.StartAt),
            activity.IsAllDay ? null : Shift(activity.EndAt), activity.IsAllDay, activity.StartDate?.AddDays(delta), activity.EndDate?.AddDays(delta), allowConflict);
        var result = await Api.PostAsync<ActivityDto>($"{Url}/{activity.Id}/reschedule", body);
        if (result.IsSuccess)
        {
            message = null;
            await RefreshAsync();
            return;
        }

        if (result.FieldErrors?.ContainsKey("conflict") == true)
        {
            conflictMove = (activity, day);
            conflictMessage = result.FieldErrors["conflict"].FirstOrDefault();
            return;
        }

        message = result.Error;
    }

    // ---- Toplu işlem: sonuç kayıt başınadır (kısmi başarı)

    private void Pick(ActivityDto activity, ChangeEventArgs e)
    {
        if (e.Value is true)
        {
            picked.Add(activity.Id);
        }
        else
        {
            picked.Remove(activity.Id);
        }
    }

    private async Task BulkAsync(string action)
    {
        busy = true;
        var request = new BulkActivityRequest(
            action, [.. items!.Where(a => picked.Contains(a.Id)).Select(a => new BulkActivityItem(a.Id, a.Version))],
            Reason: string.IsNullOrWhiteSpace(bulkReason) ? null : bulkReason, Days: action == "reschedule-by-days" ? bulkDays : null);
        var result = await Api.PostAsync<BulkActivityResultDto>($"{Url}/bulk", request);
        busy = false;

        bulkFailed = result.Error is not null || result.Value?.Failed > 0;
        bulkMessage = result.Value is { } r
            ? $"{r.Succeeded} kayıt işlendi" + (r.Failed > 0 ? $", {r.Failed} kayıt işlenemedi: {string.Join("; ", r.Failures.Select(f => $"{items!.FirstOrDefault(a => a.Id == f.Id)?.Subject ?? "kayıt"} ({f.Message})"))}" : ".")
            : result.Error;
        await RefreshAsync();
    }

    // ---- Kişisel kayıtlı görünümler (bu tarayıcıda saklanır; sunucuya gitmez)

    private async Task LoadViewsAsync()
    {
        try
        {
            var json = await Js.InvokeAsync<string?>("localStorage.getItem", ViewsKey);
            savedViews = json is null ? [] : System.Text.Json.JsonSerializer.Deserialize<List<SavedView>>(json) ?? [];
        }
        catch (Exception)
        {
            savedViews = [];
        }
    }

    private async Task PersistViewsAsync()
    {
        try
        {
            await Js.InvokeVoidAsync("localStorage.setItem", ViewsKey, System.Text.Json.JsonSerializer.Serialize(savedViews));
        }
        catch (Exception)
        {
            // Tarayıcı depolama kapalıysa görünüm yalnızca bu oturumda kalır.
        }
    }

    private async Task SaveViewAsync()
    {
        var name = $"{Modes.First(m => m.Value == mode).Label} · {Quick.First(q => q.Value == quick).Label}";
        savedViews.RemoveAll(v => v.Name == name);
        savedViews.Add(new SavedView(name, mode, quick, status, type, priority));
        await PersistViewsAsync();
    }

    private async Task ApplyViewAsync(SavedView view)
    {
        (mode, quick, status, type, priority) = (view.Mode, view.Quick, view.Status, view.Type, view.Priority);
        await ReloadAsync();
    }

    private async Task DeleteViewAsync(SavedView view)
    {
        savedViews.Remove(view);
        await PersistViewsAsync();
    }
}
