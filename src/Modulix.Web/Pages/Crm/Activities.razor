@page "/crm/aktiviteler"
@inject ApiClient Api
@inject SessionState Session
@inject CrmLookups Lookups

<PageTitle>Aktiviteler · Modulix</PageTitle>

<AuthGate Module="@CrmAccess.ModuleKey" Permission="@CrmAccess.ActivitiesRead">
    <div class="page-header">
        <h1>Aktiviteler</h1>
        @if (Session.Can(CrmAccess.ActivitiesWrite) && !editing)
        {
            <button type="button" class="btn btn-primary" @onclick="() => Open(null)">Yeni aktivite</button>
        }
    </div>

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }

    @if (editing)
    {
        <ActivityEditor Activity="selected" Lookups="Lookups" Saved="SavedAsync" Deleted="SavedAsync" Cancelled="() => editing = false" />
    }

    <div class="filters" role="group" aria-label="Görünüm">
        @foreach (var (value, label) in Views)
        {
            <button type="button" class="chip @(view == value ? "active" : null)" @onclick="() => SwitchAsync(value)">@label</button>
        }
    </div>

    <form class="search" @onsubmit="() => LoadAsync(1)" @onsubmit:preventDefault>
        <input class="form-control" type="search" placeholder="Konu ara" @bind="search" />
        <button type="submit" class="btn btn-outline-secondary">Ara</button>
    </form>

    @if (page is null)
    {
        <p class="text-muted">Yükleniyor…</p>
    }
    else if (page.Items.Count == 0)
    {
        <p class="text-muted">@(view == View.All ? "Kayıt yok." : "Bu listede yapılacak iş yok.")</p>
    }
    else
    {
        <table class="table record-table">
            <thead>
                <tr><th></th><th>Konu</th><th>Tür</th><th>Tarih</th><th>Firma</th><th>Atanan</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var activity in page.Items)
                {
                    <tr class="@RowClass(activity)">
                        <td class="check-cell">
                            @if (Session.Can(CrmAccess.ActivitiesWrite) && activity.CompletedAt is null)
                            {
                                <button type="button" class="btn btn-outline-secondary btn-sm check" title="Tamamla" aria-label="Tamamla"
                                        disabled="@busy" @onclick="() => CompleteAsync(activity)">✓</button>
                            }
                        </td>
                        <td data-label="Konu" class="primary">@activity.Subject</td>
                        <td data-label="Tür">@CrmLabels.Of(activity.Type)</td>
                        <td data-label="Tarih">@(activity.DueAt is { } due ? CrmLabels.Time(due) : null)@(IsOverdue(activity) ? " · gecikti" : null)</td>
                        <td data-label="Firma">
                            @if (activity.CompanyId is { } companyId)
                            {
                                <a href="crm/firmalar/@companyId">@Lookups.CompanyName(companyId)</a>
                            }
                        </td>
                        <td data-label="Atanan">@Lookups.MemberName(activity.OwnerId)</td>
                        <td class="actions">
                            @if (Session.Can(CrmAccess.ActivitiesWrite))
                            {
                                <button type="button" class="btn btn-outline-primary btn-sm" @onclick="() => Open(activity)">Düzenle</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager Page="page.Page" PageSize="page.PageSize" TotalCount="page.TotalCount" PageChanged="LoadAsync" />
    }
</AuthGate>

@code {
    private const string Url = "/api/crm/activities";

    private enum View
    {
        Today,
        Overdue,
        Mine,
        Open,
        All,
    }

    private static readonly (View Value, string Label)[] Views =
    [
        (View.Today, "Bugün"),
        (View.Overdue, "Geciken"),
        (View.Mine, "Bana atananlar"),
        (View.Open, "Tüm açıklar"),
        (View.All, "Tümü"),
    ];

    private CrmPage<ActivityDto>? page;
    private ActivityDto? selected;
    private bool editing;
    private bool busy;
    private View view = View.Today;
    private string? message;
    private string? search;

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (Session.Can(CrmAccess.ActivitiesRead))
        {
            await Lookups.LoadAsync(contacts: true, opportunities: true);
            await LoadAsync(1);
        }
    }

    private static bool IsOverdue(ActivityDto activity) =>
        activity.CompletedAt is null && activity.DueAt is { } due && due < DateTimeOffset.Now;

    private static string? RowClass(ActivityDto activity) =>
        activity.CompletedAt is not null ? "done" : IsOverdue(activity) ? "overdue" : null;

    /// <summary>Gün sınırı tarayıcının saat dilimine göre hesaplanır; "Bugün" gecikenleri de içerir.</summary>
    private string ViewFilters()
    {
        var now = DateTimeOffset.Now;
        var endOfToday = new DateTimeOffset(now.Date.AddDays(1), now.Offset);
        return view switch
        {
            View.Today => $"&open=true&ownerId=me&dueBefore={Uri.EscapeDataString(endOfToday.ToString("O"))}",
            View.Overdue => $"&open=true&ownerId=me&dueBefore={Uri.EscapeDataString(now.ToString("O"))}",
            View.Mine => "&open=true&ownerId=me",
            View.Open => "&open=true",
            _ => string.Empty,
        };
    }

    private async Task SwitchAsync(View value)
    {
        view = value;
        await LoadAsync(1);
    }

    private async Task LoadAsync(int pageNumber)
    {
        var result = await Api.GetAsync<CrmPage<ActivityDto>>(
            $"{Url}?page={pageNumber}&search={Uri.EscapeDataString(search ?? string.Empty)}{ViewFilters()}");
        page = result.Value;
        message = result.Error;
    }

    private void Open(ActivityDto? activity)
    {
        selected = activity;
        editing = true;
        message = null;
    }

    private async Task SavedAsync()
    {
        editing = false;
        await LoadAsync(page?.Page ?? 1);
    }

    private async Task CompleteAsync(ActivityDto activity)
    {
        busy = true;
        var result = await Api.PutAsync<ActivityDto>($"{Url}/{activity.Id}", CrmRequests.From(activity) with { CompletedAt = DateTimeOffset.Now });
        busy = false;
        message = result.Error;
        await LoadAsync(page?.Page ?? 1);
    }
}
