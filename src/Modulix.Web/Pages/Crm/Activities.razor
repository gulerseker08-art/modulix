@page "/crm/aktiviteler"
@inject ApiClient Api
@inject SessionState Session
@inject CrmLookups Lookups
@inject IJSRuntime Js

<PageTitle>@Texts.Get("crm.activities.title") · Modulix</PageTitle>

<AuthGate Module="@CrmAccess.ModuleKey" Permission="@CrmAccess.ActivitiesRead">
    <PageHeader Title="@Texts.Get("crm.activities.title")" Icon="activity" Subtitle="@Texts.Get("crm.act.subtitle")">
        @if (Session.Can(CrmAccess.ActivitiesWrite) && !editing)
        {
            <button type="button" class="btn btn-primary" @onclick="() => Open(null, null)"><span aria-hidden="true">+</span> @Texts.Get("crm.activities.new")</button>
        }
    </PageHeader>

    <Notice Text="@message" Failed="true" />
    <Notice Text="@bulkMessage" Failed="@bulkFailed" />

    @* Özet kartları: her kart, sayısını verdiği görünümü açar (sayı ile açılan liste aynı süzgeçtir). *@
    <div class="kpi-grid" role="group" aria-label="@Texts.Get("crm.act.kpi.summary")">
        <button type="button" class="stat-card kpi-card tone-brand" @onclick="() => ApplyKpiAsync(Mode.List, QuickFilter.Today, null)">
            <span class="stat-icon" aria-hidden="true"><AppIcon Name="calendar" Size="22" /></span>
            <span class="kpi-text"><span class="kpi-label">@Texts.Get("crm.act.kpi.today")</span><strong>@KpiText(kpiToday)</strong><small>@Texts.Get("crm.act.kpi.todayHint")</small></span>
        </button>
        <button type="button" class="stat-card kpi-card tone-danger" @onclick="() => ApplyKpiAsync(Mode.List, QuickFilter.Overdue, null)">
            <span class="stat-icon" aria-hidden="true"><AppIcon Name="alert-circle" Size="22" /></span>
            <span class="kpi-text"><span class="kpi-label">@Texts.Get("crm.act.kpi.overdue")</span><strong>@KpiText(kpiOverdue)</strong><small>@Texts.Get("crm.act.kpi.overdueHint")</small></span>
        </button>
        <button type="button" class="stat-card kpi-card tone-success" @onclick="() => ApplyKpiAsync(Mode.Week, QuickFilter.Mine, null)">
            <span class="stat-icon" aria-hidden="true"><AppIcon Name="check-circle" Size="22" /></span>
            <span class="kpi-text"><span class="kpi-label">@Texts.Get("crm.act.kpi.week")</span><strong>@KpiText(kpiWeek)</strong><small>@Texts.Get("crm.act.kpi.weekHint")</small></span>
        </button>
        <button type="button" class="stat-card kpi-card tone-info" @onclick="() => ApplyKpiAsync(Mode.Week, QuickFilter.Mine, ActivityStatus.Completed)">
            <span class="stat-icon" aria-hidden="true"><AppIcon Name="layers" Size="22" /></span>
            <span class="kpi-text"><span class="kpi-label">@Texts.Get("crm.act.kpi.done")</span><strong>@KpiText(kpiDone)</strong><small>@Texts.Get("crm.act.kpi.doneHint")</small></span>
        </button>
    </div>

    @* Görünüm sekmeleri: hızlı süzgeçler sistem görünümleridir, kişisel görünümler (ADR-0036) ardına eklenir; takvim/liste kipi ayrı seçicidir. *@
    <ViewTabs Items="ViewOptions" Value="@viewKey" ValueChanged="ChooseViewAsync" Label="@Texts.Get("crm.act.views")" NewView="StartNaming" />

    <div class="activity-toolbar">
        <div class="segmented" role="group" aria-label="@Texts.Get("crm.act.mode.label")">
            @foreach (var (value, label) in Modes)
            {
                <button type="button" class="chip @(mode == value ? "active" : null)" aria-pressed="@((mode == value) ? "true" : "false")" @onclick="() => SwitchModeAsync(value)">@label</button>
            }
        </div>
        @if (mode == Mode.List)
        {
            <GridColumnPicker State="grid" Changed="@(() => Task.CompletedTask)" />
        }
    </div>

    <form class="filters" @onsubmit="() => ReloadAsync()" @onsubmit:preventDefault>
        <input class="form-control" type="search" placeholder="@Texts.Get("crm.act.search")" aria-label="@Texts.Get("crm.act.search")" @bind="search" />
        <select class="form-select" aria-label="@Texts.Get("crm.act.col.status")" @bind="status">
            <option value="">@Texts.Get("common.allStatuses")</option>
            @foreach (var s in new[] { ActivityStatus.Open, ActivityStatus.InProgress, ActivityStatus.Blocked, ActivityStatus.Completed, ActivityStatus.NoAnswer, ActivityStatus.NoShow, ActivityStatus.Cancelled })
            {
                <option value="@s">@ActivityLabels.Status(ActivityFamily.Task, s)</option>
            }
        </select>
        <select class="form-select" aria-label="@Texts.Get("crm.act.col.type")" @bind="type">
            <option value="">@Texts.Get("crm.act.allTypes")</option>
            @foreach (var t in Lookups.Choices(CrmLists.ActivityType))
            {
                <option value="@t.Key">@t.Label</option>
            }
        </select>
        <select class="form-select" aria-label="@Texts.Get("crm.act.col.priority")" @bind="priority">
            <option value="">@Texts.Get("crm.act.allPriorities")</option>
            @foreach (var p in new[] { ActivityPriority.Low, ActivityPriority.Normal, ActivityPriority.High, ActivityPriority.Urgent })
            {
                <option value="@p">@ActivityLabels.Priority(p)</option>
            }
        </select>
        <button type="submit" class="btn btn-outline-secondary">@Texts.Get("crm.act.apply")</button>
    </form>

    <PersonalViewBar Active="Active" Dirty="Dirty" Naming="views.Naming" NamingChanged="views.StartNaming" Error="@views.Error"
                     SaveAs="SaveAsAsync" UpdateView="UpdateViewAsync" DiscardChanges="DiscardAsync" DeleteView="DeleteViewAsync" />

    <div class="activity-layout @(mode != Mode.List ? "with-panel" : null)">
        <div class="activity-main">
            @if (mode != Mode.List)
            {
                <div class="cal-nav" role="group" aria-label="@Texts.Get("crm.act.nav.label")">
                    <button type="button" class="btn btn-outline-secondary btn-sm cal-nav-step" aria-label="@Texts.Get("crm.act.nav.prev")" title="@Texts.Get("crm.act.nav.prev")" @onclick="() => MoveAsync(-1)"><AppIcon Name="chevron-left" Size="18" /></button>
                    <button type="button" class="btn btn-outline-secondary btn-sm cal-nav-step" aria-label="@Texts.Get("crm.act.nav.next")" title="@Texts.Get("crm.act.nav.next")" @onclick="() => MoveAsync(1)"><AppIcon Name="chevron-right" Size="18" /></button>
                    <strong class="cal-nav-title" aria-live="polite">@Title()</strong>
                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="TodayAsync">@Texts.Get("crm.act.nav.today")</button>
                </div>
            }

            @if (items is null)
            {
                <LoadingState />
            }
            else if (mode == Mode.List)
            {
                @if (items.Count == 0)
                {
                    <p class="text-muted">@Texts.Get("crm.act.emptyList")</p>
                }
                else
                {
                    @if (picked.Count > 0 && Session.Can(CrmAccess.ActivitiesWrite))
                    {
                        <div class="filters" role="group" aria-label="@Texts.Get("crm.act.bulk.label")">
                            <strong>@Texts.Get("crm.act.bulk.picked", picked.Count)</strong>
                            <button type="button" class="btn btn-outline-primary btn-sm" disabled="@busy" @onclick='() => BulkAsync("complete")'>@Texts.Get("crm.act.bulk.complete")</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@busy" @onclick='() => BulkAsync("reschedule-by-days")'>@Texts.Get("crm.act.bulk.postpone", bulkDays)</button>
                            <input class="form-control" type="number" min="1" max="366" aria-label="@Texts.Get("crm.act.bulk.daysLabel")" @bind="bulkDays" style="width:6rem" />
                            <input class="form-control" placeholder="@Texts.Get("crm.act.bulk.reasonPlaceholder")" aria-label="@Texts.Get("crm.act.bulk.reasonLabel")" @bind="bulkReason" />
                            <button type="button" class="btn btn-outline-danger btn-sm" disabled="@busy" @onclick='() => BulkAsync("cancel")'>@Texts.Get("crm.act.cancel")</button>
                        </div>
                    }
                    <table class="table record-table">
                        <thead>
                            <tr>
                                <th scope="col"><span class="visually-hidden">@Texts.Get("crm.act.select")</span></th>
                                @foreach (var column in grid.VisibleColumns)
                                {
                                    <GridHeader Column="column" State="grid" />
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var activity in items)
                            {
                                <tr class="@ActivityLabels.Css(activity)">
                                    <td class="check-cell">
                                        @if (!activity.Masked && ActivityStatus.IsOpen(activity.Status) && Session.Can(CrmAccess.ActivitiesWrite))
                                        {
                                            <input type="checkbox" aria-label="@Texts.Get("crm.act.selectRow", activity.Subject)" checked="@picked.Contains(activity.Id)" @onchange="e => Pick(activity, e)" />
                                        }
                                    </td>
                                    @foreach (var column in grid.VisibleColumns)
                                    {
                                        <td data-label="@column.Label" class="@(column.Key == "subject" ? "primary" : null)">@CellContent(column.Key, activity)</td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                    <Pager Page="pageNumber" PageSize="PageSize" TotalCount="total" PageChanged="LoadPageAsync" />
                }
            }
            else
            {
                @if (total > items.Count)
                {
                    <Notice Text="@Texts.Get("crm.act.rangeCapped", total, items.Count)" Failed="true" />
                }
                <ActivityCalendar Mode="CalendarModeOf(mode)" Anchor="anchor" Items="items" CanMove="CanMove" FamilyOf="FamilyOf"
                                  OnSelect="Select" OnCreate="day => Open(null, day)" OnDayChosen="ChooseDayAsync" OnMove="MoveActivityAsync" />
            }
        </div>
        @if (mode != Mode.List)
        {
            <TodayActivities Items="todayItems" Error="@todayError" Lookups="Lookups" OnSelect="Select" />
        }
    </div>

    @if (conflictMove is not null)
    {
        <div class="alert alert-danger" role="alert">
            @conflictMessage
            <button type="button" class="btn btn-outline-danger btn-sm" @onclick="ForceMoveAsync">@Texts.Get("crm.act.conflict.move")</button>
            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => conflictMove = null">@Texts.Get("common.dismiss")</button>
        </div>
    }

    @* Detay ve düzenleme sağdan açılan çekmecede; arkadaki takvim/liste yerinde kalır. *@
    <Drawer Open="@(selected is not null && !editing)" Label="@Texts.Get("crm.act.detail")" OnClose="() => selected = null">
        @if (selected is not null)
        {
            <ActivityActions Activity="selected" Lookups="Lookups" Changed="ChangedAsync" Closed="() => selected = null" EditRequested="a => Open(a, null)" />
        }
    </Drawer>

    <Drawer Open="editing" Label="@Texts.Get(editTarget is null ? "crm.activities.new" : "crm.activities.edit")" OnClose="() => editing = false">
        <ActivityEditor Activity="editTarget" InitialDay="initialDay" Lookups="Lookups" Saved="SavedAsync" Deleted="SavedAsync" Cancelled="() => editing = false" />
    </Drawer>
</AuthGate>

@code {
    private const string Url = "/api/crm/activities";
    private const string ScreenKey = "crm.activities";
    private const int PageSize = 50;
    private const int CalendarSize = 200;

    private enum Mode
    {
        List,
        Day,
        Week,
        Month,
        Agenda,
    }

    private enum QuickFilter
    {
        Today,
        Overdue,
        Mine,
        Team,
        AllOpen,
        All,
    }

    // Aktivite listesi sunucuda sıralanmaz (takvim kipleri tarih penceresiyle çalışır); sütunlar seçilir ve sırası görünümle saklanır.
    private static GridColumnDef[] BaseColumns =>
    [
        new("subject", Texts.Get("crm.act.col.subject"), "type", Locked: true),
        new("type", Texts.Get("crm.act.col.type"), "tag"),
        new("status", Texts.Get("crm.act.col.status"), "activity"),
        new("when", Texts.Get("crm.act.col.when"), "calendar"),
        new("priority", Texts.Get("crm.act.col.priority"), "alert-circle"),
        new("company", Texts.Get("crm.act.col.company"), "building"),
        new("owner", Texts.Get("crm.act.col.owner"), "user"),
    ];

    private static readonly (QuickFilter Value, string Icon)[] QuickIcons =
    [
        (QuickFilter.Today, "calendar"), (QuickFilter.Overdue, "alert-circle"), (QuickFilter.Mine, "user"),
        (QuickFilter.Team, "users"), (QuickFilter.AllOpen, "activity"), (QuickFilter.All, "layers"),
    ];

    private static (Mode Value, string Label)[] Modes =>
    [
        (Mode.List, Texts.Get("crm.act.mode.list")), (Mode.Day, Texts.Get("crm.act.mode.day")), (Mode.Week, Texts.Get("crm.act.mode.week")),
        (Mode.Month, Texts.Get("crm.act.mode.month")), (Mode.Agenda, Texts.Get("crm.act.mode.agenda")),
    ];

    private static (QuickFilter Value, string Label)[] Quick =>
    [
        (QuickFilter.Today, Texts.Get("crm.act.quick.today")), (QuickFilter.Overdue, Texts.Get("crm.act.quick.overdue")),
        (QuickFilter.Mine, Texts.Get("crm.act.quick.mine")), (QuickFilter.Team, Texts.Get("crm.act.quick.team")),
        (QuickFilter.AllOpen, Texts.Get("crm.act.quick.allOpen")), (QuickFilter.All, Texts.Get("crm.act.quick.all")),
    ];

    private List<ActivityDto>? itemsBacking;
    private IReadOnlyList<ActivityDto>? items;
    private int total;
    private int pageNumber = 1;
    private ActivityDto? selected;
    private ActivityDto? editTarget;
    private DateOnly? initialDay;
    private bool editing;
    private bool busy;
    private Mode mode = Mode.Week;
    private QuickFilter quick = QuickFilter.Mine;
    private DateOnly anchor = DateOnly.FromDateTime(Regional.Now.DateTime);
    private string? message;
    private string? bulkMessage;
    private bool bulkFailed;
    private string? search;
    private string? status;
    private string? type;
    private string? priority;
    private readonly HashSet<Guid> picked = [];
    private int bulkDays = 1;
    private string? bulkReason;
    private readonly GridViewState grid = new(ScreenKey, string.Empty);
    private PersonalGridViews views = default!;
    private string viewKey = QuickFilter.Mine.ToString();
    private (ActivityDto Activity, DateOnly Day)? conflictMove;
    private int? kpiToday;
    private int? kpiOverdue;
    private int? kpiWeek;
    private int? kpiDone;
    private IReadOnlyList<ActivityDto>? todayItems;
    private string? todayError;
    private string? conflictMessage;

    protected override async Task OnInitializedAsync()
    {
        views = new PersonalGridViews(Api, ScreenKey);
        await Session.EnsureLoadedAsync();
        if (Session.Can(CrmAccess.ActivitiesRead))
        {
            await Lookups.LoadAsync(contacts: true, opportunities: true);
            grid.Define([.. BaseColumns, .. Lookups.FieldsOf(CrmEntityKeys.Activity).Select(f => new GridColumnDef("custom." + f.Key, f.Label, "type", DefaultVisible: f.ShowInList))]);
            await views.LoadAsync();
            // Telefonda yedi günlük saat çizelgesi sığmaz (bugün ekran dışında kalır); varsayılan görünüm Gün olur.
            if (await Js.InvokeAsync<bool>("modulixShell.isNarrow"))
            {
                mode = Mode.Day;
            }

            await Task.WhenAll(ReloadAsync(), LoadOverviewAsync());
        }
    }

    // ---- Süzgeçler

    private static CalendarMode CalendarModeOf(Mode value) => value switch
    {
        Mode.Day => CalendarMode.Day,
        Mode.Week => CalendarMode.Week,
        Mode.Agenda => CalendarMode.Agenda,
        _ => CalendarMode.Month,
    };

    /// <summary>Gün sınırları firmanın saat dilimine göre hesaplanır. "Bugün" gecikenleri de içerir.</summary>
    private static string QuickQuery(QuickFilter value)
    {
        var now = Regional.Now;
        var endOfToday = Regional.FromTenant(now.Date.AddDays(1));
        return value switch
        {
            QuickFilter.Today => $"&open=true&ownerId=me&dueBefore={Uri.EscapeDataString(endOfToday.ToString("O"))}",
            QuickFilter.Overdue => $"&overdue={Uri.EscapeDataString(DateTimeOffset.UtcNow.ToString("O"))}&ownerId=me",
            QuickFilter.Mine => "&open=true&ownerId=me",
            QuickFilter.Team => "&open=true",
            QuickFilter.AllOpen => "&open=true",
            _ => string.Empty,
        };
    }

    private string Filters()
    {
        var filters = QuickQuery(quick);
        if (mode != Mode.List)
        {
            var (from, to) = ActivityCalendar.Window(CalendarModeOf(mode), anchor);
            filters = $"&range={Uri.EscapeDataString(ActivityLabels.Range(from, to))}" + (quick is QuickFilter.Mine or QuickFilter.Today or QuickFilter.Overdue ? "&ownerId=me" : string.Empty);
        }

        return filters
            + (string.IsNullOrEmpty(status) ? null : $"&status={status}")
            + (string.IsNullOrEmpty(type) ? null : $"&type={type}")
            + (string.IsNullOrEmpty(priority) ? null : $"&priority={priority}");
    }

    private async Task ReloadAsync()
    {
        pageNumber = 1;
        await LoadPageAsync(1);
    }

    private async Task LoadPageAsync(int page)
    {
        pageNumber = page;
        var size = mode == Mode.List ? PageSize : CalendarSize;
        var result = await Api.GetAsync<CrmPage<ActivityDto>>(
            $"{Url}?page={page}&pageSize={size}&search={Uri.EscapeDataString(search ?? string.Empty)}{Filters()}");
        itemsBacking = result.Value?.Items.ToList();
        items = itemsBacking;
        total = result.Value?.TotalCount ?? 0;
        message = result.Error;
        picked.Clear();
    }

    private async Task SwitchModeAsync(Mode value)
    {
        mode = value;
        if (mode != Mode.List && quick is QuickFilter.AllOpen or QuickFilter.All)
        {
            quick = QuickFilter.Mine;
            if (Active is null)
            {
                viewKey = quick.ToString();
            }
        }

        await ReloadAsync();
    }

    // ---- Görünümler: hızlı süzgeçler sistem görünümü, kişisel görünümler sunucuda (ADR-0036; süzgeç metni quick, mode, status, type, priority)

    private GridViewDto? Active => views.Find(viewKey);

    private IReadOnlyList<ViewOption> ViewOptions =>
    [
        .. Quick.Where(q => q.Value != QuickFilter.Team || Session.Can(CrmAccess.ActivitiesManageCalendar))
            .Select(q => new ViewOption(q.Value.ToString(), q.Label, Icon: QuickIcons.First(i => i.Value == q.Value).Icon)),
        .. views.Options,
    ];

    private string? CurrentFilters => GridFilters.Build(
        ("quick", quick.ToString()),
        ("mode", mode.ToString()),
        status is { Length: > 0 } s ? ("status", s) : null,
        type is { Length: > 0 } t ? ("type", t) : null,
        priority is { Length: > 0 } p ? ("priority", p) : null);

    // Sistem görünümünün süzgeci yalnızca hızlı süzgeçtir; kip görünümle saklanmaz, sekme değişince de korunur.
    private string? BaselineFilters => Active?.Filters ?? GridFilters.Build(("quick", viewKey), ("mode", mode.ToString()));

    private bool Dirty => grid.Differs(Active) || Canon(CurrentFilters) != Canon(BaselineFilters);

    private static string Canon(string? filters) =>
        string.Join('&', GridFilters.Parse(filters).OrderBy(p => p.Key, StringComparer.Ordinal).Select(p => p.Key + "=" + p.Value));

    private async Task ChooseViewAsync(string key)
    {
        viewKey = key;
        views.StartNaming(false);
        if (Active is { } saved)
        {
            grid.Apply(saved);
        }
        else
        {
            grid.Reset();
        }

        var filters = GridFilters.Parse(BaselineFilters);
        quick = Enum.TryParse<QuickFilter>(filters.GetValueOrDefault("quick"), out var q) ? q : QuickFilter.Mine;
        if (quick == QuickFilter.Team && !Session.Can(CrmAccess.ActivitiesManageCalendar))
        {
            quick = QuickFilter.Mine;
        }

        if (Active is not null)
        {
            mode = Enum.TryParse<Mode>(filters.GetValueOrDefault("mode"), out var m) ? m : mode;
            status = filters.GetValueOrDefault("status");
            type = filters.GetValueOrDefault("type");
            priority = filters.GetValueOrDefault("priority");
        }

        if (mode != Mode.List && quick is QuickFilter.AllOpen or QuickFilter.All)
        {
            mode = Mode.List;
        }

        await ReloadAsync();
    }

    private void StartNaming() => views.StartNaming(true);

    private async Task SaveAsAsync(string name)
    {
        if (await views.SaveAsAsync(grid.ToRequest(name, CurrentFilters)) is { } key)
        {
            viewKey = key;
        }
    }

    private async Task UpdateViewAsync()
    {
        if (Active is { } current)
        {
            await views.UpdateAsync(current, grid.ToRequest(current.Name, CurrentFilters));
        }
    }

    private async Task DiscardAsync() => await ChooseViewAsync(viewKey);

    private async Task DeleteViewAsync()
    {
        if (Active is { } current && await views.DeleteAsync(current))
        {
            await ChooseViewAsync(QuickFilter.Mine.ToString());
        }
    }

    private RenderFragment CellContent(string key, ActivityDto activity) => key switch
    {
        "subject" => @<button type="button" class="btn btn-link" @onclick="() => Select(activity)">@activity.Subject</button>,
        "type" => @<text>@(activity.Masked ? null : Lookups.Label(CrmLists.ActivityType, activity.Type))</text>,
        "status" => @<text>@ActivityLabels.Status(ActivityLabels.Family(Lookups, activity.Type), activity.Status)@(ActivityLabels.IsOverdue(activity) ? ActivityLabels.OverdueSuffix : null)</text>,
        "when" => @<text>@WhenText(activity)</text>,
        "priority" => @<text>@(activity.Masked ? null : ActivityLabels.Priority(activity.Priority))</text>,
        "company" => @<text>@if (activity.CompanyId is { } companyId) { <a href="crm/firmalar/@companyId">@Lookups.CompanyName(companyId)</a> }</text>,
        "owner" => @<text>@Lookups.MemberName(activity.OwnerId)</text>,
        _ when key.StartsWith("custom.", StringComparison.Ordinal) && Lookups.FieldsOf(CrmEntityKeys.Activity).FirstOrDefault(f => "custom." + f.Key == key) is { } field =>
            @<text>@(activity.Masked ? null : CustomFieldText.Format(field, activity.Custom))</text>,
        _ => @<text></text>,
    };

    private async Task MoveAsync(int direction)
    {
        anchor = mode switch
        {
            Mode.Day => anchor.AddDays(direction),
            Mode.Week => anchor.AddDays(7 * direction),
            Mode.Agenda => anchor.AddDays(30 * direction),
            _ => anchor.AddMonths(direction),
        };
        await ReloadAsync();
    }

    private async Task TodayAsync()
    {
        anchor = DateOnly.FromDateTime(Regional.Now.DateTime);
        await ReloadAsync();
    }

    private async Task ChooseDayAsync(DateOnly day)
    {
        anchor = day;
        mode = Mode.Day;
        await ReloadAsync();
    }

    private string Title()
    {
        var culture = UiLanguage.Culture;
        var (from, to) = ActivityCalendar.Window(CalendarModeOf(mode), anchor);
        return mode switch
        {
            Mode.Day => from.ToString("d MMMM yyyy dddd", culture),
            Mode.Month => anchor.ToString("MMMM yyyy", culture),
            _ => $"{from.ToString("d MMM", culture)} – {to.ToString("d MMM yyyy", culture)}",
        };
    }

    private static string WhenText(ActivityDto a) =>
        a.StartAt is not null || a.IsAllDay
            ? $"{ActivityLabels.Days(a).FirstOrDefault().ToString("d MMM", UiLanguage.Culture)} {ActivityLabels.TimeText(a)}"
            : a.DueAt is { } due ? CrmLabels.Time(due) : string.Empty;

    // ---- Seçim, düzenleme

    private void Select(ActivityDto activity)
    {
        selected = activity;
        editing = false;
    }

    private void Open(ActivityDto? activity, DateOnly? day)
    {
        editTarget = activity;
        initialDay = day;
        editing = true;
        selected = null;
        message = null;
    }

    private async Task SavedAsync()
    {
        editing = false;
        await RefreshAsync();
    }

    private async Task ChangedAsync(ActivityDto updated)
    {
        selected = updated;
        await RefreshAsync();
    }

    private bool CanMove(ActivityDto activity) => Session.Can(CrmAccess.ActivitiesWrite);

    private string FamilyOf(ActivityDto activity) => ActivityLabels.Family(Lookups, activity.Type);

    // ---- Özet kartları ve "Bugünün aktiviteleri": kullanıcının kendi aktiviteleri, liste süzgeçleriyle aynı sorgular.

    private static DateOnly TodayDate => DateOnly.FromDateTime(Regional.Now.DateTime);

    private static string KpiText(int? value) => value?.ToString(Regional.Numbers) ?? "–";

    private async Task RefreshAsync() => await Task.WhenAll(LoadPageAsync(pageNumber), LoadOverviewAsync());

    private async Task LoadOverviewAsync()
    {
        var (weekFrom, weekTo) = ActivityCalendar.Window(CalendarMode.Week, TodayDate);
        var week = $"&range={Uri.EscapeDataString(ActivityLabels.Range(weekFrom, weekTo))}&ownerId=me";
        var today = $"&range={Uri.EscapeDataString(ActivityLabels.Range(TodayDate, TodayDate))}&ownerId=me";

        var todayTask = Api.GetAsync<CrmPage<ActivityDto>>($"{Url}?page=1&pageSize=50{today}");
        var counts = await Task.WhenAll(
            CountAsync(QuickQuery(QuickFilter.Today)),
            CountAsync(QuickQuery(QuickFilter.Overdue)),
            CountAsync(week),
            CountAsync($"{week}&status={ActivityStatus.Completed}"));
        (kpiToday, kpiOverdue, kpiWeek, kpiDone) = (counts[0], counts[1], counts[2], counts[3]);

        var list = await todayTask;
        todayItems = list.Value?.Items.OrderBy(a => a.IsAllDay ? 0 : 1).ThenBy(a => a.StartAt ?? a.DueAt).ToList()
            ?? new List<ActivityDto>();
        todayError = list.Error;
    }

    private async Task<int?> CountAsync(string filters)
    {
        var result = await Api.GetAsync<CrmPage<ActivityDto>>($"{Url}?page=1&pageSize=1{filters}");
        return result.Value?.TotalCount;
    }

    private async Task ApplyKpiAsync(Mode targetMode, QuickFilter targetQuick, string? targetStatus)
    {
        (mode, quick, status) = (targetMode, targetQuick, targetStatus);
        viewKey = quick.ToString();
        anchor = TodayDate;
        await ReloadAsync();
    }

    // ---- Sürükle-bırak ile yeniden planlama: yerel saat korunarak yalnızca gün değişir; çakışmayı sunucu bildirir.

    private async Task MoveActivityAsync((ActivityDto Activity, DateOnly Day) move) => await RescheduleToAsync(move.Activity, move.Day, allowConflict: false);

    private async Task ForceMoveAsync()
    {
        if (conflictMove is { } move)
        {
            conflictMove = null;
            await RescheduleToAsync(move.Activity, move.Day, allowConflict: true);
        }
    }

    private async Task RescheduleToAsync(ActivityDto activity, DateOnly day, bool allowConflict)
    {
        var current = ActivityLabels.Days(activity).FirstOrDefault();
        if (current == default || current == day)
        {
            return;
        }

        var delta = day.DayNumber - current.DayNumber;
        DateTimeOffset? Shift(DateTimeOffset? value) =>
            value is { } v ? Regional.FromTenant(Regional.ToTenant(v).DateTime.AddDays(delta)) : null;

        var body = new RescheduleActivityRequest(
            activity.Version, Texts.Get("crm.act.movedInCalendar"), Shift(activity.DueAt), activity.IsAllDay ? null : Shift(activity.StartAt),
            activity.IsAllDay ? null : Shift(activity.EndAt), activity.IsAllDay, activity.StartDate?.AddDays(delta), activity.EndDate?.AddDays(delta), allowConflict);
        var result = await Api.PostAsync<ActivityDto>($"{Url}/{activity.Id}/reschedule", body);
        if (result.IsSuccess)
        {
            message = null;
            await RefreshAsync();
            return;
        }

        if (result.FieldErrors?.ContainsKey("conflict") == true)
        {
            conflictMove = (activity, day);
            conflictMessage = result.FieldErrors["conflict"].FirstOrDefault();
            return;
        }

        message = result.Error;
    }

    // ---- Toplu işlem: sonuç kayıt başınadır (kısmi başarı)

    private void Pick(ActivityDto activity, ChangeEventArgs e)
    {
        if (e.Value is true)
        {
            picked.Add(activity.Id);
        }
        else
        {
            picked.Remove(activity.Id);
        }
    }

    private async Task BulkAsync(string action)
    {
        busy = true;
        var request = new BulkActivityRequest(
            action, [.. items!.Where(a => picked.Contains(a.Id)).Select(a => new BulkActivityItem(a.Id, a.Version))],
            Reason: string.IsNullOrWhiteSpace(bulkReason) ? null : bulkReason, Days: action == "reschedule-by-days" ? bulkDays : null);
        var result = await Api.PostAsync<BulkActivityResultDto>($"{Url}/bulk", request);
        busy = false;

        bulkFailed = result.Error is not null || result.Value?.Failed > 0;
        bulkMessage = result.Value is { } r
            ? r.Failed > 0
                ? Texts.Get("crm.act.bulk.resultFailed", r.Succeeded, r.Failed, string.Join("; ", r.Failures.Select(f => $"{items!.FirstOrDefault(a => a.Id == f.Id)?.Subject ?? Texts.Get("crm.act.record")} ({f.Message})")))
                : Texts.Get("crm.act.bulk.result", r.Succeeded)
            : result.Error;
        await RefreshAsync();
    }

}
