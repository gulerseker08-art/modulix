@page "/crm/ekip-performansi"
@using System.Globalization
@using System.Net
@inject ApiClient Api
@inject SessionState Session
@inject CrmLookups Lookups

<PageTitle>Ekip performansı · Modulix</PageTitle>

<AuthGate Module="@CrmAccess.ModuleKey" Permission="@SalesAccess.ReportsRead">
    <a class="back-link" href="crm/satis-analizi">← Satış analizi</a>
    <div class="page-header">
        <div>
            <h1>Ekip performansı</h1>
            <p class="text-muted mb-0">
                Kullanıcı başına gerçekleşen satış, kazanma oranı, açık fırsat iş yükü ve döngü süresi. Tutarlar seçili para biriminde, vergi hariç nettir.
                Aktivite sayısı başarı ölçütü değildir ve bu tabloda yer almaz.
            </p>
        </div>
        <div class="header-actions">
            <a class="btn btn-outline-secondary" href="crm/veri-kalitesi">Veri kalitesi</a>
        </div>
    </div>

    <div class="filters" role="group" aria-label="Dönem türü">
        <div class="segmented">
            @foreach (var (key, label) in SalesLabels.PeriodKinds)
            {
                <button type="button" class="chip @(kind == key ? "active" : null)" aria-pressed="@(kind == key ? "true" : "false")" disabled="@loading" @onclick="() => ChooseKindAsync(key)">@label</button>
            }
        </div>
        <button type="button" class="btn btn-outline-secondary" disabled="@loading" @onclick="() => ShiftAsync(-1)">← Önceki dönem</button>
        <button type="button" class="btn btn-outline-secondary" disabled="@loading" @onclick="TodayAsync">Bugün</button>
        <button type="button" class="btn btn-outline-secondary" disabled="@loading" @onclick="() => ShiftAsync(1)">Sonraki dönem →</button>
    </div>

    <form class="form-grid mb-3" @onsubmit="LoadAsync" @onsubmit:preventDefault aria-label="Ekip performansı süzgeçleri">
        <div class="span-3">
            <label class="form-label" for="st-date">Dönemdeki bir gün</label>
            <input id="st-date" class="form-control" type="date" @bind="anchor" @bind:after="LoadAsync" />
        </div>
        <div class="span-3">
            <label class="form-label" for="st-currency">Para birimi</label>
            <input id="st-currency" class="form-control" maxlength="3" placeholder="@Regional.Currency" aria-describedby="st-currency-help" @bind="currency" @bind:after="LoadAsync" />
            <div id="st-currency-help" class="form-text">Boşsa firmanın raporlama para birimi (3 harf, ör. USD).</div>
        </div>
        <div class="span-4">
            <label class="form-label" for="st-owner">Kullanıcı (sorumlu)</label>
            <select id="st-owner" class="form-select" @bind="owner" @bind:after="LoadAsync">
                <option value="">Tüm kullanıcılar</option>
                @foreach (var member in Lookups.Members)
                {
                    <option value="@member.UserId">@member.DisplayName</option>
                }
            </select>
        </div>
    </form>

    <AnalyticsStatus Loading="loading" Error="error" Forbidden="forbidden" OnRetry="LoadAsync" />

    @if (report is { } r)
    {
        <AnalyticsFrame T="List<TeamPerformanceRowDto>" Report="r">
            @if (r.Data.Count == 0)
            {
                <p class="text-muted">Bu dönem ve süzgeç için gösterilecek kullanıcı verisi yok.</p>
            }
            else
            {
                var rows = Sorted(r.Data);
                <div class="form-grid mb-2" role="group" aria-label="Sıralama">
                    <div class="span-4">
                        <label class="form-label" for="st-sort">Sırala</label>
                        <select id="st-sort" class="form-select" @bind="sortKey">
                            @foreach (var (key, label) in SortOptions)
                            {
                                <option value="@key">@label</option>
                            }
                        </select>
                    </div>
                    <div class="span-3">
                        <label class="form-label" for="st-dir">Yön</label>
                        <select id="st-dir" class="form-select" @bind="descending">
                            <option value="True">Büyükten küçüğe</option>
                            <option value="False">Küçükten büyüğe</option>
                        </select>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table record-table">
                        <caption class="visually-hidden">Kullanıcı başına satış performansı, @r.PeriodLabel</caption>
                        <thead>
                            <tr>
                                <th scope="col" aria-sort="@AriaSort("name")"><button type="button" class="btn btn-link p-0" @onclick='() => SortBy("name")'>Kullanıcı@(Arrow("name"))</button></th>
                                <th scope="col" aria-sort="@AriaSort("realized")"><button type="button" class="btn btn-link p-0" @onclick='() => SortBy("realized")'>Gerçekleşen@(Arrow("realized"))</button></th>
                                <th scope="col" aria-sort="@AriaSort("won")"><button type="button" class="btn btn-link p-0" @onclick='() => SortBy("won")'>Kazanılan@(Arrow("won"))</button></th>
                                <th scope="col" aria-sort="@AriaSort("lost")"><button type="button" class="btn btn-link p-0" @onclick='() => SortBy("lost")'>Kaybedilen@(Arrow("lost"))</button></th>
                                <th scope="col" aria-sort="@AriaSort("winrate")"><button type="button" class="btn btn-link p-0" @onclick='() => SortBy("winrate")'>Kazanma oranı@(Arrow("winrate"))</button></th>
                                <th scope="col" aria-sort="@AriaSort("open")"><button type="button" class="btn btn-link p-0" @onclick='() => SortBy("open")'>Açık fırsat (iş yükü)@(Arrow("open"))</button></th>
                                <th scope="col" aria-sort="@AriaSort("pipeline")"><button type="button" class="btn btn-link p-0" @onclick='() => SortBy("pipeline")'>Açık pipeline@(Arrow("pipeline"))</button></th>
                                <th scope="col" aria-sort="@AriaSort("weighted")"><button type="button" class="btn btn-link p-0" @onclick='() => SortBy("weighted")'>Ağırlıklı@(Arrow("weighted"))</button></th>
                                <th scope="col" aria-sort="@AriaSort("overdue")"><button type="button" class="btn btn-link p-0" @onclick='() => SortBy("overdue")'>Gecikmiş açık@(Arrow("overdue"))</button></th>
                                <th scope="col" aria-sort="@AriaSort("cycle")"><button type="button" class="btn btn-link p-0" @onclick='() => SortBy("cycle")'>Döngü süresi@(Arrow("cycle"))</button></th>
                                <th scope="col" aria-sort="@AriaSort("attainment")"><button type="button" class="btn btn-link p-0" @onclick='() => SortBy("attainment")'>Hedef ve gerçekleşme@(Arrow("attainment"))</button></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in rows)
                            {
                                var p = row.Performance;
                                <tr>
                                    <td data-label="Kullanıcı" class="primary">@SalesAnalysisLabels.Owner(Lookups, p.OwnerId)</td>
                                    <td data-label="Gerçekleşen">
                                        @Money(p.Realized, r)
                                        @if (r.AmountsVisible && p.Realized.IsPartial)
                                        {
                                            <span class="badge stage-onhold">Kısmi</span>
                                            <br /><small class="text-muted">@SalesLabels.PartialHint(p.Realized)</small>
                                        }
                                    </td>
                                    <td data-label="Kazanılan">@SalesLabels.Count(p.WonCount)</td>
                                    <td data-label="Kaybedilen">@SalesLabels.Count(p.LostCount)</td>
                                    <td data-label="Kazanma oranı">@SalesAnalysisLabels.Rate(p.WinRatePercent)</td>
                                    <td data-label="Açık fırsat (iş yükü)">@SalesLabels.Count(p.OpenCount)</td>
                                    <td data-label="Açık pipeline">
                                        @Money(p.OpenPipeline, r)
                                        @if (r.AmountsVisible && p.OpenPipeline.IsPartial)
                                        {
                                            <br /><span class="badge stage-onhold">Kısmi</span>
                                        }
                                    </td>
                                    <td data-label="Ağırlıklı">
                                        @Money(p.WeightedOpen, r)
                                        @if (r.AmountsVisible && p.WeightedOpen.IsPartial)
                                        {
                                            <br /><span class="badge stage-onhold">Kısmi</span>
                                        }
                                    </td>
                                    <td data-label="Gecikmiş açık">@SalesLabels.Count(p.OverdueOpenCount)</td>
                                    <td data-label="Döngü süresi">
                                        @if (p.CycleSample == 0)
                                        {
                                            <text>@SalesAnalysisLabels.NoData</text>
                                        }
                                        else
                                        {
                                            <text>Ortalama @SalesAnalysisLabels.Days(p.AverageCycleDays) · medyan @SalesAnalysisLabels.Days(p.MedianCycleDays)</text>
                                        }
                                        <br /><small class="text-muted">
                                            Örneklem: @p.CycleSample kazanılan fırsat
                                            @if (p.CycleSample > 0 && p.CycleSample < SmallSample)
                                            {
                                                <span class="badge tag">Az örneklem</span>
                                            }
                                        </small>
                                    </td>
                                    <td data-label="Hedef ve gerçekleşme">@TargetCell(row, r)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <p class="small text-muted mt-2">
                    Aktivite sayısı (arama, toplantı vb.) başarı ölçütü değildir; yalnızca sonuçlanan satışlar ve açık fırsat yükü gösterilir.
                    Örneklemi @SmallSample fırsattan az olan döngü süresi, "Az örneklem" notuyla işaretlenir ve tek başına karar için yetersizdir.
                    Hedefler kullanıcı bazlı tutar hedefidir ve hedef okuma iznini ister; izniniz yoksa ya da kullanıcı için hedef girilmemişse "Hedef tanımlı değil" görünür.
                </p>
            }
        </AnalyticsFrame>
    }
</AuthGate>

@code {
    // Bu adetin altındaki örneklemde döngü süresi güvenilir sayılmaz.
    private const int SmallSample = 5;

    private static readonly IReadOnlyList<(string Key, string Label)> SortOptions =
    [
        ("name", "Kullanıcı"), ("realized", "Gerçekleşen"), ("won", "Kazanılan adet"), ("lost", "Kaybedilen adet"), ("winrate", "Kazanma oranı"),
        ("open", "Açık fırsat"), ("pipeline", "Açık pipeline"), ("weighted", "Ağırlıklı"), ("overdue", "Gecikmiş açık"), ("cycle", "Döngü süresi (ortalama)"),
        ("attainment", "Hedef gerçekleşme %"),
    ];

    private string kind = SalesPeriodKinds.Month;
    private DateOnly anchor = DateOnly.FromDateTime(Regional.Now.DateTime);
    private string owner = string.Empty;
    private string currency = string.Empty;

    private AnalyticsDto<List<TeamPerformanceRowDto>>? report;
    private string? error;
    private bool forbidden;
    private bool loading;
    private int requestId;

    private string sortKey = "realized";
    private bool descending = true;

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (Session.Can(SalesAccess.ReportsRead))
        {
            await Lookups.LoadAsync();
            await LoadAsync();
        }
    }

    private static string Iso(DateOnly day) => day.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);

    private string BuildQuery()
    {
        var query = new List<string> { $"kind={kind}", $"date={Iso(anchor)}" };
        if (owner.Length > 0)
        {
            query.Add($"ownerId={Uri.EscapeDataString(owner)}");
        }

        // Yarım yazılmış para birimi gönderilmez (3 harf olunca uygulanır).
        if (currency.Trim().Length == 3)
        {
            query.Add($"currency={Uri.EscapeDataString(currency.Trim().ToUpperInvariant())}");
        }

        return string.Join('&', query);
    }

    private async Task LoadAsync()
    {
        var id = ++requestId;
        loading = true;
        error = null;
        forbidden = false;

        var result = await Api.GetAsync<AnalyticsDto<List<TeamPerformanceRowDto>>>($"/api/crm/sales/analytics/team?{BuildQuery()}");
        if (id != requestId)
        {
            return;
        }

        loading = false;
        report = result.IsSuccess ? result.Value : null;
        error = result.Error;
        forbidden = result.Status == HttpStatusCode.Forbidden;
    }

    private async Task ChooseKindAsync(string key)
    {
        kind = key;
        await LoadAsync();
    }

    private async Task ShiftAsync(int direction)
    {
        var (start, end) = report is { } r ? (r.PeriodStart, r.PeriodEnd) : SalesLabels.CalendarPeriod(kind, anchor);
        anchor = direction < 0 ? start.AddDays(-1) : end.AddDays(1);
        await LoadAsync();
    }

    private async Task TodayAsync()
    {
        anchor = DateOnly.FromDateTime(Regional.Now.DateTime);
        await LoadAsync();
    }

    private void SortBy(string key)
    {
        if (sortKey == key)
        {
            descending = !descending;
        }
        else
        {
            sortKey = key;
            descending = key != "name";
        }
    }

    private string AriaSort(string key) => sortKey != key ? "none" : descending ? "descending" : "ascending";

    private string Arrow(string key) => sortKey != key ? string.Empty : descending ? " ↓" : " ↑";

    private decimal? SortValue(TeamPerformanceRowDto row)
    {
        var p = row.Performance;
        return sortKey switch
        {
            "realized" => p.Realized.Amount,
            "won" => p.WonCount,
            "lost" => p.LostCount,
            "winrate" => p.WinRatePercent,
            "open" => p.OpenCount,
            "pipeline" => p.OpenPipeline.Amount,
            "weighted" => p.WeightedOpen.Amount,
            "overdue" => p.OverdueOpenCount,
            "cycle" => p.AverageCycleDays,
            "attainment" => row.Progress?.AttainmentPercent,
            _ => null,
        };
    }

    // Boş değerler (veri yok / hedef yok) yönden bağımsız olarak sonda kalır.
    private List<TeamPerformanceRowDto> Sorted(IReadOnlyList<TeamPerformanceRowDto> rows)
    {
        if (sortKey == "name")
        {
            // "Sorumlusuz" satırı yönden bağımsız sonda kalır.
            var byOwner = rows.OrderBy(x => x.Performance.OwnerId is null ? 1 : 0);
            return descending
                ? [.. byOwner.ThenByDescending(x => SalesAnalysisLabels.Owner(Lookups, x.Performance.OwnerId), StringComparer.CurrentCultureIgnoreCase)]
                : [.. byOwner.ThenBy(x => SalesAnalysisLabels.Owner(Lookups, x.Performance.OwnerId), StringComparer.CurrentCultureIgnoreCase)];
        }

        var withValue = rows.Where(x => SortValue(x) is not null);
        var ordered = descending ? withValue.OrderByDescending(x => SortValue(x)) : withValue.OrderBy(x => SortValue(x));
        return [.. ordered, .. rows.Where(x => SortValue(x) is null)];
    }

    private static string Money(MoneyTotalDto total, AnalyticsDto<List<TeamPerformanceRowDto>> r) =>
        r.AmountsVisible ? CrmLabels.Amount(total.Amount, r.Currency) : SalesAnalysisLabels.NoAmountPermission;

    private RenderFragment TargetCell(TeamPerformanceRowDto row, AnalyticsDto<List<TeamPerformanceRowDto>> r) => @<text>
        @if (!r.AmountsVisible)
        {
            <text>@SalesAnalysisLabels.NoAmountPermission</text>
        }
        else if (row.Target is not { } target || row.Progress is not { } progress)
        {
            <text>Hedef tanımlı değil</text>
        }
        else
        {
            <text>Hedef @CrmLabels.Amount(target, r.Currency)</text>
            <br /><text>Gerçekleşme @SalesLabels.Percent(progress.AttainmentPercent)</text>
            <br />
            @if (progress.TargetMet)
            {
                <span class="badge stage-won">Hedef karşılandı</span>
            }
            else
            {
                <small class="text-muted">Kalan @CrmLabels.Amount(progress.Remaining, r.Currency) · kapsama @SalesAnalysisLabels.Ratio(progress.Coverage)</small>
            }
        }
    </text>;
}
