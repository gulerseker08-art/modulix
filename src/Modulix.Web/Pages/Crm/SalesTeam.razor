@page "/crm/ekip-performansi"
@using System.Globalization
@using System.Net
@inject ApiClient Api
@inject SessionState Session
@inject CrmLookups Lookups

<PageTitle>@Texts.Get("crm.salesTeam.title") · Modulix</PageTitle>

<AuthGate Module="@CrmAccess.ModuleKey" Permission="@SalesAccess.ReportsRead">
    <a class="back-link" href="crm/satis-analizi">← @Texts.Get("crm.salesAnalysis.title")</a>
    <div class="page-header">
        <div>
            <h1>@Texts.Get("crm.salesTeam.title")</h1>
            <p class="text-muted mb-0">
                @Texts.Get("crm.salesTeam.intro1")
                @Texts.Get("crm.salesTeam.intro2")
            </p>
        </div>
        <div class="header-actions">
            <a class="btn btn-outline-secondary" href="crm/veri-kalitesi">@Texts.Get("crm.dataQuality.title")</a>
        </div>
    </div>

    <div class="filters" role="group" aria-label="@Texts.Get("crm.sales.periodKind")">
        <div class="segmented">
            @foreach (var (key, label) in SalesLabels.PeriodKinds)
            {
                <button type="button" class="chip @(kind == key ? "active" : null)" aria-pressed="@(kind == key ? "true" : "false")" disabled="@loading" @onclick="() => ChooseKindAsync(key)">@label</button>
            }
        </div>
        <button type="button" class="btn btn-outline-secondary" disabled="@loading" @onclick="() => ShiftAsync(-1)">@Texts.Get("crm.sales.previousPeriod")</button>
        <button type="button" class="btn btn-outline-secondary" disabled="@loading" @onclick="TodayAsync">@Texts.Get("crm.sales.today")</button>
        <button type="button" class="btn btn-outline-secondary" disabled="@loading" @onclick="() => ShiftAsync(1)">@Texts.Get("crm.sales.nextPeriod")</button>
    </div>

    <form class="form-grid mb-3" @onsubmit="LoadAsync" @onsubmit:preventDefault aria-label="@Texts.Get("crm.salesTeam.filters")">
        <div class="span-3">
            <label class="form-label" for="st-date">@Texts.Get("crm.sales.anchorDay")</label>
            <input id="st-date" class="form-control" type="date" @bind="anchor" @bind:after="LoadAsync" />
        </div>
        <div class="span-3">
            <label class="form-label" for="st-currency">@Texts.Get("crm.sales.currency")</label>
            <input id="st-currency" class="form-control" maxlength="3" placeholder="@Regional.Currency" aria-describedby="st-currency-help" @bind="currency" @bind:after="LoadAsync" />
            <div id="st-currency-help" class="form-text">@Texts.Get("crm.sales.currencyHelp")</div>
        </div>
        <div class="span-4">
            <label class="form-label" for="st-owner">@Texts.Get("crm.sales.ownerFilter")</label>
            <select id="st-owner" class="form-select" @bind="owner" @bind:after="LoadAsync">
                <option value="">@Texts.Get("crm.sales.allUsers")</option>
                @foreach (var member in Lookups.Members)
                {
                    <option value="@member.UserId">@member.DisplayName</option>
                }
            </select>
        </div>
    </form>

    <AnalyticsStatus Loading="loading" Error="error" Forbidden="forbidden" OnRetry="LoadAsync" />

    @if (report is { } r)
    {
        <AnalyticsFrame T="List<TeamPerformanceRowDto>" Report="r">
            @if (r.Data.Count == 0)
            {
                <p class="text-muted">@Texts.Get("crm.salesTeam.empty")</p>
            }
            else
            {
                var rows = Sorted(r.Data);
                <div class="form-grid mb-2" role="group" aria-label="@Texts.Get("crm.salesTeam.sorting")">
                    <div class="span-4">
                        <label class="form-label" for="st-sort">@Texts.Get("crm.salesTeam.sort")</label>
                        <select id="st-sort" class="form-select" @bind="sortKey">
                            @foreach (var (key, label) in SortOptions)
                            {
                                <option value="@key">@label</option>
                            }
                        </select>
                    </div>
                    <div class="span-3">
                        <label class="form-label" for="st-dir">@Texts.Get("crm.salesTeam.direction")</label>
                        <select id="st-dir" class="form-select" @bind="descending">
                            <option value="True">@Texts.Get("crm.salesTeam.descending")</option>
                            <option value="False">@Texts.Get("crm.salesTeam.ascending")</option>
                        </select>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table record-table">
                        <caption class="visually-hidden">@Texts.Get("crm.salesTeam.caption", r.PeriodLabel)</caption>
                        <thead>
                            <tr>
                                <th scope="col" aria-sort="@AriaSort("name")"><button type="button" class="btn btn-link p-0" @onclick='() => SortBy("name")'>@Texts.Get("crm.salesTeam.col.user")@(Arrow("name"))</button></th>
                                <th scope="col" aria-sort="@AriaSort("realized")"><button type="button" class="btn btn-link p-0" @onclick='() => SortBy("realized")'>@Texts.Get("crm.sales-card.realized")@(Arrow("realized"))</button></th>
                                <th scope="col" aria-sort="@AriaSort("won")"><button type="button" class="btn btn-link p-0" @onclick='() => SortBy("won")'>@Texts.Get("crm.opportunityReport.won")@(Arrow("won"))</button></th>
                                <th scope="col" aria-sort="@AriaSort("lost")"><button type="button" class="btn btn-link p-0" @onclick='() => SortBy("lost")'>@Texts.Get("crm.opportunityReport.lost")@(Arrow("lost"))</button></th>
                                <th scope="col" aria-sort="@AriaSort("winrate")"><button type="button" class="btn btn-link p-0" @onclick='() => SortBy("winrate")'>@Texts.Get("crm.opportunityReport.winRate")@(Arrow("winrate"))</button></th>
                                <th scope="col" aria-sort="@AriaSort("open")"><button type="button" class="btn btn-link p-0" @onclick='() => SortBy("open")'>@Texts.Get("crm.salesTeam.col.open")@(Arrow("open"))</button></th>
                                <th scope="col" aria-sort="@AriaSort("pipeline")"><button type="button" class="btn btn-link p-0" @onclick='() => SortBy("pipeline")'>@Texts.Get("crm.sales-card.openpipeline")@(Arrow("pipeline"))</button></th>
                                <th scope="col" aria-sort="@AriaSort("weighted")"><button type="button" class="btn btn-link p-0" @onclick='() => SortBy("weighted")'>@Texts.Get("crm.opportunityReport.col.weighted")@(Arrow("weighted"))</button></th>
                                <th scope="col" aria-sort="@AriaSort("overdue")"><button type="button" class="btn btn-link p-0" @onclick='() => SortBy("overdue")'>@Texts.Get("crm.salesTeam.col.overdue")@(Arrow("overdue"))</button></th>
                                <th scope="col" aria-sort="@AriaSort("cycle")"><button type="button" class="btn btn-link p-0" @onclick='() => SortBy("cycle")'>@Texts.Get("crm.salesTeam.col.cycle")@(Arrow("cycle"))</button></th>
                                <th scope="col" aria-sort="@AriaSort("attainment")"><button type="button" class="btn btn-link p-0" @onclick='() => SortBy("attainment")'>@Texts.Get("crm.salesTeam.col.target")@(Arrow("attainment"))</button></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in rows)
                            {
                                var p = row.Performance;
                                <tr>
                                    <td data-label="@Texts.Get("crm.salesTeam.col.user")" class="primary">@SalesAnalysisLabels.Owner(Lookups, p.OwnerId)</td>
                                    <td data-label="@Texts.Get("crm.sales-card.realized")">
                                        @Money(p.Realized, r)
                                        @if (r.AmountsVisible && p.Realized.IsPartial)
                                        {
                                            <span class="badge stage-onhold">@Texts.Get("crm.sales.partial")</span>
                                            <br /><small class="text-muted">@SalesLabels.PartialHint(p.Realized)</small>
                                        }
                                    </td>
                                    <td data-label="@Texts.Get("crm.opportunityReport.won")">@SalesLabels.Count(p.WonCount)</td>
                                    <td data-label="@Texts.Get("crm.opportunityReport.lost")">@SalesLabels.Count(p.LostCount)</td>
                                    <td data-label="@Texts.Get("crm.opportunityReport.winRate")">@SalesAnalysisLabels.Rate(p.WinRatePercent)</td>
                                    <td data-label="@Texts.Get("crm.salesTeam.col.open")">@SalesLabels.Count(p.OpenCount)</td>
                                    <td data-label="@Texts.Get("crm.sales-card.openpipeline")">
                                        @Money(p.OpenPipeline, r)
                                        @if (r.AmountsVisible && p.OpenPipeline.IsPartial)
                                        {
                                            <br /><span class="badge stage-onhold">@Texts.Get("crm.sales.partial")</span>
                                        }
                                    </td>
                                    <td data-label="@Texts.Get("crm.opportunityReport.col.weighted")">
                                        @Money(p.WeightedOpen, r)
                                        @if (r.AmountsVisible && p.WeightedOpen.IsPartial)
                                        {
                                            <br /><span class="badge stage-onhold">@Texts.Get("crm.sales.partial")</span>
                                        }
                                    </td>
                                    <td data-label="@Texts.Get("crm.salesTeam.col.overdue")">@SalesLabels.Count(p.OverdueOpenCount)</td>
                                    <td data-label="@Texts.Get("crm.salesTeam.col.cycle")">
                                        @if (p.CycleSample == 0)
                                        {
                                            <text>@SalesAnalysisLabels.NoData</text>
                                        }
                                        else
                                        {
                                            <text>@Texts.Get("crm.salesTeam.cycleValue", SalesAnalysisLabels.Days(p.AverageCycleDays), SalesAnalysisLabels.Days(p.MedianCycleDays))</text>
                                        }
                                        <br /><small class="text-muted">
                                            @Texts.Get("crm.salesTeam.sample", p.CycleSample)
                                            @if (p.CycleSample > 0 && p.CycleSample < SmallSample)
                                            {
                                                <span class="badge tag">@Texts.Get("crm.salesTeam.smallSample")</span>
                                            }
                                        </small>
                                    </td>
                                    <td data-label="@Texts.Get("crm.salesTeam.col.target")">@TargetCell(row, r)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <p class="small text-muted mt-2">
                    @Texts.Get("crm.salesTeam.note1")
                    @Texts.Get("crm.salesTeam.note2", SmallSample)
                    @Texts.Get("crm.salesTeam.note3")
                </p>
            }
        </AnalyticsFrame>
    }
</AuthGate>

@code {
    // Bu adetin altındaki örneklemde döngü süresi güvenilir sayılmaz.
    private const int SmallSample = 5;

    private static IReadOnlyList<(string Key, string Label)> SortOptions =>
    [
        ("name", Texts.Get("crm.salesTeam.col.user")), ("realized", Texts.Get("crm.sales-card.realized")), ("won", Texts.Get("crm.salesTeam.sort.won")), ("lost", Texts.Get("crm.salesTeam.sort.lost")), ("winrate", Texts.Get("crm.opportunityReport.winRate")),
        ("open", Texts.Get("crm.dataQuality.open")), ("pipeline", Texts.Get("crm.sales-card.openpipeline")), ("weighted", Texts.Get("crm.opportunityReport.col.weighted")), ("overdue", Texts.Get("crm.salesTeam.col.overdue")), ("cycle", Texts.Get("crm.salesTeam.sort.cycle")),
        ("attainment", Texts.Get("crm.salesTeam.sort.attainment")),
    ];

    private string kind = SalesPeriodKinds.Month;
    private DateOnly anchor = DateOnly.FromDateTime(Regional.Now.DateTime);
    private string owner = string.Empty;
    private string currency = string.Empty;

    private AnalyticsDto<List<TeamPerformanceRowDto>>? report;
    private string? error;
    private bool forbidden;
    private bool loading;
    private int requestId;

    private string sortKey = "realized";
    private bool descending = true;

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (Session.Can(SalesAccess.ReportsRead))
        {
            await Lookups.LoadAsync();
            await LoadAsync();
        }
    }

    private static string Iso(DateOnly day) => day.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);

    private string BuildQuery()
    {
        var query = new List<string> { $"kind={kind}", $"date={Iso(anchor)}" };
        if (owner.Length > 0)
        {
            query.Add($"ownerId={Uri.EscapeDataString(owner)}");
        }

        // Yarım yazılmış para birimi gönderilmez (3 harf olunca uygulanır).
        if (currency.Trim().Length == 3)
        {
            query.Add($"currency={Uri.EscapeDataString(currency.Trim().ToUpperInvariant())}");
        }

        return string.Join('&', query);
    }

    private async Task LoadAsync()
    {
        var id = ++requestId;
        loading = true;
        error = null;
        forbidden = false;

        var result = await Api.GetAsync<AnalyticsDto<List<TeamPerformanceRowDto>>>($"/api/crm/sales/analytics/team?{BuildQuery()}");
        if (id != requestId)
        {
            return;
        }

        loading = false;
        report = result.IsSuccess ? result.Value : null;
        error = result.Error;
        forbidden = result.Status == HttpStatusCode.Forbidden;
    }

    private async Task ChooseKindAsync(string key)
    {
        kind = key;
        await LoadAsync();
    }

    private async Task ShiftAsync(int direction)
    {
        var (start, end) = report is { } r ? (r.PeriodStart, r.PeriodEnd) : SalesLabels.CalendarPeriod(kind, anchor);
        anchor = direction < 0 ? start.AddDays(-1) : end.AddDays(1);
        await LoadAsync();
    }

    private async Task TodayAsync()
    {
        anchor = DateOnly.FromDateTime(Regional.Now.DateTime);
        await LoadAsync();
    }

    private void SortBy(string key)
    {
        if (sortKey == key)
        {
            descending = !descending;
        }
        else
        {
            sortKey = key;
            descending = key != "name";
        }
    }

    private string AriaSort(string key) => sortKey != key ? "none" : descending ? "descending" : "ascending";

    private string Arrow(string key) => sortKey != key ? string.Empty : descending ? " ↓" : " ↑";

    private decimal? SortValue(TeamPerformanceRowDto row)
    {
        var p = row.Performance;
        return sortKey switch
        {
            "realized" => p.Realized.Amount,
            "won" => p.WonCount,
            "lost" => p.LostCount,
            "winrate" => p.WinRatePercent,
            "open" => p.OpenCount,
            "pipeline" => p.OpenPipeline.Amount,
            "weighted" => p.WeightedOpen.Amount,
            "overdue" => p.OverdueOpenCount,
            "cycle" => p.AverageCycleDays,
            "attainment" => row.Progress?.AttainmentPercent,
            _ => null,
        };
    }

    // Boş değerler (veri yok / hedef yok) yönden bağımsız olarak sonda kalır.
    private List<TeamPerformanceRowDto> Sorted(IReadOnlyList<TeamPerformanceRowDto> rows)
    {
        if (sortKey == "name")
        {
            // "Sorumlusuz" satırı yönden bağımsız sonda kalır.
            var byOwner = rows.OrderBy(x => x.Performance.OwnerId is null ? 1 : 0);
            return descending
                ? [.. byOwner.ThenByDescending(x => SalesAnalysisLabels.Owner(Lookups, x.Performance.OwnerId), StringComparer.CurrentCultureIgnoreCase)]
                : [.. byOwner.ThenBy(x => SalesAnalysisLabels.Owner(Lookups, x.Performance.OwnerId), StringComparer.CurrentCultureIgnoreCase)];
        }

        var withValue = rows.Where(x => SortValue(x) is not null);
        var ordered = descending ? withValue.OrderByDescending(x => SortValue(x)) : withValue.OrderBy(x => SortValue(x));
        return [.. ordered, .. rows.Where(x => SortValue(x) is null)];
    }

    private static string Money(MoneyTotalDto total, AnalyticsDto<List<TeamPerformanceRowDto>> r) =>
        r.AmountsVisible ? CrmLabels.Amount(total.Amount, r.Currency) : SalesAnalysisLabels.NoAmountPermission;

    private RenderFragment TargetCell(TeamPerformanceRowDto row, AnalyticsDto<List<TeamPerformanceRowDto>> r) => @<text>
        @if (!r.AmountsVisible)
        {
            <text>@SalesAnalysisLabels.NoAmountPermission</text>
        }
        else if (row.Target is not { } target || row.Progress is not { } progress)
        {
            <text>@Texts.Get("crm.salesTeam.noTarget")</text>
        }
        else
        {
            <text>@Texts.Get("crm.salesTeam.targetValue", CrmLabels.Amount(target, r.Currency))</text>
            <br /><text>@Texts.Get("crm.salesTeam.attainmentValue", SalesLabels.Percent(progress.AttainmentPercent))</text>
            <br />
            @if (progress.TargetMet)
            {
                <span class="badge stage-won">@Texts.Get("crm.salesTarget.met")</span>
            }
            else
            {
                <small class="text-muted">@Texts.Get("crm.salesTeam.remainingValue", CrmLabels.Amount(progress.Remaining, r.Currency), SalesAnalysisLabels.Ratio(progress.Coverage))</small>
            }
        }
    </text>;
}
