@page "/crm/satis-tahmini/{Id:guid}"
@using System.Globalization
@using System.Net
@inject ApiClient Api
@inject SessionState Session
@inject CrmLookups Lookups
@inject NavigationManager Navigation

<PageTitle>@Texts.Get("crm.salesForecasts.title") · Modulix</PageTitle>

<AuthGate Module="@CrmAccess.ModuleKey" Permission="@SalesAccess.ForecastsRead">
    <a class="back-link" href="crm/satis-tahmini">← @Texts.Get("crm.salesForecasts.caption")</a>

    @if (loading && detail is null)
    {
        <LoadingState />
    }

    @if (loadError is not null)
    {
        <div class="alert @(loadStatus == HttpStatusCode.Forbidden ? "alert-warning" : "alert-danger")" role="alert">
            @loadError
            @if (loadStatus is not (HttpStatusCode.Forbidden or HttpStatusCode.NotFound))
            {
                <button type="button" class="btn btn-outline-secondary btn-sm ms-2" disabled="@loading" @onclick="LoadAsync">@Texts.Get("crm.sales.retry")</button>
            }
        </div>
    }

    <Notice Text="@notice" />
    <Notice Text="@actionMessage" Failed="true" />

    @if (detail is not null)
    {
        var d = detail;
        var h = d.Header;
        var cap = d.Capabilities;
        var currency = h.ReportingCurrency;

        <div class="page-header">
            <div>
                <h1>@Texts.Get("crm.salesForecasts.title") <span class="badge stage-@SalesLabels.StatusBadge(h.Status)">@SalesLabels.Status(h.Status)</span></h1>
                <p class="text-muted mb-0">
                    @SalesLabels.PeriodKind(h.PeriodKind) · @SalesLabels.Period(h.PeriodStart, h.PeriodEnd) ·
                    @(h.ScopeType == SalesTargetScopes.User ? Texts.Get("crm.salesForecasts.userScope", Lookups.MemberName(h.ScopeUserId)) : Texts.Get("crm.sales-scope.tenant")) ·
                    @Texts.Get("crm.salesForecastDetail.currencyVersion", currency, h.VersionNo)
                </p>
            </div>
            <div class="header-actions">
                @if (cap.CanWrite)
                {
                    <button type="button" class="btn btn-outline-secondary" disabled="@busy" @onclick="RefreshAsync">@Texts.Get("crm.sales.refresh")</button>
                }
                @if (cap.CanSubmit)
                {
                    <button type="button" class="btn btn-primary" disabled="@busy" @onclick="SubmitAsync">@Texts.Get("crm.salesForecastDetail.submit")</button>
                }
                @if (cap.CanReturn)
                {
                    <button type="button" class="btn btn-outline-secondary" disabled="@busy" @onclick='() => StartPending("return")'>@Texts.Get("crm.salesForecastDetail.return")</button>
                }
                @if (cap.CanLock)
                {
                    <button type="button" class="btn btn-primary" disabled="@busy" @onclick='() => StartPending("lock")'>@Texts.Get("crm.salesForecastDetail.lock")</button>
                }
                @if (cap.CanReopen)
                {
                    <button type="button" class="btn btn-outline-secondary" disabled="@busy" @onclick='() => StartPending("reopen")'>@Texts.Get("crm.salesForecastDetail.reopen")</button>
                }
                @if (cap.CanDelete)
                {
                    <button type="button" class="btn btn-outline-danger" disabled="@busy" @onclick='() => StartPending("delete")'>@Texts.Get("common.delete")</button>
                }
            </div>
        </div>

        @if (pending is not null)
        {
            <form class="record-form" novalidate @onsubmit="ConfirmPendingAsync" @onsubmit:preventDefault aria-labelledby="sfd-pending-title">
                <h2 id="sfd-pending-title">@PendingTitle(pending)</h2>
                <ErrorSummary Errors="actionErrors" />
                @if (pending is "return" or "reopen")
                {
                    <p class="small text-muted">
                        @(pending == "return"
                            ? Texts.Get("crm.salesForecastDetail.returnHelp")
                            : Texts.Get("crm.salesForecastDetail.reopenHelp"))
                    </p>
                    <div>
                        <label class="form-label required" for="sfd-reason">@Texts.Get("crm.salesForecastDetail.reason")</label>
                        <textarea id="sfd-reason" class="form-control" rows="2" maxlength="500" required aria-required="true" @bind="reason"></textarea>
                        <FieldError Field="reason" Errors="actionErrors" />
                    </div>
                }
                else if (pending == "lock")
                {
                    <p>@Texts.Get("crm.salesForecastDetail.lockConfirm")</p>
                }
                else if (pending == "delete")
                {
                    <p>@Texts.Get("crm.salesForecastDetail.deleteConfirm")</p>
                }
                <div class="form-actions">
                    <button type="submit" class="btn @(pending == "delete" ? "btn-danger" : "btn-primary")" disabled="@busy">
                        @if (busy) { <span class="spinner-border spinner-border-sm" aria-hidden="true"></span> }
                        @PendingConfirmText(pending)
                    </button>
                    <button type="button" class="btn btn-outline-secondary" disabled="@busy" @onclick="CancelPending">@Texts.Get("common.dismiss")</button>
                </div>
            </form>
        }

        <dl class="detail-grid">
            <div><dt>@Texts.Get("crm.salesForecastDetail.refreshedAt")</dt><dd>@(h.RefreshedAt is { } refreshed ? CrmLabels.Time(refreshed) : "—")</dd></div>
            @if (h.SubmittedAt is { } submittedAt)
            {
                <div><dt>@SalesLabels.Status(ForecastStatuses.Submitted)</dt><dd>@CrmLabels.Time(submittedAt)@(h.SubmittedBy is { } submitter ? $" · {Lookups.MemberName(submitter)}" : null)</dd></div>
            }
            @if (h.LockedAt is { } lockedAt)
            {
                <div><dt>@SalesLabels.Status(ForecastStatuses.Locked)</dt><dd>@CrmLabels.Time(lockedAt)@(h.LockedBy is { } locker ? $" · {Lookups.MemberName(locker)}" : null)</dd></div>
            }
            @if (h.ReturnReason is not null)
            {
                <div><dt>@Texts.Get("crm.salesForecastDetail.returnReason")</dt><dd>@h.ReturnReason</dd></div>
            }
            @if (h.ReopenReason is not null)
            {
                <div><dt>@Texts.Get("crm.salesForecastDetail.reopenReason")</dt><dd>@h.ReopenReason</dd></div>
            }
            @if (h.PreviousSubmissionId is { } previousId)
            {
                <div><dt>@Texts.Get("crm.salesForecastDetail.previousVersion")</dt><dd><a href="crm/satis-tahmini/@previousId">@VersionText(previousId)</a></dd></div>
            }
        </dl>

        @if (d.Warnings.Count > 0)
        {
            <div class="alert alert-warning" role="status">
                <strong>@Texts.Get("crm.sales.warnings")</strong>
                <ul class="mb-0">
                    @foreach (var warning in d.Warnings)
                    {
                        <li>@warning</li>
                    }
                </ul>
            </div>
        }
        @if (!d.AmountsVisible)
        {
            <div class="alert alert-info" role="status">@Texts.Get("crm.salesForecastDetail.noAmounts")</div>
        }
        else if (!d.ItemsVisible)
        {
            <div class="alert alert-info" role="status">@Texts.Get("crm.salesForecastDetail.noItemsAccess")</div>
        }

        <section class="detail-section" aria-labelledby="sfd-scenarios">
            <div class="section-header"><h2 id="sfd-scenarios">@Texts.Get("crm.salesForecastDetail.scenarios")</h2></div>
            @if (d.Scenarios is { } s)
            {
                <div class="kpi-grid" role="group" aria-label="@Texts.Get("crm.salesForecastDetail.scenariosAria")">
                    <SalesKpiCard Label="@SalesLabels.Label(SalesLabels.Cards, SalesCards.Realized)" Icon="check-circle" Tone="success" Value="@CrmLabels.Amount(s.Realized, currency)"
                                  Detail="@(d.RealizedLive ? Texts.Get("crm.salesForecastDetail.realizedLive") : Texts.Get("crm.salesForecastDetail.realizedLocked"))"
                                  Partial="@h.RealizedPartial" PartialHint="@Texts.Get("crm.salesForecastDetail.realizedPartial")" />
                    <SalesKpiCard Label="@SalesLabels.Category(ForecastCategories.Commit)" Icon="target" Tone="info" Value="@CrmLabels.Amount(s.CommitScenario, currency)" Detail="@Texts.Get("crm.salesForecastDetail.commitDetail")" />
                    <SalesKpiCard Label="@Texts.Get("crm.salesForecastDetail.optimistic")" Icon="trending-up" Tone="brand" Value="@CrmLabels.Amount(s.OptimisticScenario, currency)" Detail="@Texts.Get("crm.salesForecastDetail.optimisticDetail")" />
                    <SalesKpiCard Label="@Texts.Get("crm.salesForecastDetail.weighted")" Icon="percent" Tone="brand" Value="@CrmLabels.Amount(s.WeightedScenario, currency)" Detail="@Texts.Get("crm.salesForecastDetail.weightedDetail")" />
                </div>
                <p class="small text-muted">
                    @Texts.Get("crm.salesForecastDetail.scenariosNote")
                </p>
            }
            else
            {
                <p class="text-muted">@Texts.Get("crm.salesForecastDetail.scenariosHidden")</p>
            }
        </section>

        <section class="detail-section" aria-labelledby="sfd-categories">
            <div class="section-header"><h2 id="sfd-categories">@Texts.Get("crm.salesForecastDetail.categories")</h2></div>
            @if (!d.AmountsVisible || d.ByCategory.Count == 0)
            {
                <p class="text-muted">@(d.AmountsVisible ? Texts.Get("crm.salesForecastDetail.noCategoryTotals") : Texts.Get("crm.salesForecastDetail.noAmountsShort"))</p>
            }
            else
            {
                <table class="table record-table">
                    <caption class="visually-hidden">@Texts.Get("crm.salesForecastDetail.categoriesCaption")</caption>
                    <thead><tr><th scope="col">@Texts.Get("crm.salesForecastDetail.col.category")</th><th scope="col">@Texts.Get("crm.opportunity.single")</th><th scope="col">@Texts.Get("crm.sales.col.amount")</th><th scope="col">@Texts.Get("crm.salesForecastDetail.col.weightedAmount")</th></tr></thead>
                    <tbody>
                        @foreach (var total in d.ByCategory)
                        {
                            <tr>
                                <td data-label="@Texts.Get("crm.salesForecastDetail.col.category")" class="primary"><span class="badge stage-@SalesLabels.CategoryBadge(total.Category)">@SalesLabels.Category(total.Category)</span></td>
                                <td data-label="@Texts.Get("crm.opportunity.single")">@total.Count</td>
                                <td data-label="@Texts.Get("crm.sales.col.amount")">@CrmLabels.Amount(total.Amount, currency)</td>
                                <td data-label="@Texts.Get("crm.salesForecastDetail.col.weightedAmount")">@CrmLabels.Amount(total.Weighted, currency)</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <p class="small text-muted">@Texts.Get("crm.salesForecastDetail.categoriesNote")</p>
            }
        </section>

        <section class="detail-section" aria-labelledby="sfd-note">
            <div class="section-header"><h2 id="sfd-note">@Texts.Get("crm.salesForecastDetail.note")</h2></div>
            @if (cap.CanWrite)
            {
                <form @onsubmit="SaveNoteAsync" @onsubmit:preventDefault>
                    <label class="form-label" for="sfd-note-text">@Texts.Get("crm.salesForecastDetail.noteLabel")</label>
                    <textarea id="sfd-note-text" class="form-control" rows="2" maxlength="1000" @bind="noteText"></textarea>
                    <FieldError Field="note" Errors="actionErrors" />
                    <div class="form-actions">
                        <button type="submit" class="btn btn-outline-primary btn-sm" disabled="@busy">@Texts.Get("crm.salesForecastDetail.saveNote")</button>
                    </div>
                </form>
            }
            else
            {
                <p>@(h.Note ?? Texts.Get("crm.salesForecastDetail.noNote"))</p>
            }
        </section>

        <section class="detail-section" aria-labelledby="sfd-accuracy">
            <div class="section-header"><h2 id="sfd-accuracy">@Texts.Get("crm.salesForecastDetail.accuracy")</h2></div>
            @if (d.Accuracy.State == "Ready")
            {
                var a = d.Accuracy;
                <p>
                    @Texts.Strong("crm.salesForecastDetail.horizonLine", Texts.Get("crm.sales.days", a.HorizonDays?.ToString() ?? "—"), a.Actual is { } actual ? CrmLabels.Amount(actual, currency) : "—")
                </p>
                <table class="table record-table">
                    <caption class="visually-hidden">@Texts.Get("crm.salesForecastDetail.varianceCaption")</caption>
                    <thead>
                        <tr><th scope="col">@Texts.Get("crm.salesForecastDetail.col.scenario")</th><th scope="col">@Texts.Get("crm.salesForecastDetail.col.forecast")</th><th scope="col">@SalesLabels.Label(SalesLabels.Cards, SalesCards.Realized)</th><th scope="col">@Texts.Get("crm.salesForecastDetail.col.error")</th><th scope="col">@Texts.Get("crm.salesForecastDetail.col.absError")</th><th scope="col">@Texts.Get("crm.salesForecastDetail.col.errorPercent")</th></tr>
                    </thead>
                    <tbody>
                        @VarianceRow(SalesLabels.Category(ForecastCategories.Commit), a.CommitScenario, currency)
                        @VarianceRow(Texts.Get("crm.salesForecastDetail.weighted"), a.WeightedScenario, currency)
                    </tbody>
                </table>
                <p class="small text-muted">@Texts.Get("crm.salesForecastDetail.errorNote")</p>
            }
            else if (d.Accuracy.State == "Pending")
            {
                <p class="text-muted">@(d.Accuracy.HorizonDays is { } horizon ? Texts.Get("crm.salesForecastDetail.accuracyPendingHorizon", horizon) : Texts.Get("crm.salesForecastDetail.accuracyPending"))</p>
            }
            else
            {
                <p class="text-muted">@Texts.Get("crm.salesForecastDetail.accuracyLockedOnly")</p>
            }
        </section>

        @if (adjusting is not null)
        {
            <form class="record-form" novalidate @onsubmit="AdjustAsync" @onsubmit:preventDefault aria-labelledby="sfd-adjust-title">
                <h2 id="sfd-adjust-title" tabindex="-1" @ref="adjustHeading">@Texts.Get("crm.salesForecastDetail.adjustTitle", adjusting.Number, adjusting.Title)</h2>
                <ErrorSummary Errors="actionErrors" />
                <div class="form-grid">
                    <div class="span-3">
                        <label class="form-label required" for="sfd-adj-kind">@Texts.Get("crm.salesForecastDetail.adjustKind")</label>
                        <select id="sfd-adj-kind" class="form-select" required aria-required="true" @bind="adjusting.Kind" @bind:after="AdjustKindChanged">
                            @foreach (var (key, label) in SalesLabels.AdjustmentKinds) { <option value="@key">@label</option> }
                        </select>
                        <FieldError Field="kind" Errors="actionErrors" />
                    </div>
                    <div class="span-3">
                        @if (adjusting.Kind == ForecastAdjustmentKinds.Category)
                        {
                            <label class="form-label required" for="sfd-adj-value">@Texts.Get("crm.salesForecastDetail.newCategory")</label>
                            <select id="sfd-adj-value" class="form-select" required aria-required="true" @bind="adjusting.CategoryValue">
                                @foreach (var (key, label) in SalesLabels.Categories) { <option value="@key">@label</option> }
                            </select>
                        }
                        else if (adjusting.Kind == ForecastAdjustmentKinds.Amount)
                        {
                            <label class="form-label" for="sfd-adj-value">@Texts.Get("crm.salesForecastDetail.amountDelta", currency)</label>
                            <input id="sfd-adj-value" class="form-control" type="number" step="0.01" inputmode="decimal" aria-describedby="sfd-adj-help" disabled="@(!adjusting.CanAdjustAmount)" @bind="adjusting.AmountValue" />
                            <div id="sfd-adj-help" class="form-text">
                                @(adjusting.CanAdjustAmount
                                    ? Texts.Get("crm.salesForecastDetail.amountHelp")
                                    : Texts.Get("crm.salesForecastDetail.amountBlocked"))
                            </div>
                        }
                        else
                        {
                            <label class="form-label" for="sfd-adj-value">@Texts.Get("crm.salesForecastDetail.probability")</label>
                            <input id="sfd-adj-value" class="form-control" type="number" min="0" max="100" step="1" inputmode="numeric" aria-describedby="sfd-adj-help" @bind="adjusting.ProbabilityValue" />
                            <div id="sfd-adj-help" class="form-text">@Texts.Get("crm.salesForecastDetail.probabilityHelp")</div>
                        }
                        <FieldError Field="value" Errors="actionErrors" />
                    </div>
                    <div class="span-6">
                        <label class="form-label required" for="sfd-adj-reason">@Texts.Get("crm.salesForecastDetail.reason")</label>
                        <input id="sfd-adj-reason" class="form-control" maxlength="500" required aria-required="true" @bind="adjusting.Reason" />
                        <FieldError Field="reason" Errors="actionErrors" />
                    </div>
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn btn-primary" disabled="@busy">
                        @if (busy) { <span class="spinner-border spinner-border-sm" aria-hidden="true"></span> }
                        @Texts.Get("crm.salesForecastDetail.saveAdjust")
                    </button>
                    <button type="button" class="btn btn-outline-secondary" disabled="@busy" @onclick="CancelAdjust">@Texts.Get("common.dismiss")</button>
                </div>
            </form>
        }

        <section class="detail-section" aria-labelledby="sfd-items">
            <div class="section-header"><h2 id="sfd-items">@Texts.Get("crm.salesForecastDetail.items", d.Items.Count)</h2></div>
            @if (!d.ItemsVisible)
            {
                <p class="text-muted">@Texts.Get("crm.salesForecastDetail.noItemsAccessShort")</p>
            }
            else if (d.Items.Count == 0)
            {
                <p class="text-muted">@Texts.Get("crm.salesForecastDetail.noItems")</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table record-table">
                        <caption class="visually-hidden">@Texts.Get("crm.salesForecastDetail.itemsCaption")</caption>
                        <thead>
                            <tr>
                                <th scope="col">@Texts.Get("crm.opportunity.single")</th><th scope="col">@Texts.Get("common.field.owner")</th><th scope="col">@Texts.Get("crm.opportunities.col.stage")</th><th scope="col">@Texts.Get("crm.salesForecastDetail.col.sourceAmount")</th><th scope="col">@Texts.Get("crm.salesForecastDetail.col.rate")</th>
                                <th scope="col">@Texts.Get("crm.salesForecastDetail.col.baseAmountIn", currency)</th><th scope="col">@Texts.Get("crm.salesForecastDetail.col.adjustment")</th><th scope="col">@Texts.Get("crm.salesForecastDetail.col.finalAmount")</th><th scope="col">@Texts.Get("crm.opportunities.col.probability")</th>
                                <th scope="col">@Texts.Get("crm.salesForecastDetail.col.category")</th><th scope="col">@Texts.Get("crm.salesForecastDetail.col.issues")</th>
                                @if (cap.CanWrite) { <th scope="col"><span class="visually-hidden">@Texts.Get("crm.lead.actions")</span></th> }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in d.Items)
                            {
                                <tr>
                                    <td data-label="@Texts.Get("crm.opportunity.single")" class="primary"><a href="crm/firsatlar/@item.OpportunityId">@item.OpportunityNumber</a><br /><small>@item.Title</small></td>
                                    <td data-label="@Texts.Get("common.field.owner")">
                                        @(item.CurrentOwnerId is null ? Texts.Get("crm.leads.unassigned") : Lookups.MemberName(item.CurrentOwnerId))
                                        @if (item.OwnerId != item.CurrentOwnerId)
                                        {
                                            <br /><small class="text-muted">@Texts.Get("crm.salesForecastDetail.ownerAtForecast", item.OwnerId is null ? Texts.Get("crm.leads.unassigned") : Lookups.MemberName(item.OwnerId))</small>
                                        }
                                    </td>
                                    <td data-label="@Texts.Get("crm.opportunities.col.stage")">@Lookups.Label(CrmLists.OpportunityStage, item.Stage)</td>
                                    <td data-label="@Texts.Get("crm.salesForecastDetail.col.sourceAmount")">@(item.SourceAmount is { } source ? CrmLabels.Amount(source, item.SourceCurrency) : "—")</td>
                                    <td data-label="@Texts.Get("crm.salesForecastDetail.col.rate")">
                                        @if (item.RateMissing)
                                        {
                                            <span class="badge stage-lost">@SalesLabels.Flag("MissingRate")</span>
                                        }
                                        else if (item.RateUsed is { } rate)
                                        {
                                            @rate.ToString("0.####", Regional.Numbers)
                                            @if (item.RateDate is { } rateDate)
                                            {
                                                <br /><small class="text-muted">@CrmLabels.Date(rateDate)</small>
                                            }
                                        }
                                        else
                                        {
                                            <text>—</text>
                                        }
                                    </td>
                                    <td data-label="@Texts.Get("crm.salesForecastDetail.col.baseAmount")">@(item.BaseAmount is { } baseAmount ? CrmLabels.Amount(baseAmount, currency) : "—")</td>
                                    <td data-label="@Texts.Get("crm.salesForecastDetail.col.adjustment")">@(item.AdjustmentAmount is { } delta ? $"{(delta > 0 ? "+" : null)}{CrmLabels.Amount(delta, currency)}" : "—")</td>
                                    <td data-label="@Texts.Get("crm.salesForecastDetail.col.finalAmount")">@(item.FinalAmount is { } final ? CrmLabels.Amount(final, currency) : "—")</td>
                                    <td data-label="@Texts.Get("crm.opportunities.col.probability")">
                                        @(item.EffectiveProbability is { } probability ? $"%{probability}" : "—")
                                        <br /><small class="text-muted">@SalesLabels.Source(item.ProbabilitySource)</small>
                                    </td>
                                    <td data-label="@Texts.Get("crm.salesForecastDetail.col.category")">
                                        <span class="badge stage-@SalesLabels.CategoryBadge(item.Category)">@SalesLabels.Category(item.Category)</span>
                                        @if (item.Category != item.BaseCategory)
                                        {
                                            <br /><small class="text-muted">@Texts.Get("crm.salesForecastDetail.defaultCategory", SalesLabels.Category(item.BaseCategory))</small>
                                        }
                                    </td>
                                    <td data-label="@Texts.Get("crm.salesForecastDetail.col.issues")">
                                        @if (item.Flags.Count == 0)
                                        {
                                            <text>—</text>
                                        }
                                        else
                                        {
                                            @foreach (var flag in item.Flags)
                                            {
                                                <span class="badge stage-lost">@SalesLabels.Flag(flag)</span>
                                            }
                                        }
                                    </td>
                                    @if (cap.CanWrite)
                                    {
                                        <td class="actions"><button type="button" class="btn btn-outline-primary btn-sm" disabled="@busy" aria-label="@Texts.Get("crm.salesForecastDetail.adjustAria", item.OpportunityNumber)" @onclick="() => StartAdjust(item)">@Texts.Get("crm.salesForecastDetail.adjust")</button></td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <section class="detail-section" aria-labelledby="sfd-history">
            <div class="section-header"><h2 id="sfd-history">@Texts.Get("crm.salesForecastDetail.history", d.Adjustments.Count)</h2></div>
            @if (d.Adjustments.Count == 0)
            {
                <EmptyState Title="@Texts.Get("crm.salesForecastDetail.noHistory")" />
            }
            else
            {
                <table class="table record-table">
                    <caption class="visually-hidden">@Texts.Get("crm.salesForecastDetail.historyCaption")</caption>
                    <thead><tr><th scope="col">@Texts.Get("crm.salesForecastDetail.col.time")</th><th scope="col">@Texts.Get("crm.sales-scope.user")</th><th scope="col">@Texts.Get("crm.opportunity.single")</th><th scope="col">@Texts.Get("common.field.kind")</th><th scope="col">@Texts.Get("crm.salesForecastDetail.col.before")</th><th scope="col">@Texts.Get("crm.salesForecastDetail.col.after")</th><th scope="col">@Texts.Get("crm.salesForecastDetail.reason")</th></tr></thead>
                    <tbody>
                        @foreach (var adjustment in d.Adjustments)
                        {
                            <tr>
                                <td data-label="@Texts.Get("crm.salesForecastDetail.col.time")">@CrmLabels.Time(adjustment.At)</td>
                                <td data-label="@Texts.Get("crm.sales-scope.user")">@(adjustment.ChangedBy is { } who ? Lookups.MemberName(who) : "—")</td>
                                <td data-label="@Texts.Get("crm.opportunity.single")">@OpportunityText(d, adjustment.OpportunityId)</td>
                                <td data-label="@Texts.Get("common.field.kind")">@SalesLabels.Label(SalesLabels.AdjustmentKinds, adjustment.Kind)</td>
                                <td data-label="@Texts.Get("crm.salesForecastDetail.col.before")">@AdjustmentValue(adjustment.Kind, adjustment.FromValue, currency)</td>
                                <td data-label="@Texts.Get("crm.salesForecastDetail.col.after")">@AdjustmentValue(adjustment.Kind, adjustment.ToValue, currency)</td>
                                <td data-label="@Texts.Get("crm.salesForecastDetail.reason")">@adjustment.Reason</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </section>

        <section class="detail-section" aria-labelledby="sfd-versions">
            <div class="section-header"><h2 id="sfd-versions">@Texts.Get("crm.salesForecastDetail.versions")</h2></div>
            @if (versions is null)
            {
                <p class="text-muted" role="status">@Texts.Get("crm.salesForecastDetail.versionsLoading")</p>
            }
            else
            {
                <ul class="item-list">
                    @foreach (var version in versions)
                    {
                        <li>
                            <div class="item-main">
                                @if (version.Id == Id)
                                {
                                    <strong aria-current="page">@Texts.Get("crm.salesForecastDetail.thisVersion", version.VersionNo)</strong>
                                }
                                else
                                {
                                    <a href="crm/satis-tahmini/@version.Id">@Texts.Get("crm.salesForecasts.versionNo", version.VersionNo)</a>
                                }
                                <span class="badge stage-@SalesLabels.StatusBadge(version.Status)">@SalesLabels.Status(version.Status)</span>
                                <span class="text-muted">@(version.ChangedAt is { } changed ? CrmLabels.Time(changed) : null)</span>
                            </div>
                        </li>
                    }
                </ul>
                @if (versions.Any(v => v.Id != Id))
                {
                    <form class="form-grid" @onsubmit="CompareAsync" @onsubmit:preventDefault aria-label="@Texts.Get("crm.salesForecastDetail.compareAria")">
                        <div class="span-4">
                            <label class="form-label" for="sfd-against">@Texts.Get("crm.salesForecastDetail.compareWith")</label>
                            <select id="sfd-against" class="form-select" @bind="against">
                                @foreach (var version in versions.Where(v => v.Id != Id))
                                {
                                    <option value="@version.Id">@Texts.Get("crm.salesForecasts.versionNo", version.VersionNo) · @SalesLabels.Status(version.Status)</option>
                                }
                            </select>
                        </div>
                        <div class="span-3">
                            <label class="form-label" for="sfd-compare-go">&nbsp;</label>
                            <button id="sfd-compare-go" type="submit" class="btn btn-outline-secondary" disabled="@comparing">@Texts.Get("crm.salesForecastDetail.compare")</button>
                        </div>
                    </form>
                }
                else
                {
                    <p class="text-muted">@Texts.Get("crm.salesForecastDetail.noOtherVersion")</p>
                }
            }

            @if (comparing)
            {
                <p class="text-muted" role="status">@Texts.Get("crm.salesForecastDetail.comparing")</p>
            }

            @if (compareError is not null)
            {
                <div class="alert alert-danger" role="alert">
                    @compareError
                    <button type="button" class="btn btn-outline-secondary btn-sm ms-2" disabled="@comparing" @onclick="CompareAsync">@Texts.Get("crm.sales.retry")</button>
                </div>
            }

            @if (comparison is { } c)
            {
                <h3 class="h5 mt-3" id="sfd-compare-title" tabindex="-1" @ref="compareHeading">@Texts.Get("crm.salesForecastDetail.compareTitle", c.PreviousVersionNo, c.CurrentVersionNo)</h3>
                <p class="small text-muted">@Texts.Get("crm.salesForecastDetail.compareSummary", c.Added.Count, c.Removed.Count, c.AmountChanged.Count, c.CategoryChanged.Count)</p>

                <h4 class="h6">@Texts.Get("crm.salesForecastDetail.added", c.Added.Count)</h4>
                @if (c.Added.Count == 0) { <EmptyState Compact="true" Title="@Texts.Get("crm.salesForecastDetail.none")" /> }
                else
                {
                    <table class="table record-table">
                        <caption class="visually-hidden">@Texts.Get("crm.salesForecastDetail.addedCaption")</caption>
                        <thead><tr><th scope="col">@Texts.Get("crm.opportunity.single")</th>@if (c.AmountsVisible) { <th scope="col">@Texts.Get("crm.sales.col.amount")</th> }<th scope="col">@Texts.Get("crm.salesForecastDetail.col.category")</th></tr></thead>
                        <tbody>
                            @foreach (var e in c.Added)
                            {
                                <tr>
                                    <td data-label="@Texts.Get("crm.opportunity.single")" class="primary"><a href="crm/firsatlar/@e.OpportunityId">@e.OpportunityNumber</a> · @e.Title</td>
                                    @if (c.AmountsVisible) { <td data-label="@Texts.Get("crm.sales.col.amount")">@AmountOrDash(e.AfterAmount, currency)</td> }
                                    <td data-label="@Texts.Get("crm.salesForecastDetail.col.category")">@CategoryOrDash(e.AfterCategory)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }

                <h4 class="h6">@Texts.Get("crm.salesForecastDetail.removed", c.Removed.Count)</h4>
                @if (c.Removed.Count == 0) { <EmptyState Compact="true" Title="@Texts.Get("crm.salesForecastDetail.none")" /> }
                else
                {
                    <table class="table record-table">
                        <caption class="visually-hidden">@Texts.Get("crm.salesForecastDetail.removedCaption")</caption>
                        <thead><tr><th scope="col">@Texts.Get("crm.opportunity.single")</th>@if (c.AmountsVisible) { <th scope="col">@Texts.Get("crm.salesForecastDetail.col.beforeAmount")</th> }<th scope="col">@Texts.Get("crm.salesForecastDetail.col.beforeCategory")</th><th scope="col">@Texts.Get("crm.salesForecastDetail.col.reason")</th></tr></thead>
                        <tbody>
                            @foreach (var e in c.Removed)
                            {
                                <tr>
                                    <td data-label="@Texts.Get("crm.opportunity.single")" class="primary"><a href="crm/firsatlar/@e.OpportunityId">@e.OpportunityNumber</a> · @e.Title</td>
                                    @if (c.AmountsVisible) { <td data-label="@Texts.Get("crm.salesForecastDetail.col.beforeAmount")">@AmountOrDash(e.BeforeAmount, currency)</td> }
                                    <td data-label="@Texts.Get("crm.salesForecastDetail.col.beforeCategory")">@CategoryOrDash(e.BeforeCategory)</td>
                                    <td data-label="@Texts.Get("crm.salesForecastDetail.col.reason")"><span class="badge stage-@OutcomeBadge(e.Outcome)">@SalesLabels.Outcome(e.Outcome)</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }

                <h4 class="h6">@Texts.Get("crm.salesForecastDetail.amountChanged", c.AmountChanged.Count)</h4>
                @if (c.AmountChanged.Count == 0) { <EmptyState Compact="true" Title="@Texts.Get("crm.salesForecastDetail.none")" /> }
                else
                {
                    <table class="table record-table">
                        <caption class="visually-hidden">@Texts.Get("crm.salesForecastDetail.amountChangedCaption")</caption>
                        <thead><tr><th scope="col">@Texts.Get("crm.opportunity.single")</th><th scope="col">@Texts.Get("crm.salesForecastDetail.col.beforeAmount")</th><th scope="col">@Texts.Get("crm.salesForecastDetail.col.afterAmount")</th></tr></thead>
                        <tbody>
                            @foreach (var e in c.AmountChanged)
                            {
                                <tr>
                                    <td data-label="@Texts.Get("crm.opportunity.single")" class="primary"><a href="crm/firsatlar/@e.OpportunityId">@e.OpportunityNumber</a> · @e.Title</td>
                                    <td data-label="@Texts.Get("crm.salesForecastDetail.col.beforeAmount")">@(c.AmountsVisible ? AmountOrDash(e.BeforeAmount, currency) : "—")</td>
                                    <td data-label="@Texts.Get("crm.salesForecastDetail.col.afterAmount")">@(c.AmountsVisible ? AmountOrDash(e.AfterAmount, currency) : "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }

                <h4 class="h6">@Texts.Get("crm.salesForecastDetail.categoryChanged", c.CategoryChanged.Count)</h4>
                @if (c.CategoryChanged.Count == 0) { <EmptyState Compact="true" Title="@Texts.Get("crm.salesForecastDetail.none")" /> }
                else
                {
                    <table class="table record-table">
                        <caption class="visually-hidden">@Texts.Get("crm.salesForecastDetail.categoryChangedCaption")</caption>
                        <thead><tr><th scope="col">@Texts.Get("crm.opportunity.single")</th><th scope="col">@Texts.Get("crm.salesForecastDetail.col.beforeCategory")</th><th scope="col">@Texts.Get("crm.salesForecastDetail.newCategory")</th></tr></thead>
                        <tbody>
                            @foreach (var e in c.CategoryChanged)
                            {
                                <tr>
                                    <td data-label="@Texts.Get("crm.opportunity.single")" class="primary"><a href="crm/firsatlar/@e.OpportunityId">@e.OpportunityNumber</a> · @e.Title</td>
                                    <td data-label="@Texts.Get("crm.salesForecastDetail.col.beforeCategory")">@CategoryOrDash(e.BeforeCategory)</td>
                                    <td data-label="@Texts.Get("crm.salesForecastDetail.newCategory")">@CategoryOrDash(e.AfterCategory)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            }
        </section>

        <details class="detail-section">
            <summary><strong>@Texts.Get("crm.sales.definitions")</strong></summary>
            <ul class="small text-muted mt-2">
                @foreach (var definition in d.Definitions)
                {
                    <li>@definition</li>
                }
            </ul>
        </details>
    }
</AuthGate>

@code {
    private const string BaseUrl = "/api/crm/sales/forecasts";

    [Parameter] public Guid Id { get; set; }

    private Guid loadedId;
    private ForecastDetailDto? detail;
    private IReadOnlyList<ForecastHeaderDto>? versions;
    private string? loadError;
    private HttpStatusCode loadStatus;
    private bool loading;
    private bool busy;
    private int requestId;

    private string? notice;
    private bool keepNotice;
    private string? actionMessage;
    private IReadOnlyDictionary<string, string[]>? actionErrors;

    private string? pending;
    private string reason = string.Empty;
    private string noteText = string.Empty;

    private AdjustForm? adjusting;
    private bool focusAdjust;
    private ElementReference adjustHeading;

    private string against = string.Empty;
    private ForecastComparisonDto? comparison;
    private string? compareError;
    private bool comparing;
    private bool focusCompare;
    private ElementReference compareHeading;

    private bool lookupsLoaded;

    protected override async Task OnParametersSetAsync()
    {
        if (loadedId == Id)
        {
            return;
        }

        loadedId = Id;
        await Session.EnsureLoadedAsync();
        if (!Session.Can(SalesAccess.ForecastsRead))
        {
            return;
        }

        if (!lookupsLoaded)
        {
            await Lookups.LoadAsync();
            lookupsLoaded = true;
        }

        if (!keepNotice)
        {
            notice = null;
        }

        keepNotice = false;
        actionMessage = null;
        actionErrors = null;
        pending = null;
        adjusting = null;
        comparison = null;
        compareError = null;
        detail = null;
        versions = null;
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusAdjust && adjusting is not null)
        {
            focusAdjust = false;
            await adjustHeading.FocusAsync();
        }
        else if (focusCompare && comparison is not null)
        {
            focusCompare = false;
            await compareHeading.FocusAsync();
        }
    }

    private async Task LoadAsync()
    {
        var id = ++requestId;
        loading = true;
        loadError = null;
        var result = await Api.GetAsync<ForecastDetailDto>($"{BaseUrl}/{Id}");
        if (id != requestId)
        {
            return;
        }

        loading = false;
        if (!result.IsSuccess || result.Value is null)
        {
            loadStatus = result.Status;
            loadError = result.Status == HttpStatusCode.NotFound ? Texts.Get("crm.salesForecastDetail.notFound") : result.Error;
            return;
        }

        Apply(result.Value);
        await LoadVersionsAsync();
    }

    private void Apply(ForecastDetailDto value)
    {
        detail = value;
        noteText = value.Header.Note ?? string.Empty;
    }

    private async Task LoadVersionsAsync()
    {
        if (detail is null)
        {
            return;
        }

        var h = detail.Header;
        var result = await Api.GetAsync<List<ForecastHeaderDto>>($"{BaseUrl}?from={Iso(h.PeriodStart)}&to={Iso(h.PeriodEnd)}");
        versions = (result.Value ?? [])
            .Where(v => v.PeriodStart == h.PeriodStart && v.PeriodEnd == h.PeriodEnd && v.ScopeType == h.ScopeType && v.ScopeUserId == h.ScopeUserId && v.ReportingCurrency == h.ReportingCurrency)
            .OrderByDescending(v => v.VersionNo)
            .ToList();

        var others = versions.Where(v => v.Id != Id).ToList();
        against = others.Any(v => v.Id == h.PreviousSubmissionId)
            ? h.PreviousSubmissionId!.Value.ToString()
            : others.FirstOrDefault()?.Id.ToString() ?? string.Empty;
    }

    private static string Iso(DateOnly day) => day.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);

    private string VersionText(Guid versionId) =>
        versions?.FirstOrDefault(v => v.Id == versionId) is { } v ? Texts.Get("crm.salesForecasts.versionNo", v.VersionNo) : Texts.Get("crm.salesForecastDetail.previousVersion");

    // ---- Eylemler

    private long? Version => detail?.Header.Version;

    private async Task RunAsync(Func<Task<ApiResult<ForecastDetailDto>>> call, string done)
    {
        if (busy)
        {
            return;
        }

        busy = true;
        notice = null;
        actionMessage = null;
        actionErrors = null;
        var result = await call();
        busy = false;

        if (result.IsSuccess && result.Value is { } updated)
        {
            pending = null;
            adjusting = null;
            reason = string.Empty;
            comparison = null;
            notice = done;
            if (updated.Header.Id != Id)
            {
                // Yeniden açma yeni sürüm üretir: yeni sürümün sayfasına geçilir.
                keepNotice = true;
                Navigation.NavigateTo($"crm/satis-tahmini/{updated.Header.Id}");
                return;
            }

            Apply(updated);
            await LoadVersionsAsync();
            return;
        }

        if (result.Status == HttpStatusCode.Conflict)
        {
            // Eşzamanlı değişiklik (ya da durum kuralı): güncel hali yeniden yükle ve bildir.
            pending = null;
            adjusting = null;
            var fresh = await Api.GetAsync<ForecastDetailDto>($"{BaseUrl}/{Id}");
            if (fresh.IsSuccess && fresh.Value is not null)
            {
                Apply(fresh.Value);
                await LoadVersionsAsync();
            }

            actionMessage = Texts.Get("crm.salesForecastDetail.conflict", result.Error);
            return;
        }

        actionErrors = result.FieldErrors;
        actionMessage = result.FieldErrors.Count == 0 ? result.Error : null;
    }

    private Task RefreshAsync() =>
        RunAsync(() => Api.PostAsync<ForecastDetailDto>($"{BaseUrl}/{Id}/refresh", new ForecastVersionRequestDto(Version)), Texts.Get("crm.salesForecastDetail.refreshed"));

    private Task SubmitAsync() =>
        RunAsync(() => Api.PostAsync<ForecastDetailDto>($"{BaseUrl}/{Id}/submit", new ForecastVersionRequestDto(Version)), Texts.Get("crm.salesForecastDetail.submitted"));

    private Task SaveNoteAsync() =>
        RunAsync(() => Api.PutAsync<ForecastDetailDto>($"{BaseUrl}/{Id}/note", new ForecastNoteRequestDto(string.IsNullOrWhiteSpace(noteText) ? null : noteText.Trim(), Version)), Texts.Get("crm.salesForecastDetail.noteSaved"));

    private void StartPending(string action)
    {
        pending = action;
        reason = string.Empty;
        actionErrors = null;
        actionMessage = null;
        notice = null;
        adjusting = null;
    }

    private void CancelPending()
    {
        pending = null;
        actionErrors = null;
    }

    private static string PendingTitle(string action) => action switch
    {
        "return" => Texts.Get("crm.salesForecastDetail.returnTitle"),
        "lock" => Texts.Get("crm.salesForecastDetail.lockTitle"),
        "reopen" => Texts.Get("crm.salesForecastDetail.reopenTitle"),
        _ => Texts.Get("crm.salesForecastDetail.deleteTitle"),
    };

    private static string PendingConfirmText(string action) => action switch
    {
        "return" => Texts.Get("crm.salesForecastDetail.return"),
        "lock" => Texts.Get("crm.salesForecastDetail.lockYes"),
        "reopen" => Texts.Get("crm.salesForecastDetail.reopenAsNew"),
        _ => Texts.Get("common.view.deleteYes"),
    };

    private Task ConfirmPendingAsync() => pending switch
    {
        "return" => RunAsync(() => Api.PostAsync<ForecastDetailDto>($"{BaseUrl}/{Id}/return", new ForecastReasonRequestDto(reason.Trim(), Version)), Texts.Get("crm.salesForecastDetail.returned")),
        "lock" => RunAsync(() => Api.PostAsync<ForecastDetailDto>($"{BaseUrl}/{Id}/lock", new ForecastVersionRequestDto(Version)), Texts.Get("crm.salesForecastDetail.locked")),
        "reopen" => RunAsync(() => Api.PostAsync<ForecastDetailDto>($"{BaseUrl}/{Id}/reopen", new ForecastReasonRequestDto(reason.Trim(), Version)), Texts.Get("crm.salesForecastDetail.reopened")),
        "delete" => DeleteAsync(),
        _ => Task.CompletedTask,
    };

    private async Task DeleteAsync()
    {
        if (busy)
        {
            return;
        }

        busy = true;
        actionMessage = null;
        var result = await Api.DeleteAsync($"{BaseUrl}/{Id}?version={Version}");
        busy = false;

        if (result.IsSuccess)
        {
            Navigation.NavigateTo("crm/satis-tahmini");
            return;
        }

        pending = null;
        actionMessage = result.Status == HttpStatusCode.Conflict
            ? Texts.Get("crm.salesForecastDetail.deleteConflict", result.Error)
            : result.Error;
        if (result.Status == HttpStatusCode.Conflict)
        {
            await LoadAsync();
        }
    }

    // ---- Düzeltme

    private void StartAdjust(ForecastItemDto item)
    {
        pending = null;
        actionErrors = null;
        actionMessage = null;
        notice = null;
        adjusting = new AdjustForm
        {
            ItemId = item.Id,
            Number = item.OpportunityNumber,
            Title = item.Title,
            CanAdjustAmount = item.BaseAmount is not null,
            CurrentCategory = item.Category,
            CurrentAmount = item.AdjustmentAmount,
            CurrentProbability = item.ProbabilityOverride,
            Kind = ForecastAdjustmentKinds.Category,
            CategoryValue = item.Category,
        };
        focusAdjust = true;
    }

    private void AdjustKindChanged()
    {
        if (adjusting is null)
        {
            return;
        }

        adjusting.CategoryValue = adjusting.CurrentCategory;
        adjusting.AmountValue = adjusting.CurrentAmount;
        adjusting.ProbabilityValue = adjusting.CurrentProbability;
    }

    private void CancelAdjust()
    {
        adjusting = null;
        actionErrors = null;
    }

    private Task AdjustAsync()
    {
        if (adjusting is not { } form)
        {
            return Task.CompletedTask;
        }

        var value = form.Kind switch
        {
            ForecastAdjustmentKinds.Category => form.CategoryValue,
            ForecastAdjustmentKinds.Amount => form.AmountValue?.ToString(CultureInfo.InvariantCulture),
            _ => form.ProbabilityValue?.ToString(CultureInfo.InvariantCulture),
        };

        return RunAsync(
            () => Api.PostAsync<ForecastDetailDto>($"{BaseUrl}/{Id}/adjust", new AdjustForecastRequestDto(form.ItemId, form.Kind, value, form.Reason.Trim(), Version)),
            Texts.Get("crm.salesForecastDetail.adjusted"));
    }

    // ---- Karşılaştırma

    private async Task CompareAsync()
    {
        if (comparing || !Guid.TryParse(against, out var againstId))
        {
            return;
        }

        comparing = true;
        compareError = null;
        comparison = null;
        var result = await Api.GetAsync<ForecastComparisonDto>($"{BaseUrl}/{Id}/compare?against={againstId}");
        comparing = false;
        comparison = result.Value;
        compareError = result.Error;
        focusCompare = comparison is not null;
    }

    // ---- Gösterim yardımcıları

    private static string AmountOrDash(decimal? amount, string currency) => amount is { } value ? CrmLabels.Amount(value, currency) : "—";

    private static string CategoryOrDash(string? category) => category is null ? "—" : SalesLabels.Category(category);

    private static string OutcomeBadge(string? outcome) => outcome switch
    {
        "Won" => "won",
        "Lost" => "lost",
        "Cancelled" => "cancelled",
        "OnHold" or "Postponed" => "onhold",
        _ => "open",
    };

    private static string OpportunityText(ForecastDetailDto d, Guid opportunityId) =>
        d.Items.FirstOrDefault(i => i.OpportunityId == opportunityId) is { } item ? $"{item.OpportunityNumber} · {item.Title}" : "—";

    private static string AdjustmentValue(string kind, string? value, string currency)
    {
        if (string.IsNullOrEmpty(value))
        {
            return Texts.Get("crm.salesForecastDetail.emptyValue");
        }

        return kind switch
        {
            ForecastAdjustmentKinds.Category => SalesLabels.Category(value),
            ForecastAdjustmentKinds.Probability => $"%{value}",
            _ => decimal.TryParse(value, NumberStyles.Number, CultureInfo.InvariantCulture, out var amount) ? CrmLabels.Amount(amount, currency) : value,
        };
    }

    private static RenderFragment VarianceRow(string label, ForecastVarianceDto? variance, string currency) => builder =>
    {
        if (variance is null)
        {
            return;
        }

        var seq = 0;
        builder.OpenElement(seq++, "tr");
        Cell(builder, ref seq, Texts.Get("crm.salesForecastDetail.col.scenario"), label, "primary");
        Cell(builder, ref seq, Texts.Get("crm.salesForecastDetail.col.forecast"), CrmLabels.Amount(variance.Forecast, currency));
        Cell(builder, ref seq, SalesLabels.Label(SalesLabels.Cards, SalesCards.Realized), CrmLabels.Amount(variance.Actual, currency));
        Cell(builder, ref seq, Texts.Get("crm.salesForecastDetail.col.error"), $"{(variance.Error > 0 ? "+" : null)}{CrmLabels.Amount(variance.Error, currency)}");
        Cell(builder, ref seq, Texts.Get("crm.salesForecastDetail.col.absError"), CrmLabels.Amount(variance.AbsoluteError, currency));
        Cell(builder, ref seq, Texts.Get("crm.salesForecastDetail.col.errorPercent"), variance.ErrorPercent is { } percent ? $"{(percent > 0 ? "+" : null)}{SalesLabels.Percent(percent)}" : Texts.Get("crm.salesForecastDetail.notCalculated"));
        builder.CloseElement();
    };

    private static void Cell(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder builder, ref int seq, string label, string text, string? css = null)
    {
        builder.OpenElement(seq++, "td");
        builder.AddAttribute(seq++, "data-label", label);
        if (css is not null)
        {
            builder.AddAttribute(seq++, "class", css);
        }

        builder.AddContent(seq++, text);
        builder.CloseElement();
    }

    private sealed class AdjustForm
    {
        public Guid ItemId { get; init; }

        public string Number { get; init; } = string.Empty;

        public string Title { get; init; } = string.Empty;

        public bool CanAdjustAmount { get; init; }

        public string CurrentCategory { get; init; } = string.Empty;

        public decimal? CurrentAmount { get; init; }

        public int? CurrentProbability { get; init; }

        public string Kind { get; set; } = ForecastAdjustmentKinds.Category;

        public string CategoryValue { get; set; } = string.Empty;

        public decimal? AmountValue { get; set; }

        public int? ProbabilityValue { get; set; }

        public string Reason { get; set; } = string.Empty;
    }
}
