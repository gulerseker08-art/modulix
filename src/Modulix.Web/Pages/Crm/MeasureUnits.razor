@page "/crm/birimler"
@inject ApiClient Api
@inject SessionState Session

<PageTitle>@Texts.Get("crm.measureUnits.title") · Modulix</PageTitle>

<AuthGate Module="@CrmAccess.ModuleKey" Permission="@CrmAccess.ProductsRead">
    <div class="page-header">
        <h1>@Texts.Get("crm.measureUnits.title")</h1>
        @if (Session.Can(CrmAccess.ProductsWrite) && form is null)
        {
            <button type="button" class="btn btn-primary" @onclick="() => form = new()">@Texts.Get("crm.measureUnits.new")</button>
        }
    </div>

    <p class="text-muted">@Texts.Get("crm.measureUnits.intro")</p>

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }

    @if (form is not null)
    {
        <form class="record-form" novalidate @onsubmit="SaveAsync" @onsubmit:preventDefault>
            <h2>@(form.Id is null ? Texts.Get("crm.measureUnits.new") : Texts.Get("crm.measureUnits.edit"))</h2>
            <FormTabs Title="@Texts.Get("crm.measureUnits.info")" Label="@Texts.Get("crm.measureUnits.formSections")">
            <div class="form-grid">
                <div>
                    <label class="form-label" for="code">@Texts.Get("crm.products.field.code")</label>
                    <input id="code" class="form-control" maxlength="20" @bind="form.Code" />
                    <FieldError Field="code" Errors="errors" />
                </div>
                <div>
                    <label class="form-label" for="name">@Texts.Get("common.field.nameRequired")</label>
                    <input id="name" class="form-control" maxlength="100" @bind="form.Name" />
                    <FieldError Field="name" Errors="errors" />
                </div>
                <div>
                    <label class="form-label" for="group">@Texts.Get("crm.measureUnits.field.group")</label>
                    <select id="group" class="form-select" @bind="form.GroupKey">
                        @foreach (var group in CatalogLabels.UnitGroups)
                        {
                            <option value="@group.Key">@group.Label</option>
                        }
                    </select>
                    <FieldError Field="groupKey" Errors="errors" />
                </div>
                <div>
                    <label class="form-label" for="factor">@Texts.Get("crm.measureUnits.field.factor")</label>
                    <input id="factor" class="form-control" type="number" step="any" min="0" @bind="form.Factor" />
                    <FieldError Field="factorToBase" Errors="errors" />
                </div>
            </div>
            </FormTabs>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary" disabled="@busy">@Texts.Get("common.save")</button>
                <button type="button" class="btn btn-outline-secondary" @onclick="() => form = null">@Texts.Get("common.dismiss")</button>
                @if (form.Id is not null)
                {
                    <button type="button" class="btn btn-outline-danger ms-auto" disabled="@busy" @onclick="DeleteAsync">@Texts.Get("common.delete")</button>
                }
            </div>
        </form>
    }

    @if (page is null)
    {
        <LoadingState Kind="LoadingKind.Table" />
    }
    else if (page.Items.Count == 0)
    {
        <EmptyState Title="@Texts.Get("crm.measureUnits.none")" />
    }
    else
    {
        <table class="table record-table">
            <thead>
                <tr>
                    <th scope="col"><SortHeader Label="@Texts.Get("crm.products.col.code")" ColumnIcon="hash" Asc="code" Desc="-code" Value="@sort" Default="" ValueChanged="SortAsync" /></th>
                    <th scope="col"><SortHeader Label="@Texts.Get("common.field.name")" ColumnIcon="type" Asc="name" Desc="-name" Value="@sort" Default="" ValueChanged="SortAsync" /></th>
                    <th scope="col"><SortHeader Label="@Texts.Get("crm.measureUnits.col.group")" ColumnIcon="tag" Asc="groupKey" Desc="-groupKey" Value="@sort" Default="" ValueChanged="SortAsync" /></th>
                    <th scope="col"><SortHeader Label="@Texts.Get("crm.measureUnits.col.factor")" ColumnIcon="percent" Asc="factorToBase" Desc="-factorToBase" Value="@sort" Default="" ValueChanged="SortAsync" /></th>
                    <th scope="col" class="row-menu-cell"><span class="visually-hidden">@Texts.Get("common.actions")</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var unit in page.Items)
                {
                    <tr>
                        <td data-label="@Texts.Get("crm.products.col.code")" class="primary">@unit.Code</td>
                        <td data-label="@Texts.Get("common.field.name")">@unit.Name</td>
                        <td data-label="@Texts.Get("crm.measureUnits.col.group")">@CatalogLabels.Label(CatalogLabels.UnitGroups, unit.GroupKey)</td>
                        <td data-label="@Texts.Get("crm.measureUnits.col.factor")">@unit.FactorToBase.ToString("0.######")</td>
                        <td class="row-menu-cell">
                            @if (Session.Can(CrmAccess.ProductsWrite))
                            {
                                <RowMenu Label="@Texts.Get("common.rowActionsOf", unit.Name)">
                                    <button type="button" class="view-menu-item" role="menuitem" @onclick="() => Edit(unit)"><AppIcon Name="pencil" Size="16" /> <span>@Texts.Get("common.edit")</span></button>
                                </RowMenu>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager PageSizeChoice="true" Page="page.Page" PageSize="page.PageSize" TotalCount="page.TotalCount" PageChanged="LoadAsync" />
    }
</AuthGate>

@code {
    private const string Url = "/api/crm/units";

    private CrmPage<MeasureUnitDto>? page;
    private UnitForm? form;
    private IReadOnlyDictionary<string, string[]>? errors;
    private string? message;
    private bool busy;

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (Session.Can(CrmAccess.ProductsRead))
        {
            await LoadAsync(1);
        }
    }

    private async Task LoadAsync(int pageNumber)
    {
        var result = await Api.GetAsync<CrmPage<MeasureUnitDto>>($"{Url}?page={pageNumber}&pageSize={ListPaging.Size}{(sort.Length == 0 ? "" : "&sort=" + Uri.EscapeDataString(sort))}");
        page = result.Value;
        message = result.Error;
    }

    // Sıralama sunucudadır (MeasureUnitRecordStore.SortKeys); boş değer varsayılan sıradır (grup, kod).
    private string sort = "";

    private async Task SortAsync(string value)
    {
        sort = value;
        await LoadAsync(1);
    }

    private void Edit(MeasureUnitDto unit)
    {
        form = new UnitForm { Id = unit.Id, Version = unit.Version, Code = unit.Code, Name = unit.Name, GroupKey = unit.GroupKey, Factor = unit.FactorToBase };
        errors = null;
        message = null;
    }

    private async Task SaveAsync()
    {
        busy = true;
        var request = new SaveMeasureUnitRequest(form!.Code, form.Name, form.GroupKey, form.Factor, form.Version);
        var result = form.Id is { } id
            ? await Api.PutAsync<MeasureUnitDto>($"{Url}/{id}", request)
            : await Api.PostAsync<MeasureUnitDto>(Url, request);
        busy = false;

        if (result.IsSuccess)
        {
            form = null;
            errors = null;
            message = null;
            await LoadAsync(page?.Page ?? 1);
            return;
        }

        errors = result.FieldErrors;
        message = result.Error;
    }

    private async Task DeleteAsync()
    {
        busy = true;
        var result = await Api.DeleteAsync($"{Url}/{form!.Id}?version={form.Version}");
        busy = false;

        if (result.IsSuccess)
        {
            form = null;
            await LoadAsync(page?.Page ?? 1);
            return;
        }

        message = result.Error;
    }

    private sealed class UnitForm
    {
        public Guid? Id { get; init; }

        public long? Version { get; init; }

        public string Code { get; set; } = string.Empty;

        public string Name { get; set; } = string.Empty;

        public string GroupKey { get; set; } = "count";

        public decimal Factor { get; set; } = 1m;
    }
}
