@page "/yonetim/ekipler"
@inject ApiClient Api
@inject SessionState Session
@inject NavigationManager Navigation

<PageTitle>@Texts.Get("nav.app.admin.teams") · Modulix</PageTitle>

@* Ekipler (Y8). "Ekibinin kayıtları" kapsamlı rolü olan kişi, ekip arkadaşlarının sorumlu olduğu kayıtları da görür. *@
<AuthGate Permission="@CoreAccess.ManageUsers">
    <a class="back-link" href="yonetim">← @Texts.Get("nav.app.admin")</a>

    <div class="page-header">
        <h1>@Texts.Get("nav.app.admin.teams")</h1>
    </div>

    <p class="text-muted">@Texts.Get("admin.teams.intro")</p>

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }

    <form class="record-form settings-group" novalidate @onsubmit="CreateAsync" @onsubmit:preventDefault>
        <h2>@Texts.Get("admin.teams.new")</h2>
        <FormTabs Title="@Texts.Get("admin.teams.section")" Label="@Texts.Get("admin.teams.sections")">
        <div class="form-grid">
            <div>
                <label class="form-label" for="teamName">@Texts.Get("admin.teams.name")</label>
                <input id="teamName" class="form-control" maxlength="100" placeholder="@Texts.Get("admin.teams.namePlaceholder")" @bind="name" @bind:event="oninput" />
                <FieldError Field="name" Errors="errors" />
            </div>
            <div>
                <label class="form-label" for="teamDescription">@Texts.Get("common.field.description")</label>
                <input id="teamDescription" class="form-control" maxlength="500" @bind="description" />
                <FieldError Field="description" Errors="errors" />
            </div>
        </div>
        </FormTabs>
        <div class="form-actions">
            <button type="submit" class="btn btn-primary" disabled="@(busy || string.IsNullOrWhiteSpace(name))">@Texts.Get("admin.teams.add")</button>
        </div>
    </form>

    @if (teams is null)
    {
        @if (message is null)
        {
            <LoadingState Kind="LoadingKind.Table" />
        }
    }
    else if (teams.Count == 0)
    {
        <EmptyState Title="@Texts.Get("admin.teams.empty")" />
    }
    else
    {
        <table class="table record-table">
            <thead>
                <tr><th>@Texts.Get("admin.teams.col.team")</th><th>@Texts.Get("common.field.description")</th><th>@Texts.Get("admin.roles.col.members")</th></tr>
            </thead>
            <tbody>
                @foreach (var team in teams)
                {
                    <tr>
                        <td data-label="@Texts.Get("admin.teams.col.team")" class="primary"><a href="yonetim/ekipler/@team.Id">@team.Name</a></td>
                        <td data-label="@Texts.Get("common.field.description")">@(team.Description ?? "—")</td>
                        <td data-label="@Texts.Get("admin.roles.col.members")">@team.MemberCount</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</AuthGate>

@code {
    private IReadOnlyList<TeamDto>? teams;
    private string name = string.Empty;
    private string? description;
    private string? message;
    private bool busy;
    private IReadOnlyDictionary<string, string[]>? errors;

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (Session.Can(CoreAccess.ManageUsers))
        {
            var result = await Api.GetAsync<List<TeamDto>>("/api/teams");
            teams = result.Value;
            message = result.Error;
        }
    }

    private async Task CreateAsync()
    {
        busy = true;
        var result = await Api.PostAsync<TeamDetailDto>("/api/teams", new SaveTeamRequest(name, description));
        busy = false;
        errors = result.FieldErrors;
        if (result.Value is { } created)
        {
            Navigation.NavigateTo($"yonetim/ekipler/{created.Id}");
            return;
        }

        message = result.FieldErrors.Count > 0 ? null : result.Error;
    }
}
