@page "/yonetim/ekipler"
@inject ApiClient Api
@inject SessionState Session
@inject NavigationManager Navigation

<PageTitle>Ekipler · Modulix</PageTitle>

@* Ekipler (Y8). "Ekibinin kayıtları" kapsamlı rolü olan kişi, ekip arkadaşlarının sorumlu olduğu kayıtları da görür. *@
<AuthGate Permission="@CoreAccess.ManageUsers">
    <a class="back-link" href="yonetim">← Yönetim</a>

    <div class="page-header">
        <h1>Ekipler</h1>
    </div>

    <p class="text-muted">
        Ekip, bölge ya da proje gibi bir çalışma grubudur. Bir kişi birden fazla ekipte olabilir. Rolünün kayıt kapsamı
        "Ekibinin kayıtları" olan kişi, ekip arkadaşlarının sorumlu olduğu kayıtları da görür ve düzenler.
    </p>

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }

    <form class="record-form settings-group" novalidate @onsubmit="CreateAsync" @onsubmit:preventDefault>
        <h2>Yeni ekip</h2>
        <div class="form-grid">
            <div>
                <label class="form-label" for="teamName">Ekip adı *</label>
                <input id="teamName" class="form-control" maxlength="100" placeholder="ör. İstanbul Satış" @bind="name" @bind:event="oninput" />
                <FieldError Field="name" Errors="errors" />
            </div>
            <div>
                <label class="form-label" for="teamDescription">Açıklama</label>
                <input id="teamDescription" class="form-control" maxlength="500" @bind="description" />
                <FieldError Field="description" Errors="errors" />
            </div>
        </div>
        <div class="form-actions">
            <button type="submit" class="btn btn-primary" disabled="@(busy || string.IsNullOrWhiteSpace(name))">Ekip ekle</button>
        </div>
    </form>

    @if (teams is null)
    {
        @if (message is null)
        {
            <p class="text-muted">Yükleniyor…</p>
        }
    }
    else if (teams.Count == 0)
    {
        <p class="text-muted">Henüz ekip yok.</p>
    }
    else
    {
        <table class="table record-table">
            <thead>
                <tr><th>Ekip</th><th>Açıklama</th><th>Üyeler</th></tr>
            </thead>
            <tbody>
                @foreach (var team in teams)
                {
                    <tr>
                        <td data-label="Ekip" class="primary"><a href="yonetim/ekipler/@team.Id">@team.Name</a></td>
                        <td data-label="Açıklama">@(team.Description ?? "—")</td>
                        <td data-label="Üyeler">@team.MemberCount</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</AuthGate>

@code {
    private IReadOnlyList<TeamDto>? teams;
    private string name = string.Empty;
    private string? description;
    private string? message;
    private bool busy;
    private IReadOnlyDictionary<string, string[]>? errors;

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (Session.Can(CoreAccess.ManageUsers))
        {
            var result = await Api.GetAsync<List<TeamDto>>("/api/teams");
            teams = result.Value;
            message = result.Error;
        }
    }

    private async Task CreateAsync()
    {
        busy = true;
        var result = await Api.PostAsync<TeamDetailDto>("/api/teams", new SaveTeamRequest(name, description));
        busy = false;
        errors = result.FieldErrors;
        if (result.Value is { } created)
        {
            Navigation.NavigateTo($"yonetim/ekipler/{created.Id}");
            return;
        }

        message = result.FieldErrors.Count > 0 ? null : result.Error;
    }
}
