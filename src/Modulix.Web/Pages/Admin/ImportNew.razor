@page "/yonetim/gunluk/yeni"
@inject ApiClient Api
@inject SessionState Session
@inject IJSRuntime Js

<PageTitle>@Texts.Get("admin.importNew.title") · Modulix</PageTitle>

@* İçe aktarma (ADR-0033, Dilim 2): tür seç, şablonu indir, dosyayı kuru çalışmayla dene, sonra uygula. Sayfa içi eylem formudur.
   Sonuç sunucudan gelir; hatalı satırlar için rapor yalnızca yükleyene ve kısa süreliğine verilir. *@
<AuthGate AnyPermission="@(new[] { CoreAccess.RunImports })">
    <a class="back-link" href="yonetim/gunluk">← @Texts.Get("nav.app.admin.import-log")</a>

    <div class="page-header">
        <div>
            <h1>@Texts.Get("admin.importNew.title")</h1>
            <p class="text-muted mb-0">@Texts.Get("admin.importNew.intro")</p>
        </div>
    </div>

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }

    @if (definitions is null)
    {
        <LoadingState />
    }
    else if (definitions.Count == 0)
    {
        <EmptyState Compact="true" Title="@Texts.Get("admin.importNew.empty")" Text="@Texts.Get("admin.importNew.empty.text")" />
    }
    else
    {
        <div class="card p-3">
            <div class="mb-3">
                <label class="form-label" for="import-entity">@Texts.Get("admin.importNew.entity")</label>
                <select id="import-entity" class="form-select" @bind="entityKey" @bind:after="Reset" disabled="@busy">
                    @foreach (var definition in definitions)
                    {
                        <option value="@definition.EntityKey">@definition.DisplayName</option>
                    }
                </select>
                @if (Current is { } current)
                {
                    <div class="form-text">
                        @Texts.Get("admin.importNew.columns", string.Join(", ", current.Fields.Select(f => f.Required ? f.Label + " *" : f.Label)))
                    </div>
                    <button type="button" class="btn btn-tonal btn-sm mt-2" disabled="@busy" @onclick="DownloadTemplateAsync">@Texts.Get("admin.importNew.template")</button>
                }
            </div>
            <div class="mb-3">
                <label class="form-label" for="import-file">@Texts.Get("admin.importNew.file")</label>
                <InputFile @key="inputKey" id="import-file" class="form-control" accept=".xlsx,.csv,.txt" OnChange="OnFileChosenAsync" disabled="@busy" />
                <div class="form-text">@Texts.Get("admin.importNew.fileHint", ImportFileLimits.MaxFileBytes / (1024 * 1024))</div>
            </div>
            <div class="d-flex gap-2 justify-content-end">
                <button type="button" class="btn btn-outline-secondary" disabled="@(busy || bytes is null)" @onclick="() => RunAsync(dryRun: true)">@SettingsLabels.ImportMode("DryRun")</button>
                <button type="button" class="btn btn-primary" disabled="@(busy || bytes is null)" @onclick="() => RunAsync(dryRun: false)">@Texts.Get("admin.importNew.apply")</button>
            </div>
        </div>

        @if (busy)
        {
            <p class="text-muted mt-3" role="status">
                @(progress is { } p ? Texts.Get("admin.importNew.processingCount", (p.CreatedCount + p.FailedCount).ToString("N0"), p.TotalRows.ToString("N0")) : Texts.Get("admin.importNew.processing"))
            </p>
        }

        @if (result is not null)
        {
            <div class="card p-3 mt-3" aria-live="polite">
                <h2 class="h5">
                    @Texts.Get("admin.importNew.result") <span class="badge stage-@ImportText.StatusBadge(result.Run.Status)">@SettingsLabels.ImportStatus(result.Run.Status)</span>
                </h2>
                @if (result.Run.FailedCount > 0)
                {
                    <p>
                        <button type="button" class="btn btn-tonal btn-sm" @onclick="DownloadReportAsync">@Texts.Get("admin.importNew.report")</button>
                        <small class="text-muted d-block mt-1">@Texts.Get("admin.importNew.reportHint")</small>
                    </p>
                }
                <ImportRunDetailPanel @key="result.Run.Id" RunId="result.Run.Id" />
            </div>
        }
    }
</AuthGate>

@code {
    private const int PollMilliseconds = 2000;

    private List<ImportDefinitionDto>? definitions;
    private ImportRunDto? progress;
    private string entityKey = string.Empty;
    private string fileName = string.Empty;
    private byte[]? bytes;
    private ImportRunDetailDto? result;
    private string? message;
    private bool busy;
    private int inputKey;

    private ImportDefinitionDto? Current => definitions?.FirstOrDefault(d => d.EntityKey == entityKey);

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (Session.Can(CoreAccess.RunImports))
        {
            var loaded = await Api.GetAsync<List<ImportDefinitionDto>>("/api/imports/definitions");
            definitions = loaded.Value;
            message = loaded.IsSuccess ? null : loaded.Error;
            entityKey = definitions?.FirstOrDefault()?.EntityKey ?? string.Empty;
        }
    }

    private void Reset()
    {
        bytes = null;
        result = null;
        message = null;
        inputKey++;
    }

    private async Task OnFileChosenAsync(InputFileChangeEventArgs e)
    {
        result = null;
        message = null;
        bytes = null;
        fileName = e.File.Name;
        try
        {
            using var stream = e.File.OpenReadStream(ImportFileLimits.MaxFileBytes);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            bytes = buffer.ToArray();
        }
        catch (IOException)
        {
            message = Texts.Get("admin.importNew.tooLarge", ImportFileLimits.MaxFileBytes / (1024 * 1024));
        }
    }

    private async Task RunAsync(bool dryRun)
    {
        if (bytes is null || busy)
        {
            return;
        }

        busy = true;
        message = null;
        result = null;
        var query = $"entityKey={Uri.EscapeDataString(entityKey)}&fileName={Uri.EscapeDataString(fileName)}";
        var response = await Api.PostBytesAsync<ImportRunDetailDto>($"/api/imports{(dryRun ? "/preview" : string.Empty)}?{query}", bytes, fileName.EndsWith(".xlsx", StringComparison.OrdinalIgnoreCase) ? "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" : "text/csv");
        message = response.IsSuccess ? null : response.Error;
        if (response.Value is { } started)
        {
            if (!dryRun)
            {
                // Aynı dosyanın yanlışlıkla ikinci kez uygulanması kayıtları çoğaltır; yeniden seçilmesi gerekir.
                bytes = null;
                inputKey++;
            }

            await FollowAsync(started);
        }

        busy = false;
    }

    // Satırlar sunucuda arka planda işlenir: koşu bitene kadar ilerleme okunur. Sayfa kapanırsa koşu sürer, sonucu günlüktedir.
    private async Task FollowAsync(ImportRunDetailDto current)
    {
        progress = current.Run;
        while (current.Run.Status is "Pending" or "Running")
        {
            StateHasChanged();
            await Task.Delay(PollMilliseconds);
            var next = await Api.GetAsync<ImportRunDetailDto>($"/api/imports/{current.Run.Id}");
            if (next.Value is null)
            {
                message = next.Error;
                progress = null;
                return;
            }

            current = next.Value;
            progress = current.Run;
        }

        progress = null;
        result = current;
    }

    private Task DownloadTemplateAsync() =>
        DownloadAsync($"/api/imports/definitions/{Uri.EscapeDataString(entityKey)}/template", "sablon.csv");

    private Task DownloadReportAsync() =>
        DownloadAsync($"/api/imports/{result!.Run.Id}/error-report", "hata-raporu.csv");

    private async Task DownloadAsync(string url, string name)
    {
        var file = await Api.GetAsync<byte[]>(url);
        if (file.Value is not { } content)
        {
            message = file.Error;
            return;
        }

        await Js.InvokeVoidAsync("modulixDownload", name, "text/csv", Convert.ToBase64String(content));
    }
}
