@page "/yonetim"
@inject SessionState Session
@inject AppNavigation Navigation

<PageTitle>Yönetim - Modulix</PageTitle>

@* Menüdeki "Yönetim" bölümünün giriş sayfası. Her kart yalnızca izni olana görünür; asıl denetim sunucudadır. *@
<AuthGate AnyPermission="CoreAccess.AdministrationPermissions">
    <h1>Yönetim</h1>
    <p class="text-muted">@Session.ActiveTenantName</p>

    <div class="tiles">
        @foreach (var area in Sections.Where(a => Session.Can(a.Permission)))
        {
            @if (area.Href is null)
            {
                <div class="tile is-soon" aria-disabled="true">
                    <strong>@area.Title</strong><span>@area.Description</span>
                </div>
            }
            else
            {
                <a class="tile" href="@area.Href"><strong>@area.Title</strong><span>@area.Description</span></a>
            }
        }
    </div>

    @* Modül ayarları kendi modülünde yaşar; buradan yalnızca bağlantı verilir. *@
    @if (Navigation.ModuleSettings() is { Count: > 0 } moduleSettings)
    {
        <h2 class="mt-4">Modül ayarları</h2>
        <div class="tiles">
            @foreach (AppDefinition screen in moduleSettings)
            {
                <a class="tile" href="@screen.Route"><strong>@AppNames.Of(screen)</strong><span>@(Navigation.RootOf(screen) is { } root ? AppNames.Of(root) : null) modülüne özgü kurallar ve varsayılanlar</span></a>
            }
        </div>
    }
</AuthGate>

