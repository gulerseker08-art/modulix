@page "/yonetim"
@inject SessionState Session
@inject AppNavigation Navigation

<PageTitle>@Texts.Get("nav.app.admin") - Modulix</PageTitle>

@* Menüdeki "Yönetim" bölümünün giriş sayfası. Her kart yalnızca izni olana görünür; asıl denetim sunucudadır. *@
<AuthGate AnyPermission="CoreAccess.AdministrationPermissions">
    <h1>@Texts.Get("nav.app.admin")</h1>
    <p class="text-muted">@Session.ActiveTenantName</p>

    <div class="tiles">
        @foreach (var area in Sections.Where(a => Session.Can(a.Permission)))
        {
            @if (area.Href is null)
            {
                <div class="tile is-soon" aria-disabled="true">
                    <strong>@area.Title</strong><span>@area.Description</span>
                </div>
            }
            else
            {
                <a class="tile" href="@area.Href"><strong>@area.Title</strong><span>@area.Description</span></a>
            }
        }
    </div>

    @* Modül ayarları kendi modülünde yaşar; buradan yalnızca bağlantı verilir. *@
    @if (Navigation.ModuleSettings() is { Count: > 0 } moduleSettings)
    {
        <h2 class="mt-4">@Texts.Get("admin.home.moduleSettings")</h2>
        <div class="tiles">
            @foreach (AppDefinition screen in moduleSettings)
            {
                <a class="tile" href="@screen.Route"><strong>@AppNames.Of(screen)</strong><span>@Texts.Get("admin.home.moduleSettingsDescription", Navigation.RootOf(screen) is { } root ? AppNames.Of(root) : null)</span></a>
            }
        </div>
    }
</AuthGate>

@code {
    // Href boş olan bölümün ekranı henüz yoktur; kart "Yakında" olarak görünür.
    // Özellik olarak tanımlıdır: metinler her okunuşta etkin dilden çözülür (ADR-0034).
    private static (string Title, string Description, string Permission, string? Href)[] Sections =>
    [
        (Texts.Get("nav.app.admin.users"), Texts.Get("admin.home.users"), CoreAccess.ManageUsers, "yonetim/kullanicilar"),
        (Texts.Get("nav.app.admin.teams"), Texts.Get("admin.home.teams"), CoreAccess.ManageUsers, "yonetim/ekipler"),
        (Texts.Get("nav.app.admin.business-units"), Texts.Get("admin.home.units"), CoreAccess.ManageUsers, "yonetim/departmanlar"),
        (Texts.Get("admin.supportAccess.title"), Texts.Get("admin.home.supportAccess"), CoreAccess.ManageUsers, "yonetim/destek-erisimi"),
        (Texts.Get("nav.app.admin.roles"), Texts.Get("admin.home.roles"), CoreAccess.ManageRoles, "yonetim/roller"),
        (Texts.Get("nav.app.admin.companies"), Texts.Get("admin.home.companies"), CoreAccess.ManageCompanies, "yonetim/sirketler"),
        (Texts.Get("nav.app.admin.settings"), Texts.Get("admin.home.settings"), CoreAccess.ManageSettings, "yonetim/ayarlar"),
        (Texts.Get("nav.app.admin.audit"), Texts.Get("admin.home.audit"), CoreAccess.ReadAudit, "yonetim/denetim"),
        (Texts.Get("nav.app.admin.import-log"), Texts.Get("admin.home.importLog"), CoreAccess.ReadImports, "yonetim/gunluk"),
        (Texts.Get("nav.app.admin.approvals"), Texts.Get("admin.home.approvals"), CoreAccess.ManageApprovals, "yonetim/onay-surecleri"),
        (Texts.Get("nav.app.admin.automation"), Texts.Get("admin.home.automation"), CoreAccess.ReadAutomation, "yonetim/otomasyon"),
        (Texts.Get("nav.app.admin.automation-logs"), Texts.Get("admin.home.automationLogs"), CoreAccess.ReadAutomationLogs, "yonetim/otomasyon/calismalar"),
        (Texts.Get("nav.app.admin.communication"), Texts.Get("admin.home.communication"), CoreAccess.ReadCommunication, "yonetim/iletisim-tercihleri"),
        (Texts.Get("nav.app.admin.custom-fields"), Texts.Get("admin.home.customFields"), CoreAccess.ManageCustomization, "yonetim/ozel-alanlar"),
        (Texts.Get("nav.app.admin.form-designer"), Texts.Get("admin.home.formDesigner"), CoreAccess.ManageCustomization, "yonetim/form-tasarimi"),
        (Texts.Get("nav.app.admin.lists"), Texts.Get("admin.home.lists"), CoreAccess.ManageCustomization, "yonetim/listeler"),
        (Texts.Get("admin.home.lookupSettingsTitle"), Texts.Get("admin.home.lookupSettings"), CoreAccess.ManageCustomization, "yonetim/alan-ve-lookup-ayarlari"),
        (Texts.Get("nav.app.admin.sector-profile"), Texts.Get("admin.home.sectorProfile"), CoreAccess.ManageCustomization, "yonetim/sektor-profili"),
    ];
}
