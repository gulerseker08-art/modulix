@page "/yonetim"
@inject SessionState Session

<PageTitle>Yönetim - ModüliX</PageTitle>

@* Menüdeki "Yönetim" bölümünün giriş sayfası. Her kart yalnızca izni olana görünür; asıl denetim sunucudadır. *@
<AuthGate AnyPermission="CoreAccess.AdministrationPermissions">
    <h1>Yönetim</h1>
    <p class="text-muted">@Session.ActiveTenantName</p>

    <div class="tiles">
        @foreach (var area in Sections.Where(a => Session.Can(a.Permission)))
        {
            @if (area.Href is null)
            {
                <div class="tile is-soon" aria-disabled="true">
                    <strong>@area.Title</strong><span>@area.Description</span>
                </div>
            }
            else
            {
                <a class="tile" href="@area.Href"><strong>@area.Title</strong><span>@area.Description</span></a>
            }
        }
    </div>
</AuthGate>

@code {
    // Href boş olan bölümün ekranı henüz yoktur; kart "Yakında" olarak görünür.
    private static readonly (string Title, string Description, string Permission, string? Href)[] Sections =
    [
        ("Kullanıcılar", "Davet, rol atama, devre dışı bırakma, şifre sıfırlama", CoreAccess.ManageUsers, "yonetim/kullanicilar"),
        ("Ekipler", "Ekip ve departmanlar; \"ekibinin kayıtları\" kapsamı", CoreAccess.ManageUsers, "yonetim/ekipler"),
        ("Roller", "Roller, izinleri ve kayıt kapsamı", CoreAccess.ManageRoles, "yonetim/roller"),
        ("Şirketler", "İşletici şirketler ve kullanıcıların şirket erişimi", CoreAccess.ManageCompanies, "yonetim/sirketler"),
        ("Firma ayarları", "Firma profili, saat dilimi, para birimi", CoreAccess.ManageSettings, "yonetim/ayarlar"),
        ("Denetim kaydı", "Kim, neyi, ne zaman değiştirdi", CoreAccess.ReadAudit, "yonetim/denetim"),
        ("Özel alanlar", "Kayıtlara firmanıza özgü alanlar ekleyin", CoreAccess.ManageCustomization, "yonetim/ozel-alanlar"),
        ("Listeler", "Fırsat aşamaları, firma durumu ve diğer seçim listeleri", CoreAccess.ManageCustomization, "yonetim/listeler"),
        ("Sektör profili", "Sektörünüze göre hazır alanlar ve liste değerleri", CoreAccess.ManageCustomization, "yonetim/sektor-profili"),
    ];
}
