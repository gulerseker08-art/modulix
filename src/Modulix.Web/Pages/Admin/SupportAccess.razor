@page "/yonetim/destek-erisimi"
@inject ApiClient Api

<PageTitle>@Texts.Get("admin.supportAccess.title") · Modulix</PageTitle>

@* Destek erişimi (ADR-0028 Dilim 7, Y1.3) firma tarafı: platform ekibinin bu firmada açtığı gerekçeli, süreli ve salt okunur erişimler
   listelenir; firma yöneticisi geçerli bir erişimi süresi dolmadan kapatabilir. Kayıtlar silinmez, geçmişte kalır. *@
<AuthGate Permission="@CoreAccess.ManageUsers">
    <a class="back-link" href="yonetim">← @Texts.Get("nav.app.admin")</a>

    <div class="page-header">
        <h1>@Texts.Get("admin.supportAccess.title")</h1>
    </div>
    <p class="text-muted">@Texts.Strong("admin.supportAccess.intro", Texts.Get("admin.supportAccess.readOnly"))</p>

    <Notice Text="@notice" Failed="failed" />

    @if (items is null)
    {
        <LoadingState Kind="LoadingKind.Table" />
    }
    else if (items.Count == 0)
    {
        <p class="text-muted">@Texts.Get("admin.supportAccess.empty")</p>
    }
    else
    {
        <div class="card">
            <table class="table record-table">
                <thead><tr><th>@Texts.Get("admin.supportAccess.col.person")</th><th>@Texts.Get("admin.supportAccess.col.reason")</th><th>@Texts.Get("admin.supportAccess.col.start")</th><th>@Texts.Get("admin.supportAccess.col.end")</th><th>@Texts.Get("common.field.status")</th><th></th></tr></thead>
                <tbody>
                    @foreach (var item in items)
                    {
                        <tr>
                            <td data-label="@Texts.Get("admin.supportAccess.col.person")" class="primary">@item.UserName</td>
                            <td data-label="@Texts.Get("admin.supportAccess.col.reason")">@item.Reason</td>
                            <td data-label="@Texts.Get("admin.supportAccess.col.start")">@CrmLabels.Time(item.GrantedAt)</td>
                            <td data-label="@Texts.Get("admin.supportAccess.col.end")">@CrmLabels.Time(item.EndedAt ?? item.ExpiresAt)</td>
                            <td data-label="@Texts.Get("common.field.status")">
                                <span class="badge @(item.State == SupportAccessStateDto.Active ? "user-active" : "user-disabled")">@StateText(item.State)</span>
                            </td>
                            <td class="actions">
                                <button type="button" class="btn btn-ghost btn-sm" @onclick="() => ToggleReadsAsync(item.Id)">@Texts.Get("admin.supportAccess.reads")</button>
                                @if (item.State == SupportAccessStateDto.Active)
                                {
                                    <button type="button" class="btn btn-outline-danger btn-sm" disabled="@busy" @onclick="() => RevokeAsync(item.Id)">@Texts.Get("admin.supportAccess.revoke")</button>
                                }
                            </td>
                        </tr>
                        @if (openGrant == item.Id)
                        {
                            <tr>
                                <td colspan="6">
                                    @if (reads is null)
                                    {
                                        <span class="text-muted">@Texts.Get("common.loading")</span>
                                    }
                                    else if (reads.Count == 0)
                                    {
                                        <span class="text-muted">@Texts.Get("admin.supportAccess.noReads")</span>
                                    }
                                    else
                                    {
                                        <ul class="list-unstyled">
                                            @foreach (var read in reads)
                                            {
                                                <li><span class="text-muted">@CrmLabels.Time(read.At)</span> <strong>@read.Method</strong> @read.Path</li>
                                            }
                                        </ul>
                                        <p class="text-muted">@Texts.Get("admin.supportAccess.readsNote")</p>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
</AuthGate>

@code {
    private IReadOnlyList<SupportAccessDto>? items;
    private string? notice;
    private bool failed;
    private bool busy;
    private Guid? openGrant;
    private IReadOnlyList<SupportAccessReadDto>? reads;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        var result = await Api.GetAsync<List<SupportAccessDto>>("/api/tenant/support-access");
        if (result.IsSuccess)
        {
            items = result.Value;
        }
        else
        {
            items = [];
            (notice, failed) = (result.Error, true);
        }
    }

    private async Task RevokeAsync(Guid grantId)
    {
        busy = true;
        var result = await Api.PostAsync<bool>($"/api/tenant/support-access/{grantId}/revoke", new { });
        busy = false;
        (notice, failed) = result.IsSuccess ? (Texts.Get("admin.supportAccess.revoked"), false) : (result.Error, true);
        await LoadAsync();
    }

    private async Task ToggleReadsAsync(Guid grantId)
    {
        if (openGrant == grantId)
        {
            openGrant = null;
            return;
        }

        (openGrant, reads) = (grantId, null);
        var result = await Api.GetAsync<List<SupportAccessReadDto>>($"/api/tenant/support-access/{grantId}/reads");
        reads = result.IsSuccess ? result.Value : [];
        if (!result.IsSuccess)
        {
            (notice, failed) = (result.Error, true);
        }
    }

    private static string StateText(SupportAccessStateDto state) => state switch
    {
        SupportAccessStateDto.Active => Texts.Get("admin.supportAccess.state.active"),
        SupportAccessStateDto.Expired => Texts.Get("admin.supportAccess.state.expired"),
        _ => Texts.Get("admin.supportAccess.state.revoked"),
    };
}
