@page "/yonetim/ice-aktarma-tasarimi"
@inject ApiClient Api

<PageTitle>@Texts.Get("nav.app.admin.import-design") · Modulix</PageTitle>

@* İçe aktarma tasarımı (ADR-0033): firma yöneticisi kayıt türlerini açıp kapatır, şablona girecek ve zorunlu olacak sütunları seçer.
   Kodun zorunlu tuttuğu sütunlar kapatılamaz; kural sunucuda da denetlenir. Ayar ekranıdır, sekmeli form kuralının dışındadır. *@
<AuthGate Permission="@CoreAccess.ManageCustomization">
    <a class="back-link" href="yonetim">← @Texts.Get("nav.app.admin")</a>

    <PageHeader Title="@Texts.Get("nav.app.admin.import-design")" Icon="clipboard-list" Subtitle="@Texts.Get("admin.importDesign.subtitle")">
        @if (current is not null)
        {
            <button type="button" class="btn btn-primary" disabled="@busy" @onclick="SaveAsync">@Texts.Get("common.save")</button>
        }
    </PageHeader>

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }
    @if (notice is not null)
    {
        <div class="alert alert-success" role="status">@notice</div>
    }

    @if (designs is null)
    {
        <LoadingState />
    }
    else if (current is null)
    {
        <EmptyState Compact="true" Title="@Texts.Get("admin.importDesign.empty")" />
    }
    else
    {
        <div class="card p-3 mb-3">
            <div class="mb-3">
                <label class="form-label" for="design-entity">@Texts.Get("admin.automation.entity")</label>
                <select id="design-entity" class="form-select" value="@current.EntityKey" @onchange="Choose">
                    @foreach (var design in designs)
                    {
                        <option value="@design.EntityKey">@design.DisplayName</option>
                    }
                </select>
            </div>
            <div class="form-check">
                <input id="design-enabled" class="form-check-input" type="checkbox" @bind="enabled" />
                <label class="form-check-label" for="design-enabled">@Texts.Get("admin.importDesign.enabled")</label>
            </div>
            <div class="form-check">
                <input id="design-automation" class="form-check-input" type="checkbox" @bind="runAutomation" />
                <label class="form-check-label" for="design-automation">@Texts.Get("admin.importDesign.runAutomation")</label>
                <div class="form-text">@Texts.Get("admin.importDesign.runAutomationHint")</div>
            </div>
            <div class="form-check">
                <input id="design-all-or-nothing" class="form-check-input" type="checkbox" @bind="allOrNothing" />
                <label class="form-check-label" for="design-all-or-nothing">@Texts.Get("admin.importDesign.allOrNothing")</label>
                <div class="form-text">@Texts.Get("admin.importDesign.allOrNothingHint")</div>
            </div>
        </div>

        <table class="table record-table">
            <caption class="visually-hidden">@Texts.Get("admin.importDesign.caption", current.DisplayName)</caption>
            <thead>
                <tr><th scope="col">@Texts.Get("admin.importDesign.column")</th><th scope="col">@Texts.Get("admin.importDesign.inTemplate")</th><th scope="col">@Texts.Get("admin.customFields.required")</th><th scope="col">@Texts.Get("admin.importDesign.aliases")</th></tr>
            </thead>
            <tbody>
                @foreach (var field in rows)
                {
                    <tr>
                        <td data-label="@Texts.Get("admin.importDesign.column")" class="primary">@field.Label</td>
                        <td data-label="@Texts.Get("admin.importDesign.inTemplate")">
                            <input class="form-check-input" type="checkbox" aria-label="@Texts.Get("admin.importDesign.inTemplateOf", field.Label)" checked="@field.Included" disabled="@field.Locked"
                                   @onchange="e => SetIncluded(field, e)" />
                        </td>
                        <td data-label="@Texts.Get("admin.customFields.required")">
                            <input class="form-check-input" type="checkbox" aria-label="@Texts.Get("admin.formDesigner.requiredOf", field.Label)" checked="@field.Required" disabled="@(field.Locked || !field.Included)"
                                   @onchange="e => field.Required = e.Value is true" />
                        </td>
                        <td data-label="@Texts.Get("admin.importDesign.aliases")">
                            <input class="form-control" aria-label="@Texts.Get("admin.importDesign.aliasesOf", field.Label)" placeholder="@Texts.Get("admin.importDesign.aliasesPlaceholder")" maxlength="1100" disabled="@(!field.Included)" @bind="field.Aliases" />
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</AuthGate>

@code {
    private sealed class Row(ImportDesignFieldDto field)
    {
        public string Key { get; } = field.Key;

        public string Label { get; } = field.Label;

        public bool Locked { get; } = field.Locked;

        public bool Included { get; set; } = field.Included;

        public bool Required { get; set; } = field.Required;

        /// <summary>Virgülle ayrılmış ek başlık adları (kayıtlı sütun eşlemesi, ADR-0033 Dilim 4c).</summary>
        public string Aliases { get; set; } = string.Join(", ", field.Aliases ?? []);
    }

    private List<ImportDesignDto>? designs;
    private ImportDesignDto? current;
    private List<Row> rows = [];
    private bool enabled;
    private bool runAutomation;
    private bool allOrNothing;
    private bool busy;
    private string? message;
    private string? notice;

    protected override async Task OnInitializedAsync()
    {
        var loaded = await Api.GetAsync<List<ImportDesignDto>>("/api/customization/import-designs");
        designs = loaded.Value;
        message = loaded.IsSuccess ? null : loaded.Error;
        Show(designs?.FirstOrDefault());
    }

    private void Show(ImportDesignDto? design)
    {
        current = design;
        rows = design is null ? [] : [.. design.Fields.Select(f => new Row(f))];
        enabled = design?.Enabled ?? false;
        runAutomation = design?.RunAutomation ?? false;
        allOrNothing = design?.AllOrNothing ?? false;
    }

    private void Choose(ChangeEventArgs e)
    {
        notice = null;
        Show(designs?.FirstOrDefault(d => d.EntityKey == e.Value?.ToString()));
    }

    private static void SetIncluded(Row row, ChangeEventArgs e)
    {
        row.Included = e.Value is true;
        if (!row.Included)
        {
            row.Required = false;
        }
    }

    private async Task SaveAsync()
    {
        busy = true;
        message = null;
        notice = null;
        var request = new SaveImportDesignRequest(
            enabled,
            runAutomation,
            [.. rows.Where(r => !r.Included).Select(r => r.Key)],
            [.. rows.Where(r => r.Required && !r.Locked).Select(r => r.Key)],
            current!.Version,
            rows.Where(r => r.Included && !string.IsNullOrWhiteSpace(r.Aliases))
                .ToDictionary(r => r.Key, r => (IReadOnlyList<string>)[.. r.Aliases.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)]),
            allOrNothing);
        var saved = await Api.PutAsync<ImportDesignDto>($"/api/customization/import-designs/{Uri.EscapeDataString(current.EntityKey)}", request);
        busy = false;
        if (saved.Value is not { } design)
        {
            message = saved.Error;
            return;
        }

        designs![designs.FindIndex(d => d.EntityKey == design.EntityKey)] = design;
        Show(design);
        notice = Texts.Get("admin.importDesign.saved");
    }
}
