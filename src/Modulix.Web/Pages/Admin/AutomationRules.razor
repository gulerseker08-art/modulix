@page "/yonetim/otomasyon"
@inject ApiClient Api
@inject SessionState Session

<PageTitle>@Texts.Get("admin.automationRules.title") · Modulix</PageTitle>

@* Otomasyon kuralları (ADR-0027, Dilim 5a): liste. Okuma core.automation.read ister; yeni kural yalnızca şablondan başlar
   (core.automation.manage). Düğmeleri gizlemek yetki değildir, sunucu uygular. Liste şablonu: durum sekmeleri + kişisel görünümler
   (ADR-0036), tıklanınca sıralanan başlıklar (sunucu sort anahtarı), sütun seçici. *@
<AuthGate Permission="@CoreAccess.ReadAutomation">
    <a class="back-link" href="yonetim">← @Texts.Get("nav.app.admin")</a>

    <PageHeader Title="@Texts.Get("admin.automationRules.title")" Icon="zap"
                Subtitle="@Texts.Get("admin.automationRules.subtitle")" />

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message <button type="button" class="btn btn-sm btn-outline-secondary ms-2" @onclick="() => LoadAsync(1)">@Texts.Get("admin.automation.retry")</button></div>
    }

    <ViewTabs Items="ViewOptions" Value="@view" ValueChanged="ChooseViewAsync" Label="@Texts.Get("admin.automationRules.views")" NewView="StartNaming" />

    <div class="list-toolbar">
        <form class="search" @onsubmit="() => LoadAsync(1)" @onsubmit:preventDefault>
            <input class="form-control" type="search" aria-label="@Texts.Get("admin.automationRules.searchLabel")" placeholder="@Texts.Get("admin.automationRules.searchPlaceholder")" @bind="search" />
        </form>
        <GridColumnPicker State="grid" Changed="@(() => Task.CompletedTask)" />
        @if (Session.Can(CoreAccess.ReadAutomationLogs))
        {
            <a class="btn btn-ghost" href="yonetim/otomasyon/calismalar">@Texts.Get("nav.app.admin.automation-logs")</a>
        }
        @if (Session.Can(CoreAccess.ManageAutomation))
        {
            <a class="btn btn-ghost" href="yonetim/otomasyon/yeni">@Texts.Get("admin.automationRules.fromScratch")</a>
            <a class="btn btn-primary" href="yonetim/otomasyon/sablonlar"><AppIcon Name="plus" Size="16" /> @Texts.Get("admin.automationRules.fromTemplate")</a>
        }
    </div>

    <PersonalViewBar Active="Active" Dirty="Dirty" Naming="views.Naming" NamingChanged="views.StartNaming" Error="@views.Error"
                     SaveAs="SaveAsAsync" UpdateView="UpdateViewAsync" DiscardChanges="DiscardAsync" DeleteView="DeleteViewAsync" />

    @if (rulePage is null)
    {
        @if (message is null)
        {
            <LoadingState />
        }
    }
    else if (rulePage.Items.Count == 0)
    {
        <p class="text-muted" role="status">
            @if (status is not null || !string.IsNullOrWhiteSpace(search))
            {
                <text>@Texts.Get("admin.automationRules.emptyFiltered")</text>
            }
            else
            {
                <text>@Texts.Get("admin.automationRules.empty")</text>
                @if (Session.Can(CoreAccess.ManageAutomation))
                {
                    <text> @((MarkupString)Texts.Get("admin.automationRules.emptyTemplates", "<a href=\"yonetim/otomasyon/sablonlar\">", "</a>"))</text>
                }
            }
        </p>
    }
    else
    {
        <p class="visually-hidden" role="status" aria-live="polite">@Texts.Get("admin.automationRules.listed", rulePage.TotalCount)</p>
        <table class="table record-table">
            <caption class="visually-hidden">@Texts.Get("admin.automationRules.title")</caption>
            <thead>
                <tr>
                    @foreach (var column in grid.VisibleColumns)
                    {
                        <GridHeader Column="column" State="grid" SortChanged="SortAsync" />
                    }
                    <th scope="col" class="row-menu-cell"><span class="visually-hidden">@Texts.Get("common.actions")</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var rule in rulePage.Items)
                {
                    <tr>
                        @foreach (var column in grid.VisibleColumns)
                        {
                            <td data-label="@column.Label" class="@(column.Key == "name" ? "primary" : null)">@CellContent(column.Key, rule)</td>
                        }
                        <td class="row-menu-cell">
                            <RowMenu Label="@Texts.Get("common.rowActionsOf", rule.Name)">
                                <a class="view-menu-item" role="menuitem" href="yonetim/otomasyon/@rule.Id"><AppIcon Name="eye" Size="16" /> <span>@Texts.Get("common.open")</span></a>
                            </RowMenu>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager PageSizeChoice="true" Page="rulePage.Page" PageSize="rulePage.PageSize" TotalCount="rulePage.TotalCount" PageChanged="LoadAsync" />
    }
</AuthGate>

@code {
    private const string ScreenKey = "admin.automation-rules";
    private const string DefaultSort = "-updatedAt";
    private const string StatusPrefix = "status:";

    // Sıralanabilir sütunlar sunucudaki sort anahtarlarıdır (AutomationRuleQuery.SortKeys); öncelik sürümde durduğu için sıralanamaz.
    private static GridColumnDef[] Columns =>
    [
        new("name", Texts.Get("admin.automation.rule"), "type", "name", "-name", Locked: true),
        new("entity", Texts.Get("admin.automation.entity"), "layers"),
        new("status", Texts.Get("common.field.status"), "tag", "status", "-status"),
        new("version", Texts.Get("admin.automation.version"), "hash"),
        new("priority", Texts.Get("admin.automation.priority"), "arrow-up"),
        new("updatedAt", Texts.Get("admin.automationRules.col.updatedAt"), "clock", "updatedAt", "-updatedAt"),
    ];

    private readonly GridViewState grid = new(ScreenKey, DefaultSort);
    private PersonalGridViews views = default!;
    private AutomationRulePageDto? rulePage;
    private IReadOnlyList<AutomationEntityDto> entities = [];
    private string view = AutomationLabels.AllViews;
    private string? status;
    private string? search;
    private string? message;

    protected override async Task OnInitializedAsync()
    {
        views = new PersonalGridViews(Api, ScreenKey);
        grid.Define(Columns);
        await Session.EnsureLoadedAsync();
        if (Session.Can(CoreAccess.ReadAutomation))
        {
            // Katalog kayıt türü adları içindir; alınamazsa liste teknik anahtarla yine çalışır.
            entities = (await Api.GetAsync<AutomationCatalogDto>("/api/automation/catalog")).Value?.Entities ?? [];
            await views.LoadAsync();
            await LoadAsync(1);
        }
    }

    private GridViewDto? Active => views.Find(view);

    // Sistem görünümleri yalnızca durum süzgecidir; kişisel görünümler ardına eklenir.
    private IReadOnlyList<ViewOption> ViewOptions =>
    [
        new(AutomationLabels.AllViews, Texts.Get("admin.automationRules.view.all"), Icon: "zap"),
        .. AutomationLabels.Statuses.Select(s => new ViewOption(StatusPrefix + s, AutomationLabels.Status(s), Icon: "tag")),
        .. views.Options,
    ];

    private string? CurrentFilters => GridFilters.Build(status is { Length: > 0 } s ? ("status", s) : null);

    private string? BaselineFilters => Active?.Filters ?? (view.StartsWith(StatusPrefix, StringComparison.Ordinal) ? "status=" + view[StatusPrefix.Length..] : null);

    private bool Dirty => grid.Differs(Active) || (CurrentFilters ?? string.Empty) != (BaselineFilters ?? string.Empty);

    private async Task ChooseViewAsync(string key)
    {
        view = key;
        views.StartNaming(false);
        if (Active is { } saved)
        {
            grid.Apply(saved);
        }
        else
        {
            grid.Reset();
        }

        var filters = GridFilters.Parse(BaselineFilters);
        status = filters.TryGetValue("status", out var s) && AutomationLabels.Statuses.Contains(s) ? s : null;
        await LoadAsync(1);
    }

    private async Task SortAsync(string key)
    {
        grid.Sort = key;
        await LoadAsync(1);
    }

    private void StartNaming() => views.StartNaming(true);

    private async Task SaveAsAsync(string name)
    {
        if (await views.SaveAsAsync(grid.ToRequest(name, CurrentFilters)) is { } key)
        {
            view = key;
        }
    }

    private async Task UpdateViewAsync()
    {
        if (Active is { } current)
        {
            await views.UpdateAsync(current, grid.ToRequest(current.Name, CurrentFilters));
        }
    }

    private async Task DiscardAsync() => await ChooseViewAsync(view);

    private async Task DeleteViewAsync()
    {
        if (Active is { } current && await views.DeleteAsync(current))
        {
            await ChooseViewAsync(AutomationLabels.AllViews);
        }
    }

    private async Task LoadAsync(int pageNumber)
    {
        var url = $"/api/automation/rules?page={pageNumber}&pageSize={ListPaging.Size}&search={Uri.EscapeDataString(search ?? string.Empty)}";
        if (grid.Sort != grid.DefaultSort)
        {
            url += $"&sort={Uri.EscapeDataString(grid.Sort)}";
        }

        if (status is not null)
        {
            url += $"&status={status}";
        }

        var result = await Api.GetAsync<AutomationRulePageDto>(url);
        rulePage = result.Value;
        message = result.Error;
    }

    private RenderFragment CellContent(string key, AutomationRuleSummaryDto rule) => key switch
    {
        "name" => @<text><a href="yonetim/otomasyon/@rule.Id">@rule.Name</a><small class="text-muted d-block">@AutomationLabels.Behaviour(rule)</small></text>,
        "entity" => @<text>@AutomationLabels.EntityName(entities, rule.EntityKey)</text>,
        "status" => @<text><span class="badge stage-@AutomationLabels.StatusBadge(rule.Status)">@AutomationLabels.Status(rule.Status)</span>@if (rule.HasDraft && rule.Status != AutomationLabels.Draft) { <span class="badge tag">@Texts.Get("admin.automationRules.hasDraft")</span> }</text>,
        "version" => @<text>@(rule.PublishedVersionNo is { } v ? $"v{v}" : "—")</text>,
        "priority" => @<text>@rule.Priority</text>,
        "updatedAt" => @<text>@CrmLabels.Time(rule.UpdatedAt)</text>,
        _ => @<text></text>,
    };
}
