@page "/yonetim/otomasyon/{RuleId:guid}"
@inject ApiClient Api
@inject SessionState Session
@inject NavigationManager Navigation

<PageTitle>@(detail?.Rule.Name ?? Texts.Get("admin.automationRule.title")) · Modulix</PageTitle>

@* Otomasyon kuralı ayrıntısı (ADR-0027, Dilim 5a): yayınlanmış sürüm ve taslak, doğrulama sorunları; yayınla, aç/kapat, taslağı at.
   Yayın ve açma core.automation.publish, taslağı atma core.automation.manage ister. Düğmeleri gizlemek yetki değildir. *@
<AuthGate Permission="@CoreAccess.ReadAutomation">
    <a class="back-link" href="yonetim/otomasyon">← @Texts.Get("admin.automationRules.title")</a>

    @if (detail is null)
    {
        @if (message is not null)
        {
            <div class="alert alert-danger" role="alert">@message</div>
        }
        else
        {
            <LoadingState />
        }
    }
    else
    {
        var rule = detail.Rule;
        <PageHeader Title="@rule.Name" Icon="zap" Subtitle="@AutomationLabels.Behaviour(rule)">
            <span class="badge stage-@AutomationLabels.StatusBadge(rule.Status)">@AutomationLabels.Status(rule.Status)</span>
            @if (Session.Can(CoreAccess.ReadAutomationLogs) && detail.Published is not null)
            {
                <a class="btn btn-ghost" href="yonetim/otomasyon/calismalar?kural=@rule.Id">@Texts.Get("admin.automationRule.runs")</a>
            }
            @if (Session.Can(CoreAccess.ManageAutomation))
            {
                <a class="btn btn-outline-secondary" href="yonetim/otomasyon/@rule.Id/duzenle">@Texts.Get("common.edit")</a>
            }
            @if (CanPublish && detail.Published is not null)
            {
                <button type="button" class="btn btn-outline-secondary" disabled="@busy" @onclick="() => SetActiveAsync(rule.Status != AutomationLabels.Active)">
                    @(rule.Status == AutomationLabels.Active ? Texts.Get("admin.automationRule.turnOff") : Texts.Get("admin.automationRule.turnOn"))
                </button>
            }
            @if (CanPublish && detail.Draft is not null)
            {
                <button type="button" class="btn btn-outline-secondary" disabled="@(busy || detail.DraftIssues.Count > 0)" @onclick="() => PublishAsync(false)">@Texts.Get("admin.automationRule.publishOff")</button>
                <button type="button" class="btn btn-primary" disabled="@(busy || detail.DraftIssues.Count > 0)" @onclick="() => confirming = Confirm.PublishAndOpen">@Texts.Get("admin.automationRule.publishOn")</button>
            }
        </PageHeader>

        <Notice Text="@notice" />
        @if (message is not null)
        {
            <div class="alert alert-danger" role="alert">@message</div>
            @if (problems.Count > 0)
            {
                <ul>
                    @foreach (var problem in problems)
                    {
                        <li>@problem</li>
                    }
                </ul>
            }
        }

        @if (confirming == Confirm.PublishAndOpen)
        {
            <div class="alert alert-warning confirm" role="alertdialog" aria-label="@Texts.Get("admin.automationRule.publishConfirmLabel")">
                <p>
                    @Texts.Get("admin.automationRule.publishConfirm")
                </p>
                <button type="button" class="btn btn-primary" disabled="@busy" @onclick="() => PublishAsync(true)">@Texts.Get("admin.automationRule.publishOn")</button>
                <button type="button" class="btn btn-outline-secondary" @onclick="() => confirming = Confirm.None">@Texts.Get("common.dismiss")</button>
            </div>
        }

        @if (detail.Draft is { } draft)
        {
            <FormSection Title="@Texts.Get("admin.automationRule.draft")" Icon="clipboard-list"
                         Description="@Texts.Get("admin.automationRule.draftHelp")">
                <Actions>
                    @if (Session.Can(CoreAccess.ManageAutomation))
                    {
                        <button type="button" class="btn btn-outline-danger" disabled="@busy" @onclick="() => confirming = Confirm.Discard">@Texts.Get("admin.automationRule.discard")</button>
                    }
                </Actions>
                <ChildContent>
                    @if (confirming == Confirm.Discard)
                    {
                        <div class="alert alert-warning confirm" role="alertdialog" aria-label="@Texts.Get("admin.automationRule.discardConfirmLabel")">
                            <p>
                                @(detail.Published is null
                                    ? Texts.Get("admin.automationRule.discardNeverPublished")
                                    : Texts.Get("admin.automationRule.discardKeepsPublished"))
                            </p>
                            <button type="button" class="btn btn-danger" disabled="@busy" @onclick="DiscardAsync">@Texts.Get("admin.automationRule.discard")</button>
                            <button type="button" class="btn btn-outline-secondary" @onclick="() => confirming = Confirm.None">@Texts.Get("common.dismiss")</button>
                        </div>
                    }
                    <VersionView Version="draft" Issues="detail.DraftIssues" />
                </ChildContent>
            </FormSection>
        }

        @if (detail.Published is { } published)
        {
            <FormSection Title="@Texts.Get("admin.automationRule.published", published.VersionNo)" Icon="check"
                         Description="@(rule.Status == AutomationLabels.Active ? Texts.Get("admin.automationRule.publishedRunning") : Texts.Get("admin.automationRule.publishedOff"))">
                <VersionView Version="published" Issues="detail.PublishedIssues" />
            </FormSection>

            @if (CanRun && rule.Status == AutomationLabels.Active && IsManual(published))
            {
                <FormSection Title="@Texts.Get("admin.automationRule.manual")" Icon="zap"
                             Description="@Texts.Get("admin.automationRule.manualHelp")">
                    <div class="form-grid">
                        <div class="span-6">
                            <label class="form-label" for="manualRecord">@Texts.Get("admin.automationRule.record")</label>
                            <RecordPicker Id="manualRecord" EntityKey="@rule.EntityKey" LabelField="@LabelFieldOf(rule.EntityKey)"
                                          AccessibleName="@Texts.Get("admin.automationRule.recordToRun")" @bind-Value="manualRecordId" />
                        </div>
                    </div>
                    @if (confirming == Confirm.Run)
                    {
                        <div class="alert alert-warning confirm" role="alertdialog" aria-label="@Texts.Get("admin.automationRule.runConfirmLabel")">
                            <p>@Texts.Get("admin.automationRule.runConfirm")</p>
                            <button type="button" class="btn btn-primary" disabled="@busy" @onclick="RunManuallyAsync">@Texts.Get("admin.automationRule.run")</button>
                            <button type="button" class="btn btn-outline-secondary" @onclick="() => confirming = Confirm.None">@Texts.Get("common.dismiss")</button>
                        </div>
                    }
                    else
                    {
                        <div class="form-actions">
                            <button type="button" class="btn btn-primary" disabled="@(busy || manualRecordId is null)" @onclick="() => confirming = Confirm.Run">@Texts.Get("admin.automationRule.runForRecord")</button>
                        </div>
                    }
                </FormSection>
            }
        }
    }
</AuthGate>

@code {
    private enum Confirm
    {
        None,
        PublishAndOpen,
        Discard,
        Run,
    }

    [Parameter] public Guid RuleId { get; set; }

    private AutomationRuleDetailDto? detail;
    private IReadOnlyList<AutomationEntityDto> entities = [];
    private IReadOnlyList<string> problems = [];
    private string? message;
    private string? notice;
    private bool busy;
    private Confirm confirming;

    private bool CanPublish => Session.Can(CoreAccess.PublishAutomation);

    private bool CanRun => Session.Can(CoreAccess.RunAutomation);

    private Guid? manualRecordId;

    /// <summary>Yayınlanmış sürümün tetikleyicisi "elle" mi? Yalnızca öyle kurallar elle çalıştırılabilir (sunucu da denetler).</summary>
    private static bool IsManual(AutomationVersionDto version) =>
        version.Definition.ValueKind == System.Text.Json.JsonValueKind.Object
        && version.Definition.TryGetProperty("trigger", out var trigger)
        && trigger.ValueKind == System.Text.Json.JsonValueKind.Object
        && trigger.TryGetProperty("type", out var type)
        && type.ValueKind == System.Text.Json.JsonValueKind.String
        && type.GetString() == "manual";

    private string? LabelFieldOf(string entityKey) => entities.FirstOrDefault(e => e.EntityKey == entityKey)?.LabelField;

    private async Task RunManuallyAsync()
    {
        if (manualRecordId is not { } recordId)
        {
            return;
        }

        busy = true;
        message = null;
        notice = null;
        problems = [];
        var result = await Api.PostAsync<AutomationRunDetailDto>($"/api/automation/rules/{RuleId}/run", new RunAutomationRuleRequest(recordId));
        busy = false;
        confirming = Confirm.None;
        if (result.Value is { } run)
        {
            Navigation.NavigateTo($"yonetim/otomasyon/calismalar/{run.Run.Id}");
            return;
        }

        // Aynı kayıt için bugün zaten çalıştırıldıysa (409) ve diğer hatalarda sunucunun iletisi gösterilir.
        message = result.Error;
    }

    protected override async Task OnParametersSetAsync()
    {
        await Session.EnsureLoadedAsync();
        if (!Session.Can(CoreAccess.ReadAutomation))
        {
            return;
        }

        entities = (await Api.GetAsync<AutomationCatalogDto>("/api/automation/catalog")).Value?.Entities ?? [];
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var result = await Api.GetAsync<AutomationRuleDetailDto>($"/api/automation/rules/{RuleId}");
        detail = result.Value;
        if (!result.IsSuccess)
        {
            message = result.Error;
        }
    }

    private async Task PublishAsync(bool activate)
    {
        if (detail is null)
        {
            return;
        }

        await RunAsync(
            () => Api.PostAsync<AutomationRuleDetailDto>(
                $"/api/automation/rules/{RuleId}/publish", new PublishAutomationRuleRequest(activate, detail.Rule.Version)),
            activate ? Texts.Get("admin.automationRule.publishedOnDone") : Texts.Get("admin.automationRule.publishedOffDone"));
    }

    private Task SetActiveAsync(bool active) =>
        RunAsync(
            () => Api.PutAsync<AutomationRuleDetailDto>($"/api/automation/rules/{RuleId}/active", new SetAutomationRuleActiveRequest(active)),
            active ? Texts.Get("admin.automationRule.turnedOn") : Texts.Get("admin.automationRule.turnedOff"));

    private async Task DiscardAsync()
    {
        busy = true;
        var neverPublished = detail?.Published is null;
        var result = await Api.DeleteAsync($"/api/automation/rules/{RuleId}/draft");
        busy = false;
        confirming = Confirm.None;
        if (!result.IsSuccess)
        {
            message = result.Error;
            problems = [];
            return;
        }

        if (neverPublished)
        {
            Navigation.NavigateTo("yonetim/otomasyon");
            return;
        }

        notice = Texts.Get("admin.automationRule.discarded");
        message = null;
        await LoadAsync();
    }

    private async Task RunAsync(Func<Task<ApiResult<AutomationRuleDetailDto>>> call, string done)
    {
        busy = true;
        message = null;
        notice = null;
        problems = [];
        var result = await call();
        busy = false;
        confirming = Confirm.None;
        if (result.Value is { } updated)
        {
            detail = updated;
            notice = done;
            return;
        }

        message = result.Error;
        problems = [.. result.Issues.Select(i => i.Message)];

        // Sürüm çakışmasında (başkası değiştirdi) güncel hali göster.
        if (result.Status == System.Net.HttpStatusCode.Conflict)
        {
            await LoadAsync();
        }
    }
}
