@page "/yonetim/denetim"
@inject ApiClient Api

<PageTitle>@Texts.Get("nav.app.admin.audit") · Modulix</PageTitle>

@* Denetim kaydı (Y5): kim, neyi, ne zaman, nereden değiştirdi. Yalnızca okunur; kayıtlar değiştirilemez. Okurun
   görüntüleme izni olmayan kayıt türlerinde değişen alanların adları görünür, değerleri gizlidir. *@
<AuthGate Permission="@CoreAccess.ReadAudit">
    <a class="back-link" href="yonetim">← @Texts.Get("nav.app.admin")</a>

    <div class="page-header">
        <h1>@Texts.Get("nav.app.admin.audit")</h1>
        <a class="btn btn-outline-primary" href="@ExportUrl" download>@Texts.Get("admin.audit.export")</a>
    </div>
    <p class="text-muted">@Texts.Get("admin.audit.intro")</p>

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }

    <form class="audit-filters" @onsubmit="() => LoadAsync(1)" @onsubmit:preventDefault>
        <div>
            <label class="form-label" for="auditUser">@Texts.Get("admin.lookups.user")</label>
            <select id="auditUser" class="form-select" @bind="userId">
                <option value="">@Texts.Get("admin.audit.everyone")</option>
                @foreach (var user in filters?.Users ?? [])
                {
                    <option value="@user.UserId">@user.Name</option>
                }
            </select>
        </div>
        <div>
            <label class="form-label" for="auditType">@Texts.Get("admin.automation.entity")</label>
            <select id="auditType" class="form-select" @bind="entityKey">
                <option value="">@Texts.Get("admin.subProfiles.all")</option>
                @foreach (var type in filters?.EntityTypes ?? [])
                {
                    <option value="@type.Key">@type.Name</option>
                }
            </select>
        </div>
        <div>
            <label class="form-label" for="auditAction">@Texts.Get("admin.automationRun.col.action")</label>
            <select id="auditAction" class="form-select" @bind="action">
                <option value="">@Texts.Get("admin.subProfiles.all")</option>
                @foreach (var value in Enum.GetValues<AuditOperation>())
                {
                    <option value="@value">@SettingsLabels.Audit(value)</option>
                }
            </select>
        </div>
        <div>
            <label class="form-label" for="auditSource">@Texts.Get("admin.automation.source")</label>
            <select id="auditSource" class="form-select" @bind="source">
                <option value="">@Texts.Get("admin.subProfiles.all")</option>
                @foreach (var value in Enum.GetValues<AuditSource>())
                {
                    <option value="@value">@SettingsLabels.Audit(value)</option>
                }
            </select>
        </div>
        <div>
            <label class="form-label" for="auditFrom">@Texts.Get("admin.supportAccess.col.start")</label>
            <input id="auditFrom" class="form-control" type="date" @bind="from" />
        </div>
        <div>
            <label class="form-label" for="auditTo">@Texts.Get("admin.supportAccess.col.end")</label>
            <input id="auditTo" class="form-control" type="date" @bind="to" />
        </div>
        <div class="audit-filter-actions">
            <button type="submit" class="btn btn-primary">@Texts.Get("common.filter")</button>
            <button type="button" class="btn btn-outline-secondary" @onclick="ClearAsync">@Texts.Get("admin.audit.clear")</button>
        </div>
    </form>

    @if (page is null)
    {
        @if (message is null)
        {
            <LoadingState Kind="LoadingKind.Table" />
        }
    }
    else if (page.Items.Count == 0)
    {
        <EmptyState Title="@Texts.Get("admin.audit.empty")" />
    }
    else
    {
        <table class="table record-table audit-table">
            <thead>
                <tr>
                    <th scope="col"><SortHeader Label="@Texts.Get("admin.audit.date")" ColumnIcon="calendar" Asc="occurredAt" Desc="-occurredAt" Value="@sort" Default="-occurredAt" ValueChanged="SortAsync" /></th>
                    <th scope="col"><SortHeader Label="@Texts.Get("admin.lookups.user")" ColumnIcon="user" Asc="user" Desc="-user" Value="@sort" Default="-occurredAt" ValueChanged="SortAsync" /></th>
                    <th scope="col"><SortHeader Label="@Texts.Get("admin.automation.entity")" ColumnIcon="layers" Asc="entityKey" Desc="-entityKey" Value="@sort" Default="-occurredAt" ValueChanged="SortAsync" /></th>
                    <th scope="col">@Texts.Get("admin.automationRule.record")</th>
                    <th scope="col"><SortHeader Label="@Texts.Get("admin.automationRun.col.action")" ColumnIcon="activity" Asc="action" Desc="-action" Value="@sort" Default="-occurredAt" ValueChanged="SortAsync" /></th>
                    <th scope="col"><SortHeader Label="@Texts.Get("admin.automation.source")" ColumnIcon="globe" Asc="source" Desc="-source" Value="@sort" Default="-occurredAt" ValueChanged="SortAsync" /></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var entry in page.Items)
                {
                    var open = expanded.Contains(entry.Id);
                    <tr class="audit-row @(open ? "is-open" : null)" @onclick="() => Toggle(entry.Id)">
                        <td data-label="@Texts.Get("admin.audit.date")">
                            <button type="button" class="link-button" aria-expanded="@(open ? "true" : "false")">@CrmLabels.Time(entry.OccurredAt)</button>
                        </td>
                        <td data-label="@Texts.Get("admin.lookups.user")">@entry.UserName</td>
                        <td data-label="@Texts.Get("admin.automation.entity")">@entry.EntityName</td>
                        <td data-label="@Texts.Get("admin.automationRule.record")" class="primary">@RecordTitle(entry)</td>
                        <td data-label="@Texts.Get("admin.automationRun.col.action")">@SettingsLabels.Audit(entry.Action)</td>
                        <td data-label="@Texts.Get("admin.automation.source")">@SettingsLabels.Audit(entry.Source, entry.Subscription)</td>
                    </tr>
                    @if (open)
                    {
                        <tr class="audit-detail">
                            <td colspan="6">
                                @if (entry.ValuesHidden)
                                {
                                    <p class="text-muted">@Texts.Get("admin.audit.valuesHidden")</p>
                                }
                                @if (entry.Changes.Count == 0)
                                {
                                    <EmptyState Compact="true" Title="@Texts.Get("admin.audit.noChanges")" />
                                }
                                else
                                {
                                    <table class="table table-sm audit-changes">
                                        <thead><tr><th>@Texts.Get("admin.subProfiles.field")</th><th>@Texts.Get("admin.audit.oldValue")</th><th>@Texts.Get("admin.audit.newValue")</th></tr></thead>
                                        <tbody>
                                            @foreach (var change in entry.Changes)
                                            {
                                                <tr>
                                                    <td>@change.Label</td>
                                                    <td>@Value(entry, change, change.Old)</td>
                                                    <td>@Value(entry, change, change.New)</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
        <Pager Page="page.Page" PageSize="page.PageSize" TotalCount="page.TotalCount" PageChanged="LoadAsync" />
    }
</AuthGate>

@code {
    private AuditPageResponse? page;
    private AuditFiltersResponse? filters;
    private readonly HashSet<Guid> expanded = [];
    private Guid? userId;
    private string? entityKey;
    private AuditOperation? action;
    private AuditSource? source;
    private DateOnly? from;
    private DateOnly? to;
    private string? message;

    private string ExportUrl => $"api/audit/export?{Filters()}";

    protected override async Task OnInitializedAsync()
    {
        var result = await Api.GetAsync<AuditFiltersResponse>("/api/audit/filters");
        filters = result.Value;
        message = result.Error;
        if (result.IsSuccess)
        {
            await LoadAsync(1);
        }
    }

    // Günlük varsayılan olarak en yeni önce gelir; sıralama sunucudadır (AuditQuery.SortKeys).
    private const string DefaultSort = "-occurredAt";

    private string sort = DefaultSort;

    private async Task SortAsync(string value)
    {
        sort = value;
        await LoadAsync(1);
    }

    private async Task LoadAsync(int pageNumber)
    {
        expanded.Clear();
        var result = await Api.GetAsync<AuditPageResponse>($"/api/audit?page={pageNumber}&sort={Uri.EscapeDataString(sort)}&{Filters()}");
        page = result.Value;
        message = result.Error;
    }

    private async Task ClearAsync()
    {
        userId = null;
        entityKey = null;
        action = null;
        source = null;
        from = to = null;
        await LoadAsync(1);
    }

    private void Toggle(Guid id)
    {
        if (!expanded.Remove(id))
        {
            expanded.Add(id);
        }
    }

    private string Filters()
    {
        var parts = new List<string>();
        if (userId is { } u) parts.Add($"userId={u}");
        if (!string.IsNullOrEmpty(entityKey)) parts.Add($"entityKey={Uri.EscapeDataString(entityKey)}");
        if (action is { } a) parts.Add($"action={a}");
        if (source is { } s) parts.Add($"source={s}");
        if (from is { } f) parts.Add($"from={f:yyyy-MM-dd}");
        if (to is { } t) parts.Add($"to={t:yyyy-MM-dd}");
        return string.Join('&', parts);
    }

    private static string RecordTitle(AuditEntryDto entry) =>
        entry.ValuesHidden ? Texts.Get("admin.audit.hidden") : entry.RecordTitle ?? "—";

    private static string Value(AuditEntryDto entry, AuditFieldChangeDto change, string? value) =>
        entry.ValuesHidden || change.Hidden ? Texts.Get("admin.audit.hidden") : string.IsNullOrEmpty(value) ? "—" : value;
}
