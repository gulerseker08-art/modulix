@page "/yonetim/onay-surecleri"
@inject ApiClient Api

<PageTitle>Onay süreçleri · Modulix</PageTitle>

@* Onay süreçleri (ADR-0027 Dilim 4a): firma kendi süreçlerini tanımlar. Değişiklik yeni sürüm açar; açık talepler açıldıkları andaki adımlarla sürer. *@
<AuthGate Permission="@CoreAccess.ManageApprovals">
    <a class="back-link" href="yonetim">← Yönetim</a>

    <PageHeader Title="Onay süreçleri" Icon="check-circle"
                Subtitle="Satın alma, masraf ya da iskonto gibi işler için kimin hangi sırayla onay vereceğini tanımlayın. Aynı sıra numarasındaki adımlar birlikte çalışır." />

    <Notice Text="@message" Failed="true" />

    <div class="list-toolbar">
        <ColumnPicker />
        <button type="button" class="btn btn-primary" @onclick="() => Edit(null)"><AppIcon Name="plus" Size="16" /> Yeni süreç</button>
    </div>

    @if (definitions is null)
    {
        <p class="text-muted" role="status">Yükleniyor…</p>
    }
    else if (definitions.Count == 0)
    {
        <p class="text-muted">Henüz onay süreci yok.</p>
    }
    else
    {
        <table class="table record-table">
            <caption class="visually-hidden">Onay süreçleri</caption>
            <thead>
                <tr>
                    <th scope="col"><span class="th-label"><AppIcon Name="type" Size="14" /> Süreç</span></th>
                    <th scope="col"><span class="th-label"><AppIcon Name="layers" Size="14" /> Adımlar</span></th>
                    <th scope="col"><span class="th-label"><AppIcon Name="coins" Size="14" /> Para birimi</span></th>
                    <th scope="col"><span class="th-label"><AppIcon Name="hash" Size="14" /> Sürüm</span></th>
                    <th scope="col"><span class="th-label"><AppIcon Name="tag" Size="14" /> Durum</span></th>
                    <th scope="col" class="row-menu-cell"><span class="visually-hidden">Eylemler</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var definition in definitions)
                {
                    <tr>
                        <td data-label="Süreç" class="primary"><a href="yonetim/onay-surecleri" @onclick:preventDefault @onclick="() => Edit(definition)">@definition.Name</a></td>
                        <td data-label="Adımlar">@string.Join(" → ", definition.Steps.Select(s => s.Name))</td>
                        <td data-label="Para birimi">@(definition.Currency ?? "—")</td>
                        <td data-label="Sürüm">@definition.Revision</td>
                        <td data-label="Durum"><span class="badge @(definition.IsActive ? "stage-won" : "stage-cancelled")">@(definition.IsActive ? "Açık" : "Kapalı")</span></td>
                        <td class="row-menu-cell">
                            <RowMenu Label="@($"{definition.Name} eylemleri")">
                                <button type="button" class="dropdown-item" role="menuitem" @onclick="() => Edit(definition)">Düzenle</button>
                                <button type="button" class="dropdown-item" role="menuitem" @onclick="() => ToggleAsync(definition)">@(definition.IsActive ? "Kapat" : "Aç")</button>
                            </RowMenu>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <Drawer Open="editing" Label="Onay süreci" OnClose="() => editing = false">
        <div class="section-header">
            <h2>@(editId is null ? "Yeni onay süreci" : name)</h2>
            <button type="button" class="btn btn-icon btn-ghost" aria-label="Kapat" @onclick="() => editing = false"><AppIcon Name="x" Size="18" /></button>
        </div>
        <div>
            <FormTabs Title="Süreç">
                <FormSection Title="Genel" Icon="file-text">
                    <div class="mb-3">
                        <label class="form-label" for="process-name">Süreç adı</label>
                        <input id="process-name" class="form-control" maxlength="150" @bind="name" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="process-description">Açıklama</label>
                        <textarea id="process-description" class="form-control" rows="2" maxlength="500" @bind="description"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="process-currency">Para birimi</label>
                        <input id="process-currency" class="form-control" maxlength="3" placeholder="TRY" @bind="currency" />
                        <small class="text-muted">Doluysa talepte tutar zorunludur ve adım eşikleri bu para birimindedir.</small>
                    </div>
                </FormSection>
                <FormSection Title="Adımlar" Icon="layers">
                    @foreach (var step in steps)
                    {
                        <div class="step-editor">
                            <div class="row g-2">
                                <div class="col-2">
                                    <label class="form-label" for="@($"order-{step.Key}")">Sıra</label>
                                    <input id="@($"order-{step.Key}")" class="form-control" type="number" min="1" @bind="step.Order" />
                                </div>
                                <div class="col-10">
                                    <label class="form-label" for="@($"name-{step.Key}")">Adım adı</label>
                                    <input id="@($"name-{step.Key}")" class="form-control" maxlength="100" @bind="step.Name" />
                                </div>
                                <div class="col-12">
                                    <label class="form-label" for="@($"approver-{step.Key}")">Onaycı</label>
                                    <select id="@($"approver-{step.Key}")" class="form-select" @bind="step.Approver">
                                        <option value="">Seçin…</option>
                                        <optgroup label="Roller">
                                            @foreach (var role in options?.Roles ?? []) { <option value="@($"role:{role.Id}")">@role.Name</option> }
                                        </optgroup>
                                        <optgroup label="Kişiler">
                                            @foreach (var person in options?.People ?? []) { <option value="@($"user:{person.Id}")">@person.Name</option> }
                                        </optgroup>
                                    </select>
                                </div>
                                <div class="col-6">
                                    <label class="form-label" for="@($"min-{step.Key}")">En düşük tutar</label>
                                    <input id="@($"min-{step.Key}")" class="form-control" type="number" min="0" step="0.01" @bind="step.MinAmount" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label" for="@($"due-{step.Key}")">Süre (saat)</label>
                                    <input id="@($"due-{step.Key}")" class="form-control" type="number" min="1" @bind="step.DueHours" />
                                </div>
                            </div>
                            <button type="button" class="btn btn-ghost" disabled="@(steps.Count == 1)" @onclick="() => steps.Remove(step)">Adımı kaldır</button>
                        </div>
                    }
                    <button type="button" class="btn btn-tonal" @onclick="AddStep"><AppIcon Name="plus" Size="16" /> Adım ekle</button>
                </FormSection>
            </FormTabs>
            <Notice Text="@formError" Failed="true" />
        </div>
        <div class="form-actions">
            <button type="button" class="btn btn-outline-secondary" @onclick="() => editing = false">İptal</button>
            <button type="button" class="btn btn-primary" disabled="@busy" @onclick="SaveAsync">Kaydet</button>
        </div>
    </Drawer>
</AuthGate>

@code {
    private sealed class StepRow
    {
        public string Key { get; } = Guid.NewGuid().ToString("N")[..8];

        public int Order { get; set; } = 1;

        public string Name { get; set; } = string.Empty;

        public string Approver { get; set; } = string.Empty;

        public decimal? MinAmount { get; set; }

        public int? DueHours { get; set; }

        public Guid? Id(string prefix) =>
            Approver.StartsWith(prefix + ":", StringComparison.Ordinal) ? Guid.Parse(Approver[(prefix.Length + 1)..]) : null;
    }

    private List<ApprovalDefinitionDto>? definitions;
    private ApproverOptionsDto? options;
    private List<StepRow> steps = [];
    private Guid? editId;
    private long? editVersion;
    private string name = string.Empty;
    private string? description;
    private string? currency;
    private string? message;
    private string? formError;
    private bool editing;
    private bool busy;

    protected override async Task OnInitializedAsync()
    {
        options = (await Api.GetAsync<ApproverOptionsDto>("/api/approvals/approver-options")).Value;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var loaded = await Api.GetAsync<List<ApprovalDefinitionDto>>("/api/approvals/definitions");
        definitions = loaded.Value ?? [];
        message = loaded.IsSuccess ? null : loaded.Error;
    }

    private void Edit(ApprovalDefinitionDto? definition)
    {
        formError = null;
        editId = definition?.Id;
        editVersion = definition?.Version;
        name = definition?.Name ?? string.Empty;
        description = definition?.Description;
        currency = definition?.Currency;
        steps = definition is null
            ? [new StepRow()]
            : [.. definition.Steps.Select(s => new StepRow
            {
                Order = s.Order,
                Name = s.Name,
                Approver = s.ApproverUserId is { } user ? $"user:{user}" : $"role:{s.ApproverRoleId}",
                MinAmount = s.MinAmount,
                DueHours = s.DueHours,
            })];
        editing = true;
    }

    private void AddStep() => steps.Add(new StepRow { Order = steps.Max(s => s.Order) + 1 });

    private async Task SaveAsync()
    {
        busy = true;
        var request = new SaveApprovalDefinitionRequest(
            name, description, currency,
            [.. steps.Select(s => new ApprovalStepDefinitionDto(s.Name, s.Order, s.Id("user"), s.Id("role"), s.MinAmount, s.DueHours))],
            editVersion);
        var saved = editId is { } id
            ? await Api.PutAsync<ApprovalDefinitionDto>($"/api/approvals/definitions/{id}", request)
            : await Api.PostAsync<ApprovalDefinitionDto>("/api/approvals/definitions", request);
        busy = false;
        formError = saved.IsSuccess ? null : saved.Error;
        if (saved.IsSuccess)
        {
            editing = false;
            await LoadAsync();
        }
    }

    private async Task ToggleAsync(ApprovalDefinitionDto definition)
    {
        var done = await Api.PutAsync<ApprovalDefinitionDto>($"/api/approvals/definitions/{definition.Id}/active", new SetApprovalDefinitionActiveRequest(!definition.IsActive));
        message = done.IsSuccess ? null : done.Error;
        await LoadAsync();
    }
}
