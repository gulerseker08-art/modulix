@page "/yonetim/onay-surecleri"
@inject ApiClient Api

<PageTitle>@Texts.Get("nav.app.admin.approvals") · Modulix</PageTitle>

@* Onay süreçleri (ADR-0027 Dilim 4a): firma kendi süreçlerini tanımlar. Değişiklik yeni sürüm açar; açık talepler açıldıkları andaki adımlarla sürer. *@
<AuthGate Permission="@CoreAccess.ManageApprovals">
    <a class="back-link" href="yonetim">← @Texts.Get("nav.app.admin")</a>

    <PageHeader Title="@Texts.Get("nav.app.admin.approvals")" Icon="check-circle"
                Subtitle="@Texts.Get("admin.approvalProcesses.subtitle")" />

    <Notice Text="@message" Failed="true" />

    <ViewTabs Items="ViewOptions" Value="@view" ValueChanged="ChooseViewAsync" Label="@Texts.Get("admin.approvalProcesses.views")" NewView="StartNaming" />

    <div class="list-toolbar">
        <GridColumnPicker State="grid" Changed="@(() => Task.CompletedTask)" />
        <button type="button" class="btn btn-primary" @onclick="() => Edit(null)"><AppIcon Name="plus" Size="16" /> @Texts.Get("admin.approvalProcesses.new")</button>
    </div>

    <PersonalViewBar Active="Active" Dirty="Dirty" Naming="views.Naming" NamingChanged="views.StartNaming" Error="@views.Error"
                     SaveAs="SaveAsAsync" UpdateView="UpdateViewAsync" DiscardChanges="DiscardAsync" DeleteView="DeleteViewAsync" />

    @if (definitions is null)
    {
        <LoadingState Kind="LoadingKind.Table" />
    }
    else if (Shown.Count == 0)
    {
        <p class="text-muted">@(definitions.Count == 0 ? Texts.Get("admin.approvalProcesses.empty") : Texts.Get("admin.approvalProcesses.emptyView"))</p>
    }
    else
    {
        <table class="table record-table">
            <caption class="visually-hidden">@Texts.Get("nav.app.admin.approvals")</caption>
            <thead>
                <tr>
                    @foreach (var column in grid.VisibleColumns)
                    {
                        <GridHeader Column="column" State="grid" SortChanged="SortAsync" />
                    }
                    <th scope="col" class="row-menu-cell"><span class="visually-hidden">@Texts.Get("common.actions")</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var definition in Shown)
                {
                    <tr>
                        @foreach (var column in grid.VisibleColumns)
                        {
                            <td data-label="@column.Label" class="@(column.Key == "name" ? "primary" : null)">@CellContent(column.Key, definition)</td>
                        }
                        <td class="row-menu-cell">
                            <RowMenu Label="@Texts.Get("common.rowActionsOf", definition.Name)">
                                <button type="button" class="dropdown-item" role="menuitem" @onclick="() => Edit(definition)">@Texts.Get("common.edit")</button>
                                <button type="button" class="dropdown-item" role="menuitem" @onclick="() => ToggleAsync(definition)">@(definition.IsActive ? Texts.Get("admin.automationRule.turnOff") : Texts.Get("admin.automationRule.turnOn"))</button>
                            </RowMenu>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <Drawer Open="editing" Label="@Texts.Get("approvals.record.process")" OnClose="() => editing = false">
        <div class="section-header">
            <h2>@(editId is null ? Texts.Get("admin.approvalProcesses.newTitle") : name)</h2>
            <button type="button" class="btn btn-icon btn-ghost" aria-label="@Texts.Get("common.close")" @onclick="() => editing = false"><AppIcon Name="x" Size="18" /></button>
        </div>
        <div>
            <FormTabs Title="@Texts.Get("admin.approvalProcesses.process")">
                <FormSection Title="@Texts.Get("admin.automationEditor.general")" Icon="file-text">
                    <div class="mb-3">
                        <label class="form-label" for="process-name">@Texts.Get("admin.approvalProcesses.name")</label>
                        <input id="process-name" class="form-control" maxlength="150" @bind="name" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="process-description">@Texts.Get("common.field.description")</label>
                        <textarea id="process-description" class="form-control" rows="2" maxlength="500" @bind="description"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="process-target">@Texts.Get("admin.automation.entity")</label>
                        <select id="process-target" class="form-select" @bind="target">
                            <option value="">@Texts.Get("admin.approvalProcesses.noTarget")</option>
                            @foreach (var item in targets) { <option value="@item.EntityKey">@item.DisplayName</option> }
                        </select>
                        <small class="text-muted">@Texts.Get("admin.approvalProcesses.targetHelp")</small>
                    </div>
                    @if (TargetCommands() is { Count: > 0 } commands)
                    {
                        <fieldset class="mb-3">
                            <legend class="form-label">@Texts.Get("admin.approvalProcesses.gated")</legend>
                            @foreach (var command in commands)
                            {
                                <label class="form-check">
                                    <input class="form-check-input" type="checkbox" checked="@gated.Contains(command.Key)"
                                           @onchange="e => Toggle(command.Key, e.Value is true)" />
                                    <span class="form-check-label">@command.DisplayName</span>
                                </label>
                            }
                            <small class="text-muted">@Texts.Get("admin.approvalProcesses.gatedHelp")</small>
                        </fieldset>
                    }
                    <div class="mb-3">
                        <label class="form-label" for="process-currency">@Texts.Get("admin.automationEditor.currency")</label>
                        <input id="process-currency" class="form-control" maxlength="3" placeholder="TRY" @bind="currency" />
                        <small class="text-muted">@Texts.Get("admin.approvalProcesses.currencyHelp")</small>
                    </div>
                </FormSection>
                <FormSection Title="@Texts.Get("admin.automationRun.steps")" Icon="layers">
                    @foreach (var step in steps)
                    {
                        <div class="step-editor">
                            <div class="row g-2">
                                <div class="col-2">
                                    <label class="form-label" for="@($"order-{step.Key}")">@Texts.Get("admin.automationRun.col.order")</label>
                                    <input id="@($"order-{step.Key}")" class="form-control" type="number" min="1" @bind="step.Order" />
                                </div>
                                <div class="col-10">
                                    <label class="form-label" for="@($"name-{step.Key}")">@Texts.Get("admin.approvalProcesses.stepName")</label>
                                    <input id="@($"name-{step.Key}")" class="form-control" maxlength="100" @bind="step.Name" />
                                </div>
                                <div class="col-12">
                                    <label class="form-label" for="@($"approver-{step.Key}")">@Texts.Get("admin.approvalProcesses.approver")</label>
                                    <select id="@($"approver-{step.Key}")" class="form-select" @bind="step.Approver">
                                        <option value="">@Texts.Get("common.choose")</option>
                                        <optgroup label="@Texts.Get("nav.app.admin.roles")">
                                            @foreach (var role in options?.Roles ?? []) { <option value="@($"role:{role.Id}")">@role.Name</option> }
                                        </optgroup>
                                        <optgroup label="@Texts.Get("admin.approvalProcesses.people")">
                                            @foreach (var person in options?.People ?? []) { <option value="@($"user:{person.Id}")">@person.Name</option> }
                                        </optgroup>
                                    </select>
                                </div>
                                <div class="col-6">
                                    <label class="form-label" for="@($"min-{step.Key}")">@Texts.Get("admin.approvalProcesses.minAmount")</label>
                                    <input id="@($"min-{step.Key}")" class="form-control" type="number" min="0" step="0.01" @bind="step.MinAmount" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label" for="@($"due-{step.Key}")">@Texts.Get("admin.approvalProcesses.dueHours")</label>
                                    <input id="@($"due-{step.Key}")" class="form-control" type="number" min="1" @bind="step.DueHours" />
                                </div>
                                <div class="col-12">
                                    <label class="form-label" for="@($"escalate-{step.Key}")">@Texts.Get("admin.approvalProcesses.escalate")</label>
                                    <select id="@($"escalate-{step.Key}")" class="form-select" @bind="step.Escalate">
                                        <option value="">@Texts.Get("admin.approvalProcesses.remindOnly")</option>
                                        <optgroup label="@Texts.Get("nav.app.admin.roles")">
                                            @foreach (var role in options?.Roles ?? []) { <option value="@($"role:{role.Id}")">@role.Name</option> }
                                        </optgroup>
                                        <optgroup label="@Texts.Get("admin.approvalProcesses.people")">
                                            @foreach (var person in options?.People ?? []) { <option value="@($"user:{person.Id}")">@person.Name</option> }
                                        </optgroup>
                                    </select>
                                </div>
                            </div>
                            <button type="button" class="btn btn-ghost" disabled="@(steps.Count == 1)" @onclick="() => steps.Remove(step)">@Texts.Get("admin.approvalProcesses.removeStep")</button>
                        </div>
                    }
                    <button type="button" class="btn btn-tonal" @onclick="AddStep"><AppIcon Name="plus" Size="16" /> @Texts.Get("admin.approvalProcesses.addStep")</button>
                </FormSection>
            </FormTabs>
            <Notice Text="@formError" Failed="true" />
        </div>
        <div class="form-actions">
            <button type="button" class="btn btn-outline-secondary" @onclick="() => editing = false">@Texts.Get("common.cancel")</button>
            <button type="button" class="btn btn-primary" disabled="@busy" @onclick="SaveAsync">@Texts.Get("common.save")</button>
        </div>
    </Drawer>
</AuthGate>

@code {
    private sealed class StepRow
    {
        public string Key { get; } = Guid.NewGuid().ToString("N")[..8];

        public int Order { get; set; } = 1;

        public string Name { get; set; } = string.Empty;

        public string Approver { get; set; } = string.Empty;

        public decimal? MinAmount { get; set; }

        public int? DueHours { get; set; }

        public string Escalate { get; set; } = string.Empty;

        public Guid? Id(string prefix) => Parse(Approver, prefix);

        public Guid? EscalationId(string prefix) => Parse(Escalate, prefix);

        private static Guid? Parse(string value, string prefix) =>
            value.StartsWith(prefix + ":", StringComparison.Ordinal) ? Guid.Parse(value[(prefix.Length + 1)..]) : null;
    }

    private const string ScreenKey = "admin.approval-processes";
    private const string AllViews = "all";
    private const string DefaultSort = "name";

    // Liste tek seferde gelir (sayfalama yok); sıralama bu küçük listede istemcide yapılır, anahtarlar görünümle birlikte saklanır (ADR-0036).
    private static GridColumnDef[] Columns =>
    [
        new("name", Texts.Get("admin.approvalProcesses.process"), "type", "name", "-name", Locked: true),
        new("steps", Texts.Get("admin.automationRun.steps"), "layers"),
        new("currency", Texts.Get("admin.automationEditor.currency"), "coins"),
        new("revision", Texts.Get("admin.automation.version"), "hash", "revision", "-revision"),
        new("status", Texts.Get("common.field.status"), "tag", "status", "-status"),
    ];

    private readonly GridViewState grid = new(ScreenKey, DefaultSort);
    private PersonalGridViews views = default!;
    private string view = AllViews;
    private bool? active;
    private List<ApprovalDefinitionDto>? definitions;
    private List<ApprovalTargetDto> targets = [];
    private string? target;
    private HashSet<string> gated = [];
    private ApproverOptionsDto? options;
    private List<StepRow> steps = [];
    private Guid? editId;
    private long? editVersion;
    private string name = string.Empty;
    private string? description;
    private string? currency;
    private string? message;
    private string? formError;
    private bool editing;
    private bool busy;

    protected override async Task OnInitializedAsync()
    {
        views = new PersonalGridViews(Api, ScreenKey);
        grid.Define(Columns);
        options = (await Api.GetAsync<ApproverOptionsDto>("/api/approvals/approver-options")).Value;
        targets = (await Api.GetAsync<List<ApprovalTargetDto>>("/api/approvals/targets")).Value ?? [];
        await views.LoadAsync();
        await LoadAsync();
    }

    private GridViewDto? Active => views.Find(view);

    private IReadOnlyList<ViewOption> ViewOptions =>
    [
        new(AllViews, Texts.Get("admin.approvalProcesses.view.all"), Icon: "check-circle"),
        new("active:true", Texts.Get("admin.approvalProcesses.active"), Icon: "play"),
        new("active:false", Texts.Get("admin.approvalProcesses.inactive"), Icon: "pause"),
        .. views.Options,
    ];

    private string? CurrentFilters => GridFilters.Build(active is { } a ? ("active", a ? "true" : "false") : null);

    private string? BaselineFilters => Active?.Filters ?? (view.StartsWith("active:", StringComparison.Ordinal) ? "active=" + view["active:".Length..] : null);

    private bool Dirty => grid.Differs(Active) || (CurrentFilters ?? string.Empty) != (BaselineFilters ?? string.Empty);

    // Görünümün süzgeci ve sıralaması uygulanmış liste.
    private IReadOnlyList<ApprovalDefinitionDto> Shown
    {
        get
        {
            IEnumerable<ApprovalDefinitionDto> items = definitions ?? [];
            if (active is { } a)
            {
                items = items.Where(d => d.IsActive == a);
            }

            var descending = grid.Sort.StartsWith('-');
            var sorted = grid.Sort.TrimStart('-') switch
            {
                "revision" => descending ? items.OrderByDescending(d => d.Revision) : items.OrderBy(d => d.Revision),
                "status" => descending ? items.OrderByDescending(d => d.IsActive) : items.OrderBy(d => d.IsActive),
                _ => descending
                    ? items.OrderByDescending(d => d.Name, StringComparer.CurrentCultureIgnoreCase)
                    : items.OrderBy(d => d.Name, StringComparer.CurrentCultureIgnoreCase),
            };
            return [.. sorted.ThenBy(d => d.Name, StringComparer.CurrentCultureIgnoreCase)];
        }
    }

    private Task ChooseViewAsync(string key)
    {
        view = key;
        views.StartNaming(false);
        if (Active is { } saved)
        {
            grid.Apply(saved);
        }
        else
        {
            grid.Reset();
        }

        active = GridFilters.Parse(BaselineFilters).GetValueOrDefault("active") switch { "true" => true, "false" => false, _ => null };
        return Task.CompletedTask;
    }

    private Task SortAsync(string key)
    {
        grid.Sort = key;
        return Task.CompletedTask;
    }

    private void StartNaming() => views.StartNaming(true);

    private async Task SaveAsAsync(string name)
    {
        if (await views.SaveAsAsync(grid.ToRequest(name, CurrentFilters)) is { } key)
        {
            view = key;
        }
    }

    private async Task UpdateViewAsync()
    {
        if (Active is { } current)
        {
            await views.UpdateAsync(current, grid.ToRequest(current.Name, CurrentFilters));
        }
    }

    private Task DiscardAsync() => ChooseViewAsync(view);

    private async Task DeleteViewAsync()
    {
        if (Active is { } current && await views.DeleteAsync(current))
        {
            await ChooseViewAsync(AllViews);
        }
    }

    private RenderFragment CellContent(string key, ApprovalDefinitionDto definition) => key switch
    {
        "name" => @<a href="yonetim/onay-surecleri" @onclick:preventDefault @onclick="() => Edit(definition)">@definition.Name</a>,
        "steps" => @<text>@string.Join(" → ", definition.Steps.Select(s => s.Name))</text>,
        "currency" => @<text>@(definition.Currency ?? "—")</text>,
        "revision" => @<text>@definition.Revision</text>,
        "status" => @<span class="badge @(definition.IsActive ? "stage-won" : "stage-cancelled")">@(definition.IsActive ? Texts.Get("admin.approvalProcesses.active") : Texts.Get("admin.approvalProcesses.inactive"))</span>,
        _ => @<text></text>,
    };

    private async Task LoadAsync()
    {
        var loaded = await Api.GetAsync<List<ApprovalDefinitionDto>>("/api/approvals/definitions");
        definitions = loaded.Value ?? [];
        message = loaded.IsSuccess ? null : loaded.Error;
    }

    private void Edit(ApprovalDefinitionDto? definition)
    {
        formError = null;
        editId = definition?.Id;
        editVersion = definition?.Version;
        name = definition?.Name ?? string.Empty;
        description = definition?.Description;
        currency = definition?.Currency;
        target = definition?.TargetEntityKey;
        gated = [.. definition?.GatedCommands ?? []];
        steps = definition is null
            ? [new StepRow()]
            : [.. definition.Steps.Select(s => new StepRow
            {
                Order = s.Order,
                Name = s.Name,
                Approver = s.ApproverUserId is { } user ? $"user:{user}" : $"role:{s.ApproverRoleId}",
                MinAmount = s.MinAmount,
                DueHours = s.DueHours,
                Escalate = s.EscalateToUserId is { } target ? $"user:{target}" : s.EscalateToRoleId is { } role ? $"role:{role}" : string.Empty,
            })];
        editing = true;
    }

    private void AddStep() => steps.Add(new StepRow { Order = steps.Max(s => s.Order) + 1 });

    // Seçili kayıt türünün onaya bağlanabilen işlemleri; tür değişince başka türün işlemi gönderilmez.
    private IReadOnlyList<ApprovalCommandDto> TargetCommands() =>
        targets.FirstOrDefault(t => t.EntityKey == target)?.Commands ?? [];

    private void Toggle(string command, bool on)
    {
        if (on)
        {
            gated.Add(command);
        }
        else
        {
            gated.Remove(command);
        }
    }

    private async Task SaveAsync()
    {
        busy = true;
        var request = new SaveApprovalDefinitionRequest(
            name, description, currency,
            [.. steps.Select(s => new ApprovalStepDefinitionDto(s.Name, s.Order, s.Id("user"), s.Id("role"), s.MinAmount, s.DueHours, s.EscalationId("user"), s.EscalationId("role")))],
            editVersion,
            string.IsNullOrEmpty(target) ? null : target,
            [.. gated.Where(g => TargetCommands().Any(c => c.Key == g))]);
        var saved = editId is { } id
            ? await Api.PutAsync<ApprovalDefinitionDto>($"/api/approvals/definitions/{id}", request)
            : await Api.PostAsync<ApprovalDefinitionDto>("/api/approvals/definitions", request);
        busy = false;
        formError = saved.IsSuccess ? null : saved.Error;
        if (saved.IsSuccess)
        {
            editing = false;
            await LoadAsync();
        }
    }

    private async Task ToggleAsync(ApprovalDefinitionDto definition)
    {
        var done = await Api.PutAsync<ApprovalDefinitionDto>($"/api/approvals/definitions/{definition.Id}/active", new SetApprovalDefinitionActiveRequest(!definition.IsActive));
        message = done.IsSuccess ? null : done.Error;
        await LoadAsync();
    }
}
