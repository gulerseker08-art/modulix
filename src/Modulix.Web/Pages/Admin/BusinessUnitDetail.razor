@page "/yonetim/departmanlar/{BusinessUnitId:guid}"
@inject ApiClient Api
@inject SessionState Session

<PageTitle>@(detail?.Unit.Name ?? Texts.Get("admin.unit")) · Modulix</PageTitle>

@* Departman ayrıntısı (ADR-0026): bilgiler, kapatma ve kullanıcılar. Kullanıcıyı başka departmana taşıma kullanıcı kartındadır. *@
<AuthGate Permission="@CoreAccess.ManageUsers">
    <a class="back-link" href="yonetim/departmanlar">← @Texts.Get("nav.app.admin.business-units")</a>

    @if (notice is not null)
    {
        <div class="alert alert-success" role="status">@notice</div>
    }

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }

    @if (detail is null)
    {
        @if (message is null)
        {
            <LoadingState />
        }
    }
    else
    {
        var unit = detail.Unit;
        <div class="page-header">
            <div>
                <h1>@unit.Name</h1>
                <div class="header-meta">
                    <span class="badge tag">@AdminLabels.UnitKind(unit.Kind)</span>
                    @if (!unit.IsActive)
                    {
                        <span class="badge tag">@Texts.Get("admin.units.closed")</span>
                    }
                    <small class="text-muted">@unit.PathNames</small>
                </div>
            </div>
        </div>

        <form class="record-form settings-group" novalidate @onsubmit="SaveAsync" @onsubmit:preventDefault>
            <h2>@Texts.Get("admin.units.section")</h2>
            <FormTabs Title="@Texts.Get("admin.units.section")" Label="@Texts.Get("admin.units.sections")">
            <div class="form-grid">
                <div>
                    <label class="form-label" for="unit-name">@Texts.Get("admin.units.name")</label>
                    <input id="unit-name" class="form-control" maxlength="200" @bind="name" @bind:event="oninput" />
                    <FieldError Field="name" Errors="errors" />
                </div>
                <div>
                    <label class="form-label" for="unit-code">@Texts.Get("crm.products.col.code")</label>
                    <input id="unit-code" class="form-control" maxlength="50" @bind="code" @bind:event="oninput" />
                    <FieldError Field="code" Errors="errors" />
                </div>
                <div>
                    <label class="form-label" for="unit-kind">@Texts.Get("admin.units.kind")</label>
                    @if (unit.ParentId is null)
                    {
                        <input id="unit-kind" class="form-control" value="@AdminLabels.UnitKind(unit.Kind)" disabled />
                    }
                    else
                    {
                        <select id="unit-kind" class="form-select" @bind="kind">
                            <option value="@BusinessUnitKindLabels.Dealer">@AdminLabels.UnitKind(BusinessUnitKindLabels.Dealer)</option>
                            <option value="@BusinessUnitKindLabels.Other">@AdminLabels.UnitKind(BusinessUnitKindLabels.Other)</option>
                        </select>
                    }
                    <FieldError Field="kind" Errors="errors" />
                </div>
            </div>
            </FormTabs>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary"
                        disabled="@(busy || string.IsNullOrWhiteSpace(name) || (name.Trim() == unit.Name && (code ?? "") == (unit.Code ?? "") && kind == unit.Kind))">@Texts.Get("common.save")</button>
            </div>
        </form>

        <section class="detail-section">
            <div class="section-header"><h2>@Texts.Get("nav.app.admin.users")</h2></div>
            @if (detail.Members.Count == 0)
            {
                <p class="text-muted">@((MarkupString)Texts.Get("admin.unitDetail.noUsers", "<a href=\"yonetim/kullanicilar\">", "</a>"))</p>
            }
            else
            {
                <table class="table record-table">
                    <thead><tr><th>@Texts.Get("admin.userDetail.user")</th><th>@Texts.Get("common.field.email")</th></tr></thead>
                    <tbody>
                        @foreach (var member in detail.Members)
                        {
                            <tr>
                                <td data-label="@Texts.Get("admin.userDetail.user")" class="primary"><a href="yonetim/kullanicilar/@member.MembershipId">@member.DisplayName</a></td>
                                <td data-label="@Texts.Get("common.field.email")">@member.Email</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </section>

        @* Departman rolleri (ADR-0026 K6): departmandaki her kullanıcı bu rollerin izinlerini ve kayıt kapsamını alır; kullanıcıya doğrudan atanan rollerle toplanır. *@
        <section class="detail-section">
            <div class="section-header"><h2>@Texts.Get("admin.unitDetail.roles")</h2></div>
            @if (assignable.Count == 0)
            {
                <p class="text-muted">@((MarkupString)Texts.Get("admin.unitDetail.noAssignable", "<a href=\"yonetim/roller\">", "</a>"))</p>
            }
            else
            {
                <p class="text-muted small">@Texts.Get("admin.unitDetail.rolesHelp", unit.MemberCount)</p>
                <div class="role-picker">
                    @foreach (var option in assignable)
                    {
                        <div>
                            <label class="form-check">
                                <input class="form-check-input" type="checkbox" checked="@selectedRoles.ContainsKey(option.Id)"
                                       disabled="@(!unit.IsActive && !selectedRoles.ContainsKey(option.Id))"
                                       @onchange="e => ToggleRole(option.Id, e.Value is true)" />
                                <span class="form-check-label">@option.Name <small class="text-muted">· @AdminLabels.Scope(option.Scope)</small></span>
                            </label>
                            @if (selectedRoles.TryGetValue(option.Id, out var inherit))
                            {
                                <label class="form-check ms-4">
                                    <input class="form-check-input" type="checkbox" checked="@inherit"
                                           @onchange="e => selectedRoles[option.Id] = e.Value is true" />
                                    <span class="form-check-label">@Texts.Get("admin.unitDetail.inherit")</span>
                                </label>
                            }
                        </div>
                    }
                </div>
                <FieldError Field="roles" Errors="roleErrors" />
                <div class="form-actions">
                    <button type="button" class="btn btn-primary" disabled="@busy" @onclick="SaveRolesAsync">@Texts.Get("admin.unitDetail.saveRoles")</button>
                </div>
            }
        </section>

        @if (unit.ParentId is not null)
        {
            <section class="detail-section">
                <div class="section-header"><h2>@(unit.IsActive ? Texts.Get("admin.unitDetail.close") : Texts.Get("admin.unitDetail.reopen"))</h2></div>
                <div class="account-actions">
                    <div>
                        <button type="button" class="@(unit.IsActive ? "btn btn-outline-danger" : "btn btn-outline-secondary")" disabled="@busy" @onclick="ToggleActiveAsync">
                            @(unit.IsActive ? Texts.Get("admin.unitDetail.close") : Texts.Get("admin.unitDetail.reopen"))
                        </button>
                        <small class="text-muted">
                            @Texts.Get("admin.unitDetail.closeHint")
                            @if (unit.IsActive)
                            {
                                <text> @Texts.Get("admin.unitDetail.closeBlocked")</text>
                            }
                        </small>
                    </div>
                </div>
            </section>
        }
    }
</AuthGate>

@code {
    [Parameter] public Guid BusinessUnitId { get; set; }

    private BusinessUnitDetailDto? detail;
    private IReadOnlyList<RoleDto> assignable = [];
    private Dictionary<Guid, bool> selectedRoles = [];
    private IReadOnlyDictionary<string, string[]>? roleErrors;
    private string name = string.Empty;
    private string? code;
    private string kind = string.Empty;
    private bool busy;
    private string? message;
    private string? notice;
    private IReadOnlyDictionary<string, string[]>? errors;

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (!Session.Can(CoreAccess.ManageUsers))
        {
            return;
        }

        var result = await Api.GetAsync<BusinessUnitDetailDto>($"/api/business-units/{BusinessUnitId}");
        message = result.Error;
        if (result.Value is { } loaded)
        {
            Show(loaded);
            await LoadRolesAsync();
        }
    }

    // Departmana yalnızca atanabilir düzeyi buna izin veren, sistem dışı roller verilir (sunucu da denetler).
    private async Task LoadRolesAsync()
    {
        var all = (await Api.GetAsync<List<RoleDto>>("/api/roles")).Value ?? [];
        var current = (await Api.GetAsync<List<BusinessUnitRoleDto>>($"/api/business-units/{BusinessUnitId}/roles")).Value ?? [];
        assignable = all
            .Where(r => !r.IsSystem && (r.AssignLevel is RoleAssignLevel.Unit or RoleAssignLevel.Both))
            .OrderBy(r => r.Name)
            .ToList();
        selectedRoles = current.ToDictionary(r => r.RoleId, r => r.InheritToChildren);
    }

    private void ToggleRole(Guid roleId, bool on)
    {
        if (on)
        {
            selectedRoles.TryAdd(roleId, false);
        }
        else
        {
            selectedRoles.Remove(roleId);
        }
    }

    private async Task SaveRolesAsync()
    {
        busy = true;
        notice = null;
        var request = new SetBusinessUnitRolesRequest(selectedRoles.Select(r => new BusinessUnitRoleItem(r.Key, r.Value)).ToList());
        var result = await Api.PutAsync<List<BusinessUnitRoleDto>>($"/api/business-units/{BusinessUnitId}/roles", request);
        busy = false;
        roleErrors = result.FieldErrors;
        if (!result.IsSuccess)
        {
            message = result.FieldErrors.Count > 0 ? null : result.Error;
            return;
        }

        message = null;
        await LoadRolesAsync();
        notice = Texts.Get("admin.unitDetail.rolesSaved");
    }

    private void Show(BusinessUnitDetailDto loaded)
    {
        detail = loaded;
        name = loaded.Unit.Name;
        code = loaded.Unit.Code;
        kind = loaded.Unit.Kind;
    }

    private async Task SaveAsync()
    {
        busy = true;
        notice = null;
        var result = await Api.PutAsync<BusinessUnitDetailDto>($"/api/business-units/{BusinessUnitId}", new UpdateBusinessUnitRequest(name, code, kind));
        busy = false;
        errors = result.FieldErrors;
        if (result.Value is { } saved)
        {
            Show(saved);
            (notice, message) = (Texts.Get("admin.unitDetail.saved"), null);
            return;
        }

        message = result.FieldErrors.Count > 0 ? null : result.Error;
    }

    private async Task ToggleActiveAsync()
    {
        busy = true;
        notice = null;
        var open = detail!.Unit.IsActive;
        var result = await Api.PutAsync<BusinessUnitDetailDto>($"/api/business-units/{BusinessUnitId}/active", new SetBusinessUnitActiveRequest(!open));
        busy = false;
        if (result.Value is { } saved)
        {
            Show(saved);
            (notice, message) = (open ? Texts.Get("admin.unitDetail.closed") : Texts.Get("admin.unitDetail.reopened"), null);
            return;
        }

        message = result.Error;
    }
}
