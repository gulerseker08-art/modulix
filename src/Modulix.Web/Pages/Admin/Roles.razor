@page "/yonetim/roller"
@inject ApiClient Api
@inject SessionState Session

<PageTitle>@Texts.Get("nav.app.admin.roles") · Modulix</PageTitle>

<AuthGate Permission="@CoreAccess.ManageRoles">
    <a class="back-link" href="yonetim">← @Texts.Get("nav.app.admin")</a>

    <div class="page-header">
        <h1>@Texts.Get("nav.app.admin.roles")</h1>
        <a class="btn btn-primary" href="yonetim/roller/yeni">@Texts.Get("admin.roles.new")</a>
    </div>

    <p class="text-muted">@Texts.Get("admin.roles.intro")</p>

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }

    @if (roles is null)
    {
        @if (message is null)
        {
            <LoadingState Kind="LoadingKind.Table" />
        }
    }
    else
    {
        <table class="table record-table">
            <thead>
                <tr><th>@Texts.Get("admin.users.role")</th><th>@Texts.Get("admin.roles.col.permissions")</th><th>@Texts.Get("admin.roles.col.scope")</th><th>@Texts.Get("admin.roles.col.assignLevel")</th><th>@Texts.Get("admin.roles.col.members")</th><th>@Texts.Get("nav.app.admin.business-units")</th></tr>
            </thead>
            <tbody>
                @foreach (var role in roles)
                {
                    <tr>
                        <td data-label="@Texts.Get("admin.users.role")" class="primary">
                            <a href="yonetim/roller/@role.Id">@role.Name</a>
                            @if (role.IsSystem)
                            {
                                <span class="badge tag">@Texts.Get("admin.roles.system")</span>
                            }
                        </td>
                        <td data-label="@Texts.Get("admin.roles.col.permissions")">@(role.IsSystem ? Texts.Get("admin.roles.allPermissions") : Texts.Get("admin.roles.permissionCount", role.Permissions.Count))</td>
                        <td data-label="@Texts.Get("admin.roles.col.scope")">
                            @AdminLabels.Scope(role.Scope)
                            @if (role.HideOutOfScopeShared)
                            {
                                <span class="badge tag">@Texts.Get("admin.roles.hideShared")</span>
                            }
                        </td>
                        <td data-label="@Texts.Get("admin.roles.col.assignLevel")">@AdminLabels.AssignLevel(role.AssignLevel)</td>
                        <td data-label="@Texts.Get("admin.roles.col.members")">@role.MemberCount</td>
                        <td data-label="@Texts.Get("nav.app.admin.business-units")">@role.UnitCount</td>
                    </tr>
                }
            </tbody>
        </table>

        @if (roles.All(r => r.IsSystem) && templates.Count > 0)
        {
            <h2 class="h5">@Texts.Get("admin.roles.templates")</h2>
            <p class="text-muted">@Texts.Get("admin.roles.templatesHelp")</p>
            <div class="tiles">
                @foreach (var template in templates)
                {
                    <a class="tile" href="yonetim/roller/yeni?sablon=@Uri.EscapeDataString(template.Key)">
                        <strong>@template.Name</strong><span>@template.Description</span>
                    </a>
                }
            </div>
        }
    }
</AuthGate>

@code {
    private IReadOnlyList<RoleDto>? roles;
    private IReadOnlyList<RoleTemplateDto> templates = [];
    private string? message;

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (Session.Can(CoreAccess.ManageRoles))
        {
            var result = await Api.GetAsync<List<RoleDto>>("/api/roles");
            roles = result.Value?.OrderByDescending(r => r.IsSystem).ToList();
            message = result.Error;

            // Yalnızca Yönetici rolü varken hazır roller önerilir.
            if (roles?.All(r => r.IsSystem) == true)
            {
                templates = (await Api.GetAsync<List<RoleTemplateDto>>("/api/roles/templates")).Value ?? [];
            }
        }
    }
}
