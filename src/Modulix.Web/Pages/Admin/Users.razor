@page "/yonetim/kullanicilar"
@inject ApiClient Api
@inject SessionState Session

<PageTitle>@Texts.Get("nav.app.admin.users") · Modulix</PageTitle>

<AuthGate Permission="@CoreAccess.ManageUsers">
    <a class="back-link" href="yonetim">← @Texts.Get("nav.app.admin")</a>

    <div class="page-header">
        <h1>@Texts.Get("nav.app.admin.users")</h1>
    </div>

    @if (notice is not null)
    {
        <div class="alert alert-success" role="status">@notice</div>
    }

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }

    @if (inviting)
    {
        <InviteUserForm Roles="roles" Units="units" CanGrantAdministrator="Session.IsAdministrator" Invited="InvitedAsync" Cancelled="() => inviting = false" />
    }

    <ViewTabs Items="ViewOptions" Value="@view" ValueChanged="ChooseViewAsync" Label="@Texts.Get("admin.users.views")" NewView="StartNaming" />

    <div class="list-toolbar">
        <GridColumnPicker State="grid" Changed="@(() => Task.CompletedTask)" />
        @if (!inviting)
        {
            <button type="button" class="btn btn-primary" @onclick="() => inviting = true"><AppIcon Name="plus" Size="16" /> @Texts.Get("admin.users.invite")</button>
        }
    </div>

    <form class="search has-select" @onsubmit="() => LoadAsync(1)" @onsubmit:preventDefault>
        <input class="form-control" type="search" aria-label="@Texts.Get("admin.users.search")" placeholder="@Texts.Get("admin.users.searchPlaceholder")" @bind="search" />
        <select class="form-select" aria-label="@Texts.Get("admin.users.role")" @bind="roleId" @bind:after="() => LoadAsync(1)">
            <option value="">@Texts.Get("admin.users.allRoles")</option>
            @foreach (var role in roles)
            {
                <option value="@role.Id">@role.Name</option>
            }
        </select>
        <select class="form-select" aria-label="@Texts.Get("admin.unit")" @bind="businessUnitId" @bind:after="() => LoadAsync(1)">
            <option value="">@Texts.Get("admin.users.allUnits")</option>
            @foreach (var unit in units)
            {
                <option value="@unit.Id">@unit.PathNames</option>
            }
        </select>
        <select class="form-select" aria-label="@Texts.Get("admin.users.twoFactor")" @bind="twoFactor" @bind:after="() => LoadAsync(1)">
            <option value="">@Texts.Get("admin.users.twoFactorAll")</option>
            <option value="true">@Texts.Get("admin.users.twoFactorOn")</option>
            <option value="false">@Texts.Get("admin.users.twoFactorOff")</option>
        </select>
    </form>

    <PersonalViewBar Active="Active" Dirty="Dirty" Naming="views.Naming" NamingChanged="views.StartNaming" Error="@views.Error"
                     SaveAs="SaveAsAsync" UpdateView="UpdateViewAsync" DiscardChanges="DiscardAsync" DeleteView="DeleteViewAsync" />

    @if (page is null)
    {
        @if (message is null)
        {
            <LoadingState Kind="LoadingKind.Table" />
        }
    }
    else if (page.Items.Count == 0)
    {
        <EmptyState Title="@Texts.Get("admin.users.empty")" />
    }
    else
    {
        <table class="table record-table">
            <thead>
                <tr>
                    @foreach (var column in grid.VisibleColumns)
                    {
                        <GridHeader Column="column" State="grid" SortChanged="SortAsync" />
                    }
                    <th scope="col" class="row-menu-cell"><span class="visually-hidden">@Texts.Get("common.actions")</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in page.Items)
                {
                    <tr>
                        @foreach (var column in grid.VisibleColumns)
                        {
                            @Cell(column, user)
                        }
                        <td class="row-menu-cell">
                            <RowMenu Label="@Texts.Get("common.rowActionsOf", user.DisplayName)">
                                <a class="view-menu-item" role="menuitem" href="yonetim/kullanicilar/@user.MembershipId"><AppIcon Name="eye" Size="16" /> <span>@Texts.Get("common.open")</span></a>
                            </RowMenu>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager PageSizeChoice="true" Page="page.Page" PageSize="page.PageSize" TotalCount="page.TotalCount" PageChanged="LoadAsync" />
    }
</AuthGate>

@code {
    private const string AllViews = "all";
    private const string StatusPrefix = "status:";

    // Başlık tıklamasıyla sıralanan sütunlar sunucudaki sort anahtarlarıdır (UserSortKeys). Departman ve roller sayfa dışında çözüldüğü için sıralanamaz.
    // Özellik olarak tanımlıdır: başlıklar sayfa açılırken etkin dilden çözülür (ADR-0034).
    private static GridColumnDef[] Columns =>
    [
        new("name", Texts.Get("common.field.name"), "type", "name", "-name", Locked: true),
        new("email", Texts.Get("common.field.email"), "mail", "email", "-email"),
        new("unit", Texts.Get("admin.unit"), "building"),
        new("roles", Texts.Get("nav.app.admin.roles"), "shield"),
        new("status", Texts.Get("common.field.status"), "tag", "status", "-status"),
        new("twoFactor", Texts.Get("admin.users.col.twoFactor"), "key", "twoFactor", "-twoFactor"),
        new("lastSignIn", Texts.Get("admin.users.col.lastSignIn"), "clock", "lastSignInAt", "-lastSignInAt"),
    ];

    private readonly GridViewState grid = new("admin.users", "name");
    private PersonalGridViews views = default!;
    private UserPageResponse? page;
    private IReadOnlyList<RoleDto> roles = [];
    private string? search;
    private UserStatus? status;
    private Guid? roleId;
    private Guid? businessUnitId;
    private IReadOnlyList<BusinessUnitDto> units = [];
    private bool? twoFactor;
    private bool inviting;
    private string? message;
    private string? notice;
    private string view = AllViews;

    protected override async Task OnInitializedAsync()
    {
        views = new PersonalGridViews(Api, "admin.users");
        grid.Define(Columns);
        await Session.EnsureLoadedAsync();
        if (Session.Can(CoreAccess.ManageUsers))
        {
            roles = (await Api.GetAsync<List<RoleDto>>("/api/roles")).Value ?? [];
            units = (await Api.GetAsync<List<BusinessUnitDto>>("/api/business-units")).Value ?? [];
            await views.LoadAsync();
            await LoadAsync(1);
        }
    }

    private GridViewDto? Active => views.Find(view);

    // Görünümler yalnızca süzgeçtir (Tümü, durum, kişisel); kapsamı sunucu uygular.
    private IReadOnlyList<ViewOption> ViewOptions =>
    [
        new(AllViews, Texts.Get("admin.users.all"), Icon: "users"),
        .. Enum.GetValues<UserStatus>().Select(v => new ViewOption(StatusPrefix + v, AdminLabels.Status(v), Icon: "user")),
        .. views.Options,
    ];

    private string? CurrentFilters => GridFilters.Build(
        status is { } s ? ("status", s.ToString()) : null,
        roleId is { } r ? ("roleId", r.ToString()) : null,
        businessUnitId is { } u ? ("businessUnitId", u.ToString()) : null,
        twoFactor is { } t ? ("twoFactor", t ? "true" : "false") : null);

    // Sistem görünümünün süzgeci: yalnızca durum sekmesi.
    private string? BaselineFilters => Active?.Filters ?? (view.StartsWith(StatusPrefix, StringComparison.Ordinal) ? "status=" + view[StatusPrefix.Length..] : null);

    // Kaydedilmemiş değişiklik: sütunlar/sıralama ya da süzgeç açık görünümden farklı.
    private bool Dirty => grid.Differs(Active) || Canon(CurrentFilters) != Canon(BaselineFilters);

    private static string Canon(string? filters) =>
        string.Join('&', GridFilters.Parse(filters).OrderBy(p => p.Key, StringComparer.Ordinal).Select(p => p.Key + "=" + p.Value));

    private async Task ChooseViewAsync(string key)
    {
        view = key;
        views.StartNaming(false);
        if (Active is { } saved)
        {
            grid.Apply(saved);
        }
        else
        {
            grid.Reset();
        }

        ApplyFilters(GridFilters.Parse(BaselineFilters));
        await LoadAsync(1);
    }

    private void ApplyFilters(Dictionary<string, string> filters)
    {
        status = Enum.TryParse<UserStatus>(filters.GetValueOrDefault("status"), out var s) ? s : null;
        roleId = Guid.TryParse(filters.GetValueOrDefault("roleId"), out var r) ? r : null;
        businessUnitId = Guid.TryParse(filters.GetValueOrDefault("businessUnitId"), out var u) ? u : null;
        twoFactor = filters.GetValueOrDefault("twoFactor") switch { "true" => true, "false" => false, _ => null };
    }

    private async Task SortAsync(string key)
    {
        grid.Sort = key;
        await LoadAsync(1);
    }

    private void StartNaming() => views.StartNaming(true);

    private async Task SaveAsAsync(string name)
    {
        if (await views.SaveAsAsync(grid.ToRequest(name, CurrentFilters)) is { } key)
        {
            view = key;
        }
    }

    private async Task UpdateViewAsync()
    {
        if (Active is { } current)
        {
            await views.UpdateAsync(current, grid.ToRequest(current.Name, CurrentFilters));
        }
    }

    private async Task DiscardAsync() => await ChooseViewAsync(view);

    private async Task DeleteViewAsync()
    {
        if (Active is { } current && await views.DeleteAsync(current))
        {
            await ChooseViewAsync(AllViews);
        }
    }

    private async Task LoadAsync(int pageNumber)
    {
        var url = $"/api/users?page={pageNumber}&pageSize={ListPaging.Size}&search={Uri.EscapeDataString(search ?? string.Empty)}";
        if (grid.Sort != grid.DefaultSort)
        {
            url += $"&sort={Uri.EscapeDataString(grid.Sort)}";
        }

        if (status is { } s)
        {
            url += $"&status={s}";
        }

        if (roleId is { } r)
        {
            url += $"&roleId={r}";
        }

        if (businessUnitId is { } u)
        {
            url += $"&businessUnitId={u}";
        }

        if (twoFactor is { } t)
        {
            url += $"&twoFactor={(t ? "true" : "false")}";
        }

        var result = await Api.GetAsync<UserPageResponse>(url);
        page = result.Value;
        message = result.Error;
    }

    private async Task InvitedAsync(InviteUserResponse response)
    {
        inviting = false;
        notice = response.ExistingAccount
            ? Texts.Get("admin.users.existingAdded", response.User.DisplayName)
            : Texts.Get("admin.users.invited", response.User.Email);
        await LoadAsync(1);
    }

    private RenderFragment Cell(GridColumnDef column, UserDto user) => @<td data-label="@column.Label" class="@(column.Key == "name" ? "primary" : null)">@CellContent(column.Key, user)</td>;

    private RenderFragment CellContent(string key, UserDto user) => key switch
    {
        "name" => @<text><a href="yonetim/kullanicilar/@user.MembershipId">@user.DisplayName</a>@if (user.IsCurrentUser) { <small class="text-muted"> @Texts.Get("admin.users.you")</small> }</text>,
        "email" => @<text>@user.Email</text>,
        "unit" => @<text>@(user.BusinessUnitName ?? "—")</text>,
        "roles" => @<text>@RoleNames(user)</text>,
        "status" => @<UserStatusBadge User="user" />,
        "twoFactor" => @<text>@(user.TwoFactorEnabled ? Texts.Get("two-factor.on") : Texts.Get("two-factor.off"))</text>,
        "lastSignIn" => @<text>@(user.LastSignInAt is { } at ? CrmLabels.Time(at) : "—")</text>,
        _ => @<text></text>,
    };

    private static string RoleNames(UserDto user) =>
        user.Roles.Count == 0 ? "—" : string.Join(", ", user.Roles.Select(r => r.Name));
}
