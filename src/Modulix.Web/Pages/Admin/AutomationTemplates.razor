@page "/yonetim/otomasyon/sablonlar"
@inject ApiClient Api
@inject SessionState Session
@inject NavigationManager Navigation

<PageTitle>@Texts.Get("admin.automationTemplates.title") · Modulix</PageTitle>

@* Başlangıç şablonları (ADR-0027, Dilim 3b/5a): "Kullan" yalnızca taslak kural açar; taslak yayınlanıp açılana kadar hiçbir şey çalıştırmaz.
   Şablonu kullanmak core.automation.manage ister; listeyi görmek core.automation.read. *@
<AuthGate Permission="@CoreAccess.ReadAutomation">
    <a class="back-link" href="yonetim/otomasyon">← @Texts.Get("admin.automationRules.title")</a>

    <PageHeader Title="@Texts.Get("admin.automationTemplates.title")" Icon="zap"
                Subtitle="@Texts.Get("admin.automationTemplates.subtitle")" />

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }

    @if (templates is null)
    {
        @if (message is null)
        {
            <LoadingState Kind="LoadingKind.Table" />
        }
    }
    else if (templates.Count == 0)
    {
        <EmptyState Compact="true" Title="@Texts.Get("admin.automationTemplates.empty")" Text="@Texts.Get("admin.automationTemplates.empty.text")" />
    }
    else
    {
        <table class="table record-table">
            <caption class="visually-hidden">@Texts.Get("admin.automationTemplates.title")</caption>
            <thead>
                <tr><th scope="col">@Texts.Get("admin.automationTemplates.col.template")</th><th scope="col">@Texts.Get("admin.automation.entity")</th><th scope="col"><span class="visually-hidden">@Texts.Get("admin.automationTemplates.col.action")</span></th></tr>
            </thead>
            <tbody>
                @foreach (var template in templates)
                {
                    <tr>
                        <td data-label="@Texts.Get("admin.automationTemplates.col.template")" class="primary">
                            @template.DisplayName
                            <small class="text-muted d-block">@template.Description</small>
                            @if (!template.Available)
                            {
                                <small class="text-danger d-block">@Texts.Get("admin.automationTemplates.unavailable", template.Issues.FirstOrDefault()?.Message ?? Texts.Get("admin.automationTemplates.missingAccess"))</small>
                            }
                        </td>
                        <td data-label="@Texts.Get("admin.automation.entity")">@AutomationLabels.EntityName(entities, template.EntityKey)</td>
                        <td data-label="@Texts.Get("admin.automationTemplates.col.action")" class="actions">
                            @if (Session.Can(CoreAccess.ManageAutomation))
                            {
                                <button type="button" class="btn btn-sm btn-outline-primary" disabled="@(!template.Available || busy is not null)"
                                        @onclick="() => UseAsync(template)">
                                    @(busy == template.Key ? Texts.Get("admin.automationTemplates.opening") : Texts.Get("admin.automationTemplates.use"))
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</AuthGate>

@code {
    private IReadOnlyList<AutomationTemplateDto>? templates;
    private IReadOnlyList<AutomationEntityDto> entities = [];
    private string? message;
    private string? busy;

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (!Session.Can(CoreAccess.ReadAutomation))
        {
            return;
        }

        entities = (await Api.GetAsync<AutomationCatalogDto>("/api/automation/catalog")).Value?.Entities ?? [];
        var result = await Api.GetAsync<List<AutomationTemplateDto>>("/api/automation/templates");
        templates = result.Value;
        message = result.Error;
    }

    private async Task UseAsync(AutomationTemplateDto template)
    {
        busy = template.Key;
        message = null;
        var result = await Api.PostAsync<AutomationRuleDetailDto>($"/api/automation/templates/{Uri.EscapeDataString(template.Key)}/use", new { });
        busy = null;
        if (result.Value is { } detail)
        {
            Navigation.NavigateTo($"yonetim/otomasyon/{detail.Rule.Id}");
            return;
        }

        message = result.Error;
    }
}
