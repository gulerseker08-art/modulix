@page "/yonetim/roller/yeni"
@page "/yonetim/roller/{RoleId:guid}"
@inject ApiClient Api
@inject SessionState Session
@inject NavigationManager Navigation

<PageTitle>@(IsNew ? Texts.Get("admin.roles.new") : role?.Name ?? Texts.Get("admin.users.role")) · Modulix</PageTitle>

<AuthGate Permission="@CoreAccess.ManageRoles">
    <a class="back-link" href="yonetim/roller">← @Texts.Get("nav.app.admin.roles")</a>

    @if (notice is not null)
    {
        <div class="alert alert-success" role="status">@notice</div>
    }

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }

    @if (!loaded)
    {
        <LoadingState />
    }
    else if (IsNew || role is not null)
    {
        <div class="page-header">
            <h1>@(IsNew ? Texts.Get("admin.roles.new") : role!.Name)</h1>
            @if (role is { IsSystem: false })
            {
                <a class="btn btn-outline-secondary" href="yonetim/roller/yeni?kopya=@role.Id">@Texts.Get("admin.roleDetail.copy")</a>
            }
        </div>

        @if (role is { IsSystem: true })
        {
            <div class="alert alert-info">@Texts.Get("admin.roleDetail.systemInfo")</div>
            <PermissionMatrix Permissions="permissions" Selected="AllKeys" ReadOnly="true" />
            <RoleMembers RoleId="role.Id" />
        }
        else
        {
            <form class="record-form" novalidate @onsubmit="SaveAsync" @onsubmit:preventDefault>
                <TabBar Tabs="FormTabs" State="tabs" Label="@Texts.Get("admin.roleDetail.sections")" Changed="_ => { }" />
                <TabPanel State="tabs" Key="form-genel">
                <div class="form-grid">
                    @if (IsNew && templates.Count > 0)
                    {
                        <div>
                            <label class="form-label" for="template">@Texts.Get("admin.roleDetail.template")</label>
                            <select id="template" class="form-select" value="@templateKey" @onchange="e => ApplyTemplate(e.Value as string)">
                                <option value="">@Texts.Get("admin.roleDetail.emptyRole")</option>
                                @foreach (var template in templates)
                                {
                                    <option value="@template.Key">@template.Name</option>
                                }
                            </select>
                            @if (Template is { } chosen)
                            {
                                <small class="text-muted">@chosen.Description @Texts.Get("admin.roleDetail.templateHint")</small>
                            }
                        </div>
                    }
                    <div>
                        <label class="form-label" for="roleName">@Texts.Get("admin.roleDetail.name")</label>
                        <input id="roleName" class="form-control" maxlength="100" @bind="name" />
                        <FieldError Field="name" Errors="errors" />
                    </div>
                </div>

                </TabPanel>
                <TabPanel State="tabs" Key="form-izin">
                @if (!Session.IsAdministrator)
                {
                    <p class="text-muted">@Texts.Get("admin.roleDetail.ownPermissionsOnly")</p>
                }

                <PermissionMatrix Permissions="permissions" Selected="selected" CanGrant="CanGrant" />
                <FieldError Field="permissions" Errors="errors" />

                @if (skippedFromTemplate > 0)
                {
                    <p class="text-muted">@Texts.Get("admin.roleDetail.skipped", skippedFromTemplate)</p>
                }

                @if (HiddenCount > 0)
                {
                    <p class="text-muted">@Texts.Get("admin.roleDetail.hidden", HiddenCount)</p>
                }

                </TabPanel>
                <TabPanel State="tabs" Key="form-kapsam">
                <fieldset class="scope-choice">
                    <legend class="form-label">@Texts.Get("admin.roles.col.scope")</legend>
                    <p class="text-muted small">@((MarkupString)Texts.Get("admin.roleDetail.scopeHelp", "<a href=\"yonetim/departmanlar\">", "</a>"))</p>
                    @foreach (var option in ScopeOptions)
                    {
                        var id = $"scope-{option}";
                        <div class="form-check">
                            <input id="@id" class="form-check-input" type="radio" name="scope" checked="@(scope == option)"
                                   disabled="@(!CanGrantScope(option))" @onchange="() => scope = option" />
                            <label class="form-check-label" for="@id">
                                <strong>@AdminLabels.Scope(option)</strong> <span class="text-muted">@AdminLabels.ScopeDescription(option)</span>
                            </label>
                        </div>
                    }
                    @if (ScopeOptions.Any(o => !CanGrantScope(o)))
                    {
                        <small class="text-muted">@Texts.Get("admin.roleDetail.scopeLimit")</small>
                    }
                    <FieldError Field="scope" Errors="errors" />
                </fieldset>

                @* Kayıt türüne göre kapsam (ADR-0030 K10): platformun koyduğu tavanı aşan seçenekler kapalıdır; kesin karar sunucudadır (409). *@
                @if (scopeTypes.Count > 0)
                {
                    <fieldset class="scope-choice">
                        <legend class="form-label">@Texts.Get("admin.roleDetail.overrides")</legend>
                        <p class="text-muted small">@Texts.Get("admin.roleDetail.overridesHelp")</p>
                        <table class="table record-table">
                            <thead><tr><th>@Texts.Get("admin.roleDetail.col.type")</th><th>@Texts.Get("admin.roleDetail.col.inRole")</th><th>@Texts.Get("admin.roleDetail.col.limit")</th></tr></thead>
                            <tbody>
                                @foreach (var type in scopeTypes)
                                {
                                    <tr>
                                        <td data-label="@Texts.Get("admin.roleDetail.col.type")" class="primary">@type.Label</td>
                                        <td data-label="@Texts.Get("admin.roleDetail.col.inRole")">
                                            <select class="form-select" aria-label="@Texts.Get("admin.roleDetail.scopeFor", type.Label)"
                                                    value="@(overrides.TryGetValue(type.EntityKey, out var chosen) ? ((int)chosen).ToString() : string.Empty)"
                                                    @onchange="e => ChooseOverride(type.EntityKey, e.Value as string)">
                                                <option value="">@Texts.Get("admin.roleDetail.defaultScope", AdminLabels.Scope(scope))</option>
                                                @foreach (var option in ScopeOptions)
                                                {
                                                    <option value="@((int)option)" disabled="@(!WithinLimit(type, option) || !CanGrantOverride(option))">
                                                        @AdminLabels.Scope(option)@(WithinLimit(type, option) ? null : " " + Texts.Get("admin.roleDetail.exceedsLimit"))
                                                    </option>
                                                }
                                            </select>
                                            @if (DefaultExceeds(type))
                                            {
                                                <small class="text-danger d-block">@Texts.Get("admin.roleDetail.defaultExceeds")</small>
                                            }
                                        </td>
                                        <td data-label="@Texts.Get("admin.roleDetail.col.limit")">
                                            @if (type.MaxScope is { } max)
                                            {
                                                <span class="badge">@Texts.Get("admin.roleDetail.maxScope", AdminLabels.Scope(max))</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">@Texts.Get("admin.roleDetail.noLimit")</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        @if (scopeTypes.Any(DefaultExceeds))
                        {
                            <button type="button" class="btn btn-tonal" @onclick="LowerToLimits">@Texts.Get("admin.roleDetail.lowerToLimits")</button>
                        }
                        <FieldError Field="scopeOverrides" Errors="errors" />
                    </fieldset>
                }

                @* Atanabilir düzey (ADR-0026 K6): bayi gibi departmanlara toplu rol vermek için rol açıkça departmana atanabilir yapılır. *@
                <fieldset class="scope-choice">
                    <legend class="form-label">@Texts.Get("admin.roles.col.assignLevel")</legend>
                    <p class="text-muted small">@Texts.Get("admin.roleDetail.assignLevelHelp")</p>
                    @foreach (var option in AssignLevelOptions)
                    {
                        var id = $"level-{option}";
                        <div class="form-check">
                            <input id="@id" class="form-check-input" type="radio" name="assign-level" checked="@(assignLevel == option)"
                                   disabled="@(role is { UnitCount: > 0 } && option == RoleAssignLevel.User)"
                                   @onchange="() => assignLevel = option" />
                            <label class="form-check-label" for="@id"><strong>@AdminLabels.AssignLevel(option)</strong></label>
                        </div>
                    }
                    @if (role is { UnitCount: > 0 })
                    {
                        <small class="text-muted">@Texts.Get("admin.roleDetail.assignedToUnits", role.UnitCount)</small>
                    }
                    <FieldError Field="assignLevel" Errors="errors" />
                </fieldset>

                @* Bayi izolasyonu (ADR-0026 K8): kapsam dışı ortak firma/kişiler asgari kimlikle bile görünmesin. *@
                <fieldset class="scope-choice">
                    <legend class="form-label">@Texts.Get("admin.roleDetail.outOfScopeShared")</legend>
                    <div class="form-check">
                        <input id="hide-shared" class="form-check-input" type="checkbox" checked="@hideOutOfScopeShared"
                               @onchange="e => hideOutOfScopeShared = e.Value is true" />
                        <label class="form-check-label" for="hide-shared">
                            <strong>@Texts.Get("admin.roleDetail.hideShared")</strong>
                            <span class="text-muted">@Texts.Get("admin.roleDetail.hideSharedHelp")</span>
                        </label>
                    </div>
                    <FieldError Field="hideOutOfScopeShared" Errors="errors" />
                </fieldset>
                </TabPanel>

                <div class="form-actions">
                    <button type="submit" class="btn btn-primary" disabled="@busy">@(IsNew ? Texts.Get("admin.roleDetail.create") : Texts.Get("common.save"))</button>
                    <a class="btn btn-outline-secondary" href="yonetim/roller">@Texts.Get("common.dismiss")</a>
                </div>
            </form>

            @if (role is not null)
            {
                <RoleMembers RoleId="role.Id" />

                <section class="detail-section">
                    <div class="section-header"><h2>@Texts.Get("admin.roleDetail.delete")</h2></div>
                    @if (!deleting)
                    {
                        <div class="account-actions">
                            <div>
                                <button type="button" class="btn btn-outline-danger" disabled="@busy" @onclick="() => deleting = true">@Texts.Get("admin.roleDetail.delete")</button>
                                <small class="text-muted">
                                    @(role.MemberCount == 0 ? Texts.Get("admin.roleDetail.noMembers") : Texts.Get("admin.roleDetail.membersMove", role.MemberCount))
                                </small>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning confirm" role="alertdialog">
                            @if (role.MemberCount == 0)
                            {
                                <p>@Texts.Get("admin.roleDetail.deleteQuestion", role.Name)</p>
                            }
                            else if (!Session.Can(CoreAccess.ManageUsers))
                            {
                                <p>@Texts.Get("admin.roleDetail.moveNeedsUsers", role.MemberCount)</p>
                            }
                            else
                            {
                                <p>@Texts.Get("admin.roleDetail.moveQuestion", role.MemberCount)</p>
                                <div class="mb-3">
                                    <label class="form-label" for="moveTo">@Texts.Get("admin.roleDetail.moveTo")</label>
                                    <select id="moveTo" class="form-select" @bind="moveTo">
                                        <option value="">@Texts.Get("support.choose")</option>
                                        @foreach (var target in MoveTargets())
                                        {
                                            <option value="@target.Id">@target.Name</option>
                                        }
                                    </select>
                                </div>
                            }

                            <button type="button" class="btn btn-danger" disabled="@(busy || !CanDelete)" @onclick="DeleteAsync">@Texts.Get("admin.roleDetail.delete")</button>
                            <button type="button" class="btn btn-outline-secondary" @onclick="() => deleting = false">@Texts.Get("common.dismiss")</button>
                        </div>
                    }
                </section>
            }
        }
    }
</AuthGate>

@code {
    [Parameter] public Guid? RoleId { get; set; }

    /// <summary>Kopyalanan rol: yeni rol formu onun izinleri ve "(kopya)" adıyla açılır.</summary>
    [SupplyParameterFromQuery(Name = "kopya")] public Guid? CopyOf { get; set; }

    /// <summary>Hazır rol (ör. "crm.sales-rep"): yeni rol formu şablonun adı ve izinleriyle açılır.</summary>
    [SupplyParameterFromQuery(Name = "sablon")] public string? TemplateKey { get; set; }

    private IReadOnlyList<PermissionDto> permissions = [];
    private IReadOnlyList<RoleDto> roles = [];
    private IReadOnlyList<RoleTemplateDto> templates = [];
    private string? templateKey;
    private int skippedFromTemplate;
    private RoleDto? role;
    private HashSet<string> selected = [];
    private string name = string.Empty;
    private RecordScope scope = RecordScope.All;
    private RoleAssignLevel assignLevel = RoleAssignLevel.User;
    private bool hideOutOfScopeShared;

    // Kayıt türüne göre kapsam (ADR-0030): ekranda yalnızca firmada açık modüllerin türleri görünür; modülü kapalı türün istisnası
    // sözlükte kalır ve kaydederken birlikte gönderilir (sunucu korur).
    private IReadOnlyList<RoleScopeTypeDto> scopeTypes = [];
    private Dictionary<string, RecordScope> overrides = new(StringComparer.Ordinal);
    private Guid? moveTo;
    private bool loaded;
    private bool deleting;
    private bool busy;
    private string? message;
    private string? notice;
    private IReadOnlyDictionary<string, string[]>? errors;

    // Her kayıt formu sekmelidir; hatalı alan içeren sekme "!" rozeti taşır, kayıt denemesinden sonra hatalı ilk sekme açılır.
    private readonly TabState tabs = new("form-genel");

    private int ErrorCount(params string[] fields) => errors is null ? 0 : fields.Count(errors.ContainsKey);

    private IReadOnlyList<TabItem> FormTabs =>
    [
        new("form-genel", Texts.Get("crm.quoteDetail.tab.general"), Errors: ErrorCount("name")),
        new("form-izin", Texts.Get("admin.roles.col.permissions"), Errors: ErrorCount("permissions")),
        new("form-kapsam", Texts.Get("admin.roleDetail.tab.scope"), Errors: ErrorCount("scope", "scopeOverrides", "assignLevel", "hideOutOfScopeShared")),
    ];

    private bool IsNew => RoleId is null;

    private RoleTemplateDto? Template => templates.FirstOrDefault(t => t.Key == templateKey);

    private HashSet<string> AllKeys => permissions.Select(p => p.Key).ToHashSet();

    /// <summary>Formda görünmeyen (modülü kapalı) izinler; kaydederken korunur.</summary>
    private int HiddenCount => selected.Count(k => permissions.All(p => p.Key != k));

    private bool CanDelete => role is { MemberCount: 0 } || (moveTo is not null && Session.Can(CoreAccess.ManageUsers));

    protected override async Task OnParametersSetAsync()
    {
        await Session.EnsureLoadedAsync();
        if (!Session.Can(CoreAccess.ManageRoles))
        {
            return;
        }

        loaded = false;
        deleting = false;
        moveTo = null;
        errors = null;
        tabs.Select("form-genel");
        message = null;

        var permissionResult = await Api.GetAsync<List<PermissionDto>>("/api/roles/permissions");
        var roleResult = await Api.GetAsync<List<RoleDto>>("/api/roles");
        permissions = permissionResult.Value ?? [];
        roles = roleResult.Value ?? [];
        message = permissionResult.Error ?? roleResult.Error;
        scopeTypes = (await Api.GetAsync<List<RoleScopeTypeDto>>("/api/roles/scope-types")).Value ?? [];

        if (RoleId is { } id)
        {
            role = roles.FirstOrDefault(r => r.Id == id);
            message ??= role is null ? Texts.Get("admin.roleDetail.notFound") : null;
            name = role?.Name ?? string.Empty;
            selected = role?.Permissions.ToHashSet() ?? [];
            scope = role?.Scope ?? RecordScope.All;
            assignLevel = role?.AssignLevel ?? RoleAssignLevel.User;
            hideOutOfScopeShared = role?.HideOutOfScopeShared ?? false;
            overrides = OverridesOf(role);
        }
        else
        {
            role = null;
            var source = roles.FirstOrDefault(r => r.Id == CopyOf && !r.IsSystem);
            name = source is null ? string.Empty : Texts.Get("admin.roleDetail.copyName", source.Name);
            selected = source?.Permissions.ToHashSet() ?? [];
            scope = source?.Scope ?? (Session.IsAdministrator ? RecordScope.All : Session.Scope);
            assignLevel = source?.AssignLevel ?? RoleAssignLevel.User;
            hideOutOfScopeShared = source?.HideOutOfScopeShared ?? false;
            overrides = OverridesOf(source);
            templateKey = null;
            skippedFromTemplate = 0;
            templates = source is null ? (await Api.GetAsync<List<RoleTemplateDto>>("/api/roles/templates")).Value ?? [] : [];
            ApplyTemplate(TemplateKey);
        }

        loaded = true;
    }

    /// <summary>
    /// Şablonun izinlerini forma koyar; kişinin veremeyeceği izinler atlanır. Ad boşsa veya önceki şablonun adıysa şablonun
    /// adı yazılır, kişinin yazdığı ad korunur.
    /// </summary>
    private void ApplyTemplate(string? key)
    {
        var previous = Template;
        templateKey = string.IsNullOrEmpty(key) ? null : key;
        if (Template is not { } template)
        {
            skippedFromTemplate = 0;
            return;
        }

        if (string.IsNullOrWhiteSpace(name) || name == previous?.Name)
        {
            name = template.Name;
        }

        selected = template.Permissions.Where(CanGrant).ToHashSet();
        scope = CanGrantScope(template.Scope) ? template.Scope : Session.Scope;
        skippedFromTemplate = template.Permissions.Count - selected.Count;
    }

    private bool CanGrant(string permission) => Session.IsAdministrator || Session.Can(permission);

    private static readonly RecordScope[] ScopeOptions =
        [RecordScope.All, RecordScope.UnitAndBelow, RecordScope.Unit, RecordScope.Team, RecordScope.Own];

    private static readonly RoleAssignLevel[] AssignLevelOptions = [RoleAssignLevel.User, RoleAssignLevel.Unit, RoleAssignLevel.Both];

    // Sunucu da denetler: yönetici olmayan kişi kendi kapsamının kapsamadığı kapsamı veremez, kapsamadığı kapsamlı rolü daraltamaz.
    // Ekip ile departman birbirini kapsamaz; ekranda kişinin en geniş kapsamı bilinir, kesin karar sunucudadır.
    private bool CanGrantScope(RecordScope option) =>
        Session.IsAdministrator
        || (RecordScopeRules.Covers(Session.Scope, option) && (role is null || RecordScopeRules.Covers(Session.Scope, role.Scope)));

    // İstisna için işlemi yapanın kapsamı yeter (sunucu da denetler); rolün varsayılan kapsamıyla ilgisi yoktur.
    private bool CanGrantOverride(RecordScope option) => Session.IsAdministrator || RecordScopeRules.Covers(Session.Scope, option);

    // Platform tavanı: tavan seçeneği kapsıyorsa seçenek tavan içindedir (ekip ile departman birbirini kapsamaz).
    private static bool WithinLimit(RoleScopeTypeDto type, RecordScope option) =>
        type.MaxScope is not { } max || RecordScopeRules.Covers(max, option);

    // İstisnası olmayan türde varsayılan kapsam tavanı aşıyorsa sunucu rolü reddeder.
    private bool DefaultExceeds(RoleScopeTypeDto type) => !overrides.ContainsKey(type.EntityKey) && !WithinLimit(type, scope);

    private static Dictionary<string, RecordScope> OverridesOf(RoleDto? source) =>
        source?.ScopeOverrides is { } items ? new(items, StringComparer.Ordinal) : new(StringComparer.Ordinal);

    private void ChooseOverride(string entityKey, string? value)
    {
        if (int.TryParse(value, out var number) && Enum.IsDefined(typeof(RecordScope), number))
        {
            overrides[entityKey] = (RecordScope)number;
        }
        else
        {
            overrides.Remove(entityKey);
        }
    }

    private void LowerToLimits()
    {
        foreach (var type in scopeTypes.Where(DefaultExceeds))
        {
            overrides[type.EntityKey] = type.MaxScope!.Value;
        }
    }

    // Yönetici rolüne yalnızca yönetici taşıyabilir (sunucu da denetler).
    private IEnumerable<RoleDto> MoveTargets() =>
        roles.Where(r => r.Id != role!.Id && (!r.IsSystem || Session.IsAdministrator)).OrderBy(r => r.Name);

    private async Task SaveAsync()
    {
        busy = true;
        notice = null;
        var request = new SaveRoleRequest(name, selected.Order(StringComparer.Ordinal).ToList(), scope, assignLevel, hideOutOfScopeShared, overrides);
        var result = IsNew
            ? await Api.PostAsync<RoleDto>("/api/roles", request)
            : await Api.PutAsync<RoleDto>($"/api/roles/{RoleId}", request);
        busy = false;

        if (!result.IsSuccess)
        {
            message = result.Error;
            errors = result.FieldErrors;
            tabs.RevealFirstFailing(FormTabs);
            return;
        }

        // Kendi rolü değiştiyse menü ve izinler hemen güncellensin.
        await Session.RefreshAsync();
        if (IsNew)
        {
            Navigation.NavigateTo($"yonetim/roller/{result.Value!.Id}");
            return;
        }

        role = role! with
        {
            Name = result.Value!.Name,
            Permissions = result.Value.Permissions,
            Scope = result.Value.Scope,
            AssignLevel = result.Value.AssignLevel,
            HideOutOfScopeShared = result.Value.HideOutOfScopeShared,
            ScopeOverrides = result.Value.ScopeOverrides,
        };
        overrides = OverridesOf(role);
        selected = role.Permissions.ToHashSet();
        message = null;
        errors = null;
        notice = Texts.Get("admin.roleDetail.saved");
    }

    private async Task DeleteAsync()
    {
        busy = true;
        var url = $"/api/roles/{role!.Id}" + (role.MemberCount > 0 ? $"?moveTo={moveTo}" : string.Empty);
        var result = await Api.DeleteAsync(url);
        busy = false;

        if (!result.IsSuccess)
        {
            message = result.Error;
            deleting = false;
            return;
        }

        await Session.RefreshAsync();
        Navigation.NavigateTo("yonetim/roller");
    }
}
