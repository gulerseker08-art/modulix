@page "/yonetim/gunluk"
@inject ApiClient Api
@inject SessionState Session

<PageTitle>İşlem günlüğü · Modulix</PageTitle>

@* İşlem günlüğü (ADR-0033, Dilim 1): içe aktarmalar. Firmanın tamamını görme izni olmayan kullanıcı yalnızca kendi içe
   aktarmalarını görür (sunucu uygular). Satır hatalarında ham hücre değeri yoktur. *@
<AuthGate AnyPermission="@(new[] { CoreAccess.ReadImports, CoreAccess.RunImports })">
    <a class="back-link" href="yonetim">← Yönetim</a>

    <div class="page-header">
        <div>
            <h1>İşlem günlüğü</h1>
            <p class="text-muted mb-0">
                İçe aktarmalar: hangi dosya, kim tarafından, kaç satırın alındığı ve hatalı satırların nedeni.
                @if (!Session.Can(CoreAccess.ReadImports)) { <text>Yalnızca kendi içe aktarmalarınız görünür.</text> }
            </p>
        </div>
    </div>

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message <button type="button" class="btn btn-sm btn-outline-secondary ms-2" @onclick="() => LoadAsync(1)">Tekrar dene</button></div>
    }

    <div class="list-toolbar">
        <FilterToggle @bind-Open="filtersOpen" Count="ActiveFilters" />
        <ColumnPicker />
    </div>

    @if (filtersOpen || ActiveFilters > 0)
    {
        <div class="filters">
            <label class="visually-hidden" for="import-status">Durum</label>
            <select id="import-status" class="form-select form-select-sm filter-select" @bind="status" @bind:after="() => LoadAsync(1)">
                <option value="">Tüm durumlar</option>
                @foreach (var s in ImportText.Statuses) { <option value="@s">@ImportText.Status(s)</option> }
            </select>
            <label class="visually-hidden" for="import-mode">Mod</label>
            <select id="import-mode" class="form-select form-select-sm filter-select" @bind="mode" @bind:after="() => LoadAsync(1)">
                <option value="">Kuru çalışma ve uygulama</option>
                <option value="DryRun">@ImportText.Mode("DryRun")</option>
                <option value="Apply">@ImportText.Mode("Apply")</option>
            </select>
            <label class="visually-hidden" for="import-from">Başlangıç tarihi</label>
            <input id="import-from" class="form-control form-control-sm filter-select" type="date" @bind="from" @bind:after="() => LoadAsync(1)" />
            <label class="visually-hidden" for="import-to">Bitiş tarihi</label>
            <input id="import-to" class="form-control form-control-sm filter-select" type="date" @bind="to" @bind:after="() => LoadAsync(1)" />
        </div>
    }

    @if (list is null && message is null)
    {
        <p class="text-muted" role="status">Yükleniyor…</p>
    }
    else if (list is not null && list.Items.Count == 0)
    {
        <p class="text-muted" role="status">@(ActiveFilters > 0 ? "Bu süzgece uyan içe aktarma yok." : "Henüz içe aktarma yapılmadı.")</p>
    }
    else if (list is not null)
    {
        <p class="visually-hidden" role="status" aria-live="polite">@list.TotalCount içe aktarma listelendi.</p>
        <table class="table record-table">
            <caption class="visually-hidden">İçe aktarma listesi</caption>
            <thead>
                <tr>
                    <th scope="col">Tarih</th><th scope="col">Kullanıcı</th><th scope="col">Kayıt türü</th><th scope="col">Dosya</th>
                    <th scope="col">Durum</th><th scope="col">Satır</th><th scope="col">Oluşan</th><th scope="col">Güncellenen</th>
                    <th scope="col">Atlanan</th><th scope="col">Hatalı</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var run in list.Items)
                {
                    var open = openId == run.Id;
                    <tr class="@(open ? "is-open" : null)">
                        <td data-label="Tarih">
                            <button type="button" class="link-button" aria-expanded="@(open ? "true" : "false")" @onclick="() => Toggle(run.Id)">@CrmLabels.Time(run.CreatedAt)</button>
                        </td>
                        <td data-label="Kullanıcı">@run.UserName</td>
                        <td data-label="Kayıt türü">@run.EntityName</td>
                        <td data-label="Dosya" class="primary">
                            @run.FileName
                            <small class="text-muted d-block">@FileSize(run.FileSize) · @ImportText.Mode(run.Mode)</small>
                        </td>
                        <td data-label="Durum"><span class="badge stage-@ImportText.StatusBadge(run.Status)">@ImportText.Status(run.Status)</span></td>
                        <td data-label="Satır">@run.TotalRows.ToString("N0")</td>
                        <td data-label="Oluşan">@run.CreatedCount.ToString("N0")</td>
                        <td data-label="Güncellenen">@run.UpdatedCount.ToString("N0")</td>
                        <td data-label="Atlanan">@run.SkippedCount.ToString("N0")</td>
                        <td data-label="Hatalı">@run.FailedCount.ToString("N0")</td>
                    </tr>
                    @if (open)
                    {
                        <tr class="audit-detail">
                            <td colspan="10"><ImportRunDetailPanel RunId="run.Id" /></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
        <Pager PageSizeChoice="true" Page="list.Page" PageSize="list.PageSize" TotalCount="list.TotalCount" PageChanged="LoadAsync" />
    }
</AuthGate>

@code {
    private bool filtersOpen;
    private PagedResult<ImportRunDto>? list;
    private string? message;
    private string status = string.Empty;
    private string mode = string.Empty;
    private DateOnly? from;
    private DateOnly? to;
    private Guid? openId;

    /// <summary>Etkin süzgeç sayısı ("Filtrele" rozeti).</summary>
    private int ActiveFilters => (status.Length > 0 ? 1 : 0) + (mode.Length > 0 ? 1 : 0) + (from is null ? 0 : 1) + (to is null ? 0 : 1);

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (Session.CanAny([CoreAccess.ReadImports, CoreAccess.RunImports])) { await LoadAsync(1); }
    }

    private void Toggle(Guid id) => openId = openId == id ? null : id;

    private async Task LoadAsync(int pageNumber)
    {
        openId = null;
        var parts = new List<string> { $"page={pageNumber}&pageSize={ListPaging.Size}" };
        if (status.Length > 0) { parts.Add($"status={status}"); }
        if (mode.Length > 0) { parts.Add($"mode={mode}"); }
        if (from is { } f) { parts.Add($"from={f:yyyy-MM-dd}"); }
        if (to is { } t) { parts.Add($"to={t:yyyy-MM-dd}"); }

        var result = await Api.GetAsync<ImportRunPageDto>($"/api/imports?{string.Join('&', parts)}");
        list = result.Value is { } page ? new PagedResult<ImportRunDto>(page.Items, page.Page, page.PageSize, page.TotalCount) : null;
        message = result.IsSuccess ? null : result.Error;
    }

    private static string FileSize(long bytes) => bytes switch
    {
        < 1024 => $"{bytes} B",
        < 1024 * 1024 => $"{bytes / 1024.0:N1} KB",
        _ => $"{bytes / (1024.0 * 1024.0):N1} MB",
    };
}
