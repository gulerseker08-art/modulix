@page "/yonetim/sirketler"
@inject ApiClient Api
@inject SessionState Session

<PageTitle>@Texts.Get("nav.app.admin.companies") · Modulix</PageTitle>

@* İşletici şirketler (ADR-0008). Müşteri firma (CRM) değildir: belge kesen, hesap tutan kendi tüzel kişilerinizdir. *@
<AuthGate Permission="@CoreAccess.ManageCompanies">
    <a class="back-link" href="yonetim">← @Texts.Get("nav.app.admin")</a>

    <div class="page-header">
        <h1>@Texts.Get("nav.app.admin.companies")</h1>
    </div>

    <p class="text-muted">@((MarkupString)Texts.Get("admin.companies.intro", "<a href=\"yonetim/kullanicilar\">", "</a>"))</p>

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }

    <form class="record-form settings-group" novalidate @onsubmit="CreateAsync" @onsubmit:preventDefault>
        <h2>@Texts.Get("admin.companies.new")</h2>
        <FormTabs Title="@Texts.Get("admin.companies.section")" Label="@Texts.Get("admin.companies.sections")">
        <div class="form-grid">
            <div>
                <label class="form-label" for="companyName">@Texts.Get("admin.companies.name")</label>
                <input id="companyName" class="form-control" maxlength="200" placeholder="@Texts.Get("admin.companies.namePlaceholder")" @bind="name" @bind:event="oninput" />
                <FieldError Field="name" Errors="errors" />
            </div>
        </div>
        </FormTabs>
        <div class="form-actions">
            <button type="submit" class="btn btn-primary" disabled="@(busy || string.IsNullOrWhiteSpace(name))">@Texts.Get("admin.companies.add")</button>
        </div>
    </form>

    @if (companies is null)
    {
        @if (message is null)
        {
            <LoadingState Kind="LoadingKind.Table" />
        }
    }
    else
    {
        <table class="table record-table">
            <thead>
                <tr><th>@Texts.Get("admin.companies.col.company")</th><th>@Texts.Get("admin.companies.col.default")</th><th>@Texts.Get("admin.companies.col.branches")</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var company in companies)
                {
                    <tr>
                        <td data-label="@Texts.Get("admin.companies.col.company")" class="primary">
                            @if (editingId == company.Id)
                            {
                                <input class="form-control" maxlength="200" @bind="editName" @bind:event="oninput" />
                                <FieldError Field="name" Errors="errors" />
                            }
                            else
                            {
                                @company.Name
                            }
                        </td>
                        <td data-label="@Texts.Get("admin.companies.col.default")">@(company.IsDefault ? Texts.Get("common.yes") : "—")</td>
                        <td data-label="@Texts.Get("admin.companies.col.branches")">
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => ToggleBranchesAsync(company.Id)">
                                @(expandedCompanyId == company.Id ? Texts.Get("admin.companies.hide") : Texts.Get("admin.companies.col.branches"))@(branches.TryGetValue(company.Id, out var count) ? $" ({count.Count})" : "")
                            </button>
                        </td>
                        <td class="row-actions">
                            @if (editingId == company.Id)
                            {
                                <button type="button" class="btn btn-sm btn-primary" disabled="@(busy || string.IsNullOrWhiteSpace(editName))"
                                        @onclick="() => SaveRenameAsync(company.Id)">@Texts.Get("common.save")</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CancelEdit">@Texts.Get("common.dismiss")</button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => StartEdit(company)">@Texts.Get("admin.companies.rename")</button>
                            }
                        </td>
                    </tr>
                    @if (expandedCompanyId == company.Id)
                    {
                        <tr class="branch-detail">
                            <td colspan="4">
                                @* Şube = idari birim (ADR-0008); kapsam sınırı değildir. *@
                                @if (branches.TryGetValue(company.Id, out var list) && list.Count > 0)
                                {
                                    <ul class="branch-list">
                                        @foreach (var branch in list)
                                        {
                                            <li>
                                                @if (editingBranchId == branch.Id)
                                                {
                                                    <input class="form-control form-control-sm" maxlength="200" @bind="editBranchName" @bind:event="oninput" />
                                                    <button type="button" class="btn btn-sm btn-primary" disabled="@(busy || string.IsNullOrWhiteSpace(editBranchName))"
                                                            @onclick="() => SaveBranchRenameAsync(company.Id, branch.Id)">@Texts.Get("common.save")</button>
                                                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CancelBranchEdit">@Texts.Get("common.dismiss")</button>
                                                }
                                                else
                                                {
                                                    <span>@branch.Name</span>
                                                    <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => StartEditBranch(branch)">@Texts.Get("admin.companies.rename")</button>
                                                }
                                            </li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <p class="text-muted small">@Texts.Get("admin.companies.noBranches")</p>
                                }
                                <div class="branch-add">
                                    <input class="form-control form-control-sm" maxlength="200" placeholder="@Texts.Get("admin.companies.newBranch")" @bind="newBranchName" @bind:event="oninput" />
                                    <button type="button" class="btn btn-sm btn-primary" disabled="@(busy || string.IsNullOrWhiteSpace(newBranchName))"
                                            @onclick="() => CreateBranchAsync(company.Id)">@Texts.Get("admin.companies.addBranch")</button>
                                    <FieldError Field="name" Errors="branchErrors" />
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    }
</AuthGate>

@code {
    private IReadOnlyList<OperatingCompanyDto>? companies;
    private string name = string.Empty;
    private Guid? editingId;
    private string editName = string.Empty;
    private string? message;
    private bool busy;
    private IReadOnlyDictionary<string, string[]>? errors;

    // Şube yönetimi (ADR-0008, adım 5): şube idari birimdir, kapsam sınırı değildir.
    private readonly Dictionary<Guid, List<BranchDto>> branches = [];
    private Guid? expandedCompanyId;
    private string newBranchName = string.Empty;
    private Guid? editingBranchId;
    private string editBranchName = string.Empty;
    private IReadOnlyDictionary<string, string[]>? branchErrors;

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (Session.Can(CoreAccess.ManageCompanies))
        {
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        var result = await Api.GetAsync<List<OperatingCompanyDto>>("/api/companies");
        companies = result.Value;
        message = result.Error;
    }

    private async Task CreateAsync()
    {
        busy = true;
        var result = await Api.PostAsync<OperatingCompanyDto>("/api/companies", new SaveOperatingCompanyRequest(name));
        busy = false;
        errors = result.FieldErrors;
        if (result.IsSuccess)
        {
            name = string.Empty;
            errors = null;
            await LoadAsync();
            await Session.RefreshAsync();
            return;
        }

        message = result.FieldErrors.Count > 0 ? null : result.Error;
    }

    private void StartEdit(OperatingCompanyDto company)
    {
        editingId = company.Id;
        editName = company.Name;
        errors = null;
    }

    private void CancelEdit()
    {
        editingId = null;
        errors = null;
    }

    private async Task SaveRenameAsync(Guid companyId)
    {
        busy = true;
        var result = await Api.PutAsync<OperatingCompanyDto>($"/api/companies/{companyId}", new SaveOperatingCompanyRequest(editName));
        busy = false;
        errors = result.FieldErrors;
        if (result.IsSuccess)
        {
            editingId = null;
            errors = null;
            await LoadAsync();
            await Session.RefreshAsync();
            return;
        }

        message = result.FieldErrors.Count > 0 ? null : result.Error;
    }

    private async Task ToggleBranchesAsync(Guid companyId)
    {
        editingBranchId = null;
        newBranchName = string.Empty;
        branchErrors = null;
        if (expandedCompanyId == companyId)
        {
            expandedCompanyId = null;
            return;
        }

        expandedCompanyId = companyId;
        await LoadBranchesAsync(companyId);
    }

    private async Task LoadBranchesAsync(Guid companyId)
    {
        var result = await Api.GetAsync<List<BranchDto>>($"/api/companies/{companyId}/branches");
        if (result.IsSuccess)
        {
            branches[companyId] = result.Value ?? [];
        }
        else
        {
            message = result.Error;
        }
    }

    private async Task CreateBranchAsync(Guid companyId)
    {
        busy = true;
        var result = await Api.PostAsync<BranchDto>($"/api/companies/{companyId}/branches", new SaveBranchRequest(newBranchName));
        busy = false;
        branchErrors = result.FieldErrors;
        if (result.IsSuccess)
        {
            newBranchName = string.Empty;
            branchErrors = null;
            await LoadBranchesAsync(companyId);
            return;
        }

        message = result.FieldErrors.Count > 0 ? null : result.Error;
    }

    private void StartEditBranch(BranchDto branch)
    {
        editingBranchId = branch.Id;
        editBranchName = branch.Name;
        branchErrors = null;
    }

    private void CancelBranchEdit()
    {
        editingBranchId = null;
        branchErrors = null;
    }

    private async Task SaveBranchRenameAsync(Guid companyId, Guid branchId)
    {
        busy = true;
        var result = await Api.PutAsync<BranchDto>($"/api/companies/{companyId}/branches/{branchId}", new SaveBranchRequest(editBranchName));
        busy = false;
        branchErrors = result.FieldErrors;
        if (result.IsSuccess)
        {
            editingBranchId = null;
            branchErrors = null;
            await LoadBranchesAsync(companyId);
            return;
        }

        message = result.FieldErrors.Count > 0 ? null : result.Error;
    }
}
