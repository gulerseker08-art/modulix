@page "/yonetim/iletisim-tercihleri"
@inject ApiClient Api
@inject SessionState Session

<PageTitle>İletişim tercihleri · Modulix</PageTitle>

<AuthGate Permission="@CoreAccess.ReadCommunication">
    <div class="page-header">
        <div>
            <h1>İletişim tercihleri</h1>
            <p class="text-muted mb-0">
                Kişinin bir kanalda, bir amaçla bize ulaşılmasına izni (kanıtlı), reddi ve engeller. Kayıt yoksa durum "bilinmiyor"dur ve pazarlama gönderilmez; engel izni ezer.
                Bir adresin izni segmentte ya da müşteri kartında yer almakla verilmiş olmaz.
            </p>
        </div>
    </div>

    <Notice Text="@message" Failed="@failed" />

    <div class="record-tabs" role="tablist" aria-label="Bölümler">
        <button type="button" role="tab" class="record-tab @(tab == "prefs" ? "active" : null)" aria-selected="@(tab == "prefs")" @onclick='() => SwitchAsync("prefs")'>Tercihler</button>
        <button type="button" role="tab" class="record-tab @(tab == "blocks" ? "active" : null)" aria-selected="@(tab == "blocks")" @onclick='() => SwitchAsync("blocks")'>Engeller</button>
        <button type="button" role="tab" class="record-tab @(tab == "topics" ? "active" : null)" aria-selected="@(tab == "topics")" @onclick='() => SwitchAsync("topics")'>Konular</button>
    </div>

    @if (tab == "prefs")
    {
        <div class="filters">
            <label class="visually-hidden" for="p-channel">Kanal</label>
            <select id="p-channel" class="form-select form-select-sm filter-select" @bind="channel" @bind:after="() => LoadPrefsAsync(1)">
                <option value="">Tüm kanallar</option>
                @foreach (var c in Channels) { <option value="@c.Key">@c.Label</option> }
            </select>
            <label class="visually-hidden" for="p-status">Durum</label>
            <select id="p-status" class="form-select form-select-sm filter-select" @bind="status" @bind:after="() => LoadPrefsAsync(1)">
                <option value="">Tüm durumlar</option>
                <option value="Granted">İzinli</option>
                <option value="Denied">Reddedildi</option>
                <option value="Unknown">Bilinmiyor</option>
            </select>
        </div>
        <form class="search" @onsubmit="() => LoadPrefsAsync(1)" @onsubmit:preventDefault>
            <label class="visually-hidden" for="p-search">Adres ara</label>
            <input id="p-search" class="form-control" type="search" placeholder="Adres (e-posta ya da telefon)" @bind="address" />
            <button type="submit" class="btn btn-outline-secondary">Ara</button>
        </form>

        @if (prefs is null && message is null)
        {
            <LoadingState Kind="LoadingKind.Table" />
        }
        else if (prefs is not null && prefs.Items.Count == 0)
        {
            <p class="text-muted" role="status">Bu süzgece uyan tercih kaydı yok.</p>
        }
        else if (prefs is not null)
        {
            <p class="visually-hidden" role="status" aria-live="polite">@prefs.TotalCount kayıt listelendi.</p>
            <div class="table-wrap">
                <table class="table table-sm">
                    <caption class="visually-hidden">İletişim tercihleri</caption>
                    <thead><tr><th scope="col">Kanal</th><th scope="col">Adres</th><th scope="col">Amaç</th><th scope="col">Durum</th><th scope="col">Kaynak</th><th scope="col">Değişti</th><th scope="col"><span class="visually-hidden">İşlem</span></th></tr></thead>
                    <tbody>
                    @foreach (var p in prefs.Items)
                    {
                        <tr>
                            <td>@ChannelText(p.Channel)</td>
                            <td>@p.Address</td>
                            <td>@PurposeText(p.Purpose)</td>
                            <td><span class="badge @StatusClass(p.Status)">@StatusText(p.Status)</span></td>
                            <td>@p.Source@(string.IsNullOrWhiteSpace(p.EvidenceRef) ? null : " · " + p.EvidenceRef)</td>
                            <td>@CrmLabels.Time(p.ChangedAt)</td>
                            <td><button type="button" class="btn btn-sm btn-outline-secondary" aria-expanded="@(openEvents == p.Id)" @onclick="() => ToggleEventsAsync(p)">Geçmiş</button></td>
                        </tr>
                        @if (openEvents == p.Id)
                        {
                            <tr>
                                <td colspan="7">
                                    @if (events is null) { <span class="text-muted" role="status">Yükleniyor…</span> }
                                    else if (events.Count == 0) { <span class="text-muted">Geçmiş kaydı yok.</span> }
                                    else
                                    {
                                        <ul class="list-unstyled mb-0">
                                            @foreach (var e in events)
                                            {
                                                <li>@CrmLabels.Time(e.ChangedAt) — @StatusText(e.FromStatus) → <strong>@StatusText(e.ToStatus)</strong> · @e.Source@(string.IsNullOrWhiteSpace(e.EvidenceRef) ? null : " · kanıt: " + e.EvidenceRef)@(string.IsNullOrWhiteSpace(e.Reason) ? null : " · " + e.Reason)</li>
                                            }
                                        </ul>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    </tbody>
                </table>
            </div>
            <Pager Page="prefs.Page" PageSize="prefs.PageSize" TotalCount="prefs.TotalCount" PageChanged="LoadPrefsAsync" />
        }

        @if (Session.Can(CoreAccess.ManageCommunication))
        {
            <form class="record-form" novalidate @onsubmit="SaveConsentAsync" @onsubmit:preventDefault>
                <fieldset disabled="@busy">
                    <legend class="h6">İzin ya da ret kaydet</legend>
                    <p class="text-muted small">Her kayıt kaynağı ve kanıtıyla tarihçeye yazılır. Reddedilmiş bir izin yalnızca kişinin kendisi (tercih merkezi) ya da yeni bir kanıtlı kayıtla değişir.</p>
                    <div class="form-grid">
                        <div class="span-3">
                            <label class="form-label" for="c-ch">Kanal</label>
                            <select id="c-ch" class="form-select" @bind="formChannel">
                                @foreach (var c in Channels) { <option value="@c.Key">@c.Label</option> }
                            </select>
                            <FieldError Field="channel" Errors="errors" />
                        </div>
                        <div class="span-5">
                            <label class="form-label" for="c-addr">Adres</label>
                            <input id="c-addr" class="form-control" maxlength="254" @bind="formAddress" />
                            <FieldError Field="address" Errors="errors" />
                        </div>
                        <div class="span-2">
                            <label class="form-label" for="c-status2">Durum</label>
                            <select id="c-status2" class="form-select" @bind="formStatus">
                                <option value="Granted">İzin verildi</option>
                                <option value="Denied">Reddedildi</option>
                            </select>
                            <FieldError Field="status" Errors="errors" />
                        </div>
                        <div class="span-6">
                            <label class="form-label" for="c-evidence">Kanıt (form, sözleşme, e-posta no…)</label>
                            <input id="c-evidence" class="form-control" maxlength="200" @bind="formEvidence" />
                            <FieldError Field="evidenceRef" Errors="errors" />
                        </div>
                        <div class="span-6">
                            <label class="form-label" for="c-reason">Gerekçe</label>
                            <input id="c-reason" class="form-control" maxlength="500" @bind="formReason" />
                            <FieldError Field="reason" Errors="errors" />
                        </div>
                    </div>
                </fieldset>
                <div class="form-actions"><button type="submit" class="btn btn-primary" disabled="@(busy || string.IsNullOrWhiteSpace(formAddress))">Kaydet</button></div>
            </form>
        }
    }
    else if (tab == "blocks")
    {
        <div class="filters">
            <label class="visually-hidden" for="b-active">Durum</label>
            <select id="b-active" class="form-select form-select-sm filter-select" @bind="blockActive" @bind:after="() => LoadBlocksAsync(1)">
                <option value="">Tümü</option>
                <option value="true">Etkin engeller</option>
                <option value="false">Kaldırılmış ya da süresi dolmuş</option>
            </select>
        </div>

        @if (blocks is null && message is null)
        {
            <LoadingState Kind="LoadingKind.Table" />
        }
        else if (blocks is not null && blocks.Items.Count == 0)
        {
            <p class="text-muted" role="status">Bu süzgece uyan engel yok.</p>
        }
        else if (blocks is not null)
        {
            <div class="table-wrap">
                <table class="table table-sm">
                    <caption class="visually-hidden">Engeller</caption>
                    <thead><tr><th scope="col">Kanal</th><th scope="col">Adres</th><th scope="col">Neden</th><th scope="col">Başlangıç</th><th scope="col">Bitiş</th><th scope="col">Durum</th><th scope="col"><span class="visually-hidden">İşlem</span></th></tr></thead>
                    <tbody>
                    @foreach (var b in blocks.Items)
                    {
                        <tr>
                            <td>@ChannelText(b.Channel)</td>
                            <td>@b.Address</td>
                            <td>@ReasonText(b.Reason)@(string.IsNullOrWhiteSpace(b.Note) ? null : " · " + b.Note)</td>
                            <td>@CrmLabels.Time(b.StartsAt)</td>
                            <td>@(b.EndsAt is { } end ? CrmLabels.Time(end) : "süresiz")</td>
                            <td>@(b.LiftedAt is not null ? "Kaldırıldı" + (string.IsNullOrWhiteSpace(b.LiftReason) ? null : " · " + b.LiftReason) : b.IsActive ? "Etkin" : "Süresi doldu")</td>
                            <td>
                                @if (b.IsActive && Session.Can(CoreAccess.SuppressCommunication))
                                {
                                    <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@busy" @onclick="() => AskLift(b)">Engeli kaldır</button>
                                }
                            </td>
                        </tr>
                        @if (liftId == b.Id)
                        {
                            <tr>
                                <td colspan="7">
                                    <div class="filters">
                                        <label class="visually-hidden" for="lift-reason">Gerekçe</label>
                                        <input id="lift-reason" class="form-control" maxlength="500" placeholder="Kaldırma gerekçesi (zorunlu)" @bind="liftReason" />
                                        <button type="button" class="btn btn-sm btn-primary" disabled="@(busy || string.IsNullOrWhiteSpace(liftReason))" @onclick="LiftAsync">Onayla</button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => liftId = null">Vazgeç</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    </tbody>
                </table>
            </div>
            <Pager Page="blocks.Page" PageSize="blocks.PageSize" TotalCount="blocks.TotalCount" PageChanged="LoadBlocksAsync" />
        }

        @if (Session.Can(CoreAccess.SuppressCommunication))
        {
            <form class="record-form" novalidate @onsubmit="AddBlockAsync" @onsubmit:preventDefault>
                <fieldset disabled="@busy">
                    <legend class="h6">Adresi engelle</legend>
                    <p class="text-muted small">Engellenen adrese hiçbir pazarlama iletisi gitmez; izin verilmiş olsa bile. Kaldırmak gerekçe ister ve tarihçeye yazılır.</p>
                    <div class="form-grid">
                        <div class="span-3">
                            <label class="form-label" for="s-ch">Kanal</label>
                            <select id="s-ch" class="form-select" @bind="blockChannel">
                                @foreach (var c in Channels) { <option value="@c.Key">@c.Label</option> }
                            </select>
                            <FieldError Field="channel" Errors="errors" />
                        </div>
                        <div class="span-5">
                            <label class="form-label" for="s-addr">Adres</label>
                            <input id="s-addr" class="form-control" maxlength="254" @bind="blockAddress" />
                            <FieldError Field="address" Errors="errors" />
                        </div>
                        <div class="span-4">
                            <label class="form-label" for="s-reason">Neden</label>
                            <select id="s-reason" class="form-select" @bind="blockReason">
                                @foreach (var r in Reasons) { <option value="@r.Key">@r.Label</option> }
                            </select>
                            <FieldError Field="reason" Errors="errors" />
                        </div>
                        <div class="span-12">
                            <label class="form-label" for="s-note">Not (isteğe bağlı)</label>
                            <input id="s-note" class="form-control" maxlength="500" @bind="blockNote" />
                            <FieldError Field="note" Errors="errors" />
                        </div>
                    </div>
                </fieldset>
                <div class="form-actions"><button type="submit" class="btn btn-primary" disabled="@(busy || string.IsNullOrWhiteSpace(blockAddress))">Engelle</button></div>
            </form>
        }
    }
    else
    {
        <p class="text-muted">
            Konu, pazarlama iznini değil yalnızca kapsamını daraltır: kişi bir konudan çıkabilir, ama konuya dönmek izin vermez. Konusu seçilmiş bir kampanya, o konudan çıkmış alıcılara gönderilmez.
            Kişiler konu tercihini abonelik bağlantısındaki tercih merkezinden de değiştirebilir.
        </p>

        @if (topics is null && message is null)
        {
            <LoadingState Kind="LoadingKind.Table" />
        }
        else if (topics is not null && topics.Count == 0)
        {
            <p class="text-muted" role="status">Henüz konu tanımlı değil.</p>
        }
        else if (topics is not null)
        {
            <div class="table-wrap">
                <table class="table table-sm">
                    <caption class="visually-hidden">Konular</caption>
                    <thead><tr><th scope="col">Anahtar</th><th scope="col">Ad</th><th scope="col">Durum</th><th scope="col"><span class="visually-hidden">İşlem</span></th></tr></thead>
                    <tbody>
                    @foreach (var t in topics)
                    {
                        <tr>
                            <td><code>@t.Key</code></td>
                            <td>@t.Name</td>
                            <td><span class="badge @(t.IsActive ? "text-bg-success" : "text-bg-secondary")">@(t.IsActive ? "Açık" : "Kapalı")</span></td>
                            <td>
                                @if (Session.Can(CoreAccess.ManageCommunication))
                                {
                                    <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@busy" @onclick="() => ToggleTopicAsync(t)">@(t.IsActive ? "Kapat" : "Aç")</button>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }

        @if (Session.Can(CoreAccess.ManageCommunication))
        {
            <form class="record-form" novalidate @onsubmit="SaveTopicAsync" @onsubmit:preventDefault>
                <fieldset disabled="@busy">
                    <legend class="h6">Konu ekle</legend>
                    <p class="text-muted small">Anahtar küçük harf, rakam ve tireden oluşur ve sonradan değişmez (ör. haber-bulteni). Kapalı konu yeni kampanyada seçilemez ve tercih merkezinde görünmez; mevcut tercihler korunur.</p>
                    <div class="form-grid">
                        <div class="span-4">
                            <label class="form-label" for="t-key">Anahtar</label>
                            <input id="t-key" class="form-control" maxlength="40" @bind="topicKey" />
                            <FieldError Field="key" Errors="errors" />
                        </div>
                        <div class="span-8">
                            <label class="form-label" for="t-name">Ad</label>
                            <input id="t-name" class="form-control" maxlength="100" @bind="topicName" />
                            <FieldError Field="name" Errors="errors" />
                        </div>
                    </div>
                </fieldset>
                <div class="form-actions"><button type="submit" class="btn btn-primary" disabled="@(busy || string.IsNullOrWhiteSpace(topicKey) || string.IsNullOrWhiteSpace(topicName))">Kaydet</button></div>
            </form>
        }

        <h2 class="h6 mt-4">Konudan çıkışlar</h2>
        <div class="filters">
            <label class="visually-hidden" for="tp-topic">Konu</label>
            <select id="tp-topic" class="form-select form-select-sm filter-select" @bind="topicFilter" @bind:after="() => LoadTopicPrefsAsync(1)">
                <option value="">Tüm konular</option>
                @foreach (var t in topics ?? []) { <option value="@t.Key">@t.Name</option> }
            </select>
        </div>
        @if (topicPrefs is null && message is null)
        {
            <LoadingState Kind="LoadingKind.Table" />
        }
        else if (topicPrefs is not null && topicPrefs.Items.Count == 0)
        {
            <p class="text-muted" role="status">Konudan çıkış kaydı yok.</p>
        }
        else if (topicPrefs is not null)
        {
            <div class="table-wrap">
                <table class="table table-sm">
                    <caption class="visually-hidden">Konu tercihleri</caption>
                    <thead><tr><th scope="col">Kanal</th><th scope="col">Adres</th><th scope="col">Konu</th><th scope="col">Durum</th><th scope="col">Kaynak</th><th scope="col">Değişti</th></tr></thead>
                    <tbody>
                    @foreach (var p in topicPrefs.Items)
                    {
                        <tr>
                            <td>@ChannelText(p.Channel)</td>
                            <td>@p.Address</td>
                            <td>@TopicName(p.TopicKey)</td>
                            <td><span class="badge @(p.OptedOut ? "text-bg-danger" : "text-bg-success")">@(p.OptedOut ? "Konudan çıktı" : "Konuda")</span></td>
                            <td>@p.Source</td>
                            <td>@CrmLabels.Time(p.ChangedAt)</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <Pager Page="topicPrefs.Page" PageSize="topicPrefs.PageSize" TotalCount="topicPrefs.TotalCount" PageChanged="LoadTopicPrefsAsync" />
        }

        @if (Session.Can(CoreAccess.ManageCommunication) && topics is { Count: > 0 })
        {
            <form class="record-form" novalidate @onsubmit="SaveTopicPrefAsync" @onsubmit:preventDefault>
                <fieldset disabled="@busy">
                    <legend class="h6">Konu çıkışı kaydet</legend>
                    <p class="text-muted small">Konudan çıkış her kaynakla kaydedilir. Çıkışı geri açmak yalnızca kişinin kendisi (tercih merkezi) ya da yetkili kullanıcıyla olur ve pazarlama izni vermez.</p>
                    <div class="form-grid">
                        <div class="span-3">
                            <label class="form-label" for="tp-ch">Kanal</label>
                            <select id="tp-ch" class="form-select" @bind="tpChannel">
                                @foreach (var c in Channels) { <option value="@c.Key">@c.Label</option> }
                            </select>
                            <FieldError Field="channel" Errors="errors" />
                        </div>
                        <div class="span-4">
                            <label class="form-label" for="tp-addr">Adres</label>
                            <input id="tp-addr" class="form-control" maxlength="254" @bind="tpAddress" />
                            <FieldError Field="address" Errors="errors" />
                        </div>
                        <div class="span-3">
                            <label class="form-label" for="tp-key">Konu</label>
                            <select id="tp-key" class="form-select" @bind="tpTopic">
                                <option value="">Seçin</option>
                                @foreach (var t in topics) { <option value="@t.Key">@t.Name</option> }
                            </select>
                            <FieldError Field="topicKey" Errors="errors" />
                        </div>
                        <div class="span-2">
                            <label class="form-label" for="tp-out">Durum</label>
                            <select id="tp-out" class="form-select" @bind="tpOptedOut">
                                <option value="true">Konudan çıktı</option>
                                <option value="false">Konuya döndü</option>
                            </select>
                        </div>
                    </div>
                </fieldset>
                <div class="form-actions"><button type="submit" class="btn btn-primary" disabled="@(busy || string.IsNullOrWhiteSpace(tpAddress) || tpTopic.Length == 0)">Kaydet</button></div>
            </form>
        }
    }
</AuthGate>

@code {
    private static readonly (string Key, string Label)[] Channels = [("Email", "E-posta"), ("Phone", "Telefon"), ("Sms", "SMS"), ("WhatsApp", "WhatsApp")];
    private static readonly (string Key, string Label)[] Reasons =
        [("OptOut", "Çıkış (kişi istedi)"), ("Complaint", "Şikâyet"), ("HardBounce", "Kalıcı geri dönme"), ("InvalidAddress", "Geçersiz adres"), ("Manual", "Elle")];

    private string tab = "prefs";
    private PreferencePageDto? prefs;
    private SuppressionPageDto? blocks;
    private List<ConsentEventDto>? events;
    private Guid? openEvents;
    private Guid? liftId;
    private string liftReason = string.Empty;
    private string channel = string.Empty;
    private string status = string.Empty;
    private string address = string.Empty;
    private string blockActive = "true";
    private string formChannel = "Email";
    private string formAddress = string.Empty;
    private string formStatus = "Granted";
    private string formEvidence = string.Empty;
    private string formReason = string.Empty;
    private string blockChannel = "Email";
    private string blockAddress = string.Empty;
    private string blockReason = "Manual";
    private string blockNote = string.Empty;
    private List<TopicDto>? topics;
    private TopicPreferencePageDto? topicPrefs;
    private string topicKey = string.Empty;
    private string topicName = string.Empty;
    private string topicFilter = string.Empty;
    private string tpChannel = "Email";
    private string tpAddress = string.Empty;
    private string tpTopic = string.Empty;
    private string tpOptedOut = "true";
    private string? message;
    private bool failed;
    private bool busy;
    private IReadOnlyDictionary<string, string[]>? errors;

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        await LoadPrefsAsync(1);
    }

    private async Task SwitchAsync(string next)
    {
        tab = next;
        message = null;
        errors = null;
        if (next == "prefs") { await LoadPrefsAsync(1); }
        else if (next == "blocks") { await LoadBlocksAsync(1); }
        else { await LoadTopicsAsync(); await LoadTopicPrefsAsync(1); }
    }

    private async Task LoadTopicsAsync()
    {
        var result = await Api.GetAsync<List<TopicDto>>("/api/communication/topics");
        if (result.IsSuccess) { topics = result.Value ?? []; } else { Report(result.Error, true); }
    }

    private async Task LoadTopicPrefsAsync(int page)
    {
        var result = await Api.GetAsync<TopicPreferencePageDto>(
            $"/api/communication/topic-preferences?page={page}&pageSize=25" + (topicFilter.Length > 0 ? $"&topic={Uri.EscapeDataString(topicFilter)}" : null));
        if (result.IsSuccess) { topicPrefs = result.Value; } else { Report(result.Error, true); }
    }

    private async Task SaveTopicAsync()
    {
        busy = true;
        errors = null;
        var result = await Api.PutAsync<TopicDto>("/api/communication/topics", new SaveTopicRequest(topicKey.Trim(), topicName.Trim(), true));
        busy = false;
        if (result.IsSuccess)
        {
            topicKey = string.Empty; topicName = string.Empty;
            await LoadTopicsAsync();
            Report("Konu kaydedildi.", false);
        }
        else
        {
            errors = result.FieldErrors.Count == 0 ? null : result.FieldErrors;
            Report(result.Error, true);
        }
    }

    private async Task ToggleTopicAsync(TopicDto topic)
    {
        busy = true;
        var result = await Api.PutAsync<TopicDto>("/api/communication/topics", new SaveTopicRequest(topic.Key, topic.Name, !topic.IsActive));
        busy = false;
        if (result.IsSuccess)
        {
            await LoadTopicsAsync();
            Report(topic.IsActive ? "Konu kapatıldı." : "Konu açıldı.", false);
        }
        else
        {
            Report(result.Error, true);
        }
    }

    private async Task SaveTopicPrefAsync()
    {
        busy = true;
        errors = null;
        var result = await Api.PutAsync<TopicPreferenceDto>("/api/communication/topic-preferences",
            new SaveTopicPreferenceRequest(tpChannel, tpAddress.Trim(), tpTopic, tpOptedOut == "true", null));
        busy = false;
        if (result.IsSuccess)
        {
            tpAddress = string.Empty;
            await LoadTopicPrefsAsync(1);
            Report("Konu tercihi kaydedildi.", false);
        }
        else
        {
            errors = result.FieldErrors.Count == 0 ? null : result.FieldErrors;
            Report(result.Error, true);
        }
    }

    private string TopicName(string key) => topics?.FirstOrDefault(t => t.Key == key)?.Name ?? key;

    private async Task LoadPrefsAsync(int page)
    {
        var query = $"?page={page}&pageSize=25"
            + (channel.Length > 0 ? $"&channel={channel}" : null)
            + (status.Length > 0 ? $"&status={status}" : null)
            + (string.IsNullOrWhiteSpace(address) ? null : $"&address={Uri.EscapeDataString(address.Trim())}");
        var result = await Api.GetAsync<PreferencePageDto>("/api/communication/preferences" + query);
        if (result.IsSuccess) { prefs = result.Value; } else { Report(result.Error, true); }
    }

    private async Task LoadBlocksAsync(int page)
    {
        var result = await Api.GetAsync<SuppressionPageDto>($"/api/communication/suppressions?page={page}&pageSize=25" + (blockActive.Length > 0 ? $"&active={blockActive}" : null));
        if (result.IsSuccess) { blocks = result.Value; } else { Report(result.Error, true); }
    }

    private async Task ToggleEventsAsync(PreferenceDto preference)
    {
        if (openEvents == preference.Id) { openEvents = null; return; }
        openEvents = preference.Id;
        events = null;
        var result = await Api.GetAsync<List<ConsentEventDto>>($"/api/communication/preferences/{preference.Id}/events");
        events = result.Value ?? [];
        if (!result.IsSuccess) { Report(result.Error, true); }
    }

    private async Task SaveConsentAsync()
    {
        busy = true;
        errors = null;
        var result = await Api.PutAsync<PreferenceDto>("/api/communication/preferences",
            new SaveConsentRequest(formChannel, formAddress.Trim(), "Marketing", formStatus, null,
                string.IsNullOrWhiteSpace(formEvidence) ? null : formEvidence.Trim(), string.IsNullOrWhiteSpace(formReason) ? null : formReason.Trim(), null, null));
        busy = false;
        if (result.IsSuccess)
        {
            formAddress = string.Empty; formEvidence = string.Empty; formReason = string.Empty;
            Report("Tercih kaydedildi.", false);
            await LoadPrefsAsync(1);
        }
        else
        {
            errors = result.FieldErrors.Count == 0 ? null : result.FieldErrors;
            Report(result.Error, true);
        }
    }

    private async Task AddBlockAsync()
    {
        busy = true;
        errors = null;
        var result = await Api.PostAsync<SuppressionDto>("/api/communication/suppressions",
            new SaveSuppressionRequest(blockChannel, blockAddress.Trim(), blockReason, string.IsNullOrWhiteSpace(blockNote) ? null : blockNote.Trim(), null));
        busy = false;
        if (result.IsSuccess)
        {
            blockAddress = string.Empty; blockNote = string.Empty;
            Report("Adres engellendi.", false);
            await LoadBlocksAsync(1);
        }
        else
        {
            errors = result.FieldErrors.Count == 0 ? null : result.FieldErrors;
            Report(result.Error, true);
        }
    }

    private void AskLift(SuppressionDto block)
    {
        liftId = block.Id;
        liftReason = string.Empty;
    }

    private async Task LiftAsync()
    {
        if (liftId is not { } id || string.IsNullOrWhiteSpace(liftReason)) { return; }
        busy = true;
        var result = await Api.PostAsync<SuppressionDto>($"/api/communication/suppressions/{id}/lift", new LiftSuppressionRequest(liftReason.Trim()));
        busy = false;
        liftId = null;
        Report(result.IsSuccess ? "Engel kaldırıldı." : result.Error, !result.IsSuccess);
        await LoadBlocksAsync(1);
    }

    private void Report(string? text, bool isFailure)
    {
        message = text;
        failed = isFailure;
    }

    private static string ChannelText(string key) => Channels.FirstOrDefault(c => c.Key == key).Label ?? key;

    private static string PurposeText(string key) => key switch { "Marketing" => "Pazarlama", "Transactional" => "İşlemsel", "Service" => "Hizmet", _ => key };

    private static string ReasonText(string key) => Reasons.FirstOrDefault(r => r.Key == key).Label ?? key;

    private static string StatusText(string key) => key switch { "Granted" => "İzinli", "Denied" => "Reddedildi", "Unknown" => "Bilinmiyor", _ => key };

    private static string StatusClass(string key) => key switch { "Granted" => "text-bg-success", "Denied" => "text-bg-danger", _ => "text-bg-secondary" };
}
