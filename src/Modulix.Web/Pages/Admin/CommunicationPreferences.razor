@page "/yonetim/iletisim-tercihleri"
@inject ApiClient Api
@inject SessionState Session

<PageTitle>@Texts.Get("nav.app.admin.communication") · Modulix</PageTitle>

<AuthGate Permission="@CoreAccess.ReadCommunication">
    <div class="page-header">
        <div>
            <h1>@Texts.Get("nav.app.admin.communication")</h1>
            <p class="text-muted mb-0">
                @Texts.Get("admin.commPrefs.intro")
            </p>
        </div>
    </div>

    <Notice Text="@message" Failed="@failed" />

    <div class="record-tabs" role="tablist" aria-label="@Texts.Get("common.sections")">
        <button type="button" role="tab" class="record-tab @(tab == "prefs" ? "active" : null)" aria-selected="@(tab == "prefs")" @onclick='() => SwitchAsync("prefs")'>@Texts.Get("admin.commPrefs.tab.prefs")</button>
        <button type="button" role="tab" class="record-tab @(tab == "blocks" ? "active" : null)" aria-selected="@(tab == "blocks")" @onclick='() => SwitchAsync("blocks")'>@Texts.Get("admin.commPrefs.tab.blocks")</button>
        <button type="button" role="tab" class="record-tab @(tab == "topics" ? "active" : null)" aria-selected="@(tab == "topics")" @onclick='() => SwitchAsync("topics")'>@Texts.Get("admin.commPrefs.tab.topics")</button>
    </div>

    @if (tab == "prefs")
    {
        <div class="filters">
            <label class="visually-hidden" for="p-channel">@Texts.Get("admin.commPrefs.channel")</label>
            <select id="p-channel" class="form-select form-select-sm filter-select" @bind="channel" @bind:after="() => LoadPrefsAsync(1)">
                <option value="">@Texts.Get("marketing.allChannels")</option>
                @foreach (var c in Channels) { <option value="@c.Key">@c.Label</option> }
            </select>
            <label class="visually-hidden" for="p-status">@Texts.Get("common.field.status")</label>
            <select id="p-status" class="form-select form-select-sm filter-select" @bind="status" @bind:after="() => LoadPrefsAsync(1)">
                <option value="">@Texts.Get("common.allStatuses")</option>
                @foreach (var st in SettingsLabels.ConsentStatuses) { <option value="@st.Key">@st.Label</option> }
            </select>
        </div>
        <form class="search" @onsubmit="() => LoadPrefsAsync(1)" @onsubmit:preventDefault>
            <label class="visually-hidden" for="p-search">@Texts.Get("admin.commPrefs.searchAddress")</label>
            <input id="p-search" class="form-control" type="search" placeholder="@Texts.Get("admin.commPrefs.addressPlaceholder")" @bind="address" />
            <button type="submit" class="btn btn-outline-secondary">@Texts.Get("common.search")</button>
        </form>

        @if (prefs is null && message is null)
        {
            <LoadingState Kind="LoadingKind.Table" />
        }
        else if (prefs is not null && prefs.Items.Count == 0)
        {
            <EmptyState Compact="true" Title="@Texts.Get("admin.commPrefs.emptyPrefs")" />
        }
        else if (prefs is not null)
        {
            <p class="visually-hidden" role="status" aria-live="polite">@Texts.Get("admin.commPrefs.listed", prefs.TotalCount)</p>
            <div class="table-wrap">
                <table class="table table-sm">
                    <caption class="visually-hidden">@Texts.Get("nav.app.admin.communication")</caption>
                    <thead><tr><th scope="col">@Texts.Get("admin.commPrefs.channel")</th><th scope="col">@Texts.Get("admin.commPrefs.address")</th><th scope="col">@Texts.Get("marketing.purpose")</th><th scope="col">@Texts.Get("common.field.status")</th><th scope="col">@Texts.Get("admin.automation.source")</th><th scope="col">@Texts.Get("admin.commPrefs.changed")</th><th scope="col"><span class="visually-hidden">@Texts.Get("admin.automationRun.col.action")</span></th></tr></thead>
                    <tbody>
                    @foreach (var p in prefs.Items)
                    {
                        <tr>
                            <td>@ChannelText(p.Channel)</td>
                            <td>@p.Address</td>
                            <td>@PurposeText(p.Purpose)</td>
                            <td><span class="badge @StatusClass(p.Status)">@StatusText(p.Status)</span></td>
                            <td>@p.Source@(string.IsNullOrWhiteSpace(p.EvidenceRef) ? null : " · " + p.EvidenceRef)</td>
                            <td>@CrmLabels.Time(p.ChangedAt)</td>
                            <td><button type="button" class="btn btn-sm btn-outline-secondary" aria-expanded="@(openEvents == p.Id)" @onclick="() => ToggleEventsAsync(p)">@Texts.Get("common.history.tab")</button></td>
                        </tr>
                        @if (openEvents == p.Id)
                        {
                            <tr>
                                <td colspan="7">
                                    @if (events is null) { <span class="text-muted" role="status">@Texts.Get("common.loading")</span> }
                                    else if (events.Count == 0) { <span class="text-muted">@Texts.Get("admin.commPrefs.noEvents")</span> }
                                    else
                                    {
                                        <ul class="list-unstyled mb-0">
                                            @foreach (var e in events)
                                            {
                                                <li>@CrmLabels.Time(e.ChangedAt) — @StatusText(e.FromStatus) → <strong>@StatusText(e.ToStatus)</strong> · @e.Source@(string.IsNullOrWhiteSpace(e.EvidenceRef) ? null : " · " + Texts.Get("admin.commPrefs.evidenceOf", e.EvidenceRef))@(string.IsNullOrWhiteSpace(e.Reason) ? null : " · " + e.Reason)</li>
                                            }
                                        </ul>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    </tbody>
                </table>
            </div>
            <Pager Page="prefs.Page" PageSize="prefs.PageSize" TotalCount="prefs.TotalCount" PageChanged="LoadPrefsAsync" />
        }

        @if (Session.Can(CoreAccess.ManageCommunication))
        {
            <form class="record-form" novalidate @onsubmit="SaveConsentAsync" @onsubmit:preventDefault>
                <fieldset disabled="@busy">
                    <legend class="h6">@Texts.Get("admin.commPrefs.consentTitle")</legend>
                    <p class="text-muted small">@Texts.Get("admin.commPrefs.consentHint")</p>
                    <div class="form-grid">
                        <div class="span-3">
                            <label class="form-label" for="c-ch">@Texts.Get("admin.commPrefs.channel")</label>
                            <select id="c-ch" class="form-select" @bind="formChannel">
                                @foreach (var c in Channels) { <option value="@c.Key">@c.Label</option> }
                            </select>
                            <FieldError Field="channel" Errors="errors" />
                        </div>
                        <div class="span-5">
                            <label class="form-label" for="c-addr">@Texts.Get("admin.commPrefs.address")</label>
                            <input id="c-addr" class="form-control" maxlength="254" @bind="formAddress" />
                            <FieldError Field="address" Errors="errors" />
                        </div>
                        <div class="span-2">
                            <label class="form-label" for="c-status2">@Texts.Get("common.field.status")</label>
                            <select id="c-status2" class="form-select" @bind="formStatus">
                                <option value="Granted">@Texts.Get("admin.commPrefs.granted")</option>
                                <option value="Denied">@SettingsLabels.ConsentStatus("Denied")</option>
                            </select>
                            <FieldError Field="status" Errors="errors" />
                        </div>
                        <div class="span-6">
                            <label class="form-label" for="c-evidence">@Texts.Get("admin.commPrefs.evidence")</label>
                            <input id="c-evidence" class="form-control" maxlength="200" @bind="formEvidence" />
                            <FieldError Field="evidenceRef" Errors="errors" />
                        </div>
                        <div class="span-6">
                            <label class="form-label" for="c-reason">@Texts.Get("admin.supportAccess.col.reason")</label>
                            <input id="c-reason" class="form-control" maxlength="500" @bind="formReason" />
                            <FieldError Field="reason" Errors="errors" />
                        </div>
                    </div>
                </fieldset>
                <div class="form-actions"><button type="submit" class="btn btn-primary" disabled="@(busy || string.IsNullOrWhiteSpace(formAddress))">@Texts.Get("common.save")</button></div>
            </form>
        }
    }
    else if (tab == "blocks")
    {
        <div class="filters">
            <label class="visually-hidden" for="b-active">@Texts.Get("common.field.status")</label>
            <select id="b-active" class="form-select form-select-sm filter-select" @bind="blockActive" @bind:after="() => LoadBlocksAsync(1)">
                <option value="">@Texts.Get("admin.subProfiles.all")</option>
                <option value="true">@Texts.Get("admin.commPrefs.activeBlocks")</option>
                <option value="false">@Texts.Get("admin.commPrefs.pastBlocks")</option>
            </select>
        </div>

        @if (blocks is null && message is null)
        {
            <LoadingState Kind="LoadingKind.Table" />
        }
        else if (blocks is not null && blocks.Items.Count == 0)
        {
            <EmptyState Compact="true" Title="@Texts.Get("admin.commPrefs.emptyBlocks")" />
        }
        else if (blocks is not null)
        {
            <div class="table-wrap">
                <table class="table table-sm">
                    <caption class="visually-hidden">@Texts.Get("admin.commPrefs.tab.blocks")</caption>
                    <thead><tr><th scope="col">@Texts.Get("admin.commPrefs.channel")</th><th scope="col">@Texts.Get("admin.commPrefs.address")</th><th scope="col">@Texts.Get("marketing.col.reason")</th><th scope="col">@Texts.Get("admin.supportAccess.col.start")</th><th scope="col">@Texts.Get("admin.supportAccess.col.end")</th><th scope="col">@Texts.Get("common.field.status")</th><th scope="col"><span class="visually-hidden">@Texts.Get("admin.automationRun.col.action")</span></th></tr></thead>
                    <tbody>
                    @foreach (var b in blocks.Items)
                    {
                        <tr>
                            <td>@ChannelText(b.Channel)</td>
                            <td>@b.Address</td>
                            <td>@ReasonText(b.Reason)@(string.IsNullOrWhiteSpace(b.Note) ? null : " · " + b.Note)</td>
                            <td>@CrmLabels.Time(b.StartsAt)</td>
                            <td>@(b.EndsAt is { } end ? CrmLabels.Time(end) : Texts.Get("admin.commPrefs.noEnd"))</td>
                            <td>@(b.LiftedAt is not null ? Texts.Get("admin.commPrefs.lifted") + (string.IsNullOrWhiteSpace(b.LiftReason) ? null : " · " + b.LiftReason) : b.IsActive ? Texts.Get("admin.customFields.active") : Texts.Get("admin.supportAccess.state.expired"))</td>
                            <td>
                                @if (b.IsActive && Session.Can(CoreAccess.SuppressCommunication))
                                {
                                    <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@busy" @onclick="() => AskLift(b)">@Texts.Get("admin.commPrefs.lift")</button>
                                }
                            </td>
                        </tr>
                        @if (liftId == b.Id)
                        {
                            <tr>
                                <td colspan="7">
                                    <div class="filters">
                                        <label class="visually-hidden" for="lift-reason">@Texts.Get("admin.supportAccess.col.reason")</label>
                                        <input id="lift-reason" class="form-control" maxlength="500" placeholder="@Texts.Get("admin.commPrefs.liftReason")" @bind="liftReason" />
                                        <button type="button" class="btn btn-sm btn-primary" disabled="@(busy || string.IsNullOrWhiteSpace(liftReason))" @onclick="LiftAsync">@Texts.Get("admin.commPrefs.confirm")</button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => liftId = null">@Texts.Get("common.dismiss")</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    </tbody>
                </table>
            </div>
            <Pager Page="blocks.Page" PageSize="blocks.PageSize" TotalCount="blocks.TotalCount" PageChanged="LoadBlocksAsync" />
        }

        @if (Session.Can(CoreAccess.SuppressCommunication))
        {
            <form class="record-form" novalidate @onsubmit="AddBlockAsync" @onsubmit:preventDefault>
                <fieldset disabled="@busy">
                    <legend class="h6">@Texts.Get("admin.commPrefs.blockTitle")</legend>
                    <p class="text-muted small">@Texts.Get("admin.commPrefs.blockHint")</p>
                    <div class="form-grid">
                        <div class="span-3">
                            <label class="form-label" for="s-ch">@Texts.Get("admin.commPrefs.channel")</label>
                            <select id="s-ch" class="form-select" @bind="blockChannel">
                                @foreach (var c in Channels) { <option value="@c.Key">@c.Label</option> }
                            </select>
                            <FieldError Field="channel" Errors="errors" />
                        </div>
                        <div class="span-5">
                            <label class="form-label" for="s-addr">@Texts.Get("admin.commPrefs.address")</label>
                            <input id="s-addr" class="form-control" maxlength="254" @bind="blockAddress" />
                            <FieldError Field="address" Errors="errors" />
                        </div>
                        <div class="span-4">
                            <label class="form-label" for="s-reason">@Texts.Get("marketing.col.reason")</label>
                            <select id="s-reason" class="form-select" @bind="blockReason">
                                @foreach (var r in SettingsLabels.SuppressionReasons) { <option value="@r.Key">@r.Label</option> }
                            </select>
                            <FieldError Field="reason" Errors="errors" />
                        </div>
                        <div class="span-12">
                            <label class="form-label" for="s-note">@Texts.Get("admin.commPrefs.note")</label>
                            <input id="s-note" class="form-control" maxlength="500" @bind="blockNote" />
                            <FieldError Field="note" Errors="errors" />
                        </div>
                    </div>
                </fieldset>
                <div class="form-actions"><button type="submit" class="btn btn-primary" disabled="@(busy || string.IsNullOrWhiteSpace(blockAddress))">@Texts.Get("admin.commPrefs.block")</button></div>
            </form>
        }
    }
    else
    {
        <p class="text-muted">
            @Texts.Get("admin.commPrefs.topicsIntro")
        </p>

        @if (topics is null && message is null)
        {
            <LoadingState Kind="LoadingKind.Table" />
        }
        else if (topics is not null && topics.Count == 0)
        {
            <p class="text-muted" role="status">@Texts.Get("admin.commPrefs.noTopics")</p>
        }
        else if (topics is not null)
        {
            <div class="table-wrap">
                <table class="table table-sm">
                    <caption class="visually-hidden">@Texts.Get("admin.commPrefs.tab.topics")</caption>
                    <thead><tr><th scope="col">@Texts.Get("admin.commPrefs.key")</th><th scope="col">@Texts.Get("common.field.name")</th><th scope="col">@Texts.Get("common.field.status")</th><th scope="col"><span class="visually-hidden">@Texts.Get("admin.automationRun.col.action")</span></th></tr></thead>
                    <tbody>
                    @foreach (var t in topics)
                    {
                        <tr>
                            <td><code>@t.Key</code></td>
                            <td>@t.Name</td>
                            <td><span class="badge @(t.IsActive ? "text-bg-success" : "text-bg-secondary")">@(t.IsActive ? Texts.Get("two-factor.on") : Texts.Get("two-factor.off"))</span></td>
                            <td>
                                @if (Session.Can(CoreAccess.ManageCommunication))
                                {
                                    <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@busy" @onclick="() => ToggleTopicAsync(t)">@(t.IsActive ? Texts.Get("common.close") : Texts.Get("common.open"))</button>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }

        @if (Session.Can(CoreAccess.ManageCommunication))
        {
            <form class="record-form" novalidate @onsubmit="SaveTopicAsync" @onsubmit:preventDefault>
                <fieldset disabled="@busy">
                    <legend class="h6">@Texts.Get("admin.commPrefs.addTopic")</legend>
                    <p class="text-muted small">@Texts.Get("admin.commPrefs.topicHint")</p>
                    <div class="form-grid">
                        <div class="span-4">
                            <label class="form-label" for="t-key">@Texts.Get("admin.commPrefs.key")</label>
                            <input id="t-key" class="form-control" maxlength="40" @bind="topicKey" />
                            <FieldError Field="key" Errors="errors" />
                        </div>
                        <div class="span-8">
                            <label class="form-label" for="t-name">@Texts.Get("common.field.name")</label>
                            <input id="t-name" class="form-control" maxlength="100" @bind="topicName" />
                            <FieldError Field="name" Errors="errors" />
                        </div>
                    </div>
                </fieldset>
                <div class="form-actions"><button type="submit" class="btn btn-primary" disabled="@(busy || string.IsNullOrWhiteSpace(topicKey) || string.IsNullOrWhiteSpace(topicName))">@Texts.Get("common.save")</button></div>
            </form>
        }

        <h2 class="h6 mt-4">@Texts.Get("admin.commPrefs.optOuts")</h2>
        <div class="filters">
            <label class="visually-hidden" for="tp-topic">@Texts.Get("admin.commPrefs.topic")</label>
            <select id="tp-topic" class="form-select form-select-sm filter-select" @bind="topicFilter" @bind:after="() => LoadTopicPrefsAsync(1)">
                <option value="">@Texts.Get("admin.commPrefs.allTopics")</option>
                @foreach (var t in topics ?? []) { <option value="@t.Key">@t.Name</option> }
            </select>
        </div>
        @if (topicPrefs is null && message is null)
        {
            <LoadingState Kind="LoadingKind.Table" />
        }
        else if (topicPrefs is not null && topicPrefs.Items.Count == 0)
        {
            <EmptyState Compact="true" Title="@Texts.Get("admin.commPrefs.noOptOuts")" />
        }
        else if (topicPrefs is not null)
        {
            <div class="table-wrap">
                <table class="table table-sm">
                    <caption class="visually-hidden">@Texts.Get("admin.commPrefs.topicPrefs")</caption>
                    <thead><tr><th scope="col">@Texts.Get("admin.commPrefs.channel")</th><th scope="col">@Texts.Get("admin.commPrefs.address")</th><th scope="col">@Texts.Get("admin.commPrefs.topic")</th><th scope="col">@Texts.Get("common.field.status")</th><th scope="col">@Texts.Get("admin.automation.source")</th><th scope="col">@Texts.Get("admin.commPrefs.changed")</th></tr></thead>
                    <tbody>
                    @foreach (var p in topicPrefs.Items)
                    {
                        <tr>
                            <td>@ChannelText(p.Channel)</td>
                            <td>@p.Address</td>
                            <td>@TopicName(p.TopicKey)</td>
                            <td><span class="badge @(p.OptedOut ? "text-bg-danger" : "text-bg-success")">@(p.OptedOut ? Texts.Get("admin.commPrefs.optedOut") : Texts.Get("admin.commPrefs.inTopic"))</span></td>
                            <td>@p.Source</td>
                            <td>@CrmLabels.Time(p.ChangedAt)</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <Pager Page="topicPrefs.Page" PageSize="topicPrefs.PageSize" TotalCount="topicPrefs.TotalCount" PageChanged="LoadTopicPrefsAsync" />
        }

        @if (Session.Can(CoreAccess.ManageCommunication) && topics is { Count: > 0 })
        {
            <form class="record-form" novalidate @onsubmit="SaveTopicPrefAsync" @onsubmit:preventDefault>
                <fieldset disabled="@busy">
                    <legend class="h6">@Texts.Get("admin.commPrefs.optOutTitle")</legend>
                    <p class="text-muted small">@Texts.Get("admin.commPrefs.optOutHint")</p>
                    <div class="form-grid">
                        <div class="span-3">
                            <label class="form-label" for="tp-ch">@Texts.Get("admin.commPrefs.channel")</label>
                            <select id="tp-ch" class="form-select" @bind="tpChannel">
                                @foreach (var c in Channels) { <option value="@c.Key">@c.Label</option> }
                            </select>
                            <FieldError Field="channel" Errors="errors" />
                        </div>
                        <div class="span-4">
                            <label class="form-label" for="tp-addr">@Texts.Get("admin.commPrefs.address")</label>
                            <input id="tp-addr" class="form-control" maxlength="254" @bind="tpAddress" />
                            <FieldError Field="address" Errors="errors" />
                        </div>
                        <div class="span-3">
                            <label class="form-label" for="tp-key">@Texts.Get("admin.commPrefs.topic")</label>
                            <select id="tp-key" class="form-select" @bind="tpTopic">
                                <option value="">@Texts.Get("support.choose")</option>
                                @foreach (var t in topics) { <option value="@t.Key">@t.Name</option> }
                            </select>
                            <FieldError Field="topicKey" Errors="errors" />
                        </div>
                        <div class="span-2">
                            <label class="form-label" for="tp-out">@Texts.Get("common.field.status")</label>
                            <select id="tp-out" class="form-select" @bind="tpOptedOut">
                                <option value="true">@Texts.Get("admin.commPrefs.optedOut")</option>
                                <option value="false">@Texts.Get("admin.commPrefs.optedIn")</option>
                            </select>
                        </div>
                    </div>
                </fieldset>
                <div class="form-actions"><button type="submit" class="btn btn-primary" disabled="@(busy || string.IsNullOrWhiteSpace(tpAddress) || tpTopic.Length == 0)">@Texts.Get("common.save")</button></div>
            </form>
        }
    }
</AuthGate>

@code {
    private static IReadOnlyList<(string Key, string Label)> Channels => MarketingLabels.Channels;

    private string tab = "prefs";
    private PreferencePageDto? prefs;
    private SuppressionPageDto? blocks;
    private List<ConsentEventDto>? events;
    private Guid? openEvents;
    private Guid? liftId;
    private string liftReason = string.Empty;
    private string channel = string.Empty;
    private string status = string.Empty;
    private string address = string.Empty;
    private string blockActive = "true";
    private string formChannel = "Email";
    private string formAddress = string.Empty;
    private string formStatus = "Granted";
    private string formEvidence = string.Empty;
    private string formReason = string.Empty;
    private string blockChannel = "Email";
    private string blockAddress = string.Empty;
    private string blockReason = "Manual";
    private string blockNote = string.Empty;
    private List<TopicDto>? topics;
    private TopicPreferencePageDto? topicPrefs;
    private string topicKey = string.Empty;
    private string topicName = string.Empty;
    private string topicFilter = string.Empty;
    private string tpChannel = "Email";
    private string tpAddress = string.Empty;
    private string tpTopic = string.Empty;
    private string tpOptedOut = "true";
    private string? message;
    private bool failed;
    private bool busy;
    private IReadOnlyDictionary<string, string[]>? errors;

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        await LoadPrefsAsync(1);
    }

    private async Task SwitchAsync(string next)
    {
        tab = next;
        message = null;
        errors = null;
        if (next == "prefs") { await LoadPrefsAsync(1); }
        else if (next == "blocks") { await LoadBlocksAsync(1); }
        else { await LoadTopicsAsync(); await LoadTopicPrefsAsync(1); }
    }

    private async Task LoadTopicsAsync()
    {
        var result = await Api.GetAsync<List<TopicDto>>("/api/communication/topics");
        if (result.IsSuccess) { topics = result.Value ?? []; } else { Report(result.Error, true); }
    }

    private async Task LoadTopicPrefsAsync(int page)
    {
        var result = await Api.GetAsync<TopicPreferencePageDto>(
            $"/api/communication/topic-preferences?page={page}&pageSize=25" + (topicFilter.Length > 0 ? $"&topic={Uri.EscapeDataString(topicFilter)}" : null));
        if (result.IsSuccess) { topicPrefs = result.Value; } else { Report(result.Error, true); }
    }

    private async Task SaveTopicAsync()
    {
        busy = true;
        errors = null;
        var result = await Api.PutAsync<TopicDto>("/api/communication/topics", new SaveTopicRequest(topicKey.Trim(), topicName.Trim(), true));
        busy = false;
        if (result.IsSuccess)
        {
            topicKey = string.Empty; topicName = string.Empty;
            await LoadTopicsAsync();
            Report(Texts.Get("admin.commPrefs.topicSaved"), false);
        }
        else
        {
            errors = result.FieldErrors.Count == 0 ? null : result.FieldErrors;
            Report(result.Error, true);
        }
    }

    private async Task ToggleTopicAsync(TopicDto topic)
    {
        busy = true;
        var result = await Api.PutAsync<TopicDto>("/api/communication/topics", new SaveTopicRequest(topic.Key, topic.Name, !topic.IsActive));
        busy = false;
        if (result.IsSuccess)
        {
            await LoadTopicsAsync();
            Report(topic.IsActive ? Texts.Get("admin.commPrefs.topicClosed") : Texts.Get("admin.commPrefs.topicOpened"), false);
        }
        else
        {
            Report(result.Error, true);
        }
    }

    private async Task SaveTopicPrefAsync()
    {
        busy = true;
        errors = null;
        var result = await Api.PutAsync<TopicPreferenceDto>("/api/communication/topic-preferences",
            new SaveTopicPreferenceRequest(tpChannel, tpAddress.Trim(), tpTopic, tpOptedOut == "true", null));
        busy = false;
        if (result.IsSuccess)
        {
            tpAddress = string.Empty;
            await LoadTopicPrefsAsync(1);
            Report(Texts.Get("admin.commPrefs.topicPrefSaved"), false);
        }
        else
        {
            errors = result.FieldErrors.Count == 0 ? null : result.FieldErrors;
            Report(result.Error, true);
        }
    }

    private string TopicName(string key) => topics?.FirstOrDefault(t => t.Key == key)?.Name ?? key;

    private async Task LoadPrefsAsync(int page)
    {
        var query = $"?page={page}&pageSize=25"
            + (channel.Length > 0 ? $"&channel={channel}" : null)
            + (status.Length > 0 ? $"&status={status}" : null)
            + (string.IsNullOrWhiteSpace(address) ? null : $"&address={Uri.EscapeDataString(address.Trim())}");
        var result = await Api.GetAsync<PreferencePageDto>("/api/communication/preferences" + query);
        if (result.IsSuccess) { prefs = result.Value; } else { Report(result.Error, true); }
    }

    private async Task LoadBlocksAsync(int page)
    {
        var result = await Api.GetAsync<SuppressionPageDto>($"/api/communication/suppressions?page={page}&pageSize=25" + (blockActive.Length > 0 ? $"&active={blockActive}" : null));
        if (result.IsSuccess) { blocks = result.Value; } else { Report(result.Error, true); }
    }

    private async Task ToggleEventsAsync(PreferenceDto preference)
    {
        if (openEvents == preference.Id) { openEvents = null; return; }
        openEvents = preference.Id;
        events = null;
        var result = await Api.GetAsync<List<ConsentEventDto>>($"/api/communication/preferences/{preference.Id}/events");
        events = result.Value ?? [];
        if (!result.IsSuccess) { Report(result.Error, true); }
    }

    private async Task SaveConsentAsync()
    {
        busy = true;
        errors = null;
        var result = await Api.PutAsync<PreferenceDto>("/api/communication/preferences",
            new SaveConsentRequest(formChannel, formAddress.Trim(), "Marketing", formStatus, null,
                string.IsNullOrWhiteSpace(formEvidence) ? null : formEvidence.Trim(), string.IsNullOrWhiteSpace(formReason) ? null : formReason.Trim(), null, null));
        busy = false;
        if (result.IsSuccess)
        {
            formAddress = string.Empty; formEvidence = string.Empty; formReason = string.Empty;
            Report(Texts.Get("admin.commPrefs.prefSaved"), false);
            await LoadPrefsAsync(1);
        }
        else
        {
            errors = result.FieldErrors.Count == 0 ? null : result.FieldErrors;
            Report(result.Error, true);
        }
    }

    private async Task AddBlockAsync()
    {
        busy = true;
        errors = null;
        var result = await Api.PostAsync<SuppressionDto>("/api/communication/suppressions",
            new SaveSuppressionRequest(blockChannel, blockAddress.Trim(), blockReason, string.IsNullOrWhiteSpace(blockNote) ? null : blockNote.Trim(), null));
        busy = false;
        if (result.IsSuccess)
        {
            blockAddress = string.Empty; blockNote = string.Empty;
            Report(Texts.Get("admin.commPrefs.blocked"), false);
            await LoadBlocksAsync(1);
        }
        else
        {
            errors = result.FieldErrors.Count == 0 ? null : result.FieldErrors;
            Report(result.Error, true);
        }
    }

    private void AskLift(SuppressionDto block)
    {
        liftId = block.Id;
        liftReason = string.Empty;
    }

    private async Task LiftAsync()
    {
        if (liftId is not { } id || string.IsNullOrWhiteSpace(liftReason)) { return; }
        busy = true;
        var result = await Api.PostAsync<SuppressionDto>($"/api/communication/suppressions/{id}/lift", new LiftSuppressionRequest(liftReason.Trim()));
        busy = false;
        liftId = null;
        Report(result.IsSuccess ? Texts.Get("admin.commPrefs.liftedNotice") : result.Error, !result.IsSuccess);
        await LoadBlocksAsync(1);
    }

    private void Report(string? text, bool isFailure)
    {
        message = text;
        failed = isFailure;
    }

    private static string ChannelText(string key) => MarketingLabels.Lookup(MarketingLabels.ChannelGroup, MarketingLabels.ChannelSource, key);

    private static string PurposeText(string key) => SettingsLabels.ConsentPurpose(key);

    private static string ReasonText(string key) => SettingsLabels.SuppressionReason(key);

    private static string StatusText(string key) => SettingsLabels.ConsentStatus(key);

    private static string StatusClass(string key) => key switch { "Granted" => "text-bg-success", "Denied" => "text-bg-danger", _ => "text-bg-secondary" };
}
