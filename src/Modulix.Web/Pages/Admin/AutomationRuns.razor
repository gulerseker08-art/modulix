@page "/yonetim/otomasyon/calismalar"
@inject ApiClient Api
@inject SessionState Session

<PageTitle>@Texts.Get("admin.automationRuns.title") · Modulix</PageTitle>

@* Otomasyon çalışma geçmişi (ADR-0027, Dilim 5b): liste. Okuma core.automation-logs.read ister. Çalışma kaydı kayıt değeri ya da
   parametre taşımaz; yalnızca durum, özet ve kimlikler görünür. Düğmeleri gizlemek yetki değildir, sunucu uygular. *@
<AuthGate Permission="@CoreAccess.ReadAutomationLogs">
    <a class="back-link" href="yonetim/otomasyon">← @Texts.Get("admin.automationRules.title")</a>

    <PageHeader Title="@Texts.Get("admin.automationRuns.title")" Icon="zap"
                Subtitle="@Texts.Get("admin.automationRuns.subtitle")" />

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message <button type="button" class="btn btn-sm btn-outline-secondary ms-2" @onclick="() => LoadAsync(1)">@Texts.Get("admin.automation.retry")</button></div>
    }

    <div class="list-toolbar">
        <ViewSelector Label="@Texts.Get("common.field.status")" Items="StatusOptions" Value="@(status ?? AutomationLabels.AllViews)" ValueChanged="ChooseStatusAsync" />
        @if (RuleId is not null)
        {
            <span class="chip active">@Texts.Get("admin.automationRuns.singleRule") <a href="yonetim/otomasyon/calismalar" aria-label="@Texts.Get("admin.automationRuns.clearRule")">×</a></span>
        }
    </div>

    @if (runPage is null)
    {
        @if (message is null)
        {
            <LoadingState />
        }
    }
    else if (runPage.Items.Count == 0)
    {
        <p class="text-muted" role="status">
            @(status is not null || RuleId is not null ? Texts.Get("admin.automationRuns.emptyFiltered") : Texts.Get("admin.automationRuns.empty"))
        </p>
    }
    else
    {
        <p class="visually-hidden" role="status" aria-live="polite">@Texts.Get("admin.automationRuns.listed", runPage.TotalCount)</p>
        <table class="table record-table">
            <caption class="visually-hidden">@Texts.Get("admin.automationRuns.title")</caption>
            <thead>
                <tr><th scope="col">@Texts.Get("admin.automation.rule")</th><th scope="col">@Texts.Get("admin.automation.entity")</th><th scope="col">@Texts.Get("admin.automation.source")</th><th scope="col">@Texts.Get("common.field.status")</th><th scope="col">@Texts.Get("admin.automation.started")</th><th scope="col">@Texts.Get("admin.automation.finished")</th></tr>
            </thead>
            <tbody>
                @foreach (var run in runPage.Items)
                {
                    <tr>
                        <td data-label="@Texts.Get("admin.automation.rule")" class="primary">
                            <a href="yonetim/otomasyon/calismalar/@run.Id">@run.RuleName</a>
                            <small class="text-muted d-block">v@(run.VersionNo)@(string.IsNullOrWhiteSpace(run.Note) ? "" : " · " + run.Note)</small>
                        </td>
                        <td data-label="@Texts.Get("admin.automation.entity")">@AutomationLabels.EntityName(entities, run.EntityKey)</td>
                        <td data-label="@Texts.Get("admin.automation.source")">@AutomationLabels.Origin(run.Origin)</td>
                        <td data-label="@Texts.Get("common.field.status")"><span class="badge stage-@AutomationLabels.RunStatusBadge(run.Status)">@AutomationLabels.RunStatus(run.Status)</span></td>
                        <td data-label="@Texts.Get("admin.automation.started")">@CrmLabels.Time(run.CreatedAt)</td>
                        <td data-label="@Texts.Get("admin.automation.finished")">@(run.CompletedAt is { } done ? CrmLabels.Time(done) : "—")</td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager PageSizeChoice="true" Page="runPage.Page" PageSize="runPage.PageSize" TotalCount="runPage.TotalCount" PageChanged="LoadAsync" />
    }
</AuthGate>

@code {
    /// <summary>Kural ayrıntısındaki "Çalışmaları" bağlantısı tek kurala süzer.</summary>
    [SupplyParameterFromQuery(Name = "kural")] public Guid? RuleId { get; set; }

    private AutomationRunPageDto? runPage;
    private IReadOnlyList<AutomationEntityDto> entities = [];
    private string? status;
    private string? message;

    protected override async Task OnParametersSetAsync()
    {
        await Session.EnsureLoadedAsync();
        if (Session.Can(CoreAccess.ReadAutomationLogs))
        {
            // Katalog kayıt türü adları içindir (core.automation.read ister); alınamazsa liste teknik anahtarla yine çalışır.
            if (entities.Count == 0 && Session.Can(CoreAccess.ReadAutomation))
            {
                entities = (await Api.GetAsync<AutomationCatalogDto>("/api/automation/catalog")).Value?.Entities ?? [];
            }

            await LoadAsync(1);
        }
    }

    private static IReadOnlyList<ViewOption> StatusOptions =>
        [new(AutomationLabels.AllViews, Texts.Get("admin.automationRuns.view.all")), .. AutomationLabels.RunStatuses.Select(s => new ViewOption(s, AutomationLabels.RunStatus(s)))];

    private Task ChooseStatusAsync(string key)
    {
        status = key == AutomationLabels.AllViews ? null : key;
        return LoadAsync(1);
    }

    private async Task LoadAsync(int pageNumber)
    {
        var url = $"/api/automation/runs?page={pageNumber}&pageSize={ListPaging.Size}";
        if (status is not null)
        {
            url += $"&status={status}";
        }

        if (RuleId is { } ruleId)
        {
            url += $"&ruleId={ruleId}";
        }

        var result = await Api.GetAsync<AutomationRunPageDto>(url);
        runPage = result.Value;
        message = result.Error;
    }
}
