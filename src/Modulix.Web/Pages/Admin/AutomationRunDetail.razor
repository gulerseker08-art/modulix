@page "/yonetim/otomasyon/calismalar/{RunId:guid}"
@inject ApiClient Api
@inject SessionState Session

<PageTitle>@(detail?.Run.RuleName ?? Texts.Get("admin.automationRun.title")) · Modulix</PageTitle>

@* Otomasyon çalışması ayrıntısı (ADR-0027, Dilim 5b): adımlar, deneme sayısı, sonuç özeti; başarısızı yeniden dene, bitmemişi iptal et.
   Okuma core.automation-logs.read, yeniden deneme ve iptal core.automation.run ister. Düğmeleri gizlemek yetki değildir, sunucu uygular. *@
<AuthGate Permission="@CoreAccess.ReadAutomationLogs">
    <a class="back-link" href="yonetim/otomasyon/calismalar">← @Texts.Get("admin.automationRuns.title")</a>

    @if (detail is null)
    {
        @if (message is not null)
        {
            <div class="alert alert-danger" role="alert">@message</div>
        }
        else
        {
            <LoadingState />
        }
    }
    else
    {
        var run = detail.Run;
        <PageHeader Title="@run.RuleName" Icon="zap" Subtitle="@($"v{run.VersionNo} · {AutomationLabels.Origin(run.Origin)} · {CrmLabels.Time(run.CreatedAt)}")">
            <span class="badge stage-@AutomationLabels.RunStatusBadge(run.Status)">@AutomationLabels.RunStatus(run.Status)</span>
            @if (CanRun && AutomationLabels.CanCancel(run.Status))
            {
                <button type="button" class="btn btn-outline-danger" disabled="@busy" @onclick="() => confirmingCancel = true">@Texts.Get("admin.automationRun.cancel")</button>
            }
            @if (CanRun && AutomationLabels.CanRetry(run.Status))
            {
                <button type="button" class="btn btn-primary" disabled="@busy" @onclick="RetryAsync">@Texts.Get("admin.automationRun.retry")</button>
            }
        </PageHeader>

        <Notice Text="@notice" />
        @if (message is not null)
        {
            <div class="alert alert-danger" role="alert">@message</div>
        }

        @if (confirmingCancel)
        {
            <div class="alert alert-warning confirm" role="alertdialog" aria-label="@Texts.Get("admin.automationRun.cancelConfirmLabel")">
                <p>@Texts.Get("admin.automationRun.cancelConfirm")</p>
                <button type="button" class="btn btn-danger" disabled="@busy" @onclick="CancelAsync">@Texts.Get("admin.automationRun.cancel")</button>
                <button type="button" class="btn btn-outline-secondary" @onclick="() => confirmingCancel = false">@Texts.Get("common.dismiss")</button>
            </div>
        }

        <FormSection Title="@Texts.Get("admin.automationRun.section")" Icon="clipboard-list">
            <dl class="detail-list">
                <dt>@Texts.Get("admin.automation.rule")</dt>
                <dd>
                    @if (Session.Can(CoreAccess.ReadAutomation))
                    {
                        <a href="yonetim/otomasyon/@run.RuleId">@run.RuleName</a>
                    }
                    else
                    {
                        @run.RuleName
                    }
                    (v@(run.VersionNo))
                </dd>
                <dt>@Texts.Get("admin.automation.entity")</dt>
                <dd>@AutomationLabels.EntityName(entities, run.EntityKey)</dd>
                <dt>@Texts.Get("admin.automation.source")</dt>
                <dd>@AutomationLabels.Origin(run.Origin)</dd>
                <dt>@Texts.Get("admin.automation.started")</dt>
                <dd>@CrmLabels.Time(run.CreatedAt)</dd>
                <dt>@Texts.Get("admin.automation.finished")</dt>
                <dd>@(run.CompletedAt is { } done ? CrmLabels.Time(done) : "—")</dd>
                @if (run.Status == AutomationLabels.RunRunning)
                {
                    <dt>@(detail.Steps.Any(s => s.WaitingUntil is not null) ? Texts.Get("admin.automationRun.resumesAt") : Texts.Get("admin.automationRun.nextAttempt"))</dt>
                    <dd>@CrmLabels.Time(detail.NextAttemptAt)</dd>
                }
                @if (!string.IsNullOrWhiteSpace(run.Note))
                {
                    <dt>@Texts.Get("admin.automationRun.note")</dt>
                    <dd>@run.Note</dd>
                }
            </dl>
        </FormSection>

        <FormSection Title="@Texts.Get("admin.automationRun.steps")" Icon="check"
                     Description="@Texts.Get("admin.automationRun.stepsHelp")">
            @if (detail.Steps.Count == 0)
            {
                <p class="text-muted" role="status">
                    @(run.Status == AutomationLabels.RunNotMatched ? Texts.Get("admin.automationRun.notMatched") : Texts.Get("admin.automationRun.noSteps"))
                </p>
            }
            else
            {
                <table class="table record-table">
                    <caption class="visually-hidden">@Texts.Get("admin.automationRun.stepsCaption")</caption>
                    <thead>
                        <tr><th scope="col">@Texts.Get("admin.automationRun.col.order")</th><th scope="col">@Texts.Get("admin.automationRun.col.step")</th><th scope="col">@Texts.Get("admin.automationRun.col.action")</th><th scope="col">@Texts.Get("common.field.status")</th><th scope="col">@Texts.Get("admin.automationRun.col.attempts")</th><th scope="col">@Texts.Get("admin.automationRun.col.result")</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var step in detail.Steps)
                        {
                            <tr>
                                <td data-label="@Texts.Get("admin.automationRun.col.order")">@step.StepNo</td>
                                <td data-label="@Texts.Get("admin.automationRun.col.step")" class="primary">@step.StepId</td>
                                <td data-label="@Texts.Get("admin.automationRun.col.action")">@ActionName(step.Action)</td>
                                <td data-label="@Texts.Get("common.field.status")"><span class="badge stage-@AutomationLabels.StepStatusBadge(step.Status)">@(step.Status == "Pending" && step.WaitingUntil is null && detail.Steps.Any(s => s.WaitingUntil is not null) ? Texts.Get("admin.automationRun.queued") : AutomationLabels.StepStatus(step.Status))</span>
                                    @if (step.WaitingUntil is { } until) { <small class="text-muted"> · @Texts.Get("admin.automationRun.waitingUntil", CrmLabels.Time(until))</small> }</td>
                                <td data-label="@Texts.Get("admin.automationRun.col.attempts")">@step.Attempts</td>
                                <td data-label="@Texts.Get("admin.automationRun.col.result")">@(string.IsNullOrWhiteSpace(step.Summary) ? "—" : step.Summary)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </FormSection>
    }
</AuthGate>

@code {
    [Parameter] public Guid RunId { get; set; }

    private AutomationRunDetailDto? detail;
    private IReadOnlyList<AutomationEntityDto> entities = [];
    private IReadOnlyList<AutomationActionDto> actions = [];
    private string? message;
    private string? notice;
    private bool busy;
    private bool confirmingCancel;

    private bool CanRun => Session.Can(CoreAccess.RunAutomation);

    protected override async Task OnParametersSetAsync()
    {
        await Session.EnsureLoadedAsync();
        if (!Session.Can(CoreAccess.ReadAutomationLogs))
        {
            return;
        }

        // Katalog ad çevirisi içindir (core.automation.read ister); alınamazsa teknik anahtar görünür.
        if (Session.Can(CoreAccess.ReadAutomation))
        {
            var catalog = (await Api.GetAsync<AutomationCatalogDto>("/api/automation/catalog")).Value;
            entities = catalog?.Entities ?? [];
            actions = catalog?.Actions ?? [];
        }

        var result = await Api.GetAsync<AutomationRunDetailDto>($"/api/automation/runs/{RunId}");
        detail = result.Value;
        message = result.Error;
    }

    private string ActionName(string key) => actions.FirstOrDefault(a => a.Key == key)?.DisplayName ?? key;

    private Task RetryAsync() => ChangeAsync($"/api/automation/runs/{RunId}/retry", Texts.Get("admin.automationRun.retried"));

    private async Task CancelAsync()
    {
        await ChangeAsync($"/api/automation/runs/{RunId}/cancel", Texts.Get("admin.automationRun.cancelled"));
    }

    private async Task ChangeAsync(string url, string done)
    {
        busy = true;
        message = null;
        notice = null;
        var result = await Api.PostAsync<AutomationRunDetailDto>(url, new { });
        busy = false;
        confirmingCancel = false;
        if (result.Value is { } updated)
        {
            detail = updated;
            notice = done;
            return;
        }

        message = result.Error;
    }
}
