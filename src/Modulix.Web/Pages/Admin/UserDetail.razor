@page "/yonetim/kullanicilar/{MembershipId:guid}"
@inject ApiClient Api
@inject SessionState Session
@inject NavigationManager Navigation

<PageTitle>@(user?.DisplayName ?? Texts.Get("admin.userDetail.user")) · Modulix</PageTitle>

<AuthGate Permission="@CoreAccess.ManageUsers">
    <a class="back-link" href="yonetim/kullanicilar">← @Texts.Get("nav.app.admin.users")</a>

    @if (notice is not null)
    {
        <div class="alert alert-success" role="status">@notice</div>
    }

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }

    @if (user is null)
    {
        @if (message is null)
        {
            <LoadingState />
        }
    }
    else
    {
        <div class="page-header">
            <div>
                <h1>@user.DisplayName</h1>
                <div class="header-meta">
                    <UserStatusBadge User="user" />
                    @if (user.IsAdministrator)
                    {
                        <span class="badge tag">@Texts.Get("admin.userDetail.administrator")</span>
                    }
                    @if (user.IsCurrentUser)
                    {
                        <span class="badge tag">@Texts.Get("admin.userDetail.you")</span>
                    }
                </div>
            </div>
        </div>

        <dl class="detail-grid">
            <div><dt>@Texts.Get("common.field.email")</dt><dd>@user.Email</dd></div>
            <div><dt>@Texts.Get("admin.unit")</dt><dd>@(currentUnit?.PathNames ?? user.BusinessUnitName ?? "—")</dd></div>
            <div><dt>@Texts.Get("admin.users.col.lastSignIn")</dt><dd>@(user.LastSignInAt is { } at ? CrmLabels.Time(at) : "—")</dd></div>
            <div><dt>@Texts.Get("admin.userDetail.created")</dt><dd>@CrmLabels.Time(user.CreatedAt)</dd></div>
            @if (user.InvitedAt is { } invitedAt)
            {
                <div><dt>@Texts.Get("admin.userDetail.lastInvite")</dt><dd>@CrmLabels.Time(invitedAt)</dd></div>
            }
        </dl>

        @if (Locked)
        {
            <div class="alert alert-info">@Texts.Get("admin.userDetail.locked")</div>
        }

        @* Departman (ADR-0026): kullanıcı tam bir departmandadır. Departman değişince kullanıcının sorumlu olduğu kayıtlar da yeni departmanla görünür. *@
        <section class="detail-section">
            <div class="section-header"><h2>@Texts.Get("admin.unit")</h2></div>
            @if (units.Count == 0)
            {
                <p class="text-muted">@Texts.Get("admin.userDetail.unitLoadFailed")</p>
            }
            else
            {
                <div class="form-grid">
                    <div>
                        <label class="form-label" for="user-unit">@Texts.Get("admin.unit")</label>
                        <select id="user-unit" class="form-select" @bind="selectedUnitId" @bind:after="ResetUnitChange" disabled="@Locked">
                            @foreach (var unit in units.Where(u => u.IsActive || u.Id == currentUnit?.Id))
                            {
                                <option value="@unit.Id">@unit.PathNames@(unit.IsActive ? "" : " " + Texts.Get("admin.userDetail.closedUnit"))</option>
                            }
                        </select>
                    </div>
                </div>
                <p class="text-muted small">@Texts.Get("admin.userDetail.unitHelp")</p>
                <div class="form-actions">
                    <button type="button" class="btn btn-primary" disabled="@(busy || Locked || selectedUnitId == currentUnit?.Id || unitPreview is not null)" @onclick="PreviewUnitAsync">@Texts.Get("admin.userDetail.changeUnitStart")</button>
                </div>

                @* Etki ve onay (ADR-0026 K7): kayıtlar kullanıcıyla taşınır ya da eski departmanda kalan birine devredilir; gerekçe denetim kaydına yazılır. *@
                @if (unitPreview is { IsChange: true } preview)
                {
                    <div class="alert alert-warning confirm" role="alertdialog" aria-label="@Texts.Get("admin.userDetail.unitConfirm")">
                        <p><strong>@(preview.CurrentPath ?? "—") → @preview.TargetPath</strong></p>
                        @foreach (var warning in preview.Warnings)
                        {
                            <p class="mb-1">@warning</p>
                        }

                        @if (preview.OwnedRecords.Any(o => o.Count > 0))
                        {
                            <ul>
                                @foreach (var owned in preview.OwnedRecords.Where(o => o.Count > 0))
                                {
                                    <li>@owned.Label: @owned.Count</li>
                                }
                            </ul>
                        }

                        @if (preview.DecisionRequired)
                        {
                            <fieldset class="scope-choice">
                                <legend class="form-label">@Texts.Get("admin.userDetail.recordsChoice")</legend>
                                <div class="form-check">
                                    <input id="rec-move" class="form-check-input" type="radio" name="rec-choice" checked="@(recordChoice == "move")"
                                           @onchange="ChooseMove" />
                                    <label class="form-check-label" for="rec-move">@Texts.Get("admin.userDetail.recordsMove")</label>
                                </div>
                                <div class="form-check">
                                    <input id="rec-transfer" class="form-check-input" type="radio" name="rec-choice" checked="@(recordChoice == "transfer")"
                                           @onchange="ChooseTransfer" />
                                    <label class="form-check-label" for="rec-transfer">@Texts.Get("admin.userDetail.recordsTransfer")</label>
                                </div>
                                @if (recordChoice == "transfer")
                                {
                                    @if (oldUnitMembers.Count == 0)
                                    {
                                        <EmptyState Compact="true" Title="@Texts.Get("admin.userDetail.noReceiver")" />
                                    }
                                    else
                                    {
                                        <select class="form-select" aria-label="@Texts.Get("admin.userDetail.receiver")" @bind="transferTo">
                                            <option value="">@Texts.Get("admin.userDetail.chooseUser")</option>
                                            @foreach (var member in oldUnitMembers)
                                            {
                                                <option value="@member.MembershipId">@member.DisplayName</option>
                                            }
                                        </select>
                                    }
                                }
                            </fieldset>
                        }

                        @if (preview.ReasonRequired)
                        {
                            <label class="form-label" for="unit-reason">@Texts.Get("crm.act.reasonRequired")</label>
                            <textarea id="unit-reason" class="form-control" rows="2" maxlength="500" @bind="unitReason" @bind:event="oninput"></textarea>
                        }

                        <div class="form-actions">
                            <button type="button" class="btn btn-warning" disabled="@(busy || !CanConfirmUnitChange)" @onclick="ApplyUnitAsync">@Texts.Get("admin.userDetail.changeUnit")</button>
                            <button type="button" class="btn btn-outline-secondary" disabled="@busy" @onclick="ResetUnitChange">@Texts.Get("common.dismiss")</button>
                        </div>
                    </div>
                }
            }
        </section>

        <section class="detail-section">
            <div class="section-header"><h2>@Texts.Get("nav.app.admin.roles")</h2></div>
            <RolePicker Roles="roles" Selected="selectedRoles" CanGrantAdministrator="Session.IsAdministrator" />
            <div class="form-actions">
                <button type="button" class="btn btn-primary" disabled="@(busy || Locked)" @onclick="SaveRolesAsync">@Texts.Get("admin.userDetail.saveRoles")</button>
            </div>
        </section>

        <section class="detail-section">
            <div class="section-header"><h2>@Texts.Get("nav.app.admin.teams")</h2></div>
            @if (teams.Count == 0)
            {
                <p class="text-muted">@((MarkupString)Texts.Get("admin.userDetail.noTeams", "<a href=\"yonetim/ekipler\">", "</a>"))</p>
            }
            else
            {
                <p class="text-muted small">@Texts.Get("admin.userDetail.teamsHelp")</p>
                <div class="role-picker">
                    @foreach (var team in teams)
                    {
                        <label class="form-check">
                            <input class="form-check-input" type="checkbox" checked="@selectedTeams.Contains(team.Id)"
                                   @onchange="e => ToggleTeam(team.Id, e.Value is true)" />
                            <span class="form-check-label">@team.Name <small class="text-muted">· @Texts.Get("admin.userDetail.memberCount", team.MemberCount)</small></span>
                        </label>
                    }
                </div>
                <div class="form-actions">
                    <button type="button" class="btn btn-primary" disabled="@busy" @onclick="SaveTeamsAsync">@Texts.Get("admin.userDetail.saveTeams")</button>
                </div>
            }
        </section>

        @* İşletici şirket erişimi (ADR-0008). Yönetici zaten bütün şirketlere erişir; bu, yönetici olmayan kullanıcılar içindir. *@
        @if (Session.Can(CoreAccess.ManageCompanies))
        {
            <section class="detail-section">
                <div class="section-header"><h2>@Texts.Get("nav.app.admin.companies")</h2></div>
                @if (user.IsAdministrator)
                {
                    <p class="text-muted small">@Texts.Get("admin.userDetail.companiesAdministrator")</p>
                }
                else if (companies.Count == 0)
                {
                    <EmptyState Compact="true" Title="@Texts.Get("admin.userDetail.noCompanies")" />
                }
                else
                {
                    <p class="text-muted small">@Texts.Get("admin.userDetail.companiesHelp")</p>
                    <div class="role-picker">
                        @foreach (var company in companies)
                        {
                            var state = assignments[company.Id];
                            <div class="company-assignment">
                                <label class="form-check">
                                    <input class="form-check-input" type="checkbox" checked="@state.Selected"
                                           @onchange="e => ToggleCompany(company.Id, e.Value is true)" />
                                    <span class="form-check-label">@company.Name @if (company.IsDefault) { <small class="text-muted">· @Texts.Get("admin.userDetail.defaultCompany")</small> }</span>
                                </label>
                                @if (state.Selected)
                                {
                                    <div class="company-assignment-detail">
                                        <label class="small text-muted">
                                            @Texts.Get("admin.userDetail.validUntil")
                                            <input type="date" class="form-control form-control-sm" value="@(state.ValidUntil?.ToString("yyyy-MM-dd"))"
                                                   @onchange="e => SetValidUntil(company.Id, e.Value?.ToString())" />
                                        </label>
                                        @if (branchesByCompany.TryGetValue(company.Id, out var branches) && branches.Count > 0)
                                        {
                                            <label class="small text-muted">
                                                @Texts.Get("admin.userDetail.defaultBranch")
                                                <select class="form-select form-select-sm" @onchange="e => SetBranch(company.Id, e.Value?.ToString())">
                                                    <option value="">—</option>
                                                    @foreach (var branch in branches)
                                                    {
                                                        <option value="@branch.Id" selected="@(state.BranchId == branch.Id)">@branch.Name</option>
                                                    }
                                                </select>
                                            </label>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                    <div class="form-actions">
                        <button type="button" class="btn btn-primary" disabled="@busy" @onclick="SaveCompaniesAsync">@Texts.Get("admin.userDetail.saveCompanies")</button>
                    </div>
                }
            </section>
        }

        <UserAccessPanel MembershipId="MembershipId" Disabled="user.Status == UserStatus.Disabled" Version="accessVersion" />

        <section class="detail-section">
            <div class="section-header"><h2>@Texts.Get("admin.userDetail.account")</h2></div>

            @if (confirming is { } pending)
            {
                <div class="alert alert-warning confirm" role="alertdialog">
                    <p>@pending.Question</p>
                    @if (pending.Handover)
                    {
                        <HandoverChoice Owned="owned" Receivers="receivers" Required="pending.Url.EndsWith(TransferPath)" @bind-Selected="receiverId" />
                    }
                    <button type="button" class="btn btn-danger" disabled="@(busy || (pending.Url.EndsWith(TransferPath) && receiverId is null))"
                            @onclick="() => RunAsync(pending)">@pending.Label</button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="() => confirming = null">@Texts.Get("common.dismiss")</button>
                </div>
            }
            else
            {
                <div class="account-actions">
                    @foreach (var action in Actions())
                    {
                        <div>
                            <button type="button" class="btn @(action.Danger ? "btn-outline-danger" : "btn-outline-primary")"
                                    disabled="@(busy || Locked)" @onclick="() => Start(action)">@action.Label</button>
                            <small class="text-muted">@action.Hint</small>
                        </div>
                    }
                </div>
            }
        </section>
    }
</AuthGate>

@code {
    [Parameter] public Guid MembershipId { get; set; }

    private UserDto? user;
    private IReadOnlyList<RoleDto> roles = [];
    private HashSet<Guid> selectedRoles = [];
    private IReadOnlyList<TeamDto> teams = [];
    private HashSet<Guid> selectedTeams = [];
    private IReadOnlyList<BusinessUnitDto> units = [];
    private MembershipBusinessUnitDto? currentUnit;
    private Guid selectedUnitId;
    private IReadOnlyList<OperatingCompanyDto> companies = [];
    private Dictionary<Guid, CompanyAssignmentState> assignments = [];
    private Dictionary<Guid, IReadOnlyList<BranchDto>> branchesByCompany = [];

    /// <summary>Ekrandaki bir şirket görevi: seçili mi, geçici vekâlet bitişi ve varsayılan şube (ADR-0008, adım 5).</summary>
    private sealed class CompanyAssignmentState
    {
        public bool Selected { get; set; }
        public DateTime? ValidUntil { get; set; }
        public Guid? BranchId { get; set; }
    }
    private const string TransferPath = "/transfer-records";

    private AccountAction? confirming;
    private IReadOnlyList<OwnedRecordsDto>? owned;
    private IReadOnlyList<UserDto> receivers = [];
    private Guid? receiverId;
    private string? message;
    private string? notice;
    private bool busy;
    private int accessVersion;

    /// <summary>Yönetici olmayan kullanıcı yöneticinin hesabında işlem yapamaz (sunucu da reddeder).</summary>
    private bool Locked => user is { IsAdministrator: true } && !Session.IsAdministrator;

    /// <summary><see cref="Handover"/>: onayda kişinin kayıtları ve devralacak kişi seçimi gösterilir.</summary>
    private sealed record AccountAction(
        string Label, string Hint, string Url, bool Delete, string Done, string? Question, bool Danger, bool Handover = false);

    private int OwnedTotal => owned?.Sum(o => o.Count ?? 0) ?? 0;

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (Session.Can(CoreAccess.ManageUsers))
        {
            roles = (await Api.GetAsync<List<RoleDto>>("/api/roles")).Value ?? [];
            await LoadAsync();
            await LoadTeamsAsync();
            await LoadUnitAsync();
            if (Session.Can(CoreAccess.ManageCompanies))
            {
                await LoadCompaniesAsync();
            }
        }
    }

    private async Task LoadAsync()
    {
        var result = await Api.GetAsync<UserDto>($"/api/users/{MembershipId}");
        user = result.Value;
        message = result.Error;
        selectedRoles = user?.Roles.Select(r => r.Id).ToHashSet() ?? [];

        // Devre dışı kişinin üzerinde kalan kayıtlar sonradan da devredilebilir.
        owned = user?.Status == UserStatus.Disabled ? await LoadOwnedAsync() : null;
    }

    private async Task<IReadOnlyList<OwnedRecordsDto>?> LoadOwnedAsync() =>
        (await Api.GetAsync<List<OwnedRecordsDto>>($"/api/users/{MembershipId}/owned-records")).Value;

    private IEnumerable<AccountAction> Actions()
    {
        var url = $"/api/users/{MembershipId}";
        switch (user!.Status)
        {
            case UserStatus.Invited:
                yield return new(Texts.Get("admin.userDetail.resend"), Texts.Get("admin.userDetail.resendHint"), $"{url}/invitation/resend", false,
                    Texts.Get("admin.userDetail.resendDone"), null, false);
                yield return new(Texts.Get("admin.userDetail.revoke"), Texts.Get("admin.userDetail.revokeHint"), $"{url}/invitation", true,
                    Texts.Get("admin.userDetail.revokeDone"), Texts.Get("admin.userDetail.revokeQuestion", user.Email), true);
                break;
            case UserStatus.Active:
                yield return new(Texts.Get("admin.userDetail.reset"),
                    Texts.Get("admin.userDetail.resetHint"),
                    $"{url}/password-reset", false, Texts.Get("admin.userDetail.resetDone", user.Email), null, false);
                if (!user.IsCurrentUser)
                {
                    yield return new(Texts.Get("admin.userDetail.closeSessions"),
                        Texts.Get("admin.userDetail.closeSessionsHint"),
                        $"{url}/close-sessions", false, Texts.Get("admin.userDetail.closeSessionsDone"),
                        Texts.Get("admin.userDetail.closeSessionsQuestion", user.DisplayName), true);
                    yield return new(Texts.Get("admin.userDetail.disable"), Texts.Get("admin.userDetail.disableHint"),
                        $"{url}/disable", false, Texts.Get("admin.userDetail.disableDone"),
                        Texts.Get("admin.userDetail.disableQuestion", user.DisplayName), true, Handover: true);
                }

                break;
            case UserStatus.Disabled:
                yield return new(Texts.Get("admin.userDetail.enable"), Texts.Get("admin.userDetail.enableHint"), $"{url}/enable", false,
                    Texts.Get("admin.userDetail.enableDone"), null, false);
                if (OwnedTotal > 0)
                {
                    yield return new(Texts.Get("admin.userDetail.transfer"), Texts.Get("admin.userDetail.transferHint", HandoverChoice.Describe(owned!)), $"{url}{TransferPath}", false,
                        Texts.Get("admin.userDetail.transferDone"), Texts.Get("admin.userDetail.transferQuestion", user.DisplayName), false, Handover: true);
                }

                break;
        }

        if (user.IsLockedOut)
        {
            yield return new(Texts.Get("admin.userDetail.unlock"), Texts.Get("admin.userDetail.unlockHint"), $"{url}/unlock", false,
                Texts.Get("admin.userDetail.unlockDone"), null, false);
        }
    }

    private async Task Start(AccountAction action)
    {
        if (action.Handover)
        {
            receiverId = null;
            owned = await LoadOwnedAsync();
            var active = await Api.GetAsync<UserPageResponse>("/api/users?status=Active&pageSize=100");
            receivers = active.Value?.Items.Where(u => u.MembershipId != MembershipId).ToList() ?? [];
        }

        if (action.Question is not null)
        {
            confirming = action;
            return;
        }

        await RunAsync(action);
    }

    private async Task RunAsync(AccountAction action)
    {
        busy = true;
        notice = null;
        object body = action switch
        {
            { Handover: true } when action.Url.EndsWith(TransferPath) => new TransferRecordsRequest(receiverId!.Value),
            { Handover: true } => new DisableUserRequest(receiverId),
            _ => new { },
        };
        var result = action.Delete ? await Api.DeleteAsync(action.Url) : await Api.PostAsync<bool>(action.Url, body);
        busy = false;
        confirming = null;

        if (!result.IsSuccess)
        {
            message = result.Error;
            return;
        }

        if (action.Delete)
        {
            Navigation.NavigateTo("yonetim/kullanicilar");
            return;
        }

        await LoadAsync();
        notice = action.Handover && receiverId is not null
            ? action.Done + " " + Texts.Get("admin.userDetail.handedOver", receivers.FirstOrDefault(r => r.MembershipId == receiverId)?.DisplayName)
            : action.Done;
    }

    private async Task LoadUnitAsync()
    {
        units = (await Api.GetAsync<List<BusinessUnitDto>>("/api/business-units")).Value ?? [];
        currentUnit = (await Api.GetAsync<MembershipBusinessUnitDto>($"/api/users/{MembershipId}/business-unit")).Value;
        selectedUnitId = currentUnit?.Id ?? Guid.Empty;
    }

    private BusinessUnitChangePreviewDto? unitPreview;
    private string recordChoice = string.Empty;
    private Guid? transferTo;
    private string unitReason = string.Empty;
    private List<UserDto> oldUnitMembers = [];

    private const string MoveChoice = "move";
    private const string TransferChoice = "transfer";

    private void ChooseMove() => recordChoice = MoveChoice;

    private void ChooseTransfer() => recordChoice = TransferChoice;

    private void ResetUnitChange()
    {
        unitPreview = null;
        recordChoice = string.Empty;
        transferTo = null;
        unitReason = string.Empty;
        oldUnitMembers = [];
    }

    /// <summary>Kayıt kararı ve gerekçe istenen durumlarda tamamlanmadan onaylanamaz (sunucu da aynısını ister).</summary>
    private bool CanConfirmUnitChange =>
        unitPreview is { } p
        && (!p.DecisionRequired || recordChoice == MoveChoice || (recordChoice == TransferChoice && transferTo is not null))
        && (!p.ReasonRequired || !string.IsNullOrWhiteSpace(unitReason));

    // Önce etkisi gösterilir; kayıt, gerekçe ya da uyarı yoksa doğrudan uygulanır.
    private async Task PreviewUnitAsync()
    {
        busy = true;
        notice = null;
        message = null;
        var result = await Api.GetAsync<BusinessUnitChangePreviewDto>(
            $"/api/users/{MembershipId}/business-unit/change-preview?businessUnitId={selectedUnitId}");
        busy = false;
        if (result.Value is not { } preview)
        {
            message = result.Error;
            return;
        }

        if (!preview.IsChange)
        {
            return;
        }

        ResetUnitChange();
        unitPreview = preview;
        if (!preview.DecisionRequired && !preview.ReasonRequired && preview.Warnings.Count == 0)
        {
            await ApplyUnitAsync();
            return;
        }

        if (preview.DecisionRequired && preview.CurrentBusinessUnitId is { } current)
        {
            var page = (await Api.GetAsync<UserPageResponse>($"/api/users?businessUnitId={current}&pageSize=100")).Value;
            oldUnitMembers = page?.Items.Where(u => u.Status == UserStatus.Active && u.MembershipId != MembershipId).ToList() ?? [];
        }
    }

    private async Task ApplyUnitAsync()
    {
        busy = true;
        notice = null;
        message = null;
        var request = new SetMembershipBusinessUnitRequest(
            selectedUnitId,
            string.IsNullOrWhiteSpace(unitReason) ? null : unitReason.Trim(),
            recordChoice == MoveChoice,
            recordChoice == TransferChoice ? transferTo : null);
        var result = await Api.PutAsync<bool>($"/api/users/{MembershipId}/business-unit", request);
        busy = false;
        if (!result.IsSuccess)
        {
            message = result.FieldErrors.Count > 0 ? string.Join(" ", result.FieldErrors.Values.SelectMany(v => v)) : result.Error;
            return;
        }

        ResetUnitChange();
        await LoadAsync();
        await LoadUnitAsync();
        accessVersion++;
        notice = Texts.Get("admin.userDetail.unitChanged");
    }

    private async Task LoadTeamsAsync()
    {
        teams = (await Api.GetAsync<List<TeamDto>>("/api/teams")).Value ?? [];
        selectedTeams = ((await Api.GetAsync<List<TeamDto>>($"/api/users/{MembershipId}/teams")).Value ?? []).Select(t => t.Id).ToHashSet();
    }

    private void ToggleTeam(Guid teamId, bool on)
    {
        if (on)
        {
            selectedTeams.Add(teamId);
        }
        else
        {
            selectedTeams.Remove(teamId);
        }
    }

    private async Task SaveTeamsAsync()
    {
        busy = true;
        notice = null;
        var result = await Api.PutAsync<bool>($"/api/users/{MembershipId}/teams", new SetMembershipTeamsRequest(selectedTeams.ToList()));
        busy = false;
        if (!result.IsSuccess)
        {
            message = result.Error;
            return;
        }

        await LoadTeamsAsync();
        accessVersion++;
        notice = Texts.Get("admin.userDetail.teamsSaved");
    }

    private async Task LoadCompaniesAsync()
    {
        companies = (await Api.GetAsync<List<OperatingCompanyDto>>("/api/companies")).Value ?? [];
        var current = (await Api.GetAsync<List<CompanyAssignment>>($"/api/memberships/{MembershipId}/companies")).Value ?? [];
        var byCompany = current.ToDictionary(a => a.CompanyId);
        assignments = companies.ToDictionary(c => c.Id, c =>
        {
            byCompany.TryGetValue(c.Id, out var assignment);
            return new CompanyAssignmentState
            {
                Selected = assignment is not null,
                ValidUntil = assignment?.ValidUntil?.LocalDateTime.Date,
                BranchId = assignment?.BranchId,
            };
        });

        branchesByCompany = [];
        foreach (var company in companies)
        {
            branchesByCompany[company.Id] = (await Api.GetAsync<List<BranchDto>>($"/api/companies/{company.Id}/branches")).Value ?? [];
        }
    }

    private void ToggleCompany(Guid companyId, bool on) => assignments[companyId].Selected = on;

    private void SetValidUntil(Guid companyId, string? value) =>
        assignments[companyId].ValidUntil = DateTime.TryParse(value, out var date) ? date.Date : null;

    private void SetBranch(Guid companyId, string? value) =>
        assignments[companyId].BranchId = Guid.TryParse(value, out var branchId) ? branchId : null;

    private async Task SaveCompaniesAsync()
    {
        busy = true;
        notice = null;
        var payload = assignments
            .Where(entry => entry.Value.Selected)
            .Select(entry => new CompanyAssignment(
                entry.Key,
                null,
                entry.Value.ValidUntil is { } date ? new DateTimeOffset(date.Date, TimeZoneInfo.Local.GetUtcOffset(date.Date)) : null,
                entry.Value.BranchId))
            .ToList();
        var result = await Api.PutAsync<bool>(
            $"/api/memberships/{MembershipId}/companies", new SetMembershipCompaniesRequest(payload));
        busy = false;
        if (!result.IsSuccess)
        {
            message = result.Error;
            return;
        }

        await LoadCompaniesAsync();
        notice = Texts.Get("admin.userDetail.companiesSaved");
        if (user?.IsCurrentUser == true)
        {
            await Session.RefreshAsync();
        }
    }

    private async Task SaveRolesAsync()
    {
        busy = true;
        notice = null;
        var result = await Api.PutAsync<bool>($"/api/memberships/{MembershipId}/roles", new SetMembershipRolesRequest(selectedRoles.ToList()));
        busy = false;

        if (!result.IsSuccess)
        {
            message = result.Error;
            return;
        }

        await LoadAsync();
        accessVersion++;
        notice = Texts.Get("admin.userDetail.rolesSaved");
        if (user?.IsCurrentUser == true)
        {
            await Session.RefreshAsync();
        }
    }
}
