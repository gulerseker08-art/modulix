@page "/yonetim/alan-ve-lookup-ayarlari"
@inject ApiClient Api
@inject SessionState Session
@inject LookupCatalog Catalog

<PageTitle>@Texts.Get("admin.lookups.title") · Modulix</PageTitle>

@* Lookup alanları (ADR-0016): kullanıcının seçtiği N→1 referans alanları. Teknik tanım kodda sabittir; yönetici yalnızca metin aramasını açıp kapatır. *@
<AuthGate Permission="@CoreAccess.ManageCustomization">
    <a class="back-link" href="yonetim">← @Texts.Get("nav.app.admin")</a>

    <div class="page-header">
        <h1>@Texts.Get("admin.lookups.title")</h1>
    </div>

    <p class="text-muted">
        @((MarkupString)Texts.Get("admin.lookups.intro", "<strong>", "</strong>"))
    </p>

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message <button type="button" class="btn btn-sm btn-outline-secondary ms-2" @onclick="LoadAsync">@Texts.Get("admin.lookups.reload")</button></div>
    }

    @if (notice is not null)
    {
        <div class="alert alert-success" role="status">@notice</div>
    }

    @if (loading)
    {
        <LoadingState />
    }
    else if (items is { Count: > 0 })
    {
        <div class="filters">
            <label class="visually-hidden" for="lookup-filter">@Texts.Get("admin.lookups.search")</label>
            <input id="lookup-filter" class="form-control" type="search" placeholder="@Texts.Get("admin.lookups.searchPlaceholder")" @bind="filter" @bind:event="oninput" />
        </div>

        @foreach (var group in Visible.GroupBy(i => i.SourceEntityName))
        {
            <section class="settings-group">
                <h2>@group.Key</h2>
                <div class="table-responsive">
                    <table class="table lookup-settings">
                        <thead>
                            <tr><th>@Texts.Get("admin.subProfiles.field")</th><th>@Texts.Get("admin.subProfiles.target")</th><th>@Texts.Get("admin.lookups.searchable")</th><th>@Texts.Get("admin.lookups.effect")</th><th></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var item in group)
                            {
                                var value = Current(item);
                                var changed = pending.ContainsKey(item.Key);
                                <tr class="@(changed ? "is-changed" : null)">
                                    <td data-label="@Texts.Get("admin.subProfiles.field")">
                                        <strong>@item.Title</strong>
                                        @if (item.DependsOnField is not null)
                                        {
                                            <small class="d-block text-muted">@Texts.Get("admin.lookups.dependent")</small>
                                        }
                                    </td>
                                    <td data-label="@Texts.Get("admin.subProfiles.target")">@(item.IsMember ? Texts.Get("admin.lookups.member") : item.TargetEntityName)</td>
                                    <td data-label="@Texts.Get("admin.lookups.searchable")">
                                        <div class="form-check form-switch">
                                            <input id="s-@item.Key" class="form-check-input" type="checkbox" role="switch" checked="@value"
                                                   disabled="@busy" @onchange="e => Set(item, (bool)e.Value!)" />
                                            <label class="form-check-label" for="s-@item.Key">
                                                @(value ? Texts.Get("two-factor.on") : Texts.Get("two-factor.off"))
                                                @if (!changed && !item.Customized) { <small class="text-muted"> @Texts.Get("admin.lookups.default")</small> }
                                                @if (changed) { <small class="text-warning-emphasis"> @Texts.Get("admin.lookups.unsaved")</small> }
                                            </label>
                                        </div>
                                    </td>
                                    <td data-label="@Texts.Get("admin.lookups.effect")">
                                        <small class="text-muted">
                                            @(value
                                                ? Texts.Get("admin.lookups.searchOn", item.MinSearchLength, item.SearchDescription)
                                                : Texts.Get("admin.lookups.searchOff"))
                                        </small>
                                    </td>
                                    <td>
                                        @if (item.Customized || (changed && pending[item.Key] is not null))
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@busy" @onclick="() => Reset(item)">@Texts.Get("common.columns.reset")</button>
                                        }
                                        @if (rowErrors.TryGetValue(item.Key, out var rowError))
                                        {
                                            <div class="invalid-feedback d-block">@rowError</div>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }

        <div class="form-actions">
            <button type="button" class="btn btn-primary" disabled="@(busy || pending.Count == 0)" @onclick="SaveAsync">
                @(busy ? Texts.Get("admin.lookups.saving") : pending.Count == 0 ? Texts.Get("common.save") : Texts.Get("admin.lookups.saveCount", pending.Count))
            </button>
            <button type="button" class="btn btn-outline-secondary" disabled="@(busy || pending.Count == 0)" @onclick="Discard">@Texts.Get("admin.lookups.discard")</button>
            @if (pending.Count == 0)
            {
                <span class="text-muted">@Texts.Get("admin.lookups.noChanges")</span>
            }
        </div>
    }
    else if (!loading && message is null)
    {
        <p class="text-muted">@Texts.Get("admin.lookups.noModule")</p>
    }
</AuthGate>

@code {
    // Bekleyen değişiklik: anahtar → true/false (firmanın seçimi) ya da null (varsayılana dön).
    private readonly Dictionary<string, bool?> pending = [];
    private readonly Dictionary<string, string> rowErrors = [];
    private List<LookupDto>? items;
    private string filter = string.Empty;
    private string? message;
    private string? notice;
    private bool loading = true;
    private bool busy;

    private IEnumerable<LookupDto> Visible => (items ?? []).Where(i => filter.Length == 0
        || i.Title.Contains(filter, StringComparison.CurrentCultureIgnoreCase)
        || i.SourceEntityName.Contains(filter, StringComparison.CurrentCultureIgnoreCase)
        || (i.TargetEntityName ?? Texts.Get("admin.lookups.user")).Contains(filter, StringComparison.CurrentCultureIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (Session.Can(CoreAccess.ManageCustomization))
        {
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        loading = true;
        message = null;
        var result = await Api.GetAsync<List<LookupDto>>("/api/lookups");
        loading = false;
        if (!result.IsSuccess)
        {
            message = result.Error ?? Texts.Get("admin.lookups.loadFailed");
            return;
        }

        items = result.Value ?? [];
        pending.Clear();
        rowErrors.Clear();
    }

    private bool Current(LookupDto item) => pending.TryGetValue(item.Key, out var value) ? value ?? item.DefaultSearchable : item.Searchable;

    // Değer kayıtlı ayara geri dönerse bekleyen değişiklik de kalkar.
    private void Set(LookupDto item, bool value)
    {
        notice = null;
        if (value == item.Searchable)
        {
            pending.Remove(item.Key);
        }
        else
        {
            pending[item.Key] = value;
        }
    }

    private void Reset(LookupDto item)
    {
        notice = null;
        if (!item.Customized)
        {
            pending.Remove(item.Key);
        }
        else
        {
            pending[item.Key] = null;
        }
    }

    private void Discard()
    {
        pending.Clear();
        rowErrors.Clear();
    }

    // Her ayar kendi sürümüyle yazılır; başkası araya girdiyse o satır çakışma gösterir ve diğerleri yine kaydedilir.
    private async Task SaveAsync()
    {
        busy = true;
        notice = null;
        message = null;
        rowErrors.Clear();
        var saved = 0;
        foreach (var (key, value) in pending.ToList())
        {
            var item = items!.First(i => i.Key == key);
            var result = await Api.PutAsync<LookupDto>($"/api/customization/lookups/{Uri.EscapeDataString(key)}", new SaveLookupSettingRequest(value, item.Version));
            if (result.Value is { } updated)
            {
                items![items.FindIndex(i => i.Key == key)] = updated;
                pending.Remove(key);
                saved++;
            }
            else
            {
                rowErrors[key] = result.Status == System.Net.HttpStatusCode.Conflict
                    ? Texts.Get("admin.lookups.conflict")
                    : result.Error ?? Texts.Get("common.saveFailed");
            }
        }

        busy = false;
        Catalog.Invalidate();
        if (saved > 0)
        {
            notice = Texts.Get("admin.lookups.saved", saved);
        }

        if (rowErrors.Count > 0)
        {
            message = Texts.Get("admin.lookups.partial");
        }
    }
}
