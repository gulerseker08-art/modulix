@page "/sifremi-unuttum"
@inject ApiClient Api

<PageTitle>@Texts.Get("auth.forgot.title") · Modulix</PageTitle>

@* "Şifremi unuttum" (Y7a). Hesap olsun olmasın aynı yanıt gösterilir; adreslerin kayıtlı olup olmadığı yoklanamaz. *@
<div class="narrow">
    <h1>@Texts.Get("auth.forgot.title")</h1>

    @if (sent)
    {
        <div class="alert alert-success" role="status">@Texts.Get("auth.forgot.sent")</div>
        <a href="giris">@Texts.Get("auth.backToLogin")</a>
    }
    else
    {
        @if (error is not null)
        {
            <div class="alert alert-danger" role="alert">@error</div>
        }

        <p class="text-muted">@Texts.Get("auth.forgot.help")</p>
        <form @onsubmit="SendAsync" @onsubmit:preventDefault>
            <div class="mb-3">
                <label class="form-label" for="email">@Texts.Get("common.email")</label>
                <input id="email" class="form-control" type="email" autocomplete="username" required @bind="email" @bind:event="oninput" />
            </div>
            <button type="submit" class="btn btn-primary w-100" disabled="@(busy || string.IsNullOrWhiteSpace(email))">@Texts.Get("auth.forgot.submit")</button>
        </form>
        <p class="mt-3"><a href="giris">@Texts.Get("auth.backToLogin")</a></p>
    }
</div>

@code {
    private string email = string.Empty;
    private string? error;
    private bool busy;
    private bool sent;

    private async Task SendAsync()
    {
        busy = true;
        var result = await Api.PostAsync<bool>("/api/auth/forgot-password", new ForgotPasswordRequest(email.Trim()));
        busy = false;
        (sent, error) = (result.IsSuccess, result.Error);
    }
}
