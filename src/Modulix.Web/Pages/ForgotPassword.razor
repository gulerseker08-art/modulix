@page "/sifremi-unuttum"
@inject ApiClient Api

<PageTitle>Şifremi unuttum · ModuliX</PageTitle>

@* "Şifremi unuttum" (Y7a). Hesap olsun olmasın aynı yanıt gösterilir; adreslerin kayıtlı olup olmadığı yoklanamaz. *@
<div class="narrow">
    <h1>Şifremi unuttum</h1>

    @if (sent)
    {
        <div class="alert alert-success" role="status">
            Bu adrese bağlı bir hesap varsa şifre sıfırlama bağlantısı gönderdik. E-postanızı kontrol edin; bağlantı 24 saat geçerlidir.
        </div>
        <a href="giris">Giriş sayfasına dön</a>
    }
    else
    {
        @if (error is not null)
        {
            <div class="alert alert-danger" role="alert">@error</div>
        }

        <p class="text-muted">Giriş e-postanızı yazın; size yeni şifre belirleme bağlantısı gönderelim.</p>
        <form @onsubmit="SendAsync" @onsubmit:preventDefault>
            <div class="mb-3">
                <label class="form-label" for="email">E-posta</label>
                <input id="email" class="form-control" type="email" autocomplete="username" required @bind="email" @bind:event="oninput" />
            </div>
            <button type="submit" class="btn btn-primary w-100" disabled="@(busy || string.IsNullOrWhiteSpace(email))">Bağlantı gönder</button>
        </form>
        <p class="mt-3"><a href="giris">Giriş sayfasına dön</a></p>
    }
</div>

@code {
    private string email = string.Empty;
    private string? error;
    private bool busy;
    private bool sent;

    private async Task SendAsync()
    {
        busy = true;
        var result = await Api.PostAsync<bool>("/api/auth/forgot-password", new ForgotPasswordRequest(email.Trim()));
        busy = false;
        (sent, error) = (result.IsSuccess, result.Error);
    }
}
