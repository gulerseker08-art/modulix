@page "/"
@inject SessionState Session
@inject ApiClient Api
@inject CrmLookups Lookups
@inject NavigationManager Navigation

<PageTitle>Modulix</PageTitle>

<AuthGate>
    <PageHeader Title="@Greeting" Icon="home" Subtitle="@Session.ActiveTenantName" />

    @if (Session.IsModuleEnabled(CrmAccess.ModuleKey))
    {
        @* Özet kutuları ilgili listeye bağlantıdır; ayrıca kısayol kartı çizilmez. *@
        @if (!loaded)
        {
            <LoadingState Kind="LoadingKind.Cards" />
        }
        else if (counts.Count > 0)
        {
            <div class="stat-grid">
                @foreach (var (label, href, total) in counts)
                {
                    <a class="stat-card" href="@href">
                        <span class="stat-icon"><AppIcon Name="@IconFor(href)" Size="18" /></span>
                        <span>@label</span>
                        <strong>@total.ToString("N0", Regional.Numbers)</strong>
                    </a>
                }
            </div>
        }

        @* Solda satış hunisi, sağda kullanıcının bugünkü işleri: aynı veri iki grafikle yinelenmez. *@
        @if (stages.Count > 0 || showToday)
        {
            <div class="chart-grid">
                @if (stages.Count > 0)
                {
                    <section class="chart-card">
                        <h2>@Texts.Get("home.funnel.title")</h2>
                        <BarChart Slices="stages" Title="@Texts.Get("home.funnel.chart")" />
                    </section>
                }
                @if (showToday)
                {
                    <TodayActivities Items="todayItems" Error="@todayError" Lookups="Lookups" OnSelect="OpenActivities" />
                }
            </div>
        }
    }
    else
    {
        <p>@Texts.Get("home.noModule")</p>
    }
</AuthGate>

@code {
    private readonly List<(string Label, string Href, int Total)> counts = [];
    private IReadOnlyList<ChartSlice> stages = [];
    private IReadOnlyList<ActivityDto>? todayItems;
    private string? todayError;
    private bool showToday;
    private bool loaded;

    private string Greeting => Session.User?.DisplayName.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() is { } name
        ? Texts.Get("home.greeting", name)
        : Texts.Get("home.title");


    private void OpenActivities(ActivityDto activity) => Navigation.NavigateTo("crm/aktiviteler");

    private static string IconFor(string href) => href switch
    {
        "crm/firmalar" => "building",
        "crm/kisiler" => "users",
        "crm/firsatlar" => "target",
        _ => "activity",
    };

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (!Session.IsModuleEnabled(CrmAccess.ModuleKey))
        {
            return;
        }

        // Bugünün işleri özet sayılarını beklemeden istenir (yalnızca kullanıcıya atananlar; kapsam sunucuda).
        showToday = Session.Can(CrmAccess.ActivitiesRead);
        Task todayTask = showToday ? LoadTodayAsync() : Task.CompletedTask;

        var entries = new List<(string Label, string Href, string Url, bool Allowed)>
        {
            (Texts.Get("crm.companies.title"), "crm/firmalar", "/api/crm/companies", Session.Can(CrmAccess.CompaniesRead)),
            (Texts.Get("crm.contacts.title"), "crm/kisiler", "/api/crm/contacts", Session.Can(CrmAccess.ContactsRead)),
            (Texts.Get("crm.opportunities.title"), "crm/firsatlar", "/api/crm/opportunities", Session.Can(CrmAccess.OpportunitiesRead)),
            (Texts.Get("crm.activities.title"), "crm/aktiviteler", "/api/crm/activities", Session.Can(CrmAccess.ActivitiesRead)),
        };

        // Yalnızca toplam sayı gerekir; tek kayıtlık sayfa yeter.
        var totals = await Task.WhenAll(entries.Where(e => e.Allowed).Select(async e =>
            (e.Label, e.Href, Result: await Api.GetAsync<CrmPage<object>>($"{e.Url}?pageSize=1"))));
        counts.AddRange(totals.Where(t => t.Result.Value is not null).Select(t => (t.Label, t.Href, t.Result.Value!.TotalCount)));

        if (Session.Can(CrmAccess.OpportunitiesRead))
        {
            await Lookups.LoadAsync();
            var values = Lookups.ValuesOf(CrmLists.OpportunityStage);
            var perStage = await Task.WhenAll(values.Select(async v =>
                (Value: v, Result: await Api.GetAsync<CrmPage<object>>(
                    $"/api/crm/opportunities?stage={Uri.EscapeDataString(v.Key)}&pageSize=1"))));
            stages = perStage
                .Where(s => s.Result.Value is { TotalCount: > 0 } || s.Value.Active)
                .Select(s => new ChartSlice(s.Value.Label, s.Result.Value?.TotalCount ?? 0))
                .ToList();
            if (stages.All(s => s.Value == 0))
            {
                stages = [];
            }
        }

        loaded = true;
        await todayTask;
    }

    private async Task LoadTodayAsync()
    {
        await Lookups.LoadAsync();
        DateOnly today = DateOnly.FromDateTime(Regional.Now.DateTime);
        var list = await Api.GetAsync<CrmPage<ActivityDto>>(
            $"/api/crm/activities?page=1&pageSize=50&range={Uri.EscapeDataString(ActivityLabels.Range(today, today))}&ownerId=me");
        todayItems = list.Value?.Items.OrderBy(a => a.IsAllDay ? 0 : 1).ThenBy(a => a.StartAt ?? a.DueAt).ToList() ?? [];
        todayError = list.Error;
        StateHasChanged();
    }
}
