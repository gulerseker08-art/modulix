@page "/depo/hareketler"
@using System.Text.Json.Nodes
@inject ApiClient Api
@inject SessionState Session
@inject CrmLookups Lookups

<PageTitle>@Texts.Get("nav.app.warehouse.stock-movements") · Modulix</PageTitle>

<AuthGate Module="@WarehouseAccess.ModuleKey" Permission="@WarehouseAccess.MovementsRead">
    <PageHeader Title="@Texts.Get("nav.app.warehouse.stock-movements")" Icon="repeat" Subtitle="@(page is null ? Texts.Get("warehouse.stockMovements.intro") : Texts.Get("common.records", page.TotalCount))" />

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }

    @if (notice is not null)
    {
        <div class="alert alert-success" role="status">@notice</div>
    }

    @if (creating)
    {
        <StockMovementEditor Lookups="Lookups" LotId="lotId" Saved="CreatedAsync" Cancelled="() => creating = false" />
    }

    @if (reversing is { } target)
    {
        @* Onay adımı: ters kayıt geri alınamaz (bir düzeltme yeniden düzeltilemez); düz kırmızı düğme onay adımındadır. *@
        <div class="alert alert-warning" role="alertdialog" aria-labelledby="reverse-title">
            <h2 id="reverse-title" class="h6">@Texts.Get("warehouse.stockMovements.reverseTitle")</h2>
            <p>
                @Texts.Get("warehouse.stockMovements.reverseText", Lookups.Label(WarehouseAccess.MovementTypeList, WarehouseLabels.Text(target, "typeKey")), WarehouseLabels.NameOf(lotNames, WarehouseLabels.Id(target, "lotId")), WarehouseLabels.Number(WarehouseLabels.Decimal(target, "quantity")))
            </p>
            @if (AdjustmentTypes.Count > 1)
            {
                <label class="form-label" for="reverse-type">@Texts.Get("warehouse.stockMovements.adjustmentType")</label>
                <select id="reverse-type" class="form-select mb-2" @bind="reverseTypeKey">
                    @foreach (var type in AdjustmentTypes)
                    {
                        <option value="@type.Key">@type.Label</option>
                    }
                </select>
            }
            @if (AdjustmentTypes.Count == 0)
            {
                <p class="text-danger">@Texts.Get("warehouse.stockMovements.noAdjustmentType")</p>
            }
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-outline-secondary" @onclick="() => reversing = null">@Texts.Get("common.dismiss")</button>
                <button type="button" class="btn btn-danger" disabled="@(busy || string.IsNullOrEmpty(reverseTypeKey))" aria-busy="@(busy ? "true" : "false")" @onclick="ReverseAsync">@Texts.Get("warehouse.stockMovements.reverse")</button>
            </div>
        </div>
    }

    @* Görünümler sunucuda süzgeç olarak uygulanır; sayfalama ve toplam doğru kalır. Gün sınırları sunucuda UTC'dir. *@
    <ViewTabs Items="ViewOptions" Value="@view" ValueChanged="ChooseViewAsync" Label="@Texts.Get("warehouse.stockMovements.views")" NewView="StartNaming" />

    <div class="list-toolbar">
        <form class="search" @onsubmit="() => LoadAsync(1)" @onsubmit:preventDefault>
            <input class="form-control" type="search" aria-label="@Texts.Get("warehouse.stockMovements.search")" placeholder="@Texts.Get("warehouse.stockMovements.searchPlaceholder")" @bind="search" />
        </form>
        <FilterToggle @bind-Open="filtersOpen" Count="ActiveFilters" />
        <GridColumnPicker State="grid" Changed="ColumnsChanged" />
        @if (Session.Can(WarehouseAccess.MovementsWrite) && !creating)
        {
            <button type="button" class="btn btn-primary" @onclick="StartCreate"><AppIcon Name="plus" Size="16" /> @Texts.Get("warehouse.stockMovements.new")</button>
        }
    </div>

    @if (filtersOpen || ActiveFilters > 0)
    {
        <div class="filters">
            <select class="form-select" aria-label="@Texts.Get("warehouse.movementType")" @bind="typeKey" @bind:after="() => LoadAsync(1)">
                <option value="">@Texts.Get("warehouse.allTypes")</option>
                @foreach (var type in Lookups.ValuesOf(WarehouseAccess.MovementTypeList))
                {
                    <option value="@type.Key">@type.Label</option>
                }
            </select>
            <LookupPicker Id="movement-lot-filter" LookupKey="@WarehouseAccess.MovementLotLookup" Value="lotId" ValueChanged="ChooseLotAsync" Placeholder="@Texts.Get("warehouse.lots.view.all")" />
            <LookupPicker Id="movement-location-filter" LookupKey="@WarehouseAccess.MovementToLocationLookup" Value="locationId" ValueChanged="ChooseLocationAsync" Placeholder="@Texts.Get("warehouse.locations.view.all")" />
            <input class="form-control" type="date" aria-label="@Texts.Get("warehouse.fromDay")" @bind="occurredFrom" @bind:format="yyyy-MM-dd" @bind:after="() => LoadAsync(1)" />
            <input class="form-control" type="date" aria-label="@Texts.Get("warehouse.toDay")" @bind="occurredTo" @bind:format="yyyy-MM-dd" @bind:after="() => LoadAsync(1)" />
        </div>
    }

    <PersonalViewBar Active="Active" Dirty="grid.Differs(Active)" Naming="views.Naming" NamingChanged="views.StartNaming" Error="@views.Error"
                     SaveAs="SaveAsAsync" UpdateView="UpdateViewAsync" DiscardChanges="DiscardAsync" DeleteView="DeleteViewAsync" />

    @if (page is null)
    {
        <LoadingState Kind="LoadingKind.Table" />
    }
    else if (page.Items.Count == 0)
    {
        <EmptyState Compact="true" Title="@Texts.Get("warehouse.stockMovements.empty")" />
    }
    else
    {
        <p class="visually-hidden" role="status" aria-live="polite">@Texts.Get("warehouse.stockMovements.listed", page.TotalCount)</p>
        <table class="table record-table">
            <caption class="visually-hidden">@Texts.Get("warehouse.stockMovements.caption")</caption>
            <thead>
                <tr>
                    @foreach (var column in grid.VisibleColumns)
                    {
                        <GridHeader Column="column" State="grid" SortChanged="SortAsync" />
                    }
                    <th scope="col" class="row-menu-cell"><span class="visually-hidden">@Texts.Get("common.actions")</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var movement in page.Items)
                {
                    <tr>
                        @foreach (var column in grid.VisibleColumns)
                        {
                            @Cell(column, movement)
                        }
                        <td class="row-menu-cell">
                            @if (Session.Can(WarehouseAccess.MovementsWrite) && CanReverse(movement))
                            {
                                <RowMenu Label="@Texts.Get("warehouse.stockMovements.rowActions", WarehouseLabels.NameOf(lotNames, WarehouseLabels.Id(movement, "lotId")))">
                                    <button type="button" class="view-menu-item" role="menuitem" @onclick="() => StartReverse(movement)"><AppIcon Name="arrow-left" Size="16" /> <span>@Texts.Get("warehouse.stockMovements.reverseMenu")</span></button>
                                </RowMenu>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager PageSizeChoice="true" Page="page.Page" PageSize="page.PageSize" TotalCount="page.TotalCount" PageChanged="LoadAsync" />
    }
</AuthGate>

@code {
    private static readonly string Url = "/api/records/" + WarehouseAccess.StockMovementEntityKey;

    private const string AllViews = "all";
    private const string TodayView = "today";
    private const string WeekView = "week";

    // Sütunların sırası varsayılan sıradır; sıralama anahtarları kayıt deposunun beyanıdır (StockMovementRecordStore.SortKeys).
    private static GridColumnDef[] BaseColumns =>
    [
        new("occurredAt", Texts.Get("warehouse.time"), "clock", "occurredAt", "-occurredAt", Locked: true),
        new("typeKey", Texts.Get("common.field.kind"), "tag", "typeKey", "-typeKey"),
        new("lot", Texts.Get("warehouse.lot"), "package"),
        new("from", Texts.Get("warehouse.from"), "map-pin"),
        new("to", Texts.Get("warehouse.to"), "map-pin"),
        new("quantity", Texts.Get("warehouse.quantity"), "hash", "quantity", "-quantity"),
        new("reasonKey", Texts.Get("warehouse.reason"), "info", DefaultVisible: false),
        new("documentReference", Texts.Get("warehouse.document"), "file-text"),
        new("reverses", Texts.Get("warehouse.stockMovements.col.reverses"), "history", DefaultVisible: false),
    ];

    private readonly GridViewState grid = new("warehouse.stock-movements", "-occurredAt");
    private PersonalGridViews views = default!;
    private RecordPageResponse? page;
    private readonly Dictionary<Guid, string> lotNames = [];
    private readonly Dictionary<Guid, string> locationNames = [];
    private bool creating;
    private bool filtersOpen;
    private bool busy;
    private string? message;
    private string? notice;
    private string? search;
    private string view = AllViews;
    private string typeKey = "";
    private Guid? locationId;
    private DateOnly? occurredFrom;
    private DateOnly? occurredTo;
    private RecordResponse? reversing;
    private string reverseTypeKey = "";
    private string reverseKey = "";

    /// <summary>Partiler ekranından gelince (?lotId=…) liste o partiyle süzülür ve yeni hareket formunda parti seçili gelir.</summary>
    [SupplyParameterFromQuery(Name = "lotId")] public Guid? QueryLotId { get; set; }

    private Guid? lotId;

    private int ActiveFilters => (typeKey.Length > 0 ? 1 : 0) + (lotId is null ? 0 : 1) + (locationId is null ? 0 : 1)
        + (view == AllViews && occurredFrom is not null ? 1 : 0) + (view == AllViews && occurredTo is not null ? 1 : 0);

    private IReadOnlyList<ChoiceValueDto> AdjustmentTypes =>
        [.. Lookups.ValuesOf(WarehouseAccess.MovementTypeList).Where(v => v.Active && v.Category == WarehouseAccess.MovementAdjustment)];

    protected override async Task OnInitializedAsync()
    {
        views = new PersonalGridViews(Api, "warehouse.stock-movements");
        lotId = QueryLotId;
        await Session.EnsureLoadedAsync();
        if (Session.Can(WarehouseAccess.MovementsRead))
        {
            await Lookups.LoadAsync();
            grid.Define(BaseColumns);
            await views.LoadAsync();
            await LoadAsync(1);
        }
    }

    private GridViewDto? Active => views.Find(view);

    // Görünümler yalnızca süzgeçtir (Tümü, Bugün, Son 7 gün, kişisel); tür, parti, lokasyon ve tarih "Filtrele" ile açılır.
    private IReadOnlyList<ViewOption> ViewOptions =>
    [
        new(AllViews, Texts.Get("warehouse.stockMovements.view.all"), Icon: "repeat"),
        new(TodayView, Texts.Get("warehouse.stockMovements.view.today"), Icon: "clock"),
        new(WeekView, Texts.Get("warehouse.stockMovements.view.week"), Icon: "calendar"),
        .. views.Options,
    ];

    private async Task ChooseViewAsync(string key)
    {
        view = key;
        views.StartNaming(false);
        var today = DateOnly.FromDateTime(DateTime.UtcNow);
        if (Active is { } saved)
        {
            // Kişisel görünüm: sütunlar, sıralama ve süzgeç birlikte gelir. Tarihler sabit gün olarak saklanır.
            grid.Apply(saved);
            var filters = GridFilters.Parse(saved.Filters);
            typeKey = filters.GetValueOrDefault("typeKey") ?? "";
            lotId = Guid.TryParse(filters.GetValueOrDefault("lotId"), out var lot) ? lot : null;
            locationId = Guid.TryParse(filters.GetValueOrDefault("locationId"), out var location) ? location : null;
            occurredFrom = DateOnly.TryParse(filters.GetValueOrDefault("occurredFrom"), out var from) ? from : null;
            occurredTo = DateOnly.TryParse(filters.GetValueOrDefault("occurredTo"), out var to) ? to : null;
        }
        else
        {
            grid.Reset();
            typeKey = "";
            lotId = locationId = null;
            occurredFrom = key switch { TodayView => today, WeekView => today.AddDays(-6), _ => null };
            occurredTo = null;
        }

        await LoadAsync(1);
    }

    private async Task ChooseLotAsync(Guid? id)
    {
        lotId = id;
        await LoadAsync(1);
    }

    private async Task ChooseLocationAsync(Guid? id)
    {
        locationId = id;
        await LoadAsync(1);
    }

    private async Task SortAsync(string key)
    {
        grid.Sort = key;
        await LoadAsync(1);
    }

    // Sütun seçimi/sırası değişince veri yeniden çekilmez; olay işleyicisi sayfada olduğu için tablo yeniden çizilir.
    private Task ColumnsChanged() => Task.CompletedTask;

    private string? CurrentFilters => GridFilters.Build(
        ("typeKey", typeKey), lotId is { } l ? ("lotId", l.ToString()) : null, locationId is { } loc ? ("locationId", loc.ToString()) : null,
        occurredFrom is { } f ? ("occurredFrom", f.ToString("yyyy-MM-dd")) : null, occurredTo is { } t ? ("occurredTo", t.ToString("yyyy-MM-dd")) : null);

    private void StartNaming() => views.StartNaming(true);

    private async Task SaveAsAsync(string name)
    {
        if (await views.SaveAsAsync(grid.ToRequest(name, CurrentFilters)) is { } key)
        {
            view = key;
        }
    }

    private async Task UpdateViewAsync()
    {
        if (Active is { } current)
        {
            await views.UpdateAsync(current, grid.ToRequest(current.Name, CurrentFilters));
        }
    }

    private async Task DiscardAsync() => await ChooseViewAsync(view);

    private async Task DeleteViewAsync()
    {
        if (Active is { } current && await views.DeleteAsync(current))
        {
            await ChooseViewAsync(AllViews);
        }
    }

    private async Task LoadAsync(int pageNumber)
    {
        var url = $"{Url}?page={pageNumber}&pageSize={ListPaging.Size}&search={Uri.EscapeDataString(search ?? string.Empty)}";
        if (grid.Sort != grid.DefaultSort)
        {
            url += $"&sort={Uri.EscapeDataString(grid.Sort)}";
        }

        if (typeKey.Length > 0)
        {
            url += $"&typeKey={Uri.EscapeDataString(typeKey)}";
        }

        if (lotId is { } lot)
        {
            url += $"&lotId={lot}";
        }

        if (locationId is { } location)
        {
            url += $"&locationId={location}";
        }

        if (occurredFrom is { } from)
        {
            url += $"&occurredFrom={from:yyyy-MM-dd}";
        }

        if (occurredTo is { } to)
        {
            url += $"&occurredTo={to:yyyy-MM-dd}";
        }

        var result = await Api.GetAsync<RecordPageResponse>(url);
        page = result.Value;
        message = result.Error;
        if (page is not null)
        {
            // Parti ve lokasyon adları yalnızca bu sayfanın kimlikleri için seçim kutusunun çözümleme ucundan gelir; okuma izni yoksa "—".
            await WarehouseLabels.ResolveNamesAsync(Api, WarehouseAccess.MovementLotLookup, page.Items.Select(m => WarehouseLabels.Id(m, "lotId")).OfType<Guid>(), lotNames);
            var locations = page.Items.SelectMany(m => new[] { WarehouseLabels.Id(m, "fromLocationId"), WarehouseLabels.Id(m, "toLocationId") }).OfType<Guid>();
            await WarehouseLabels.ResolveNamesAsync(Api, WarehouseAccess.MovementToLocationLookup, locations, locationNames);
        }
    }

    // Düzeltme kaydı ve başka bir hareketi geri alan kayıt yeniden geri alınamaz (sunucu da reddeder); zaten geri alınmış olanı sunucu bildirir.
    private bool CanReverse(RecordResponse movement) =>
        WarehouseLabels.Id(movement, "reversesMovementId") is null
        && Lookups.CategoryOf(WarehouseAccess.MovementTypeList, WarehouseLabels.Text(movement, "typeKey")) != WarehouseAccess.MovementAdjustment;

    private void StartCreate()
    {
        creating = true;
        reversing = null;
        message = notice = null;
    }

    private void StartReverse(RecordResponse movement)
    {
        reversing = movement;
        creating = false;
        message = notice = null;
        reverseTypeKey = AdjustmentTypes.FirstOrDefault()?.Key ?? "";
        reverseKey = "ui-" + Guid.NewGuid().ToString("N");
    }

    private async Task ReverseAsync()
    {
        if (reversing is not { } target)
        {
            return;
        }

        busy = true;
        var values = new JsonObject
        {
            ["typeKey"] = reverseTypeKey,
            ["reversesMovementId"] = target.Id.ToString(),
            // Onay adımı başına bir anahtar: çift tıklama ikinci ters kaydı yazmaz. Aynı hareketin ikinci kez geri alınmasını sunucu ayrıca reddeder.
            ["idempotencyKey"] = reverseKey,
        };
        var result = await Api.PostAsync<RecordResponse>(Url, new RecordWriteRequest(values, null));
        busy = false;

        if (result.IsSuccess)
        {
            reversing = null;
            notice = Texts.Get("warehouse.stockMovements.reversed");
            await LoadAsync(1);
            return;
        }

        message = result.FieldErrors?.Values.SelectMany(v => v).FirstOrDefault() ?? result.Error;
    }

    private async Task CreatedAsync()
    {
        creating = false;
        notice = Texts.Get("warehouse.stockMovements.created");
        await LoadAsync(1);
    }

    private RenderFragment Cell(GridColumnDef column, RecordResponse movement) => @<td data-label="@column.Label" class="@(column.Key == "occurredAt" ? "primary" : null)">@CellContent(column.Key, movement)</td>;

    private RenderFragment CellContent(string key, RecordResponse movement) => key switch
    {
        "occurredAt" => @<text>@(DateTimeOffset.TryParse(WarehouseLabels.Text(movement, "occurredAt"), out var at) ? CrmLabels.Time(at) : "—")</text>,
        "typeKey" => @<span class="badge @TypeBadge(movement)">@Lookups.Label(WarehouseAccess.MovementTypeList, WarehouseLabels.Text(movement, "typeKey"))</span>,
        "lot" => @<text>@WarehouseLabels.NameOf(lotNames, WarehouseLabels.Id(movement, "lotId"))</text>,
        "from" => @<text>@WarehouseLabels.NameOf(locationNames, WarehouseLabels.Id(movement, "fromLocationId"))</text>,
        "to" => @<text>@WarehouseLabels.NameOf(locationNames, WarehouseLabels.Id(movement, "toLocationId"))</text>,
        "quantity" => @<text>@WarehouseLabels.Number(WarehouseLabels.Decimal(movement, "quantity"))</text>,
        "reasonKey" => @<text>@(WarehouseLabels.Text(movement, "reasonKey") is { Length: > 0 } reason ? Lookups.Label(WarehouseAccess.MovementReasonList, reason) : "—")</text>,
        "documentReference" => @<text>@(WarehouseLabels.Text(movement, "documentReference") is { Length: > 0 } document ? document : "—")</text>,
        "reverses" => @<text>@(WarehouseLabels.Id(movement, "reversesMovementId") is null ? "—" : Texts.Get("warehouse.stockMovements.reversal"))</text>,
        _ => @<text></text>,
    };

    private string TypeBadge(RecordResponse movement) =>
        WarehouseLabels.MovementBadge(Lookups.CategoryOf(WarehouseAccess.MovementTypeList, WarehouseLabels.Text(movement, "typeKey")));
}
