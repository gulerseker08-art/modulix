@page "/depo/vekaletler"
@using System.Globalization
@using System.Text.Json.Nodes
@inject ApiClient Api
@inject SessionState Session
@inject CrmLookups Lookups

<PageTitle>@Texts.Get("nav.app.warehouse.power-of-attorneys") · Modulix</PageTitle>

<AuthGate Module="@WarehouseAccess.ModuleKey" Permission="@WarehouseAccess.AttorneysRead">
    <PageHeader Title="@Texts.Get("nav.app.warehouse.power-of-attorneys")" Icon="file-text" Subtitle="@(page is null ? Texts.Get("warehouse.powerOfAttorneys.intro") : Texts.Get("common.records", page.TotalCount))" />

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }

    @if (editing)
    {
        <PowerOfAttorneyEditor Attorney="selected" Lookups="Lookups" Saved="SavedAsync" Deleted="SavedAsync" Cancelled="Close" />
    }

    @* Görünümler sunucuda süzgeç olarak uygulanır; sayfalama ve toplam doğru kalır. Geçerlilik bugünün tarihine göre sunucuda hesaplanır. *@
    <ViewTabs Items="ViewOptions" Value="@view" ValueChanged="ChooseViewAsync" Label="@Texts.Get("warehouse.powerOfAttorneys.views")" NewView="StartNaming" />

    <div class="list-toolbar">
        <form class="search" @onsubmit="() => LoadAsync(1)" @onsubmit:preventDefault>
            <input class="form-control" type="search" aria-label="@Texts.Get("warehouse.powerOfAttorneys.search")" placeholder="@Texts.Get("warehouse.powerOfAttorneys.searchPlaceholder")" @bind="search" />
        </form>
        <FilterToggle @bind-Open="filtersOpen" Count="ActiveFilters" />
        <GridColumnPicker State="grid" Changed="ColumnsChanged" />
        @if (Session.Can(WarehouseAccess.AttorneysWrite) && !editing)
        {
            <button type="button" class="btn btn-primary" @onclick="() => Open(null)"><AppIcon Name="plus" Size="16" /> @Texts.Get("warehouse.powerOfAttorneys.new")</button>
        }
    </div>

    @if (filtersOpen || ActiveFilters > 0)
    {
        <div class="filters">
            <LookupPicker Id="attorney-importer-filter" LookupKey="@WarehouseAccess.AttorneyImporterLookup" Value="importerId" ValueChanged="ChooseImporterAsync" Placeholder="@Texts.Get("warehouse.declarations.allImporters")" />
            <LookupPicker Id="attorney-broker-filter" LookupKey="@WarehouseAccess.AttorneyBrokerLookup" Value="brokerId" ValueChanged="ChooseBrokerAsync" Placeholder="@Texts.Get("warehouse.declarations.allBrokers")" />
        </div>
    }

    <PersonalViewBar Active="Active" Dirty="grid.Differs(Active)" Naming="views.Naming" NamingChanged="views.StartNaming" Error="@views.Error"
                     SaveAs="SaveAsAsync" UpdateView="UpdateViewAsync" DiscardChanges="DiscardAsync" DeleteView="DeleteViewAsync" />

    @if (page is null)
    {
        <LoadingState Kind="LoadingKind.Table" />
    }
    else if (page.Items.Count == 0)
    {
        <p class="text-muted" role="status">@Texts.Get("warehouse.powerOfAttorneys.empty")</p>
    }
    else
    {
        <p class="visually-hidden" role="status" aria-live="polite">@Texts.Get("warehouse.powerOfAttorneys.listed", page.TotalCount)</p>
        <table class="table record-table">
            <caption class="visually-hidden">@Texts.Get("warehouse.powerOfAttorneys.caption")</caption>
            <thead>
                <tr>
                    @foreach (var column in grid.VisibleColumns)
                    {
                        <GridHeader Column="column" State="grid" SortChanged="SortAsync" />
                    }
                    <th scope="col" class="row-menu-cell"><span class="visually-hidden">@Texts.Get("common.actions")</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var attorney in page.Items)
                {
                    <tr>
                        @foreach (var column in grid.VisibleColumns)
                        {
                            @Cell(column, attorney)
                        }
                        <td class="row-menu-cell">
                            @if (Session.Can(WarehouseAccess.AttorneysWrite))
                            {
                                <RowMenu Label="@Texts.Get("warehouse.powerOfAttorneys.rowActions", WarehouseLabels.NameOf(partyNames, WarehouseLabels.Id(attorney, "importerPartyId")))">
                                    <button type="button" class="view-menu-item" role="menuitem" @onclick="() => Open(attorney)"><AppIcon Name="pencil" Size="16" /> <span>@Texts.Get("common.edit")</span></button>
                                </RowMenu>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager PageSizeChoice="true" Page="page.Page" PageSize="page.PageSize" TotalCount="page.TotalCount" PageChanged="LoadAsync" />
    }
</AuthGate>

@code {
    private static readonly string Url = "/api/records/" + WarehouseAccess.PowerOfAttorneyEntityKey;

    private const string AllViews = "all";
    private const string ValidView = "valid";
    private const string RevokedView = "revoked";

    // Sütunların sırası varsayılan sıradır; sıralama anahtarları kayıt deposunun beyanıdır (WarehouseRecordStore.SortKeys).
    // Taraflar (firma adı) sunucuda sıralanamaz: firma görünürlüğü sıralamayla dolanılmasın. Durum satır içi hesaplanır; sıralanamaz.
    // Varsayılan sıra başlangıç tarihine göre en yenidir.
    private static GridColumnDef[] BaseColumns =>
    [
        new("importer", Texts.Get("warehouse.importer"), "building", Locked: true),
        new("broker", Texts.Get("warehouse.broker"), "user"),
        new("validFrom", Texts.Get("warehouse.validFrom"), "calendar", "validFrom", "-validFrom"),
        new("validTo", Texts.Get("warehouse.validTo"), "calendar", "validTo", "-validTo"),
        new("status", Texts.Get("common.field.status"), "tag"),
    ];

    private readonly GridViewState grid = new("warehouse.power-of-attorneys", "-validFrom");
    private PersonalGridViews views = default!;
    private RecordPageResponse? page;
    private RecordResponse? selected;
    private readonly Dictionary<Guid, string> partyNames = [];
    private bool editing;
    private bool filtersOpen;
    private string? message;
    private string? search;
    private string view = AllViews;
    private bool validToday;
    private string? isActive;
    private Guid? importerId;
    private Guid? brokerId;

    private int ActiveFilters => (importerId is null ? 0 : 1) + (brokerId is null ? 0 : 1);

    protected override async Task OnInitializedAsync()
    {
        views = new PersonalGridViews(Api, "warehouse.power-of-attorneys");
        await Session.EnsureLoadedAsync();
        if (Session.Can(WarehouseAccess.AttorneysRead))
        {
            await Lookups.LoadAsync();
            grid.Define([.. BaseColumns, .. Lookups.FieldsOf(WarehouseAccess.PowerOfAttorneyEntityKey).Select(f => new GridColumnDef("custom." + f.Key, f.Label, "type", DefaultVisible: f.ShowInList))]);
            await views.LoadAsync();
            await LoadAsync(1);
        }
    }

    private GridViewDto? Active => views.Find(view);

    // Görünümler yalnızca süzgeçtir (Tümü, Bugün geçerli, İptal edilmiş, kişisel); taraf seçimleri "Filtrele" ile açılır. Yetki ve kapsamı sunucu uygular.
    private IReadOnlyList<ViewOption> ViewOptions =>
    [
        new(AllViews, Texts.Get("warehouse.powerOfAttorneys.view.all"), Icon: "file-text"),
        new(ValidView, Texts.Get("warehouse.powerOfAttorneys.view.valid"), Icon: "check-circle"),
        new(RevokedView, Texts.Get("warehouse.powerOfAttorneys.view.revoked"), Icon: "clock"),
        .. views.Options,
    ];

    private async Task ChooseViewAsync(string key)
    {
        view = key;
        views.StartNaming(false);
        if (Active is { } saved)
        {
            // Kişisel görünüm: sütunlar, sıralama ve süzgeç birlikte gelir. "Bugün geçerli" tarihe bağlı olduğundan bayrak olarak saklanır.
            grid.Apply(saved);
            var filters = GridFilters.Parse(saved.Filters);
            validToday = filters.GetValueOrDefault("validToday") == "true";
            isActive = filters.GetValueOrDefault("isActive");
            importerId = Guid.TryParse(filters.GetValueOrDefault("importerPartyId"), out var importer) ? importer : null;
            brokerId = Guid.TryParse(filters.GetValueOrDefault("brokerPartyId"), out var broker) ? broker : null;
        }
        else
        {
            grid.Reset();
            validToday = key == ValidView;
            isActive = key == RevokedView ? "false" : null;
            importerId = brokerId = null;
        }

        await LoadAsync(1);
    }

    private async Task ChooseImporterAsync(Guid? id)
    {
        importerId = id;
        await LoadAsync(1);
    }

    private async Task ChooseBrokerAsync(Guid? id)
    {
        brokerId = id;
        await LoadAsync(1);
    }

    private async Task SortAsync(string key)
    {
        grid.Sort = key;
        await LoadAsync(1);
    }

    // Sütun seçimi/sırası değişince veri yeniden çekilmez; olay işleyicisi sayfada olduğu için tablo yeniden çizilir.
    private Task ColumnsChanged() => Task.CompletedTask;

    private string? CurrentFilters => GridFilters.Build(
        validToday ? ("validToday", "true") : null, isActive is { } a ? ("isActive", a) : null,
        importerId is { } i ? ("importerPartyId", i.ToString()) : null, brokerId is { } b ? ("brokerPartyId", b.ToString()) : null);

    private void StartNaming() => views.StartNaming(true);

    private async Task SaveAsAsync(string name)
    {
        if (await views.SaveAsAsync(grid.ToRequest(name, CurrentFilters)) is { } key)
        {
            view = key;
        }
    }

    private async Task UpdateViewAsync()
    {
        if (Active is { } current)
        {
            await views.UpdateAsync(current, grid.ToRequest(current.Name, CurrentFilters));
        }
    }

    private async Task DiscardAsync() => await ChooseViewAsync(view);

    private async Task DeleteViewAsync()
    {
        if (Active is { } current && await views.DeleteAsync(current))
        {
            await ChooseViewAsync(AllViews);
        }
    }

    private async Task LoadAsync(int pageNumber)
    {
        var url = $"{Url}?page={pageNumber}&pageSize={ListPaging.Size}&search={Uri.EscapeDataString(search ?? string.Empty)}";
        if (grid.Sort != grid.DefaultSort)
        {
            url += $"&sort={Uri.EscapeDataString(grid.Sort)}";
        }

        if (validToday)
        {
            url += $"&validOn={DateOnly.FromDateTime(DateTime.Today):yyyy-MM-dd}";
        }

        if (isActive is { } active)
        {
            url += $"&isActive={Uri.EscapeDataString(active)}";
        }

        if (importerId is { } importer)
        {
            url += $"&importerPartyId={importer}";
        }

        if (brokerId is { } broker)
        {
            url += $"&brokerPartyId={broker}";
        }

        var result = await Api.GetAsync<RecordPageResponse>(url);
        page = result.Value;
        message = result.Error;
        if (page is not null)
        {
            var ids = page.Items.SelectMany(a => new[] { WarehouseLabels.Id(a, "importerPartyId"), WarehouseLabels.Id(a, "brokerPartyId") })
                .OfType<Guid>();
            await WarehouseLabels.ResolveNamesAsync(Api, WarehouseAccess.AttorneyImporterLookup, ids, partyNames);
        }
    }

    private RenderFragment Cell(GridColumnDef column, RecordResponse attorney) => @<td data-label="@column.Label" class="@(column.Key == "importer" ? "primary" : null)">@CellContent(column.Key, attorney)</td>;

    private RenderFragment CellContent(string key, RecordResponse attorney) => key switch
    {
        "importer" => @<text>@WarehouseLabels.NameOf(partyNames, WarehouseLabels.Id(attorney, "importerPartyId"))</text>,
        "broker" => @<text>@WarehouseLabels.NameOf(partyNames, WarehouseLabels.Id(attorney, "brokerPartyId"))</text>,
        "validFrom" => @<text>@Display(WarehouseLabels.Text(attorney, "validFrom"))</text>,
        "validTo" => @<text>@(WarehouseLabels.Text(attorney, "validTo") is { Length: > 0 } to ? Display(to) : Texts.Get("warehouse.openEnded"))</text>,
        "status" => StatusBadge(attorney),
        _ when key.StartsWith("custom.", StringComparison.Ordinal) && Lookups.FieldsOf(WarehouseAccess.PowerOfAttorneyEntityKey).FirstOrDefault(f => "custom." + f.Key == key) is { } field =>
            @<text>@CustomFieldText.Format(field, attorney.Values["custom"] as JsonObject)</text>,
        _ => @<text></text>,
    };

    private static RenderFragment StatusBadge(RecordResponse attorney)
    {
        var (label, badge) = Status(attorney);
        return @<span class="badge @badge">@label</span>;
    }

    // Durum gösterimi: iptal edilmiş, başlamamış, süresi dolmuş ya da geçerli. Tek doğru kaynak sunucudaki geçerlilik süzgecidir;
    // burada yalnızca satır rozeti için aynı kural bugünün tarihiyle uygulanır.
    private static (string Label, string Badge) Status(RecordResponse attorney)
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        if (!WarehouseLabels.Flag(attorney, "isActive", true))
        {
            return (Texts.Get("warehouse.attorneyStatus.revoked"), "status-inactive");
        }

        if (DateOnly.TryParseExact(WarehouseLabels.Text(attorney, "validFrom"), "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var from) && from > today)
        {
            return (Texts.Get("warehouse.attorneyStatus.notStarted"), "stage-qualified");
        }

        if (DateOnly.TryParseExact(WarehouseLabels.Text(attorney, "validTo"), "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var to) && to < today)
        {
            return (Texts.Get("warehouse.attorneyStatus.expired"), "status-inactive");
        }

        return (Texts.Get("warehouse.attorneyStatus.valid"), "status-customer");
    }

    private static string Display(string isoDate) =>
        DateOnly.TryParseExact(isoDate, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var date)
            ? date.ToString("d", CultureInfo.GetCultureInfo("tr-TR"))
            : isoDate;

    private void Open(RecordResponse? attorney)
    {
        selected = attorney;
        editing = true;
        message = null;
    }

    private void Close() => editing = false;

    private async Task SavedAsync()
    {
        editing = false;
        await LoadAsync(page?.Page ?? 1);
    }
}
