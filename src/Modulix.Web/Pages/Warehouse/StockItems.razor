@page "/depo/stok-kartlari"
@using System.Text.Json.Nodes
@inject ApiClient Api
@inject SessionState Session
@inject CrmLookups Lookups

<PageTitle>Stok kartları · Modulix</PageTitle>

<AuthGate Module="@WarehouseAccess.ModuleKey" Permission="@WarehouseAccess.StockItemsRead">
    <PageHeader Title="Stok kartları" Icon="package" Subtitle="@(page is null ? "Depoda tutulan malların kodunu, birimini ve varsayılan GTİP'ini yönetin." : $"{page.TotalCount} kayıt")" />

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }

    @if (editing)
    {
        <StockItemEditor Item="selected" Lookups="Lookups" Saved="SavedAsync" Deleted="SavedAsync" Cancelled="Close" />
    }

    @* Görünümler sunucuda süzgeç olarak uygulanır; sayfalama ve toplam doğru kalır. *@
    <ViewTabs Items="ViewOptions" Value="@view" ValueChanged="ChooseViewAsync" Label="Stok kartı görünümleri" NewView="StartNaming" NewViewText="Görünüm" />

    <div class="list-toolbar">
        <form class="search" @onsubmit="() => LoadAsync(1)" @onsubmit:preventDefault>
            <input class="form-control" type="search" aria-label="Stok kartı ara" placeholder="Kod, ad veya GTİP ara" @bind="search" />
        </form>
        <FilterToggle @bind-Open="filtersOpen" Count="ActiveFilters" />
        <GridColumnPicker State="grid" Changed="ColumnsChanged" />
        @if (Session.Can(WarehouseAccess.StockItemsWrite) && !editing)
        {
            <button type="button" class="btn btn-primary" @onclick="() => Open(null)"><AppIcon Name="plus" Size="16" /> Yeni stok kartı</button>
        }
    </div>

    @if (filtersOpen || ActiveFilters > 0)
    {
        <div class="filters">
            <select class="form-select" aria-label="Birim" @bind="unitKey" @bind:after="() => LoadAsync(1)">
                <option value="">Tüm birimler</option>
                @foreach (var unit in Lookups.ValuesOf(WarehouseAccess.StockUnitList))
                {
                    <option value="@unit.Key">@unit.Label</option>
                }
            </select>
            <input class="form-control" aria-label="GTİP ön eki" inputmode="numeric" maxlength="14" placeholder="GTİP ön eki (ör. 0902)" @bind="gtipPrefix" @bind:after="() => LoadAsync(1)" @bind:event="onchange" />
        </div>
    }

    <PersonalViewBar Active="Active" Dirty="grid.Differs(Active)" Naming="views.Naming" NamingChanged="views.StartNaming" Error="@views.Error"
                     SaveAs="SaveAsAsync" UpdateView="UpdateViewAsync" DiscardChanges="DiscardAsync" DeleteView="DeleteViewAsync" />

    @if (page is null)
    {
        <LoadingState Kind="LoadingKind.Table" />
    }
    else if (page.Items.Count == 0)
    {
        <p class="text-muted" role="status">Bu görünüme uyan stok kartı yok.</p>
    }
    else
    {
        <p class="visually-hidden" role="status" aria-live="polite">@(page.TotalCount) stok kartı listelendi.</p>
        <table class="table record-table">
            <caption class="visually-hidden">Stok kartı listesi</caption>
            <thead>
                <tr>
                    @foreach (var column in grid.VisibleColumns)
                    {
                        <GridHeader Column="column" State="grid" SortChanged="SortAsync" />
                    }
                    <th scope="col" class="row-menu-cell"><span class="visually-hidden">Eylemler</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in page.Items)
                {
                    <tr>
                        @foreach (var column in grid.VisibleColumns)
                        {
                            @Cell(column, item)
                        }
                        <td class="row-menu-cell">
                            @if (Session.Can(WarehouseAccess.StockItemsWrite))
                            {
                                <RowMenu Label="@($"{WarehouseLabels.Text(item, "code")} eylemleri")">
                                    <button type="button" class="view-menu-item" role="menuitem" @onclick="() => Open(item)"><AppIcon Name="pencil" Size="16" /> <span>Düzenle</span></button>
                                </RowMenu>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager PageSizeChoice="true" Page="page.Page" PageSize="page.PageSize" TotalCount="page.TotalCount" PageChanged="LoadAsync" />
    }
</AuthGate>

@code {
    private static readonly string Url = "/api/records/" + WarehouseAccess.StockItemEntityKey;

    private const string AllViews = "all";
    private const string ActiveView = "active";
    private const string InactiveView = "inactive";

    // Sütunların sırası varsayılan sıradır; sıralama anahtarları kayıt deposunun beyanıdır (WarehouseRecordStore.SortKeys).
    private static readonly GridColumnDef[] BaseColumns =
    [
        new("code", "Kod", "hash", "code", "-code", Locked: true),
        new("name", "Ad", "type", "name", "-name"),
        new("unitKey", "Birim", "package", "unitKey", "-unitKey"),
        new("gtip", "GTİP", "list", "gtip", "-gtip"),
        new("isActive", "Durum", "tag", "isActive", "-isActive"),
    ];

    private readonly GridViewState grid = new("warehouse.stock-items", "code");
    private PersonalGridViews views = default!;
    private RecordPageResponse? page;
    private RecordResponse? selected;
    private bool editing;
    private bool filtersOpen;
    private string? message;
    private string? search;
    private string view = AllViews;
    private string? isActive;
    private string unitKey = "";
    private string gtipPrefix = "";

    private int ActiveFilters => (unitKey.Length > 0 ? 1 : 0) + (string.IsNullOrWhiteSpace(gtipPrefix) ? 0 : 1);

    protected override async Task OnInitializedAsync()
    {
        views = new PersonalGridViews(Api, "warehouse.stock-items");
        await Session.EnsureLoadedAsync();
        if (Session.Can(WarehouseAccess.StockItemsRead))
        {
            await Lookups.LoadAsync();
            grid.Define([.. BaseColumns, .. Lookups.FieldsOf(WarehouseAccess.StockItemEntityKey).Select(f => new GridColumnDef("custom." + f.Key, f.Label, "type", DefaultVisible: f.ShowInList))]);
            await views.LoadAsync();
            await LoadAsync(1);
        }
    }

    private GridViewDto? Active => views.Find(view);

    // Görünümler yalnızca süzgeçtir (Tümü, Etkin, Pasif, kişisel); birim ve GTİP ön eki "Filtrele" ile açılır. Yetki ve kapsamı sunucu uygular.
    private IReadOnlyList<ViewOption> ViewOptions =>
    [
        new(AllViews, "Tüm stok kartları", Icon: "package"),
        new(ActiveView, "Etkin kartlar", Icon: "check-circle"),
        new(InactiveView, "Pasif kartlar", Icon: "clock"),
        .. views.Options,
    ];

    private async Task ChooseViewAsync(string key)
    {
        view = key;
        views.StartNaming(false);
        if (Active is { } saved)
        {
            // Kişisel görünüm: sütunlar, sıralama ve süzgeç birlikte gelir.
            grid.Apply(saved);
            var filters = GridFilters.Parse(saved.Filters);
            isActive = filters.GetValueOrDefault("isActive");
            unitKey = filters.GetValueOrDefault("unitKey") ?? "";
            gtipPrefix = filters.GetValueOrDefault("gtip") ?? "";
        }
        else
        {
            grid.Reset();
            isActive = key switch { ActiveView => "true", InactiveView => "false", _ => null };
            unitKey = gtipPrefix = "";
        }

        await LoadAsync(1);
    }

    private async Task SortAsync(string key)
    {
        grid.Sort = key;
        await LoadAsync(1);
    }

    // Sütun seçimi/sırası değişince veri yeniden çekilmez; olay işleyicisi sayfada olduğu için tablo yeniden çizilir.
    private Task ColumnsChanged() => Task.CompletedTask;

    private string? CurrentFilters => GridFilters.Build(
        isActive is { } a ? ("isActive", a) : null, ("unitKey", unitKey), ("gtip", gtipPrefix.Trim()));

    private void StartNaming() => views.StartNaming(true);

    private async Task SaveAsAsync(string name)
    {
        if (await views.SaveAsAsync(grid.ToRequest(name, CurrentFilters)) is { } key)
        {
            view = key;
        }
    }

    private async Task UpdateViewAsync()
    {
        if (Active is { } current)
        {
            await views.UpdateAsync(current, grid.ToRequest(current.Name, CurrentFilters));
        }
    }

    private async Task DiscardAsync() => await ChooseViewAsync(view);

    private async Task DeleteViewAsync()
    {
        if (Active is { } current && await views.DeleteAsync(current))
        {
            await ChooseViewAsync(AllViews);
        }
    }

    private async Task LoadAsync(int pageNumber)
    {
        var url = $"{Url}?page={pageNumber}&pageSize={ListPaging.Size}&search={Uri.EscapeDataString(search ?? string.Empty)}";
        if (grid.Sort != grid.DefaultSort)
        {
            url += $"&sort={Uri.EscapeDataString(grid.Sort)}";
        }

        if (isActive is { } active)
        {
            url += $"&isActive={Uri.EscapeDataString(active)}";
        }

        if (unitKey.Length > 0)
        {
            url += $"&unitKey={Uri.EscapeDataString(unitKey)}";
        }

        if (!string.IsNullOrWhiteSpace(gtipPrefix))
        {
            url += $"&gtip={Uri.EscapeDataString(gtipPrefix.Trim())}";
        }

        var result = await Api.GetAsync<RecordPageResponse>(url);
        page = result.Value;
        message = result.Error;
    }

    private RenderFragment Cell(GridColumnDef column, RecordResponse item) => @<td data-label="@column.Label" class="@(column.Key == "code" ? "primary" : null)">@CellContent(column.Key, item)</td>;

    private RenderFragment CellContent(string key, RecordResponse item) => key switch
    {
        "code" => @<text>@WarehouseLabels.Text(item, "code")</text>,
        "name" => @<text>@WarehouseLabels.Text(item, "name")</text>,
        "unitKey" => @<text>@Lookups.Label(WarehouseAccess.StockUnitList, WarehouseLabels.Text(item, "unitKey"))</text>,
        "gtip" => @<text>@(WarehouseLabels.Text(item, "gtip") is { Length: > 0 } gtip ? gtip : "—")</text>,
        "isActive" => @<span class="badge @WarehouseLabels.ActiveBadge(WarehouseLabels.Flag(item, "isActive"))">@(WarehouseLabels.Flag(item, "isActive") ? "Etkin" : "Pasif")</span>,
        _ when key.StartsWith("custom.", StringComparison.Ordinal) && Lookups.FieldsOf(WarehouseAccess.StockItemEntityKey).FirstOrDefault(f => "custom." + f.Key == key) is { } field =>
            @<text>@CustomFieldText.Format(field, item.Values["custom"] as JsonObject)</text>,
        _ => @<text></text>,
    };

    private void Open(RecordResponse? item)
    {
        selected = item;
        editing = true;
        message = null;
    }

    private void Close() => editing = false;

    private async Task SavedAsync()
    {
        editing = false;
        await LoadAsync(page?.Page ?? 1);
    }
}
