@page "/depo/tesisler"
@using System.Text.Json.Nodes
@inject ApiClient Api
@inject SessionState Session
@inject CrmLookups Lookups

<PageTitle>@Texts.Get("nav.app.warehouse.facilities") · Modulix</PageTitle>

<AuthGate Module="@WarehouseAccess.ModuleKey" Permission="@WarehouseAccess.FacilitiesRead">
    <PageHeader Title="@Texts.Get("nav.app.warehouse.facilities")" Icon="warehouse" Subtitle="@(page is null ? Texts.Get("warehouse.facilities.intro") : Texts.Get("common.records", page.TotalCount))" />

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }

    @if (editing)
    {
        <FacilityEditor Facility="selected" Lookups="Lookups" Saved="SavedAsync" Deleted="SavedAsync" Cancelled="Close" />
    }

    @* Görünümler sunucuda süzgeç olarak uygulanır; sayfalama ve toplam doğru kalır. *@
    <ViewTabs Items="ViewOptions" Value="@view" ValueChanged="ChooseViewAsync" Label="@Texts.Get("warehouse.facilities.views")" NewView="StartNaming" />

    <div class="list-toolbar">
        <form class="search" @onsubmit="() => LoadAsync(1)" @onsubmit:preventDefault>
            <input class="form-control" type="search" aria-label="@Texts.Get("warehouse.facilities.search")" placeholder="@Texts.Get("warehouse.searchCodeOrName")" @bind="search" />
        </form>
        <GridColumnPicker State="grid" Changed="ColumnsChanged" />
        @if (Session.Can(WarehouseAccess.FacilitiesWrite) && !editing)
        {
            <button type="button" class="btn btn-primary" @onclick="() => Open(null)"><AppIcon Name="plus" Size="16" /> @Texts.Get("warehouse.facilities.new")</button>
        }
    </div>

    <PersonalViewBar Active="Active" Dirty="grid.Differs(Active)" Naming="views.Naming" NamingChanged="views.StartNaming" Error="@views.Error"
                     SaveAs="SaveAsAsync" UpdateView="UpdateViewAsync" DiscardChanges="DiscardAsync" DeleteView="DeleteViewAsync" />

    @if (page is null)
    {
        <LoadingState Kind="LoadingKind.Table" />
    }
    else if (page.Items.Count == 0)
    {
        <p class="text-muted" role="status">@Texts.Get("warehouse.facilities.empty")</p>
    }
    else
    {
        <p class="visually-hidden" role="status" aria-live="polite">@Texts.Get("warehouse.facilities.listed", page.TotalCount)</p>
        <table class="table record-table">
            <caption class="visually-hidden">@Texts.Get("warehouse.facilities.caption")</caption>
            <thead>
                <tr>
                    @foreach (var column in grid.VisibleColumns)
                    {
                        <GridHeader Column="column" State="grid" SortChanged="SortAsync" />
                    }
                    <th scope="col" class="row-menu-cell"><span class="visually-hidden">@Texts.Get("common.actions")</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var facility in page.Items)
                {
                    <tr>
                        @foreach (var column in grid.VisibleColumns)
                        {
                            @Cell(column, facility)
                        }
                        <td class="row-menu-cell">
                            @if (Session.Can(WarehouseAccess.FacilitiesWrite))
                            {
                                <RowMenu Label="@Texts.Get("common.rowActionsOf", WarehouseLabels.Text(facility, "code"))">
                                    <button type="button" class="view-menu-item" role="menuitem" @onclick="() => Open(facility)"><AppIcon Name="pencil" Size="16" /> <span>@Texts.Get("common.edit")</span></button>
                                </RowMenu>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager PageSizeChoice="true" Page="page.Page" PageSize="page.PageSize" TotalCount="page.TotalCount" PageChanged="LoadAsync" />
    }
</AuthGate>

@code {
    private static readonly string Url = "/api/records/" + WarehouseAccess.FacilityEntityKey;

    private const string AllViews = "all";
    private const string ActiveView = "active";
    private const string InactiveView = "inactive";
    private const string CustomsView = "customs";

    // Sütunların sırası varsayılan sıradır; sıralama anahtarları kayıt deposunun beyanıdır (WarehouseRecordStore.SortKeys).
    private static GridColumnDef[] BaseColumns =>
    [
        new("code", Texts.Get("warehouse.code"), "hash", "code", "-code", Locked: true),
        new("name", Texts.Get("common.field.name"), "type", "name", "-name"),
        new("countryCode", Texts.Get("warehouse.country"), "globe", "countryCode", "-countryCode"),
        new("customsEnabled", Texts.Get("warehouse.customsExtension"), "landmark", "customsEnabled", "-customsEnabled"),
        new("isActive", Texts.Get("common.field.status"), "tag", "isActive", "-isActive"),
    ];

    private readonly GridViewState grid = new("warehouse.facilities", "code");
    private PersonalGridViews views = default!;
    private RecordPageResponse? page;
    private RecordResponse? selected;
    private bool editing;
    private string? message;
    private string? search;
    private string view = AllViews;
    private string? isActive;
    private string? customsEnabled;

    protected override async Task OnInitializedAsync()
    {
        views = new PersonalGridViews(Api, "warehouse.facilities");
        await Session.EnsureLoadedAsync();
        if (Session.Can(WarehouseAccess.FacilitiesRead))
        {
            await Lookups.LoadAsync();
            grid.Define([.. BaseColumns, .. Lookups.FieldsOf(WarehouseAccess.FacilityEntityKey).Select(f => new GridColumnDef("custom." + f.Key, f.Label, "type", DefaultVisible: f.ShowInList))]);
            await views.LoadAsync();
            await LoadAsync(1);
        }
    }

    private GridViewDto? Active => views.Find(view);

    // Görünümler yalnızca süzgeçtir (Tümü, Etkin, Pasif, Gümrük uzantılı, kişisel); yetki ve kapsamı sunucu uygular.
    private IReadOnlyList<ViewOption> ViewOptions =>
    [
        new(AllViews, Texts.Get("warehouse.allFacilities"), Icon: "warehouse"),
        new(ActiveView, Texts.Get("warehouse.facilities.view.active"), Icon: "check-circle"),
        new(InactiveView, Texts.Get("warehouse.facilities.view.inactive"), Icon: "clock"),
        new(CustomsView, Texts.Get("warehouse.facilities.view.customs"), Icon: "landmark"),
        .. views.Options,
    ];

    private async Task ChooseViewAsync(string key)
    {
        view = key;
        views.StartNaming(false);
        if (Active is { } saved)
        {
            // Kişisel görünüm: sütunlar, sıralama ve süzgeç birlikte gelir.
            grid.Apply(saved);
            var filters = GridFilters.Parse(saved.Filters);
            isActive = filters.GetValueOrDefault("isActive");
            customsEnabled = filters.GetValueOrDefault("customsEnabled");
        }
        else
        {
            grid.Reset();
            isActive = key switch { ActiveView => "true", InactiveView => "false", _ => null };
            customsEnabled = key == CustomsView ? "true" : null;
        }

        await LoadAsync(1);
    }

    private async Task SortAsync(string key)
    {
        grid.Sort = key;
        await LoadAsync(1);
    }

    // Sütun seçimi/sırası değişince veri yeniden çekilmez; olay işleyicisi sayfada olduğu için tablo yeniden çizilir.
    private Task ColumnsChanged() => Task.CompletedTask;

    private string? CurrentFilters => GridFilters.Build(
        isActive is { } a ? ("isActive", a) : null, customsEnabled is { } c ? ("customsEnabled", c) : null);

    private void StartNaming() => views.StartNaming(true);

    private async Task SaveAsAsync(string name)
    {
        if (await views.SaveAsAsync(grid.ToRequest(name, CurrentFilters)) is { } key)
        {
            view = key;
        }
    }

    private async Task UpdateViewAsync()
    {
        if (Active is { } current)
        {
            await views.UpdateAsync(current, grid.ToRequest(current.Name, CurrentFilters));
        }
    }

    private async Task DiscardAsync() => await ChooseViewAsync(view);

    private async Task DeleteViewAsync()
    {
        if (Active is { } current && await views.DeleteAsync(current))
        {
            await ChooseViewAsync(AllViews);
        }
    }

    private async Task LoadAsync(int pageNumber)
    {
        var url = $"{Url}?page={pageNumber}&pageSize={ListPaging.Size}&search={Uri.EscapeDataString(search ?? string.Empty)}";
        if (grid.Sort != grid.DefaultSort)
        {
            url += $"&sort={Uri.EscapeDataString(grid.Sort)}";
        }

        if (isActive is { } a)
        {
            url += $"&isActive={Uri.EscapeDataString(a)}";
        }

        if (customsEnabled is { } c)
        {
            url += $"&customsEnabled={Uri.EscapeDataString(c)}";
        }

        var result = await Api.GetAsync<RecordPageResponse>(url);
        page = result.Value;
        message = result.Error;
    }

    private RenderFragment Cell(GridColumnDef column, RecordResponse facility) => @<td data-label="@column.Label" class="@(column.Key == "code" ? "primary" : null)">@CellContent(column.Key, facility)</td>;

    private RenderFragment CellContent(string key, RecordResponse facility) => key switch
    {
        "code" => @<text>@WarehouseLabels.Text(facility, "code")</text>,
        "name" => @<text>@WarehouseLabels.Text(facility, "name")</text>,
        "countryCode" => @<text>@WarehouseLabels.Text(facility, "countryCode")</text>,
        "customsEnabled" => @<span class="badge @WarehouseLabels.ActiveBadge(WarehouseLabels.Flag(facility, "customsEnabled"))">@WarehouseLabels.OnOffText(WarehouseLabels.Flag(facility, "customsEnabled"))</span>,
        "isActive" => @<span class="badge @WarehouseLabels.ActiveBadge(WarehouseLabels.Flag(facility, "isActive"))">@WarehouseLabels.ActiveText(WarehouseLabels.Flag(facility, "isActive"))</span>,
        _ when key.StartsWith("custom.", StringComparison.Ordinal) && Lookups.FieldsOf(WarehouseAccess.FacilityEntityKey).FirstOrDefault(f => "custom." + f.Key == key) is { } field =>
            @<text>@CustomFieldText.Format(field, facility.Values["custom"] as JsonObject)</text>,
        _ => @<text></text>,
    };

    private void Open(RecordResponse? facility)
    {
        selected = facility;
        editing = true;
        message = null;
    }

    private void Close() => editing = false;

    private async Task SavedAsync()
    {
        editing = false;
        await LoadAsync(page?.Page ?? 1);
    }
}
