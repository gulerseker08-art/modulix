@page "/depo/lokasyon-seviyeleri"
@inject ApiClient Api
@inject SessionState Session

<PageTitle>@Texts.Get("nav.app.warehouse.location-levels") · Modulix</PageTitle>

<AuthGate Module="@WarehouseAccess.ModuleKey" Permission="@WarehouseAccess.LocationLevelsRead">
    <PageHeader Title="@Texts.Get("nav.app.warehouse.location-levels")" Icon="sliders" Subtitle="@(page is null ? Texts.Get("warehouse.locationLevels.intro") : Texts.Get("common.records", page.TotalCount))" />

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }

    @if (form is not null)
    {
        @* Ayar niteliğinde küçük kayıt formu: tek bölümlü, FormTabs ile sekmeli (docs/design-system/form-standards.md). *@
        <form class="record-form" novalidate @onsubmit="SaveAsync" @onsubmit:preventDefault>
            <h2>@(form.Id is null ? Texts.Get("warehouse.locationLevels.new") : Texts.Get("warehouse.locationLevels.edit"))</h2>
            <FormTabs Title="@Texts.Get("warehouse.locationLevels.formTitle")" Label="@Texts.Get("warehouse.locationLevels.tabs")">
                <div class="form-grid">
                    <div class="span-6">
                        <label class="form-label required" for="level-facility">@Texts.Get("warehouse.facility")</label>
                        <LookupPicker Id="level-facility" LookupKey="@WarehouseAccess.LocationLevelFacilityLookup" @bind-Value="form.FacilityId" Required="true" Disabled="@(form.Id is not null)" Placeholder="@Texts.Get("warehouse.chooseFacility")" Invalid="@(errors?.ContainsKey("facilityId") == true)" />
                        <FieldError Field="facilityId" Errors="errors" />
                    </div>
                    <div class="span-3">
                        <label class="form-label required" for="level-position">@Texts.Get("warehouse.locationLevels.position")</label>
                        <input id="level-position" class="form-control" type="number" min="1" max="10" required aria-required="true" @bind="form.Position" />
                        <FieldError Field="position" Errors="errors" />
                        <small class="text-muted">@Texts.Get("warehouse.locationLevels.positionHelp")</small>
                    </div>
                    <div class="span-3">
                        <label class="form-label required" for="level-key">@Texts.Get("warehouse.locationLevels.key")</label>
                        <input id="level-key" class="form-control" maxlength="30" required aria-required="true" @bind="form.Key" />
                        <FieldError Field="key" Errors="errors" />
                        <small class="text-muted">@Texts.Get("warehouse.locationLevels.keyHelp")</small>
                    </div>
                    <div class="span-6">
                        <label class="form-label required" for="level-name">@Texts.Get("common.field.name")</label>
                        <input id="level-name" class="form-control" maxlength="100" required aria-required="true" @bind="form.Name" />
                        <FieldError Field="name" Errors="errors" />
                    </div>
                    <div class="span-6">
                        <label class="form-label" for="level-set">@Texts.Get("warehouse.locationLevels.characterSet")</label>
                        <select id="level-set" class="form-select" @bind="form.CharacterSet">
                            @foreach (var (key, label) in WarehouseLabels.CharacterSets)
                            {
                                <option value="@key">@label</option>
                            }
                        </select>
                        <FieldError Field="characterSet" Errors="errors" />
                    </div>
                    <div class="span-3">
                        <label class="form-label" for="level-min">@Texts.Get("warehouse.locationLevels.minLength")</label>
                        <input id="level-min" class="form-control" type="number" min="1" max="20" @bind="form.MinLength" />
                        <FieldError Field="minLength" Errors="errors" />
                    </div>
                    <div class="span-3">
                        <label class="form-label" for="level-max">@Texts.Get("warehouse.locationLevels.maxLength")</label>
                        <input id="level-max" class="form-control" type="number" min="1" max="20" @bind="form.MaxLength" />
                        <FieldError Field="maxLength" Errors="errors" />
                    </div>
                    <div class="span-6">
                        <label class="form-label" for="level-separator">@Texts.Get("warehouse.locationLevels.separator")</label>
                        <input id="level-separator" class="form-control" maxlength="3" @bind="form.Separator" />
                        <FieldError Field="separator" Errors="errors" />
                        <small class="text-muted">@Texts.Get("warehouse.locationLevels.separatorHelp")</small>
                    </div>
                </div>
            </FormTabs>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary" disabled="@busy">@Texts.Get("common.save")</button>
                <button type="button" class="btn btn-outline-secondary" @onclick="() => form = null">@Texts.Get("common.dismiss")</button>
                @if (form.Id is not null)
                {
                    <button type="button" class="btn btn-outline-danger ms-auto" disabled="@busy" @onclick="DeleteAsync">@Texts.Get("common.delete")</button>
                }
            </div>
            @if (form.Id is not null)
            {
                <p class="small text-muted">@Texts.Get("warehouse.locationLevels.lockedNote")</p>
            }
        </form>
    }

    @* Tek görünüm vardır (tüm seviyeler); tesis seçimi "Filtrele" ile açılır. Kişisel görünümler sütun, sıralama ve tesis süzgecini saklar. *@
    <ViewTabs Items="ViewOptions" Value="@view" ValueChanged="ChooseViewAsync" Label="@Texts.Get("warehouse.locationLevels.views")" NewView="StartNaming" />

    <div class="list-toolbar">
        <form class="search" @onsubmit="() => LoadAsync(1)" @onsubmit:preventDefault>
            <input class="form-control" type="search" aria-label="@Texts.Get("warehouse.locationLevels.search")" placeholder="@Texts.Get("warehouse.locationLevels.searchPlaceholder")" @bind="search" />
        </form>
        <FilterToggle @bind-Open="filtersOpen" Count="@(string.IsNullOrEmpty(facilityId) ? 0 : 1)" />
        <GridColumnPicker State="grid" Changed="ColumnsChanged" />
        @if (Session.Can(WarehouseAccess.LocationLevelsWrite) && form is null)
        {
            <button type="button" class="btn btn-primary" @onclick="NewLevel"><AppIcon Name="plus" Size="16" /> @Texts.Get("warehouse.locationLevels.new")</button>
        }
    </div>

    @if (filtersOpen || !string.IsNullOrEmpty(facilityId))
    {
        <div class="filters">
            <select class="form-select" aria-label="@Texts.Get("warehouse.facility")" @bind="facilityId" @bind:after="() => LoadAsync(1)">
                <option value="">@Texts.Get("warehouse.allFacilities")</option>
                @foreach (var (id, name) in facilities.OrderBy(f => f.Value, StringComparer.CurrentCulture))
                {
                    <option value="@id">@name</option>
                }
            </select>
        </div>
    }

    <PersonalViewBar Active="Active" Dirty="grid.Differs(Active)" Naming="views.Naming" NamingChanged="views.StartNaming" Error="@views.Error"
                     SaveAs="SaveAsAsync" UpdateView="UpdateViewAsync" DiscardChanges="DiscardAsync" DeleteView="DeleteViewAsync" />

    @if (page is null)
    {
        <LoadingState Kind="LoadingKind.Table" />
    }
    else if (page.Items.Count == 0)
    {
        <p class="text-muted" role="status">@Texts.Get("warehouse.locationLevels.empty")</p>
    }
    else
    {
        <table class="table record-table">
            <caption class="visually-hidden">@Texts.Get("warehouse.locationLevels.caption")</caption>
            <thead>
                <tr>
                    @foreach (var column in grid.VisibleColumns)
                    {
                        <GridHeader Column="column" State="grid" SortChanged="SortAsync" />
                    }
                    <th scope="col" class="row-menu-cell"><span class="visually-hidden">@Texts.Get("common.actions")</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var level in page.Items)
                {
                    <tr>
                        @foreach (var column in grid.VisibleColumns)
                        {
                            @Cell(column, level)
                        }
                        <td class="row-menu-cell">
                            @if (Session.Can(WarehouseAccess.LocationLevelsWrite))
                            {
                                <RowMenu Label="@Texts.Get("common.rowActionsOf", WarehouseLabels.Text(level, "name"))">
                                    <button type="button" class="view-menu-item" role="menuitem" @onclick="() => Edit(level)"><AppIcon Name="pencil" Size="16" /> <span>@Texts.Get("common.edit")</span></button>
                                </RowMenu>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager PageSizeChoice="true" Page="page.Page" PageSize="page.PageSize" TotalCount="page.TotalCount" PageChanged="LoadAsync" />
    }
</AuthGate>

@code {
    private static readonly string Url = "/api/records/" + WarehouseAccess.LocationLevelEntityKey;

    private const string AllViews = "all";

    // Sütunların sırası varsayılan sıradır; sıralama anahtarları kayıt deposunun beyanıdır (WarehouseRecordStore.SortKeys).
    // Varsayılan sıra tesis koduna, sonra seviye sırasına göredir.
    private static GridColumnDef[] BaseColumns =>
    [
        new("facility", Texts.Get("warehouse.facility"), "warehouse", "facility", "-facility", Locked: true),
        new("position", Texts.Get("warehouse.locationLevels.position"), "hash", "position", "-position"),
        new("name", Texts.Get("common.field.name"), "type", "name", "-name"),
        new("key", Texts.Get("warehouse.locationLevels.key"), "key", "key", "-key"),
        new("characterSet", Texts.Get("warehouse.locationLevels.col.characterSet"), "list", "characterSet", "-characterSet"),
        new("length", Texts.Get("warehouse.locationLevels.col.length"), "sliders", "maxLength", "-maxLength"),
        new("separator", Texts.Get("warehouse.locationLevels.separator"), "tag", "separator", "-separator"),
    ];

    private readonly GridViewState grid = new("warehouse.location-levels", "facility");
    private PersonalGridViews views = default!;
    private RecordPageResponse? page;
    private Dictionary<Guid, string> facilities = [];
    private LevelForm? form;
    private IReadOnlyDictionary<string, string[]>? errors;
    private string? message;
    private string? search;
    private string facilityId = "";
    private string view = AllViews;
    private bool filtersOpen;
    private bool busy;

    protected override async Task OnInitializedAsync()
    {
        views = new PersonalGridViews(Api, "warehouse.location-levels");
        await Session.EnsureLoadedAsync();
        if (Session.Can(WarehouseAccess.LocationLevelsRead))
        {
            facilities = await WarehouseLabels.NamesAsync(Api, WarehouseAccess.FacilityEntityKey, f => WarehouseLabels.Text(f, "code") + " · " + WarehouseLabels.Text(f, "name"));
            grid.Define(BaseColumns);
            await views.LoadAsync();
            await LoadAsync(1);
        }
    }

    private GridViewDto? Active => views.Find(view);

    private IReadOnlyList<ViewOption> ViewOptions =>
    [
        new(AllViews, Texts.Get("warehouse.locationLevels.view.all"), Icon: "sliders"),
        .. views.Options,
    ];

    private async Task ChooseViewAsync(string key)
    {
        view = key;
        views.StartNaming(false);
        if (Active is { } saved)
        {
            // Kişisel görünüm: sütunlar, sıralama ve süzgeç birlikte gelir.
            grid.Apply(saved);
            facilityId = GridFilters.Parse(saved.Filters).GetValueOrDefault("facilityId") ?? "";
        }
        else
        {
            grid.Reset();
            facilityId = "";
        }

        await LoadAsync(1);
    }

    private async Task SortAsync(string key)
    {
        grid.Sort = key;
        await LoadAsync(1);
    }

    // Sütun seçimi/sırası değişince veri yeniden çekilmez; olay işleyicisi sayfada olduğu için tablo yeniden çizilir.
    private Task ColumnsChanged() => Task.CompletedTask;

    private string? CurrentFilters => GridFilters.Build(("facilityId", facilityId));

    private void StartNaming() => views.StartNaming(true);

    private async Task SaveAsAsync(string name)
    {
        if (await views.SaveAsAsync(grid.ToRequest(name, CurrentFilters)) is { } key)
        {
            view = key;
        }
    }

    private async Task UpdateViewAsync()
    {
        if (Active is { } current)
        {
            await views.UpdateAsync(current, grid.ToRequest(current.Name, CurrentFilters));
        }
    }

    private async Task DiscardAsync() => await ChooseViewAsync(view);

    private async Task DeleteViewAsync()
    {
        if (Active is { } current && await views.DeleteAsync(current))
        {
            await ChooseViewAsync(AllViews);
        }
    }

    private async Task LoadAsync(int pageNumber)
    {
        var url = $"{Url}?page={pageNumber}&pageSize={ListPaging.Size}&search={Uri.EscapeDataString(search ?? string.Empty)}";
        if (grid.Sort != grid.DefaultSort)
        {
            url += $"&sort={Uri.EscapeDataString(grid.Sort)}";
        }

        if (facilityId.Length > 0)
        {
            url += $"&facilityId={Uri.EscapeDataString(facilityId)}";
        }

        var result = await Api.GetAsync<RecordPageResponse>(url);
        page = result.Value;
        message = result.Error;
    }

    private RenderFragment Cell(GridColumnDef column, RecordResponse level) => @<td data-label="@column.Label" class="@(column.Key == "facility" ? "primary" : null)">@CellContent(column.Key, level)</td>;

    private RenderFragment CellContent(string key, RecordResponse level) => key switch
    {
        "facility" => @<text>@WarehouseLabels.NameOf(facilities, WarehouseLabels.Id(level, "facilityId"))</text>,
        "position" => @<text>@WarehouseLabels.Number(level, "position")</text>,
        "name" => @<text>@WarehouseLabels.Text(level, "name")</text>,
        "key" => @<text>@WarehouseLabels.Text(level, "key")</text>,
        "characterSet" => @<text>@WarehouseLabels.CharacterSetLabel(WarehouseLabels.Text(level, "characterSet"))</text>,
        "length" => @<text>@WarehouseLabels.Number(level, "minLength")–@WarehouseLabels.Number(level, "maxLength")</text>,
        "separator" => @<text>@(WarehouseLabels.Text(level, "separator") is { Length: > 0 } separator ? separator : "—")</text>,
        _ => @<text></text>,
    };

    private void NewLevel()
    {
        form = new LevelForm { FacilityId = Guid.TryParse(facilityId, out var facility) ? facility : null };
        errors = null;
        message = null;
    }

    private void Edit(RecordResponse level)
    {
        form = new LevelForm
        {
            Id = level.Id, Version = level.Version, FacilityId = WarehouseLabels.Id(level, "facilityId"), Position = WarehouseLabels.Number(level, "position"),
            Key = WarehouseLabels.Text(level, "key"), Name = WarehouseLabels.Text(level, "name"), CharacterSet = WarehouseLabels.Text(level, "characterSet"),
            MinLength = WarehouseLabels.Number(level, "minLength"), MaxLength = WarehouseLabels.Number(level, "maxLength"), Separator = WarehouseLabels.Text(level, "separator"),
        };
        errors = null;
        message = null;
    }

    private async Task SaveAsync()
    {
        busy = true;
        var values = new System.Text.Json.Nodes.JsonObject
        {
            ["position"] = form!.Position,
            ["key"] = form.Key,
            ["name"] = form.Name,
            ["characterSet"] = form.CharacterSet,
            ["minLength"] = form.MinLength,
            ["maxLength"] = form.MaxLength,
            ["separator"] = form.Separator,
        };
        if (form.Id is null)
        {
            // Tesis yalnızca oluştururken verilir; sonra değiştirilemez.
            values["facilityId"] = form.FacilityId?.ToString();
        }

        var request = new RecordWriteRequest(values, form.Version);
        var result = form.Id is { } id
            ? await Api.PutAsync<RecordResponse>($"{Url}/{id}", request)
            : await Api.PostAsync<RecordResponse>(Url, request);
        busy = false;

        if (result.IsSuccess)
        {
            form = null;
            errors = null;
            message = null;
            await LoadAsync(page?.Page ?? 1);
            return;
        }

        errors = result.FieldErrors;
        message = result.Error;
    }

    private async Task DeleteAsync()
    {
        busy = true;
        var result = await Api.DeleteAsync($"{Url}/{form!.Id}?version={form.Version}");
        busy = false;

        if (result.IsSuccess)
        {
            form = null;
            await LoadAsync(page?.Page ?? 1);
            return;
        }

        message = result.Error;
    }

    private sealed class LevelForm
    {
        public Guid? Id { get; init; }

        public long? Version { get; init; }

        public Guid? FacilityId { get; set; }

        public int Position { get; set; } = 1;

        public string Key { get; set; } = string.Empty;

        public string Name { get; set; } = string.Empty;

        public string CharacterSet { get; set; } = "alphanumeric";

        public int MinLength { get; set; } = 1;

        public int MaxLength { get; set; } = 10;

        public string Separator { get; set; } = "-";
    }
}
