@page "/depo/bakiyeler"
@inject ApiClient Api
@inject SessionState Session
@inject NavigationManager Navigation

<PageTitle>@Texts.Get("nav.app.warehouse.stock-balances") · Modulix</PageTitle>

@* Bakiye yalnızca okunur (ADR-0032 K13): hareket defterinden türetilir, hareket kaydıyla aynı işlemde değişir. Bu ekranda yazma eylemi yoktur;
   stok değiştirmek için Stok hareketleri ekranından hareket kaydedilir. *@
<AuthGate Module="@WarehouseAccess.ModuleKey" Permission="@WarehouseAccess.MovementsRead">
    <PageHeader Title="@Texts.Get("nav.app.warehouse.stock-balances")" Icon="list" Subtitle="@(page is null ? Texts.Get("warehouse.stockBalances.intro") : Texts.Get("common.records", page.TotalCount))" />

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }

    <ViewTabs Items="ViewOptions" Value="@view" ValueChanged="ChooseViewAsync" Label="@Texts.Get("warehouse.stockBalances.views")" NewView="StartNaming" />

    <div class="list-toolbar">
        <FilterToggle @bind-Open="filtersOpen" Count="ActiveFilters" />
        <GridColumnPicker State="grid" Changed="ColumnsChanged" />
        @if (Session.Can(WarehouseAccess.MovementsWrite))
        {
            <button type="button" class="btn btn-tonal" @onclick="@(() => Navigation.NavigateTo(lotId is { } lot ? $"depo/hareketler?lotId={lot}" : "depo/hareketler"))"><AppIcon Name="repeat" Size="16" /> @Texts.Get("warehouse.stockBalances.movements")</button>
        }
    </div>

    @if (filtersOpen || ActiveFilters > 0)
    {
        <div class="filters">
            <LookupPicker Id="balance-stock-item-filter" LookupKey="@WarehouseAccess.LotStockItemLookup" Value="stockItemId" ValueChanged="ChooseStockItemAsync" Placeholder="@Texts.Get("warehouse.stockItems.view.all")" />
            <LookupPicker Id="balance-lot-filter" LookupKey="@WarehouseAccess.MovementLotLookup" Value="lotId" ValueChanged="ChooseLotAsync" Placeholder="@Texts.Get("warehouse.lots.view.all")" />
            <LookupPicker Id="balance-location-filter" LookupKey="@WarehouseAccess.MovementToLocationLookup" Value="locationId" ValueChanged="ChooseLocationAsync" Placeholder="@Texts.Get("warehouse.locations.view.all")" />
        </div>
    }

    <PersonalViewBar Active="Active" Dirty="grid.Differs(Active)" Naming="views.Naming" NamingChanged="views.StartNaming" Error="@views.Error"
                     SaveAs="SaveAsAsync" UpdateView="UpdateViewAsync" DiscardChanges="DiscardAsync" DeleteView="DeleteViewAsync" />

    @if (page is null)
    {
        <LoadingState Kind="LoadingKind.Table" />
    }
    else if (page.Items.Count == 0)
    {
        <EmptyState Compact="true" Title="@Texts.Get("warehouse.stockBalances.empty")" />
    }
    else
    {
        <p class="visually-hidden" role="status" aria-live="polite">@Texts.Get("warehouse.stockBalances.listed", page.TotalCount)</p>
        <table class="table record-table">
            <caption class="visually-hidden">@Texts.Get("warehouse.stockBalances.caption")</caption>
            <thead>
                <tr>
                    @foreach (var column in grid.VisibleColumns)
                    {
                        <GridHeader Column="column" State="grid" SortChanged="SortAsync" />
                    }
                    <th scope="col" class="row-menu-cell"><span class="visually-hidden">@Texts.Get("common.actions")</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var balance in page.Items)
                {
                    <tr>
                        @foreach (var column in grid.VisibleColumns)
                        {
                            @Cell(column, balance)
                        }
                        <td class="row-menu-cell">
                            <RowMenu Label="@Texts.Get("warehouse.stockBalances.rowActions", WarehouseLabels.NameOf(lotNames, WarehouseLabels.Id(balance, "lotId")))">
                                <button type="button" class="view-menu-item" role="menuitem" @onclick="@(() => Navigation.NavigateTo($"depo/hareketler?lotId={WarehouseLabels.Id(balance, "lotId")}"))"><AppIcon Name="repeat" Size="16" /> <span>@Texts.Get("warehouse.stockBalances.lotMovements")</span></button>
                            </RowMenu>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager PageSizeChoice="true" Page="page.Page" PageSize="page.PageSize" TotalCount="page.TotalCount" PageChanged="LoadAsync" />
    }
</AuthGate>

@code {
    private static readonly string Url = "/api/records/" + WarehouseAccess.StockBalanceEntityKey;

    private const string InStockView = "in-stock";
    private const string AllViews = "all";

    // Sıralama yalnızca miktara göredir (StockBalanceRecordStore.SortKeys); varsayılan en çok stok önce.
    private static GridColumnDef[] BaseColumns =>
    [
        new("lot", Texts.Get("warehouse.lot"), "package", Locked: true),
        new("location", Texts.Get("warehouse.location"), "map-pin"),
        new("quantity", Texts.Get("warehouse.quantity"), "hash", "quantity", "-quantity"),
    ];

    private readonly GridViewState grid = new("warehouse.stock-balances", "");
    private PersonalGridViews views = default!;
    private RecordPageResponse? page;
    private readonly Dictionary<Guid, string> lotNames = [];
    private readonly Dictionary<Guid, string> locationNames = [];
    private bool filtersOpen;
    private string? message;
    private string view = InStockView;
    private bool nonZero = true;
    private Guid? stockItemId;
    private Guid? lotId;
    private Guid? locationId;

    /// <summary>Partiler ekranından gelince (?lotId=…) liste o partiyle süzülür.</summary>
    [SupplyParameterFromQuery(Name = "lotId")] public Guid? QueryLotId { get; set; }

    private int ActiveFilters => (stockItemId is null ? 0 : 1) + (lotId is null ? 0 : 1) + (locationId is null ? 0 : 1);

    protected override async Task OnInitializedAsync()
    {
        views = new PersonalGridViews(Api, "warehouse.stock-balances");
        lotId = QueryLotId;
        await Session.EnsureLoadedAsync();
        if (Session.Can(WarehouseAccess.MovementsRead))
        {
            grid.Define(BaseColumns);
            await views.LoadAsync();
            await LoadAsync(1);
        }
    }

    private GridViewDto? Active => views.Find(view);

    // Varsayılan görünüm stokta olanlardır (sıfır bakiyeli satırlar gizli); "Tüm satırlar" tükenmiş satırları da gösterir.
    private IReadOnlyList<ViewOption> ViewOptions =>
    [
        new(InStockView, Texts.Get("warehouse.stockBalances.view.inStock"), Icon: "check-circle"),
        new(AllViews, Texts.Get("warehouse.stockBalances.view.all"), Icon: "list"),
        .. views.Options,
    ];

    private async Task ChooseViewAsync(string key)
    {
        view = key;
        views.StartNaming(false);
        if (Active is { } saved)
        {
            grid.Apply(saved);
            var filters = GridFilters.Parse(saved.Filters);
            nonZero = filters.GetValueOrDefault("nonZero") != "false";
            stockItemId = Guid.TryParse(filters.GetValueOrDefault("stockItemId"), out var item) ? item : null;
            lotId = Guid.TryParse(filters.GetValueOrDefault("lotId"), out var lot) ? lot : null;
            locationId = Guid.TryParse(filters.GetValueOrDefault("locationId"), out var location) ? location : null;
        }
        else
        {
            grid.Reset();
            nonZero = key != AllViews;
            stockItemId = lotId = locationId = null;
        }

        await LoadAsync(1);
    }

    private async Task ChooseStockItemAsync(Guid? id)
    {
        stockItemId = id;
        await LoadAsync(1);
    }

    private async Task ChooseLotAsync(Guid? id)
    {
        lotId = id;
        await LoadAsync(1);
    }

    private async Task ChooseLocationAsync(Guid? id)
    {
        locationId = id;
        await LoadAsync(1);
    }

    private async Task SortAsync(string key)
    {
        grid.Sort = key;
        await LoadAsync(1);
    }

    private Task ColumnsChanged() => Task.CompletedTask;

    private string? CurrentFilters => GridFilters.Build(
        ("nonZero", nonZero ? "true" : "false"), stockItemId is { } s ? ("stockItemId", s.ToString()) : null,
        lotId is { } l ? ("lotId", l.ToString()) : null, locationId is { } loc ? ("locationId", loc.ToString()) : null);

    private void StartNaming() => views.StartNaming(true);

    private async Task SaveAsAsync(string name)
    {
        if (await views.SaveAsAsync(grid.ToRequest(name, CurrentFilters)) is { } key)
        {
            view = key;
        }
    }

    private async Task UpdateViewAsync()
    {
        if (Active is { } current)
        {
            await views.UpdateAsync(current, grid.ToRequest(current.Name, CurrentFilters));
        }
    }

    private async Task DiscardAsync() => await ChooseViewAsync(view);

    private async Task DeleteViewAsync()
    {
        if (Active is { } current && await views.DeleteAsync(current))
        {
            await ChooseViewAsync(InStockView);
        }
    }

    private async Task LoadAsync(int pageNumber)
    {
        var url = $"{Url}?page={pageNumber}&pageSize={ListPaging.Size}&nonZero={(nonZero ? "true" : "false")}";
        // Sıralama her zaman gönderilir: varsayılan (en çok stok önce) da sunucuda miktara göredir.
        url += $"&sort={Uri.EscapeDataString(grid.Sort)}";

        if (stockItemId is { } item)
        {
            url += $"&stockItemId={item}";
        }

        if (lotId is { } lot)
        {
            url += $"&lotId={lot}";
        }

        if (locationId is { } location)
        {
            url += $"&locationId={location}";
        }

        var result = await Api.GetAsync<RecordPageResponse>(url);
        page = result.Value;
        message = result.Error;
        if (page is not null)
        {
            await WarehouseLabels.ResolveNamesAsync(Api, WarehouseAccess.MovementLotLookup, page.Items.Select(b => WarehouseLabels.Id(b, "lotId")).OfType<Guid>(), lotNames);
            await WarehouseLabels.ResolveNamesAsync(Api, WarehouseAccess.MovementToLocationLookup, page.Items.Select(b => WarehouseLabels.Id(b, "locationId")).OfType<Guid>(), locationNames);
        }
    }

    private RenderFragment Cell(GridColumnDef column, RecordResponse balance) => @<td data-label="@column.Label" class="@(column.Key == "lot" ? "primary" : null)">@CellContent(column.Key, balance)</td>;

    private RenderFragment CellContent(string key, RecordResponse balance) => key switch
    {
        "lot" => @<text>@WarehouseLabels.NameOf(lotNames, WarehouseLabels.Id(balance, "lotId"))</text>,
        "location" => @<text>@WarehouseLabels.NameOf(locationNames, WarehouseLabels.Id(balance, "locationId"))</text>,
        "quantity" => @<text>@WarehouseLabels.Number(WarehouseLabels.Decimal(balance, "quantity"))</text>,
        _ => @<text></text>,
    };
}
