@page "/depo/alanlar"
@using System.Text.Json.Nodes
@inject ApiClient Api
@inject SessionState Session
@inject CrmLookups Lookups

<PageTitle>@Texts.Get("nav.app.warehouse.zones") · Modulix</PageTitle>

<AuthGate Module="@WarehouseAccess.ModuleKey" Permission="@WarehouseAccess.ZonesRead">
    <PageHeader Title="@Texts.Get("nav.app.warehouse.zones")" Icon="layers" Subtitle="@(page is null ? Texts.Get("warehouse.zones.intro") : Texts.Get("common.records", page.TotalCount))" />

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }

    @if (editing)
    {
        <ZoneEditor Zone="selected" Lookups="Lookups" Saved="SavedAsync" Deleted="SavedAsync" Cancelled="Close" />
    }

    @* Görünümler sunucuda süzgeç olarak uygulanır; sayfalama ve toplam doğru kalır. *@
    <ViewTabs Items="ViewOptions" Value="@view" ValueChanged="ChooseViewAsync" Label="@Texts.Get("warehouse.zones.views")" NewView="StartNaming" />

    <div class="list-toolbar">
        <form class="search" @onsubmit="() => LoadAsync(1)" @onsubmit:preventDefault>
            <input class="form-control" type="search" aria-label="@Texts.Get("warehouse.zones.search")" placeholder="@Texts.Get("warehouse.searchCodeOrName")" @bind="search" />
        </form>
        <FilterToggle @bind-Open="filtersOpen" Count="ActiveFilters" />
        <GridColumnPicker State="grid" Changed="ColumnsChanged" />
        @if (Session.Can(WarehouseAccess.ZonesWrite) && !editing)
        {
            <button type="button" class="btn btn-primary" @onclick="() => Open(null)"><AppIcon Name="plus" Size="16" /> @Texts.Get("warehouse.zones.new")</button>
        }
    </div>

    @if (filtersOpen || ActiveFilters > 0)
    {
        <div class="filters">
            <select class="form-select" aria-label="@Texts.Get("warehouse.facility")" @bind="facilityId" @bind:after="() => LoadAsync(1)">
                <option value="">@Texts.Get("warehouse.allFacilities")</option>
                @foreach (var (id, name) in facilities.OrderBy(f => f.Value, StringComparer.CurrentCulture))
                {
                    <option value="@id">@name</option>
                }
            </select>
            <select class="form-select" aria-label="@Texts.Get("warehouse.zones.kind")" @bind="kindKey" @bind:after="() => LoadAsync(1)">
                <option value="">@Texts.Get("warehouse.zones.allKinds")</option>
                @foreach (var kind in Lookups.ValuesOf(WarehouseAccess.ZoneKindList))
                {
                    <option value="@kind.Key">@kind.Label</option>
                }
            </select>
        </div>
    }

    <PersonalViewBar Active="Active" Dirty="grid.Differs(Active)" Naming="views.Naming" NamingChanged="views.StartNaming" Error="@views.Error"
                     SaveAs="SaveAsAsync" UpdateView="UpdateViewAsync" DiscardChanges="DiscardAsync" DeleteView="DeleteViewAsync" />

    @if (page is null)
    {
        <LoadingState Kind="LoadingKind.Table" />
    }
    else if (page.Items.Count == 0)
    {
        <p class="text-muted" role="status">@Texts.Get("warehouse.zones.empty")</p>
    }
    else
    {
        <p class="visually-hidden" role="status" aria-live="polite">@Texts.Get("warehouse.zones.listed", page.TotalCount)</p>
        <table class="table record-table">
            <caption class="visually-hidden">@Texts.Get("warehouse.zones.caption")</caption>
            <thead>
                <tr>
                    @foreach (var column in grid.VisibleColumns)
                    {
                        <GridHeader Column="column" State="grid" SortChanged="SortAsync" />
                    }
                    <th scope="col" class="row-menu-cell"><span class="visually-hidden">@Texts.Get("common.actions")</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var zone in page.Items)
                {
                    <tr>
                        @foreach (var column in grid.VisibleColumns)
                        {
                            @Cell(column, zone)
                        }
                        <td class="row-menu-cell">
                            @if (Session.Can(WarehouseAccess.ZonesWrite))
                            {
                                <RowMenu Label="@Texts.Get("common.rowActionsOf", WarehouseLabels.Text(zone, "code"))">
                                    <button type="button" class="view-menu-item" role="menuitem" @onclick="() => Open(zone)"><AppIcon Name="pencil" Size="16" /> <span>@Texts.Get("common.edit")</span></button>
                                </RowMenu>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager PageSizeChoice="true" Page="page.Page" PageSize="page.PageSize" TotalCount="page.TotalCount" PageChanged="LoadAsync" />
    }
</AuthGate>

@code {
    private static readonly string Url = "/api/records/" + WarehouseAccess.ZoneEntityKey;

    private const string AllViews = "all";
    private const string ActiveView = "active";
    private const string InactiveView = "inactive";

    // Sütunların sırası varsayılan sıradır; sıralama anahtarları kayıt deposunun beyanıdır (WarehouseRecordStore.SortKeys).
    private static GridColumnDef[] BaseColumns =>
    [
        new("code", Texts.Get("warehouse.code"), "hash", "code", "-code", Locked: true),
        new("name", Texts.Get("common.field.name"), "type", "name", "-name"),
        new("facility", Texts.Get("warehouse.facility"), "warehouse", "facility", "-facility"),
        new("kindKey", Texts.Get("common.field.kind"), "layers", "kindKey", "-kindKey"),
        new("isActive", Texts.Get("common.field.status"), "tag", "isActive", "-isActive"),
    ];

    private readonly GridViewState grid = new("warehouse.zones", "facility");
    private PersonalGridViews views = default!;
    private RecordPageResponse? page;
    private RecordResponse? selected;
    private Dictionary<Guid, string> facilities = [];
    private bool editing;
    private bool filtersOpen;
    private string? message;
    private string? search;
    private string view = AllViews;
    private string? isActive;
    private string facilityId = "";
    private string kindKey = "";

    private int ActiveFilters => (facilityId.Length > 0 ? 1 : 0) + (kindKey.Length > 0 ? 1 : 0);

    protected override async Task OnInitializedAsync()
    {
        views = new PersonalGridViews(Api, "warehouse.zones");
        await Session.EnsureLoadedAsync();
        if (Session.Can(WarehouseAccess.ZonesRead))
        {
            await Lookups.LoadAsync();
            facilities = await WarehouseLabels.NamesAsync(Api, WarehouseAccess.FacilityEntityKey, f => WarehouseLabels.Text(f, "code") + " · " + WarehouseLabels.Text(f, "name"));
            grid.Define([.. BaseColumns, .. Lookups.FieldsOf(WarehouseAccess.ZoneEntityKey).Select(f => new GridColumnDef("custom." + f.Key, f.Label, "type", DefaultVisible: f.ShowInList))]);
            await views.LoadAsync();
            await LoadAsync(1);
        }
    }

    private GridViewDto? Active => views.Find(view);

    // Görünümler yalnızca süzgeçtir (Tümü, Etkin, Pasif, kişisel); tesis ve tür seçimleri "Filtrele" ile açılır. Yetki ve kapsamı sunucu uygular.
    private IReadOnlyList<ViewOption> ViewOptions =>
    [
        new(AllViews, Texts.Get("warehouse.allZones"), Icon: "layers"),
        new(ActiveView, Texts.Get("warehouse.zones.view.active"), Icon: "check-circle"),
        new(InactiveView, Texts.Get("warehouse.zones.view.inactive"), Icon: "clock"),
        .. views.Options,
    ];

    private async Task ChooseViewAsync(string key)
    {
        view = key;
        views.StartNaming(false);
        if (Active is { } saved)
        {
            // Kişisel görünüm: sütunlar, sıralama ve süzgeç birlikte gelir.
            grid.Apply(saved);
            var filters = GridFilters.Parse(saved.Filters);
            isActive = filters.GetValueOrDefault("isActive");
            facilityId = filters.GetValueOrDefault("facilityId") ?? "";
            kindKey = filters.GetValueOrDefault("kindKey") ?? "";
        }
        else
        {
            grid.Reset();
            isActive = key switch { ActiveView => "true", InactiveView => "false", _ => null };
            facilityId = kindKey = "";
        }

        await LoadAsync(1);
    }

    private async Task SortAsync(string key)
    {
        grid.Sort = key;
        await LoadAsync(1);
    }

    // Sütun seçimi/sırası değişince veri yeniden çekilmez; olay işleyicisi sayfada olduğu için tablo yeniden çizilir.
    private Task ColumnsChanged() => Task.CompletedTask;

    private string? CurrentFilters => GridFilters.Build(
        isActive is { } a ? ("isActive", a) : null, ("facilityId", facilityId), ("kindKey", kindKey));

    private void StartNaming() => views.StartNaming(true);

    private async Task SaveAsAsync(string name)
    {
        if (await views.SaveAsAsync(grid.ToRequest(name, CurrentFilters)) is { } key)
        {
            view = key;
        }
    }

    private async Task UpdateViewAsync()
    {
        if (Active is { } current)
        {
            await views.UpdateAsync(current, grid.ToRequest(current.Name, CurrentFilters));
        }
    }

    private async Task DiscardAsync() => await ChooseViewAsync(view);

    private async Task DeleteViewAsync()
    {
        if (Active is { } current && await views.DeleteAsync(current))
        {
            await ChooseViewAsync(AllViews);
        }
    }

    private async Task LoadAsync(int pageNumber)
    {
        var url = $"{Url}?page={pageNumber}&pageSize={ListPaging.Size}&search={Uri.EscapeDataString(search ?? string.Empty)}";
        if (grid.Sort != grid.DefaultSort)
        {
            url += $"&sort={Uri.EscapeDataString(grid.Sort)}";
        }

        if (isActive is { } a)
        {
            url += $"&isActive={Uri.EscapeDataString(a)}";
        }

        foreach (var (name, value) in new[] { ("facilityId", facilityId), ("kindKey", kindKey) })
        {
            if (value.Length > 0)
            {
                url += $"&{name}={Uri.EscapeDataString(value)}";
            }
        }

        var result = await Api.GetAsync<RecordPageResponse>(url);
        page = result.Value;
        message = result.Error;
    }

    private RenderFragment Cell(GridColumnDef column, RecordResponse zone) => @<td data-label="@column.Label" class="@(column.Key == "code" ? "primary" : null)">@CellContent(column.Key, zone)</td>;

    private RenderFragment CellContent(string key, RecordResponse zone) => key switch
    {
        "code" => @<text>@WarehouseLabels.Text(zone, "code")</text>,
        "name" => @<text>@WarehouseLabels.Text(zone, "name")</text>,
        "facility" => @<text>@WarehouseLabels.NameOf(facilities, WarehouseLabels.Id(zone, "facilityId"))</text>,
        "kindKey" => @<span class="badge @WarehouseLabels.KindBadge(Lookups.CategoryOf(WarehouseAccess.ZoneKindList, WarehouseLabels.Text(zone, "kindKey")))">@Lookups.Label(WarehouseAccess.ZoneKindList, WarehouseLabels.Text(zone, "kindKey"))</span>,
        "isActive" => @<span class="badge @WarehouseLabels.ActiveBadge(WarehouseLabels.Flag(zone, "isActive"))">@WarehouseLabels.ActiveText(WarehouseLabels.Flag(zone, "isActive"))</span>,
        _ when key.StartsWith("custom.", StringComparison.Ordinal) && Lookups.FieldsOf(WarehouseAccess.ZoneEntityKey).FirstOrDefault(f => "custom." + f.Key == key) is { } field =>
            @<text>@CustomFieldText.Format(field, zone.Values["custom"] as JsonObject)</text>,
        _ => @<text></text>,
    };

    private void Open(RecordResponse? zone)
    {
        selected = zone;
        editing = true;
        message = null;
    }

    private void Close() => editing = false;

    private async Task SavedAsync()
    {
        editing = false;
        await LoadAsync(page?.Page ?? 1);
    }
}
