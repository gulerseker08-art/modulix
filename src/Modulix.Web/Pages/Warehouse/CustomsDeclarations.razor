@page "/depo/beyannameler"
@using System.Globalization
@using System.Text.Json.Nodes
@inject ApiClient Api
@inject SessionState Session
@inject CrmLookups Lookups

<PageTitle>@Texts.Get("nav.app.warehouse.customs-declarations") · Modulix</PageTitle>

<AuthGate Module="@WarehouseAccess.ModuleKey" Permission="@WarehouseAccess.DeclarationsRead">
    <PageHeader Title="@Texts.Get("nav.app.warehouse.customs-declarations")" Icon="clipboard-list" Subtitle="@(page is null ? Texts.Get("warehouse.declarations.intro") : Texts.Get("common.records", page.TotalCount))" />

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }

    <Notice Text="@notice" Failed="false" />

    @if (editing)
    {
        <CustomsDeclarationEditor Declaration="selected" Lookups="Lookups" Saved="SavedAsync" Deleted="DeletedAsync" Cancelled="Close" />
        @if (selected is not null)
        {
            <DeclarationLinesPanel DeclarationId="selected.Id" Lookups="Lookups" CanWrite="@Session.Can(WarehouseAccess.DeclarationsWrite)"
                                   Locked="@(Lookups.CategoryOf(WarehouseAccess.DeclarationStatusList, WarehouseLabels.Text(selected, "statusKey")) == WarehouseAccess.DeclarationCancelled)" />
        }
    }

    @* Görünümler sunucuda süzgeç olarak uygulanır; sayfalama ve toplam doğru kalır. *@
    <ViewTabs Items="ViewOptions" Value="@view" ValueChanged="ChooseViewAsync" Label="@Texts.Get("warehouse.declarations.views")" NewView="StartNaming" />

    <div class="list-toolbar">
        <form class="search" @onsubmit="() => LoadAsync(1)" @onsubmit:preventDefault>
            <input class="form-control" type="search" aria-label="@Texts.Get("warehouse.declarations.search")" placeholder="@Texts.Get("warehouse.declarations.searchPlaceholder")" @bind="search" />
        </form>
        <FilterToggle @bind-Open="filtersOpen" Count="ActiveFilters" />
        <GridColumnPicker State="grid" Changed="ColumnsChanged" />
        @if (Session.Can(WarehouseAccess.DeclarationsWrite) && !editing)
        {
            <button type="button" class="btn btn-primary" @onclick="() => Open(null)"><AppIcon Name="plus" Size="16" /> @Texts.Get("warehouse.declarations.new")</button>
        }
    </div>

    @if (filtersOpen || ActiveFilters > 0)
    {
        <div class="filters">
            <LookupPicker Id="decl-importer-filter" LookupKey="@WarehouseAccess.DeclarationImporterLookup" Value="importerId" ValueChanged="ChooseImporterAsync" Placeholder="@Texts.Get("warehouse.declarations.allImporters")" />
            <LookupPicker Id="decl-broker-filter" LookupKey="@WarehouseAccess.DeclarationBrokerLookup" Value="brokerId" ValueChanged="ChooseBrokerAsync" Placeholder="@Texts.Get("warehouse.declarations.allBrokers")" />
            <input class="form-control" type="date" aria-label="@Texts.Get("warehouse.declarations.fromLabel")" title="@Texts.Get("warehouse.declarations.fromTitle")" @bind="from" @bind:after="() => LoadAsync(1)" />
            <input class="form-control" type="date" aria-label="@Texts.Get("warehouse.declarations.toLabel")" title="@Texts.Get("warehouse.declarations.toTitle")" @bind="to" @bind:after="() => LoadAsync(1)" />
        </div>
    }

    <PersonalViewBar Active="Active" Dirty="grid.Differs(Active)" Naming="views.Naming" NamingChanged="views.StartNaming" Error="@views.Error"
                     SaveAs="SaveAsAsync" UpdateView="UpdateViewAsync" DiscardChanges="DiscardAsync" DeleteView="DeleteViewAsync" />

    @if (page is null)
    {
        <LoadingState Kind="LoadingKind.Table" />
    }
    else if (page.Items.Count == 0)
    {
        <EmptyState Compact="true" Title="@Texts.Get("warehouse.declarations.empty")" />
    }
    else
    {
        <p class="visually-hidden" role="status" aria-live="polite">@Texts.Get("warehouse.declarations.listed", page.TotalCount)</p>
        <table class="table record-table">
            <caption class="visually-hidden">@Texts.Get("warehouse.declarations.caption")</caption>
            <thead>
                <tr>
                    @foreach (var column in grid.VisibleColumns)
                    {
                        <GridHeader Column="column" State="grid" SortChanged="SortAsync" />
                    }
                    <th scope="col" class="row-menu-cell"><span class="visually-hidden">@Texts.Get("common.actions")</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var declaration in page.Items)
                {
                    <tr>
                        @foreach (var column in grid.VisibleColumns)
                        {
                            @Cell(column, declaration)
                        }
                        <td class="row-menu-cell">
                            <RowMenu Label="@Texts.Get("common.rowActionsOf", WarehouseLabels.Text(declaration, "registrationNo"))">
                                <button type="button" class="view-menu-item" role="menuitem" @onclick="() => Open(declaration)">
                                    <AppIcon Name="@(Session.Can(WarehouseAccess.DeclarationsWrite) ? "pencil" : "eye")" Size="16" /> <span>@(Session.Can(WarehouseAccess.DeclarationsWrite) ? Texts.Get("common.edit") : Texts.Get("common.open"))</span>
                                </button>
                            </RowMenu>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager PageSizeChoice="true" Page="page.Page" PageSize="page.PageSize" TotalCount="page.TotalCount" PageChanged="LoadAsync" />
    }
</AuthGate>

@code {
    private static readonly string Url = "/api/records/" + WarehouseAccess.CustomsDeclarationEntityKey;
    private const string AllViews = "all";
    private const string StatusPrefix = "status:";

    // Sütunların sırası varsayılan sıradır; sıralama anahtarları kayıt deposunun beyanıdır (WarehouseRecordStore.SortKeys).
    // Taraflar (firma adı) sunucuda sıralanamaz: firma görünürlüğü sıralamayla dolanılmasın. Varsayılan sıra tescil tarihine göre en yenidir.
    private static GridColumnDef[] BaseColumns =>
    [
        new("registrationNo", Texts.Get("warehouse.registrationNo"), "hash", "registrationNo", "-registrationNo", Locked: true),
        new("registrationDate", Texts.Get("warehouse.registrationDate"), "calendar", "registrationDate", "-registrationDate"),
        new("importer", Texts.Get("warehouse.importer"), "building", DefaultVisible: true),
        new("broker", Texts.Get("warehouse.broker"), "user"),
        new("regimeKey", Texts.Get("warehouse.regime"), "landmark", "regimeKey", "-regimeKey"),
        new("statusKey", Texts.Get("common.field.status"), "tag", "statusKey", "-statusKey"),
    ];

    private readonly GridViewState grid = new("warehouse.customs-declarations", "-registrationDate");
    private PersonalGridViews views = default!;
    private RecordPageResponse? page;
    private RecordResponse? selected;
    private readonly Dictionary<Guid, string> partyNames = [];
    private bool editing;
    private bool filtersOpen;
    private string? message;
    private string? notice;
    private string? search;
    private string view = AllViews;
    private string? statusKey;
    private Guid? importerId;
    private Guid? brokerId;
    private DateTime? from;
    private DateTime? to;

    protected override async Task OnInitializedAsync()
    {
        views = new PersonalGridViews(Api, "warehouse.customs-declarations");
        await Session.EnsureLoadedAsync();
        if (Session.Can(WarehouseAccess.DeclarationsRead))
        {
            await Lookups.LoadAsync();
            grid.Define([.. BaseColumns, .. Lookups.FieldsOf(WarehouseAccess.CustomsDeclarationEntityKey).Select(f => new GridColumnDef("custom." + f.Key, f.Label, "type", DefaultVisible: f.ShowInList))]);
            await views.LoadAsync();
            await LoadAsync(1);
        }
    }

    private GridViewDto? Active => views.Find(view);

    // Görünümler yalnızca süzgeçtir (Tümü, firmanın beyanname durumları, kişisel); taraf ve tarih süzgeçleri "Filtrele" ile açılır. Yetki ve kapsamı sunucu uygular.
    private IReadOnlyList<ViewOption> ViewOptions =>
    [
        new(AllViews, Texts.Get("warehouse.declarations.view.all"), Icon: "clipboard-list"),
        .. Lookups.ValuesOf(WarehouseAccess.DeclarationStatusList).Where(v => v.Active).Select(v => new ViewOption(StatusPrefix + v.Key, v.Label, Icon: "tag")),
        .. views.Options,
    ];

    private int ActiveFilters => (importerId is null ? 0 : 1) + (brokerId is null ? 0 : 1) + (from is null ? 0 : 1) + (to is null ? 0 : 1);

    private async Task ChooseViewAsync(string key)
    {
        view = key;
        views.StartNaming(false);
        if (Active is { } saved)
        {
            // Kişisel görünüm: sütunlar, sıralama ve süzgeç birlikte gelir.
            grid.Apply(saved);
            var filters = GridFilters.Parse(saved.Filters);
            statusKey = filters.GetValueOrDefault("statusKey");
            importerId = Guid.TryParse(filters.GetValueOrDefault("importerPartyId"), out var importer) ? importer : null;
            brokerId = Guid.TryParse(filters.GetValueOrDefault("brokerPartyId"), out var broker) ? broker : null;
            from = ParseDay(filters.GetValueOrDefault("registeredFrom"));
            to = ParseDay(filters.GetValueOrDefault("registeredTo"));
        }
        else
        {
            grid.Reset();
            statusKey = key.StartsWith(StatusPrefix, StringComparison.Ordinal) ? key[StatusPrefix.Length..] : null;
            importerId = brokerId = null;
            from = to = null;
        }

        await LoadAsync(1);
    }

    private async Task ChooseImporterAsync(Guid? id)
    {
        importerId = id;
        await LoadAsync(1);
    }

    private async Task ChooseBrokerAsync(Guid? id)
    {
        brokerId = id;
        await LoadAsync(1);
    }

    private async Task SortAsync(string key)
    {
        grid.Sort = key;
        await LoadAsync(1);
    }

    // Sütun seçimi/sırası değişince veri yeniden çekilmez; olay işleyicisi sayfada olduğu için tablo yeniden çizilir.
    private Task ColumnsChanged() => Task.CompletedTask;

    private string? CurrentFilters => GridFilters.Build(
        statusKey is { } s ? ("statusKey", s) : null,
        importerId is { } i ? ("importerPartyId", i.ToString()) : null, brokerId is { } b ? ("brokerPartyId", b.ToString()) : null,
        from is { } f ? ("registeredFrom", $"{f:yyyy-MM-dd}") : null, to is { } t ? ("registeredTo", $"{t:yyyy-MM-dd}") : null);

    private void StartNaming() => views.StartNaming(true);

    private async Task SaveAsAsync(string name)
    {
        if (await views.SaveAsAsync(grid.ToRequest(name, CurrentFilters)) is { } key)
        {
            view = key;
        }
    }

    private async Task UpdateViewAsync()
    {
        if (Active is { } current)
        {
            await views.UpdateAsync(current, grid.ToRequest(current.Name, CurrentFilters));
        }
    }

    private async Task DiscardAsync() => await ChooseViewAsync(view);

    private async Task DeleteViewAsync()
    {
        if (Active is { } current && await views.DeleteAsync(current))
        {
            await ChooseViewAsync(AllViews);
        }
    }

    private static DateTime? ParseDay(string? value) =>
        DateTime.TryParseExact(value, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var day) ? day : null;

    private async Task LoadAsync(int pageNumber)
    {
        var url = $"{Url}?page={pageNumber}&pageSize={ListPaging.Size}&search={Uri.EscapeDataString(search ?? string.Empty)}";
        if (grid.Sort != grid.DefaultSort)
        {
            url += $"&sort={Uri.EscapeDataString(grid.Sort)}";
        }

        if (statusKey is { } status)
        {
            url += $"&statusKey={Uri.EscapeDataString(status)}";
        }

        if (importerId is { } importer)
        {
            url += $"&importerPartyId={importer}";
        }

        if (brokerId is { } broker)
        {
            url += $"&brokerPartyId={broker}";
        }

        if (from is { } start)
        {
            url += $"&registeredFrom={start:yyyy-MM-dd}";
        }

        if (to is { } end)
        {
            url += $"&registeredTo={end:yyyy-MM-dd}";
        }

        var result = await Api.GetAsync<RecordPageResponse>(url);
        page = result.Value;
        message = result.Error;
        if (page is not null)
        {
            var ids = page.Items.SelectMany(d => new[] { WarehouseLabels.Id(d, "importerPartyId"), WarehouseLabels.Id(d, "brokerPartyId") }).OfType<Guid>();
            await WarehouseLabels.ResolveNamesAsync(Api, WarehouseAccess.DeclarationImporterLookup, ids, partyNames);
        }
    }

    private RenderFragment Cell(GridColumnDef column, RecordResponse declaration) => @<td data-label="@column.Label" class="@(column.Key == "registrationNo" ? "primary" : null)">@CellContent(column.Key, declaration)</td>;

    private RenderFragment CellContent(string key, RecordResponse declaration) => key switch
    {
        "registrationNo" => @<text>@WarehouseLabels.Text(declaration, "registrationNo")</text>,
        "registrationDate" => @<text>@Display(WarehouseLabels.Text(declaration, "registrationDate"))</text>,
        "importer" => @<text>@WarehouseLabels.NameOf(partyNames, WarehouseLabels.Id(declaration, "importerPartyId"))</text>,
        "broker" => @<text>@WarehouseLabels.NameOf(partyNames, WarehouseLabels.Id(declaration, "brokerPartyId"))</text>,
        "regimeKey" => @<text>@Lookups.Label(WarehouseAccess.CustomsRegimeList, WarehouseLabels.Text(declaration, "regimeKey"))</text>,
        "statusKey" => @<span class="badge @WarehouseLabels.DeclarationBadge(Lookups.CategoryOf(WarehouseAccess.DeclarationStatusList, WarehouseLabels.Text(declaration, "statusKey")))">@Lookups.Label(WarehouseAccess.DeclarationStatusList, WarehouseLabels.Text(declaration, "statusKey"))</span>,
        _ when key.StartsWith("custom.", StringComparison.Ordinal) && Lookups.FieldsOf(WarehouseAccess.CustomsDeclarationEntityKey).FirstOrDefault(f => "custom." + f.Key == key) is { } field =>
            @<text>@CustomFieldText.Format(field, declaration.Values["custom"] as JsonObject)</text>,
        _ => @<text></text>,
    };

    private static string Display(string isoDate) =>
        DateOnly.TryParseExact(isoDate, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var date)
            ? date.ToString("d", CultureInfo.GetCultureInfo("tr-TR"))
            : isoDate;

    private void Open(RecordResponse? declaration)
    {
        selected = declaration;
        editing = true;
        message = null;
        notice = null;
    }

    private void Close() => editing = false;

    // Kayıttan sonra form açık kalır: yeni beyannamenin satırları hemen eklenebilsin.
    private async Task SavedAsync(RecordResponse saved)
    {
        selected = saved;
        notice = Texts.Get("warehouse.declarations.saved");
        await LoadAsync(page?.Page ?? 1);
    }

    private async Task DeletedAsync()
    {
        editing = false;
        selected = null;
        await LoadAsync(page?.Page ?? 1);
    }
}
