@page "/depo/rejim-profilleri"
@using System.Text.Json.Nodes
@using Modulix.Shared.Customs
@inject ApiClient Api
@inject SessionState Session
@inject CrmLookups Lookups

<PageTitle>@Texts.Get("nav.app.warehouse.regime-bindings") · Modulix</PageTitle>

@* Rejim–profil bağlaması (ADR-0032 K16). Platformun yayınladığı bir rejim profili, firmanın kendi rejim listesindeki bir değere bağlanır; o rejimdeki
   beyannamelerde tescil numarası profilin kuralına göre denetlenir. Firma kuralı yalnızca sıkılaştırabilir (uyarıyı engele çevirir), gevşetemez.
   Profil platformca yönetilir; "Doğrulanmadı" etiketli profilin kuralı uzman teyidi beklemektedir. Ayar ekranıdır (form sekmeleri kuralının dışında). *@
<AuthGate Module="@WarehouseAccess.ModuleKey" Permission="@WarehouseAccess.RegimesRead">
    <PageHeader Title="@Texts.Get("nav.app.warehouse.regime-bindings")" Icon="shield" Subtitle="@Texts.Get("warehouse.regimeBindings.intro")" />

    <Notice Text="@notice" Failed="@failed" />

    @if (regimes is null)
    {
        <LoadingState Kind="LoadingKind.Table" />
    }
    else
    {
        <table class="table record-table">
            <caption class="visually-hidden">@Texts.Get("warehouse.regimeBindings.caption")</caption>
            <thead>
                <tr><th scope="col">@Texts.Get("warehouse.regime")</th><th scope="col">@Texts.Get("warehouse.regimeBindings.profile")</th><th scope="col">@Texts.Get("warehouse.regimeBindings.rule")</th><th scope="col">@Texts.Get("warehouse.regimeBindings.onViolation")</th><th scope="col"></th></tr>
            </thead>
            <tbody>
                @foreach (var regime in regimes)
                {
                    var binding = bindings.GetValueOrDefault(regime.Key);
                    var profile = binding is null ? null : profiles.FirstOrDefault(p => p.ProfileId == WarehouseLabels.Id(binding, "profileId"));
                    <tr>
                        <td data-label="@Texts.Get("warehouse.regime")" class="primary">@regime.Label</td>
                        <td data-label="@Texts.Get("warehouse.regimeBindings.profile")">
                            @if (binding is null)
                            {
                                <span class="text-muted">@Texts.Get("warehouse.regimeBindings.notBound")</span>
                            }
                            else if (profile is null)
                            {
                                <span class="text-muted">@Texts.Get("warehouse.regimeBindings.notPublished")</span>
                            }
                            else
                            {
                                <span>@Texts.Get("warehouse.regimeBindings.profileVersion", profile.Name, profile.VersionNumber)</span>
                                <span class="badge @(profile.IsVerified ? "status-customer" : "stage-qualified")">@(profile.IsVerified ? Texts.Get("warehouse.verified") : Texts.Get("warehouse.unverified"))</span>
                            }
                        </td>
                        <td data-label="@Texts.Get("warehouse.regimeBindings.rule")">@(profile is null ? "—" : RuleText(profile.RegistrationNo))</td>
                        <td data-label="@Texts.Get("warehouse.regimeBindings.onViolation")">@(binding is null || profile is null ? "—" : LevelText(profile, WarehouseLabels.Text(binding, "enforcement")))</td>
                        <td class="actions">
                            @if (Session.Can(WarehouseAccess.RegimesWrite))
                            {
                                <button type="button" class="btn btn-outline-primary btn-sm" @onclick="() => Open(regime.Key)">@(binding is null ? Texts.Get("warehouse.regimeBindings.bind") : Texts.Get("common.edit"))</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (profiles.Count == 0)
        {
            <p class="text-muted" role="status">@Texts.Get("warehouse.regimeBindings.noProfiles")</p>
        }
    }

    @if (editingKey is { } key)
    {
        <form class="record-form settings-group" novalidate @onsubmit="SaveAsync" @onsubmit:preventDefault>
            <h2>@Texts.Get("warehouse.regimeBindings.formTitle", Lookups.Label(WarehouseAccess.CustomsRegimeList, key))</h2>
            <div class="form-grid">
                <div>
                    <label class="form-label" for="binding-profile">@Texts.Get("warehouse.regimeBindings.profileRequired")</label>
                    <select id="binding-profile" class="form-select" @bind="profileId">
                        <option value="">@Texts.Get("common.choose")</option>
                        @foreach (var p in profiles)
                        {
                            <option value="@p.ProfileId">@Texts.Get("warehouse.regimeBindings.profileVersion", p.Name, p.VersionNumber)@(p.IsVerified ? null : " · " + Texts.Get("warehouse.unverified"))</option>
                        }
                    </select>
                    <FieldError Field="profileId" Errors="errors" />
                </div>
                <div>
                    <label class="form-label" for="binding-level">@Texts.Get("warehouse.regimeBindings.onViolation")</label>
                    <select id="binding-level" class="form-select" @bind="level">
                        <option value="Inherit">@Texts.Get("warehouse.regimeBindings.inherit")</option>
                        <option value="Block">@Texts.Get("warehouse.regimeBindings.block")</option>
                    </select>
                    <FieldError Field="enforcement" Errors="errors" />
                    <div class="form-text">@Texts.Get("warehouse.regimeBindings.levelHelp")</div>
                </div>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary" disabled="@(busy || string.IsNullOrEmpty(profileId))">@Texts.Get("common.save")</button>
                <button type="button" class="btn btn-outline-secondary" @onclick="Close">@Texts.Get("common.cancel")</button>
                @if (editingBinding is not null)
                {
                    <button type="button" class="btn btn-outline-danger ms-auto" disabled="@busy" @onclick="RemoveAsync">@Texts.Get("warehouse.regimeBindings.remove")</button>
                }
            </div>
        </form>
    }
</AuthGate>

@code {
    private static readonly string Url = "/api/records/" + WarehouseAccess.RegimeBindingEntityKey;

    private IReadOnlyList<ChoiceValueDto>? regimes;
    private readonly Dictionary<string, RecordResponse> bindings = new(StringComparer.OrdinalIgnoreCase);
    private List<PublishedRegimeProfileDto> profiles = [];
    private string? editingKey;
    private RecordResponse? editingBinding;
    private string profileId = string.Empty;
    private string level = "Inherit";
    private IReadOnlyDictionary<string, string[]>? errors;
    private string? notice;
    private bool failed;
    private bool busy;

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (Session.Can(WarehouseAccess.RegimesRead))
        {
            await Lookups.LoadAsync();
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        regimes = Lookups.ValuesOf(WarehouseAccess.CustomsRegimeList);
        profiles = (await Api.GetAsync<List<PublishedRegimeProfileDto>>("/api/warehouse/regime/profiles")).Value ?? [];
        var result = await Api.GetAsync<RecordPageResponse>($"{Url}?page=1&pageSize=200");
        bindings.Clear();
        foreach (var item in result.Value?.Items ?? [])
        {
            bindings[WarehouseLabels.Text(item, "regimeKey")] = item;
        }

        if (!result.IsSuccess)
        {
            Fail(result.Error);
        }
    }

    private void Open(string key)
    {
        editingKey = key;
        editingBinding = bindings.GetValueOrDefault(key);
        profileId = editingBinding is null ? string.Empty : WarehouseLabels.Text(editingBinding, "profileId");
        level = editingBinding is not null && WarehouseLabels.Text(editingBinding, "enforcement") == "Block" ? "Block" : "Inherit";
        errors = null;
        notice = null;
    }

    private void Close() => editingKey = null;

    private async Task SaveAsync()
    {
        if (busy || editingKey is null)
        {
            return;
        }

        busy = true;
        var values = new JsonObject { ["regimeKey"] = editingKey, ["profileId"] = profileId, ["enforcement"] = level };
        var request = new RecordWriteRequest(values, editingBinding?.Version);
        var result = editingBinding is { } existing
            ? await Api.PutAsync<RecordResponse>($"{Url}/{existing.Id}", request)
            : await Api.PostAsync<RecordResponse>(Url, request);
        busy = false;
        if (!result.IsSuccess)
        {
            errors = result.FieldErrors;
            Fail(result.Error);
            return;
        }

        notice = Texts.Get("warehouse.regimeBindings.saved");
        failed = false;
        editingKey = null;
        await LoadAsync();
    }

    private async Task RemoveAsync()
    {
        if (busy || editingBinding is null)
        {
            return;
        }

        busy = true;
        var result = await Api.DeleteAsync($"{Url}/{editingBinding.Id}?version={editingBinding.Version}");
        busy = false;
        if (!result.IsSuccess)
        {
            Fail(result.Error);
            return;
        }

        notice = Texts.Get("warehouse.regimeBindings.removed");
        failed = false;
        editingKey = null;
        await LoadAsync();
    }

    private static string RuleText(RegistrationNoRuleDto? rule)
    {
        if (rule is null)
        {
            return Texts.Get("warehouse.regimeBindings.noRule");
        }

        var parts = new List<string>();
        if (rule.MinLength is not null || rule.MaxLength is not null)
        {
            parts.Add(Texts.Get("warehouse.regimeBindings.length", rule.MinLength?.ToString() ?? "—", rule.MaxLength?.ToString() ?? "—"));
        }

        if (!string.IsNullOrEmpty(rule.Pattern))
        {
            parts.Add(Texts.Get("warehouse.regimeBindings.pattern", rule.Pattern));
        }

        return parts.Count == 0 ? Texts.Get("warehouse.regimeBindings.noRule") : string.Join(" · ", parts);
    }

    // Etkin düzey: profil engelse engel (gevşetilemez); aksi halde firma engel seçtiyse engel, yoksa uyarı.
    private static string LevelText(PublishedRegimeProfileDto profile, string tenantLevel) =>
        profile.RegistrationNo?.Enforcement == "Block" || tenantLevel == "Block" ? Texts.Get("warehouse.regimeBindings.levelBlock") : Texts.Get("warehouse.regimeBindings.levelWarn");

    private void Fail(string? message)
    {
        notice = message ?? Texts.Get("warehouse.regimeBindings.failed");
        failed = true;
    }
}
