@page "/depo/lokasyonlar"
@using System.Text.Json.Nodes
@inject ApiClient Api
@inject SessionState Session
@inject CrmLookups Lookups

<PageTitle>@Texts.Get("nav.app.warehouse.locations") · Modulix</PageTitle>

<AuthGate Module="@WarehouseAccess.ModuleKey" Permission="@WarehouseAccess.LocationsRead">
    <PageHeader Title="@Texts.Get("nav.app.warehouse.locations")" Icon="map-pin" Subtitle="@(page is null ? Texts.Get("warehouse.locations.intro") : Texts.Get("common.records", page.TotalCount))" />

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }

    @if (editing)
    {
        @* Her açılışta yeni bileşen: ön ayar (alt lokasyon ekle) değişince form baştan kurulur. *@
        <LocationEditor @key="editorKey" Location="selected" ParentPreset="parentPreset" FacilityPreset="FacilityFilter" Lookups="Lookups"
                        Saved="SavedAsync" Deleted="SavedAsync" Cancelled="Close" />
    }

    @* Görünümler sunucuda süzgeç olarak uygulanır; sayfalama ve toplam doğru kalır. *@
    <ViewTabs Items="ViewOptions" Value="@view" ValueChanged="ChooseViewAsync" Label="@Texts.Get("warehouse.locations.views")" NewView="StartNaming" />

    <div class="list-toolbar">
        <form class="search" @onsubmit="() => LoadAsync(1)" @onsubmit:preventDefault>
            <input class="form-control" type="search" aria-label="@Texts.Get("warehouse.locations.search")" placeholder="@Texts.Get("warehouse.searchCodeOrName")" @bind="search" />
        </form>
        <FilterToggle @bind-Open="filtersOpen" Count="ActiveFilters" />
        <GridColumnPicker State="grid" Changed="ColumnsChanged" />
        @if (Session.Can(WarehouseAccess.LocationsWrite) && !editing)
        {
            <button type="button" class="btn btn-primary" @onclick="() => Open(null, null)"><AppIcon Name="plus" Size="16" /> @Texts.Get("warehouse.locations.new")</button>
        }
    </div>

    @if (filtersOpen || ActiveFilters > 0)
    {
        <div class="filters">
            <select class="form-select" aria-label="@Texts.Get("warehouse.facility")" @bind="facilityId" @bind:after="() => LoadAsync(1)">
                <option value="">@Texts.Get("warehouse.allFacilities")</option>
                @foreach (var (id, name) in facilities.OrderBy(f => f.Value, StringComparer.CurrentCulture))
                {
                    <option value="@id">@name</option>
                }
            </select>
            <select class="form-select" aria-label="@Texts.Get("warehouse.zone")" @bind="zoneId" @bind:after="() => LoadAsync(1)">
                <option value="">@Texts.Get("warehouse.allZones")</option>
                @foreach (var (id, name) in zones.OrderBy(z => z.Value, StringComparer.CurrentCulture))
                {
                    <option value="@id">@name</option>
                }
            </select>
        </div>
    }

    <PersonalViewBar Active="Active" Dirty="grid.Differs(Active)" Naming="views.Naming" NamingChanged="views.StartNaming" Error="@views.Error"
                     SaveAs="SaveAsAsync" UpdateView="UpdateViewAsync" DiscardChanges="DiscardAsync" DeleteView="DeleteViewAsync" />

    @if (page is null)
    {
        <LoadingState Kind="LoadingKind.Table" />
    }
    else if (page.Items.Count == 0)
    {
        <EmptyState Compact="true" Title="@Texts.Get("warehouse.locations.empty")" />
    }
    else
    {
        <p class="visually-hidden" role="status" aria-live="polite">@Texts.Get("warehouse.locations.listed", page.TotalCount)</p>
        <table class="table record-table">
            <caption class="visually-hidden">@Texts.Get("warehouse.locations.caption")</caption>
            <thead>
                <tr>
                    @foreach (var column in grid.VisibleColumns)
                    {
                        <GridHeader Column="column" State="grid" SortChanged="SortAsync" />
                    }
                    <th scope="col" class="row-menu-cell"><span class="visually-hidden">@Texts.Get("common.actions")</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var location in page.Items)
                {
                    <tr>
                        @foreach (var column in grid.VisibleColumns)
                        {
                            @Cell(column, location)
                        }
                        <td class="row-menu-cell">
                            @if (Session.Can(WarehouseAccess.LocationsWrite))
                            {
                                <RowMenu Label="@Texts.Get("common.rowActionsOf", WarehouseLabels.Text(location, "code"))">
                                    <button type="button" class="view-menu-item" role="menuitem" @onclick="() => Open(null, location)"><AppIcon Name="plus" Size="16" /> <span>@Texts.Get("warehouse.locations.addChild")</span></button>
                                    <button type="button" class="view-menu-item" role="menuitem" @onclick="() => Open(location, null)"><AppIcon Name="pencil" Size="16" /> <span>@Texts.Get("common.edit")</span></button>
                                </RowMenu>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager PageSizeChoice="true" Page="page.Page" PageSize="page.PageSize" TotalCount="page.TotalCount" PageChanged="LoadAsync" />
    }
</AuthGate>

@code {
    private static readonly string Url = "/api/records/" + WarehouseAccess.LocationEntityKey;

    private const string AllViews = "all";
    private const string RootView = "root";
    private const string ActiveView = "active";
    private const string InactiveView = "inactive";

    // Sütunların sırası varsayılan sıradır; sıralama anahtarları kayıt deposunun beyanıdır (WarehouseRecordStore.SortKeys).
    // Varsayılan sıra tesis koduna, sonra lokasyon koduna göredir.
    private static GridColumnDef[] BaseColumns =>
    [
        new("code", Texts.Get("warehouse.code"), "hash", "code", "-code", Locked: true),
        new("name", Texts.Get("common.field.name"), "type", "name", "-name"),
        new("facility", Texts.Get("warehouse.facility"), "warehouse", "facility", "-facility"),
        new("zone", Texts.Get("warehouse.zone"), "layers", "zone", "-zone"),
        new("depth", Texts.Get("warehouse.depth"), "list", "depth", "-depth"),
        new("isActive", Texts.Get("common.field.status"), "tag", "isActive", "-isActive"),
    ];

    private readonly GridViewState grid = new("warehouse.locations", "facility");
    private PersonalGridViews views = default!;
    private RecordPageResponse? page;
    private RecordResponse? selected;
    private RecordResponse? parentPreset;
    private Dictionary<Guid, string> facilities = [];
    private Dictionary<Guid, string> zones = [];
    private bool editing;
    private bool filtersOpen;
    private int editorKey;
    private string? message;
    private string? search;
    private string view = AllViews;
    private string? root;
    private string? isActive;
    private string facilityId = "";
    private string zoneId = "";

    private int ActiveFilters => (facilityId.Length > 0 ? 1 : 0) + (zoneId.Length > 0 ? 1 : 0);

    private Guid? FacilityFilter => Guid.TryParse(facilityId, out var id) ? id : null;

    protected override async Task OnInitializedAsync()
    {
        views = new PersonalGridViews(Api, "warehouse.locations");
        await Session.EnsureLoadedAsync();
        if (Session.Can(WarehouseAccess.LocationsRead))
        {
            await Lookups.LoadAsync();
            facilities = await WarehouseLabels.NamesAsync(Api, WarehouseAccess.FacilityEntityKey, f => WarehouseLabels.Text(f, "code") + " · " + WarehouseLabels.Text(f, "name"));
            zones = await WarehouseLabels.NamesAsync(Api, WarehouseAccess.ZoneEntityKey, z => WarehouseLabels.Text(z, "code") + " · " + WarehouseLabels.Text(z, "name"));
            grid.Define([.. BaseColumns, .. Lookups.FieldsOf(WarehouseAccess.LocationEntityKey).Select(f => new GridColumnDef("custom." + f.Key, f.Label, "type", DefaultVisible: f.ShowInList))]);
            await views.LoadAsync();
            await LoadAsync(1);
        }
    }

    private GridViewDto? Active => views.Find(view);

    // Görünümler yalnızca süzgeçtir (Tümü, Kök, Etkin, Pasif, kişisel); tesis ve alan seçimleri "Filtrele" ile açılır. Yetki ve kapsamı sunucu uygular.
    private IReadOnlyList<ViewOption> ViewOptions =>
    [
        new(AllViews, Texts.Get("warehouse.locations.view.all"), Icon: "map-pin"),
        new(RootView, Texts.Get("warehouse.locations.view.root"), Icon: "landmark"),
        new(ActiveView, Texts.Get("warehouse.locations.view.active"), Icon: "check-circle"),
        new(InactiveView, Texts.Get("warehouse.locations.view.inactive"), Icon: "clock"),
        .. views.Options,
    ];

    private async Task ChooseViewAsync(string key)
    {
        view = key;
        views.StartNaming(false);
        if (Active is { } saved)
        {
            // Kişisel görünüm: sütunlar, sıralama ve süzgeç birlikte gelir.
            grid.Apply(saved);
            var filters = GridFilters.Parse(saved.Filters);
            root = filters.GetValueOrDefault("root");
            isActive = filters.GetValueOrDefault("isActive");
            facilityId = filters.GetValueOrDefault("facilityId") ?? "";
            zoneId = filters.GetValueOrDefault("zoneId") ?? "";
        }
        else
        {
            grid.Reset();
            root = key == RootView ? "true" : null;
            isActive = key switch { ActiveView => "true", InactiveView => "false", _ => null };
            facilityId = zoneId = "";
        }

        await LoadAsync(1);
    }

    private async Task SortAsync(string key)
    {
        grid.Sort = key;
        await LoadAsync(1);
    }

    // Sütun seçimi/sırası değişince veri yeniden çekilmez; olay işleyicisi sayfada olduğu için tablo yeniden çizilir.
    private Task ColumnsChanged() => Task.CompletedTask;

    private string? CurrentFilters => GridFilters.Build(
        root is { } r ? ("root", r) : null, isActive is { } a ? ("isActive", a) : null, ("facilityId", facilityId), ("zoneId", zoneId));

    private void StartNaming() => views.StartNaming(true);

    private async Task SaveAsAsync(string name)
    {
        if (await views.SaveAsAsync(grid.ToRequest(name, CurrentFilters)) is { } key)
        {
            view = key;
        }
    }

    private async Task UpdateViewAsync()
    {
        if (Active is { } current)
        {
            await views.UpdateAsync(current, grid.ToRequest(current.Name, CurrentFilters));
        }
    }

    private async Task DiscardAsync() => await ChooseViewAsync(view);

    private async Task DeleteViewAsync()
    {
        if (Active is { } current && await views.DeleteAsync(current))
        {
            await ChooseViewAsync(AllViews);
        }
    }

    private async Task LoadAsync(int pageNumber)
    {
        var url = $"{Url}?page={pageNumber}&pageSize={ListPaging.Size}&search={Uri.EscapeDataString(search ?? string.Empty)}";
        if (grid.Sort != grid.DefaultSort)
        {
            url += $"&sort={Uri.EscapeDataString(grid.Sort)}";
        }

        foreach (var (name, value) in new[] { ("root", root ?? ""), ("isActive", isActive ?? ""), ("facilityId", facilityId), ("zoneId", zoneId) })
        {
            if (value.Length > 0)
            {
                url += $"&{name}={Uri.EscapeDataString(value)}";
            }
        }

        var result = await Api.GetAsync<RecordPageResponse>(url);
        page = result.Value;
        message = result.Error;
    }

    private RenderFragment Cell(GridColumnDef column, RecordResponse location) => @<td data-label="@column.Label" class="@(column.Key == "code" ? "primary" : null)">@CellContent(column.Key, location)</td>;

    private RenderFragment CellContent(string key, RecordResponse location) => key switch
    {
        "code" => @<text>@WarehouseLabels.Text(location, "code")</text>,
        "name" => @<text>@WarehouseLabels.Text(location, "name")</text>,
        "facility" => @<text>@WarehouseLabels.NameOf(facilities, WarehouseLabels.Id(location, "facilityId"))</text>,
        "zone" => @<text>@(WarehouseLabels.Id(location, "zoneId") is { } zone ? WarehouseLabels.NameOf(zones, zone) : "—")</text>,
        "depth" => @<text>@WarehouseLabels.Number(location, "depth")</text>,
        "isActive" => @<span class="badge @WarehouseLabels.ActiveBadge(WarehouseLabels.Flag(location, "isActive"))">@WarehouseLabels.ActiveText(WarehouseLabels.Flag(location, "isActive"))</span>,
        _ when key.StartsWith("custom.", StringComparison.Ordinal) && Lookups.FieldsOf(WarehouseAccess.LocationEntityKey).FirstOrDefault(f => "custom." + f.Key == key) is { } field =>
            @<text>@CustomFieldText.Format(field, location.Values["custom"] as JsonObject)</text>,
        _ => @<text></text>,
    };

    private void Open(RecordResponse? location, RecordResponse? parent)
    {
        selected = location;
        parentPreset = parent;
        editorKey++;
        editing = true;
        message = null;
    }

    private void Close() => editing = false;

    private async Task SavedAsync()
    {
        editing = false;
        await LoadAsync(page?.Page ?? 1);
    }
}
