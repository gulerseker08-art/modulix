@page "/depo"
@page "/depo/pano"
@using System.Globalization
@inject ApiClient Api
@inject SessionState Session

<PageTitle>@Texts.Get("warehouse.dashboard.title") · Modulix</PageTitle>

@* Depo ve antrepo panosu. Her bölüm kendi okuma iznine bağlıdır ve sunucuda süzülür: izni olmayana bölüm hiç gelmez (yalnızca gizlenmez).
   Tesis süzgeci lokasyon, doluluk ve hareket bölümlerine uygulanır; beyanname, vekâlet ve stok kartı tesise bağlı değildir. Sayılar adettir. *@
<AuthGate Module="@WarehouseAccess.ModuleKey" Permission="@WarehouseAccess.FacilitiesRead">
    <PageHeader Title="@Texts.Get("warehouse.dashboard.title")" Icon="warehouse" Subtitle="@Texts.Get("warehouse.dashboard.subtitle")">
        <select class="form-select dash-filter" aria-label="@Texts.Get("warehouse.facility")" @bind="facility" @bind:after="LoadAsync" disabled="@loading">
            <option value="">@Texts.Get("warehouse.allFacilities")</option>
            @foreach (var option in facilities)
            {
                <option value="@option.Id">@option.Label</option>
            }
        </select>
        <div class="segmented" role="group" aria-label="@Texts.Get("warehouse.dashboard.period")">
            @foreach (var option in Periods)
            {
                <button type="button" class="chip @(days == option ? "active" : null)" aria-pressed="@(days == option ? "true" : "false")" disabled="@loading"
                        @onclick="() => ChooseDaysAsync(option)">@Texts.Get("warehouse.dashboard.days", option)</button>
            }
        </div>
    </PageHeader>

    @if (loading && data is null)
    {
        <LoadingState />
    }

    @if (error is not null)
    {
        <div class="alert alert-danger" role="alert">
            @error
            <button type="button" class="btn btn-outline-secondary btn-sm ms-2" disabled="@loading" @onclick="LoadAsync">@Texts.Get("crm.sales.retry")</button>
        </div>
    }

    @if (data is { } d)
    {
        <div class="dash-kpis" role="group" aria-label="@Texts.Get("warehouse.dashboard.summary")">
            @if (d.Facilities is { } f)
            {
                <DashKpi Label="@Texts.Get("warehouse.dashboard.kpi.facilities")" Icon="warehouse" Value="@Count(f.Active)"
                         Detail="@(f.CustomsEnabled == 0 ? Texts.Get("warehouse.dashboard.kpi.noCustoms") : Texts.Get("warehouse.dashboard.kpi.customs", Count(f.CustomsEnabled)))" />
            }
            @if (d.Occupancy is { } o)
            {
                <DashKpi Label="@Texts.Get("warehouse.dashboard.kpi.occupancy")" Icon="map-pin" Tone="teal" Value="@(o.Locations == 0 ? "—" : Percent(o.Occupied, o.Locations))"
                         Detail="@(o.Locations == 0 ? Texts.Get("warehouse.dashboard.kpi.noLocations") : Texts.Get("warehouse.dashboard.kpi.occupied", Count(o.Occupied), Count(o.Locations)))" />
            }
            @if (d.StockItems is { } s)
            {
                <DashKpi Label="@Texts.Get("warehouse.dashboard.kpi.stockItems")" Icon="package" Tone="success" Value="@Count(s.Active)"
                         Delta="@(s.NewInPeriod > 0 ? Texts.Get("warehouse.dashboard.kpi.newItems", Count(s.NewInPeriod)) : null)" DeltaTrend="1" Detail="@Texts.Get("warehouse.dashboard.kpi.addedInDays", d.Days)" />
            }
            @if (d.Declarations is { } decl)
            {
                <DashKpi Label="@Texts.Get("warehouse.dashboard.kpi.drafts")" Icon="clipboard-list" Tone="warning" Value="@Count(InCategory(decl, DraftCategory))"
                         Detail="@Texts.Get("warehouse.dashboard.kpi.registered", Count(InCategory(decl, RegisteredCategory)))" />
            }
        </div>

        <div class="dash-day">
            <div class="dash-day-col">
                @if (d.Movements is { } m)
                {
                    <section class="dash-card" aria-labelledby="wh-movements">
                        <div class="dash-card-head"><h2 id="wh-movements">@Texts.Get("nav.app.warehouse.stock-movements")</h2><span class="small text-muted">@Texts.Get("warehouse.dashboard.movements.subtitle", d.Days)</span></div>
                        @if (m.Daily.All(x => x.Inbound == 0 && x.Outbound == 0 && x.Transfer == 0 && x.Adjustment == 0))
                        {
                            <p class="text-muted mb-0">@Texts.Get("warehouse.dashboard.movements.none")</p>
                        }
                        else
                        {
                            <PairColumnChart Title="@Texts.Get("warehouse.dashboard.movements.chart", d.Days)" FirstName="@Texts.Get("warehouse.dashboard.movements.in")" SecondName="@Texts.Get("warehouse.dashboard.movements.out")"
                                             Items="@(m.Daily.Select(x => new PairColumnChart.Item(x.Day.ToString("d MMM", UiLanguage.Culture), x.Day.ToString("d MMMM yyyy", UiLanguage.Culture), x.Inbound, x.Outbound)).ToList())" />
                        }
                        <div class="dash-totals">
                            <span>@Texts.Strong("warehouse.dashboard.totals.in", Count(m.Inbound))</span>
                            <span>@Texts.Strong("warehouse.dashboard.totals.out", Count(m.Outbound))</span>
                            <span>@Texts.Strong("warehouse.dashboard.totals.transfer", Count(m.Transfer))</span>
                        </div>
                    </section>
                }

                @if (d.Occupancy is { } occ)
                {
                    <section class="dash-card" aria-labelledby="wh-occupancy">
                        <div class="dash-card-head">
                            <h2 id="wh-occupancy">@Texts.Get("warehouse.dashboard.occupancy.title")</h2>
                            <a href="depo/tesisler">@Texts.Get("warehouse.allFacilities")</a>
                        </div>
                        @if (occ.ByFacility.Count == 0)
                        {
                            <p class="text-muted mb-0">@Texts.Get("warehouse.dashboard.occupancy.none") <a href="depo/lokasyonlar">@Texts.Get("warehouse.dashboard.occupancy.define")</a></p>
                        }
                        else
                        {
                            <ul class="dash-list">
                                @foreach (var row in occ.ByFacility)
                                {
                                    var share = row.Locations == 0 ? 0m : row.Occupied / (decimal)row.Locations * 100m;
                                    <li>
                                        <div class="dash-list-main">
                                            <a href="depo/lokasyonlar" title="@row.Name">@row.Name</a>
                                            <small>@row.Code@(row.CustomsEnabled ? $" · {Texts.Get("warehouse.dashboard.occupancy.customs")}" : null) · @Texts.Get("warehouse.dashboard.occupancy.locations", Count(row.Occupied), Count(row.Locations))</small>
                                        </div>
                                        <div class="dash-meter" aria-hidden="true">
                                            <i class="@(share >= HighOccupancy ? "chart-fill-2" : "chart-fill-0")" style="width:@share.ToString("0.#", CultureInfo.InvariantCulture)%"></i>
                                        </div>
                                        <span class="dash-num">@Percent(row.Occupied, row.Locations)</span>
                                    </li>
                                }
                            </ul>
                        }
                    </section>
                }

                @if (d.Movements is { } recent)
                {
                    <section class="dash-card" aria-labelledby="wh-recent">
                        <div class="dash-card-head"><h2 id="wh-recent">@Texts.Get("warehouse.dashboard.recent.title")</h2></div>
                        @if (recent.Recent.Count == 0)
                        {
                            <p class="text-muted mb-0">@Texts.Get("warehouse.dashboard.recent.none")</p>
                        }
                        else
                        {
                            <ul class="dash-list">
                                @foreach (var row in recent.Recent)
                                {
                                    <li>
                                        <span class="badge @MovementBadge(row.Category)">@row.TypeLabel</span>
                                        <div class="dash-list-main">
                                            <strong class="small">@ItemText(row)</strong>
                                            <small class="d-block">@Route(row) · @Regional.ToTenant(row.OccurredAt).ToString($"{Regional.DatePattern} {Regional.TimePattern}", CultureInfo.InvariantCulture)</small>
                                        </div>
                                        <span class="dash-num">@row.Quantity.ToString("#,0.###", Regional.Numbers)</span>
                                    </li>
                                }
                            </ul>
                        }
                    </section>
                }
            </div>

            <div class="dash-day-col">
                @if (d.Declarations is { } decls)
                {
                    var total = decls.ByStatus.Sum(x => x.Count);
                    <section class="dash-card" aria-labelledby="wh-declarations">
                        <div class="dash-card-head">
                            <h2 id="wh-declarations">@Texts.Get("warehouse.dashboard.declarations.title")</h2>
                            <a href="depo/beyannameler">@Texts.Get("nav.app.warehouse.customs-declarations")</a>
                        </div>
                        @if (total == 0)
                        {
                            <p class="text-muted mb-0">@Texts.Get("warehouse.dashboard.declarations.none")</p>
                        }
                        else
                        {
                            <div class="stack-bar" role="img" aria-label="@string.Join(", ", decls.ByStatus.Where(x => x.Count > 0).Select(x => $"{x.Label} {x.Count}"))">
                                @foreach (var status in decls.ByStatus.Where(x => x.Count > 0))
                                {
                                    <i class="@StatusFill(status.Category)" style="width:@((status.Count / (decimal)total * 100m).ToString("0.##", CultureInfo.InvariantCulture))%"></i>
                                }
                            </div>
                            <ul class="dash-list">
                                @foreach (var status in decls.ByStatus)
                                {
                                    <li>
                                        <span class="dash-swatch @StatusFill(status.Category)" aria-hidden="true"></span>
                                        <span class="dash-list-main small">@status.Label</span>
                                        <span class="dash-num">@Count(status.Count)</span>
                                    </li>
                                }
                            </ul>
                        }
                    </section>
                }

                <section class="dash-card" aria-labelledby="wh-attention">
                    <div class="dash-card-head"><h2 id="wh-attention" class="dash-card-title"><AppIcon Name="alert-circle" Size="18" /> @Texts.Get("warehouse.dashboard.attention.title")</h2></div>
                    @if (Attention(d).Count == 0)
                    {
                        <p class="text-muted mb-0">@Texts.Get("warehouse.dashboard.attention.none")</p>
                    }
                    else
                    {
                        <ul class="dash-list">
                            @foreach (var item in Attention(d))
                            {
                                <li>
                                    <span class="dash-kpi-icon tone-@item.Tone" aria-hidden="true"><AppIcon Name="@item.Icon" Size="18" /></span>
                                    <div class="dash-list-main">
                                        <a href="@item.Href">@item.Title</a>
                                        <small>@item.Detail</small>
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                </section>

                <p class="small text-muted mb-0">
                    @Texts.Get("warehouse.dashboard.note")
                    @if (d.FacilityId is not null)
                    {
                        <span>@Texts.Get("warehouse.dashboard.facilityNote")</span>
                    }
                </p>
            </div>
        </div>
    }
</AuthGate>

@code {
    private const string DraftCategory = "draft";
    private const string RegisteredCategory = "registered";
    private const string CancelledCategory = "cancelled";
    private const decimal HighOccupancy = 85m;

    private static readonly int[] Periods = [7, 14, 30];

    private sealed record FacilityOption(Guid Id, string Label);

    private sealed record AttentionItem(string Icon, string Tone, string Title, string Detail, string Href);

    private WarehouseDashboardDto? data;
    private List<FacilityOption> facilities = [];
    private string facility = string.Empty;
    private int days = 14;
    private string? error;
    private bool loading;
    private int requestId;

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (!Session.Can(WarehouseAccess.FacilitiesRead))
        {
            return;
        }

        var list = await Api.GetAsync<RecordPageResponse>($"/api/records/{WarehouseAccess.FacilityEntityKey}?isActive=true&pageSize=200&sort=code");
        facilities = [.. (list.Value?.Items ?? []).Select(i => new FacilityOption(i.Id, $"{Text(i, "code")} · {Text(i, "name")}"))];
        await LoadAsync();
    }

    private async Task ChooseDaysAsync(int value)
    {
        days = value;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var current = ++requestId;
        loading = true;
        error = null;
        var url = $"/api/warehouse/dashboard?days={days}{(Guid.TryParse(facility, out var id) ? $"&facilityId={id}" : null)}";
        var result = await Api.GetAsync<WarehouseDashboardDto>(url);
        if (current != requestId)
        {
            return;
        }

        loading = false;
        if (result.IsSuccess)
        {
            data = result.Value;
        }
        else
        {
            error = result.Error ?? Texts.Get("warehouse.dashboard.loadFailed");
        }
    }

    private static string Text(RecordResponse item, string field) =>
        item.Values.TryGetPropertyValue(field, out var node) && node is not null ? node.ToString() : string.Empty;

    private static string Count(int value) => value.ToString("N0", Regional.Numbers);

    private static string Percent(int part, int whole) =>
        whole == 0 ? "—" : $"%{Math.Round(part / (decimal)whole * 100m).ToString("0", Regional.Numbers)}";

    private static int InCategory(WarehouseDeclarationSummaryDto declarations, string category) =>
        declarations.ByStatus.Where(s => s.Category == category).Sum(s => s.Count);

    // Durum rengi kategoriye göredir (adı firmanındır): taslak sarı, tescilli mavi, iptal gri, kategorisiz koyu mavi.
    private static string StatusFill(string? category) => category switch
    {
        DraftCategory => "chart-fill-2",
        RegisteredCategory => "chart-fill-0",
        CancelledCategory => "chart-fill-5",
        _ => "chart-fill-3",
    };

    private static string MovementBadge(string? category) => category switch
    {
        "in" => "stage-open",
        "out" => "stage-won",
        "transfer" => "stage-proposal",
        _ => "stage-onhold",
    };

    private static string ItemText(WarehouseRecentMovementDto row)
    {
        var item = row.StockItemCode is null ? null : $"{row.StockItemCode} {row.StockItemName}";
        var lot = row.LotNo is null ? null : Texts.Get("warehouse.dashboard.lot", row.LotNo);
        return string.Join(" · ", new[] { item, lot }.Where(x => x is not null)) is { Length: > 0 } text ? text : Texts.Get("warehouse.dashboard.movement");
    }

    private static string Route(WarehouseRecentMovementDto row) => (row.FromLocation, row.ToLocation) switch
    {
        ({ } from, { } to) => $"{from} → {to}",
        ({ } from, null) => from,
        (null, { } to) => to,
        _ => Texts.Get("warehouse.dashboard.noLocation"),
    };

    private IReadOnlyList<AttentionItem> Attention(WarehouseDashboardDto d)
    {
        var items = new List<AttentionItem>();
        if (d.Attorneys is { Expiring: > 0 } a)
        {
            items.Add(new("clock", "warning", Texts.Get("warehouse.dashboard.attention.attorneys", Count(a.Expiring), a.WindowDays),
                a.Nearest is { } nearest ? Texts.Get("warehouse.dashboard.attention.nearest", nearest.ToString(Regional.DatePattern, CultureInfo.InvariantCulture)) : string.Empty, "depo/vekaletler"));
        }

        if (d.Declarations is { StaleDrafts: > 0 } decl)
        {
            items.Add(new("clipboard-list", "danger", Texts.Get("warehouse.dashboard.attention.staleDrafts", Count(decl.StaleDrafts), decl.StaleDraftDays),
                string.Join(", ", decl.StaleSample.Select(x => x.RegistrationNo)), "depo/beyannameler"));
        }

        if (d.Occupancy is { PassiveWithStock: > 0 } occ)
        {
            items.Add(new("map-pin", "warning", Texts.Get("warehouse.dashboard.attention.passive", Count(occ.PassiveWithStock)),
                Texts.Get("warehouse.dashboard.attention.passiveDetail"), "depo/lokasyonlar"));
        }

        return items;
    }
}
