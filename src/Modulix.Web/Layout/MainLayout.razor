@inherits LayoutComponentBase
@implements IDisposable
@inject SessionState Session
@inject NavigationManager Navigation

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            @if (Session.IsSignedIn)
            {
                @* Firmanın logosu (Y6b), ayarlanmışsa. *@
                @if (Session.Logo is { } logo)
                {
                    <img class="tenant-logo" src="@logo.Url" alt="@Session.ActiveTenantName" />
                }
                <span class="avatar" aria-hidden="true">@Initials(Session.User!.DisplayName)</span>
                <span class="session-info text-truncate">
                    <a class="session-link" href="hesabim" title="Hesabım">@Session.User!.DisplayName</a>
                    @if (Session.ActiveTenantName is { } tenant)
                    {
                        <span class="text-muted"> · @tenant</span>
                    }
                </span>
                @if (Session.User.Memberships.Count > 1)
                {
                    <a href="tenant">Kuruluş değiştir</a>
                }
                @* İşletici şirket seçici (ADR-0008): yalnızca birden fazla şirkete erişim varsa görünür. *@
                @if (Session.HasMultipleCompanies)
                {
                    <label class="company-switcher">
                        <span class="visually-hidden">Aktif şirket</span>
                        <select class="form-select form-select-sm" disabled="@companyBusy"
                                @onchange="OnCompanyChanged" value="@Session.ActiveCompanyId">
                            @foreach (var company in Session.Companies)
                            {
                                <option value="@company.Id">@company.Name</option>
                            }
                        </select>
                    </label>
                }
                <button type="button" class="btn btn-link" @onclick="LogoutAsync">Çıkış</button>
            }
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        Session.Changed += OnChanged;
        await Session.EnsureLoadedAsync();
    }

    private bool companyBusy;

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private async Task OnCompanyChanged(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var companyId) && companyId != Session.ActiveCompanyId)
        {
            companyBusy = true;
            await Session.SelectCompanyAsync(companyId);
            companyBusy = false;
        }
    }

    private async Task LogoutAsync()
    {
        await Session.LogoutAsync();
        Navigation.NavigateTo("giris");
    }

    private static string Initials(string name) =>
        string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpper(p[0])));

    public void Dispose() => Session.Changed -= OnChanged;
}
