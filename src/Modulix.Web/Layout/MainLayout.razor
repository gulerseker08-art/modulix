@inherits LayoutComponentBase
@implements IDisposable
@inject SessionState Session
@inject NavigationManager Navigation

@* Ortak uygulama kabuğu (AppShell): sol menü + üst çubuk + içerik. Bütün oturumlu sayfalar bu düzeni kullanır;
   yeni modüller ayrı bir kabuk oluşturmaz (docs/design-system/README.md). *@
<a class="skip-link" href="@SkipHref">İçeriğe geç</a>

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <div class="app-main">
        <header class="top-row app-header px-4">
            @if (Session.IsSignedIn)
            {
                @* Firmanın logosu (Y6b), ayarlanmışsa. *@
                @if (Session.Logo is { } logo)
                {
                    <img class="tenant-logo" src="@logo.Url" alt="@Session.ActiveTenantName" />
                }

                @* Genel arama: yetki ve tenant sınırları sunucudaki liste uç noktalarından gelir (GlobalSearch). *@
                <div class="header-search">
                    <GlobalSearch />
                </div>

                <div class="header-tools">
                    @* İşletici şirket seçici (ADR-0008): yalnızca birden fazla şirkete erişim varsa görünür. *@
                    @if (Session.HasMultipleCompanies)
                    {
                        <label class="company-switcher">
                            <span class="visually-hidden">Aktif şirket</span>
                            <select class="form-select form-select-sm" disabled="@companyBusy"
                                    @onchange="OnCompanyChanged" value="@Session.ActiveCompanyId">
                                @foreach (var company in Session.Companies)
                                {
                                    <option value="@company.Id">@company.Name</option>
                                }
                            </select>
                        </label>
                    }

                    <ThemeToggle />

                    <div class="profile-menu" @onkeydown="OnProfileKeyDown">
                        <button type="button" class="profile-button" @onclick="ToggleProfile"
                                aria-haspopup="menu" aria-expanded="@(profileOpen ? "true" : "false")" aria-controls="profile-menu-list">
                            <span class="avatar" aria-hidden="true">@Initials(Session.User!.DisplayName)</span>
                            <span class="session-info">
                                <span class="session-name text-truncate">@Session.User!.DisplayName</span>
                                @if (Session.ActiveTenantName is { } tenant)
                                {
                                    <span class="session-tenant text-truncate">@tenant</span>
                                }
                            </span>
                            <AppIcon Name="chevron-down" Size="18" />
                        </button>

                        @if (profileOpen)
                        {
                            @* Menünün dışına tıklanınca kapanır. *@
                            <div class="menu-backdrop" @onclick="CloseProfile"></div>
                            <ul id="profile-menu-list" class="menu-list" role="menu" aria-label="Profil menüsü">
                                <li role="none">
                                    <a role="menuitem" href="hesabim" @onclick="CloseProfile">
                                        <AppIcon Name="user" Size="18" /> Hesabım
                                    </a>
                                </li>
                                @if (Session.User.Memberships.Count > 1)
                                {
                                    <li role="none">
                                        <a role="menuitem" href="tenant" @onclick="CloseProfile">
                                            <AppIcon Name="repeat" Size="18" /> Kuruluş değiştir
                                        </a>
                                    </li>
                                }
                                <li role="none">
                                    <button type="button" role="menuitem" @onclick="LogoutAsync">
                                        <AppIcon Name="log-out" Size="18" /> Çıkış
                                    </button>
                                </li>
                            </ul>
                        }
                    </div>
                </div>
            }
        </header>

        <main id="main-content" class="content px-4" tabindex="-1">
            <LicenseBanner />
            @if (Session.IsSignedIn)
            {
                <Breadcrumb />
            }
            @Body
        </main>
    </div>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        Session.Changed += OnChanged;
        await Session.EnsureLoadedAsync();
    }

    private bool companyBusy;
    private bool profileOpen;

    private string SkipHref => Navigation.ToBaseRelativePath(Navigation.Uri).Split('#')[0] + "#main-content";

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private void ToggleProfile() => profileOpen = !profileOpen;

    private void CloseProfile() => profileOpen = false;

    private void OnProfileKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            profileOpen = false;
        }
    }

    private async Task OnCompanyChanged(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var companyId) && companyId != Session.ActiveCompanyId)
        {
            companyBusy = true;
            await Session.SelectCompanyAsync(companyId);
            companyBusy = false;
        }
    }

    private async Task LogoutAsync()
    {
        profileOpen = false;
        await Session.LogoutAsync();
        Navigation.NavigateTo("giris");
    }

    private static string Initials(string name) =>
        string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpper(p[0])));

    public void Dispose() => Session.Changed -= OnChanged;
}
