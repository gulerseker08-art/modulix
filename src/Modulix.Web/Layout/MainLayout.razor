@inherits LayoutComponentBase
@implements IDisposable
@inject SessionState Session
@inject NavigationManager Navigation

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            @if (Session.IsSignedIn)
            {
                <span class="session-info text-truncate">
                    @Session.User!.DisplayName
                    @if (Session.ActiveTenantName is { } tenant)
                    {
                        <span class="text-muted"> · @tenant</span>
                    }
                </span>
                @if (Session.User.Memberships.Count > 1)
                {
                    <a href="tenant">Kuruluş değiştir</a>
                }
                <button type="button" class="btn btn-link" @onclick="LogoutAsync">Çıkış</button>
            }
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        Session.Changed += OnChanged;
        await Session.EnsureLoadedAsync();
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private async Task LogoutAsync()
    {
        await Session.LogoutAsync();
        Navigation.NavigateTo("giris");
    }

    public void Dispose() => Session.Changed -= OnChanged;
}
