@implements IDisposable
@inject SessionState Session
@inject AppNavigation Apps
@inject NavigationManager Navigation

<div class="top-row ps-3 navbar navbar-light">
    <div class="container-fluid">
        <AppLauncher />
        <button type="button" title="Menü" aria-label="Menü" aria-expanded="@(!collapseNavMenu ? "true" : "false")"
                class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="nav flex-column" aria-label="Sol menü">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <AppIcon Name="home" Size="18" /> Ana sayfa
            </NavLink>
        </div>

        @* Sol menü yalnızca aktif modülün sayfalarını gösterir; aktif modül route'tan bulunur (yenilemede ve doğrudan bağlantıda da). *@
        @if (activeRoot is not null)
        {
            <div class="nav-section px-3">Aktif modül</div>
            <div class="nav-module px-3">
                <AppIcon Name="@activeRoot.Icon" Size="20" />
                <span>@activeRoot.Name</span>
            </div>
            @foreach (AppDefinition app in children)
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="@app.Route" Match="@(app.ExactMatch ? NavLinkMatch.All : NavLinkMatch.Prefix)">
                        <AppIcon Name="@app.Icon" Size="18" /> @app.Name
                    </NavLink>
                </div>
            }
        }
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;
    private AppDefinition? activeRoot;
    private IReadOnlyList<AppDefinition> children = [];

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    protected override void OnInitialized()
    {
        Session.Changed += OnChanged;
        Navigation.LocationChanged += OnLocationChanged;
        Recompute();
    }

    private void Recompute()
    {
        AppDefinition? active = AppNavigation.Resolve(Navigation.ToBaseRelativePath(Navigation.Uri));
        AppDefinition? root = active is null ? null : Apps.RootOf(active);
        bool visible = root is not null && Apps.Roots().Any(r => r.Id == root.Id);
        activeRoot = visible ? root : null;
        children = activeRoot is null ? [] : Apps.Children(activeRoot.Id);
    }

    private void OnChanged() =>
        InvokeAsync(() =>
        {
            Recompute();
            StateHasChanged();
        });

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        Recompute();
        StateHasChanged();
    }

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    public void Dispose()
    {
        Session.Changed -= OnChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
