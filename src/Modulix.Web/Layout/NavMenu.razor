@implements IDisposable
@inject SessionState Session

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">
            <img src="img/modulix-mark.svg" alt="" width="28" height="28" />
            <span>modulix</span>
        </a>
        <button title="Menü" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Ana sayfa
            </NavLink>
        </div>

        @* Menü yalnızca tenant için açık modülleri ve kullanıcının görebildiği ekranları gösterir. *@
        @if (Session.IsModuleEnabled(CrmAccess.ModuleKey))
        {
            <div class="nav-section px-3">CRM</div>
            @foreach (var (href, label, permission) in CrmLinks)
            {
                @if (Session.Can(permission))
                {
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="@href">
                            <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> @label
                        </NavLink>
                    </div>
                }
            }
        }

        @if (Session.CanAny(CoreAccess.AdministrationPermissions))
        {
            <div class="nav-section px-3">Yönetim</div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="yonetim">
                    <span class="bi bi-gear-fill-nav-menu" aria-hidden="true"></span> Yönetim
                </NavLink>
            </div>
        }

        @* Platform yöneticisi (Y4): firmalar ve modül hakları. Firmaya üye değilse yalnızca bu bölümü görür. *@
        @if (Session.IsPlatformAdministrator)
        {
            <div class="nav-section px-3">Platform</div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="platform" Match="NavLinkMatch.All">
                    <span class="bi bi-gear-fill-nav-menu" aria-hidden="true"></span> Platform
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="platform/firmalar">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Firmalar
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="platform/moduller">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Modül hakları
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="platform/katalog">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Modül kataloğu
                </NavLink>
            </div>
        }
    </nav>
</div>

@code {
    private static readonly (string Href, string Label, string Permission)[] CrmLinks =
    [
        ("crm/firmalar", "Firmalar", CrmAccess.CompaniesRead),
        ("crm/kisiler", "Kişiler", CrmAccess.ContactsRead),
        ("crm/firsatlar", "Fırsatlar", CrmAccess.OpportunitiesRead),
        ("crm/aktiviteler", "Aktiviteler", CrmAccess.ActivitiesRead),
    ];

    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    protected override void OnInitialized() => Session.Changed += OnChanged;

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    public void Dispose() => Session.Changed -= OnChanged;
}
