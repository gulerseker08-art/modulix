@implements IDisposable
@inject SessionState Session
@inject AppNavigation Apps
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="top-row ps-3 navbar navbar-light">
    <div class="container-fluid">
        <AppLauncher />
        <button type="button" title="@Texts.Get("shell.nav.menu")" aria-label="@Texts.Get("shell.nav.menu")" aria-expanded="@(!collapseNavMenu ? "true" : "false")"
                class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable">
    <nav class="nav flex-column" aria-label="@Texts.Get("shell.nav.label")">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All" title="@Texts.Get("shell.nav.home")" @onclick="CloseMobileMenu">
                <AppIcon Name="home" Size="20" /> <span class="nav-label">@Texts.Get("shell.nav.home")</span>
            </NavLink>
        </div>

        @* Sol menü yalnızca aktif uygulamanın ekranlarını gösterir; aktif uygulama route'tan bulunur (yenilemede ve doğrudan bağlantıda da).
           Bölümler ve bağlantılar AppCatalog metadata'sından, tenant'ın açık modüllerine ve kullanıcının izinlerine göre süzülerek gelir;
           boş bölüm çıkmaz. Etkin ekranın bölümü açık gelir; "Footer" bölümler (CRM Ayarları) kaydırma alanının altına sabitlenir. *@
        @if (menu is not null)
        {
            <div class="nav-section px-3"><span class="nav-label">@Texts.Get("shell.nav.activeModule")</span></div>
            <div class="nav-module mx-3" title="@AppNames.Of(menu.Root)">
                <AppIcon Name="@menu.Root.Icon" Size="20" />
                <span class="nav-label">@AppNames.Of(menu.Root)</span>
            </div>

            @foreach (MenuSection section in menu.Sections.Where(s => s.Group is not { Footer: true }))
            {
                @Group(section)
            }

            @if (menu.Sections.Any(s => s.Group is { Footer: true }))
            {
                <div class="nav-pinned">
                    @foreach (MenuSection section in menu.Sections.Where(s => s.Group is { Footer: true }))
                    {
                        @Group(section)
                    }
                </div>
            }
        }
    </nav>
</div>

@* Menüyü daralt / genişlet (yalnızca geniş ekranda; telefonda menü açılır panel olarak çalışır). *@
<div class="nav-footer px-3">
    <button type="button" class="nav-collapse-button" @onclick="ToggleSidebarAsync"
            aria-pressed="@(sidebarCollapsed ? "true" : "false")" title="@(Texts.Get(sidebarCollapsed ? "shell.nav.expand" : "shell.nav.collapse"))">
        <AppIcon Name="@(sidebarCollapsed ? "panel-left-open" : "panel-left-close")" Size="20" />
        <span class="nav-label">@Texts.Get(sidebarCollapsed ? "shell.nav.expand" : "shell.nav.collapse")</span>
    </button>
</div>

@code {
    private bool collapseNavMenu = true;
    private bool sidebarCollapsed;
    private MenuContext? menu;
    private readonly HashSet<string> expanded = [];

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    protected override void OnInitialized()
    {
        Session.Changed += OnChanged;
        Navigation.LocationChanged += OnLocationChanged;
        Recompute();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            bool collapsed = await JS.InvokeAsync<bool>("modulixShell.isSidebarCollapsed");
            if (collapsed)
            {
                sidebarCollapsed = true;
                StateHasChanged();
            }
        }
    }

    // Bölüm başlığı (açılır/kapanır) ve bağlantıları. Başlıksız küme (grubu tanımsız ekranlar) düz bağlantı listesidir.
    private RenderFragment Group(MenuSection section) => @<div class="nav-group px-3">
        @if (section.Group is { } group)
        {
            bool open = expanded.Contains(group.Id);
            bool hasActive = section.Entries.Any(e => e.App.Id == menu!.Active.Id);
            string listId = "nav-group-" + group.Id;
            <button type="button" class="nav-group-header @(hasActive ? "has-active" : null)" title="@AppNames.Of(group)"
                    aria-expanded="@(open ? "true" : "false")" aria-controls="@listId" @onclick="() => ToggleGroupAsync(group.Id)">
                <AppIcon Name="@(group.Icon ?? "list")" Size="20" />
                <span class="nav-label">@AppNames.Of(group)</span>
                <span class="nav-chevron nav-label"><AppIcon Name="@(open ? "chevron-down" : "chevron-right")" Size="16" /></span>
            </button>
            @if (open)
            {
                <ul id="@listId" class="nav-sub">
                    @foreach (MenuEntry entry in section.Entries)
                    {
                        @Link(entry)
                    }
                </ul>
            }
        }
        else
        {
            <ul class="nav-sub nav-sub-flat">
                @foreach (MenuEntry entry in section.Entries)
                {
                    @Link(entry)
                }
            </ul>
        }
    </div>;

    private RenderFragment Link(MenuEntry entry) => @<li>
        <a class="nav-sublink @(IsActive(entry) ? "active" : null)" href="@entry.Link" title="@entry.Name"
           aria-current="@(IsActive(entry) ? "page" : null)" @onclick="CloseMobileMenu">
            <span class="nav-bullet" aria-hidden="true"></span>
            <span class="nav-label">@entry.Name</span>
        </a>
    </li>;

    private bool IsActive(MenuEntry entry) => menu?.Active.Id == entry.App.Id;

    private void Recompute()
    {
        menu = Apps.Context(Navigation.ToBaseRelativePath(Navigation.Uri));

        // Etkin ekranın bölümü açık gelir; kullanıcının açtığı bölümler sayfa değişiminde de açık kalır.
        if (menu is not null)
        {
            MenuSection? withActive = menu.Sections.FirstOrDefault(s => s.Group is not null && s.Entries.Any(e => e.App.Id == menu.Active.Id));
            if (withActive?.Group is { } group)
            {
                expanded.Add(group.Id);
            }
        }
    }

    private void OnChanged() =>
        InvokeAsync(() =>
        {
            Recompute();
            StateHasChanged();
        });

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        Recompute();
        StateHasChanged();
    }

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    // Telefonda bir bağlantıya tıklanınca açılır panel kapanır; bölüm başlıklarına tıklamak paneli kapatmaz.
    private void CloseMobileMenu()
    {
        collapseNavMenu = true;
    }

    private async Task ToggleGroupAsync(string groupId)
    {
        // Daraltılmış menüde (yalnızca ikonlar) bölüm başlığına tıklamak menüyü genişletir ve o bölümü açar.
        if (sidebarCollapsed)
        {
            await ToggleSidebarAsync();
            expanded.Add(groupId);
            return;
        }

        if (!expanded.Remove(groupId))
        {
            expanded.Add(groupId);
        }
    }

    private async Task ToggleSidebarAsync()
    {
        sidebarCollapsed = await JS.InvokeAsync<bool>("modulixShell.setSidebarCollapsed", !sidebarCollapsed);
    }

    public void Dispose()
    {
        Session.Changed -= OnChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
