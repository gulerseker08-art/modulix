@* Satış genel görünümü kart ayrıntısını dışa aktarır (ADR-0035). Yalnızca core.reports.export izni olana görünür. Dosya sunucuda ekrandaki kartla aynı
   hesaptan, çağıranın yetkisiyle üretilir (tutar izni yoksa tutar sütunları dosyada olmaz); rapor merkezinin dışa aktarma dosyasıdır (24 saat, sahibine özel). *@
@inject ApiClient Api
@inject SessionState Session
@inject IJSRuntime Js

@if (Session.Can(ReportAccess.Read) && Session.Can(ReportAccess.Export))
{
    <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
        <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@busy" @onclick='() => RunExportAsync("csv")'>
            @if (busy) { <span class="spinner-border spinner-border-sm" aria-hidden="true"></span> }
            @Texts.Get("crm.sales.export.csv")
        </button>
        <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@busy" @onclick='() => RunExportAsync("xlsx")'>@Texts.Get("crm.sales.export.xlsx")</button>

        <div aria-live="polite">
            @if (error is not null)
            {
                <span class="text-danger" role="alert">@error</span>
            }
            else if (export is not null)
            {
                <span role="status"><strong>@Texts.Get("crm.sales.export.ready")</strong> @Texts.Get("crm.sales.export.file", export.FileName, export.RowCount.ToString("N0", Regional.Numbers))</span>
                <button type="button" class="btn btn-primary btn-sm ms-2" disabled="@busy" @onclick="DownloadAsync">@Texts.Get("crm.sales.export.download")</button>
                <a class="ms-2" href="raporlar/disa-aktarimlar">@Texts.Get("crm.sales.export.mine")</a>
            }

            @if (downloadError is not null)
            {
                <span class="text-danger" role="alert">@downloadError</span>
            }
        </div>
    </div>
}

@code {
    private ReportExportDto? export;
    private string? error;
    private string? downloadError;
    private bool busy;

    /// <summary>Kart anahtarı (<c>SalesCards</c>).</summary>
    [Parameter, EditorRequired] public string Card { get; set; } = string.Empty;

    /// <summary>Ekranın uyguladığı sorgu (dönem, kullanıcı, para birimi); kart ayrıntısıyla aynıdır.</summary>
    [Parameter, EditorRequired] public string Query { get; set; } = string.Empty;

    protected override void OnParametersSet()
    {
        // Kart ya da süzgeç değişince eski dosya bilgisi yanıltmasın.
        if (!string.Equals(lastKey, Card + "?" + Query, StringComparison.Ordinal))
        {
            lastKey = Card + "?" + Query;
            export = null;
            error = null;
            downloadError = null;
        }
    }

    private string? lastKey;

    private async Task RunExportAsync(string format)
    {
        busy = true;
        error = null;
        downloadError = null;
        export = null;
        var result = await Api.PostAsync<ReportExportDto>($"/api/crm/sales/overview/cards/{Card}/exports?{Query}&format={format}", new { });
        busy = false;
        if (result.IsSuccess)
        {
            export = result.Value;
            return;
        }

        error = result.Status == System.Net.HttpStatusCode.Forbidden
            ? Texts.Get("crm.sales.export.forbidden", result.Error)
            : result.Error;
    }

    private async Task DownloadAsync()
    {
        if (export is null)
        {
            return;
        }

        busy = true;
        downloadError = await ReportExportDownloads.DownloadAsync(Api, Js, export);
        busy = false;
    }
}
