@inject IJSRuntime JS

@* Açık/koyu tema düğmesi. Tercih tarayıcıda saklanır (js/shell.js); varsayılan açık temadır. *@
<button type="button" class="icon-button" @onclick="ToggleAsync"
        aria-pressed="@(dark ? "true" : "false")" title="@(dark ? "Açık temaya geç" : "Koyu temaya geç")">
    <AppIcon Name="@(dark ? "sun" : "moon")" Size="20" />
    <span class="visually-hidden">Koyu tema</span>
</button>

@code {
    private bool dark;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            string theme = await JS.InvokeAsync<string>("modulixShell.getTheme");
            if (theme == "dark")
            {
                dark = true;
                StateHasChanged();
            }
        }
    }

    private async Task ToggleAsync()
    {
        string theme = await JS.InvokeAsync<string>("modulixShell.toggleTheme");
        dark = theme == "dark";
    }
}
