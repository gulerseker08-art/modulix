@* Bir kaydın süreli belgeleri (ADR-0038 K3): araç kartında muayene, sigorta; sürücü kartında ehliyet, SRC, psikoteknik. Liste bitişi en yakın
   olandan başlar; durum rozeti bugüne göre hesaplanır (geçerli, gün kaldı, süresi doldu, iptal). Belgeler genel kayıt uçlarından
   (/api/records/core.credential?ownerEntityKey=&ownerId=) okunur ve yazılır; erişim sunucuda sahip kaydın erişimidir. *@
@inject ApiClient Api

<section class="settings-group" aria-label="@PanelTitle">
    <h2>@PanelTitle</h2>

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }

    @if (editing)
    {
        <CredentialEditor Credential="selected" OwnerEntityKey="@OwnerEntityKey" OwnerId="OwnerId" Category="@Category" Lookups="Lookups" CanWrite="CanWrite"
                          Saved="SavedAsync" Deleted="SavedAsync" Cancelled="Close" />
    }
    else if (CanWrite)
    {
        <div class="form-actions">
            <button type="button" class="btn btn-tonal" @onclick="() => Open(null)"><AppIcon Name="plus" Size="16" /> @Texts.Get("credentials.panel.add")</button>
        </div>
    }

    @if (items is null)
    {
        <LoadingState Kind="LoadingKind.Table" />
    }
    else if (items.Count == 0)
    {
        <p class="text-muted" role="status">@PanelEmptyText</p>
    }
    else
    {
        <p class="text-muted" role="status" aria-live="polite">@Summary</p>
        <table class="table record-table">
            <caption class="visually-hidden">@PanelTitle</caption>
            <thead>
                <tr>
                    <th scope="col">@Texts.Get("credentials.col.type")</th><th scope="col">@Texts.Get("credentials.col.number")</th><th scope="col">@Texts.Get("credentials.col.issuer")</th>
                    <th scope="col">@Texts.Get("credentials.col.validity")</th><th scope="col">@Texts.Get("common.field.status")</th><th scope="col"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in items)
                {
                    var (badge, text) = CredentialLabels.State(item, Today);
                    <tr>
                        <td data-label="@Texts.Get("credentials.col.type")" class="primary">@Lookups.Label(CredentialAccess.TypeList, WarehouseLabels.Text(item, "typeKey"))</td>
                        <td data-label="@Texts.Get("credentials.col.number")">@Dash(WarehouseLabels.Text(item, "documentNo"))</td>
                        <td data-label="@Texts.Get("credentials.col.issuer")">@Dash(WarehouseLabels.Text(item, "issuedBy"))</td>
                        <td data-label="@Texts.Get("credentials.col.validity")">@CredentialLabels.Validity(item)</td>
                        <td data-label="@Texts.Get("common.field.status")"><span class="badge @badge">@text</span></td>
                        <td class="actions">
                            <button type="button" class="btn btn-outline-primary btn-sm" @onclick="() => Open(item)">@(CanWrite ? Texts.Get("common.edit") : Texts.Get("common.open"))</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

@code {
    private static readonly string Url = "/api/records/" + CredentialAccess.EntityKey;

    private List<RecordResponse>? items;
    private RecordResponse? selected;
    private bool editing;
    private string? message;
    private (string, Guid) loadedFor;

    [Parameter, EditorRequired] public string OwnerEntityKey { get; set; } = string.Empty;

    [Parameter, EditorRequired] public Guid OwnerId { get; set; }

    /// <summary>Sahip türün belge kategorisi (<see cref="CredentialAccess.Vehicle"/>, <see cref="CredentialAccess.Driver"/>).</summary>
    [Parameter, EditorRequired] public string Category { get; set; } = string.Empty;

    [Parameter, EditorRequired] public CrmLookups Lookups { get; set; } = default!;

    /// <summary>Kullanıcının sahip kayıtta güncelleme izni var mı? Kararı sunucu verir; panel yalnızca düğmeleri gizler.</summary>
    [Parameter] public bool CanWrite { get; set; }

    /// <summary>Boşsa "Belgeler" (çeviriden).</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>Boşsa "Henüz belge eklenmedi." (çeviriden).</summary>
    [Parameter] public string? EmptyText { get; set; }

    private string PanelTitle => Title ?? Texts.Get("credentials.panel.title");

    private string PanelEmptyText => EmptyText ?? Texts.Get("credentials.panel.empty");

    private static DateOnly Today => DateOnly.FromDateTime(DateTime.Now);

    private string Summary
    {
        get
        {
            var states = items!.Select(i => CredentialLabels.StateOf(i, Today)).ToList();
            var expired = states.Count(s => s == CredentialState.Expired);
            var expiring = states.Count(s => s is CredentialState.DueToday or CredentialState.Expiring);
            var parts = new List<string> { Texts.Get("credentials.count", items!.Count) };
            if (expiring > 0)
            {
                parts.Add(Texts.Get("credentials.panel.summary-expiring", expiring, CredentialAccess.ExpiringDays));
            }

            if (expired > 0)
            {
                parts.Add(Texts.Get("credentials.panel.summary-expired", expired));
            }

            return string.Join(" · ", parts);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (loadedFor == (OwnerEntityKey, OwnerId))
        {
            return;
        }

        loadedFor = (OwnerEntityKey, OwnerId);
        editing = false;
        selected = null;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        items = null;
        var result = await Api.GetAsync<RecordPageResponse>(
            $"{Url}?ownerEntityKey={Uri.EscapeDataString(OwnerEntityKey)}&ownerId={OwnerId}&page=1&pageSize=100");
        items = result.Value is { } page ? [.. page.Items] : [];
        message = result.Error;
    }

    private void Open(RecordResponse? item)
    {
        selected = item;
        editing = true;
        message = null;
    }

    private void Close() => editing = false;

    private async Task SavedAsync()
    {
        editing = false;
        await LoadAsync();
    }

    private static string Dash(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
}
