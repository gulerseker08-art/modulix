@* "Bugünün aktiviteleri": takvimin yanında dikey ajanda. Veri çağırandan gelir (bugünün penceresi, kullanıcıya atananlar). *@

<section class="today-panel" aria-labelledby="today-panel-title">
    <header class="today-panel-head">
        <div>
            <h2 id="today-panel-title">@Texts.Get("crm.act.today.title")</h2>
            <p class="today-panel-date">@DateText</p>
        </div>
        @if (Items is not null)
        {
            <span class="count-pill" aria-label="@Texts.Get("crm.act.countLabel", Items.Count)">@Items.Count</span>
        }
    </header>

    @if (Items is null)
    {
        <div class="today-panel-state"><LoadingState Rows="3" /></div>
    }
    else if (Error is not null)
    {
        <p class="today-panel-state text-danger" role="alert">@Error</p>
    }
    else if (Items.Count == 0)
    {
        <p class="today-panel-state">@Texts.Get("crm.act.today.empty")</p>
    }
    else
    {
        <ul class="today-list">
            @foreach (var activity in Items)
            {
                var family = FamilyOf(activity);
                <li class="today-item fam-@family @ActivityLabels.Css(activity)">
                    <span class="today-icon" aria-hidden="true"><AppIcon Name="@ActivityLabels.Icon(activity.Masked ? null : family)" Size="18" /></span>
                    <button type="button" class="today-body" @onclick="() => OnSelect.InvokeAsync(activity)">
                        <span class="today-time">@ActivityLabels.TimeText(activity)</span>
                        <strong class="today-subject">@(activity.Masked ? Texts.Get("crm.act.busy") : activity.Subject)</strong>
                        @if (!activity.Masked)
                        {
                            @if (activity.ContactId is not null)
                            {
                                <span class="today-meta"><AppIcon Name="user" Size="14" /> @Lookups.ContactName(activity.ContactId)</span>
                            }
                            @if (activity.CompanyId is not null)
                            {
                                <span class="today-meta"><AppIcon Name="building" Size="14" /> @Lookups.CompanyName(activity.CompanyId)</span>
                            }
                        }
                    </button>
                    @if (!activity.Masked)
                    {
                        <span class="today-tags">
                            <span class="badge fam-badge fam-@family">@Lookups.Label(CrmLists.ActivityType, activity.Type)</span>
                            <span class="today-status">@ActivityLabels.Status(family, activity.Status)@(ActivityLabels.IsOverdue(activity) ? ActivityLabels.OverdueSuffix : null)</span>
                        </span>
                    }
                </li>
            }
        </ul>
    }
</section>

@code {
    /// <summary><c>null</c> iken yükleniyor gösterilir.</summary>
    [Parameter] public IReadOnlyList<ActivityDto>? Items { get; set; }

    [Parameter] public string? Error { get; set; }

    [Parameter, EditorRequired] public CrmLookups Lookups { get; set; } = default!;

    [Parameter] public EventCallback<ActivityDto> OnSelect { get; set; }

    private string FamilyOf(ActivityDto activity) => ActivityLabels.Family(Lookups, activity.Type);

    private static string DateText =>
        Regional.Now.DateTime.ToString("d MMMM yyyy, dddd", UiLanguage.Culture);
}
