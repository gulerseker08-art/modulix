@* Sıralanabilir tablo başlığı (<th> içine konur): tıklama artan → azalan → varsayılan sırayla döner. Sıralama sunucudadır
   (liste uç noktasının sort anahtarları); bu bileşen yalnızca anahtarı seçer. Desc verilmezse artan ↔ varsayılan döner. *@
<button type="button" class="sort-button @(Active ? "active" : null)" aria-label="@AriaText" @onclick="ClickAsync">
    @if (ColumnIcon is not null)
    {
        <AppIcon Name="@ColumnIcon" Size="14" />
    }
    @Label
    <AppIcon Name="@Icon" Size="12" />
</button>

@code {
    /// <summary>Başlık metni.</summary>
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;

    /// <summary>Sütunun türünü gösteren başlık ikonu (ör. "phone", "map-pin"); verilmezse çizilmez.</summary>
    [Parameter] public string? ColumnIcon { get; set; }

    /// <summary>Artan sıralama anahtarı (ör. "title").</summary>
    [Parameter] public string? Asc { get; set; }

    /// <summary>Azalan sıralama anahtarı (ör. "-title"); yoksa yalnızca artan vardır.</summary>
    [Parameter] public string? Desc { get; set; }

    /// <summary>Geçerli sıralama anahtarı.</summary>
    [Parameter] public string? Value { get; set; }

    /// <summary>Liste varsayılan sırası; döngü sonunda buna dönülür.</summary>
    [Parameter, EditorRequired] public string Default { get; set; } = string.Empty;

    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    private bool Ascending => Asc is not null && Value == Asc;

    private bool Descending => Desc is not null && Value == Desc;

    private bool Active => Ascending || Descending;

    private string Icon => Ascending ? "arrow-up" : Descending ? "arrow-down" : "chevrons-up-down";

    private string AriaText => Ascending ? $"{Label}: artan sırada" : Descending ? $"{Label}: azalan sırada" : $"{Label} sütununa göre sırala";

    private Task ClickAsync()
    {
        // Varsayılan sıra bu sütunun azalanıysa (ör. "-createdAt") azalandan "varsayılana" dönmek aynı yerde kalırdı; artana geçilir.
        var next = Ascending ? (Desc ?? Default) : Descending ? (Default == Desc && Asc is not null ? Asc : Default) : (Asc ?? Desc ?? Default);
        return ValueChanged.InvokeAsync(next);
    }
}
