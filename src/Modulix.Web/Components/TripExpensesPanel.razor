@* Seferin masrafları (ADR-0038 K10, dilim 8). Masraf türü firmanın listesindendir; yakıt kategorisinde litre ve kilometre, ceza kategorisinde
   sürücüye rücu bayrağı (yalnızca bilgi) istenir. Masraf "Beklemede" doğar; onay yetkisi olan onaylar ya da gerekçeyle reddeder, reddedilen masraf
   düzeltilip yeniden bekletilir. Firma masrafı onaylamayı bir onay sürecine bağladıysa sunucu onayı reddeder ve nedenini iletir. Onaylı masraf
   değişmez. Kurallar sunucudadır; sayfa içi küçük eylem formu olduğu için sekmesizdir. *@
@inject ApiClient Api

<section class="settings-group" aria-label="Masraflar">
    <h2>Masraflar</h2>

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }

    @if (CanWrite && Open)
    {
        <form class="record-form" novalidate aria-label="Masraf ekle" @onsubmit="AddAsync" @onsubmit:preventDefault>
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label required" for="expense-type">Masraf türü</label>
                    <select id="expense-type" class="form-select" required aria-required="true" @bind="typeKey">
                        @foreach (var type in Lookups.Choices(LogisticsAccess.ExpenseTypeList, typeKey))
                        {
                            <option value="@type.Key">@type.Label</option>
                        }
                    </select>
                    <FieldError Field="expenseTypeKey" Errors="errors" />
                </div>
                <div class="col-md-4">
                    <label class="form-label required" for="expense-date">Masraf günü</label>
                    <input id="expense-date" class="form-control" type="date" required aria-required="true" @bind="day" />
                    <FieldError Field="expenseDate" Errors="errors" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="expense-doc">Belge no</label>
                    <input id="expense-doc" class="form-control" maxlength="60" placeholder="Fiş / fatura no" @bind="documentNo" />
                    <FieldError Field="documentNo" Errors="errors" />
                </div>
                <div class="col-md-4">
                    <label class="form-label required" for="expense-amount">Tutar (KDV dahil)</label>
                    <input id="expense-amount" class="form-control" type="number" step="0.01" min="0" required aria-required="true" @bind="amount" />
                    <FieldError Field="amount" Errors="errors" />
                </div>
                <div class="col-md-4">
                    <label class="form-label required" for="expense-currency">Para birimi</label>
                    <input id="expense-currency" class="form-control" maxlength="3" required aria-required="true" placeholder="TRY" @bind="currency" />
                    <FieldError Field="currency" Errors="errors" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="expense-vat">KDV tutarı</label>
                    <input id="expense-vat" class="form-control" type="number" step="0.01" min="0" @bind="vat" />
                    <FieldError Field="vatAmount" Errors="errors" />
                </div>
                @if (Category == LogisticsAccess.ExpenseFuelCategory)
                {
                    <div class="col-md-4">
                        <label class="form-label required" for="expense-liters">Litre</label>
                        <input id="expense-liters" class="form-control" type="number" step="0.001" min="0" required aria-required="true" @bind="liters" />
                        <FieldError Field="liters" Errors="errors" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="expense-km">Kilometre sayacı</label>
                        <input id="expense-km" class="form-control" type="number" step="1" min="0" @bind="odometer" />
                        <FieldError Field="odometerKm" Errors="errors" />
                    </div>
                }
                @if (Category == LogisticsAccess.ExpenseFineCategory)
                {
                    <div class="col-md-4">
                        <SegmentedChoice Id="expense-recover" Label="Sürücüye rücu (bilgi)" Options="YesNo" @bind-Value="recover" />
                        <FieldError Field="recoverFromDriver" Errors="errors" />
                    </div>
                }
                <div class="col-12">
                    <label class="form-label" for="expense-notes">Not</label>
                    <textarea id="expense-notes" class="form-control" rows="2" maxlength="2000" placeholder="İsteğe bağlı" @bind="notes"></textarea>
                    <FieldError Field="notes" Errors="errors" />
                </div>
            </div>
            <div class="list-toolbar">
                <button type="submit" class="btn btn-tonal" disabled="@busy" aria-busy="@(busy ? "true" : null)">
                    <AppIcon Name="plus" Size="16" /> Masraf ekle
                </button>
            </div>
        </form>
    }

    @if (expenses is null)
    {
        <p class="text-muted" role="status">Yükleniyor…</p>
    }
    else if (expenses.Count == 0)
    {
        <p class="text-muted" role="status">Bu sefer için masraf girilmedi.</p>
    }
    else
    {
        <p class="text-muted" role="status" aria-live="polite">@Totals</p>
        <table class="table record-table">
            <caption class="visually-hidden">Sefer masrafları</caption>
            <thead>
                <tr>
                    <th scope="col"><AppIcon Name="calendar" Size="14" /> Gün</th>
                    <th scope="col"><AppIcon Name="tag" Size="14" /> Tür</th>
                    <th scope="col"><AppIcon Name="hash" Size="14" /> Tutar</th>
                    <th scope="col"><AppIcon Name="file-text" Size="14" /> Ayrıntı</th>
                    <th scope="col"><AppIcon Name="tag" Size="14" /> Durum</th>
                    <th scope="col" class="row-menu-cell"><span class="visually-hidden">Eylemler</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var expense in expenses)
                {
                    var status = WarehouseLabels.Text(expense, "status");
                    <tr>
                        <td data-label="Gün">@(FleetLabels.Day(WarehouseLabels.Text(expense, "expenseDate")) is { } d ? FleetLabels.Date(d) : "—")</td>
                        <td data-label="Tür" class="primary">@Lookups.Label(LogisticsAccess.ExpenseTypeList, WarehouseLabels.Text(expense, "expenseTypeKey"))</td>
                        <td data-label="Tutar">@Money(expense)</td>
                        <td data-label="Ayrıntı">@Detail(expense)</td>
                        <td data-label="Durum">
                            <span class="badge @LogisticsLabels.ExpenseStatusBadge(status)">@LogisticsLabels.ExpenseStatus(status)</span>
                            @if (status == "rejected" && WarehouseLabels.Text(expense, "statusReason") is { Length: > 0 } why)
                            {
                                <small class="text-muted d-block">@why</small>
                            }
                        </td>
                        <td class="row-menu-cell actions">
                            @if (status == "pending" && CanApprove)
                            {
                                @if (rejecting == expense.Id)
                                {
                                    <label class="visually-hidden" for="reject-reason">Ret gerekçesi</label>
                                    <input id="reject-reason" class="form-control" maxlength="2000" placeholder="Ret gerekçesi" @bind="rejectReason" />
                                    <button type="button" class="btn btn-outline-danger btn-sm" disabled="@(busy || string.IsNullOrWhiteSpace(rejectReason))" @onclick="() => RejectAsync(expense)">Reddet</button>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-tonal btn-sm" disabled="@busy" @onclick="() => ApproveAsync(expense)"><AppIcon Name="check" Size="16" /> Onayla</button>
                                    <button type="button" class="btn btn-outline-danger btn-sm" disabled="@busy" @onclick="() => StartReject(expense)">Reddet</button>
                                }
                            }
                            else if (status == "rejected" && CanWrite)
                            {
                                <button type="button" class="btn btn-tonal btn-sm" disabled="@busy" @onclick="() => ResubmitAsync(expense)">Yeniden onaya gönder</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

@code {
    private static readonly IReadOnlyList<SegmentOption<bool>> YesNo = [new(false, "Hayır"), new(true, "Evet")];

    private List<RecordResponse>? expenses;
    private IReadOnlyDictionary<string, string[]>? errors;
    private string? message;
    private bool busy;
    private (Guid, long) loadedFor;
    private Guid? rejecting;
    private string? rejectReason;
    private string typeKey = string.Empty;
    private DateTime? day = DateTime.Today;
    private decimal? amount;
    private string currency = "TRY";
    private decimal? vat;
    private string? documentNo;
    private decimal? liters;
    private int? odometer;
    private bool recover;
    private string? notes;

    [Parameter, EditorRequired] public RecordResponse Trip { get; set; } = default!;

    [Parameter, EditorRequired] public CrmLookups Lookups { get; set; } = default!;

    [Parameter] public bool CanWrite { get; set; }

    [Parameter] public bool CanApprove { get; set; }

    /// <summary>İptal edilen sefere masraf eklenmez.</summary>
    private bool Open => WarehouseLabels.Text(Trip, "status") != "cancelled";

    private string? Category => Lookups.CategoryOf(LogisticsAccess.ExpenseTypeList, typeKey);

    private string Totals
    {
        get
        {
            string Sum(string status) => string.Join(" + ", expenses!.Where(e => WarehouseLabels.Text(e, "status") == status)
                .GroupBy(e => WarehouseLabels.Text(e, "currency"))
                .Select(g => $"{g.Sum(e => e.Values["amount"]?.GetValue<decimal>() ?? 0):N2} {g.Key}"));
            var approved = Sum("approved");
            var pending = Sum("pending");
            return $"Onaylı: {(approved.Length == 0 ? "—" : approved)} · Onay bekleyen: {(pending.Length == 0 ? "—" : pending)}";
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (typeKey.Length == 0)
        {
            typeKey = Lookups.DefaultOf(LogisticsAccess.ExpenseTypeList) ?? string.Empty;
        }

        if (loadedFor == (Trip.Id, Trip.Version))
        {
            return;
        }

        loadedFor = (Trip.Id, Trip.Version);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var page = await Api.GetAsync<RecordPageResponse>($"/api/records/{LogisticsAccess.ExpenseEntityKey}?tripId={Trip.Id}&pageSize=200");
        expenses = page.Value?.Items.ToList() ?? [];
        message = page.Error;
    }

    private async Task AddAsync()
    {
        var values = new System.Text.Json.Nodes.JsonObject
        {
            ["tripId"] = Trip.Id.ToString(),
            ["expenseTypeKey"] = typeKey,
            ["expenseDate"] = day?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture),
            ["currency"] = currency.Trim(),
            ["documentNo"] = documentNo,
            ["notes"] = notes,
        };
        if (amount is { } a)
        {
            values["amount"] = a;
        }

        if (vat is { } v)
        {
            values["vatAmount"] = v;
        }

        if (Category == LogisticsAccess.ExpenseFuelCategory)
        {
            values["liters"] = liters;
            values["odometerKm"] = odometer;
        }

        if (Category == LogisticsAccess.ExpenseFineCategory)
        {
            values["recoverFromDriver"] = recover;
        }

        busy = true;
        message = null;
        errors = null;
        var result = await Api.PostAsync<RecordResponse>($"/api/records/{LogisticsAccess.ExpenseEntityKey}", new RecordWriteRequest(values, null));
        busy = false;
        if (!result.IsSuccess)
        {
            errors = result.FieldErrors;
            message = result.FieldErrors?.Values.SelectMany(e => e).FirstOrDefault() ?? result.Error;
            return;
        }

        amount = vat = liters = null;
        odometer = null;
        documentNo = notes = null;
        recover = false;
        await LoadAsync();
    }

    private void StartReject(RecordResponse expense)
    {
        rejecting = expense.Id;
        rejectReason = null;
    }

    private Task ApproveAsync(RecordResponse expense) => RunAsync(expense, "approve", null);

    private Task RejectAsync(RecordResponse expense) => RunAsync(expense, "reject", rejectReason);

    private Task ResubmitAsync(RecordResponse expense) => RunAsync(expense, "resubmit", null);

    private async Task RunAsync(RecordResponse expense, string action, string? reason)
    {
        busy = true;
        message = null;
        var result = await Api.PostAsync<RecordResponse>($"/api/logistics/expenses/{expense.Id}/actions", new RunLogisticsActionRequest(action, expense.Version, reason));
        busy = false;
        if (!result.IsSuccess)
        {
            message = result.FieldErrors?.Values.SelectMany(e => e).FirstOrDefault() ?? result.Error;
            return;
        }

        rejecting = null;
        await LoadAsync();
    }

    private static string Money(RecordResponse expense) =>
        $"{expense.Values["amount"]?.GetValue<decimal>():N2} {WarehouseLabels.Text(expense, "currency")}";

    private static string Detail(RecordResponse expense)
    {
        var parts = new List<string>();
        if (expense.Values["liters"]?.GetValue<decimal>() is { } liters)
        {
            parts.Add($"{liters:N3} lt");
        }

        if (expense.Values["odometerKm"]?.GetValue<int>() is { } km)
        {
            parts.Add($"{km:N0} km");
        }

        if (WarehouseLabels.Flag(expense, "recoverFromDriver"))
        {
            parts.Add("sürücüye rücu");
        }

        if (WarehouseLabels.Text(expense, "documentNo") is { Length: > 0 } doc)
        {
            parts.Add($"Belge {doc}");
        }

        return parts.Count == 0 ? "—" : string.Join(" · ", parts);
    }
}
