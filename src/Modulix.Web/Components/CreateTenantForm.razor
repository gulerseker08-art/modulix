@* Firma açma formu (Y4); Firmalar sayfası kullanır. Açılış sunucuda tek işlemdir: firma, Yönetici rolü, modüller,
   hazır roller, sektör profili (Y9c) ve ilk yöneticinin daveti birlikte oluşur. *@
@inject ApiClient Api

<form class="record-form" novalidate @onsubmit="CreateAsync" @onsubmit:preventDefault>
    <h2>@Texts.Get("platform.tenants.create")</h2>
    <p class="text-muted">@Texts.Get("platform.createTenant.intro")</p>

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }

    <TabBar Tabs="FormTabs" State="tabs" Label="@Texts.Get("platform.createTenant.sections")" />
    <TabPanel State="tabs" Key="form-firma">
    <div class="form-grid">
        <div>
            <label class="form-label" for="tenantName">@Texts.Get("platform.createTenant.name")</label>
            <input id="tenantName" class="form-control" maxlength="200" @bind="name" @bind:after="SuggestSlug" />
            <FieldError Field="name" Errors="errors" />
        </div>
        <div>
            <label class="form-label" for="tenantSlug">@Texts.Get("platform.createTenant.slug")</label>
            <input id="tenantSlug" class="form-control" maxlength="50" @bind="slug" @bind:after="() => slugEdited = true" />
            <small class="text-muted">@Texts.Get("platform.createTenant.slugHint")</small>
            <FieldError Field="slug" Errors="errors" />
        </div>
        <div>
            <label class="form-label" for="adminEmail">@Texts.Get("platform.createTenant.adminEmail")</label>
            <input id="adminEmail" class="form-control" type="email" autocomplete="off" @bind="administratorEmail" />
            <FieldError Field="administratorEmail" Errors="errors" />
        </div>
        <div>
            <label class="form-label" for="adminName">@Texts.Get("platform.createTenant.adminName")</label>
            <input id="adminName" class="form-control" maxlength="200" @bind="administratorName" />
            <FieldError Field="administratorName" Errors="errors" />
        </div>
    </div>
    </TabPanel>
    <TabPanel State="tabs" Key="form-sektor">
    <div class="form-grid">
        @if (Profiles.Count > 0)
        {
            <div class="span-all">
                <label class="form-label" for="tenantProfile">@Texts.Get("platform.profile")</label>
                <select id="tenantProfile" class="form-select" value="@profile" @onchange="e => SelectProfile((string?)e.Value)">
                    <option value="">@Texts.Get("platform.createTenant.noProfile")</option>
                    @foreach (var item in Profiles)
                    {
                        <option value="@item.Key">@item.Name</option>
                    }
                </select>
                <small class="text-muted">
                    @(Profiles.FirstOrDefault(p => p.Key == profile)?.Description
                        ?? Texts.Get("platform.createTenant.profileHint"))
                </small>
                <FieldError Field="profile" Errors="errors" />
            </div>
        }
        <fieldset class="span-all">
            <legend class="form-label">@Texts.Get("platform.createTenant.modules")</legend>
            @foreach (var module in Modules.Modules)
            {
                <div class="form-check">
                    <input id="module-@module.Key" class="form-check-input" type="checkbox"
                           checked="@modules.Contains(module.Key)" @onchange="e => ToggleModule(module.Key, (bool)e.Value!)" />
                    <label class="form-check-label" for="module-@module.Key">@module.DisplayName</label>
                </div>
            }
            <FieldError Field="modules" Errors="errors" />
        </fieldset>
    </div>
    </TabPanel>
    @if (Templates.Count > 0)
    {
    <TabPanel State="tabs" Key="form-roller">
    <div class="form-grid">
        @if (Templates.Count > 0)
        {
            <fieldset class="span-all">
                <legend class="form-label">@Texts.Get("platform.createTenant.templates")</legend>
                @foreach (var template in Templates)
                {
                    <div class="form-check">
                        <input id="template-@template.Key" class="form-check-input" type="checkbox"
                               checked="@templates.Contains(template.Key)" @onchange="e => Toggle(templates, template.Key, (bool)e.Value!)" />
                        <label class="form-check-label" for="template-@template.Key">
                            @template.Name <small class="text-muted">@template.Description</small>
                        </label>
                    </div>
                }
                <FieldError Field="roleTemplates" Errors="errors" />
            </fieldset>
        }
    </div>
    </TabPanel>
    }

    <div class="form-actions">
        <button type="submit" class="btn btn-primary" disabled="@busy">@Texts.Get("platform.createTenant.submit")</button>
        <button type="button" class="btn btn-outline-secondary" @onclick="Cancelled">@Texts.Get("common.dismiss")</button>
    </div>
</form>

@code {
    [Parameter, EditorRequired] public PlatformModulesResponse Modules { get; set; } = default!;

    /// <summary>Sektör profilleri (Y9c); seçilen profilin modülleri önceden işaretlenir, sonra değiştirilebilir.</summary>
    [Parameter] public IReadOnlyList<SectorProfileDto> Profiles { get; set; } = [];

    [Parameter] public EventCallback<CreateTenantResponse> Created { get; set; }

    [Parameter] public EventCallback Cancelled { get; set; }

    private readonly HashSet<string> modules = [];
    private readonly HashSet<string> templates = [];
    private string? profile;
    private string name = string.Empty;
    private string slug = string.Empty;
    private bool slugEdited;
    private string administratorEmail = string.Empty;
    private string administratorName = string.Empty;
    private string? message;
    private IReadOnlyDictionary<string, string[]>? errors;

    // Her kayıt formu sekmelidir; hatalı alan içeren sekme "!" rozeti taşır, kayıt denemesinden sonra hatalı ilk sekme açılır.
    private readonly TabState tabs = new("form-firma");

    private int ErrorCount(params string[] fields) => errors is null ? 0 : fields.Count(errors.ContainsKey);

    private IReadOnlyList<TabItem> FormTabs
    {
        get
        {
            List<TabItem> items =
            [
                new("form-firma", Texts.Get("platform.createTenant.tab.tenant"), Errors: ErrorCount("name", "slug", "administratorEmail", "administratorName")),
                new("form-sektor", Texts.Get("platform.createTenant.tab.sector"), Errors: ErrorCount("profile", "modules")),
            ];
            if (Templates.Count > 0)
            {
                items.Add(new("form-roller", Texts.Get("platform.templates"), Errors: ErrorCount("roleTemplates")));
            }

            return items;
        }
    }
    private bool busy;

    /// <summary>Seçili modüllerin hazır rolleri; en az bir modül seçiliyse "Salt okur" da.</summary>
    private List<RoleTemplateDto> Templates
    {
        get
        {
            var list = Modules.Modules.Where(m => modules.Contains(m.Key)).SelectMany(m => m.Templates).ToList();
            if (modules.Count > 0)
            {
                list.Add(Modules.ReadOnlyTemplate);
            }

            return list;
        }
    }

    private void ToggleModule(string key, bool on)
    {
        Toggle(modules, key, on);

        // Kapanan modülün şablonları seçimden çıkar.
        templates.IntersectWith(Templates.Select(t => t.Key));
    }

    private void SelectProfile(string? key)
    {
        profile = string.IsNullOrEmpty(key) ? null : key;
        if (Profiles.FirstOrDefault(p => p.Key == profile) is { } selected)
        {
            modules.Clear();
            modules.UnionWith(selected.Modules.Where(m => Modules.Modules.Any(x => x.Key == m)));
            templates.IntersectWith(Templates.Select(t => t.Key));
        }
    }

    private static void Toggle(HashSet<string> set, string key, bool on)
    {
        if (on)
        {
            set.Add(key);
        }
        else
        {
            set.Remove(key);
        }
    }

    private void SuggestSlug()
    {
        if (!slugEdited)
        {
            slug = Slug.Suggest(name);
        }
    }

    private async Task CreateAsync()
    {
        busy = true;
        var result = await Api.PostAsync<CreateTenantResponse>("/api/platform/tenants", new CreateTenantRequest(
            name, slug, [.. modules], [.. templates], administratorEmail, administratorName, profile));
        busy = false;

        if (!result.IsSuccess)
        {
            message = result.Error;
            errors = result.FieldErrors;
            tabs.RevealFirstFailing(FormTabs);
            return;
        }

        await Created.InvokeAsync(result.Value!);
    }
}
