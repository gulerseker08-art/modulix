@typeparam T
@* Satış analizi zarfı: dönem satırı, kapsam / tutar izni / kısaltma notları, kısmi veri uyarıları, içerik ve hesap açıklamaları.
   Renk tek başına bilgi taşımaz; her not metinle yazılır. *@
<p class="small text-muted" role="status">
    @SalesLabels.PeriodLine(Report.PeriodLabel, Report.PeriodStart, Report.PeriodEnd, Report.Today, Report.Currency)
    @if (Report.ScopeLimited)
    {
        <span class="badge tag">@Texts.Get("crm.sales.scopeLimitedBadge")</span>
    }
</p>

@if (Report.ScopeLimited)
{
    <div class="alert alert-info" role="status">@Texts.Get("crm.sales.scopeLimited")</div>
}
@if (!Report.AmountsVisible)
{
    <div class="alert alert-info" role="status">@Texts.Get("crm.sales.analyticsNoAmounts")</div>
}
@if (Report.Truncated)
{
    <div class="alert alert-warning" role="status">@Texts.Get("crm.sales.analyticsTruncated")</div>
}
@if (Report.Warnings.Count > 0)
{
    <div class="alert alert-warning" role="status">
        <strong>@Texts.Get("crm.sales.warnings")</strong>
        <ul class="mb-0">
            @foreach (var warning in Report.Warnings)
            {
                <li>@warning</li>
            }
        </ul>
    </div>
}

@ChildContent

@if (Report.Definitions.Count > 0)
{
    <details class="detail-section">
        <summary><strong>@Texts.Get("crm.sales.definitions")</strong></summary>
        <ul class="small text-muted mt-2">
            @foreach (var definition in Report.Definitions)
            {
                <li>@definition</li>
            }
        </ul>
    </details>
}

@code {
    [Parameter, EditorRequired] public AnalyticsDto<T> Report { get; set; } = default!;

    [Parameter] public RenderFragment? ChildContent { get; set; }
}
