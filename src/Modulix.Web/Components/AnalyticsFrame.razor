@typeparam T
@* Satış analizi zarfı: dönem satırı, kapsam / tutar izni / kısaltma notları, kısmi veri uyarıları, içerik ve hesap açıklamaları.
   Renk tek başına bilgi taşımaz; her not metinle yazılır. *@
<p class="small text-muted" role="status">
    <strong>@Report.PeriodLabel</strong> (@SalesLabels.Period(Report.PeriodStart, Report.PeriodEnd)) · bugün @CrmLabels.Date(Report.Today) · para birimi <strong>@Report.Currency</strong>
    @if (Report.ScopeLimited)
    {
        <span class="badge tag">Veri kapsamınız kısıtlı</span>
    }
</p>

@if (Report.ScopeLimited)
{
    <div class="alert alert-info" role="status">Veri kapsamınız kısıtlı: yalnızca yetkili olduğunuz fırsatlar hesaba katıldı.</div>
}
@if (!Report.AmountsVisible)
{
    <div class="alert alert-info" role="status">Tutarları görme yetkiniz yok; tutarlar gösterilmiyor, yalnızca adetler ve oranlar vardır.</div>
}
@if (Report.Truncated)
{
    <div class="alert alert-warning" role="status">Okuma sınırına ulaşıldı; sonuçlar eksik olabilir. Kullanıcı ya da dönem seçerek daraltın.</div>
}
@if (Report.Warnings.Count > 0)
{
    <div class="alert alert-warning" role="status">
        <strong>Verilerle ilgili uyarılar</strong>
        <ul class="mb-0">
            @foreach (var warning in Report.Warnings)
            {
                <li>@warning</li>
            }
        </ul>
    </div>
}

@ChildContent

@if (Report.Definitions.Count > 0)
{
    <details class="detail-section">
        <summary><strong>Hesap açıklaması</strong></summary>
        <ul class="small text-muted mt-2">
            @foreach (var definition in Report.Definitions)
            {
                <li>@definition</li>
            }
        </ul>
    </details>
}

@code {
    [Parameter, EditorRequired] public AnalyticsDto<T> Report { get; set; } = default!;

    [Parameter] public RenderFragment? ChildContent { get; set; }
}
