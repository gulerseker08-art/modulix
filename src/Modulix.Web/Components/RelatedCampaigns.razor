@* Firma/kişi kartında pazarlama geçmişi (ADR-0025, dilim 8): bu müşteriye giden kampanya iletileri ve gelen yanıtlar. Adres gösterilmez. Pazarlama modülü bu tenant için kapalıysa ya da kullanıcının rapor ve
   alıcı görüntüleme izni yoksa bileşen hiçbir şey çizmez ve istek yapmaz; liste sunucuda izin ve kampanya veri kapsamıyla süzülür. *@
@inject ApiClient Api
@inject SessionState Session

@if (Available)
{
    <section class="detail-section" aria-labelledby="related-campaigns">
        <div class="section-header"><h2 id="related-campaigns">@Texts.Get("marketing.related.title")</h2></div>
        @if (history is null)
        {
            <LoadingState Kind="LoadingKind.Table" />
        }
        else if (history.Items.Count == 0)
        {
            <EmptyState Title="@Texts.Get("marketing.related.empty")" />
        }
        else
        {
            <table class="table record-table">
                <caption class="visually-hidden">@Texts.Get("marketing.related.title")</caption>
                <thead><tr><th scope="col">@Texts.Get("marketing.campaigns.col.name")</th><th scope="col">@Texts.Get("common.field.kind")</th><th scope="col">@Texts.Get("common.field.status")</th><th scope="col">@Texts.Get("marketing.col.time")</th></tr></thead>
                <tbody>
                    @foreach (var i in history.Items)
                    {
                        <tr>
                            <td data-label="@Texts.Get("marketing.campaigns.col.name")" class="primary"><a href="pazarlama/kampanyalar/@i.CampaignId">@i.CampaignName</a></td>
                            <td data-label="@Texts.Get("common.field.kind")">@(i.Kind == "Delivery" ? Texts.Get("marketing.related.delivery") : Texts.Get("marketing.related.response", MarketingLabels.ResponseKind(i.Detail ?? "Other")))</td>
                            <td data-label="@Texts.Get("common.field.status")">@(i.Kind == "Delivery" ? MarketingLabels.DeliveryStatus(i.Status) : MarketingLabels.ResponseStatus(i.Status))</td>
                            <td data-label="@Texts.Get("marketing.col.time")">@CrmLabels.Time(i.At)</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>
}

@code {
    /// <summary>Ortak müşteri (taraf) ya da kişi kimliği; firma kartında firmanın <c>PartyId</c> değeri.</summary>
    [Parameter] public Guid? TargetId { get; set; }

    private TargetHistoryDto? history;
    private Guid? loadedFor;

    private bool Available => TargetId is not null && Session.IsModuleEnabled(MarketingAccess.ModuleKey) && Session.Can(MarketingAccess.ReportsRead) && Session.Can(MarketingAccess.RecipientsRead);

    protected override async Task OnParametersSetAsync()
    {
        if (!Available || loadedFor == TargetId) { return; }
        loadedFor = TargetId;
        history = (await Api.GetAsync<TargetHistoryDto>($"/api/marketing/targets/{TargetId}/history")).Value ?? new TargetHistoryDto([]);
    }
}
