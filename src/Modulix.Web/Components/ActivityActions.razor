@* Aktivite ayrıntı paneli ve yaşam döngüsü eylemleri (ADR-0015): başlat, bloke, tamamla (sonuç ve sonraki adım), iptal, yeniden aç,
   ertele, yeniden ata. Eylemler yalnızca kullanıcının iznine göre görünür; sunucu yine de her birini kayıt başına doğrular.
   Özel aktivitede ayrıntı yoktur: yalnızca meşguliyet gösterilir. *@
@inject ApiClient Api
@inject SessionState Session

<section class="detail-section activity-panel" aria-live="polite">
    <div class="section-header">
        <h2>@(Activity.Masked ? Texts.Get("crm.act.busy") : Activity.Subject)</h2>
        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="Closed">@Texts.Get("common.close")</button>
    </div>

    <Notice Text="@message" Failed="true" />

    <dl class="detail-list">
        <dt>@Texts.Get("crm.act.col.status")</dt>
        <dd>@ActivityLabels.Status(Family, Activity.Status)@(ActivityLabels.IsOverdue(Activity) ? ActivityLabels.OverdueSuffix : null)@(Activity.RescheduleCount > 0 ? " · " + Texts.Get("crm.act.rescheduled", Activity.RescheduleCount) : null)</dd>
        <dt>@Texts.Get("crm.act.col.when")</dt>
        <dd>@When()</dd>
        @if (!Activity.Masked)
        {
            <dt>@Texts.Get("crm.act.typePriority")</dt>
            <dd>@Lookups.Label(CrmLists.ActivityType, Activity.Type) · @ActivityLabels.Priority(Activity.Priority)</dd>
            <dt>@Texts.Get("common.field.owner")</dt>
            <dd>@Lookups.MemberName(Activity.OwnerId)</dd>
            @if (Activity.StatusReason is not null)
            {
                <dt>@Texts.Get("crm.act.statusReason")</dt>
                <dd>@Activity.StatusReason</dd>
            }
            @if (Activity.Location is not null)
            {
                <dt>@Texts.Get("crm.act.location")</dt>
                <dd>@Activity.Location</dd>
            }
            @if (Activity.OnlineMeetingUrl is not null)
            {
                <dt>@Texts.Get("crm.act.online")</dt>
                <dd><a href="@(Activity.OnlineMeetingUrl.StartsWith("http") ? Activity.OnlineMeetingUrl : "https://" + Activity.OnlineMeetingUrl)" target="_blank" rel="noopener noreferrer">@Texts.Get("crm.act.joinMeeting")</a></dd>
            }
            @if (Activity.Notes is not null)
            {
                <dt>@Texts.Get("common.field.notes")</dt>
                <dd class="pre">@Activity.Notes</dd>
            }
            @if (related is { } r && (r.Links.Count > 0 || r.HiddenCount > 0))
            {
                <dt>@Texts.Get("crm.act.related")</dt>
                <dd>
                    @string.Join(", ", r.Links.Select(l => l.Title))
                    @if (r.HiddenCount > 0) { <small class="text-muted"> · @Texts.Get("crm.act.relatedHidden", r.HiddenCount)</small> }
                </dd>
            }
        }
    </dl>

    @if (!Activity.Masked)
    {
        @if (pending is null)
        {
            <div class="form-actions">
                @if (ActivityStatus.IsOpen(Activity.Status))
                {
                    @if (Session.Can(CrmAccess.ActivitiesWrite))
                    {
                        @if (Family == ActivityFamily.Task && Activity.Status == ActivityStatus.Open)
                        {
                            <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@busy" @onclick="StartAsync">@Texts.Get("crm.act.start")</button>
                        }
                        @if (Family == ActivityFamily.Task && Activity.Status != ActivityStatus.Blocked)
                        {
                            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => pending = Pending.Block">@Texts.Get("crm.act.block")</button>
                        }
                        @if (Activity.Status == ActivityStatus.Blocked)
                        {
                            <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@busy" @onclick="UnblockAsync">@Texts.Get("crm.act.unblock")</button>
                        }
                        @if (Activity.Status != ActivityStatus.Blocked)
                        {
                            <button type="button" class="btn btn-primary btn-sm" @onclick="() => pending = Pending.Complete">@Texts.Get(Family == ActivityFamily.Email ? "crm.act.markSent" : "crm.act.complete")</button>
                        }
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="StartReschedule">@Texts.Get("crm.act.postpone")</button>
                        <button type="button" class="btn btn-outline-danger btn-sm" @onclick="() => pending = Pending.Cancel">@Texts.Get("crm.act.cancel")</button>
                    }
                    @if (Session.Can(CrmAccess.ActivitiesWrite) || Session.Can(CrmAccess.ActivitiesAssign))
                    {
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => pending = Pending.Reassign">@Texts.Get("crm.act.reassign")</button>
                    }
                }
                else if (Session.Can(CrmAccess.ActivitiesReopen))
                {
                    <button type="button" class="btn btn-outline-primary btn-sm" @onclick="() => pending = Pending.Reopen">@Texts.Get("crm.act.reopen")</button>
                }
                @if (Session.Can(CrmAccess.ActivitiesWrite))
                {
                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="Edit">@Texts.Get("common.edit")</button>
                }
            </div>
        }
        else
        {
            <form class="record-form" novalidate @onsubmit="SubmitAsync" @onsubmit:preventDefault>
                <div class="form-grid">
                    @switch (pending)
                    {
                        case Pending.Complete:
                            @if (Family != ActivityFamily.Task && Family != ActivityFamily.Email)
                            {
                                <div>
                                    <label class="form-label" for="outcome">@Texts.Get("crm.act.outcome")</label>
                                    <select id="outcome" class="form-select" @bind="outcome">
                                        <option value="@ActivityOutcome.Reached">@Texts.Get(Family == ActivityFamily.Call ? "crm.act.outcome.callReached" : "crm.act.outcome.held")</option>
                                        <option value="@ActivityOutcome.NoAnswer">@Texts.Get(Family == ActivityFamily.Call ? "crm.act.outcome.callNoAnswer" : "crm.act.outcome.noShow")</option>
                                    </select>
                                </div>
                            }
                            <div>
                                <label class="form-label" for="actual">@Texts.Get("crm.act.actualMinutes")</label>
                                <input id="actual" class="form-control" type="number" min="1" @bind="actualMinutes" />
                            </div>
                            <div class="span-all">
                                <label class="form-label" for="note">@Texts.Get("crm.act.outcomeNote")</label>
                                <textarea id="note" class="form-control" rows="2" maxlength="@CrmLimits.TextMaxLength" @bind="text"></textarea>
                            </div>
                            <div class="form-check-row span-all">
                                <input id="next" class="form-check-input" type="checkbox" @bind="addNext" />
                                <label class="form-check-label" for="next">@Texts.Get("crm.act.addNext")</label>
                            </div>
                            @if (addNext)
                            {
                                <div>
                                    <label class="form-label" for="nsub">@Texts.Get("crm.act.nextSubject")</label>
                                    <input id="nsub" class="form-control" maxlength="@CrmLimits.TextMaxLength" @bind="nextSubject" />
                                </div>
                                <div>
                                    <label class="form-label" for="ntype">@Texts.Get("crm.act.type")</label>
                                    <select id="ntype" class="form-select" @bind="nextType">
                                        @foreach (var type in Lookups.Choices(CrmLists.ActivityType))
                                        {
                                            <option value="@type.Key">@type.Label</option>
                                        }
                                    </select>
                                </div>
                                <div>
                                    <label class="form-label" for="ndue">@Texts.Get("crm.act.date")</label>
                                    <input id="ndue" class="form-control" type="datetime-local" @bind="nextDue" />
                                </div>
                            }
                            break;
                        case Pending.Reschedule:
                            @if (Activity.IsAllDay)
                            {
                                <div>
                                    <label class="form-label" for="sd">@Texts.Get("crm.act.startDay")</label>
                                    <input id="sd" class="form-control" type="date" @bind="startDate" />
                                </div>
                                <div>
                                    <label class="form-label" for="ed">@Texts.Get("crm.act.endDay")</label>
                                    <input id="ed" class="form-control" type="date" @bind="endDate" />
                                </div>
                            }
                            else
                            {
                                @if (Activity.StartAt is not null)
                                {
                                    <div>
                                        <label class="form-label" for="st">@Texts.Get("crm.act.startAt")</label>
                                        <input id="st" class="form-control" type="datetime-local" @bind="start" />
                                    </div>
                                    <div>
                                        <label class="form-label" for="en">@Texts.Get("crm.act.endAt")</label>
                                        <input id="en" class="form-control" type="datetime-local" @bind="end" />
                                    </div>
                                }
                                <div>
                                    <label class="form-label" for="du">@Texts.Get("crm.act.dueAt")</label>
                                    <input id="du" class="form-control" type="datetime-local" @bind="due" />
                                </div>
                            }
                            <div class="span-all">
                                <label class="form-label" for="reason">@Texts.Get("crm.act.reasonRequired")</label>
                                <input id="reason" class="form-control" maxlength="@CrmLimits.TextMaxLength" @bind="text" />
                            </div>
                            break;
                        case Pending.Reassign:
                            <div class="span-all">
                                <label class="form-label" for="owner">@Texts.Get("crm.act.newOwner")</label>
                                <LookupPicker Id="owner" LookupKey="crm.activity.owner" @bind-Value="NewOwner" Required="true" />
                            </div>
                            break;
                        default:
                            <div class="span-all">
                                <label class="form-label" for="reason2">@Texts.Get("crm.act.reasonRequired")</label>
                                <input id="reason2" class="form-control" maxlength="@CrmLimits.TextMaxLength" @bind="text" />
                            </div>
                            break;
                    }
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn btn-primary btn-sm" disabled="@busy">@Texts.Get("crm.act.confirm")</button>
                    @if (conflict)
                    {
                        <button type="button" class="btn btn-outline-danger btn-sm" disabled="@busy" @onclick="() => { allowConflict = true; return SubmitAsync(); }">@Texts.Get("crm.act.conflict.schedule")</button>
                    }
                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="Reset">@Texts.Get("common.dismiss")</button>
                </div>
            </form>
        }
    }
</section>

@code {
    private enum Pending
    {
        Complete,
        Cancel,
        Reopen,
        Block,
        Reschedule,
        Reassign,
    }

    private Pending? pending;
    private bool busy;
    private bool conflict;
    private bool allowConflict;
    private string? message;
    private string? text;
    private string outcome = ActivityOutcome.Reached;
    private int? actualMinutes;
    private bool addNext;
    private string nextSubject = string.Empty;
    private string nextType = ActivityType.Task;
    private DateTime? nextDue;
    private DateTime? start;
    private DateTime? end;
    private DateTime? due;
    private DateTime? startDate;
    private DateTime? endDate;
    private Guid newOwner;

    private Guid? NewOwner
    {
        get => newOwner == Guid.Empty ? null : newOwner;
        set => newOwner = value ?? Guid.Empty;
    }
    private ActivityRelatedDto? related;
    private Guid loadedFor;

    [Parameter, EditorRequired] public ActivityDto Activity { get; set; } = default!;

    /// <summary>Eylem sonrası yenilenen aktivite (liste ve takvim güncellenir).</summary>
    [Parameter] public EventCallback<ActivityDto> Changed { get; set; }

    [Parameter] public EventCallback Closed { get; set; }

    /// <summary>
    /// Sayfanın yüklediği seçim listeleri ve üyeler. <see cref="CrmLookups"/> geçici (transient) kayıtlıdır; bileşen kendisi
    /// enjekte etseydi boş bir örnek alır, tür ve sorumlu adı yerine ham anahtar ve "—" görünürdü.
    /// </summary>
    [Parameter, EditorRequired] public CrmLookups Lookups { get; set; } = default!;

    [Parameter] public EventCallback<ActivityDto> EditRequested { get; set; }

    private string Family => ActivityLabels.Family(Lookups, Activity.Type);

    protected override async Task OnParametersSetAsync()
    {
        if (loadedFor == Activity.Id)
        {
            return;
        }

        loadedFor = Activity.Id;
        Reset();
        related = Activity.Masked ? null : (await Api.GetAsync<ActivityRelatedDto>($"/api/crm/activities/{Activity.Id}/related")).Value;
    }

    private string When()
    {
        var text = ActivityLabels.TimeText(Activity);
        var day = ActivityLabels.Days(Activity).FirstOrDefault();
        return day == default ? text : $"{day.ToString("d MMMM yyyy", UiLanguage.Culture)} {text}".Trim();
    }

    private Task StartAsync() => RunAsync("start", new ActivityVersionRequest(Activity.Version));

    private Task UnblockAsync() => RunAsync("unblock", new ActivityVersionRequest(Activity.Version));

    private Task Edit() => EditRequested.InvokeAsync(Activity);

    private void StartReschedule()
    {
        start = Activity.StartAt is { } s ? Regional.ToTenant(s).DateTime : null;
        end = Activity.EndAt is { } e ? Regional.ToTenant(e).DateTime : null;
        due = Activity.DueAt is { } d ? Regional.ToTenant(d).DateTime : null;
        startDate = Activity.StartDate?.ToDateTime(TimeOnly.MinValue);
        endDate = Activity.EndDate?.ToDateTime(TimeOnly.MinValue);
        pending = Pending.Reschedule;
    }

    private void Reset()
    {
        pending = null;
        message = null;
        text = null;
        conflict = false;
        allowConflict = false;
        addNext = false;
        nextSubject = string.Empty;
        outcome = ActivityOutcome.Reached;
        newOwner = Activity.OwnerId ?? Lookups.AssignableMembers.FirstOrDefault()?.UserId ?? Guid.Empty;
    }

    private Task SubmitAsync() => pending switch
    {
        Pending.Complete => RunAsync("complete", new CompleteActivityRequest(
            Activity.Version, Family is ActivityFamily.Task or ActivityFamily.Email ? null : outcome, text, ActualMinutes: actualMinutes,
            NextStep: addNext ? new ActivityNextStepRequest(nextSubject, nextType, nextDue is { } n ? Regional.FromTenant(n) : null) : null)),
        Pending.Cancel => RunAsync("cancel", new ActivityReasonRequest(Activity.Version, text)),
        Pending.Reopen => RunAsync("reopen", new ActivityReasonRequest(Activity.Version, text)),
        Pending.Block => RunAsync("block", new ActivityReasonRequest(Activity.Version, text)),
        Pending.Reassign => RunAsync("reassign", new ReassignActivityRequest(Activity.Version, newOwner)),
        Pending.Reschedule => RunAsync("reschedule", Activity.IsAllDay
            ? new RescheduleActivityRequest(Activity.Version, text, IsAllDay: true, StartDate: ToDay(startDate), EndDate: ToDay(endDate), AllowConflict: allowConflict)
            : new RescheduleActivityRequest(Activity.Version, text, due is { } d ? Regional.FromTenant(d) : null,
                start is { } s ? Regional.FromTenant(s) : null, end is { } e ? Regional.FromTenant(e) : null, AllowConflict: allowConflict)),
        _ => Task.CompletedTask,
    };

    private static DateOnly? ToDay(DateTime? value) => value is { } v ? DateOnly.FromDateTime(v) : null;

    private async Task RunAsync(string action, object body)
    {
        busy = true;
        message = null;
        ActivityDto? updated;
        if (action == "complete")
        {
            var result = await Api.PostAsync<CompleteActivityResultDto>($"/api/crm/activities/{Activity.Id}/{action}", body);
            updated = result.Value?.Activity;
            message = result.Error;
            conflict = false;
        }
        else
        {
            var result = await Api.PostAsync<ActivityDto>($"/api/crm/activities/{Activity.Id}/{action}", body);
            updated = result.Value;
            message = result.Error;
            conflict = result.FieldErrors?.ContainsKey("conflict") == true;
            if (conflict)
            {
                message = result.FieldErrors!["conflict"].FirstOrDefault();
            }
            else if (result.FieldErrors is { Count: > 0 } fields)
            {
                message = string.Join(" ", fields.SelectMany(f => f.Value));
            }
        }

        busy = false;
        if (updated is not null)
        {
            loadedFor = Guid.Empty;
            pending = null;
            await Changed.InvokeAsync(updated);
        }
    }
}
