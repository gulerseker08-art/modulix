@* Talep SLA durumu: tüm hesap sunucudadır (otorite); bu bileşen yalnızca sunucunun hesapladığı örnekleri ve süreleri gösterir. Sayaç yazısı gösterim amaçlıdır. *@
@implements IDisposable
@inject ApiClient Api
@inject SessionState Session

<section aria-labelledby="sla-title">
    <h2 id="sla-title">SLA</h2>
    <Notice Text="@message" Failed="@failed" />
    @if (instances is null)
    {
        <LoadingState />
    }
    else if (instances.Count == 0)
    {
        <p class="text-muted">@Texts.Strong("support.slaPanel.none", Texts.Get("support.slaPanel.noTarget"))</p>
    }
    else
    {
        <p class="small text-muted">@Texts.Get("support.slaPanel.help", Refresh)</p>
        @foreach (var cycle in instances.GroupBy(i => i.Cycle).OrderByDescending(g => g.Key))
        {
            <h3 class="h6">@(cycle.Key == instances.Max(i => i.Cycle) ? Texts.Get("support.slaPanel.cycleCurrent", cycle.Key) : Texts.Get("support.slaPanel.cyclePast", cycle.Key))</h3>
            <div class="sla-cards">
                @foreach (var i in cycle.OrderBy(i => i.Metric))
                {
                    <article class="sla-card" aria-label="@SlaLabels.Label(SlaLabels.Metrics, i.Metric) SLA">
                        <header>
                            <strong>@SlaLabels.Label(SlaLabels.Metrics, i.Metric)</strong>
                            <span class="badge stage-@SlaLabels.StateBadge(i.State)">@SlaLabels.Label(SlaLabels.States, i.State)</span>
                        </header>
                        <dl class="detail-list">
                            <dt>@Texts.Get("support.slaPanel.policy")</dt><dd>@Texts.Get("support.slaPanel.policyRevision", i.PolicyName, i.PolicyRevision)@(i.AlwaysOpen ? " · 7/24" : i.CalendarName is { } cal ? " · " + cal : null)</dd>
                            <dt>@Texts.Get("crm.salesTarget.target")</dt><dd>@Texts.Get("support.slaPanel.workTime", SlaLabels.Duration(i.TargetMinutes))</dd>
                            <dt>@Texts.Get("support.slaPanel.spentLeft")</dt><dd>@SlaLabels.Duration(i.WorkedMinutes) / @SlaLabels.Duration(i.RemainingMinutes)</dd>
                            @if (i.Status == "Running" && i.DueAt is { } due)
                            {
                                <dt>@Texts.Get("support.slaPanel.dueAt")</dt><dd>@CrmLabels.Time(due) · <span aria-live="off">@SlaLabels.Remaining(due, DateTimeOffset.UtcNow)</span></dd>
                            }
                            else if (i.Status == "Paused")
                            {
                                <dt>@Texts.Get("support.slaPanel.dueAt")</dt><dd>@Texts.Get("support.slaPanel.paused")</dd>
                            }
                            @if (i.BreachedAt is { } breached) { <dt>@Texts.Get("support.slaPanel.breachedAt")</dt><dd>@CrmLabels.Time(breached) <small class="text-muted">@Texts.Get("support.slaPanel.realDue")</small></dd> }
                            @if (i.CompletedAt is { } completed) { <dt>@Texts.Get("support.slaPanel.completedAt")</dt><dd>@CrmLabels.Time(completed)</dd> }
                        </dl>
                        @if (i.Pauses.Count > 0)
                        {
                            <details>
                                <summary>@Texts.Get("support.slaPanel.pauses", i.Pauses.Count)</summary>
                                <ul class="small">
                                    @foreach (var p in i.Pauses)
                                    {
                                        <li>@CrmLabels.Time(p.StartedAt) → @(p.EndedAt is { } end ? CrmLabels.Time(end) : Texts.Get("support.slaPanel.ongoing")) · @SupportLabels.Label(SupportLabels.Statuses, p.Reason)</li>
                                    }
                                </ul>
                            </details>
                        }
                        @if (i.Escalations.Count > 0)
                        {
                            <details>
                                <summary>@Texts.Get("support.slaPanel.escalations", i.Escalations.Count)</summary>
                                <ul class="small">
                                    @foreach (var e in i.Escalations)
                                    {
                                        <li>@Texts.Get("support.percent", e.Percent) · @SlaLabels.Label(SlaLabels.Actions, e.Action) · @CrmLabels.Time(e.ExecutedAt) · @e.Outcome</li>
                                    }
                                </ul>
                            </details>
                        }
                    </article>
                }
            </div>
        }

        @if (Session.Can(SupportAccess.SlaRecalculate) && instances.Any(i => i.Status is "Running" or "Paused"))
        {
            <details>
                <summary>@Texts.Get("support.slaPanel.recalcTitle")</summary>
                <form class="record-form" novalidate @onsubmit="RecalculateAsync" @onsubmit:preventDefault>
                    <p class="small text-muted">@Texts.Get("support.slaPanel.recalcHelp")</p>
                    <label class="form-label" for="sla-reason">@Texts.Get("orders.change.reason")</label>
                    <textarea id="sla-reason" class="form-control" rows="2" maxlength="500" @bind="reason" aria-invalid="@(reasonError is not null ? "true" : null)"></textarea>
                    @if (reasonError is not null) { <div class="invalid-feedback d-block" role="alert">@reasonError</div> }
                    <div class="form-actions"><button type="submit" class="btn btn-outline-secondary" disabled="@busy">@Texts.Get("support.slaPanel.recalc")</button></div>
                </form>
            </details>
        }
    }
</section>

@code {
    private const int Refresh = 30;

    [Parameter, EditorRequired] public TicketDto Ticket { get; set; } = default!;

    /// <summary>Yeniden hesaplamadan sonra güncel talep.</summary>
    [Parameter] public EventCallback<TicketDto> Changed { get; set; }

    private List<SlaInstanceDto>? instances;
    private Guid loadedFor;
    private long loadedVersion;
    private string reason = string.Empty;
    private string? reasonError;
    private string? message;
    private bool failed;
    private bool busy;
    private Timer? timer;

    protected override async Task OnParametersSetAsync()
    {
        if (loadedFor == Ticket.Id && loadedVersion == Ticket.Version)
        {
            return;
        }

        loadedFor = Ticket.Id;
        loadedVersion = Ticket.Version;
        await LoadAsync();
        timer ??= new Timer(async _ => await InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); }), null, TimeSpan.FromSeconds(Refresh), TimeSpan.FromSeconds(Refresh));
    }

    private async Task LoadAsync() =>
        instances = (await Api.GetAsync<List<SlaInstanceDto>>($"/api/support/tickets/{Ticket.Id}/sla")).Value ?? [];

    private async Task RecalculateAsync()
    {
        if (busy) { return; }
        if (string.IsNullOrWhiteSpace(reason))
        {
            reasonError = Texts.Get("crm.quoteDetail.reasonRequired");
            return;
        }

        busy = true;
        reasonError = null;
        var result = await Api.PostAsync<TicketDto>($"/api/support/tickets/{Ticket.Id}/sla/recalculate", new SlaRecalculateRequest(Ticket.Version, reason.Trim()));
        busy = false;
        failed = !result.IsSuccess;
        message = result.IsSuccess ? Texts.Get("support.slaPanel.recalculated") : result.Error;
        if (result.IsSuccess)
        {
            reason = string.Empty;
            await Changed.InvokeAsync(result.Value!);
        }
    }

    public void Dispose() => timer?.Dispose();
}
