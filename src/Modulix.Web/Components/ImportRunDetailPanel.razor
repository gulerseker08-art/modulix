@inject ApiClient Api
@inject SessionState Session

@* İçe aktarma ayrıntısı (ADR-0033): en sık hatalar ve satır hataları. Ham hücre değeri yoktur; düzeltme için asıl satır
   hata raporunda verilir. *@
@if (message is not null)
{
    <div class="alert alert-danger" role="alert">@message</div>
}
else if (detail is null)
{
    <LoadingState />
}
else
{
    var run = detail.Run;
    <p class="text-muted">
        @SettingsLabels.ImportMode(run.Mode) · @SettingsLabels.ImportPolicy(run.Policy)
        @if (run.StartedAt is { } started) { <text> · @Texts.Get("admin.importRun.startedAt", CrmLabels.Time(started))</text> }
        @if (run.CompletedAt is { } done) { <text> · @Texts.Get("admin.importRun.finishedAt", CrmLabels.Time(done))</text> }
    </p>
    @if (run.Note is not null)
    {
        <p>@run.Note</p>
    }

    @* Geri alma (ADR-0033 Dilim 4d): yalnızca kayıt almış uygulamada ve geri alma izniyle. Onay adımında gerekçe zorunludur; düz kırmızı düğme
       onay adımındadır. Sonradan değişmiş, başka kayda bağlı ya da silme yetkisi olmayan kayıtlar silinmez, sayıyla bildirilir. *@
    @if (CanRollBack(run))
    {
        @if (!confirming)
        {
            <div class="list-toolbar">
                <button type="button" class="btn btn-outline-danger" @onclick="() => confirming = true">@Texts.Get("admin.importRun.rollback")</button>
            </div>
        }
        else
        {
            <div class="alert alert-warning" role="alertdialog" aria-labelledby="rollback-title">
                <h3 id="rollback-title" class="h6">@Texts.Get("admin.importRun.rollbackTitle", run.CreatedCount)</h3>
                <p>@Texts.Get("admin.importRun.rollbackHint")</p>
                <label class="form-label required" for="rollback-reason">@Texts.Get("admin.supportAccess.col.reason")</label>
                <input id="rollback-reason" class="form-control mb-2" maxlength="300" @bind="reason" @bind:event="oninput" />
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-outline-secondary" @onclick="() => confirming = false">@Texts.Get("common.dismiss")</button>
                    <button type="button" class="btn btn-danger" disabled="@(busy || string.IsNullOrWhiteSpace(reason))" aria-busy="@(busy ? "true" : "false")" @onclick="RollBackAsync">@Texts.Get("admin.importRun.rollbackConfirm")</button>
                </div>
            </div>
        }
    }
    @if (outcome is not null)
    {
        <div class="alert @(outcome.Kept.Count == 0 ? "alert-success" : "alert-warning")" role="status">
            @Outcome(outcome)
        </div>
    }

    @if (detail.IssueCodes.Count == 0)
    {
        <EmptyState Compact="true" Title="@Texts.Get("admin.importRun.noIssues")" />
    }
    else
    {
        <div class="filters" role="group" aria-label="@Texts.Get("admin.importRun.filterByCode")">
            <button type="button" class="chip @(code is null ? "active" : null)" aria-pressed="@(code is null ? "true" : "false")" @onclick="() => FilterCodeAsync(null)">@Texts.Get("admin.subProfiles.all")</button>
            @foreach (var item in detail.IssueCodes)
            {
                <button type="button" class="chip @(code == item.Code ? "active" : null)" aria-pressed="@(code == item.Code ? "true" : "false")"
                        @onclick="() => FilterCodeAsync(item.Code)">@SettingsLabels.ImportCode(item.Code) (@item.Count)</button>
            }
        </div>

        <table class="table record-table">
            <caption class="visually-hidden">@Texts.Get("admin.importRun.issues")</caption>
            <thead>
                <tr><th scope="col">@Texts.Get("admin.importRun.row")</th><th scope="col">@Texts.Get("admin.importDesign.column")</th><th scope="col">@Texts.Get("admin.importRun.error")</th><th scope="col">@Texts.Get("admin.importRun.severity")</th><th scope="col">@Texts.Get("common.field.description")</th></tr>
            </thead>
            <tbody>
                @foreach (var issue in detail.Issues.Items)
                {
                    <tr>
                        <td data-label="@Texts.Get("admin.importRun.row")">@(issue.RowNo == 0 ? Texts.Get("admin.importRun.file") : issue.RowNo.ToString())</td>
                        <td data-label="@Texts.Get("admin.importDesign.column")">@(issue.ColumnKey ?? "—")</td>
                        <td data-label="@Texts.Get("admin.importRun.error")">@SettingsLabels.ImportCode(issue.Code)</td>
                        <td data-label="@Texts.Get("admin.importRun.severity")"><span class="badge stage-@ImportText.SeverityBadge(issue.Severity)">@SettingsLabels.ImportSeverity(issue.Severity)</span></td>
                        <td data-label="@Texts.Get("common.field.description")">@issue.Message</td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager Page="detail.Issues.Page" PageSize="detail.Issues.PageSize" TotalCount="detail.Issues.TotalCount" PageChanged="LoadAsync" />
        @if (run.FailedCount > detail.IssueCodes.Sum(c => c.Count))
        {
            <p class="text-muted">@Texts.Get("admin.importRun.truncated")</p>
        }
    }
}

@code {
    [Parameter, EditorRequired] public Guid RunId { get; set; }

    private ImportRunDetailDto? detail;
    private string? message;
    private string? code;
    private bool confirming;
    private bool busy;
    private string? reason;
    private ImportRollbackDto? outcome;

    // Geri alma sonucu: silinen, zaten silinmiş ve korunan kayıt sayıları; korunma nedenleri sunucudan gelir.
    private static string Outcome(ImportRollbackDto result) =>
        Texts.Get("admin.importRun.removed", result.Removed)
        + (result.AlreadyRemoved > 0 ? Texts.Get("admin.importRun.alreadyRemoved", result.AlreadyRemoved) : string.Empty)
        + (result.Kept.Count > 0 ? Texts.Get("admin.importRun.kept", result.Kept.Count, string.Join(" ", result.Kept.Select(k => k.Reason).Distinct())) : ".");

    private bool CanRollBack(ImportRunDto run) =>
        Session.Can(CoreAccess.RollbackImports) && run.Mode == "Apply" && run.Status is "Succeeded" or "PartiallySucceeded" && run.CreatedCount > 0;

    private async Task RollBackAsync()
    {
        busy = true;
        var result = await Api.PostAsync<ImportRollbackDto>($"/api/imports/{RunId}/rollback", new ImportRollbackRequest(reason));
        busy = false;
        if (result.Value is not { } done)
        {
            message = result.FieldErrors?.Values.SelectMany(v => v).FirstOrDefault() ?? result.Error;
            return;
        }

        outcome = done;
        confirming = false;
        reason = null;
        await LoadAsync(1);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (detail is null || detail.Run.Id != RunId)
        {
            code = null;
            await LoadAsync(1);
        }
    }

    private Task FilterCodeAsync(string? value)
    {
        code = value;
        return LoadAsync(1);
    }

    private async Task LoadAsync(int pageNumber)
    {
        var query = $"page={pageNumber}" + (code is null ? string.Empty : $"&code={Uri.EscapeDataString(code)}");
        var result = await Api.GetAsync<ImportRunDetailDto>($"/api/imports/{RunId}?{query}");
        detail = result.Value;
        message = result.IsSuccess ? null : result.Error;
    }
}
