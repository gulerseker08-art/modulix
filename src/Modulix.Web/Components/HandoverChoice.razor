@* Kayıt devri seçimi: kişinin sorumlu olduğu kayıtlar ve devralacak etkin üye. Devir sunucuda kayıt boru hattından
   geçer; işlemi yapanın kayıtları düzenleme izni yoksa hiçbir şey değişmez. *@
@if (Owned is null)
{
    <p class="text-muted">@Texts.Get("admin.handover.loadFailed")</p>
}
else if (Owned.Count == 0 || Owned.All(o => o.Count == 0))
{
    <EmptyState Compact="true" Title="@Texts.Get("admin.handover.none")" />
}
else
{
    <p>@Texts.Strong("admin.handover.owned", Describe(Owned))</p>
    @if (Owned.Any(o => o.Count is null))
    {
        <p class="text-muted">@Texts.Get("admin.handover.hidden")</p>
    }

    <div class="mb-3 handover-choice">
        <label class="form-label" for="receiver">@Texts.Get("admin.handover.receiver")</label>
        <select id="receiver" class="form-select" value="@Selected?.ToString()" @onchange="Changed">
            @if (!Required)
            {
                <option value="">@Texts.Get("admin.handover.keep")</option>
            }
            else
            {
                <option value="">@Texts.Get("support.choose")</option>
            }
            @foreach (var receiver in Receivers)
            {
                <option value="@receiver.MembershipId">@receiver.DisplayName</option>
            }
        </select>
        <div class="form-text">@Texts.Get("admin.handover.closedStay")</div>
    </div>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<OwnedRecordsDto>? Owned { get; set; }

    [Parameter, EditorRequired] public IReadOnlyList<UserDto> Receivers { get; set; } = [];

    /// <summary>Devir zorunlu mu (yalnızca devir işlemi) yoksa isteğe bağlı mı (devre dışı bırakma)?</summary>
    [Parameter] public bool Required { get; set; }

    [Parameter] public Guid? Selected { get; set; }

    [Parameter] public EventCallback<Guid?> SelectedChanged { get; set; }

    /// <summary>Ör. "12 firma, 3 açık fırsat"; sayısı sıfır olanlar yazılmaz.</summary>
    public static string Describe(IEnumerable<OwnedRecordsDto> owned) =>
        string.Join(", ", owned.Where(o => o.Count > 0).Select(o => $"{o.Count} {o.Label}"));

    private Task Changed(ChangeEventArgs e) =>
        SelectedChanged.InvokeAsync(Guid.TryParse(e.Value?.ToString(), out var id) ? id : null);
}
