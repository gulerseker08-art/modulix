@* Yapılandırılmış adresler (ADR-0012): firma düzeyinde (LocationId boş) ya da bir lokasyonun adresleri. Liste ve satır içi düzenleme. *@
@inject ApiClient Api
@inject ToastService Toasts

<div class="sub-section @(open ? null : "closed")">
    <div class="section-header">
        <h3>
            <button type="button" class="section-toggle" aria-expanded="@(open ? "true" : "false")"@onclick="() => open = !open">
                <span class="section-icon"><AppIcon Name="map-pin" Size="18" /></span>
                <span class="section-title">@(Title ?? Texts.Get("crm.company.addresses"))</span>
                @if (items is not null)
                {
                    <span class="count-pill">@items.Count</span>
                }
                <span class="section-chevron"><AppIcon Name="chevron-down" Size="18" /></span>
            </button>
        </h3>
        @if (CanWrite && form is null)
        {
            <button type="button" class="btn btn-outline-primary btn-sm" @onclick="OpenNew">@Texts.Get("crm.address.add")</button>
        }
    </div>

    @if (open)
    {
    <div class="section-body">
    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }

    @if (form is not null)
    {
        <form class="record-form" novalidate @onsubmit="SaveAsync" @onsubmit:preventDefault>
            <FormTabs Title="@Texts.Get("crm.address.info")" Label="@Texts.Get("crm.address.tabs")">
            <div class="form-grid">
                <div>
                    <label class="form-label">@Texts.Get("crm.company.editor.kind")</label>
                    <select class="form-select" @bind="form.Type">
                        @foreach (var (key, label) in SharedLabels.Addresses())
                        {
                            <option value="@key">@label</option>
                        }
                    </select>
                    <FieldError Field="type" Errors="errors" />
                </div>
                <div>
                    <label class="form-label">@Texts.Get("crm.address.country")</label>
                    <input class="form-control" maxlength="2" @bind="form.Country" />
                    <FieldError Field="country" Errors="errors" />
                </div>
                <div class="span-all">
                    <label class="form-label">@Texts.Get("crm.address.line1")</label>
                    <input class="form-control" maxlength="@CrmDirectoryLimits.AddressLineMaxLength" @bind="form.Line1" />
                    <FieldError Field="line1" Errors="errors" />
                </div>
                <div class="span-all">
                    <label class="form-label">@Texts.Get("crm.address.line2")</label>
                    <input class="form-control" maxlength="@CrmDirectoryLimits.AddressLineMaxLength" @bind="form.Line2" />
                    <FieldError Field="line2" Errors="errors" />
                </div>
                <div>
                    <label class="form-label">@Texts.Get("crm.address.district")</label>
                    <input class="form-control" maxlength="@CrmDirectoryLimits.AddressPartMaxLength" @bind="form.District" />
                    <FieldError Field="district" Errors="errors" />
                </div>
                <div>
                    <label class="form-label">@Texts.Get("common.field.city")</label>
                    <input class="form-control" maxlength="@CrmDirectoryLimits.AddressPartMaxLength" @bind="form.City" />
                    <FieldError Field="city" Errors="errors" />
                </div>
                <div>
                    <label class="form-label">@Texts.Get("crm.address.postalCode")</label>
                    <input class="form-control" maxlength="@CrmDirectoryLimits.PostalCodeMaxLength" @bind="form.PostalCode" />
                    <FieldError Field="postalCode" Errors="errors" />
                </div>
                <div>
                    <label class="form-check-inline"><input type="checkbox" @bind="form.IsPrimary" /> @Texts.Get("crm.address.primary")</label>
                    <FieldError Field="isPrimary" Errors="errors" />
                </div>
                @if (form.Id is not null)
                {
                    <div>
                        <label class="form-check-inline"><input type="checkbox" @bind="form.IsActive" /> @Texts.Get("common.active")</label>
                    </div>
                }
            </div>
            </FormTabs>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary btn-sm" disabled="@busy">@Texts.Get("common.save")</button>
                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => form = null">@Texts.Get("common.dismiss")</button>
            </div>
        </form>
    }

    @if (items is { Count: > 0 })
    {
        <ul class="item-list">
            @foreach (var item in items)
            {
                <li class="@(item.IsActive ? null : "done")">
                    @if (confirming == item.Id)
                    {
                        <ConfirmBox Text="@Texts.Get("common.confirm.deleteOf", AddressTitle(item))" Busy="busy" Confirm="() => DeleteAsync(item)" Cancel="() => confirming = null" />
                    }
                    else
                    {
                        <div class="item-main">
                            <strong>@item.Line1@(item.Line2 is { Length: > 0 } ? $", {item.Line2}" : null)</strong>
                            <span>
                                @string.Join(", ", new[] { item.PostalCode, item.District, item.City, item.Country }.Where(s => !string.IsNullOrWhiteSpace(s)))
                                · @SharedLabels.Address(item.Type)
                                @if (item.IsPrimary) { <text> · </text><span class="badge status-customer">@Texts.Get("common.primaryBadge")</span> }
                                @if (!item.IsActive) { <text> · @Texts.Get("common.inactive")</text> }
                            </span>
                        </div>
                        @if (CanWrite)
                        {
                            <RowMenu Label="@Texts.Get("common.rowActionsOf", AddressTitle(item))">
                                <button type="button" class="view-menu-item" role="menuitem" @onclick="() => Open(item)"><AppIcon Name="pencil" Size="16" /> <span>@Texts.Get("common.edit")</span></button>
                                <button type="button" class="view-menu-item is-danger" role="menuitem" @onclick="() => confirming = item.Id"><AppIcon Name="trash" Size="16" /> <span>@Texts.Get("common.delete")</span></button>
                            </RowMenu>
                        }
                    }
                </li>
            }
        </ul>
    }
    else if (items is not null)
    {
        <EmptyState Compact="true" Title="@Texts.Get("crm.address.none")" />
    }
    </div>
    }
</div>

@code {
    private const string Url = "/api/crm/addresses";

    private bool open = true;

    private IReadOnlyList<AddressDto>? items;
    private AddressForm? form;
    private IReadOnlyDictionary<string, string[]>? errors;
    private string? message;
    private bool busy;
    private (Guid, Guid?)? loadedFor;

    [Parameter, EditorRequired] public Guid CompanyId { get; set; }

    [Parameter] public Guid? LocationId { get; set; }

    [Parameter] public string? Title { get; set; }

    [Parameter] public bool CanWrite { get; set; }

    /// <summary>Kaydedilince çağrılır (firma düzeyindeki ana adres eski adres/şehir alanını da değiştirir).</summary>
    [Parameter] public EventCallback Changed { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (loadedFor == (CompanyId, LocationId))
        {
            return;
        }

        loadedFor = (CompanyId, LocationId);
        form = null;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var query = $"companyId={CompanyId}" + (LocationId is { } location ? $"&locationId={location}" : "&companyLevel=true");
        items = (await Api.GetAsync<CrmPage<AddressDto>>($"{Url}?{query}&pageSize=100")).Value?.Items ?? [];
    }

    // Kapalı bölümde "Adres ekle" bölümü açar; yoksa form görünmez kalırdı.
    private void OpenNew()
    {
        open = true;
        Open(null);
    }

    private void Open(AddressDto? a)
    {
        form = a is null
            ? new AddressForm { IsPrimary = items?.Count == 0, Type = LocationId is null ? "Registered" : "Shipping" }
            : new AddressForm
            {
                Id = a.Id, Version = a.Version, Type = a.Type, Country = a.Country, City = a.City, District = a.District, PostalCode = a.PostalCode,
                Line1 = a.Line1, Line2 = a.Line2, IsPrimary = a.IsPrimary, IsActive = a.IsActive,
            };
        errors = null;
        message = null;
    }

    private async Task SaveAsync()
    {
        busy = true;
        var f = form!;
        var request = new SaveAddressRequest(CompanyId, f.Line1, LocationId, f.Type, f.IsPrimary, f.IsActive, f.Country, f.City, f.District,
            f.PostalCode, f.Line2, f.Version);
        var result = f.Id is { } id ? await Api.PutAsync<AddressDto>($"{Url}/{id}", request) : await Api.PostAsync<AddressDto>(Url, request);
        busy = false;

        if (result.IsSuccess)
        {
            form = null;
            await LoadAsync();
            await Changed.InvokeAsync();
            return;
        }

        errors = result.FieldErrors;
        message = result.Error;
    }

    // Adres satırı boş olabilir (yalnızca şehir girilmiş adres); o zaman şehir ya da tür adı kullanılır.
    private static string AddressTitle(AddressDto address) =>
        new[] { address.Line1, address.City }.FirstOrDefault(v => !string.IsNullOrWhiteSpace(v)) ?? SharedLabels.Address(address.Type);

    // Silme iki adımlıdır: menüdeki "Sil" onay kutusunu açar, kutudaki düğme siler.
    private Guid? confirming;

    private async Task DeleteAsync(AddressDto address)
    {
        busy = true;
        var result = await Api.DeleteAsync($"{Url}/{address.Id}?version={address.Version}");
        busy = false;
        confirming = null;
        message = result.Error;
        if (result.IsSuccess)
        {
            Toasts.Success(Texts.Get("common.deleted"));
        }

        await LoadAsync();
        await Changed.InvokeAsync();
    }

    private sealed class AddressForm
    {
        public Guid? Id { get; init; }

        public long? Version { get; init; }

        public string Type { get; set; } = "Other";

        public string Country { get; set; } = "TR";

        public string? City { get; set; }

        public string? District { get; set; }

        public string? PostalCode { get; set; }

        public string Line1 { get; set; } = string.Empty;

        public string? Line2 { get; set; }

        public bool IsPrimary { get; set; }

        public bool IsActive { get; set; } = true;
    }
}
