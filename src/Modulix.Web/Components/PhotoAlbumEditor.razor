@* Fotoğraf albümü formu (ADR-0042 dilim 8). Düzen firmanın form düzenine (ADR-0021) göre çizilir. Fotoğraflar albüm kaydedildikten sonra dosya
   panelinden eklenir; "Yayında" işaretlenmeden okurlar albümü ve fotoğraflarını görmez. *@
@using System.Text.Json.Nodes
@inject ApiClient Api
@inject FormLayouts Layouts

<form class="record-form sectioned" novalidate @onsubmit="SaveAsync" @onsubmit:preventDefault @oninput="() => dirty = true">
    <div class="form-toolbar">
        <div>
            <h2>@(Album is null ? "Yeni albüm" : "Fotoğraf albümü")</h2>
        </div>
        <div class="form-toolbar-actions">
            <UnsavedChanges IsDirty="() => dirty" />
            <button type="button" class="btn btn-outline-secondary" @onclick="Cancelled">İptal</button>
            <button type="submit" class="btn btn-primary" disabled="@(busy || layout is null)" aria-busy="@(busy ? "true" : null)">Kaydet</button>
        </div>
    </div>

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }
    @if (layoutError is not null)
    {
        <div class="alert alert-danger" role="alert">@layoutError</div>
    }

    <LayoutForm Layout="layout" CustomFields="CustomFields" CustomValues="form.Custom" Errors="errors" TabsLabel="Albüm bölümleri">
        <Field Context="f">
            @switch (f.Key)
            {
                case "title":
                    <label class="@f.LabelClass()" for="album-title">@f.Label</label>
                    <input id="album-title" class="form-control" maxlength="200" required aria-required="true" placeholder="ör. Yılbaşı kutlaması 2026" @bind="form.Title" />
                    <FieldError Field="title" Errors="errors" />
                    break;
                case "description":
                    <label class="@f.LabelClass()" for="album-description">@f.Label</label>
                    <textarea id="album-description" class="form-control" rows="3" maxlength="2000" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.Description"></textarea>
                    <FieldError Field="description" Errors="errors" />
                    break;
                case "eventDate":
                    <label class="@f.LabelClass()" for="album-date">@f.Label</label>
                    <input id="album-date" class="form-control" type="date" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.EventDate" />
                    <FieldError Field="eventDate" Errors="errors" />
                    break;
                case "isPublished":
                    <div class="form-check mt-4">
                        <input id="album-published" class="form-check-input" type="checkbox" @bind="form.IsPublished" />
                        <label class="form-check-label" for="album-published">@f.Label</label>
                    </div>
                    break;
            }
        </Field>
    </LayoutForm>
</form>

@code {
    private const string EntityKey = HrAccess.PhotoAlbumEntityKey;

    private bool dirty;
    private FormLayoutDto? layout;
    private string? layoutError;
    private AlbumForm form = new();
    private IReadOnlyDictionary<string, string[]>? errors;
    private string? message;
    private bool busy;

    [Parameter] public RecordResponse? Album { get; set; }

    [Parameter, EditorRequired] public CrmLookups Lookups { get; set; } = default!;

    [Parameter] public EventCallback<RecordResponse> Saved { get; set; }

    [Parameter] public EventCallback Cancelled { get; set; }

    private IReadOnlyList<CustomFieldDto> CustomFields => [.. Lookups.FieldsOf(EntityKey)];

    protected override async Task OnInitializedAsync()
    {
        form = Album is { } a
            ? new AlbumForm
            {
                Id = a.Id, Version = a.Version, Title = WarehouseLabels.Text(a, "title"), Description = WarehouseLabels.Text(a, "description"),
                EventDate = FleetLabels.Day(WarehouseLabels.Text(a, "eventDate")), IsPublished = WarehouseLabels.Flag(a, "isPublished"),
                Custom = a.Values["custom"]?.DeepClone().AsObject() ?? [],
            }
            : new AlbumForm();
        layout = await Layouts.ForAsync(EntityKey);
        layoutError = layout is null ? "Form düzeni yüklenemedi; sayfayı yenileyip yeniden deneyin." : null;
    }

    private async Task SaveAsync()
    {
        busy = true;
        message = null;
        errors = null;
        var request = new RecordWriteRequest(new JsonObject
        {
            ["title"] = string.IsNullOrWhiteSpace(form.Title) ? null : form.Title.Trim(),
            ["description"] = string.IsNullOrWhiteSpace(form.Description) ? null : form.Description.Trim(),
            ["eventDate"] = form.EventDate?.ToString("yyyy-MM-dd"),
            ["isPublished"] = form.IsPublished,
            ["custom"] = CustomFieldText.ForSave(CustomFields, form.Custom),
        }, form.Version);
        var url = "/api/records/" + EntityKey;
        var result = form.Id is { } id ? await Api.PutAsync<RecordResponse>($"{url}/{id}", request) : await Api.PostAsync<RecordResponse>(url, request);
        busy = false;
        if (result.IsSuccess)
        {
            dirty = false;
            await Saved.InvokeAsync(result.Value!);
            return;
        }

        errors = result.FieldErrors;
        message = result.Error;
    }

    private sealed class AlbumForm
    {
        public JsonObject Custom { get; set; } = [];

        public Guid? Id { get; init; }

        public long? Version { get; init; }

        public string? Title { get; set; }

        public string? Description { get; set; }

        public DateOnly? EventDate { get; set; }

        public bool IsPublished { get; set; }
    }
}
