@* Stok hareketi kayıt formu; Stok hareketleri ekranı kullanır (ADR-0032 dilim 6b). Defter yalnızca eklenir: form yalnızca yeni hareket yazar, düzenleme yoktur;
   düzeltme listedeki "Geri al" eylemiyle ters kayıt olarak yapılır. Hareket türünün kategorisi (giriş/çıkış/transfer) hangi lokasyonların istendiğini belirler;
   kategori listenin değerinden okunur, türün adına bakılmaz. Yetersiz stok, pasif parti/lokasyon ve tür–lokasyon biçimi sunucuda denetlenir. Form açılırken
   üretilen tekrar anahtarı (idempotencyKey) çift tıklamada ikinci hareketin yazılmasını engeller. Hareket kaydı metadata form düzeni dışındadır (özel alanı yok). *@
@using System.Globalization
@using System.Text.Json.Nodes
@inject ApiClient Api
@inject ToastService Toasts

<form class="record-form" novalidate @onsubmit="SaveAsync" @onsubmit:preventDefault @oninput="() => dirty = true">
    <div class="form-toolbar">
        <div>
            <h2>@Texts.Get("warehouse.stockMovementEditor.title")</h2>
            <p>@Texts.Get("warehouse.stockMovementEditor.note")</p>
        </div>
        <div class="form-toolbar-actions">
            <UnsavedChanges IsDirty="() => dirty" />
            <button type="button" class="btn btn-outline-secondary" @onclick="Cancelled">@Texts.Get("common.cancel")</button>
            <button type="submit" class="btn btn-primary" disabled="@busy" aria-busy="@(busy ? "true" : "false")">
                @if (busy)
                {
                    <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                }
                @Texts.Get("common.save")
            </button>
        </div>
    </div>

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }

    <FormTabs Title="@Texts.Get("warehouse.stockMovementEditor.tab")" Label="@Texts.Get("warehouse.stockMovementEditor.tabs")">
        <div class="form-grid">
            <div>
                <label class="form-label required" for="movement-type">@Texts.Get("warehouse.movementType")</label>
                <select id="movement-type" class="form-select" required aria-required="true" @bind="form.TypeKey">
                    <option value="">@Texts.Get("common.choose")</option>
                    @foreach (var type in DirectTypes)
                    {
                        <option value="@type.Key">@type.Label</option>
                    }
                </select>
                <FieldError Field="typeKey" Errors="errors" />
            </div>
            <div>
                <label class="form-label required" for="movement-lot">@Texts.Get("warehouse.lot")</label>
                <LookupPicker Id="movement-lot" LookupKey="@WarehouseAccess.MovementLotLookup" @bind-Value="form.LotId" Required="true" Placeholder="@Texts.Get("warehouse.chooseLot")" Invalid="@(errors?.ContainsKey("lotId") == true)" />
                <FieldError Field="lotId" Errors="errors" />
            </div>
            @if (Category is WarehouseAccess.MovementOutbound or WarehouseAccess.MovementTransfer)
            {
                <div>
                    <label class="form-label required" for="movement-from">@Texts.Get("warehouse.fromLocation")</label>
                    <LookupPicker Id="movement-from" LookupKey="@WarehouseAccess.MovementFromLocationLookup" @bind-Value="form.FromLocationId" Required="true" Placeholder="@Texts.Get("warehouse.stockMovementEditor.chooseFrom")" Invalid="@(errors?.ContainsKey("fromLocationId") == true)" />
                    <FieldError Field="fromLocationId" Errors="errors" />
                </div>
            }
            @if (Category is WarehouseAccess.MovementInbound or WarehouseAccess.MovementTransfer)
            {
                <div>
                    <label class="form-label required" for="movement-to">@Texts.Get("warehouse.toLocation")</label>
                    <LookupPicker Id="movement-to" LookupKey="@WarehouseAccess.MovementToLocationLookup" @bind-Value="form.ToLocationId" Required="true" Placeholder="@Texts.Get("warehouse.stockMovementEditor.chooseTo")" Invalid="@(errors?.ContainsKey("toLocationId") == true)" />
                    <FieldError Field="toLocationId" Errors="errors" />
                </div>
            }
            <div>
                <label class="form-label required" for="movement-quantity">@Texts.Get("warehouse.quantity")</label>
                <input id="movement-quantity" class="form-control" inputmode="decimal" required aria-required="true" placeholder="@Texts.Get("warehouse.quantityPlaceholder")" @bind="form.Quantity" />
                <FieldError Field="quantity" Errors="errors" />
                <small class="text-muted">@Texts.Get("warehouse.quantityHelp")</small>
            </div>
            <div>
                <label class="form-label" for="movement-reason">@Texts.Get("warehouse.reason")</label>
                <select id="movement-reason" class="form-select" @bind="form.ReasonKey">
                    <option value="">—</option>
                    @foreach (var reason in Lookups.ValuesOf(WarehouseAccess.MovementReasonList).Where(v => v.Active))
                    {
                        <option value="@reason.Key">@reason.Label</option>
                    }
                </select>
                <FieldError Field="reasonKey" Errors="errors" />
            </div>
            <div>
                <label class="form-label" for="movement-document">@Texts.Get("warehouse.documentReference")</label>
                <input id="movement-document" class="form-control" maxlength="200" placeholder="@Texts.Get("warehouse.stockMovementEditor.documentPlaceholder")" @bind="form.DocumentReference" />
                <FieldError Field="documentReference" Errors="errors" />
            </div>
        </div>
    </FormTabs>
</form>

@code {
    private static readonly string Url = "/api/records/" + WarehouseAccess.StockMovementEntityKey;

    private bool dirty;
    private MovementForm form = new();
    private IReadOnlyDictionary<string, string[]>? errors;
    private string? message;
    private bool busy;

    [Parameter, EditorRequired] public CrmLookups Lookups { get; set; } = default!;

    /// <summary>Formun önceden seçili partisi (ör. parti listesinden gelince); boşsa seçilir.</summary>
    [Parameter] public Guid? LotId { get; set; }

    [Parameter] public EventCallback<RecordResponse> Saved { get; set; }

    [Parameter] public EventCallback Cancelled { get; set; }

    // Düzeltme türleri formda yoktur: düzeltme bir hareketi geri alır ve listedeki satır eyleminden yapılır.
    private IEnumerable<ChoiceValueDto> DirectTypes =>
        Lookups.ValuesOf(WarehouseAccess.MovementTypeList).Where(v => v.Active && v.Category != WarehouseAccess.MovementAdjustment);

    private string? Category => Lookups.CategoryOf(WarehouseAccess.MovementTypeList, form.TypeKey);

    protected override void OnInitialized() => form = new MovementForm { LotId = LotId };

    private async Task SaveAsync()
    {
        errors = null;
        message = null;
        if (!TryParseQuantity(form.Quantity, out var quantity))
        {
            errors = new Dictionary<string, string[]> { ["quantity"] = [Texts.Get("warehouse.quantityInvalid")] };
            return;
        }

        busy = true;
        var category = Category;
        var values = new JsonObject
        {
            ["typeKey"] = string.IsNullOrEmpty(form.TypeKey) ? null : form.TypeKey,
            ["lotId"] = form.LotId?.ToString(),
            ["fromLocationId"] = category is WarehouseAccess.MovementOutbound or WarehouseAccess.MovementTransfer ? form.FromLocationId?.ToString() : null,
            ["toLocationId"] = category is WarehouseAccess.MovementInbound or WarehouseAccess.MovementTransfer ? form.ToLocationId?.ToString() : null,
            ["quantity"] = quantity,
            ["reasonKey"] = string.IsNullOrEmpty(form.ReasonKey) ? null : form.ReasonKey,
            ["documentReference"] = string.IsNullOrWhiteSpace(form.DocumentReference) ? null : form.DocumentReference.Trim(),
            ["idempotencyKey"] = form.IdempotencyKey,
        };

        var result = await Api.PostAsync<RecordResponse>(Url, new RecordWriteRequest(values, null));
        busy = false;

        if (result.IsSuccess)
        {
            dirty = false;
            Toasts.Success(Texts.Get("common.saved"));
            await Saved.InvokeAsync(result.Value!);
            return;
        }

        errors = result.FieldErrors;
        message = result.Error;
    }

    /// <summary>Türkçe (12,5) ve noktalı (12.5) yazımı kabul eder; binlik ayraç kullanılmaz.</summary>
    private static bool TryParseQuantity(string? text, out decimal? quantity)
    {
        quantity = null;
        if (string.IsNullOrWhiteSpace(text))
        {
            return true;
        }

        if (decimal.TryParse(text.Trim().Replace(',', '.'), NumberStyles.AllowDecimalPoint, CultureInfo.InvariantCulture, out var value))
        {
            quantity = value;
            return true;
        }

        return false;
    }

    private sealed class MovementForm
    {
        public string TypeKey { get; set; } = string.Empty;

        public Guid? LotId { get; set; }

        public Guid? FromLocationId { get; set; }

        public Guid? ToLocationId { get; set; }

        public string? Quantity { get; set; }

        public string ReasonKey { get; set; } = string.Empty;

        public string? DocumentReference { get; set; }

        /// <summary>Form başına bir kez üretilir; aynı form ikinci kez gönderilirse sunucu ikinci hareketi yazmaz (409).</summary>
        public string IdempotencyKey { get; } = "ui-" + Guid.NewGuid().ToString("N");
    }
}
