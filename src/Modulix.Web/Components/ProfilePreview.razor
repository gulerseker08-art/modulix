@* Sektör profilinin firmaya ekleyeceği şeyler (Y9c, "Şunlar eklenecek"); firma yönetimi ve platform ekranı kullanır. *@

@if (Plan.IsEmpty)
{
    <p class="text-muted">@Texts.Get("admin.sectorProfile.nothingToAdd")</p>
}
else
{
    <p>@(Applied ? Texts.Get("admin.sectorProfile.added") : Texts.Get("admin.sectorProfile.toAdd"))</p>
    <ul class="profile-plan">
        @if (Plan.ModulesToEnable.Count > 0)
        {
            <li><strong>@Texts.Get("admin.sectorProfile.modulesToEnable")</strong> @string.Join(", ", Plan.ModulesToEnable)</li>
        }
        @foreach (var field in Plan.Fields)
        {
            <li>@FieldLine(field)</li>
        }
        @foreach (var value in Plan.ListValues)
        {
            <li>@((MarkupString)Texts.Get("admin.sectorProfile.planValue", Bold(value.ListName), Italic(value.Label)))</li>
        }
    </ul>
}
@if (Plan.UnavailableModules.Count > 0)
{
    <p class="form-text">
        @Texts.Get("admin.sectorProfile.unavailable", string.Join(", ", Plan.UnavailableModules))
    </p>
}
@if (!Applied)
{
    <p class="form-text">@Texts.Get("admin.sectorProfile.keepsExisting")</p>
}

@code {
    [Parameter, EditorRequired] public ProfilePlanDto Plan { get; set; } = default!;

    /// <summary>Uygulandıktan sonra gösteriliyorsa true ("Şunlar eklendi").</summary>
    [Parameter] public bool Applied { get; set; }

    // Kayıt türü kalın, alan adı eğik yazılır; sunucudan gelen adlar HTML'e kodlanır.
    private static string Bold(string text) => $"<strong>{System.Net.WebUtility.HtmlEncode(text)}</strong>";

    private static string Italic(string text) => $"<em>{System.Net.WebUtility.HtmlEncode(text)}</em>";

    private static MarkupString FieldLine(ProfileFieldDto field)
    {
        var type = SettingsLabels.FieldType(field.Type) + (field.Options.Count > 0 ? $": {string.Join(", ", field.Options)}" : null);
        return (MarkupString)Texts.Get("admin.sectorProfile.planField", Bold(field.EntityName), Italic(field.Label), System.Net.WebUtility.HtmlEncode(type));
    }
}
