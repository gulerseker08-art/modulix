@using System.Text.Json.Nodes
@inject ApiClient Api
@inject SessionState Session
@inject CrmLookups Lookups

@* Belge takibi (ADR-0038 dilim 2b; sayfaları VehicleCredentials ve DriverCredentials): bir sahip türünün (Filo: araç, Lojistik: sürücü) bütün süreli belgeleri, bitişi en yakın olandan başlayarak.
   Varsayılan görünüm "Bitişi yaklaşan"dır (bugün geçerli ve 30 gün içinde bitecek). Belge eklemek kartın "Belgeler" panelindendir; buradan
   düzenlenir. Belgeler genel kayıt uçlarından okunur; sahip adı (plaka, ad soyad) sunucunun ownerLabel değeridir. *@

<PageTitle>@Config.Title · Modulix</PageTitle>

<AuthGate Module="@Config.Module" Permission="@Config.ReadPermission">
    <PageHeader Title="@Config.Title" Icon="calendar" Subtitle="@(page is null ? Config.Subtitle : $"{page.TotalCount} belge")" />

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }

    @if (editing && selected is not null)
    {
        <CredentialEditor Credential="selected" OwnerEntityKey="@Config.OwnerEntityKey" OwnerId="@(WarehouseLabels.Id(selected, "ownerId") ?? Guid.Empty)"
                          Category="@Config.Category" Lookups="Lookups" CanWrite="@Session.Can(Config.WritePermission)"
                          Saved="SavedAsync" Deleted="SavedAsync" Cancelled="Close" />
    }

    @* Görünümler sunucuda süzgeç olarak uygulanır; sayfalama ve toplam doğru kalır. *@
    <ViewTabs Items="ViewOptions" Value="@view" ValueChanged="ChooseViewAsync" Label="Belge görünümleri" NewView="StartNaming" NewViewText="Görünüm" />

    <div class="list-toolbar">
        <form class="search" @onsubmit="() => LoadAsync(1)" @onsubmit:preventDefault>
            <input class="form-control" type="search" aria-label="Belge ara" placeholder="Belge no veya veren kurum ara" @bind="search" />
        </form>
        <GridColumnPicker State="grid" Changed="ColumnsChanged" />
    </div>

    <PersonalViewBar Active="Active" Dirty="grid.Differs(Active)" Naming="views.Naming" NamingChanged="views.StartNaming" Error="@views.Error"
                     SaveAs="SaveAsAsync" UpdateView="UpdateViewAsync" DiscardChanges="DiscardAsync" DeleteView="DeleteViewAsync" />

    @if (page is null)
    {
        <p class="text-muted" role="status">Yükleniyor…</p>
    }
    else if (page.Items.Count == 0)
    {
        <p class="text-muted" role="status">@(view == ExpiringView ? $"Önümüzdeki {CredentialAccess.ExpiringDays} gün içinde biten belge yok." : "Bu görünüme uyan belge yok.")</p>
    }
    else
    {
        <p class="visually-hidden" role="status" aria-live="polite">@(page.TotalCount) belge listelendi.</p>
        <table class="table record-table">
            <caption class="visually-hidden">@Config.Title</caption>
            <thead>
                <tr>
                    @foreach (var column in grid.VisibleColumns)
                    {
                        <GridHeader Column="column" State="grid" SortChanged="SortAsync" />
                    }
                    <th scope="col" class="row-menu-cell"><span class="visually-hidden">Eylemler</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var credential in page.Items)
                {
                    <tr>
                        @foreach (var column in grid.VisibleColumns)
                        {
                            @Cell(column, credential)
                        }
                        <td class="row-menu-cell">
                            <RowMenu Label="@($"{Lookups.Label(CredentialAccess.TypeList, WarehouseLabels.Text(credential, "typeKey"))} eylemleri")">
                                <button type="button" class="view-menu-item" role="menuitem" @onclick="() => Open(credential)">
                                    <AppIcon Name="pencil" Size="16" /> <span>@(Session.Can(Config.WritePermission) ? "Düzenle" : "Aç")</span>
                                </button>
                            </RowMenu>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager PageSizeChoice="true" Page="page.Page" PageSize="page.PageSize" TotalCount="page.TotalCount" PageChanged="LoadAsync" />
    }
</AuthGate>

@code {
    private static readonly string Url = "/api/records/" + CredentialAccess.EntityKey;

    private const string ExpiringView = "expiring";
    private const string ExpiredView = "expired";
    private const string CurrentView = "current";
    private const string AllViews = "all";
    private const string RevokedView = "revoked";

    /// <summary>Rotaya göre sahip türü: Filo araç belgelerini, Lojistik sürücü belgelerini izler (modül ve izin sahip türünündür).</summary>
    private sealed record TrackingConfig(
        string Module, string ReadPermission, string WritePermission, string OwnerEntityKey, string Category, string Title, string Subtitle,
        string OwnerLabel, string OwnerIcon, string GridKey);

    private static readonly TrackingConfig VehicleConfig = new(
        FleetAccess.ModuleKey, FleetAccess.VehiclesRead, FleetAccess.VehiclesWrite, FleetAccess.VehicleEntityKey, CredentialAccess.Vehicle,
        "Araç belgeleri", "Muayene, sigorta ve kasko bitişlerini tek listede izleyin.", "Araç", "truck", "fleet.credentials");

    private static readonly TrackingConfig DriverConfig = new(
        LogisticsAccess.ModuleKey, LogisticsAccess.DriversRead, LogisticsAccess.DriversWrite, LogisticsAccess.DriverEntityKey, CredentialAccess.Driver,
        "Sürücü belgeleri", "Ehliyet, SRC ve psikoteknik bitişlerini tek listede izleyin.", "Sürücü", "user", "logistics.credentials");

    /// <summary>Sahip türü: <c>vehicle</c> (Filo) ya da <c>driver</c> (Lojistik).</summary>
    [Parameter, EditorRequired] public string Owner { get; set; } = CredentialAccess.Vehicle;

    private TrackingConfig Config => Owner == CredentialAccess.Driver ? DriverConfig : VehicleConfig;

    private GridViewState grid = default!;
    private PersonalGridViews views = default!;
    private RecordPageResponse? page;
    private RecordResponse? selected;
    private bool editing;
    private string? message;
    private string? search;
    private string view = ExpiringView;
    private string? validOn;
    private string? expiresBy;
    private string? expiredBefore;
    private string? status;

    private static DateOnly Today => DateOnly.FromDateTime(DateTime.Now);

    private TrackingConfig? loadedFor;

    // İki sayfa aynı bileşeni kullanır; sahip türü değişince (Filo ile Lojistik arasında geçiş) liste baştan yüklenir.
    protected override async Task OnParametersSetAsync()
    {
        if (ReferenceEquals(loadedFor, Config))
        {
            return;
        }

        loadedFor = Config;
        page = null;
        editing = false;
        search = null;
        // Sütunların sırası varsayılan sıradır; sıralama anahtarları kayıt deposunun beyanıdır (CredentialRecordStore).
        grid = new GridViewState(Config.GridKey, "validTo");
        grid.Define(
        [
            new("owner", Config.OwnerLabel, Config.OwnerIcon, Locked: true),
            new("type", "Belge türü", "file-text", "typeKey", "-typeKey"),
            new("documentNo", "Belge no", "hash", "documentNo", "-documentNo"),
            new("issuedBy", "Veren kurum", "building", DefaultVisible: false),
            new("validity", "Geçerlilik", "calendar", "validTo", "-validTo"),
            new("state", "Durum", "tag"),
        ]);
        views = new PersonalGridViews(Api, Config.GridKey);
        await Session.EnsureLoadedAsync();
        if (Session.Can(Config.ReadPermission))
        {
            await Lookups.LoadAsync();
            await views.LoadAsync();
            await ChooseViewAsync(ExpiringView);
        }
    }

    private GridViewDto? Active => views.Find(view);

    private IReadOnlyList<ViewOption> ViewOptions =>
    [
        new(ExpiringView, "Bitişi yaklaşan", Icon: "hourglass"),
        new(ExpiredView, "Süresi dolan", Icon: "alert-circle"),
        new(CurrentView, "Bugün geçerli", Icon: "check-circle"),
        new(AllViews, "Tüm belgeler", Icon: "file-text"),
        new(RevokedView, "İptal edilen", Icon: "x"),
        .. views.Options,
    ];

    private async Task ChooseViewAsync(string key)
    {
        view = key;
        views.StartNaming(false);
        if (Active is { } saved)
        {
            grid.Apply(saved);
            var filters = GridFilters.Parse(saved.Filters);
            validOn = filters.GetValueOrDefault("validOn");
            expiresBy = filters.GetValueOrDefault("expiresBy");
            expiredBefore = filters.GetValueOrDefault("expiredBefore");
            status = filters.GetValueOrDefault("status");
        }
        else
        {
            grid.Reset();
            var today = Today.ToString("yyyy-MM-dd");

            // Bitişi yaklaşan: bugün geçerli ve eşik gün içinde bitecek (süresi dolmuşlar "Süresi dolan"dadır).
            validOn = key is ExpiringView or CurrentView ? today : null;
            expiresBy = key == ExpiringView ? Today.AddDays(CredentialAccess.ExpiringDays).ToString("yyyy-MM-dd") : null;
            expiredBefore = key == ExpiredView ? today : null;
            status = key == RevokedView ? CredentialAccess.Revoked : null;
        }

        await LoadAsync(1);
    }

    private async Task SortAsync(string key)
    {
        grid.Sort = key;
        await LoadAsync(1);
    }

    private Task ColumnsChanged() => Task.CompletedTask;

    private string? CurrentFilters => GridFilters.Build(
        validOn is { } v ? ("validOn", v) : null, expiresBy is { } b ? ("expiresBy", b) : null,
        expiredBefore is { } e ? ("expiredBefore", e) : null, status is { } s ? ("status", s) : null);

    private void StartNaming() => views.StartNaming(true);

    private async Task SaveAsAsync(string name)
    {
        if (await views.SaveAsAsync(grid.ToRequest(name, CurrentFilters)) is { } key)
        {
            view = key;
        }
    }

    private async Task UpdateViewAsync()
    {
        if (Active is { } current)
        {
            await views.UpdateAsync(current, grid.ToRequest(current.Name, CurrentFilters));
        }
    }

    private async Task DiscardAsync() => await ChooseViewAsync(view);

    private async Task DeleteViewAsync()
    {
        if (Active is { } current && await views.DeleteAsync(current))
        {
            await ChooseViewAsync(ExpiringView);
        }
    }

    private async Task LoadAsync(int pageNumber)
    {
        var url = $"{Url}?ownerEntityKey={Uri.EscapeDataString(Config.OwnerEntityKey)}&page={pageNumber}&pageSize={ListPaging.Size}"
            + $"&search={Uri.EscapeDataString(search ?? string.Empty)}";
        if (grid.Sort != grid.DefaultSort)
        {
            url += $"&sort={Uri.EscapeDataString(grid.Sort)}";
        }

        foreach (var (name, value) in new[] { ("validOn", validOn), ("expiresBy", expiresBy), ("expiredBefore", expiredBefore), ("status", status) })
        {
            if (value is not null)
            {
                url += $"&{name}={value}";
            }
        }

        var result = await Api.GetAsync<RecordPageResponse>(url);
        page = result.Value;
        message = result.Error;
    }

    private RenderFragment Cell(GridColumnDef column, RecordResponse credential) =>
        @<td data-label="@column.Label" class="@(column.Key == "owner" ? "primary" : null)">@CellContent(column.Key, credential)</td>;

    private RenderFragment CellContent(string key, RecordResponse credential) => key switch
    {
        "owner" => @<text>@(WarehouseLabels.Text(credential, "ownerLabel") is { Length: > 0 } owner ? owner : "—")</text>,
        "type" => @<text>@Lookups.Label(CredentialAccess.TypeList, WarehouseLabels.Text(credential, "typeKey"))</text>,
        "documentNo" => @<text>@(WarehouseLabels.Text(credential, "documentNo") is { Length: > 0 } no ? no : "—")</text>,
        "issuedBy" => @<text>@(WarehouseLabels.Text(credential, "issuedBy") is { Length: > 0 } issuer ? issuer : "—")</text>,
        "validity" => @<text>@CredentialLabels.Validity(credential)</text>,
        "state" => State(credential),
        _ => @<text></text>,
    };

    private static RenderFragment State(RecordResponse credential)
    {
        var (badge, text) = CredentialLabels.State(credential, Today);
        return @<span class="badge @badge">@text</span>;
    }

    private void Open(RecordResponse credential)
    {
        selected = credential;
        editing = true;
        message = null;
    }

    private void Close() => editing = false;

    private async Task SavedAsync()
    {
        editing = false;
        await LoadAsync(page?.Page ?? 1);
    }
}
