@inject ApiClient Api

@* Firmanın kayıt görünürlük tavanları (ADR-0030 K10): platform yöneticisi her kayıt türü için firmanın rollerinin verebileceği en geniş
   kapsamı koyar. Tür listesi sunucudan gelir (firmada açık modüllerin sahipli kayıt türleri). PUT tüm kümeyi değiştirir; gerekçe
   ve etkilenen rol sayısı platform denetim kaydına yazılır. "Etkiyi göster" kaydetmeden önce kaç kişinin kısılacağını ya da serbest
   kalacağını sunucudan hesaplatır (yazmaz). *@
<section class="detail-section">
    <div class="section-header"><h2>@Texts.Get("platform.scopeLimits.title")</h2></div>
    <Notice Text="@notice" Failed="failed" />

    @if (state is null)
    {
        @if (notice is null)
        {
            <LoadingState />
        }
    }
    else if (state.Types.Count == 0)
    {
        <EmptyState Compact="true" Title="@Texts.Get("platform.scopeLimits.empty")" />
    }
    else
    {
        <p class="text-muted">@Texts.Get("platform.scopeLimits.intro")</p>

        <form class="inline-form" novalidate @onsubmit="SaveAsync" @onsubmit:preventDefault>
            <table class="table record-table">
                <thead><tr><th>@Texts.Get("admin.automation.entity")</th><th>@Texts.Get("platform.scopeLimits.maxScope")</th><th>@Texts.Get("platform.scopeLimits.administrator")</th></tr></thead>
                <tbody>
                    @foreach (var type in state.Types)
                    {
                        var row = rows[type.EntityKey];
                        <tr>
                            <td data-label="@Texts.Get("admin.automation.entity")" class="primary">@type.Label <small class="text-muted">@type.EntityKey</small></td>
                            <td data-label="@Texts.Get("platform.scopeLimits.maxScope")">
                                <select class="form-select" aria-label="@Texts.Get("platform.scopeLimits.maxScopeOf", type.Label)"
                                        value="@(row.Max is { } max ? ((int)max).ToString() : string.Empty)"
                                        @onchange="e => { Choose(type.EntityKey, e.Value as string); preview = null; }">
                                    <option value="">@Texts.Get("platform.scopeLimits.noLimit")</option>
                                    @foreach (var option in Options)
                                    {
                                        <option value="@((int)option)">@AdminLabels.Scope(option)</option>
                                    }
                                </select>
                            </td>
                            <td data-label="@Texts.Get("platform.scopeLimits.administrator")">
                                @if (row.Max is not null)
                                {
                                    var id = $"admin-{type.EntityKey}";
                                    <div class="form-check">
                                        <input id="@id" class="form-check-input" type="checkbox" checked="@row.Admin"
                                               @onchange="e => { row.Admin = e.Value is true; preview = null; }" />
                                        <label class="form-check-label" for="@id">@Texts.Get("platform.scopeLimits.bindAdministrator")</label>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (rows.Values.Any(r => r is { Max: not null, Admin: true }))
            {
                <div class="alert alert-warning">@Texts.Get("platform.scopeLimits.administratorWarning")</div>
            }

            @if (hidden.Count > 0)
            {
                <p class="text-muted">@Texts.Get("platform.scopeLimits.hidden", hidden.Count)</p>
            }

            @if (preview is not null)
            {
                <div class="alert alert-info" role="status" aria-live="polite">
                    <strong>@Texts.Get("platform.scopeLimits.previewTitle")</strong>
                    <ul class="mb-0">
                        <li>@Texts.Get("platform.scopeLimits.previewRoles", preview.AffectedRoleCount)</li>
                        <li>@Texts.Get("platform.scopeLimits.previewRestricted", preview.NewlyRestrictedMemberCount, preview.NewlyRestrictedAdministratorCount)</li>
                        @if (preview.ReleasedMemberCount + preview.ReleasedAdministratorCount > 0)
                        {
                            <li>@Texts.Get("platform.scopeLimits.previewReleased", preview.ReleasedMemberCount, preview.ReleasedAdministratorCount)</li>
                        }
                    </ul>
                    @foreach (var impact in preview.Types.Where(t => t.NewlyRestrictedMembers + t.ReleasedMembers + t.NewlyRestrictedAdministrators + t.ReleasedAdministrators + t.AffectedRoles > 0))
                    {
                        <div class="small">
                            @Texts.Get("platform.scopeLimits.previewType", LabelOf(impact.EntityKey), impact.AffectedRoles, impact.NewlyRestrictedMembers, impact.ReleasedMembers, impact.NewlyRestrictedAdministrators, impact.ReleasedAdministrators)
                        </div>
                    }
                    <div class="small text-muted">@Texts.Get("platform.scopeLimits.previewNote")</div>
                </div>
            }

            <div class="form-grid">
                <div>
                    <label class="form-label" for="limitsReason">@Texts.Get("platform.reasonRequired")</label>
                    <input id="limitsReason" class="form-control" maxlength="500" @bind="reason" @bind:event="oninput" />
                    <FieldError Field="reason" Errors="errors" />
                    <FieldError Field="limits" Errors="errors" />
                </div>
            </div>
            <div class="form-actions">
                <button type="button" class="btn btn-tonal" disabled="@(busy || !Dirty)" @onclick="PreviewAsync">@Texts.Get("platform.scopeLimits.preview")</button>
                <button type="submit" class="btn btn-primary" disabled="@(busy || !Dirty || string.IsNullOrWhiteSpace(reason))">@Texts.Get("platform.scopeLimits.save")</button>
            </div>
        </form>
    }
</section>

@code {
    [Parameter, EditorRequired] public Guid TenantId { get; set; }

    private static readonly RecordScope[] Options =
        [RecordScope.Own, RecordScope.Team, RecordScope.Unit, RecordScope.UnitAndBelow, RecordScope.All];

    private TenantScopeLimitsResponse? state;
    private ScopeLimitsPreviewResponse? preview;
    private readonly Dictionary<string, LimitRow> rows = new(StringComparer.Ordinal);
    private IReadOnlyList<ScopeLimitDto> hidden = [];
    private IReadOnlyDictionary<string, string[]>? errors;
    private string reason = string.Empty;
    private string? notice;
    private bool failed;
    private bool busy;

    private string Url => $"/api/platform/tenants/{TenantId}/scope-limits";

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var result = await Api.GetAsync<TenantScopeLimitsResponse>(Url);
        if (!result.IsSuccess)
        {
            (notice, failed) = (result.Error, true);
            return;
        }

        state = result.Value!;
        rows.Clear();
        foreach (var type in state.Types)
        {
            var limit = state.Limits.FirstOrDefault(l => l.EntityKey == type.EntityKey);
            rows[type.EntityKey] = new LimitRow { Max = limit?.MaxScope, Admin = limit?.AppliesToAdministrators ?? false };
        }

        // Modülü sonradan kapanan türün tavanı ekranda görünmez ama kümeyle birlikte gönderilir (sunucu korur).
        hidden = [.. state.Limits.Where(l => !rows.ContainsKey(l.EntityKey))];
    }

    private void Choose(string entityKey, string? value)
    {
        var row = rows[entityKey];
        row.Max = int.TryParse(value, out var number) && Enum.IsDefined(typeof(RecordScope), number) ? (RecordScope)number : null;
        if (row.Max is null)
        {
            row.Admin = false;
        }
    }

    private bool Dirty => state is not null && state.Types.Any(type =>
    {
        var saved = state.Limits.FirstOrDefault(l => l.EntityKey == type.EntityKey);
        var row = rows[type.EntityKey];
        return saved?.MaxScope != row.Max || (row.Max is not null && saved!.AppliesToAdministrators != row.Admin);
    });

    // Ekrandaki seçimler ve modülü kapalı türlerin korunan sınırları: PUT ve önizleme aynı kümeyi gönderir.
    private List<ScopeLimitDto> BuildLimits() => rows
        .Where(r => r.Value.Max is not null)
        .Select(r => new ScopeLimitDto(r.Key, r.Value.Max!.Value, r.Value.Admin))
        .Concat(hidden)
        .ToList();

    private string LabelOf(string entityKey) => state?.Types.FirstOrDefault(t => t.EntityKey == entityKey)?.Label ?? entityKey;

    private async Task PreviewAsync()
    {
        busy = true;
        var result = await Api.PostAsync<ScopeLimitsPreviewResponse>($"{Url}/preview", new SetScopeLimitsRequest(BuildLimits()));
        busy = false;
        errors = null;
        if (!result.IsSuccess)
        {
            (notice, failed, preview) = (result.Error, true, null);
            return;
        }

        (notice, failed, preview) = (null, false, result.Value);
    }

    private async Task SaveAsync()
    {
        busy = true;
        preview = null;
        var result = await Api.PutAsync<SetScopeLimitsResponse>(Url, new SetScopeLimitsRequest(BuildLimits(), reason));
        busy = false;
        errors = result.FieldErrors;
        if (!result.IsSuccess)
        {
            (notice, failed) = (result.FieldErrors.Count > 0 ? null : result.Error, true);
            return;
        }

        (notice, failed, reason) = (
            Texts.Get("platform.scopeLimits.saved", result.Value!.AffectedRoleCount),
            false,
            string.Empty);
        await LoadAsync();
    }

    private sealed class LimitRow
    {
        public RecordScope? Max { get; set; }

        public bool Admin { get; set; }
    }
}
