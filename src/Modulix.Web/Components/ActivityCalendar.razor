@* Aktivite takvimi: ay, hafta, gün ve ajanda görünümleri (ADR-0015). Veriyi çağıran yükler; burada yalnızca çizilir.
   Hafta ve gün görünümü saat çizelgesidir: saatli aktiviteler süreleri kadar yer kaplar, çakışanlar yan yana dizilir; tüm gün
   etkinlikleri ve yalnızca son tarihli işler üstteki "Tüm gün" satırındadır. Renk aktivite ailesinden gelir (fam-* sınıfları).
   Her aktivite bir düğmedir (klavyeyle odaklanır, Enter açar); gün hücresine Enter hızlı oluşturur; bir aktiviteyi başka güne
   sürüklemek yeniden planlamadır (sunucu yetki ve çakışmayı denetler). Son tarih işaretleri (⏰) zaman bloğundan ayrı gösterilir. *@

<div class="cal" role="grid" aria-label="Aktivite takvimi">
    @if (Mode == CalendarMode.Agenda)
    {
        @foreach (var (day, items) in Grouped())
        {
            <section class="cal-agenda-day" aria-label="@Heading(day)">
                <h3>@Heading(day)</h3>
                <ul class="item-list">
                    @foreach (var activity in items)
                    {
                        <li class="cal-agenda-item fam-@FamilyClass(activity) @ActivityLabels.Css(activity)">@Entry(activity)</li>
                    }
                </ul>
            </section>
        }
        @if (!Items.Any())
        {
            <p class="text-muted">Bu aralıkta aktivite yok.</p>
        }
    }
    else if (Mode is CalendarMode.Week or CalendarMode.Day)
    {
        var days = Days().ToList();
        var (startHour, endHour) = HourRange(days);
        <div class="cal-time cal-time-@Mode.ToString().ToLowerInvariant()" style="--cal-days:@days.Count;--cal-hours:@(endHour - startHour)">
            <div class="cal-time-row cal-time-header" role="row">
                <div class="cal-time-gutter" aria-hidden="true"></div>
                @foreach (var day in days)
                {
                    <div class="cal-time-dayhead @(day == Today ? "today" : null)" role="columnheader">
                        <span class="cal-time-weekday">@WeekdayNames[((int)day.DayOfWeek + 6) % 7]</span>
                        <button type="button" class="cal-day-link" @onclick="() => OnCreate.InvokeAsync(day)"
                                title="Bu güne aktivite ekle" aria-label="@Heading(day) için yeni aktivite">@day.Day</button>
                    </div>
                }
            </div>
            <div class="cal-time-row cal-time-allday" role="row">
                <div class="cal-time-gutter">Tüm gün</div>
                @foreach (var day in days)
                {
                    var untimed = UntimedOn(day);
                    <div class="cal-time-allday-cell" role="gridcell" tabindex="0" aria-label="@Heading(day), tüm gün ve son tarihli @untimed.Count aktivite"
                         @onkeydown="e => CellKey(e, day)" @ondragover:preventDefault @ondrop="() => DropAsync(day)">
                        @foreach (var activity in untimed)
                        {
                            <div class="cal-item fam-@FamilyClass(activity) @ActivityLabels.Css(activity)" draggable="@(CanDrag(activity) ? "true" : "false")"
                                 @ondragstart="() => dragging = activity">
                                @Entry(activity)
                            </div>
                        }
                    </div>
                }
            </div>
            <div class="cal-time-row cal-time-body" role="row">
                <div class="cal-time-gutter cal-time-hours" aria-hidden="true">
                    @for (var hour = startHour; hour < endHour; hour++)
                    {
                        <span>@hour.ToString("00"):00</span>
                    }
                </div>
                @foreach (var day in days)
                {
                    <div class="cal-time-col @(day == Today ? "today" : null)" role="gridcell" aria-label="@Heading(day)"
                         @ondragover:preventDefault @ondrop="() => DropAsync(day)">
                        @foreach (var segment in Arrange(TimedOn(day)))
                        {
                            <div class="cal-event fam-@FamilyClass(segment.Activity) @ActivityLabels.Css(segment.Activity)"
                                 style="@Position(segment, startHour, endHour)" draggable="@(CanDrag(segment.Activity) ? "true" : "false")"
                                 @ondragstart="() => dragging = segment.Activity">
                                @Block(segment.Activity)
                            </div>
                        }
                        @if (day == Today && NowMinutes > startHour * 60 && NowMinutes < endHour * 60)
                        {
                            <div class="cal-now" style="top:@(Percent((NowMinutes - startHour * 60) / ((endHour - startHour) * 60.0) * 100))%" aria-hidden="true"></div>
                        }
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <div class="cal-grid cal-@Mode.ToString().ToLowerInvariant()">
            @if (Mode != CalendarMode.Day)
            {
                @foreach (var name in WeekdayNames)
                {
                    <div class="cal-weekday" role="columnheader">@name</div>
                }
            }
            @foreach (var day in Days())
            {
                var items = ItemsOn(day);
                <div class="cal-cell @(day == Today ? "today" : null) @(Mode == CalendarMode.Month && day.Month != Anchor.Month ? "outside" : null)"
                     role="gridcell" tabindex="0" aria-label="@Heading(day), @items.Count aktivite"
                     @onkeydown="e => CellKey(e, day)" @ondragover:preventDefault @ondrop="() => DropAsync(day)">
                    <div class="cal-date">
                        <button type="button" class="cal-day-link" @onclick="() => OnCreate.InvokeAsync(day)"
                                title="Bu güne aktivite ekle" aria-label="@Heading(day) için yeni aktivite">@day.Day</button>
                    </div>
                    @foreach (var activity in items.Take(Mode == CalendarMode.Month ? 4 : 50))
                    {
                        <div class="cal-item fam-@FamilyClass(activity) @ActivityLabels.Css(activity)" draggable="@(CanDrag(activity) ? "true" : "false")"
                             @ondragstart="() => dragging = activity">
                            @Entry(activity)
                        </div>
                    }
                    @if (Mode == CalendarMode.Month && items.Count > 4)
                    {
                        <button type="button" class="btn btn-link btn-sm" @onclick="() => OnDayChosen.InvokeAsync(day)">+@(items.Count - 4) daha</button>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    private static readonly string[] WeekdayNames = ["Pzt", "Sal", "Çar", "Per", "Cum", "Cmt", "Paz"];

    private ActivityDto? dragging;

    [Parameter] public CalendarMode Mode { get; set; } = CalendarMode.Month;

    /// <summary>Görünümün odak günü: ay/hafta/gün bu güne göre hesaplanır.</summary>
    [Parameter] public DateOnly Anchor { get; set; }

    [Parameter] public IReadOnlyList<ActivityDto> Items { get; set; } = [];

    /// <summary>Kullanıcı bu aktiviteyi sürükleyerek taşıyabilir mi? (yetki)</summary>
    [Parameter] public Func<ActivityDto, bool> CanMove { get; set; } = _ => false;

    [Parameter] public EventCallback<ActivityDto> OnSelect { get; set; }

    [Parameter] public EventCallback<DateOnly> OnCreate { get; set; }

    [Parameter] public EventCallback<DateOnly> OnDayChosen { get; set; }

    [Parameter] public EventCallback<(ActivityDto Activity, DateOnly Day)> OnMove { get; set; }

    /// <summary>Aktivitenin ailesi (task, call, meeting, visit, email); renk ve ikon buna göre seçilir.</summary>
    [Parameter] public Func<ActivityDto, string> FamilyOf { get; set; } = _ => ActivityFamily.Task;

    private sealed record Segment(ActivityDto Activity, int From, int To, int Lane, int Lanes);

    private const int MinutesPerDay = 24 * 60;

    private static DateOnly Today => DateOnly.FromDateTime(Regional.Now.DateTime);

    private RenderFragment Entry(ActivityDto activity) => builder =>
    {
        var deadlineOnly = activity.StartAt is null && !activity.IsAllDay && activity.DueAt is not null;
        builder.OpenElement(0, "button");
        builder.AddAttribute(1, "type", "button");
        builder.AddAttribute(2, "class", "cal-entry");
        builder.AddAttribute(3, "title", activity.Masked ? "Meşgul" : $"{activity.Subject} · {ActivityLabels.TimeText(activity)}");
        builder.AddAttribute(4, "onclick", EventCallback.Factory.Create(this, () => OnSelect.InvokeAsync(activity)));
        builder.AddContent(5, $"{(deadlineOnly ? "⏰ " : null)}{ActivityLabels.TimeText(activity)} {activity.Subject}");
        builder.CloseElement();
    };

    /// <summary>Saat çizelgesindeki blok: üstte saat, altta konu.</summary>
    private RenderFragment Block(ActivityDto activity) => builder =>
    {
        builder.OpenElement(0, "button");
        builder.AddAttribute(1, "type", "button");
        builder.AddAttribute(2, "class", "cal-entry");
        builder.AddAttribute(3, "title", activity.Masked ? "Meşgul" : $"{activity.Subject} · {ActivityLabels.TimeText(activity)}");
        builder.AddAttribute(4, "onclick", EventCallback.Factory.Create(this, () => OnSelect.InvokeAsync(activity)));
        builder.OpenElement(5, "span");
        builder.AddAttribute(6, "class", "cal-entry-time");
        builder.AddContent(7, ActivityLabels.TimeText(activity));
        builder.CloseElement();
        builder.OpenElement(8, "span");
        builder.AddAttribute(9, "class", "cal-entry-subject");
        builder.AddContent(10, activity.Masked ? "Meşgul" : activity.Subject);
        builder.CloseElement();
        builder.CloseElement();
    };

    private string FamilyClass(ActivityDto activity) => activity.Masked ? "busy" : FamilyOf(activity);

    private static bool IsTimed(ActivityDto activity) => !activity.IsAllDay && activity.StartAt is not null;

    private static double NowMinutes => Regional.Now.TimeOfDay.TotalMinutes;

    private List<ActivityDto> UntimedOn(DateOnly day) =>
        [.. Items.Where(a => !IsTimed(a) && ActivityLabels.Days(a).Contains(day)).OrderBy(a => a.IsAllDay ? 0 : 1).ThenBy(a => a.DueAt)];

    /// <summary>
    /// Günün saatli aktiviteleri, gün içindeki dakika aralığıyla (firma saat dilimi). Birden fazla güne yayılan blok her günde o güne
    /// düşen kısmıyla görünür; bitişi olmayan ya da çok kısa blok okunabilsin diye en az 30 dakika yer kaplar.
    /// </summary>
    private List<(ActivityDto Activity, int From, int To)> TimedOn(DateOnly day)
    {
        var dayStart = day.ToDateTime(TimeOnly.MinValue);
        var list = new List<(ActivityDto Activity, int From, int To)>();
        foreach (var activity in Items)
        {
            if (!IsTimed(activity))
            {
                continue;
            }

            var start = Regional.ToTenant(activity.StartAt!.Value).DateTime;
            var end = activity.EndAt is { } endAt && endAt > activity.StartAt ? Regional.ToTenant(endAt).DateTime : start.AddMinutes(30);
            var from = Math.Max(0, (start - dayStart).TotalMinutes);
            var to = Math.Min(MinutesPerDay, (end - dayStart).TotalMinutes);
            if (to <= 0 || from >= MinutesPerDay)
            {
                continue;
            }

            list.Add((activity, (int)from, (int)Math.Min(MinutesPerDay, Math.Max(to, from + 30))));
        }

        return [.. list.OrderBy(x => x.From).ThenByDescending(x => x.To)];
    }

    /// <summary>Çakışan blokları şeritlere dizer: birbiriyle çakışan grup aynı genişliği paylaşır.</summary>
    private static List<Segment> Arrange(List<(ActivityDto Activity, int From, int To)> items)
    {
        var result = new List<Segment>();
        var group = new List<(ActivityDto Activity, int From, int To, int Lane)>();
        var laneEnds = new List<int>();
        var groupEnd = -1;
        foreach (var item in items)
        {
            if (group.Count > 0 && item.From >= groupEnd)
            {
                Flush();
            }

            var lane = laneEnds.FindIndex(end => end <= item.From);
            if (lane < 0)
            {
                lane = laneEnds.Count;
                laneEnds.Add(item.To);
            }
            else
            {
                laneEnds[lane] = item.To;
            }

            group.Add((item.Activity, item.From, item.To, lane));
            groupEnd = Math.Max(groupEnd, item.To);
        }

        Flush();
        return result;

        void Flush()
        {
            foreach (var entry in group)
            {
                result.Add(new Segment(entry.Activity, entry.From, entry.To, entry.Lane, laneEnds.Count));
            }

            group.Clear();
            laneEnds.Clear();
        }
    }

    /// <summary>Gösterilecek saat aralığı: varsayılan 08–18, daha erken/geç aktivite varsa genişler.</summary>
    private (int Start, int End) HourRange(List<DateOnly> days)
    {
        int start = 8, end = 18;
        foreach (var day in days)
        {
            foreach (var (_, from, to) in TimedOn(day))
            {
                start = Math.Min(start, from / 60);
                end = Math.Max(end, (to + 59) / 60);
            }
        }

        return (Math.Clamp(start, 0, 23), Math.Clamp(end, start + 1, 24));
    }

    private static string Position(Segment segment, int startHour, int endHour)
    {
        double span = (endHour - startHour) * 60.0;
        double top = (segment.From - startHour * 60) / span * 100;
        double height = (segment.To - segment.From) / span * 100;
        double width = 100.0 / segment.Lanes;
        return $"top:{Percent(top)}%;height:{Percent(height)}%;left:{Percent(width * segment.Lane)}%;width:{Percent(width)}%";
    }

    private static string Percent(double value) => value.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);

    private bool CanDrag(ActivityDto activity) => !activity.Masked && ActivityStatus.IsOpen(activity.Status) && CanMove(activity);

    private async Task DropAsync(DateOnly day)
    {
        if (dragging is { } activity)
        {
            dragging = null;
            await OnMove.InvokeAsync((activity, day));
        }
    }

    private async Task CellKey(KeyboardEventArgs e, DateOnly day)
    {
        if (e.Key == "Enter")
        {
            await OnCreate.InvokeAsync(day);
        }
    }

    private List<ActivityDto> ItemsOn(DateOnly day) =>
        [.. Items.Where(a => ActivityLabels.Days(a).Contains(day)).OrderBy(a => a.IsAllDay ? 0 : 1).ThenBy(a => a.StartAt ?? a.DueAt)];

    private IEnumerable<(DateOnly Day, List<ActivityDto> Items)> Grouped() =>
        Items.SelectMany(a => ActivityLabels.Days(a).Select(d => (Day: d, Activity: a)))
            .GroupBy(x => x.Day).OrderBy(g => g.Key)
            .Select(g => (g.Key, g.Select(x => x.Activity).OrderBy(a => a.StartAt ?? a.DueAt).ToList()));

    /// <summary>Görünümün kapsadığı günler (bitiş dahil); sunucu sorgusu da bu pencereyle yapılır.</summary>
    public static (DateOnly From, DateOnly To) Window(CalendarMode mode, DateOnly anchor)
    {
        var weekStart = anchor.AddDays(-(((int)anchor.DayOfWeek + 6) % 7));
        return mode switch
        {
            CalendarMode.Day => (anchor, anchor),
            CalendarMode.Week => (weekStart, weekStart.AddDays(6)),
            CalendarMode.Agenda => (anchor, anchor.AddDays(29)),
            _ => MonthWindow(anchor),
        };
    }

    private static (DateOnly, DateOnly) MonthWindow(DateOnly anchor)
    {
        var first = new DateOnly(anchor.Year, anchor.Month, 1);
        var start = first.AddDays(-(((int)first.DayOfWeek + 6) % 7));
        var last = first.AddMonths(1).AddDays(-1);
        return (start, last.AddDays(6 - (((int)last.DayOfWeek + 6) % 7)));
    }

    private IEnumerable<DateOnly> Days()
    {
        var (from, to) = Window(Mode, Anchor);
        for (var day = from; day <= to; day = day.AddDays(1))
        {
            yield return day;
        }
    }

    private static string Heading(DateOnly day)
    {
        var tr = System.Globalization.CultureInfo.GetCultureInfo("tr-TR");
        return $"{day.ToString("d MMMM yyyy", tr)} {day.ToString("dddd", tr)}";
    }
}
