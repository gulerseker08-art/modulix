@* Sözleşme iç onay özeti (ADR-0022, dilim 5): eşleşen kurallar, adımlar, verilmiş kararlar ve geçerli kullanıcının durumu. Karar verme sözleşme sayfasındaki
   eylem çubuğundan ya da onay iş listesinden yapılır; bu bileşen salt okunurdur. Kural eşikleri ve tutarlar burada gösterilmez (plan yalnızca kural adı ve nedeni taşır). *@
@inject ApiClient Api
@inject CrmLookups Lookups

<section class="detail-section" aria-labelledby="approval-title">
    <div class="section-header">
        <h2 id="approval-title">@Texts.Get("contracts.approvalPanel.title")</h2>
        @if (approval is not null)
        {
            <span class="badge stage-@ContractLabels.ApprovalBadge(approval.Status)">@ContractLabels.Label(ContractLabels.Approvals, approval.Status)</span>
        }
    </div>

    @if (error is not null)
    {
        <p class="text-muted" role="status">@error</p>
    }
    else if (approval is null)
    {
        <LoadingState />
    }
    else if (approval.Status == "NotRequired" && approval.Decisions.Count == 0)
    {
        <p class="text-muted">@Texts.Get("contracts.approvalPanel.notSubmitted")</p>
    }
    else
    {
        <dl class="detail-list">
            <div><dt>@Texts.Get("contracts.approvalPanel.version")</dt><dd>@Texts.Get("contracts.versionNo", approval.VersionNo)</dd></div>
            <div><dt>@Texts.Get("contracts.approvals.col.sender")</dt><dd>@Lookups.MemberName(approval.SubmittedBy) · @(approval.SubmittedAt is { } at ? CrmLabels.Time(at) : "—")</dd></div>
            <div>
                <dt>@Texts.Get("contracts.approvals.col.due")</dt>
                <dd>
                    @(approval.DueAt is { } due ? CrmLabels.Time(due) : "—")
                    @if (approval.IsOverdue) { <span class="badge stage-lost">@Texts.Get("crm.pending.overdue")</span> }
                </dd>
            </div>
        </dl>

        @if (approval.CanDecide)
        {
            <div class="alert alert-info" role="status">
                @Texts.Get(approval.ActingAsDelegate ? "contracts.approvalPanel.canDecideDelegate" : "contracts.approvalPanel.canDecide")
            </div>
        }
        else if (approval.Status == "Pending" && approval.CannotDecideReason is not null)
        {
            <p class="text-muted" role="status">@Texts.Get("contracts.approvalPanel.cannotDecide", approval.CannotDecideReason)</p>
        }

        <h3>@Texts.Get("contracts.approvalPanel.rules")</h3>
        @if (approval.Rules.Count == 0)
        {
            <p class="text-muted">@approval.Note</p>
        }
        else
        {
            <ul>
                @foreach (var rule in approval.Rules)
                {
                    <li><strong>@rule.Name</strong> <small class="text-muted">@(approval.Steps.Count > 1 ? Texts.Get("contracts.approvalPanel.ruleVersionStep", rule.RuleVersion, rule.Step) : Texts.Get("contracts.approvalPanel.ruleVersion", rule.RuleVersion))</small> — @rule.Reason
                        @if (rule.ApproverId is not null) { <span class="text-muted"> @Texts.Get("contracts.approvalPanel.ruleApprover", Lookups.MemberName(rule.ApproverId))</span> }</li>
                }
            </ul>
        }

        <h3>@Texts.Get("contracts.approvalPanel.steps")</h3>
        <ol class="approval-steps">
            @foreach (var step in approval.Steps)
            {
                <li aria-current="@(step.IsCurrent ? "step" : null)">
                    <span class="badge stage-@(step.Completed ? "won" : step.IsCurrent ? "qualified" : "open")">@Texts.Get(step.Completed ? "contracts.approvalPanel.stepCompleted" : step.IsCurrent ? "contracts.approvalPanel.stepCurrent" : "contracts.approvalPanel.stepWaiting")</span>
                    @Texts.Get("contracts.approvalPanel.stepNo", step.Step)
                    @if (step.Approvers.Count == 0) { <span>@Texts.Get("contracts.approvalPanel.anyApprover")</span> }
                    else { <span>@string.Join(", ", step.Approvers.Select(a => Lookups.MemberName(a) + (step.ApprovedBy.Contains(a) ? " ✓" : string.Empty)))</span> }
                </li>
            }
        </ol>

        <h3>@Texts.Get("contracts.approvalPanel.decisions")</h3>
        @if (approval.Decisions.Count == 0)
        {
            <EmptyState Title="@Texts.Get("contracts.approvalPanel.noDecisions")" />
        }
        else
        {
            <table class="table record-table">
                <caption class="visually-hidden">@Texts.Get("contracts.approvalPanel.decisionsCaption")</caption>
                <thead><tr><th scope="col">@Texts.Get("contracts.approvalPanel.col.step")</th><th scope="col">@Texts.Get("contracts.renewals.col.decision")</th><th scope="col">@Texts.Get("contracts.approvalPanel.col.actor")</th><th scope="col">@Texts.Get("contracts.approvalPanel.col.time")</th><th scope="col">@Texts.Get("crm.quoteApprovals.reasonLabel")</th></tr></thead>
                <tbody>
                    @foreach (var d in approval.Decisions)
                    {
                        <tr>
                            <td data-label="@Texts.Get("contracts.approvalPanel.col.step")">@d.StepNo</td>
                            <td data-label="@Texts.Get("contracts.renewals.col.decision")"><span class="badge stage-@DecisionBadge(d.Decision)">@DecisionLabel(d.Decision)</span></td>
                            <td data-label="@Texts.Get("contracts.approvalPanel.col.actor")">
                                @Lookups.MemberName(d.ActorId)
                                @if (d.OnBehalfOf.Any(p => p != d.ActorId)) { <div class="small text-muted">@Texts.Get("contracts.approvalPanel.onBehalfOf", string.Join(", ", d.OnBehalfOf.Where(p => p != d.ActorId).Select(p => Lookups.MemberName(p))))</div> }
                            </td>
                            <td data-label="@Texts.Get("contracts.approvalPanel.col.time")">@CrmLabels.Time(d.At)</td>
                            <td data-label="@Texts.Get("crm.quoteApprovals.reasonLabel")">@(d.Reason ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }
</section>

@code {
    private ContractApprovalDto? approval;
    private string? error;
    private string? loadedKey;

    [Parameter, EditorRequired] public Guid ContractId { get; set; }

    /// <summary>Sözleşme kaydının sürümü; eylemlerden sonra değişir ve paneli yeniler.</summary>
    [Parameter] public long Version { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        var key = $"{ContractId}:{Version}";
        if (key == loadedKey) { return; }
        loadedKey = key;
        await Lookups.LoadAsync();
        var result = await Api.GetAsync<ContractApprovalDto>($"/api/contracts/contracts/{ContractId}/approval");
        approval = result.Value;
        error = result.IsSuccess ? null : result.Error;
    }

    private static string DecisionLabel(string decision) => decision switch
    {
        "Approved" => Texts.Get("contracts.approvalPanel.decision.approved"),
        "Rejected" => Texts.Get("contracts.approvalPanel.decision.rejected"),
        "Returned" => Texts.Get("contracts.approvalPanel.decision.returned"),
        _ => decision,
    };

    private static string DecisionBadge(string decision) => decision switch { "Approved" => "won", "Rejected" => "lost", _ => "onhold" };
}
