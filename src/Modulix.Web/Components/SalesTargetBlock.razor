@* Satış görünümünde bir hedef bloğu (tutar ya da adet): hedef, gerçekleşme, kalan, pipeline kapsama. Hedef yoksa ya da sıfırsa oran gösterilmez;
   hedef karşılandıysa "Hedef karşılandı" yazılır ve kapsama oranı gösterilmez (ADR-0035). *@
<section class="detail-section" aria-labelledby="@headingId">
    <div class="section-header"><h3 id="@headingId" class="h5">@Title</h3></div>
    @if (Hidden is not null)
    {
        <p class="text-muted">@Hidden</p>
    }
    else if (Block is null)
    {
        <p class="text-muted">@Texts.Get("crm.salesTarget.hidden")</p>
    }
    else if (Block.Value is null)
    {
        <EmptyState Compact="true" Title="@Texts.Get("crm.salesTarget.none")" />
        @if (Block.Problem is not null)
        {
            <div class="alert alert-warning" role="status">@Block.Problem</div>
        }
    }
    else
    {
        <p class="small text-muted">@SourceText(Block.Source)</p>
        @if (Block.ChildExcess is { } excess)
        {
            <div class="alert alert-warning" role="status">
                @Texts.Get("crm.salesTarget.childExcess", Number(excess))
            </div>
        }
        @if (Block.Progress is { } progress)
        {
            <dl class="detail-grid">
                <div><dt>@Texts.Get("crm.salesTarget.target")</dt><dd>@Number(progress.Target)</dd></div>
                <div><dt>@Texts.Get("crm.sales-card.realized")</dt><dd>@Number(progress.Realized)</dd></div>
                <div>
                    <dt>@Texts.Get("crm.salesTarget.attainment")</dt>
                    <dd>
                        @(progress.AttainmentPercent is { } attainment ? SalesLabels.Percent(attainment) : "—")
                        @if (progress.AttainmentPercent is { } value)
                        {
                            <progress value="@Math.Min(100m, Math.Max(0m, value)).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" max="100" aria-label="@Texts.Get("crm.salesTarget.attainmentOf", Title)"></progress>
                        }
                    </dd>
                </div>
                @if (progress.TargetMet)
                {
                    <div><dt>@Texts.Get("common.field.status")</dt><dd><span class="badge stage-won">@Texts.Get("crm.salesTarget.met")</span>@(progress.Remaining < 0 ? " " + Texts.Get("crm.salesTarget.exceeded", Number(-progress.Remaining)) : null)</dd></div>
                }
                else
                {
                    <div><dt>@Texts.Get("crm.salesTarget.remaining")</dt><dd>@Number(progress.Remaining)</dd></div>
                    <div>
                        <dt>@Texts.Get("crm.salesTarget.coverage")</dt>
                        <dd>@(progress.Coverage is { } coverage ? Texts.Get("crm.sales.ratio", coverage.ToString("0.##", Regional.Numbers)) : "—")</dd>
                    </div>
                }
            </dl>
            @if (!progress.TargetMet)
            {
                <p class="small text-muted">@Texts.Get("crm.salesTarget.coverageHelp")</p>
            }
        }
        else
        {
            <p>@Texts.Strong("crm.salesTarget.noRate", Number(Block.Value.Value))</p>
        }
    }
</section>

@code {
    private readonly string headingId = $"target-{Guid.NewGuid():N}";

    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    [Parameter] public TargetBlockDto? Block { get; set; }

    /// <summary>Dolu ise blok yerine bu açıklama gösterilir (ör. tutar izni yok).</summary>
    [Parameter] public string? Hidden { get; set; }

    private bool IsAmount => Block?.Metric == SalesTargetMetrics.WonAmount;

    private string Number(decimal value) => IsAmount && Block?.Currency is { } currency
        ? CrmLabels.Amount(value, currency)
        : value.ToString("N0", Regional.Numbers);

    private static string SourceText(string source) => source switch
    {
        "User" => Texts.Get("crm.salesTarget.source.user"),
        "UserSum" => Texts.Get("crm.salesTarget.source.userSum"),
        "Tenant" => Texts.Get("crm.salesTarget.source.tenant"),
        _ => Texts.Get("crm.salesTarget.source.other"),
    };
}
