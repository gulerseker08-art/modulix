@* Form / detay bölümü kartı (docs/design-system/form-standards.md): ikonlu başlık, isteğe bağlı açıklama ve sağda aksiyon;
   gövdede genellikle bir form-grid (12 kolon; alanlar span-3/4/6/12) ya da detail-grid bulunur. Referans tasarımdaki
   "Temel Bilgiler", "Finans", "Genel İletişim Bilgileri" kartları bu bileşenle kurulur. *@
<section class="section-card @Class" aria-labelledby="@headingId">
    <div class="section-card-head">
        @if (Icon is not null)
        {
            <span class="section-card-icon" aria-hidden="true"><AppIcon Name="@Icon" Size="18" /></span>
        }
        <div class="section-card-heading">
            <h2 id="@headingId" class="section-card-title">@Title</h2>
            @if (Description is not null)
            {
                <p class="section-card-description">@Description</p>
            }
        </div>
        @if (Actions is not null)
        {
            <div class="section-card-actions">@Actions</div>
        }
    </div>
    <div class="section-card-body">
        @ChildContent
    </div>
</section>

@code {
    private readonly string headingId = $"section-{Guid.NewGuid():N}";

    [Parameter, EditorRequired]
    public string Title { get; set; } = "";

    /// <summary>AppIcon adı; başlığın solundaki renkli kutuda görünür.</summary>
    [Parameter]
    public string? Icon { get; set; }

    [Parameter]
    public string? Description { get; set; }

    /// <summary>Ek CSS sınıfı (ör. <c>side-card</c>).</summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>Başlığın sağındaki düğmeler.</summary>
    [Parameter]
    public RenderFragment? Actions { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
