@* Pano KPI kutusu (docs/design-system/component-catalog.md → DashKpi). "Kısmi" rozeti renkle değil metinle anlatılır. *@
<div class="dash-kpi">
    <div class="dash-kpi-label">
        <span class="dash-kpi-icon tone-@Tone" aria-hidden="true"><AppIcon Name="@Icon" Size="18" /></span>
        @Label
    </div>
    <strong class="dash-kpi-value">@Value</strong>
    <div class="dash-kpi-foot">
        <span>
            @if (Delta is not null)
            {
                <span class="dash-delta @DeltaClass">@if (DeltaTrend != 0) { <AppIcon Name="@(DeltaTrend < 0 ? "arrow-down" : "arrow-up")" Size="12" /> }@Delta</span>
                <br />
            }
            @Detail
            @if (Partial)
            {
                <span class="badge stage-onhold" title="@PartialHint">Kısmi</span>
            }
        </span>
        @if (Trend is not null)
        {
            <Sparkline Values="Trend" Label="@($"{Label} eğilimi")" />
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;

    [Parameter, EditorRequired] public string Value { get; set; } = string.Empty;

    [Parameter] public string Icon { get; set; } = "coins";

    /// <summary>brand, success, teal ya da warning.</summary>
    [Parameter] public string Tone { get; set; } = "brand";

    [Parameter] public string? Detail { get; set; }

    [Parameter] public bool Partial { get; set; }

    [Parameter] public string? PartialHint { get; set; }

    /// <summary>Önceki döneme göre değişim metni (ör. "+%12", "+4 puan"); işaret metinde de yazılır, renk tek başına anlam taşımaz.</summary>
    [Parameter] public string? Delta { get; set; }

    /// <summary>Değişimin yönü: artı iyi, eksi kötü, sıfır nötr.</summary>
    [Parameter] public int DeltaTrend { get; set; }

    private string? DeltaClass => DeltaTrend switch { < 0 => "is-down", 0 => "is-flat", _ => null };

    /// <summary>Dönemlere göre değerler; verilmezse çizgi çizilmez.</summary>
    [Parameter] public IReadOnlyList<decimal>? Trend { get; set; }
}
