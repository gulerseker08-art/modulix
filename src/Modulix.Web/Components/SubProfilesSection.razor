    private string RuleConditionSummary(FieldRuleDto rule)
    {
        if (rule.Condition is not { } node || node.ValueKind != System.Text.Json.JsonValueKind.Object)
        {
            return "Her zaman";
        }

        if (!IsLeaf(node))
        {
            return "Koşullu";
        }

        var values = node.TryGetProperty("values", out var array) && array.ValueKind == System.Text.Json.JsonValueKind.Array
            ? string.Join(", ", array.EnumerateArray().Select(v => v.ToString()))
            : string.Empty;
        var field = node.TryGetProperty("field", out var f) ? f.GetString() ?? string.Empty : string.Empty;
        var op = node.TryGetProperty("operator", out var o) ? o.GetString() ?? string.Empty : string.Empty;
        return $"{ConditionFieldLabel(field)} {AutomationLabels.Operator(op)} {values}".Trim();
