@using Modulix.Web.Services
@inject ApiClient Api

@* Firma alt profilleri (ADR-0041): sektör profilinin altında firmanın kendi tanımladığı alan ve liste değeri paketleri. Tek seviyedir;
   etkinleştirince seçenekler firmaya yalnızca eklenir. Uygulanmış seçenek bu ekrandan değişmez (Özel alanlar ve Listeler sayfasından). *@
<section class="settings-group" aria-labelledby="subProfilesTitle">
    <h2 id="subProfilesTitle">@Texts.Get("admin.subProfiles.title")</h2>
    <p class="text-muted">
        @Texts.Get("admin.subProfiles.intro")
    </p>

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }

    @if (profiles is null)
    {
        <LoadingState />
    }
    else
    {
        @if (starters.Count > 0)
        {
            <h3>@Texts.Get("admin.subProfiles.starters")</h3>
            <p class="text-muted">
                @Texts.Get("admin.subProfiles.startersIntro")
            </p>
            <div class="profile-cards">
                @foreach (var starter in starters)
                {
                    <button type="button" class="profile-card" disabled="@(busy || starter.Added || starter.MissingModules.Count > 0)"
                            aria-label="@(starter.Added ? Texts.Get("admin.subProfiles.starterAdded", starter.Name) : Texts.Get("admin.subProfiles.addStarter", starter.Name))" @onclick="() => AddStarterAsync(starter.Key)">
                        <strong>@starter.Name</strong>
                        <span>@starter.Description</span>
                        <span class="text-muted">@Texts.Get("admin.subProfiles.starterOptions", starter.Options.Count, string.Join(", ", starter.Options))</span>
                        @if (starter.Features.Count > 0)
                        {
                            <span class="text-muted">@Texts.Get("admin.subProfiles.starterFeatures", string.Join(" · ", starter.Features))</span>
                        }
                        @if (starter.Added)
                        {
                            <span class="badge category">@Texts.Get("admin.subProfiles.added")</span>
                        }
                        else if (starter.MissingModules.Count > 0)
                        {
                            <span class="badge">@Texts.Get("admin.subProfiles.moduleOff", string.Join(", ", starter.MissingModules))</span>
                        }
                    </button>
                }
            </div>
        }

        <div class="list-toolbar">
            <button type="button" class="btn btn-primary" disabled="@busy" @onclick="NewProfile">@Texts.Get("admin.subProfiles.new")</button>
        </div>

        @if (profileForm is not null)
        {
            <form class="record-form" novalidate @onsubmit="SaveProfileAsync" @onsubmit:preventDefault>
                <h3>@(profileForm.Id is null ? Texts.Get("admin.subProfiles.new") : Texts.Get("admin.subProfiles.edit"))</h3>
                <div class="form-grid">
                    <div>
                        <label class="form-label" for="subProfileName">@Texts.Get("common.field.nameRequired")</label>
                        <input id="subProfileName" class="form-control" maxlength="100" placeholder="@Texts.Get("admin.subProfiles.namePlaceholder")" @bind="profileForm.Name" @bind:event="oninput" />
                        <FieldError Field="name" Errors="errors" />
                    </div>
                    <div>
                        <label class="form-label" for="subProfileActivity">@Texts.Get("admin.subProfiles.activity")</label>
                        <select id="subProfileActivity" class="form-select" @bind="profileForm.ActivityCode">
                            <option value="">@Texts.Get("admin.subProfiles.noActivity")</option>
                            @foreach (var activity in activities)
                            {
                                <option value="@activity.Code">@activity.Name</option>
                            }
                        </select>
                        <div class="form-text">@Texts.Get("admin.subProfiles.activityHint")</div>
                        <FieldError Field="activityCode" Errors="errors" />
                    </div>
                    <div class="span-all">
                        <label class="form-label" for="subProfileDescription">@Texts.Get("common.field.description")</label>
                        <input id="subProfileDescription" class="form-control" maxlength="500" @bind="profileForm.Description" />
                        <FieldError Field="description" Errors="errors" />
                    </div>
                </div>
                <div class="form-actions">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CancelProfileForm">@Texts.Get("common.dismiss")</button>
                    <button type="submit" class="btn btn-primary" aria-busy="@(busy ? "true" : "false")" disabled="@(busy || string.IsNullOrWhiteSpace(profileForm.Name))">
                        @(profileForm.Id is null ? Texts.Get("admin.subProfiles.add") : Texts.Get("common.save"))
                    </button>
                </div>
            </form>
        }

        @if (profiles.Count == 0)
        {
            <EmptyState Title="@Texts.Get("admin.subProfiles.empty")" />
        }
        else
        {
            @if (FeatureChoices.Count > 0)
            {
                <div class="list-toolbar">
                    <label class="form-label" for="featureFilter">@Texts.Get("admin.subProfiles.feature")</label>
                    <select id="featureFilter" class="form-select" @bind="featureFilter">
                        <option value="">@Texts.Get("admin.subProfiles.all")</option>
                        @foreach (var choice in FeatureChoices)
                        {
                            <option value="@choice">@choice</option>
                        }
                    </select>
                </div>
            }

            @if (VisibleProfiles.Count == 0)
            {
                <p class="text-muted">@Texts.Get("admin.subProfiles.noneWithFeature")</p>
            }

            <table class="table record-table" hidden="@(VisibleProfiles.Count == 0)">
                <thead>
                    <tr><th>@Texts.Get("admin.subProfiles.col.profile")</th><th>@Texts.Get("admin.subProfiles.activity")</th><th>@Texts.Get("admin.subProfiles.features")</th><th>@Texts.Get("admin.subProfiles.options")</th><th>@Texts.Get("common.field.status")</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var profile in VisibleProfiles)
                    {
                        <tr class="@(current?.Id == profile.Id ? "is-selected" : null)">
                            <td data-label="@Texts.Get("admin.subProfiles.col.profile")" class="primary">@profile.Name</td>
                            <td data-label="@Texts.Get("admin.subProfiles.activity")">@(profile.ActivityName ?? "—")</td>
                            <td data-label="@Texts.Get("admin.subProfiles.features")">@(FeatureSummary(profile.Features) is { Length: > 0 } summary ? summary : "—")</td>
                            <td data-label="@Texts.Get("admin.subProfiles.options")">
                                @profile.OptionCount
                                @if (profile.PendingCount > 0)
                                {
                                    <span class="badge category">@Texts.Get("admin.subProfiles.pendingCount", profile.PendingCount)</span>
                                }
                            </td>
                            <td data-label="@Texts.Get("common.field.status")"><span class="badge @StatusTone(profile.Status)">@SettingsLabels.SubProfileStatus(profile.Status)</span></td>
                            <td class="actions">
                                <button type="button" class="btn btn-outline-primary btn-sm" disabled="@busy" @onclick="() => OpenAsync(profile.Id)">@Texts.Get("admin.subProfiles.options")</button>
                                <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@busy" @onclick="() => EditProfile(profile)">@Texts.Get("common.edit")</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        @if (current is not null)
        {
            <div class="record-form" aria-live="polite">
                <h3>@current.Name <span class="badge @StatusTone(current.Status)">@SettingsLabels.SubProfileStatus(current.Status)</span></h3>

                <div class="list-toolbar">
                    @if (current.Status == SubProfileStatuses.Active)
                    {
                        if (current.PendingCount > 0)
                        {
                            <button type="button" class="btn btn-tonal" disabled="@busy" @onclick="ApplyPendingAsync">@Texts.Get("admin.subProfiles.applyPending")</button>
                        }
                        <button type="button" class="btn btn-outline-secondary" disabled="@busy" @onclick="() => SetStatusAsync(SubProfileStatuses.Inactive)">@Texts.Get("admin.subProfiles.deactivate")</button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-primary" disabled="@busy" @onclick="PreviewActivationAsync">
                            @(current.Status == SubProfileStatuses.Inactive ? Texts.Get("admin.subProfiles.reactivate") : Texts.Get("admin.subProfiles.activate"))
                        </button>
                    }
                </div>

                @if (plan is not null)
                {
                    <section class="settings-group">
                        <h3>@Texts.Get("admin.subProfiles.planTitle")</h3>
                        <ProfilePreview Plan="plan" Applied="false" />
                        @if (rulePreview is { Rules.Count: > 0 })
                        {
                            <p>@Texts.Strong("admin.subProfiles.rulesActivate", Texts.Get("admin.subProfiles.ruleCount", rulePreview.Rules.Count))</p>
                        }

                        @if (rulePreview is { Conflicts.Count: > 0 })
                        {
                            <div class="alert alert-danger" role="alert">
                                @Texts.Get("admin.subProfiles.conflict")
                                <ul class="mb-0">
                                    @foreach (var conflict in rulePreview.Conflicts)
                                    {
                                        <li>@conflict.Message</li>
                                    }
                                </ul>
                            </div>
                        }

                        <div class="form-actions">
                            <button type="button" class="btn btn-outline-secondary" disabled="@busy" @onclick="() => { plan = null; rulePreview = null; }">@Texts.Get("common.dismiss")</button>
                            <button type="button" class="btn btn-primary" aria-busy="@(busy ? "true" : "false")" disabled="@(busy || ActivationBlocked)" @onclick="() => SetStatusAsync(SubProfileStatuses.Active)">@Texts.Get("admin.subProfiles.activateApply")</button>
                        </div>
                    </section>
                }

                <h3>@Texts.Get("admin.subProfiles.features")</h3>
                <p class="text-muted">
                    @Texts.Get("admin.subProfiles.featuresIntro")
                </p>
                @if (current.Features.Count == 0)
                {
                    <p class="text-muted">@Texts.Get("admin.subProfiles.noFeatures")</p>
                }
                else
                {
                    <table class="table record-table">
                        <thead>
                            <tr><th>@Texts.Get("admin.subProfiles.featureGroup")</th><th>@Texts.Get("admin.subProfiles.value")</th><th></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var feature in current.Features)
                            {
                                <tr>
                                    <td data-label="@Texts.Get("admin.subProfiles.featureGroup")" class="primary">@feature.Group</td>
                                    <td data-label="@Texts.Get("admin.subProfiles.value")">@feature.Value</td>
                                    <td class="actions">
                                        <button type="button" class="btn btn-outline-danger btn-sm" disabled="@busy" aria-label="@Texts.Get("admin.subProfiles.removeFeature", feature.Group, feature.Value)"
                                                @onclick="() => RemoveFeatureAsync(feature)">@Texts.Get("admin.subProfiles.remove")</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }

                <form novalidate @onsubmit="AddFeatureAsync" @onsubmit:preventDefault>
                    <div class="form-grid">
                        <div>
                            <label class="form-label" for="featureGroup">@Texts.Get("admin.subProfiles.featureGroup")</label>
                            <input id="featureGroup" class="form-control" maxlength="60" list="featureGroups" placeholder="@Texts.Get("admin.subProfiles.featureGroupPlaceholder")" @bind="featureGroup" @bind:event="oninput" />
                            <datalist id="featureGroups">
                                @foreach (var group in FeatureGroups)
                                {
                                    <option value="@group"></option>
                                }
                            </datalist>
                            <FieldError Field="group" Errors="errors" />
                        </div>
                        <div>
                            <label class="form-label" for="featureValue">@Texts.Get("admin.subProfiles.value")</label>
                            <input id="featureValue" class="form-control" maxlength="100" placeholder="@Texts.Get("admin.subProfiles.featureValuePlaceholder")" @bind="featureValue" @bind:event="oninput" />
                            <FieldError Field="value" Errors="errors" />
                        </div>
                    </div>
                    <div class="form-actions">
                        <button type="submit" class="btn btn-tonal" aria-busy="@(busy ? "true" : "false")" disabled="@(busy || string.IsNullOrWhiteSpace(featureGroup) || string.IsNullOrWhiteSpace(featureValue))">@Texts.Get("admin.subProfiles.addFeature")</button>
                    </div>
                </form>

                <h3>@Texts.Get("admin.subProfiles.options")</h3>
                @if (current.Options.Count == 0)
                {
                    <EmptyState Title="@Texts.Get("admin.subProfiles.noOptions")" />
                }
                else
                {
                    <table class="table record-table">
                        <thead>
                            <tr><th>@Texts.Get("admin.subProfiles.option")</th><th>@Texts.Get("common.field.kind")</th><th>@Texts.Get("admin.subProfiles.target")</th><th>@Texts.Get("admin.subProfiles.detail")</th><th>@Texts.Get("common.field.status")</th><th></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var option in current.Options)
                            {
                                <tr>
                                    <td data-label="@Texts.Get("admin.subProfiles.option")" class="primary">@option.Label</td>
                                    <td data-label="@Texts.Get("common.field.kind")">@SettingsLabels.SubProfileOption(option.Kind)</td>
                                    <td data-label="@Texts.Get("admin.subProfiles.target")">@option.TargetName</td>
                                    <td data-label="@Texts.Get("admin.subProfiles.detail")">@Detail(option)</td>
                                    <td data-label="@Texts.Get("common.field.status")">
                                        @if (option.AppliedAt is not null)
                                        {
                                            <span class="badge category">@Texts.Get("admin.sectorProfile.applied")</span>
                                        }
                                        else
                                        {
                                            <span class="badge">@Texts.Get("admin.subProfiles.pending")</span>
                                        }
                                    </td>
                                    <td class="actions">
                                        @if (option.AppliedAt is null)
                                        {
                                            <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@busy" @onclick="() => EditOption(option)">@Texts.Get("common.edit")</button>
                                            <button type="button" class="btn btn-outline-danger btn-sm" disabled="@busy" @onclick="() => RemoveOptionAsync(option)">@Texts.Get("admin.subProfiles.remove")</button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }

                @if (optionForm is null)
                {
                    <div class="list-toolbar">
                        <button type="button" class="btn btn-tonal" disabled="@busy" @onclick="NewOption">@Texts.Get("admin.subProfiles.addOption")</button>
                    </div>
                }
                else
                {
                    <form novalidate @onsubmit="SaveOptionAsync" @onsubmit:preventDefault>
                        <h3>@(optionForm.Id is null ? Texts.Get("admin.subProfiles.newOption") : Texts.Get("admin.subProfiles.editOption"))</h3>
                        <div class="form-grid">
                            <div>
                                <label class="form-label" for="optionKind">@Texts.Get("common.field.kind")</label>
                                <select id="optionKind" class="form-select" value="@optionForm.Kind" @onchange="OnKindChanged" disabled="@(optionForm.Id is not null)">
                                    <option value="@SubProfileOptionKinds.Field">@Texts.Get("admin.subProfiles.kindField")</option>
                                    <option value="@SubProfileOptionKinds.ListValue">@Texts.Get("admin.subProfiles.kindListValue")</option>
                                </select>
                            </div>
                            <div>
                                <label class="form-label" for="optionTarget">@(optionForm.Kind == SubProfileOptionKinds.Field ? Texts.Get("admin.automation.entity") : Texts.Get("admin.subProfiles.list"))</label>
                                <select id="optionTarget" class="form-select" @bind="optionForm.TargetKey">
                                    @if (optionForm.Kind == SubProfileOptionKinds.Field)
                                    {
                                        foreach (var entity in entities)
                                        {
                                            <option value="@entity.Key">@entity.Name</option>
                                        }
                                    }
                                    else
                                    {
                                        foreach (var list in lists)
                                        {
                                            <option value="@list.Key">@list.Name</option>
                                        }
                                    }
                                </select>
                                <FieldError Field="targetKey" Errors="errors" />
                            </div>
                            <div>
                                <label class="form-label" for="optionLabel">@(optionForm.Kind == SubProfileOptionKinds.Field ? Texts.Get("admin.subProfiles.fieldName") : Texts.Get("admin.subProfiles.valueName"))</label>
                                <input id="optionLabel" class="form-control" maxlength="100" @bind="optionForm.Label" @bind:event="oninput" />
                                <FieldError Field="label" Errors="errors" />
                            </div>
                            @if (optionForm.Kind == SubProfileOptionKinds.Field)
                            {
                                <div>
                                    <label class="form-label" for="optionType">@Texts.Get("admin.subProfiles.fieldType")</label>
                                    <select id="optionType" class="form-select" @bind="optionForm.Type">
                                        @foreach (var type in Enum.GetValues<CustomFieldType>())
                                        {
                                            <option value="@type">@SettingsLabels.FieldType(type)</option>
                                        }
                                    </select>
                                    <FieldError Field="fieldType" Errors="errors" />
                                </div>
                                <div class="span-all check-list">
                                    <label class="form-check">
                                        <input class="form-check-input" type="checkbox" @bind="optionForm.Required" />
                                        <span class="form-check-label">@Texts.Get("admin.customFields.required")</span>
                                    </label>
                                    <label class="form-check">
                                        <input class="form-check-input" type="checkbox" @bind="optionForm.ShowInList" />
                                        <span class="form-check-label">@Texts.Get("admin.customFields.showInList")</span>
                                    </label>
                                </div>
                                @if (CustomFieldTypeLabels.HasOptions(optionForm.Type))
                                {
                                    <div class="span-all">
                                        <label class="form-label" for="optionChoices">@Texts.Get("admin.subProfiles.choices")</label>
                                        <textarea id="optionChoices" class="form-control" rows="4" @bind="optionForm.ChoicesText" @bind:event="oninput"></textarea>
                                        <FieldError Field="choices" Errors="errors" />
                                    </div>
                                }
                            }
                            else if (ListCategories.Count > 0)
                            {
                                <div>
                                    <label class="form-label" for="optionCategory">@Texts.Get("admin.subProfiles.category")</label>
                                    <select id="optionCategory" class="form-select" @bind="optionForm.Category">
                                        @foreach (var category in ListCategories)
                                        {
                                            <option value="@category.Key">@category.Name</option>
                                        }
                                    </select>
                                    <FieldError Field="category" Errors="errors" />
                                </div>
                            }
                        </div>
                        <div class="form-actions">
                            <button type="button" class="btn btn-outline-secondary" @onclick="CancelOptionForm">@Texts.Get("common.dismiss")</button>
                            <button type="submit" class="btn btn-primary" aria-busy="@(busy ? "true" : "false")" disabled="@(busy || string.IsNullOrWhiteSpace(optionForm.Label))">
                                @(optionForm.Id is null ? Texts.Get("admin.subProfiles.addOptionSubmit") : Texts.Get("common.save"))
                            </button>
                        </div>
                    </form>
                }

                <h3>@Texts.Get("admin.subProfiles.rules")</h3>
                <p class="text-muted">
                    @((MarkupString)Texts.Get("admin.subProfiles.rulesIntro", "<strong>", "</strong>"))
                </p>
                @if (current.Rules.Count == 0)
                {
                    <p class="text-muted">@Texts.Get("admin.subProfiles.noRules")</p>
                }
                else
                {
                    <table class="table record-table">
                        <thead>
                            <tr><th>@Texts.Get("admin.automation.rule")</th><th>@Texts.Get("admin.subProfiles.field")</th><th>@Texts.Get("admin.subProfiles.effect")</th><th>@Texts.Get("admin.subProfiles.condition")</th><th>@Texts.Get("admin.subProfiles.messageValue")</th><th></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var rule in current.Rules)
                            {
                                <tr>
                                    <td data-label="@Texts.Get("admin.automation.rule")" class="primary">@rule.Name</td>
                                    <td data-label="@Texts.Get("admin.subProfiles.field")">@RuleFieldLabel(rule.Rule.Field)</td>
                                    <td data-label="@Texts.Get("admin.subProfiles.effect")">@RuleEffectLabel(rule.Rule.Effect)</td>
                                    <td data-label="@Texts.Get("admin.subProfiles.condition")">@RuleConditionSummary(rule.Rule)</td>
                                    <td data-label="@Texts.Get("admin.subProfiles.messageValue")">@((rule.Rule.Message ?? rule.Rule.Value) is { Length: > 0 } text ? text : "—")</td>
                                    <td class="actions">
                                        @if (IsEditable(rule.Rule))
                                        {
                                            <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@busy" aria-label="@Texts.Get("admin.subProfiles.editRule", rule.Name)" @onclick="() => EditRule(rule)">@Texts.Get("common.edit")</button>
                                        }
                                        <button type="button" class="btn btn-outline-danger btn-sm" disabled="@busy" aria-label="@Texts.Get("admin.subProfiles.removeRule", rule.Name)" @onclick="() => RemoveRuleAsync(rule)">@Texts.Get("admin.subProfiles.remove")</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }

                @if (ruleForm is null)
                {
                    <div class="list-toolbar">
                        <button type="button" class="btn btn-tonal" disabled="@busy" @onclick="NewRule">@Texts.Get("admin.subProfiles.addRule")</button>
                    </div>
                }
                else
                {
                    <form novalidate @onsubmit="SaveRuleAsync" @onsubmit:preventDefault>
                        <h3>@(ruleForm.Id is null ? Texts.Get("admin.subProfiles.newRule") : Texts.Get("admin.subProfiles.editRuleTitle"))</h3>
                        <div class="form-grid">
                            <div>
                                <label class="form-label" for="ruleName">@Texts.Get("admin.subProfiles.ruleName")</label>
                                <input id="ruleName" class="form-control" maxlength="100" placeholder="@Texts.Get("admin.subProfiles.ruleNamePlaceholder")" @bind="ruleForm.Name" @bind:event="oninput" />
                                <FieldError Field="name" Errors="errors" />
                            </div>
                            <div>
                                <label class="form-label" for="ruleField">@Texts.Get("admin.subProfiles.fieldRequired")</label>
                                <select id="ruleField" class="form-select" value="@ruleForm.Field" @onchange="e => OnRuleFieldChanged(e.Value?.ToString())">
                                    <option value="">@Texts.Get("admin.subProfiles.chooseField")</option>
                                    @foreach (var entity in RuleEntities)
                                    {
                                        <optgroup label="@entity.DisplayName">
                                            @foreach (var field in entity.Fields)
                                            {
                                                <option value="@field.Key">@field.Label</option>
                                            }
                                        </optgroup>
                                    }
                                </select>
                                <FieldError Field="field" Errors="errors" />
                            </div>
                            <div>
                                <label class="form-label" for="ruleEffect">@Texts.Get("admin.subProfiles.effectRequired")</label>
                                <select id="ruleEffect" class="form-select" @bind="ruleForm.Effect">
                                    @foreach (var effect in SettingsLabels.RuleEffects)
                                    {
                                        <option value="@effect.Key">@effect.Label</option>
                                    }
                                </select>
                                <FieldError Field="effect" Errors="errors" />
                            </div>
                            @if (ruleForm.Effect is "Validate" or "Warn" or "RequireApproval" or "Block")
                            {
                                <div>
                                    <label class="form-label" for="ruleMessage">@Texts.Get("admin.subProfiles.messageRequired")</label>
                                    <input id="ruleMessage" class="form-control" maxlength="200" @bind="ruleForm.Message" @bind:event="oninput" />
                                    <FieldError Field="message" Errors="errors" />
                                </div>
                            }
                            else if (ruleForm.Effect == "SuggestDefault")
                            {
                                <div>
                                    <label class="form-label" for="ruleValue">@Texts.Get("admin.subProfiles.suggestedValue")</label>
                                    <input id="ruleValue" class="form-control" @bind="ruleForm.Value" @bind:event="oninput" />
                                    <FieldError Field="value" Errors="errors" />
                                </div>
                            }
                            <div class="span-all check-list">
                                <label class="form-check">
                                    <input class="form-check-input" type="checkbox" @bind="ruleForm.Conditional" />
                                    <span class="form-check-label">@Texts.Get("admin.subProfiles.conditional")</span>
                                </label>
                            </div>
                            @if (ruleForm.Conditional)
                            {
                                <div>
                                    <label class="form-label" for="ruleCondField">@Texts.Get("admin.subProfiles.conditionField")</label>
                                    <select id="ruleCondField" class="form-select" value="@ruleForm.CondField" @onchange="e => OnConditionFieldChanged(e.Value?.ToString())">
                                        <option value="">@Texts.Get("admin.subProfiles.chooseField")</option>
                                        @foreach (var field in ConditionFields)
                                        {
                                            <option value="@field.Key">@field.Label</option>
                                        }
                                    </select>
                                    <FieldError Field="condition" Errors="errors" />
                                </div>
                                <div>
                                    <label class="form-label" for="ruleCondOp">@Texts.Get("admin.subProfiles.condition")</label>
                                    <select id="ruleCondOp" class="form-select" @bind="ruleForm.CondOperator">
                                        @foreach (var op in ConditionOperators)
                                        {
                                            <option value="@EditorLeaf.OperatorKey(op)">@AutomationLabels.Operator(op)</option>
                                        }
                                    </select>
                                </div>
                                @if (EditorLeaf.ValueCount(ruleForm.CondOperator).Max > 0)
                                {
                                    <div>
                                        <label class="form-label" for="ruleCondValue">@Texts.Get("admin.subProfiles.value")</label>
                                        @if (ConditionField is { Options.Count: > 0 } && EditorLeaf.ValueCount(ruleForm.CondOperator).Max == 1)
                                        {
                                            @* Seçim alanında değer listeden seçilir: serbest yazılan anahtar sunucuda reddedilirdi. *@
                                            <select id="ruleCondValue" class="form-select" @bind="ruleForm.CondValues">
                                                <option value="">@Texts.Get("admin.subProfiles.chooseValue")</option>
                                                @foreach (var option in ConditionField.Options)
                                                {
                                                    <option value="@option.Key">@option.Label</option>
                                                }
                                            </select>
                                        }
                                        else
                                        {
                                            <input id="ruleCondValue" class="form-control" list="ruleCondOptions" placeholder="@Texts.Get("admin.subProfiles.valuesPlaceholder")" @bind="ruleForm.CondValues" @bind:event="oninput" />
                                            <datalist id="ruleCondOptions">
                                                @foreach (var option in ConditionField?.Options ?? [])
                                                {
                                                    <option value="@option.Key">@option.Label</option>
                                                }
                                            </datalist>
                                        }
                                    </div>
                                }
                            }
                        </div>
                        <FieldError Field="rule" Errors="errors" />
                        <div class="form-actions">
                            <button type="button" class="btn btn-outline-secondary" @onclick="CancelRuleForm">@Texts.Get("common.dismiss")</button>
                            <button type="submit" class="btn btn-primary" aria-busy="@(busy ? "true" : "false")"
                                    disabled="@(busy || string.IsNullOrWhiteSpace(ruleForm.Name) || string.IsNullOrWhiteSpace(ruleForm.Field))">
                                @(ruleForm.Id is null ? Texts.Get("admin.subProfiles.addRuleSubmit") : Texts.Get("common.save"))
                            </button>
                        </div>
                    </form>
                }
            </div>
        }
    }
</section>

