    // Kurallar (ADR-0041 dilim 2): alan listesi firmanın otomasyon alan kümesidir (özel alanlar dahil); koşul tek satırdır, daha karmaşık koşullar API'dendir.
    private AutomationCatalogDto? ruleCatalog;
    private RuleForm? ruleForm;
    private SubProfileRulePreviewDto? rulePreview;
    private IEnumerable<AutomationEntityDto> RuleEntities => ruleCatalog?.Entities ?? [];

    private AutomationEntityDto? RuleEntity => RuleEntities.FirstOrDefault(e => e.Fields.Any(f => f.Key == ruleForm?.Field));

    // Koşul alanı kuralın kayıt türünden seçilir (sunucu da aynı alan kümesiyle doğrular); para alanı para birimi istediğinden dışarıda kalır.
    private IEnumerable<AutomationFieldDto> ConditionFields => RuleEntity?.Fields.Where(f => f.Type != "Money") ?? [];

    private AutomationFieldDto? ConditionField => ConditionFields.FirstOrDefault(f => f.Key == ruleForm?.CondField);

    private IEnumerable<string> ConditionOperators => ConditionField?.Operators.Where(o => !string.Equals(o, "Changed", StringComparison.OrdinalIgnoreCase)) ?? [];

    private bool ActivationBlocked => rulePreview is { CanActivate: false };

    private async Task EnsureRuleCatalogAsync()
    {
        ruleCatalog ??= (await Api.GetAsync<AutomationCatalogDto>("/api/customization/sub-profiles/rule-catalog")).Value;
    }

    private string RuleFieldLabel(string key)
    {
        foreach (var entity in RuleEntities)
        {
            if (entity.Fields.FirstOrDefault(f => f.Key == key) is { } field)
            {
                return $"{entity.DisplayName} · {field.Label}";
            }
        }

        return key;
    }

    private string ConditionFieldLabel(string key) =>
        RuleEntities.SelectMany(e => e.Fields).FirstOrDefault(f => f.Key == key)?.Label ?? key;

    private static string RuleEffectLabel(string effect) => SettingsLabels.RuleEffect(effect);

    private static bool IsLeaf(System.Text.Json.JsonElement node) =>
        node.ValueKind == System.Text.Json.JsonValueKind.Object && node.TryGetProperty("type", out var type) && type.GetString() == "leaf";

    // Ekrandan yalnızca tek satırlık koşul düzenlenir; API'den gelen grup/ilişki koşullu kural bu ekranda bozulmasın diye yalnızca kaldırılabilir.
    private static bool IsEditable(FieldRuleDto rule) => rule.Condition is not { } node || node.ValueKind == System.Text.Json.JsonValueKind.Null || IsLeaf(node);

    private string RuleConditionSummary(FieldRuleDto rule)
    {
        if (rule.Condition is not { } node || node.ValueKind != System.Text.Json.JsonValueKind.Object)
        {
            return Texts.Get("admin.subProfiles.always");
        }

        if (!IsLeaf(node))
        {
            return Texts.Get("admin.subProfiles.conditionalShort");
        }

        var values = node.TryGetProperty("values", out var array) && array.ValueKind == System.Text.Json.JsonValueKind.Array
            ? string.Join(", ", array.EnumerateArray().Select(v => v.ToString()))
            : string.Empty;
        var field = node.TryGetProperty("field", out var f) ? f.GetString() ?? string.Empty : string.Empty;
        var op = node.TryGetProperty("operator", out var o) ? o.GetString() ?? string.Empty : string.Empty;
        return $"{ConditionFieldLabel(field)} {AutomationLabels.Operator(op)} {values}".Trim();
    }

    private async Task NewRule()
    {
        await EnsureRuleCatalogAsync();
        ruleForm = new RuleForm();
        errors = null;
    }

    private async Task EditRule(SubProfileRuleDto rule)
    {
        await EnsureRuleCatalogAsync();
        var form = new RuleForm { Id = rule.Id, Name = rule.Name, Field = rule.Rule.Field, Effect = rule.Rule.Effect, Message = rule.Rule.Message ?? string.Empty, Value = rule.Rule.Value ?? string.Empty };
        if (rule.Rule.Condition is { } node && IsLeaf(node))
        {
            form.Conditional = true;
            form.CondField = node.TryGetProperty("field", out var f) ? f.GetString() ?? string.Empty : string.Empty;
            form.CondOperator = node.TryGetProperty("operator", out var o) ? o.GetString() ?? "eq" : "eq";
            form.CondValues = node.TryGetProperty("values", out var array) && array.ValueKind == System.Text.Json.JsonValueKind.Array
                ? string.Join(", ", array.EnumerateArray().Select(v => v.ToString()))
                : string.Empty;
        }

        ruleForm = form;
        errors = null;
    }

    private void CancelRuleForm()
    {
        ruleForm = null;
        errors = null;
    }

    private void OnRuleFieldChanged(string? key)
    {
        ruleForm!.Field = key ?? string.Empty;
        if (ConditionField is null)
        {
            ruleForm.CondField = string.Empty;
        }
    }

    private void OnConditionFieldChanged(string? key)
    {
        ruleForm!.CondField = key ?? string.Empty;
        ruleForm.CondOperator = ConditionOperators.FirstOrDefault() is { } first ? EditorLeaf.OperatorKey(first) : "eq";
        ruleForm.CondValues = string.Empty;
    }

    private async Task SaveRuleAsync()
    {
        var form = ruleForm!;
        System.Text.Json.JsonElement? condition = null;
        if (form.Conditional)
        {
            if (string.IsNullOrWhiteSpace(form.CondField))
            {
                errors = new Dictionary<string, string[]> { ["condition"] = [Texts.Get("admin.subProfiles.chooseConditionField")] };
                return;
            }

            var leaf = new EditorLeaf
            {
                Field = form.CondField,
                Operator = form.CondOperator,
                Values = EditorLeaf.ValueCount(form.CondOperator).Max == 0
                    ? []
                    : [.. form.CondValues.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)],
            };
            condition = System.Text.Json.JsonDocument.Parse(leaf.Build().ToJsonString()).RootElement.Clone();
        }

        var needsMessage = form.Effect is "Validate" or "Warn" or "RequireApproval" or "Block";
        var request = new SaveSubProfileRuleRequest(
            form.Name,
            new FieldRuleDto(string.Empty, form.Field, form.Effect, condition, needsMessage ? form.Message : null, form.Effect == "SuggestDefault" ? form.Value : null, false));
        busy = true;
        var url = $"/api/customization/sub-profiles/{current!.Id}/rules";
        var result = form.Id is { } id
            ? await Api.PutAsync<SubProfileDto>($"{url}/{id}", request)
            : await Api.PostAsync<SubProfileDto>(url, request);
        busy = false;
        errors = result.FieldErrors;
        message = result.FieldErrors.Count > 0 ? null : result.Error;
        if (result.IsSuccess)
        {
            current = result.Value;
            ruleForm = null;
            await ReloadAsync();
        }
    }

    private async Task RemoveRuleAsync(SubProfileRuleDto rule)
    {
        busy = true;
        var result = await Api.DeleteAsync($"/api/customization/sub-profiles/{current!.Id}/rules/{rule.Id}");
        busy = false;
        message = result.Error;
        await OpenAsync(current.Id);
        await ReloadAsync();
    }

    private sealed class RuleForm
    {
        public Guid? Id { get; init; }

        public string Name { get; set; } = string.Empty;

        public string Field { get; set; } = string.Empty;

        public string Effect { get; set; } = "Required";

        public string Message { get; set; } = string.Empty;

        public string Value { get; set; } = string.Empty;

        public bool Conditional { get; set; }

        public string CondField { get; set; } = string.Empty;

        public string CondOperator { get; set; } = "eq";

        public string CondValues { get; set; } = string.Empty;
    }

    private sealed class OptionForm
    {
        public Guid? Id { get; init; }

        public string Kind { get; set; } = SubProfileOptionKinds.Field;

        public string TargetKey { get; set; } = string.Empty;

        public string Label { get; set; } = string.Empty;

        public CustomFieldType Type { get; set; } = CustomFieldType.Text;

        public bool Required { get; set; }

        public bool ShowInList { get; set; }

        public string ChoicesText { get; set; } = string.Empty;

        public string? Category { get; set; }
    }
