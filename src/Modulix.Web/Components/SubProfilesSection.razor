        busy = false;

        // Etkinleştirme kural çakışmasıyla reddedilirse ileti alan hatası olarak gelir; kullanıcıya yine de gösterilir.
        message = result.FieldErrors.Count > 0 ? string.Join(" ", result.FieldErrors.Values.SelectMany(v => v)) : result.Error;
