@using Modulix.Web.Services
@inject ApiClient Api

@* Firma alt profilleri (ADR-0041): sektör profilinin altında firmanın kendi tanımladığı alan ve liste değeri paketleri. Tek seviyedir;
   etkinleştirince seçenekler firmaya yalnızca eklenir. Uygulanmış seçenek bu ekrandan değişmez (Özel alanlar ve Listeler sayfasından). *@
<section class="settings-group" aria-labelledby="subProfilesTitle">
    <h2 id="subProfilesTitle">Alt profiller</h2>
    <p class="text-muted">
        Firmanıza özgü alt profiller tanımlayın (ör. Kara taşımacılığı, Gümrüklü antrepo, Deniz taşımacılığı). Her alt profil istediğiniz kadar
        alan ve liste değeri içerebilir; etkinleştirince firmaya eklenir. Pasife aldığınızda eklenen alanlar ve değerler kalır.
    </p>

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }

    @if (profiles is null)
    {
        <LoadingState />
    }
    else
    {
        @if (starters.Count > 0)
        {
            <h3>Hazır alt profiller</h3>
            <p class="text-muted">
                Hazır öneriler tek tıkla taslak alt profil olarak eklenir; seçeneklerini gözden geçirip siz etkinleştirirsiniz. İçerikleri öneridir,
                eklendikten sonra istediğiniz gibi değiştirebilirsiniz.
            </p>
            <div class="profile-cards">
                @foreach (var starter in starters)
                {
                    <button type="button" class="profile-card" disabled="@(busy || starter.Added || starter.MissingModules.Count > 0)"
                            aria-label="@(starter.Added ? $"{starter.Name} zaten eklenmiş" : $"{starter.Name} alt profilini ekle")" @onclick="() => AddStarterAsync(starter.Key)">
                        <strong>@starter.Name</strong>
                        <span>@starter.Description</span>
                        <span class="text-muted">@starter.Options.Count seçenek: @string.Join(", ", starter.Options)</span>
                        @if (starter.Features.Count > 0)
                        {
                            <span class="text-muted">Özellikler: @string.Join(" · ", starter.Features)</span>
                        }
                        @if (starter.Added)
                        {
                            <span class="badge category">Eklendi</span>
                        }
                        else if (starter.MissingModules.Count > 0)
                        {
                            <span class="badge">@string.Join(", ", starter.MissingModules) modülü kapalı</span>
                        }
                    </button>
                }
            </div>
        }

        <div class="list-toolbar">
            <button type="button" class="btn btn-primary" disabled="@busy" @onclick="NewProfile">Yeni alt profil</button>
        </div>

        @if (profileForm is not null)
        {
            <form class="record-form" novalidate @onsubmit="SaveProfileAsync" @onsubmit:preventDefault>
                <h3>@(profileForm.Id is null ? "Yeni alt profil" : "Alt profili düzenle")</h3>
                <div class="form-grid">
                    <div>
                        <label class="form-label" for="subProfileName">Ad *</label>
                        <input id="subProfileName" class="form-control" maxlength="100" placeholder="ör. Kara taşımacılığı" @bind="profileForm.Name" @bind:event="oninput" />
                        <FieldError Field="name" Errors="errors" />
                    </div>
                    <div>
                        <label class="form-label" for="subProfileActivity">Bağlı faaliyet</label>
                        <select id="subProfileActivity" class="form-select" @bind="profileForm.ActivityCode">
                            <option value="">Bağlı faaliyet yok</option>
                            @foreach (var activity in activities)
                            {
                                <option value="@activity.Code">@activity.Name</option>
                            }
                        </select>
                        <div class="form-text">İsteğe bağlı; yalnızca sınıflandırma içindir.</div>
                        <FieldError Field="activityCode" Errors="errors" />
                    </div>
                    <div class="span-all">
                        <label class="form-label" for="subProfileDescription">Açıklama</label>
                        <input id="subProfileDescription" class="form-control" maxlength="500" @bind="profileForm.Description" />
                        <FieldError Field="description" Errors="errors" />
                    </div>
                </div>
                <div class="form-actions">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CancelProfileForm">Vazgeç</button>
                    <button type="submit" class="btn btn-primary" aria-busy="@(busy ? "true" : "false")" disabled="@(busy || string.IsNullOrWhiteSpace(profileForm.Name))">
                        @(profileForm.Id is null ? "Alt profili ekle" : "Kaydet")
                    </button>
                </div>
            </form>
        }

        @if (profiles.Count == 0)
        {
            <EmptyState Title="Henüz alt profil yok." />
        }
        else
        {
            @if (FeatureChoices.Count > 0)
            {
                <div class="list-toolbar">
                    <label class="form-label" for="featureFilter">Hizmet özelliği</label>
                    <select id="featureFilter" class="form-select" @bind="featureFilter">
                        <option value="">Tümü</option>
                        @foreach (var choice in FeatureChoices)
                        {
                            <option value="@choice">@choice</option>
                        }
                    </select>
                </div>
            }

            @if (VisibleProfiles.Count == 0)
            {
                <p class="text-muted">Bu özelliğe sahip alt profil yok.</p>
            }

            <table class="table record-table" hidden="@(VisibleProfiles.Count == 0)">
                <thead>
                    <tr><th>Alt profil</th><th>Bağlı faaliyet</th><th>Hizmet özellikleri</th><th>Seçenekler</th><th>Durum</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var profile in VisibleProfiles)
                    {
                        <tr class="@(current?.Id == profile.Id ? "is-selected" : null)">
                            <td data-label="Alt profil" class="primary">@profile.Name</td>
                            <td data-label="Bağlı faaliyet">@(profile.ActivityName ?? "—")</td>
                            <td data-label="Hizmet özellikleri">@(FeatureSummary(profile.Features) is { Length: > 0 } summary ? summary : "—")</td>
                            <td data-label="Seçenekler">
                                @profile.OptionCount
                                @if (profile.PendingCount > 0)
                                {
                                    <span class="badge category">@profile.PendingCount bekliyor</span>
                                }
                            </td>
                            <td data-label="Durum"><span class="badge @StatusTone(profile.Status)">@SubProfileStatuses.Label(profile.Status)</span></td>
                            <td class="actions">
                                <button type="button" class="btn btn-outline-primary btn-sm" disabled="@busy" @onclick="() => OpenAsync(profile.Id)">Seçenekler</button>
                                <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@busy" @onclick="() => EditProfile(profile)">Düzenle</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        @if (current is not null)
        {
            <div class="record-form" aria-live="polite">
                <h3>@current.Name <span class="badge @StatusTone(current.Status)">@SubProfileStatuses.Label(current.Status)</span></h3>

                <div class="list-toolbar">
                    @if (current.Status == SubProfileStatuses.Active)
                    {
                        if (current.PendingCount > 0)
                        {
                            <button type="button" class="btn btn-tonal" disabled="@busy" @onclick="ApplyPendingAsync">Bekleyenleri uygula</button>
                        }
                        <button type="button" class="btn btn-outline-secondary" disabled="@busy" @onclick="() => SetStatusAsync(SubProfileStatuses.Inactive)">Pasife al</button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-primary" disabled="@busy" @onclick="PreviewActivationAsync">
                            @(current.Status == SubProfileStatuses.Inactive ? "Yeniden etkinleştir" : "Etkinleştir")
                        </button>
                    }
                </div>

                @if (plan is not null)
                {
                    <section class="settings-group">
                        <h3>Etkinleştirince firmaya eklenecekler</h3>
                        <ProfilePreview Plan="plan" Applied="false" />
                        @if (rulePreview is { Rules.Count: > 0 })
                        {
                            <p>Etkinleşince <strong>@rulePreview.Rules.Count kural</strong> kayıt formlarında geçerli olur.</p>
                        }

                        @if (rulePreview is { Conflicts.Count: > 0 })
                        {
                            <div class="alert alert-danger" role="alert">
                                Kurallar etkin kurallarla çakışıyor; çakışma giderilmeden etkinleştirilemez.
                                <ul class="mb-0">
                                    @foreach (var conflict in rulePreview.Conflicts)
                                    {
                                        <li>@conflict.Message</li>
                                    }
                                </ul>
                            </div>
                        }

                        <div class="form-actions">
                            <button type="button" class="btn btn-outline-secondary" disabled="@busy" @onclick="() => { plan = null; rulePreview = null; }">Vazgeç</button>
                            <button type="button" class="btn btn-primary" aria-busy="@(busy ? "true" : "false")" disabled="@(busy || ActivationBlocked)" @onclick="() => SetStatusAsync(SubProfileStatuses.Active)">Etkinleştir ve uygula</button>
                        </div>
                    </section>
                }

                <h3>Hizmet özellikleri</h3>
                <p class="text-muted">
                    Bu alt profilin nasıl çalıştığını anlatan etiketler (ör. Taşıma türü: Komple, Parsiyel). Hiçbir şeyi uygulamaz; her durumda eklenip kaldırılır.
                </p>
                @if (current.Features.Count == 0)
                {
                    <p class="text-muted">Bu alt profilde henüz hizmet özelliği yok.</p>
                }
                else
                {
                    <table class="table record-table">
                        <thead>
                            <tr><th>Özellik</th><th>Değer</th><th></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var feature in current.Features)
                            {
                                <tr>
                                    <td data-label="Özellik" class="primary">@feature.Group</td>
                                    <td data-label="Değer">@feature.Value</td>
                                    <td class="actions">
                                        <button type="button" class="btn btn-outline-danger btn-sm" disabled="@busy" aria-label="@($"{feature.Group}: {feature.Value} özelliğini kaldır")"
                                                @onclick="() => RemoveFeatureAsync(feature)">Kaldır</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }

                <form novalidate @onsubmit="AddFeatureAsync" @onsubmit:preventDefault>
                    <div class="form-grid">
                        <div>
                            <label class="form-label" for="featureGroup">Özellik</label>
                            <input id="featureGroup" class="form-control" maxlength="60" list="featureGroups" placeholder="ör. Taşıma türü" @bind="featureGroup" @bind:event="oninput" />
                            <datalist id="featureGroups">
                                @foreach (var group in FeatureGroups)
                                {
                                    <option value="@group"></option>
                                }
                            </datalist>
                            <FieldError Field="group" Errors="errors" />
                        </div>
                        <div>
                            <label class="form-label" for="featureValue">Değer</label>
                            <input id="featureValue" class="form-control" maxlength="100" placeholder="ör. Komple" @bind="featureValue" @bind:event="oninput" />
                            <FieldError Field="value" Errors="errors" />
                        </div>
                    </div>
                    <div class="form-actions">
                        <button type="submit" class="btn btn-tonal" aria-busy="@(busy ? "true" : "false")" disabled="@(busy || string.IsNullOrWhiteSpace(featureGroup) || string.IsNullOrWhiteSpace(featureValue))">Özellik ekle</button>
                    </div>
                </form>

                <h3>Seçenekler</h3>
                @if (current.Options.Count == 0)
                {
                    <EmptyState Title="Bu alt profilde henüz seçenek yok." />
                }
                else
                {
                    <table class="table record-table">
                        <thead>
                            <tr><th>Seçenek</th><th>Tür</th><th>Hedef</th><th>Ayrıntı</th><th>Durum</th><th></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var option in current.Options)
                            {
                                <tr>
                                    <td data-label="Seçenek" class="primary">@option.Label</td>
                                    <td data-label="Tür">@SubProfileOptionKinds.Label(option.Kind)</td>
                                    <td data-label="Hedef">@option.TargetName</td>
                                    <td data-label="Ayrıntı">@Detail(option)</td>
                                    <td data-label="Durum">
                                        @if (option.AppliedAt is not null)
                                        {
                                            <span class="badge category">Uygulandı</span>
                                        }
                                        else
                                        {
                                            <span class="badge">Bekliyor</span>
                                        }
                                    </td>
                                    <td class="actions">
                                        @if (option.AppliedAt is null)
                                        {
                                            <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@busy" @onclick="() => EditOption(option)">Düzenle</button>
                                            <button type="button" class="btn btn-outline-danger btn-sm" disabled="@busy" @onclick="() => RemoveOptionAsync(option)">Kaldır</button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }

                @if (optionForm is null)
                {
                    <div class="list-toolbar">
                        <button type="button" class="btn btn-tonal" disabled="@busy" @onclick="NewOption">Seçenek ekle</button>
                    </div>
                }
                else
                {
                    <form novalidate @onsubmit="SaveOptionAsync" @onsubmit:preventDefault>
                        <h3>@(optionForm.Id is null ? "Yeni seçenek" : "Seçeneği düzenle")</h3>
                        <div class="form-grid">
                            <div>
                                <label class="form-label" for="optionKind">Tür</label>
                                <select id="optionKind" class="form-select" value="@optionForm.Kind" @onchange="OnKindChanged" disabled="@(optionForm.Id is not null)">
                                    <option value="@SubProfileOptionKinds.Field">Alan (kayda özel alan ekler)</option>
                                    <option value="@SubProfileOptionKinds.ListValue">Liste değeri (listeye değer ekler)</option>
                                </select>
                            </div>
                            <div>
                                <label class="form-label" for="optionTarget">@(optionForm.Kind == SubProfileOptionKinds.Field ? "Kayıt türü" : "Liste")</label>
                                <select id="optionTarget" class="form-select" @bind="optionForm.TargetKey">
                                    @if (optionForm.Kind == SubProfileOptionKinds.Field)
                                    {
                                        foreach (var entity in entities)
                                        {
                                            <option value="@entity.Key">@entity.Name</option>
                                        }
                                    }
                                    else
                                    {
                                        foreach (var list in lists)
                                        {
                                            <option value="@list.Key">@list.Name</option>
                                        }
                                    }
                                </select>
                                <FieldError Field="targetKey" Errors="errors" />
                            </div>
                            <div>
                                <label class="form-label" for="optionLabel">@(optionForm.Kind == SubProfileOptionKinds.Field ? "Alan adı *" : "Değer adı *")</label>
                                <input id="optionLabel" class="form-control" maxlength="100" @bind="optionForm.Label" @bind:event="oninput" />
                                <FieldError Field="label" Errors="errors" />
                            </div>
                            @if (optionForm.Kind == SubProfileOptionKinds.Field)
                            {
                                <div>
                                    <label class="form-label" for="optionType">Alan tipi</label>
                                    <select id="optionType" class="form-select" @bind="optionForm.Type">
                                        @foreach (var type in Enum.GetValues<CustomFieldType>())
                                        {
                                            <option value="@type">@CustomFieldTypeLabels.Of(type)</option>
                                        }
                                    </select>
                                    <FieldError Field="fieldType" Errors="errors" />
                                </div>
                                <div class="span-all check-list">
                                    <label class="form-check">
                                        <input class="form-check-input" type="checkbox" @bind="optionForm.Required" />
                                        <span class="form-check-label">Zorunlu</span>
                                    </label>
                                    <label class="form-check">
                                        <input class="form-check-input" type="checkbox" @bind="optionForm.ShowInList" />
                                        <span class="form-check-label">Listede göster</span>
                                    </label>
                                </div>
                                @if (CustomFieldTypeLabels.HasOptions(optionForm.Type))
                                {
                                    <div class="span-all">
                                        <label class="form-label" for="optionChoices">Seçenekler (her satıra bir tane)</label>
                                        <textarea id="optionChoices" class="form-control" rows="4" @bind="optionForm.ChoicesText" @bind:event="oninput"></textarea>
                                        <FieldError Field="choices" Errors="errors" />
                                    </div>
                                }
                            }
                            else if (ListCategories.Count > 0)
                            {
                                <div>
                                    <label class="form-label" for="optionCategory">Kategori</label>
                                    <select id="optionCategory" class="form-select" @bind="optionForm.Category">
                                        @foreach (var category in ListCategories)
                                        {
                                            <option value="@category.Key">@category.Name</option>
                                        }
                                    </select>
                                    <FieldError Field="category" Errors="errors" />
                                </div>
                            }
                        </div>
                        <div class="form-actions">
                            <button type="button" class="btn btn-outline-secondary" @onclick="CancelOptionForm">Vazgeç</button>
                            <button type="submit" class="btn btn-primary" aria-busy="@(busy ? "true" : "false")" disabled="@(busy || string.IsNullOrWhiteSpace(optionForm.Label))">
                                @(optionForm.Id is null ? "Seçeneği ekle" : "Kaydet")
                            </button>
                        </div>
                    </form>
                }

                <h3>Kurallar</h3>
                <p class="text-muted">
                    Alt profil <strong>etkinken</strong> kayıt formunda geçerli olan alan kuralları (ör. Konteyner no zorunlu). Alan ve liste değeri gibi firmaya eklenmez:
                    alt profil pasife alınınca kurallar devre dışı kalır, kural silinmez. Firma uyarlaması bir alt profil kuralını tek tek kapatabilir ya da değiştirebilir.
                </p>
                @if (current.Rules.Count == 0)
                {
                    <p class="text-muted">Bu alt profilde henüz kural yok.</p>
                }
                else
                {
                    <table class="table record-table">
                        <thead>
                            <tr><th>Kural</th><th>Alan</th><th>Etki</th><th>Koşul</th><th>İleti / değer</th><th></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var rule in current.Rules)
                            {
                                <tr>
                                    <td data-label="Kural" class="primary">@rule.Name</td>
                                    <td data-label="Alan">@RuleFieldLabel(rule.Rule.Field)</td>
                                    <td data-label="Etki">@RuleEffectLabel(rule.Rule.Effect)</td>
                                    <td data-label="Koşul">@RuleConditionSummary(rule.Rule)</td>
                                    <td data-label="İleti / değer">@((rule.Rule.Message ?? rule.Rule.Value) is { Length: > 0 } text ? text : "—")</td>
                                    <td class="actions">
                                        @if (IsEditable(rule.Rule))
                                        {
                                            <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@busy" aria-label="@($"{rule.Name} kuralını düzenle")" @onclick="() => EditRule(rule)">Düzenle</button>
                                        }
                                        <button type="button" class="btn btn-outline-danger btn-sm" disabled="@busy" aria-label="@($"{rule.Name} kuralını kaldır")" @onclick="() => RemoveRuleAsync(rule)">Kaldır</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }

                @if (ruleForm is null)
                {
                    <div class="list-toolbar">
                        <button type="button" class="btn btn-tonal" disabled="@busy" @onclick="NewRule">Kural ekle</button>
                    </div>
                }
                else
                {
                    <form novalidate @onsubmit="SaveRuleAsync" @onsubmit:preventDefault>
                        <h3>@(ruleForm.Id is null ? "Yeni kural" : "Kuralı düzenle")</h3>
                        <div class="form-grid">
                            <div>
                                <label class="form-label" for="ruleName">Kural adı *</label>
                                <input id="ruleName" class="form-control" maxlength="100" placeholder="ör. Konteyner no zorunlu" @bind="ruleForm.Name" @bind:event="oninput" />
                                <FieldError Field="name" Errors="errors" />
                            </div>
                            <div>
                                <label class="form-label" for="ruleField">Alan *</label>
                                <select id="ruleField" class="form-select" value="@ruleForm.Field" @onchange="e => OnRuleFieldChanged(e.Value?.ToString())">
                                    <option value="">Alan seçin</option>
                                    @foreach (var entity in RuleEntities)
                                    {
                                        <optgroup label="@entity.DisplayName">
                                            @foreach (var field in entity.Fields)
                                            {
                                                <option value="@field.Key">@field.Label</option>
                                            }
                                        </optgroup>
                                    }
                                </select>
                                <FieldError Field="field" Errors="errors" />
                            </div>
                            <div>
                                <label class="form-label" for="ruleEffect">Etki *</label>
                                <select id="ruleEffect" class="form-select" @bind="ruleForm.Effect">
                                    @foreach (var effect in RuleEffects)
                                    {
                                        <option value="@effect.Key">@effect.Label</option>
                                    }
                                </select>
                                <FieldError Field="effect" Errors="errors" />
                            </div>
                            @if (ruleForm.Effect is "Validate" or "Warn" or "RequireApproval" or "Block")
                            {
                                <div>
                                    <label class="form-label" for="ruleMessage">İleti *</label>
                                    <input id="ruleMessage" class="form-control" maxlength="200" @bind="ruleForm.Message" @bind:event="oninput" />
                                    <FieldError Field="message" Errors="errors" />
                                </div>
                            }
                            else if (ruleForm.Effect == "SuggestDefault")
                            {
                                <div>
                                    <label class="form-label" for="ruleValue">Önerilen değer *</label>
                                    <input id="ruleValue" class="form-control" @bind="ruleForm.Value" @bind:event="oninput" />
                                    <FieldError Field="value" Errors="errors" />
                                </div>
                            }
                            <div class="span-all check-list">
                                <label class="form-check">
                                    <input class="form-check-input" type="checkbox" @bind="ruleForm.Conditional" />
                                    <span class="form-check-label">Yalnızca bir koşul sağlanınca geçerli olsun</span>
                                </label>
                            </div>
                            @if (ruleForm.Conditional)
                            {
                                <div>
                                    <label class="form-label" for="ruleCondField">Koşul alanı</label>
                                    <select id="ruleCondField" class="form-select" value="@ruleForm.CondField" @onchange="e => OnConditionFieldChanged(e.Value?.ToString())">
                                        <option value="">Alan seçin</option>
                                        @foreach (var field in ConditionFields)
                                        {
                                            <option value="@field.Key">@field.Label</option>
                                        }
                                    </select>
                                    <FieldError Field="condition" Errors="errors" />
                                </div>
                                <div>
                                    <label class="form-label" for="ruleCondOp">Koşul</label>
                                    <select id="ruleCondOp" class="form-select" @bind="ruleForm.CondOperator">
                                        @foreach (var op in ConditionOperators)
                                        {
                                            <option value="@EditorLeaf.OperatorKey(op)">@AutomationLabels.Operator(op)</option>
                                        }
                                    </select>
                                </div>
                                @if (EditorLeaf.ValueCount(ruleForm.CondOperator).Max > 0)
                                {
                                    <div>
                                        <label class="form-label" for="ruleCondValue">Değer</label>
                                        <input id="ruleCondValue" class="form-control" list="ruleCondOptions" placeholder="birden fazlaysa virgülle ayırın" @bind="ruleForm.CondValues" @bind:event="oninput" />
                                        <datalist id="ruleCondOptions">
                                            @foreach (var option in ConditionField?.Options ?? [])
                                            {
                                                <option value="@option.Key">@option.Label</option>
                                            }
                                        </datalist>
                                    </div>
                                }
                            }
                        </div>
                        <FieldError Field="rule" Errors="errors" />
                        <div class="form-actions">
                            <button type="button" class="btn btn-outline-secondary" @onclick="CancelRuleForm">Vazgeç</button>
                            <button type="submit" class="btn btn-primary" aria-busy="@(busy ? "true" : "false")"
                                    disabled="@(busy || string.IsNullOrWhiteSpace(ruleForm.Name) || string.IsNullOrWhiteSpace(ruleForm.Field))">
                                @(ruleForm.Id is null ? "Kuralı ekle" : "Kaydet")
                            </button>
                        </div>
                    </form>
                }
