    private async Task SaveRuleAsync()
    {
        var form = ruleForm!;
        System.Text.Json.JsonElement? condition = null;
        if (form.Conditional)
        {
            if (string.IsNullOrWhiteSpace(form.CondField))
            {
                errors = new Dictionary<string, string[]> { ["condition"] = ["Koşul alanını seçin."] };
                return;
            }

            var leaf = new EditorLeaf
            {
                Field = form.CondField,
                Operator = form.CondOperator,
                Values = EditorLeaf.ValueCount(form.CondOperator).Max == 0
                    ? []
                    : [.. form.CondValues.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)],
            };
            condition = System.Text.Json.JsonDocument.Parse(leaf.Build().ToJsonString()).RootElement.Clone();
        }

        var needsMessage = form.Effect is "Validate" or "Warn" or "RequireApproval" or "Block";
        var request = new SaveSubProfileRuleRequest(
            form.Name,
            new FieldRuleDto(string.Empty, form.Field, form.Effect, condition, needsMessage ? form.Message : null, form.Effect == "SuggestDefault" ? form.Value : null, false));
        busy = true;
        var url = $"/api/customization/sub-profiles/{current!.Id}/rules";
        var result = form.Id is { } id
            ? await Api.PutAsync<SubProfileDto>($"{url}/{id}", request)
            : await Api.PostAsync<SubProfileDto>(url, request);
        busy = false;
