@* Platform ekranları (Y4) için: oturum ve platform yöneticiliği ister; aktif firma gerekmez. Asıl denetim
   sunucudadır (bayrak her istekte okunur); bu yalnızca kullanıcıyı doğru ekrana götürür. *@
@implements IDisposable
@inject SessionState Session
@inject NavigationManager Navigation

@if (!Session.IsLoaded)
{
    <LoadingState />
}
else if (Session.IsSignedIn)
{
    @if (!Session.IsPlatformAdministrator)
    {
        <div class="alert alert-warning">@Texts.Get("platform.gate.denied")</div>
    }
    else
    {
        @if (Session.PlatformNeedsTwoFactor)
        {
            <div class="alert alert-warning" role="alert">
                @((MarkupString)Texts.Get("platform.gate.twoFactor", "<a href=\"hesabim\">", "</a>"))
            </div>
        }

        @ChildContent
    }
}

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += OnChanged;
        await Session.EnsureLoadedAsync();
        Redirect();
    }

    private void OnChanged()
    {
        Redirect();
        InvokeAsync(StateHasChanged);
    }

    private void Redirect()
    {
        if (Session.IsLoaded && !Session.IsSignedIn)
        {
            // Oturum kapanınca birden fazla bileşen aynı anda yönlendirebilir; giriş sayfasındaysak dönüş adresi bozulmasın.
            var current = Navigation.ToBaseRelativePath(Navigation.Uri);
            if (!current.StartsWith("giris", StringComparison.Ordinal))
            {
                Navigation.NavigateTo($"giris?donus={Uri.EscapeDataString(current)}");
            }
        }
    }

    public void Dispose() => Session.Changed -= OnChanged;
}
