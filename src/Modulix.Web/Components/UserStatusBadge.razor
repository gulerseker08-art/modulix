@* Kullanıcının durumu; hesap kilitliyse ayrıca "Kilitli". *@
<span class="badge user-@User.Status.ToString().ToLowerInvariant()">@AdminLabels.Status(User.Status)</span>
@if (User.IsLockedOut)
{
    <span class="badge user-locked">@Texts.Get("admin.users.locked")</span>
}

@code {
    [Parameter, EditorRequired] public UserDto User { get; set; } = default!;
}
