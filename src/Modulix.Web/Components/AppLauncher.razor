@implements IAsyncDisposable
@inject SessionState Session
@inject AppNavigation Apps
@inject NavigationManager Navigation
@inject IJSRuntime JS

@* Modulix logosu (BrandLogo): tıklanınca "Tüm Uygulamalar" paneli açılır (sayfanın üzerinde, içeriği kaydırmaz).
   İki düzey: ana uygulamalar, sonra seçilen uygulamanın alt uygulamaları. Liste AppCatalog'dan ve oturumdan gelir. *@
<div class="app-launcher">
    @if (Session.IsSignedIn)
    {
        <button type="button" class="navbar-brand brand-button" @ref="brandButton" @onclick="Toggle"
                aria-haspopup="dialog" aria-expanded="@(isOpen ? "true" : "false")" aria-controls="app-launcher-panel"
                aria-label="@Texts.Get("shell.launcher.aria")">
            <BrandLogo Size="36" />
        </button>
    }
    else
    {
        <a class="navbar-brand" href="" aria-label="@Texts.Get("shell.launcher.home")">
            <BrandLogo Size="36" />
        </a>
    }

    @if (isOpen)
    {
        <div id="app-launcher-panel" class="app-panel" role="dialog" aria-labelledby="app-panel-title" tabindex="-1" @ref="panel">
            <div class="app-panel-head">
                <h2 id="app-panel-title" class="app-panel-title">@Texts.Get("shell.launcher.title")</h2>
            </div>

            @if (showSearch)
            {
                <div class="app-search">
                    <label class="visually-hidden" for="app-search-input">@Texts.Get("shell.launcher.search")</label>
                    <AppIcon Name="search" Size="16" />
                    <input id="app-search-input" type="search" class="form-control" autocomplete="off"
                           placeholder="@Texts.Get("shell.launcher.search")" @ref="searchInput" @bind="Query" @bind:event="oninput" />
                </div>
            }

            <div class="app-panel-body">
                @if (!Session.IsLoaded)
                {
                    <p class="app-state" role="status"><span class="spinner-border spinner-border-sm" aria-hidden="true"></span> @Texts.Get("shell.launcher.loading")</p>
                }
                else if (loadFailed)
                {
                    <div class="app-state" role="alert">
                        <p class="mb-2">@Texts.Get("shell.launcher.failed")</p>
                        <button type="button" class="btn btn-outline-primary btn-sm" @onclick="RetryAsync">@Texts.Get("shell.launcher.retry")</button>
                    </div>
                }
                else if (listed.Count == 0 && string.IsNullOrWhiteSpace(Query))
                {
                    <p class="app-state" role="status">@Texts.Get("shell.launcher.empty")</p>
                }
                else if (visible.Count == 0 && plannedVisible.Count == 0)
                {
                    <p class="app-state" role="status">@Texts.Get("common.noResultFor", Query)</p>
                }

                @if (Session.IsLoaded && !loadFailed && visible.Count > 0)
                {
                    @if (groups.Count > 0)
                    {
                        @foreach (AppRootGroup section in groups)
                        {
                            <section class="app-group" aria-labelledby="@(section.Group is null ? null : $"app-group-{section.Group.Id}")">
                                @if (section.Group is not null)
                                {
                                    <h3 id="app-group-@section.Group.Id" class="app-group-title">@section.Group.Name</h3>
                                }
                                <ul class="app-grid">
                                    @foreach (AppDefinition app in section.Apps)
                                    {
                                        @Tile(app)
                                    }
                                </ul>
                            </section>
                        }
                    }
                    else
                    {
                        <ul class="app-grid">
                            @foreach (AppDefinition app in visible)
                            {
                                @Tile(app)
                            }
                        </ul>
                    }
                }

                @* Yol haritasındaki uygulamalar: pasif kartlar, tıklanınca bir şey olmaz (ekranları henüz yok). *@
                @if (Session.IsLoaded && !loadFailed && plannedVisible.Count > 0)
                {
                    <section class="app-group app-planned" aria-labelledby="app-group-planned">
                        <h3 id="app-group-planned" class="app-group-title">@Texts.Get("shell.launcher.planned")</h3>
                        <ul class="app-grid">
                            @foreach (PlannedApp planned in plannedVisible)
                            {
                                <li>
                                    <span class="app-tile is-planned" aria-disabled="true">
                                        <span class="app-tile-icon"><AppIcon Name="@planned.Icon" /></span>
                                        <span class="app-tile-name">@planned.Name</span>
                                    </span>
                                </li>
                            }
                        </ul>
                    </section>
                }
            </div>
        </div>
    }
</div>

@code {
    private enum FocusTarget
    {
        None,
        Brand,
        Search,
    }

    private ElementReference brandButton;
    private ElementReference panel;
    private ElementReference searchInput;
    private DotNetObjectReference<AppLauncher>? self;
    private bool attached;
    private bool isOpen;
    private string query = "";
    private Guid? lastTenant;
    private FocusTarget pendingFocus;

    private string Query
    {
        get => query;
        set
        {
            query = value ?? "";
            Recompute();
        }
    }

    // Panelde yalnızca mevcut, etkin, lisans kapsamında ve kullanıcının erişebildiği uygulamalar listelenir (AppNavigation.Roots).
    private IReadOnlyList<AppDefinition> listed = [];
    private IReadOnlyList<AppDefinition> visible = [];
    private IReadOnlyList<PlannedApp> plannedVisible = [];
    private bool showSearch;

    // Başlıklı gösterim yalnızca aramasız ve birden çok grup görünürken; aksi halde düz liste.
    private IReadOnlyList<AppRootGroup> groups = [];

    // Erişim bilgisi yüklenemedi: tenant var ama erişim okunamadı (iki adımlı doğrulama beklerken bilerek boştur).
    private bool loadFailed => Session.IsLoaded && Session.HasActiveTenant && !Session.TwoFactorRequired && Session.Access is null;

    protected override void OnInitialized()
    {
        Session.Changed += OnSessionChanged;
        Navigation.LocationChanged += OnLocationChanged;
        lastTenant = Session.User?.ActiveTenantId;
    }

    protected override void OnParametersSet() => Recompute();

    private void Recompute()
    {
        listed = Apps.Roots();
        visible = string.IsNullOrWhiteSpace(query)
            ? listed
            : listed.Where(a => Matches(a.Name, query.Trim())).ToList();
        plannedVisible = string.IsNullOrWhiteSpace(query)
            ? AppCatalog.Planned
            : AppCatalog.Planned.Where(p => Matches(p.Name, query.Trim())).ToList();
        showSearch = Session.IsLoaded && !loadFailed && (listed.Count > 0 || AppCatalog.Planned.Count > 0);

        IReadOnlyList<AppRootGroup> grouped = string.IsNullOrWhiteSpace(query) ? Apps.Grouped(listed) : [];
        groups = grouped.Count > 1 ? grouped : [];
    }

    // Uygulama kartı doğrudan uygulamanın ilk ekranına gider; uygulamanın ekranları sol menüde bölümler halinde gelir.
    private RenderFragment Tile(AppDefinition app) => @<li>
        <a href="@Apps.EntryRoute(app)" class="app-tile tone-@ToneClass(app) @(IsCurrent(app) ? "is-current" : null)"
           aria-current="@(IsCurrent(app) ? "page" : null)" @onclick="() => Close(true)">
            <span class="app-tile-icon"><AppIcon Name="@app.Icon" /></span>
            <span class="app-tile-name">@app.Name</span>
        </a>
    </li>;

    private static bool Matches(string name, string text) =>
        System.Globalization.CultureInfo.GetCultureInfo("tr-TR").CompareInfo
            .IndexOf(name, text, System.Globalization.CompareOptions.IgnoreCase) >= 0;

    private bool IsCurrent(AppDefinition app) => Apps.Context(Navigation.ToBaseRelativePath(Navigation.Uri))?.Root.Id == app.Id;

    private static string ToneClass(AppDefinition app) => app.Tone == AppTone.Teal ? "teal" : "indigo";

    private void OnSessionChanged()
    {
        // Tenant değişince panel kapanır ve önceki tenant'ın araması kalmaz.
        Guid? tenant = Session.User?.ActiveTenantId;
        if (tenant != lastTenant)
        {
            lastTenant = tenant;
            ResetPanel();
        }

        InvokeAsync(() =>
        {
            Recompute();
            StateHasChanged();
        });
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        if (isOpen)
        {
            InvokeAsync(() =>
            {
                ResetPanel();
                StateHasChanged();
            });
        }
    }

    private void ResetPanel()
    {
        isOpen = false;
        query = "";
    }

    private void Toggle()
    {
        if (isOpen)
        {
            Close(true);
            return;
        }

        isOpen = true;
        query = "";
        pendingFocus = FocusTarget.Search;
        Recompute();
    }

    private void Close(bool returnFocus)
    {
        ResetPanel();
        pendingFocus = returnFocus ? FocusTarget.Brand : FocusTarget.None;
    }

    private async Task RetryAsync() => await Session.RefreshAsync();

    [JSInvokable]
    public Task Dismiss(bool returnFocus)
    {
        if (isOpen)
        {
            Close(returnFocus);
            Recompute();
            StateHasChanged();
        }

        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (isOpen && !attached)
        {
            self ??= DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("modulixAppLauncher.attach", self, panel, brandButton);
            attached = true;
        }
        else if (!isOpen && attached)
        {
            await JS.InvokeVoidAsync("modulixAppLauncher.detach");
            attached = false;
        }

        FocusTarget target = pendingFocus;
        pendingFocus = FocusTarget.None;
        switch (target)
        {
            case FocusTarget.Brand:
                await brandButton.FocusAsync();
                break;
            case FocusTarget.Search when showSearch:
                await searchInput.FocusAsync();
                break;
            case FocusTarget.Search:
                await panel.FocusAsync();
                break;
        }
    }

    public async ValueTask DisposeAsync()
    {
        Session.Changed -= OnSessionChanged;
        Navigation.LocationChanged -= OnLocationChanged;
        if (attached)
        {
            try
            {
                await JS.InvokeVoidAsync("modulixAppLauncher.detach");
            }
            catch (JSDisconnectedException)
            {
            }
        }

        self?.Dispose();
    }
}
