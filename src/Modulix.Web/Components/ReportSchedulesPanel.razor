@* Zamanlanmış rapor teslimi (ADR-0035 dilim 4, core.reports.schedule). ReportId verilirse o raporun zamanlamaları ve yeni/düzenle formu; verilmezse
   kullanıcının bütün zamanlamaları (açma/kapama ve silme; düzenleme rapor sayfasında). Kullanıcı yalnızca kendi zamanlamalarını görür. *@
@using System.Net
@using Modulix.Shared.Auth
@inject ApiClient Api
@inject SessionState Session

<section class="detail-section" aria-labelledby="rsp-title" id="zamanlamalar">
    <div class="section-header">
        <h2 id="rsp-title">@Texts.Get("reports.schedules.title")</h2>
        @if (ReportId is not null && !formOpen)
        {
            <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@(items.Count >= ReportCenterLabels.MaxSchedules || loading)" @onclick="NewSchedule">@Texts.Get("reports.schedules.new")</button>
        }
    </div>
    <p class="text-muted small">
        @((MarkupString)Texts.Get("reports.schedules.intro", "<a href=\"raporlar/disa-aktarimlar\">", "</a>", ReportCenterLabels.MaxSchedules, System.Net.WebUtility.HtmlEncode(Regional.Zone.Id)))
    </p>

    @if (message is not null)
    {
        <div class="alert @(messageFailed ? "alert-danger" : "alert-success")" role="@(messageFailed ? "alert" : "status")">
            @message
            @if (conflict)
            {
                <button type="button" class="btn btn-outline-secondary btn-sm ms-2" disabled="@busy" @onclick="ReloadAfterConflictAsync">@Texts.Get("reports.schedules.reload")</button>
            }
        </div>
    }

    @if (formOpen)
    {
        <form class="report-builder-section" @onsubmit="SaveAsync" @onsubmit:preventDefault aria-label="@(editingId is null ? Texts.Get("reports.schedules.new") : Texts.Get("reports.schedules.edit"))">
            <h3 class="h6">@(editingId is null ? Texts.Get("reports.schedules.new") : Texts.Get("reports.schedules.edit"))</h3>
            <div class="form-grid">
                <div class="span-3">
                    <label class="form-label" for="rsp-frequency">@Texts.Get("reports.schedules.frequency")</label>
                    <select id="rsp-frequency" class="form-select" @bind="frequency">
                        @foreach (var (key, label) in ReportCenterLabels.Frequencies)
                        {
                            <option value="@key">@label</option>
                        }
                    </select>
                </div>
                @if (frequency == "weekly")
                {
                    <div class="span-3">
                        <label class="form-label" for="rsp-weekday">@Texts.Get("reports.schedules.weekday")</label>
                        <select id="rsp-weekday" class="form-select" @bind="weekday">
                            @foreach (var (key, label) in ReportCenterLabels.Weekdays)
                            {
                                <option value="@key">@label</option>
                            }
                        </select>
                    </div>
                }
                @if (frequency == "monthly")
                {
                    <div class="span-3">
                        <label class="form-label" for="rsp-monthday">@Texts.Get("reports.schedules.monthDay")</label>
                        <select id="rsp-monthday" class="form-select" aria-describedby="rsp-monthday-help" @bind="monthDay">
                            @for (var d = 1; d <= 28; d++)
                            {
                                <option value="@d">@d</option>
                            }
                        </select>
                        <div id="rsp-monthday-help" class="form-text">@Texts.Get("reports.schedules.monthDayHelp")</div>
                    </div>
                }
                <div class="span-3">
                    <label class="form-label" for="rsp-hour">@Texts.Get("reports.schedules.hour")</label>
                    <select id="rsp-hour" class="form-select" @bind="hour">
                        @for (var h = 0; h < 24; h++)
                        {
                            <option value="@h">@ReportCenterLabels.Hour(h)</option>
                        }
                    </select>
                </div>
                <div class="span-3">
                    <label class="form-label" for="rsp-format">@Texts.Get("reports.schedules.format")</label>
                    <select id="rsp-format" class="form-select" @bind="format">
                        <option value="csv">CSV</option>
                        <option value="xlsx">Excel (xlsx)</option>
                    </select>
                </div>
            </div>
            <fieldset class="mt-3">
                <legend class="form-label">@Texts.Get("reports.schedules.recipientsOptional")</legend>
                <p id="rsp-recipients-help" class="form-text">
                    @Texts.Strong("reports.schedules.recipientsHelp", Texts.Get("reports.schedules.ownPermissions"))
                    @Texts.Get("reports.schedules.maxRecipients", ReportCenterLabels.MaxRecipients)
                </p>
                @if (membersError is not null)
                {
                    <div class="alert alert-danger" role="alert">
                        @membersError
                        <button type="button" class="btn btn-outline-secondary btn-sm ms-2" @onclick="LoadMembersAsync">@Texts.Get("crm.sales.retry")</button>
                    </div>
                }
                else if (members is null)
                {
                    <p class="text-muted" role="status">@Texts.Get("reports.usersLoading")</p>
                }
                else
                {
                    <label class="visually-hidden" for="rsp-member-filter">@Texts.Get("reports.searchUser")</label>
                    <input id="rsp-member-filter" class="form-control mb-2" type="search" placeholder="@Texts.Get("reports.searchUser")" aria-describedby="rsp-recipients-help" @bind="memberFilter" @bind:event="oninput" />
                    <div class="report-member-list" role="group" aria-label="@Texts.Get("reports.schedules.recipients")">
                        @foreach (var member in FilteredMembers())
                        {
                            var memberId = member.UserId;
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="rsp-mem-@memberId" checked="@recipientIds.Contains(memberId)" @onchange="e => ToggleRecipient(memberId, e.Value is true)" />
                                <label class="form-check-label" for="rsp-mem-@memberId">@member.DisplayName</label>
                            </div>
                        }
                        @if (!FilteredMembers().Any())
                        {
                            <EmptyState Compact="true" Title="@Texts.Get("reports.noUserFound")" />
                        }
                    </div>
                    <p class="small text-muted mt-1" role="status">@Texts.Get("reports.schedules.recipientsSelected", recipientIds.Count)</p>
                }
            </fieldset>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary" disabled="@busy">
                    @if (busy) { <span class="spinner-border spinner-border-sm" aria-hidden="true"></span> }
                    @Texts.Get("common.save")
                </button>
                <button type="button" class="btn btn-outline-secondary" disabled="@busy" @onclick="CloseForm">@Texts.Get("common.dismiss")</button>
            </div>
        </form>
    }

    <AnalyticsStatus Loading="loading" Error="@error" Forbidden="forbidden" OnRetry="LoadAsync" />

    @if (!loading && error is null && loaded)
    {
        @if (items.Count == 0)
        {
            <p class="text-muted" role="status">@(ReportId is null ? Texts.Get("reports.schedules.emptyAll") : Texts.Get("reports.schedules.emptyReport"))</p>
        }

        @foreach (var item in items)
        {
            var stopped = !string.IsNullOrWhiteSpace(item.StoppedReason);
            <div class="report-row">
                <div class="report-row-main">
                    <h3>@ReportCenterLabels.ScheduleSummary(item)</h3>
                    @if (ReportId is null)
                    {
                        <p class="mb-0"><a href="raporlar/@item.ReportId">@(item.ReportName ?? Texts.Get("reports.run.pageTitle"))</a></p>
                    }

                    <div class="report-row-meta">
                        <span class="badge @(item.Enabled ? "status-customer" : "status-inactive")">@(item.Enabled ? Texts.Get("warehouse.on") : Texts.Get("warehouse.off"))</span>
                        <span class="badge tag">@(item.Format == "xlsx" ? "Excel" : "CSV")</span>
                        @if (item.Enabled)
                        {
                            <span class="badge tag">@Texts.Get("reports.schedules.nextRun", CrmLabels.Time(item.NextRunAt))</span>
                        }
                        <span class="badge tag">
                            @(item.LastRunAt is { } last ? Texts.Get("reports.schedules.lastStatusAt", ReportCenterLabels.ScheduleStatus(item.LastStatus), CrmLabels.Time(last)) : Texts.Get("reports.schedules.lastStatus", ReportCenterLabels.ScheduleStatus(item.LastStatus)))
                        </span>
                    </div>
                    @if (item.Recipients is { Count: > 0 } recipients)
                    {
                        <p class="small mt-2 mb-0"><strong>@Texts.Get("reports.schedules.recipientsLabel")</strong> @string.Join(", ", recipients.Select(r => r.DisplayName ?? Texts.Get("reports.schedules.formerMember")))</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(item.LastMessage))
                    {
                        <p class="small text-muted mt-2 mb-0">@item.LastMessage</p>
                    }
                    @if (stopped)
                    {
                        <div class="alert alert-warning mt-2 mb-0" role="alert">
                            <strong>@Texts.Get("reports.schedules.stoppedTitle")</strong> @item.StoppedReason
                            @Texts.Get("reports.schedules.stopped")
                        </div>
                    }
                </div>
                <div class="report-row-actions">
                    <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@busy" aria-pressed="@(item.Enabled ? "true" : "false")"
                            aria-label="@(item.Enabled ? Texts.Get("reports.schedules.closeAria", ReportCenterLabels.ScheduleSummary(item)) : Texts.Get("reports.schedules.openAria", ReportCenterLabels.ScheduleSummary(item)))" @onclick="() => ToggleAsync(item)">
                        @(item.Enabled ? Texts.Get("common.close") : Texts.Get("common.open"))
                    </button>
                    @if (ReportId is not null)
                    {
                        <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@busy" aria-label="@Texts.Get("reports.schedules.editAria", ReportCenterLabels.ScheduleSummary(item))" @onclick="() => Edit(item)">@Texts.Get("common.edit")</button>
                    }
                    else
                    {
                        <a class="btn btn-outline-secondary btn-sm" href="raporlar/@item.ReportId#zamanlamalar" aria-label="@Texts.Get("reports.schedules.editOnReportAria", ReportCenterLabels.ScheduleSummary(item))">@Texts.Get("common.edit")</a>
                    }
                    @if (confirmDeleteId == item.Id)
                    {
                        <span class="confirm" role="alert">
                            <span>@Texts.Get("reports.schedules.deleteConfirm")</span>
                            <button type="button" class="btn btn-danger btn-sm" disabled="@busy" @onclick="() => DeleteAsync(item)">@Texts.Get("common.view.deleteYes")</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@busy" @onclick="() => confirmDeleteId = null">@Texts.Get("common.dismiss")</button>
                        </span>
                    }
                    else
                    {
                        <button type="button" class="btn btn-outline-danger btn-sm" disabled="@busy" aria-label="@Texts.Get("reports.schedules.deleteAria", ReportCenterLabels.ScheduleSummary(item))" @onclick="() => confirmDeleteId = item.Id">@Texts.Get("common.delete")</button>
                    }
                </div>
            </div>
        }
    }
</section>

@code {
    private readonly List<ReportScheduleDto> items = [];
    private bool loading;
    private bool loaded;
    private string? error;
    private bool forbidden;
    private bool busy;
    private Guid? confirmDeleteId;
    private string? message;
    private bool messageFailed;
    private bool conflict;

    private bool formOpen;
    private Guid? editingId;
    private long? editingVersion;
    private string frequency = "daily";
    private string weekday = "monday";
    private int monthDay = 1;
    private int hour = 9;
    private string format = "csv";
    private readonly HashSet<Guid> recipientIds = [];
    private List<TenantMemberResponse>? members;
    private string? membersError;
    private string memberFilter = string.Empty;

    /// <summary>Verilirse yalnızca bu raporun zamanlamaları; boşsa kullanıcının tüm zamanlamaları.</summary>
    [Parameter] public Guid? ReportId { get; set; }

    private Guid? loadedFor;
    private bool firstLoadDone;

    protected override async Task OnParametersSetAsync()
    {
        await Session.EnsureLoadedAsync();
        if (!Session.Can(ReportAccess.Schedule) || (firstLoadDone && loadedFor == ReportId))
        {
            return;
        }

        firstLoadDone = true;
        loadedFor = ReportId;
        formOpen = false;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        error = null;
        forbidden = false;
        var url = ReportId is { } id ? $"/api/reports/schedules?reportId={id}" : "/api/reports/schedules";
        var result = await Api.GetAsync<List<ReportScheduleDto>>(url);
        loading = false;
        loaded = true;
        error = result.Error;
        forbidden = result.Status == HttpStatusCode.Forbidden;
        items.Clear();
        if (result.Value is { } value)
        {
            items.AddRange(value.OrderBy(s => s.NextRunAt));
        }
    }

    private void NewSchedule()
    {
        editingId = null;
        editingVersion = null;
        frequency = "daily";
        weekday = "monday";
        monthDay = 1;
        hour = 9;
        format = "csv";
        recipientIds.Clear();
        memberFilter = string.Empty;
        message = null;
        conflict = false;
        formOpen = true;
        _ = EnsureMembersAsync();
    }

    private void Edit(ReportScheduleDto item)
    {
        editingId = item.Id;
        editingVersion = item.Version;
        frequency = item.Frequency;
        weekday = item.DayOfWeek ?? "monday";
        monthDay = item.DayOfMonth ?? 1;
        hour = item.Hour;
        format = item.Format;
        recipientIds.Clear();
        foreach (var recipient in item.Recipients ?? [])
        {
            recipientIds.Add(recipient.UserId);
        }

        memberFilter = string.Empty;
        message = null;
        conflict = false;
        formOpen = true;
        _ = EnsureMembersAsync();
    }

    private async Task EnsureMembersAsync()
    {
        if (members is null)
        {
            await LoadMembersAsync();
        }
    }

    private async Task LoadMembersAsync()
    {
        membersError = null;
        var response = await Api.GetAsync<List<TenantMemberResponse>>("/api/tenant/members");
        members = response.IsSuccess ? response.Value ?? [] : null;
        membersError = response.Error;
        StateHasChanged();
    }

    private IEnumerable<TenantMemberResponse> FilteredMembers() =>
        (members ?? []).Where(m => m.UserId != Session.User?.UserId
            && (memberFilter.Length == 0 || m.DisplayName.Contains(memberFilter, StringComparison.CurrentCultureIgnoreCase)));

    private void ToggleRecipient(Guid id, bool selected)
    {
        if (selected)
        {
            recipientIds.Add(id);
        }
        else
        {
            recipientIds.Remove(id);
        }
    }

    private void CloseForm() => formOpen = false;

    private async Task SaveAsync()
    {
        if (ReportId is not { } reportId)
        {
            return;
        }

        busy = true;
        message = null;
        conflict = false;
        var body = new SaveReportScheduleRequest(
            frequency, hour, frequency == "weekly" ? weekday : null, frequency == "monthly" ? monthDay : null, editingId is null ? null : editingVersion, format, [.. recipientIds]);
        var result = editingId is { } id
            ? await Api.PutAsync<ReportScheduleDto>($"/api/reports/schedules/{id}", body)
            : await Api.PostAsync<ReportScheduleDto>($"/api/reports/{reportId}/schedules", body);
        busy = false;
        if (result.IsSuccess)
        {
            formOpen = false;
            messageFailed = false;
            message = editingId is null ? Texts.Get("reports.schedules.added") : Texts.Get("reports.schedules.updated");
            await LoadAsync();
            return;
        }

        messageFailed = true;
        conflict = result.Status == HttpStatusCode.Conflict;
        message = conflict
            ? Texts.Get("reports.schedules.conflict")
            : result.Issues.Count > 0 ? $"{result.Error} {string.Join(" ", result.Issues.Select(i => i.Message))}" : result.Error;
    }

    private async Task ReloadAfterConflictAsync()
    {
        formOpen = false;
        message = null;
        conflict = false;
        await LoadAsync();
    }

    private async Task ToggleAsync(ReportScheduleDto item)
    {
        busy = true;
        message = null;
        var result = await Api.PutAsync<ReportScheduleDto>($"/api/reports/schedules/{item.Id}/enabled", new SetReportScheduleEnabledRequest(!item.Enabled));
        busy = false;
        messageFailed = !result.IsSuccess;
        message = result.IsSuccess ? (result.Value!.Enabled ? Texts.Get("reports.schedules.enabled") : Texts.Get("reports.schedules.disabled")) : result.Error;
        if (result.IsSuccess || result.Status == HttpStatusCode.NotFound)
        {
            await LoadAsync();
        }
    }

    private async Task DeleteAsync(ReportScheduleDto item)
    {
        busy = true;
        message = null;
        var result = await Api.DeleteAsync($"/api/reports/schedules/{item.Id}");
        busy = false;
        confirmDeleteId = null;
        messageFailed = !result.IsSuccess;
        message = result.IsSuccess ? Texts.Get("reports.schedules.deleted") : result.Error;
        if (result.IsSuccess || result.Status == HttpStatusCode.NotFound)
        {
            await LoadAsync();
        }
    }
}
