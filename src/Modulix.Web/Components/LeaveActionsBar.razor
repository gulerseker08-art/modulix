@* İzin talebi eylemleri (ADR-0042 dilim 2): onayla, reddet, iptal et. Eylemler ve yapılabilirlik sunucudan gelir (/api/hr/leave-requests/{id}/actions);
   ilgisi olmayan kullanıcıya eylem gelmez, yapılamayan eylem nedeniyle pasif görünür. Ret gerekçe ister. Kararı sunucu verir; sürüm değiştiyse
   409 iletisi gösterilir. *@
@inject ApiClient Api

@if (actions is { Count: > 0 })
{
    <section class="list-toolbar" aria-label="İzin talebi eylemleri">
        @if (pending is { } asking)
        {
            <label class="visually-hidden" for="leave-action-reason">Gerekçe</label>
            <input id="leave-action-reason" class="form-control" maxlength="500" placeholder="@($"{asking.Label} gerekçesi")" @bind="reason" @bind:event="oninput" />
            <button type="button" class="btn btn-outline-secondary" disabled="@busy" @onclick="() => pending = null">Vazgeç</button>
            <button type="button" class="btn btn-danger" disabled="@(busy || string.IsNullOrWhiteSpace(reason))" aria-busy="@(busy ? "true" : null)" @onclick="() => RunAsync(asking)">@asking.Label</button>
        }
        else
        {
            @foreach (var action in actions)
            {
                <button type="button" class="@(action.Destructive ? "btn btn-outline-danger" : "btn btn-tonal")" disabled="@(busy || !action.Allowed)"
                        title="@action.Message" @onclick="() => StartAsync(action)">
                    @action.Label
                </button>
            }
        }
    </section>
    @foreach (var blocked in actions.Where(a => !a.Allowed && a.Message is not null).Select(a => a.Message).Distinct())
    {
        <p class="text-muted mb-2">@blocked</p>
    }
}

@if (message is not null)
{
    <div class="alert alert-danger" role="alert">@message</div>
}

@code {
    private List<HrActionDto>? actions;
    private HrActionDto? pending;
    private string? reason;
    private string? message;
    private bool busy;
    private (Guid, long) loadedFor;

    [Parameter, EditorRequired] public RecordResponse Record { get; set; } = default!;

    /// <summary>Eylem başarılı olunca talebin yeni hali.</summary>
    [Parameter] public EventCallback<RecordResponse> Changed { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (loadedFor == (Record.Id, Record.Version))
        {
            return;
        }

        loadedFor = (Record.Id, Record.Version);
        pending = null;
        var result = await Api.GetAsync<List<HrActionDto>>($"/api/hr/leave-requests/{Record.Id}/actions");
        actions = result.Value ?? [];
        message = result.Error;
    }

    private async Task StartAsync(HrActionDto action)
    {
        if (action.RequiresReason)
        {
            pending = action;
            reason = null;
            return;
        }

        await RunAsync(action);
    }

    private async Task RunAsync(HrActionDto action)
    {
        busy = true;
        message = null;
        var result = await Api.PostAsync<RecordResponse>($"/api/hr/leave-requests/{Record.Id}/actions", new RunHrActionRequest(action.Action, Record.Version, reason));
        busy = false;
        if (!result.IsSuccess)
        {
            message = result.FieldErrors?.Values.SelectMany(v => v).FirstOrDefault() ?? result.Error;
            return;
        }

        pending = null;
        reason = null;
        await Changed.InvokeAsync(result.Value!);
    }
}
