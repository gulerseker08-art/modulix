@* Anket formu (ADR-0042 dilim 7). Düzen firmanın form düzenine (ADR-0021) göre çizilir. "Kimliği gizli" yalnızca oluştururken seçilir (sunucu sonradan
   değiştirmez); durum (yanıta aç, kapat) formdan değil eylem çubuğundan değişir. Hedef departman boşsa bütün çalışanlar yanıtlar. *@
@using System.Text.Json.Nodes
@inject ApiClient Api
@inject FormLayouts Layouts
@inject ToastService Toasts

<form class="record-form sectioned" novalidate @onsubmit="SaveAsync" @onsubmit:preventDefault @oninput="() => dirty = true">
    <div class="form-toolbar">
        <div>
            <h2>@(Survey is null ? "Yeni anket" : "Anket")</h2>
            @if (Survey is not null)
            {
                <p>@HrLabels.SurveyStatus(WarehouseLabels.Text(Survey, "status")) · @WarehouseLabels.Number(Survey, "questionCount") soru · @WarehouseLabels.Number(Survey, "responseCount") yanıt</p>
            }
        </div>
        <div class="form-toolbar-actions">
            <UnsavedChanges IsDirty="() => dirty" />
            <button type="button" class="btn btn-outline-secondary" @onclick="Cancelled">İptal</button>
            <button type="submit" class="btn btn-primary" disabled="@(busy || layout is null)" aria-busy="@(busy ? "true" : null)">Kaydet</button>
        </div>
    </div>

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }
    @if (layoutError is not null)
    {
        <div class="alert alert-danger" role="alert">@layoutError</div>
    }

    <LayoutForm Layout="layout" CustomFields="CustomFields" CustomValues="form.Custom" Errors="errors" TabsLabel="Anket bölümleri">
        <Field Context="f">
            @switch (f.Key)
            {
                case "title":
                    <label class="@f.LabelClass()" for="survey-title">@f.Label</label>
                    <input id="survey-title" class="form-control" maxlength="200" required aria-required="true" placeholder="ör. Çalışan memnuniyeti 2026" @bind="form.Title" />
                    <FieldError Field="title" Errors="errors" />
                    break;
                case "description":
                    <label class="@f.LabelClass()" for="survey-description">@f.Label</label>
                    <textarea id="survey-description" class="form-control" rows="3" maxlength="2000" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.Description"></textarea>
                    <FieldError Field="description" Errors="errors" />
                    break;
                case "isAnonymous":
                    <div class="form-check mt-4">
                        <input id="survey-anonymous" class="form-check-input" type="checkbox" disabled="@(form.Id is not null)" @bind="form.IsAnonymous" />
                        <label class="form-check-label" for="survey-anonymous">@f.Label</label>
                    </div>
                    <small class="text-muted">Tam anonim: cevaplar yanıtlayana hiçbir yerde (sonuç, denetim kaydı, veritabanı) bağlanmaz; yalnızca kimin katıldığı tutulur. En az @MinAnonymousResponses yanıt gelince özet görünür. Kaydettikten sonra değişmez.</small>
                    break;
                case "audienceBusinessUnitIds":
                    <label class="@f.LabelClass()" for="survey-audience-units">@f.Label</label>
                    <HrAudiencePicker Kind="HrAudiencePicker.AudienceKind.Units" Id="survey-audience-units" Lookups="Lookups" Selected="form.AudienceUnits"
                                      SelectedChanged="UnitsChanged" Invalid="@(errors?.ContainsKey("audienceBusinessUnitIds") == true)" />
                    <FieldError Field="audienceBusinessUnitIds" Errors="errors" />
                    @if (!form.UnitsTouched && form.AudienceUnits.Count == 0 && form.LegacyAudience is { Length: > 0 } legacy)
                    {
                        <small class="text-muted">Eski İK departmanına hedefli: @Lookups.Label(HrAccess.DepartmentList, legacy). Departman seçilince Core departmanına geçer.</small>
                    }
                    else
                    {
                        <small class="text-muted">Alt departmanlardakiler de dahildir. Departman ve kişi seçilmezse bütün çalışanlara yöneliktir.</small>
                    }
                    break;
                case "audienceUserIds":
                    <label class="@f.LabelClass()" for="survey-audience-users">@f.Label</label>
                    <HrAudiencePicker Kind="HrAudiencePicker.AudienceKind.Users" Id="survey-audience-users" Lookups="Lookups" Selected="form.AudienceUsers"
                                      SelectedChanged="UsersChanged" Invalid="@(errors?.ContainsKey("audienceUserIds") == true)" />
                    <FieldError Field="audienceUserIds" Errors="errors" />
                    break;
                case "closesOn":
                    <label class="@f.LabelClass()" for="survey-closes">@f.Label</label>
                    <input id="survey-closes" class="form-control" type="date" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.ClosesOn" />
                    <FieldError Field="closesOn" Errors="errors" />
                    <small class="text-muted">Boşsa elle kapatılana kadar açık.</small>
                    break;
            }
        </Field>
    </LayoutForm>
</form>

@code {
    private const string EntityKey = HrAccess.SurveyEntityKey;
    private const int MinAnonymousResponses = 3;

    private bool dirty;
    private FormLayoutDto? layout;
    private string? layoutError;
    private SurveyForm form = new();
    private IReadOnlyDictionary<string, string[]>? errors;
    private string? message;
    private bool busy;

    [Parameter] public RecordResponse? Survey { get; set; }

    [Parameter, EditorRequired] public CrmLookups Lookups { get; set; } = default!;

    [Parameter] public EventCallback<RecordResponse> Saved { get; set; }

    [Parameter] public EventCallback Cancelled { get; set; }

    private IReadOnlyList<CustomFieldDto> CustomFields => [.. Lookups.FieldsOf(EntityKey)];

    protected override async Task OnInitializedAsync()
    {
        form = Survey is { } s
            ? new SurveyForm
            {
                Id = s.Id, Version = s.Version, Title = WarehouseLabels.Text(s, "title"), Description = WarehouseLabels.Text(s, "description"),
                IsAnonymous = WarehouseLabels.Flag(s, "isAnonymous"), AudienceUnits = HrLabels.Ids(s, "audienceBusinessUnitIds"), AudienceUsers = HrLabels.Ids(s, "audienceUserIds"),
                LegacyAudience = WarehouseLabels.Text(s, "audienceDepartmentKey"),
                ClosesOn = FleetLabels.Day(WarehouseLabels.Text(s, "closesOn")), Custom = s.Values["custom"]?.DeepClone().AsObject() ?? [],
            }
            : new SurveyForm();
        layout = await Layouts.ForAsync(EntityKey);
        layoutError = layout is null ? "Form düzeni yüklenemedi; sayfayı yenileyip yeniden deneyin." : null;
    }

    // Hedef birden çok Core departmanı ve/veya kişidir (bölüm 23c). Eski İK departman hedefi olan kayıtta departmanlar değiştirilmedikçe gönderilmez
    // (sunucu eski hedefi korur).
    private void AddAudience(JsonObject values)
    {
        if (form.UnitsTouched || string.IsNullOrEmpty(form.LegacyAudience))
        {
            values["audienceBusinessUnitIds"] = HrLabels.IdArray(form.AudienceUnits);
        }

        values["audienceUserIds"] = HrLabels.IdArray(form.AudienceUsers);
    }

    private void UnitsChanged(IReadOnlyList<Guid> units)
    {
        form.AudienceUnits = units;
        form.UnitsTouched = true;
        dirty = true;
    }

    private void UsersChanged(IReadOnlyList<Guid> users)
    {
        form.AudienceUsers = users;
        dirty = true;
    }

    private async Task SaveAsync()
    {
        busy = true;
        message = null;
        errors = null;
        var values = new JsonObject
        {
            ["title"] = string.IsNullOrWhiteSpace(form.Title) ? null : form.Title.Trim(),
            ["description"] = string.IsNullOrWhiteSpace(form.Description) ? null : form.Description.Trim(),
            ["closesOn"] = form.ClosesOn?.ToString("yyyy-MM-dd"),
            ["custom"] = CustomFieldText.ForSave(CustomFields, form.Custom),
        };
        if (form.Id is null)
        {
            values["isAnonymous"] = form.IsAnonymous;
        }

        AddAudience(values);
        var request = new RecordWriteRequest(values, form.Version);
        var url = "/api/records/" + EntityKey;
        var result = form.Id is { } id ? await Api.PutAsync<RecordResponse>($"{url}/{id}", request) : await Api.PostAsync<RecordResponse>(url, request);
        busy = false;
        if (result.IsSuccess)
        {
            dirty = false;
            Toasts.Success(Texts.Get("common.saved"));
            await Saved.InvokeAsync(result.Value!);
            return;
        }

        errors = result.FieldErrors;
        message = result.Error;
    }

    private sealed class SurveyForm
    {
        public JsonObject Custom { get; set; } = [];

        public Guid? Id { get; init; }

        public long? Version { get; init; }

        public string? Title { get; set; }

        public string? Description { get; set; }

        public bool IsAnonymous { get; set; }

        public IReadOnlyList<Guid> AudienceUnits { get; set; } = [];

        public IReadOnlyList<Guid> AudienceUsers { get; set; } = [];

        /// <summary>Eski İK departman hedefi (Core'a eşlenmemiş kayıtta); hedef değiştirilmedikçe korunur.</summary>
        public string? LegacyAudience { get; init; }

        public bool UnitsTouched { get; set; }

        public DateOnly? ClosesOn { get; set; }
    }
}
