@* Otomasyon kural sürümünün salt okunur görünümü (ADR-0027, Dilim 5a): ad, açıklama, okunabilir özet, öncelik, geçerlilik ve
   şu anki katalogla doğrulama sorunları. Özeti sunucu üretir (kullanıcının görebildiği alanlarla); burada yeniden hesaplanmaz. *@
<dl class="detail-grid">
    <dt>@Texts.Get("common.field.name")</dt>
    <dd>@Version.Name</dd>
    @if (!string.IsNullOrWhiteSpace(Version.Description))
    {
        <dt>@Texts.Get("common.field.description")</dt>
        <dd>@Version.Description</dd>
    }
    <dt>@Texts.Get("admin.automationRule.summary")</dt>
    <dd class="span-all">@(string.IsNullOrWhiteSpace(Version.Summary) ? Texts.Get("admin.automationRule.noSummary") : Version.Summary)</dd>
    <dt>@Texts.Get("admin.automation.priority")</dt>
    <dd>@Version.Priority @(Version.StopProcessing ? "· " + Texts.Get("admin.automationRule.stopsOthers") : null)</dd>
    <dt>@Texts.Get("admin.automationRule.validity")</dt>
    <dd>@Validity</dd>
    @if (Version.PublishedAt is { } at)
    {
        <dt>@Texts.Get("admin.automationRule.publishedAt")</dt>
        <dd>@CrmLabels.Time(at)</dd>
    }
</dl>

@if (Issues.Count > 0)
{
    <div class="alert alert-warning" role="alert">
        <strong>@Texts.Get("admin.automationRule.issues")</strong>
        <ul class="mb-0">
            @foreach (var issue in Issues)
            {
                <li>@issue.Message</li>
            }
        </ul>
    </div>
}

@code {
    [Parameter, EditorRequired] public AutomationVersionDto Version { get; set; } = null!;

    [Parameter] public IReadOnlyList<AutomationIssueDto> Issues { get; set; } = [];

    private string Validity => (Version.ActiveFrom, Version.ActiveUntil) switch
    {
        (null, null) => Texts.Get("admin.automationRule.validAlways"),
        ({ } from, null) => Texts.Get("admin.automationRule.validFrom", CrmLabels.Time(from)),
        (null, { } until) => Texts.Get("admin.automationRule.validUntil", CrmLabels.Time(until)),
        ({ } from, { } until) => $"{CrmLabels.Time(from)} – {CrmLabels.Time(until)}",
    };
}
