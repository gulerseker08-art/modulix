@* Otomasyon kural sürümünün salt okunur görünümü (ADR-0027, Dilim 5a): ad, açıklama, okunabilir özet, öncelik, geçerlilik ve
   şu anki katalogla doğrulama sorunları. Özeti sunucu üretir (kullanıcının görebildiği alanlarla); burada yeniden hesaplanmaz. *@
<dl class="detail-grid">
    <dt>Ad</dt>
    <dd>@Version.Name</dd>
    @if (!string.IsNullOrWhiteSpace(Version.Description))
    {
        <dt>Açıklama</dt>
        <dd>@Version.Description</dd>
    }
    <dt>Ne yapar</dt>
    <dd class="span-all">@(string.IsNullOrWhiteSpace(Version.Summary) ? "Özet gösterilemiyor (bu kayıt türünü görme izniniz yok ya da modül kapalı)." : Version.Summary)</dd>
    <dt>Öncelik</dt>
    <dd>@Version.Priority @(Version.StopProcessing ? "· Bu kuraldan sonra aynı kayıt için başka kural çalışmaz" : null)</dd>
    <dt>Geçerlilik</dt>
    <dd>@Validity</dd>
    @if (Version.PublishedAt is { } at)
    {
        <dt>Yayın tarihi</dt>
        <dd>@CrmLabels.Time(at)</dd>
    }
</dl>

@if (Issues.Count > 0)
{
    <div class="alert alert-warning" role="alert">
        <strong>Sorunlar</strong>
        <ul class="mb-0">
            @foreach (var issue in Issues)
            {
                <li>@issue.Message</li>
            }
        </ul>
    </div>
}

@code {
    [Parameter, EditorRequired] public AutomationVersionDto Version { get; set; } = null!;

    [Parameter] public IReadOnlyList<AutomationIssueDto> Issues { get; set; } = [];

    private string Validity => (Version.ActiveFrom, Version.ActiveUntil) switch
    {
        (null, null) => "Süresiz",
        ({ } from, null) => $"{CrmLabels.Time(from)} tarihinden itibaren",
        (null, { } until) => $"{CrmLabels.Time(until)} tarihine kadar",
        ({ } from, { } until) => $"{CrmLabels.Time(from)} – {CrmLabels.Time(until)}",
    };
}
