@* Gümrük beyannamesi başlığı ekleme/düzenleme formu; Beyannameler ekranı kullanır. Düzen firmanın form düzenine (ADR-0021) göre çizilir. Kayıt
   genel kayıt uçlarından (/api/records/warehouse.customs-declaration) yapılır. İthalatçı ve müşavir firmadır (core.party); seçim kutuları yalnızca
   ilgili ilişki rolündeki firmaları getirir. Tescil no benzersizliği, taraf rolleri ve dış referans kuralları sunucudadır; ileti alanın altında
   gösterilir. Kaydedilmiş beyannamenin satırları formun altındaki panelden yönetilir. *@
@using System.Text.Json.Nodes
@inject ApiClient Api
@inject FormLayouts Layouts

<form class="record-form sectioned" novalidate @onsubmit="SaveAsync" @onsubmit:preventDefault>
    <div class="form-toolbar">
        <div>
            <h2>@(Declaration is null ? "Yeni beyanname" : "Beyanname")</h2>
            @if (Declaration is not null)
            {
                <p>@form.RegistrationNo</p>
            }
        </div>
        <div class="form-toolbar-actions">
            <button type="button" class="btn btn-outline-secondary" @onclick="Cancelled">@(Declaration is null ? "İptal" : "Kapat")</button>
            <button type="submit" class="btn btn-primary" disabled="@(busy || layout is null)">
                @if (busy)
                {
                    <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                }
                Kaydet
            </button>
        </div>
    </div>

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }
    @if (layoutError is not null)
    {
        <div class="alert alert-danger" role="alert">@layoutError</div>
    }

    <div class="record-layout">
        <aside class="record-summary" aria-label="Beyanname özeti">
            <div class="summary-card">
                <div class="summary-identity">
                    <span class="summary-avatar" aria-hidden="true"><AppIcon Name="clipboard-list" Size="24" /></span>
                    <strong class="summary-name">@(string.IsNullOrWhiteSpace(form.RegistrationNo) ? "Tescil no" : form.RegistrationNo)</strong>
                    <span class="summary-sub">@Show(form.RegistrationDate)</span>
                </div>
                <h3 class="summary-heading">Beyanname özeti</h3>
                <dl class="summary-facts">
                    <div><dt>Durum</dt><dd>@(string.IsNullOrEmpty(form.StatusKey) ? "—" : Lookups.Label(WarehouseAccess.DeclarationStatusList, form.StatusKey))</dd></div>
                    <div><dt>Rejim</dt><dd>@(string.IsNullOrEmpty(form.RegimeKey) ? "—" : Lookups.Label(WarehouseAccess.CustomsRegimeList, form.RegimeKey))</dd></div>
                </dl>
            </div>
        </aside>

        <div class="record-main">
            <LayoutForm Layout="layout" CustomFields="CustomFields" CustomValues="form.Custom" Errors="errors" TabsLabel="Beyanname formu bölümleri">
                <Field Context="f">
                    @switch (f.Key)
                    {
                        case "registrationNo":
                            <label class="@f.LabelClass()" for="decl-no">@f.Label</label>
                            <input id="decl-no" class="form-control" maxlength="30" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.RegistrationNo" @bind:event="onchange" />
                            <FieldError Field="registrationNo" Errors="errors" />
                            <small class="text-muted">Harf, rakam ve - _ . / karakterleri; büyük harfe çevrilir, firma içinde benzersizdir.</small>
                            @* Rejim bir rejim profiline bağlıysa tescil no profilin kuralına göre denetlenir (uyarı kaydı engellemez). *@
                            <RegistrationNoHint RegimeKey="@form.RegimeKey" RegistrationNo="@form.RegistrationNo" />
                            break;
                        case "registrationDate":
                            <label class="@f.LabelClass()" for="decl-date">@f.Label</label>
                            <input id="decl-date" class="form-control" type="date" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.RegistrationDate" />
                            <FieldError Field="registrationDate" Errors="errors" />
                            break;
                        case "statusKey":
                            <label class="@f.LabelClass()" for="decl-status">@f.Label</label>
                            <select id="decl-status" class="form-select" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.StatusKey">
                                @foreach (var status in Lookups.Choices(WarehouseAccess.DeclarationStatusList, form.StatusKey))
                                {
                                    <option value="@status.Key">@status.Label</option>
                                }
                            </select>
                            <FieldError Field="statusKey" Errors="errors" />
                            <small class="text-muted">İptal durumundaki beyannamenin satırları değiştirilemez.</small>
                            break;
                        case "regimeKey":
                            <label class="@f.LabelClass()" for="decl-regime">@f.Label</label>
                            <select id="decl-regime" class="form-select" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.RegimeKey">
                                @foreach (var regime in Lookups.Choices(WarehouseAccess.CustomsRegimeList, form.RegimeKey))
                                {
                                    <option value="@regime.Key">@regime.Label</option>
                                }
                            </select>
                            <FieldError Field="regimeKey" Errors="errors" />
                            break;
                        case "customsOffice":
                            <label class="@f.LabelClass()" for="decl-office">@f.Label</label>
                            <input id="decl-office" class="form-control" maxlength="100" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.CustomsOffice" />
                            <FieldError Field="customsOffice" Errors="errors" />
                            break;
                        case "importerPartyId":
                            <label class="@f.LabelClass()" for="decl-importer">@f.Label</label>
                            <LookupPicker Id="decl-importer" LookupKey="@WarehouseAccess.DeclarationImporterLookup" @bind-Value="form.ImporterPartyId" Required="f.Required" Placeholder="İthalatçı seçin…" Invalid="@(errors?.ContainsKey("importerPartyId") == true)" />
                            <FieldError Field="importerPartyId" Errors="errors" />
                            <small class="text-muted">Yalnızca "İthalatçı / malik" rolündeki firmalar listelenir; rol firma kaydından verilir.</small>
                            break;
                        case "brokerPartyId":
                            <label class="@f.LabelClass()" for="decl-broker">@f.Label</label>
                            <LookupPicker Id="decl-broker" LookupKey="@WarehouseAccess.DeclarationBrokerLookup" @bind-Value="form.BrokerPartyId" Required="f.Required" Placeholder="Gümrük müşaviri seçin…" Invalid="@(errors?.ContainsKey("brokerPartyId") == true)" />
                            <FieldError Field="brokerPartyId" Errors="errors" />
                            <small class="text-muted">İsteğe bağlı. Yalnızca "Gümrük müşaviri" rolündeki firmalar listelenir.</small>
                            break;
                        case "externalReference":
                            <label class="@f.LabelClass()" for="decl-external">@f.Label</label>
                            <input id="decl-external" class="form-control" maxlength="100" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.ExternalReference" />
                            <FieldError Field="externalReference" Errors="errors" />
                            <small class="text-muted">Müşavirlik yazılımındaki kayıt numarası; doluysa firma içinde benzersizdir.</small>
                            break;
                        case "description":
                            <label class="@f.LabelClass()" for="decl-description">@f.Label</label>
                            <textarea id="decl-description" class="form-control" rows="3" maxlength="1000" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.Description"></textarea>
                            <FieldError Field="description" Errors="errors" />
                            break;
                    }
                </Field>
            </LayoutForm>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary" disabled="@(busy || layout is null)">Kaydet</button>
                <button type="button" class="btn btn-outline-secondary" @onclick="Cancelled">@(Declaration is null ? "İptal" : "Kapat")</button>
                @if (form.Id is not null)
                {
                    <button type="button" class="btn btn-outline-danger ms-auto" disabled="@busy" @onclick="DeleteAsync">Sil</button>
                }
            </div>
        </div>
    </div>
</form>

@code {
    private const string EntityKey = WarehouseAccess.CustomsDeclarationEntityKey;
    private static readonly string Url = "/api/records/" + EntityKey;

    private FormLayoutDto? layout;
    private string? layoutError;
    private DeclarationForm form = new();
    private IReadOnlyDictionary<string, string[]>? errors;
    private string? message;
    private bool busy;
    private RecordResponse? source;
    private bool initialized;

    /// <summary>Düzenlenecek beyanname; null ise yeni beyanname.</summary>
    [Parameter] public RecordResponse? Declaration { get; set; }

    [Parameter, EditorRequired] public CrmLookups Lookups { get; set; } = default!;

    [Parameter] public EventCallback<RecordResponse> Saved { get; set; }

    [Parameter] public EventCallback Deleted { get; set; }

    [Parameter] public EventCallback Cancelled { get; set; }

    private IReadOnlyList<CustomFieldDto> CustomFields => [.. Lookups.FieldsOf(EntityKey)];

    protected override async Task OnInitializedAsync()
    {
        layout = await Layouts.ForAsync(EntityKey);
        layoutError = layout is null ? "Form düzeni yüklenemedi; sayfayı yenileyip yeniden deneyin." : null;
    }

    /// <summary>Form yalnızca başka bir beyanname verildiğinde yeniden doldurulur; yazılanlar kaybolmaz.</summary>
    protected override void OnParametersSet()
    {
        if (initialized && ReferenceEquals(source, Declaration))
        {
            return;
        }

        initialized = true;
        source = Declaration;
        form = Declaration is { } r
            ? new DeclarationForm
            {
                Id = r.Id, Version = r.Version, RegistrationNo = WarehouseLabels.Text(r, "registrationNo"),
                RegistrationDate = ParseDate(WarehouseLabels.Text(r, "registrationDate")), CustomsOffice = WarehouseLabels.Text(r, "customsOffice"),
                RegimeKey = WarehouseLabels.Text(r, "regimeKey"), StatusKey = WarehouseLabels.Text(r, "statusKey"),
                ImporterPartyId = WarehouseLabels.Id(r, "importerPartyId"), BrokerPartyId = WarehouseLabels.Id(r, "brokerPartyId"),
                ExternalReference = WarehouseLabels.Text(r, "externalReference"), Description = WarehouseLabels.Text(r, "description"),
                Custom = r.Values["custom"]?.DeepClone().AsObject() ?? [],
            }
            : new DeclarationForm
            {
                RegistrationDate = DateTime.Today,
                RegimeKey = Lookups.DefaultOf(WarehouseAccess.CustomsRegimeList) ?? string.Empty,
                StatusKey = Lookups.DefaultOf(WarehouseAccess.DeclarationStatusList) ?? string.Empty,
            };
        errors = null;
        message = null;
    }

    private async Task SaveAsync()
    {
        busy = true;
        var values = new JsonObject
        {
            ["registrationNo"] = form.RegistrationNo,
            ["registrationDate"] = Iso(form.RegistrationDate),
            ["customsOffice"] = form.CustomsOffice,
            ["regimeKey"] = form.RegimeKey,
            ["statusKey"] = form.StatusKey,
            ["importerPartyId"] = form.ImporterPartyId?.ToString(),
            ["brokerPartyId"] = form.BrokerPartyId?.ToString(),
            ["externalReference"] = form.ExternalReference,
            ["description"] = form.Description,
            ["custom"] = CustomFieldText.ForSave(CustomFields, form.Custom),
        };

        var request = new RecordWriteRequest(values, form.Version);
        var result = form.Id is { } id
            ? await Api.PutAsync<RecordResponse>($"{Url}/{id}", request)
            : await Api.PostAsync<RecordResponse>(Url, request);
        busy = false;

        if (result.IsSuccess)
        {
            await Saved.InvokeAsync(result.Value!);
            return;
        }

        errors = result.FieldErrors;
        message = result.Error;
    }

    private static string? Iso(DateTime? date) => date?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture);

    private static DateTime? ParseDate(string iso) =>
        DateTime.TryParseExact(iso, "yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var date) ? date : null;

    private static string Show(DateTime? date) => date?.ToString("d", System.Globalization.CultureInfo.GetCultureInfo("tr-TR")) ?? "—";

    private async Task DeleteAsync()
    {
        busy = true;
        var result = await Api.DeleteAsync($"{Url}/{form.Id}?version={form.Version}");
        busy = false;

        if (result.IsSuccess)
        {
            await Deleted.InvokeAsync();
            return;
        }

        message = result.Error;
    }

    private sealed class DeclarationForm
    {
        public JsonObject Custom { get; set; } = [];

        public Guid? Id { get; init; }

        public long? Version { get; init; }

        public string RegistrationNo { get; set; } = string.Empty;

        /// <summary>Tarih girdisi; sunucuya yyyy-AA-gg olarak gider.</summary>
        public DateTime? RegistrationDate { get; set; }

        public string? CustomsOffice { get; set; }

        public string RegimeKey { get; set; } = string.Empty;

        public string StatusKey { get; set; } = string.Empty;

        public Guid? ImporterPartyId { get; set; }

        public Guid? BrokerPartyId { get; set; }

        public string? ExternalReference { get; set; }

        public string? Description { get; set; }
    }
}
