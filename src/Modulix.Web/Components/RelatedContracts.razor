@* İlişkili sözleşmeler (ADR-0022, dilim 3): firma kartında müşterinin, fırsat ekranında kaynak fırsatın sözleşmeleri. Sözleşme modülü bu tenant için
   kapalıysa ya da kullanıcının okuma izni yoksa bileşen hiçbir şey çizmez ve istek yapmaz; liste sunucuda izin ve veri kapsamıyla süzülür. *@
@inject ApiClient Api
@inject SessionState Session

@if (Available)
{
    <section class="detail-section" aria-labelledby="related-contracts-title">
        <div class="section-header">
            <h2 id="related-contracts-title">@Heading</h2>
        </div>
        @if (error is not null)
        {
            <p class="text-muted" role="status">@error</p>
        }
        else if (items is null)
        {
            <LoadingState Kind="LoadingKind.Table" />
        }
        else if (items.Count == 0)
        {
            <EmptyState Title="@Texts.Get("contracts.related.empty")" />
        }
        else
        {
            <table class="table record-table">
                <caption class="visually-hidden">@Heading</caption>
                <thead>
                    <tr><th scope="col">@Texts.Get("contracts.list.col.contract")</th><th scope="col">@Texts.Get("common.field.status")</th><th scope="col">@Texts.Get("contracts.list.col.dates")</th><th scope="col">@Texts.Get("contracts.renewals.col.notice")</th></tr>
                </thead>
                <tbody>
                    @foreach (var c in items)
                    {
                        <tr>
                            <td data-label="@Texts.Get("contracts.list.col.contract")" class="primary"><a href="sozlesmeler/@c.Id">@c.Title</a> <small class="text-muted">@c.Number</small></td>
                            <td data-label="@Texts.Get("common.field.status")">
                                <span class="badge stage-@ContractLabels.EffectiveBadge(c.EffectiveStatus)">@ContractLabels.Label(ContractLabels.Effectives, c.EffectiveStatus)</span>
                                @if (c.SignatureStatus != "NotSent") { <span class="badge stage-@ContractLabels.SignatureBadge(c.SignatureStatus)">@ContractLabels.Label(ContractLabels.Signatures, c.SignatureStatus)</span> }
                            </td>
                            <td data-label="@Texts.Get("contracts.list.col.dates")">@ContractLabels.Date(c.StartDate) – @(c.IsIndefinite ? Texts.Get("contracts.indefinite") : ContractLabels.Date(c.EndDate))</td>
                            <td data-label="@Texts.Get("contracts.renewals.col.notice")">@ContractLabels.Date(c.NoticeDeadline)</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>

    @if (PartyId is not null && upcoming is { Count: > 0 })
    {
        <section class="detail-section" aria-labelledby="related-commitments-title">
            <div class="section-header">
                <h2 id="related-commitments-title">@Texts.Get("contracts.related.commitmentsTitle")</h2>
            </div>
            <table class="table record-table">
                <caption class="visually-hidden">@Texts.Get("contracts.related.commitmentsCaption")</caption>
                <thead><tr><th scope="col">@Texts.Get("contracts.commitments.col.commitment")</th><th scope="col">@Texts.Get("contracts.list.col.contract")</th><th scope="col">@Texts.Get("contracts.commitments.col.due")</th><th scope="col">@Texts.Get("common.field.status")</th></tr></thead>
                <tbody>
                    @foreach (var o in upcoming)
                    {
                        <tr>
                            <td data-label="@Texts.Get("contracts.commitments.col.commitment")" class="primary">@o.CommitmentTitle</td>
                            <td data-label="@Texts.Get("contracts.list.col.contract")"><a href="sozlesmeler/@o.ContractId">@o.ContractTitle</a> <small class="text-muted">@o.ContractNumber</small></td>
                            <td data-label="@Texts.Get("contracts.commitments.col.due")">@ContractLabels.Date(o.DueDate)@if (o.IsOverdue) { <div class="small text-danger">@Texts.Get("contracts.commitments.daysOverdue", o.DaysOverdue)</div> }</td>
                            <td data-label="@Texts.Get("common.field.status")"><span class="badge stage-@CommitmentLabels.Badge(o.Status, o.IsOverdue)">@CommitmentLabels.Label(CommitmentLabels.OccurrenceStatuses, o.Status)</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>
    }
}

@code {
    private IReadOnlyList<ContractDto>? items;
    private IReadOnlyList<CommitmentOccurrenceDto>? upcoming;
    private string? error;
    private string? loadedFor;

    /// <summary>Bölüm başlığı; verilmezse "Sözleşmeler" (sözlükten).</summary>
    [Parameter] public string? Title { get; set; }

    private string Heading => Title ?? Texts.Get("crm.company.contracts");

    /// <summary>Ortak müşteri (taraf) kaydı; firma kartında firmanın <c>PartyId</c> değeri.</summary>
    [Parameter] public Guid? PartyId { get; set; }

    /// <summary>Kaynak fırsat: fırsattan açılan tekliflerden doğan sözleşmeler.</summary>
    [Parameter] public Guid? SourceOpportunityId { get; set; }

    private bool Available => Session.IsModuleEnabled(ContractsAccess.ModuleKey) && Session.Can(ContractsAccess.ContractsRead) && (PartyId is not null || SourceOpportunityId is not null);

    protected override async Task OnParametersSetAsync()
    {
        if (!Available)
        {
            return;
        }

        var query = PartyId is { } party ? $"partyId={party}" : $"sourceOpportunityId={SourceOpportunityId}";
        if (loadedFor == query)
        {
            return;
        }

        loadedFor = query;
        var result = await Api.GetAsync<PagedResult<ContractDto>>($"/api/contracts/contracts?{query}&pageSize=20");
        items = result.Value?.Items;
        error = result.IsSuccess ? null : result.Error;

        // Müşterinin açık taahhütleri: gecikenler ve önümüzdeki 60 gün (en yakın beş).
        if (PartyId is { } partyId)
        {
            var until = DateOnly.FromDateTime(DateTime.Today.AddDays(60)).ToString("yyyy-MM-dd");
            var commitments = await Api.GetAsync<List<CommitmentOccurrenceDto>>($"/api/contracts/commitments/occurrences?partyId={partyId}&status=Open&dueTo={until}");
            upcoming = commitments.Value?.Take(5).ToList();
        }
    }
}
