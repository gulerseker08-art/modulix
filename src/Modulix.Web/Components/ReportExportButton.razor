@* "CSV olarak dışa aktar" (ADR-0035 dilim 4). Yalnızca core.reports.export izni olana görünür. Kayıtlı raporda ReportId, kayıtsız tanımda (önizleme,
   hazır rapor) Spec verilir. Dosya sunucuda ekrandaki sonuçla aynı hesaptan, çağıranın yetkisiyle üretilir; hassas alanlar yetki yoksa dosyada olmaz. *@
@inject ApiClient Api
@inject SessionState Session
@inject IJSRuntime Js

@if (Session.Can(ReportAccess.Export))
{
    <div class="report-export">
        <button type="button" class="btn btn-outline-secondary" disabled="@(Disabled || busy)" aria-describedby="rx-help" @onclick='() => RunExportAsync("csv")'>
            @if (busy) { <span class="spinner-border spinner-border-sm" aria-hidden="true"></span> }
            @Texts.Get("reports.exportButton.csv")
        </button>
        <button type="button" class="btn btn-outline-secondary ms-2" disabled="@(Disabled || busy)" aria-describedby="rx-help" @onclick='() => RunExportAsync("xlsx")'>
            @Texts.Get("reports.exportButton.excel")
        </button>
        <span id="rx-help" class="form-text ms-2">@Texts.Get("reports.exportButton.help")</span>

        <div aria-live="polite">
            @if (error is not null)
            {
                <div class="alert alert-danger mt-2" role="alert">
                    @error
                    <ReportIssueList Issues="issues" />
                </div>
            }

            @if (export is not null)
            {
                <div class="alert alert-success mt-2" role="status">
                    <strong>@Texts.Get("reports.exportButton.ready")</strong> @export.FileName
                    @Texts.Get("reports.exportButton.readyDetails", export.RowCount.ToString("N0", Regional.Numbers), ReportCenterLabels.Size(export.SizeBytes), CrmLabels.Time(export.ExpiresAt))
                    <button type="button" class="btn btn-primary btn-sm ms-2" disabled="@busy" @onclick="DownloadAsync">@Texts.Get("crm.sales.export.download")</button>
                    <a class="ms-2" href="raporlar/disa-aktarimlar">@Texts.Get("reports.exportButton.myExports")</a>
                </div>
                @if (export.Truncated)
                {
                    <div class="alert alert-warning" role="status">
                        <strong>@Texts.Get("reports.exportButton.truncatedTitle")</strong> @Texts.Get("reports.exportButton.truncated")
                    </div>
                }
            }

            @if (downloadError is not null)
            {
                <div class="alert alert-danger" role="alert">@downloadError</div>
            }
        </div>
    </div>
}

@code {
    private ReportExportDto? export;
    private string? error;
    private string? downloadError;
    private IReadOnlyList<ReportIssueDto> issues = [];
    private bool busy;

    /// <summary>Kayıtlı rapor; doluysa <c>/{id}/exports</c> çağrılır.</summary>
    [Parameter] public Guid? ReportId { get; set; }

    /// <summary>Kayıtsız tanım (ReportId boşken): oluşturucu önizlemesi ya da hazır rapor.</summary>
    [Parameter] public ReportSpecDto? Spec { get; set; }

    /// <summary>Kayıtsız tanımda dosya/rapor adı.</summary>
    [Parameter] public string? Name { get; set; }

    [Parameter] public bool Disabled { get; set; }

    private async Task RunExportAsync(string format)
    {
        busy = true;
        error = null;
        downloadError = null;
        export = null;
        issues = [];
        var result = ReportId is { } id
            ? await Api.PostAsync<ReportExportDto>($"/api/reports/{id}/exports?format={format}", new { })
            : await Api.PostAsync<ReportExportDto>($"/api/reports/exports?format={format}", new ExportReportRequest(Spec, string.IsNullOrWhiteSpace(Name) ? null : Name.Trim()));
        busy = false;
        if (result.IsSuccess)
        {
            export = result.Value;
            return;
        }

        error = result.Status == System.Net.HttpStatusCode.Forbidden
            ? Texts.Get("reports.exportButton.forbidden", result.Error)
            : result.Error;
        issues = result.Issues;
    }

    private async Task DownloadAsync()
    {
        if (export is null)
        {
            return;
        }

        busy = true;
        downloadError = await ReportExportDownloads.DownloadAsync(Api, Js, export);
        busy = false;
    }
}
