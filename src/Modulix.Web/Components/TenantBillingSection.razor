@inject ApiClient Api

@* Ödeme kayıtları (ADR-0028 Dilim 7c): sağlayıcıdan bağımsız defter. Tahsilat/fatura buraya elle işlenir (Finans rolü); kayıt erişimi
   değiştirmez, hiçbir kayıt silinmez (iptal gerekçesiyle kalır). *@
<section class="detail-section">
    <div class="section-header"><h2>@Texts.Get("platform.billing.title")</h2></div>
    <p class="text-muted">@Texts.Strong("platform.billing.intro", Texts.Get("platform.billing.introStrong"))</p>

    <Notice Text="@notice" Failed="failed" />

    <form class="inline-form" novalidate @onsubmit="CreateAsync" @onsubmit:preventDefault>
        <h3>@Texts.Get("platform.billing.create")</h3>
        <div class="form-grid">
            <div>
                <label class="form-label" for="billStart">@Texts.Get("platform.billing.periodStart")</label>
                <input id="billStart" class="form-control" type="date" @bind="periodStart" />
                <FieldError Field="periodStart" Errors="errors" />
            </div>
            <div>
                <label class="form-label" for="billEnd">@Texts.Get("platform.billing.periodEnd")</label>
                <input id="billEnd" class="form-control" type="date" @bind="periodEnd" />
                <FieldError Field="periodEnd" Errors="errors" />
            </div>
            <div>
                <label class="form-label" for="billAmount">@Texts.Get("platform.billing.amountRequired")</label>
                <input id="billAmount" class="form-control" type="number" min="0" step="0.01" @bind="amount" />
                <FieldError Field="amount" Errors="errors" />
            </div>
            <div>
                <label class="form-label" for="billCurrency">@Texts.Get("platform.billing.currency")</label>
                <input id="billCurrency" class="form-control" maxlength="3" @bind="currency" />
                <FieldError Field="currency" Errors="errors" />
            </div>
            <div>
                <label class="form-label" for="billDue">@Texts.Get("platform.billing.due")</label>
                <input id="billDue" class="form-control" type="date" @bind="dueDate" />
            </div>
            <div>
                <label class="form-label" for="billRef">@Texts.Get("platform.billing.referenceLabel")</label>
                <input id="billRef" class="form-control" maxlength="100" @bind="reference" />
                <FieldError Field="reference" Errors="errors" />
            </div>
        </div>
        <div class="form-actions">
            <button type="submit" class="btn btn-primary" disabled="@(busy || amount <= 0)">@Texts.Get("platform.billing.createSubmit")</button>
        </div>
    </form>

    @if (items is not null && items.Any(i => i.Status == BillingStatusDto.Pending))
    {
        <div class="inline-form">
            <label class="form-label" for="billCancelReason">@Texts.Get("platform.billing.cancelReason")</label>
            <input id="billCancelReason" class="form-control" maxlength="500" @bind="cancelReason" @bind:event="oninput" />
        </div>
    }

    @if (items is not null && items.Count > 0)
    {
        <table class="table record-table">
            <thead><tr><th>@Texts.Get("platform.billing.period")</th><th>@Texts.Get("platform.billing.amount")</th><th>@Texts.Get("platform.billing.due")</th><th>@Texts.Get("platform.billing.reference")</th><th>@Texts.Get("common.field.status")</th><th></th></tr></thead>
            <tbody>
                @foreach (var item in items)
                {
                    <tr>
                        <td data-label="@Texts.Get("platform.billing.period")" class="primary">@item.PeriodStart.ToString("dd.MM.yyyy") – @item.PeriodEnd.ToString("dd.MM.yyyy")</td>
                        <td data-label="@Texts.Get("platform.billing.amount")">@item.Amount.ToString("N2") @item.Currency</td>
                        <td data-label="@Texts.Get("platform.billing.due")">@(item.DueDate?.ToString("dd.MM.yyyy") ?? "—")</td>
                        <td data-label="@Texts.Get("platform.billing.reference")">@(item.Reference ?? "—")</td>
                        <td data-label="@Texts.Get("common.field.status")">
                            <span class="badge @StateClass(item)">@PlatformLabels.BillingStatusOf(item)</span>
                        </td>
                        <td class="actions">
                            @if (item.Status == BillingStatusDto.Pending)
                            {
                                <button type="button" class="btn btn-tonal btn-sm" disabled="@busy" @onclick="() => PaidAsync(item.Id)">@Texts.Get("platform.billing.markPaid")</button>
                                <button type="button" class="btn btn-outline-danger btn-sm" disabled="@(busy || string.IsNullOrWhiteSpace(cancelReason))" @onclick="() => CancelAsync(item.Id)">@Texts.Get("common.cancel")</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

@code {
    [Parameter, EditorRequired] public Guid TenantId { get; set; }

    private IReadOnlyList<BillingRecordDto>? items;
    private DateTime periodStart = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime periodEnd = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).AddMonths(1).AddDays(-1);
    private DateTime? dueDate;
    private decimal amount;
    private string currency = "TRY";
    private string reference = string.Empty;
    private string cancelReason = string.Empty;
    private IReadOnlyDictionary<string, string[]>? errors;
    private string? notice;
    private bool failed;
    private bool busy;

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        var result = await Api.GetAsync<List<BillingRecordDto>>($"/api/platform/billing?tenantId={TenantId}");
        items = result.Value;
    }

    private async Task CreateAsync()
    {
        busy = true;
        var request = new CreateBillingRequest(
            DateOnly.FromDateTime(periodStart), DateOnly.FromDateTime(periodEnd), amount, currency,
            dueDate is { } due ? DateOnly.FromDateTime(due) : null, reference);
        var result = await Api.PostAsync<BillingRecordDto>($"/api/platform/tenants/{TenantId}/billing", request);
        busy = false;
        errors = result.FieldErrors;
        if (!result.IsSuccess)
        {
            (notice, failed) = (result.FieldErrors.Count > 0 ? null : result.Error, true);
            return;
        }

        (notice, failed, amount, reference) = (Texts.Get("platform.billing.created"), false, 0m, string.Empty);
        await LoadAsync();
    }

    private async Task PaidAsync(Guid id)
    {
        busy = true;
        var result = await Api.PostAsync<BillingRecordDto>($"/api/platform/billing/{id}/paid", new MarkBillingPaidRequest());
        busy = false;
        (notice, failed) = result.IsSuccess ? (Texts.Get("platform.billing.paid"), false) : (result.Error, true);
        await LoadAsync();
    }

    private async Task CancelAsync(Guid id)
    {
        busy = true;
        var result = await Api.PostAsync<BillingRecordDto>($"/api/platform/billing/{id}/cancel", new CancelBillingRequest(cancelReason));
        busy = false;
        (notice, failed) = result.IsSuccess ? (Texts.Get("platform.billing.cancelled"), false) : (result.Error, true);
        if (result.IsSuccess)
        {
            cancelReason = string.Empty;
        }

        await LoadAsync();
    }

    private static string StateClass(BillingRecordDto item) => item.Status == BillingStatusDto.Paid ? "user-active" : "user-disabled";
}
