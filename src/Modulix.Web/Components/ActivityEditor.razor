@* Aktivite ekleme/düzenleme formu; Aktiviteler sayfası, firma ve Lead detay sayfaları (çekmecede) kullanır. Durum, tamamlanma ve
   sorumlu değişikliği buradan yapılmaz: bunlar ayrı eylemlerdir (ActivityActions). Yeni kayıtta "geçmişte tamamlandı" işaretlenirse
   geçmiş tarihli bir etkileşim kaydı açılır. Saatler firmanın saat dilimindedir; tüm gün etkinliği yalnızca takvim günüdür.
   Alanlar firmanın form düzenine (ADR-0021) göre bölümlere yerleşir; çekmecede bölümler çizgiyle ayrılır. *@
@inject ApiClient Api
@inject SessionState Session
@inject FormLayouts Layouts

<form class="record-form sectioned" novalidate @onsubmit="SaveAsync" @onsubmit:preventDefault @oninput="() => dirty = true">
    <div class="form-toolbar">
        <div>
            <h2>@Texts.Get(Activity is null ? "crm.activities.new" : "crm.activities.edit")</h2>
        </div>
        <div class="form-toolbar-actions">
            <UnsavedChanges IsDirty="() => dirty" />
            <button type="button" class="btn btn-outline-secondary" @onclick="Cancelled">@Texts.Get("common.cancel")</button>
            <button type="submit" class="btn btn-primary" disabled="@(busy || layout is null)">@Texts.Get("common.save")</button>
        </div>
    </div>

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }
    @if (layoutError is not null)
    {
        <div class="alert alert-danger" role="alert">@layoutError</div>
    }

    <LayoutForm Layout="layout" Shows="Shows" CustomFields="CustomFields" CustomValues="form.Custom" Errors="errors" TabsLabel="@Texts.Get("crm.act.form.sections")">
        <Field Context="f">
            @switch (f.Key)
            {
                case "subject":
                    <label class="@f.LabelClass()" for="subject">@f.Label</label>
                    <input id="subject" class="form-control" maxlength="@CrmLimits.TextMaxLength" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.Subject" />
                    <FieldError Field="subject" Errors="errors" />
                    break;
                case "type":
                    <label class="@f.LabelClass()" for="type">@f.Label</label>
                    <select id="type" class="form-select" @bind="form.Type">
                        @foreach (var type in Lookups.Choices(CrmLists.ActivityType, source?.Type))
                        {
                            <option value="@type.Key">@type.Label</option>
                        }
                    </select>
                    <FieldError Field="type" Errors="errors" />
                    break;
                case "priority":
                    <label class="@f.LabelClass()" for="priority">@f.Label</label>
                    <select id="priority" class="form-select" @bind="form.Priority">
                        @foreach (var priority in new[] { ActivityPriority.Low, ActivityPriority.Normal, ActivityPriority.High, ActivityPriority.Urgent })
                        {
                            <option value="@priority">@ActivityLabels.Priority(priority)</option>
                        }
                    </select>
                    <FieldError Field="priority" Errors="errors" />
                    break;
                case "dueAt":
                    <label class="@f.LabelClass()" for="dueAt">@f.Label</label>
                    <input id="dueAt" class="form-control" type="datetime-local" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.DueAt" />
                    <FieldError Field="dueAt" Errors="errors" />
                    break;
                case "isAllDay":
                    <div class="form-check-row form-switch">
                        <input id="allday" class="form-check-input" type="checkbox" role="switch" @bind="form.IsAllDay" />
                        <label class="form-check-label" for="allday">@f.Label</label>
                    </div>
                    break;
                case "startAt":
                    @if (form.IsAllDay)
                    {
                        <label class="@f.LabelClass()" for="startDate">@Texts.Get("crm.act.startDay")</label>
                        <input id="startDate" class="form-control" type="date" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.StartDate" />
                        <FieldError Field="startDate" Errors="errors" />
                    }
                    else
                    {
                        <label class="@f.LabelClass()" for="startAt">@Texts.Get("crm.act.startBlock")</label>
                        <input id="startAt" class="form-control" type="datetime-local" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.StartAt" />
                        <FieldError Field="startAt" Errors="errors" />
                    }
                    <FieldError Field="timeZone" Errors="errors" />
                    break;
                case "endAt":
                    @if (form.IsAllDay)
                    {
                        <label class="@f.LabelClass()" for="endDate">@Texts.Get("crm.act.endDay")</label>
                        <input id="endDate" class="form-control" type="date" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.EndDate" />
                        <FieldError Field="endDate" Errors="errors" />
                    }
                    else
                    {
                        <label class="@f.LabelClass()" for="endAt">@Texts.Get("crm.act.endAt")</label>
                        <input id="endAt" class="form-control" type="datetime-local" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.EndAt" />
                        <FieldError Field="endAt" Errors="errors" />
                    }
                    break;
                case "estimatedMinutes":
                    <label class="@f.LabelClass()" for="estimate">@f.Label</label>
                    <input id="estimate" class="form-control" type="number" min="1" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.EstimatedMinutes" />
                    <FieldError Field="estimatedMinutes" Errors="errors" />
                    break;
                case "ownerId":
                    <label class="@f.LabelClass()" for="ownerId">@f.Label</label>
                    @if (Activity is null)
                    {
                        <LookupPicker Id="ownerId" LookupKey="crm.activity.owner" @bind-Value="form.OwnerId" Placeholder="@Texts.Get("common.me")" Invalid="@(errors?.ContainsKey("ownerId") == true)" />
                    }
                    else
                    {
                        <input id="ownerId" class="form-control" value="@Lookups.MemberName(Activity.OwnerId)" disabled />
                        <small class="text-muted">@Texts.Get("crm.act.ownerHint")</small>
                    }
                    <FieldError Field="ownerId" Errors="errors" />
                    break;
                case "companyId":
                    <label class="@f.LabelClass()" for="companyId">@f.Label</label>
                    <LookupPicker Id="companyId" LookupKey="crm.activity.company" @bind-Value="form.CompanyId" Required="f.Required" Placeholder="—" Invalid="@(errors?.ContainsKey("companyId") == true)" />
                    <FieldError Field="companyId" Errors="errors" />
                    break;
                case "contactId":
                    <label class="@f.LabelClass()" for="contactId">@f.Label</label>
                    <LookupPicker Id="contactId" LookupKey="crm.activity.contact" @bind-Value="form.ContactId" ParentId="form.CompanyId" Required="f.Required" Placeholder="—" Invalid="@(errors?.ContainsKey("contactId") == true)" />
                    <FieldError Field="contactId" Errors="errors" />
                    break;
                case "opportunityId":
                    <label class="@f.LabelClass()" for="opportunityId">@f.Label</label>
                    <LookupPicker Id="opportunityId" LookupKey="crm.activity.opportunity" @bind-Value="form.OpportunityId" ParentId="form.CompanyId" Required="f.Required" Placeholder="—" Invalid="@(errors?.ContainsKey("opportunityId") == true)" />
                    <FieldError Field="opportunityId" Errors="errors" />
                    break;
                case "location":
                    <label class="@f.LabelClass()" for="location">@f.Label</label>
                    <div class="input-icon">
                        <AppIcon Name="map-pin" Size="16" />
                        <input id="location" class="form-control" maxlength="300" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.Location" />
                    </div>
                    <FieldError Field="location" Errors="errors" />
                    break;
                case "onlineMeetingUrl":
                    <label class="@f.LabelClass()" for="online">@f.Label</label>
                    <div class="input-icon">
                        <AppIcon Name="globe" Size="16" />
                        <input id="online" class="form-control" maxlength="500" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.OnlineMeetingUrl" />
                    </div>
                    <FieldError Field="onlineMeetingUrl" Errors="errors" />
                    break;
                case "isPrivate":
                    <div class="form-check-row form-switch">
                        <input id="private" class="form-check-input" type="checkbox" role="switch" @bind="form.IsPrivate" />
                        <label class="form-check-label" for="private">@Texts.Get("crm.act.private")</label>
                    </div>
                    break;
                case "logAsDone":
                    <div class="form-check-row form-switch">
                        <input id="completed" class="form-check-input" type="checkbox" role="switch" @bind="form.LogAsDone" />
                        <label class="form-check-label" for="completed">@Texts.Get("crm.act.logAsDone")</label>
                    </div>
                    @if (form.LogAsDone)
                    {
                        <div class="form-grid mt-2">
                            <div class="span-6">
                                <label class="form-label" for="doneAt">@Texts.Get("crm.act.doneAt")</label>
                                <input id="doneAt" class="form-control" type="datetime-local" @bind="form.DoneAt" />
                                <FieldError Field="completedAt" Errors="errors" />
                            </div>
                            @if (form.Type is ActivityType.Call or ActivityType.Meeting or ActivityType.Visit)
                            {
                                <div class="span-6">
                                    <label class="form-label" for="outcome">@Texts.Get("crm.act.outcome")</label>
                                    <select id="outcome" class="form-select" @bind="form.Outcome">
                                        <option value="@ActivityOutcome.Reached">@CrmText.ActivityOutcomeName(ActivityOutcome.Reached)</option>
                                        <option value="@ActivityOutcome.NoAnswer">@CrmText.ActivityOutcomeName(ActivityOutcome.NoAnswer)</option>
                                    </select>
                                    <small class="text-muted">@Texts.Get("crm.act.firstContactHint")</small>
                                    <FieldError Field="outcome" Errors="errors" />
                                </div>
                            }
                            else if (form.Type == ActivityType.Email)
                            {
                                <input type="hidden" value="@ActivityOutcome.Sent" />
                            }
                        </div>
                    }
                    break;
                case "notes":
                    <label class="@f.LabelClass()" for="notes">@f.Label</label>
                    <textarea id="notes" class="form-control" rows="3" maxlength="@CrmLimits.NotesMaxLength" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.Notes"></textarea>
                    <FieldError Field="notes" Errors="errors" />
                    break;
            }
        </Field>
    </LayoutForm>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary" disabled="@(busy || layout is null)">@Texts.Get("common.save")</button>
        <button type="button" class="btn btn-outline-secondary" @onclick="Cancelled">@Texts.Get("common.cancel")</button>
        @if (Activity is not null)
        {
            <button type="button" class="btn btn-outline-danger ms-auto" disabled="@busy" @onclick="DeleteAsync">@Texts.Get("common.delete")</button>
        }
    </div>
</form>

@code {
    private bool dirty;
    private FormLayoutDto? layout;
    private string? layoutError;

    /// <summary>Firmanın form düzeni (ADR-0021): bölüm, sekme, sıra, genişlik, zorunluluk. Yüklenemezse form kaydedilemez.</summary>
    protected override async Task OnInitializedAsync()
    {
        layout = await Layouts.ForAsync(CrmEntityKeys.Activity);
        layoutError = layout is null ? Texts.Get("common.form.loadFailed") : null;
    }

    // Firma sabitse (firma detayı) seçilmez; geçmişe kayıt yalnızca yeni aktivitede ve yazma izniyle.
    private bool Shows(FormFieldDto field) => field.Key switch
    {
        "companyId" => FixedCompanyId is null,
        "logAsDone" => Activity is null && Session.Can(CrmAccess.ActivitiesWrite),
        _ => true,
    };

    private const string Url = "/api/crm/activities";

    private ActivityForm form = new();
    private ActivityDto? source;
    private bool initialized;
    private IReadOnlyDictionary<string, string[]>? errors;
    private string? message;
    private bool busy;

    /// <summary>Düzenlenecek aktivite; null ise yeni aktivite.</summary>
    [Parameter] public ActivityDto? Activity { get; set; }

    /// <summary>Verilirse firma seçilemez (firma detay sayfası).</summary>
    [Parameter] public Guid? FixedCompanyId { get; set; }

    /// <summary>Verilirse aktivite bu Lead'e bağlanır (Lead detay sayfası).</summary>
    [Parameter] public Guid? FixedLeadId { get; set; }

    /// <summary>Verilirse yeni aktivite bu fırsata bağlanır (fırsat sayfası); firma da fırsatın firmasıdır (<see cref="FixedCompanyId"/> ile verilir).</summary>
    [Parameter] public Guid? FixedOpportunityId { get; set; }

    /// <summary>Takvimden hızlı oluşturmada seçilen gün (yeni aktivite için başlangıç).</summary>
    [Parameter] public DateOnly? InitialDay { get; set; }

    [Parameter, EditorRequired] public CrmLookups Lookups { get; set; } = default!;

    private IReadOnlyList<CustomFieldDto> CustomFields => [.. Lookups.FieldsOf(CrmEntityKeys.Activity)];

    [Parameter] public EventCallback<ActivityDto> Saved { get; set; }

    [Parameter] public EventCallback Deleted { get; set; }

    [Parameter] public EventCallback Cancelled { get; set; }

    protected override void OnParametersSet()
    {
        if (initialized && ReferenceEquals(source, Activity))
        {
            return;
        }

        initialized = true;
        source = Activity;
        form = Activity is { } a
            ? new ActivityForm
            {
                Id = a.Id, Version = a.Version, Type = a.Type, Subject = a.Subject, Priority = a.Priority,
                DueAt = a.DueAt is { } due ? Regional.ToTenant(due).DateTime : null,
                StartAt = a.StartAt is { } start ? Regional.ToTenant(start).DateTime : null,
                EndAt = a.EndAt is { } end ? Regional.ToTenant(end).DateTime : null,
                IsAllDay = a.IsAllDay, StartDate = a.StartDate?.ToDateTime(TimeOnly.MinValue), EndDate = a.EndDate?.ToDateTime(TimeOnly.MinValue),
                Location = a.Location, OnlineMeetingUrl = a.OnlineMeetingUrl, IsPrivate = a.IsPrivate, EstimatedMinutes = a.EstimatedMinutes,
                ActualMinutes = a.ActualMinutes, CompanyId = a.CompanyId, ContactId = a.ContactId,
                OpportunityId = a.OpportunityId, OwnerId = a.OwnerId, Notes = a.Notes, LeadId = a.LeadId, Outcome = a.Outcome,
                Custom = a.Custom?.DeepClone().AsObject() ?? [],
            }
            : new ActivityForm
            {
                CompanyId = FixedCompanyId, LeadId = FixedLeadId, OpportunityId = FixedOpportunityId, Type = Lookups.DefaultOf(CrmLists.ActivityType) ?? ActivityType.Task,
                StartAt = InitialDay is { } day ? day.ToDateTime(new TimeOnly(9, 0)) : null,
                EndAt = InitialDay is { } day2 ? day2.ToDateTime(new TimeOnly(10, 0)) : null,
                DoneAt = Regional.Now.DateTime,
            };
        errors = null;
        message = null;
    }

    private async Task SaveAsync()
    {
        busy = true;

        // Geçmiş tarihli kayıt yalnızca oluştururken: tamamlanma zamanı ve sonuç verilir (sunucu durumu tamamlanmış yapar).
        var done = Activity is null && form.LogAsDone;
        DateTimeOffset? completedAt = done ? Regional.FromTenant(form.DoneAt ?? Regional.Now.DateTime) : null;
        var outcome = !done ? null : form.Type == ActivityType.Email ? ActivityOutcome.Sent : form.Type == ActivityType.Task || form.Type == ActivityType.Note ? null : form.Outcome ?? ActivityOutcome.Reached;
        var timed = !form.IsAllDay && form.StartAt is not null;
        var request = new SaveActivityRequest(
            form.Subject, form.Type, form.DueAt is { } due ? Regional.FromTenant(due) : null, completedAt, form.CompanyId, form.ContactId,
            form.OpportunityId, form.Notes, form.Version, form.OwnerId, Custom: CustomFieldText.ForSave(CustomFields, form.Custom),
            LeadId: form.LeadId ?? FixedLeadId, Outcome: outcome, Priority: form.Priority,
            StartAt: timed ? Regional.FromTenant(form.StartAt!.Value) : null,
            EndAt: timed && form.EndAt is { } end ? Regional.FromTenant(end) : null,
            IsAllDay: form.IsAllDay,
            StartDate: form.IsAllDay && form.StartDate is { } sd ? DateOnly.FromDateTime(sd) : null,
            EndDate: form.IsAllDay && form.EndDate is { } ed ? DateOnly.FromDateTime(ed) : null,
            TimeZone: timed ? Regional.Zone.Id : null,
            Location: string.IsNullOrWhiteSpace(form.Location) ? null : form.Location,
            OnlineMeetingUrl: string.IsNullOrWhiteSpace(form.OnlineMeetingUrl) ? null : form.OnlineMeetingUrl,
            IsPrivate: form.IsPrivate, EstimatedMinutes: form.EstimatedMinutes, ActualMinutes: form.ActualMinutes);
        var result = form.Id is { } id
            ? await Api.PutAsync<ActivityDto>($"{Url}/{id}", request)
            : await Api.PostAsync<ActivityDto>(Url, request);
        busy = false;

        if (result.IsSuccess)
        {
            dirty = false;
            await Saved.InvokeAsync(result.Value);
            return;
        }

        errors = result.FieldErrors;
        message = result.Error;
    }

    private async Task DeleteAsync()
    {
        busy = true;
        var result = await Api.DeleteAsync($"{Url}/{form.Id}?version={form.Version}");
        busy = false;

        if (result.IsSuccess)
        {
            dirty = false;
            await Deleted.InvokeAsync();
            return;
        }

        message = result.Error;
    }

    private sealed class ActivityForm
    {
        public System.Text.Json.Nodes.JsonObject Custom { get; set; } = [];

        public Guid? Id { get; init; }

        public long? Version { get; init; }

        public string Type { get; set; } = ActivityType.Task;

        public string Subject { get; set; } = string.Empty;

        public string Priority { get; set; } = ActivityPriority.Normal;

        public DateTime? DueAt { get; set; }

        public DateTime? StartAt { get; set; }

        public DateTime? EndAt { get; set; }

        public bool IsAllDay { get; set; }

        public DateTime? StartDate { get; set; }

        public DateTime? EndDate { get; set; }

        public string? Location { get; set; }

        public string? OnlineMeetingUrl { get; set; }

        public bool IsPrivate { get; set; }

        public int? EstimatedMinutes { get; set; }

        public int? ActualMinutes { get; set; }

        public bool LogAsDone { get; set; }

        public DateTime? DoneAt { get; set; }

        public Guid? CompanyId { get; set; }

        public Guid? ContactId { get; set; }

        public Guid? OpportunityId { get; set; }

        public Guid? LeadId { get; set; }

        public string? Outcome { get; set; }

        public Guid? OwnerId { get; set; }

        public string? Notes { get; set; }
    }
}
