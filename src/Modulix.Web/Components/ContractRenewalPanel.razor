@* Sözleşme dönemi, yenileme ve fesih (ADR-0022, dilim 8): bildirim tarihleri, otomatik uzatma durumu, yenileme taslağı, yenilememe kararı, fesih, hatırlatma geçmişi ve yenileme zinciri.
   Bir dönem için tek karar vardır. Otomatik uzatma yalnızca sözleşme "otomatik" yenilemeliyse ve firma ayarı açıksa çalışır; fiyat/ceza gibi finansal sonuç otomatik uygulanmaz.
   Hatırlatmalar sorumluya takip aktivitesi olarak açılır; müşteriye bildirim gitmez. *@
@inject ApiClient Api
@inject SessionState Session
@inject CrmLookups Lookups
@inject NavigationManager Navigation

<section class="detail-section" aria-labelledby="renewal-title">
    <div class="section-header">
        <h2 id="renewal-title">@Texts.Get("contracts.renewalPanel.title")</h2>
    </div>

    <Notice Text="@notice" Failed="@noticeFailed" />

    @if (loading)
    {
        <p class="text-muted" role="status">@Texts.Get("common.loading")</p>
    }
    else if (overview is null)
    {
        <p class="text-muted">@Texts.Get("contracts.renewalPanel.loadFailed")</p>
    }
    else
    {
        <dl class="detail-list">
            <div><dt>@Texts.Get("contracts.list.effectiveFilter")</dt><dd>@ContractLabels.Label(ContractLabels.Effectives, overview.EffectiveStatus)</dd></div>
            <div><dt>@Texts.Get("contracts.renewalPanel.periodEnd")</dt><dd>@(overview.IsIndefinite ? Texts.Get("contracts.indefinite") : ContractLabels.Date(overview.EndDate))@if (!overview.IsIndefinite && overview.DaysToEnd is { } toEnd) { <small class="text-muted"> · @RenewalLabels.Days(toEnd)</small> }</dd></div>
            <div>
                <dt>@Texts.Get("contracts.field.noticedeadline")</dt>
                <dd>
                    @ContractLabels.Date(overview.NoticeDeadline)
                    @if (overview.DaysToNotice is { } toNotice) { <small class="@(toNotice < 0 && overview.CurrentDecision is null ? "text-danger" : "text-muted")"> · @RenewalLabels.Days(toNotice)</small> }
                    @if (overview.NoticePeriodDays is { } noticeDays) { <small class="text-muted"> @Texts.Get("contracts.renewalPanel.noticeBefore", noticeDays)</small> }
                </dd>
            </div>
            <div><dt>@Texts.Get("contracts.field.renewalmode")</dt><dd>@ContractLabels.Label(ContractLabels.RenewalModes, overview.RenewalMode)@(overview.RenewalPeriodMonths is { } months ? " · " + Texts.Get("contracts.renewalPanel.months", months) : string.Empty)</dd></div>
            <div>
                <dt>@Texts.Get("contracts.renewalPanel.autoRenewal")</dt>
                <dd>@(overview.AutoRenewalBlockedReason is null ? Texts.Get("contracts.renewalPanel.autoRenewalReady") : overview.AutoRenewalBlockedReason)</dd>
            </div>
            <div><dt>@Texts.Get("contracts.renewalPanel.thresholds")</dt><dd>@string.Join(", ", overview.Thresholds.Select(t => Texts.Get("crm.sales.days", t)))</dd></div>
            @if (overview.TerminationDate is { } terminationDate)
            {
                <div><dt>@Texts.Get("contracts.renewalPanel.termination")</dt><dd>@ContractLabels.Date(terminationDate) · @overview.TerminationReason</dd></div>
            }
            @if (overview.CurrentDecision is { } current)
            {
                <div>
                    <dt>@Texts.Get("contracts.renewalPanel.currentDecision")</dt>
                    <dd>
                        <span class="badge stage-@RenewalLabels.Badge(current.Outcome)">@RenewalLabels.Label(RenewalLabels.Outcomes, current.Outcome)</span>
                        @if (current.Reason is not null) { <span> · @RenewalLabels.Label(RenewalLabels.Reasons, current.Reason)</span> }
                        @if (current.ResultContractId is { } resultId) { <span> · <a href="sozlesmeler/@resultId">@Texts.Get("contracts.renewals.openDraft")</a></span> }
                    </dd>
                </div>
            }
        </dl>

        @if (overview.EffectiveStatus == "Active" && (CanManage || CanTerminate))
        {
            <div class="header-actions">
                @if (CanManage && overview.CurrentDecision is null && !overview.IsIndefinite)
                {
                    <button type="button" class="btn btn-primary btn-sm" disabled="@busy" @onclick='() => Open("draft")'>@Texts.Get("contracts.renewalPanel.createDraft")</button>
                    <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@busy" @onclick='() => Open("decline")'>@Texts.Get("contracts.renewalPanel.decline")</button>
                }
                @if (CanTerminate && overview.TerminationDate is null)
                {
                    <button type="button" class="btn btn-outline-danger btn-sm" disabled="@busy" @onclick='() => Open("terminate")'>@Texts.Get("contracts.renewalPanel.terminate")</button>
                }
            </div>
        }

        @if (errors is { Count: > 0 })
        {
            <div class="alert alert-danger" role="alert"><ul class="mb-0">@foreach (var (_, messages) in errors) { foreach (var message in messages) { <li>@message</li> } }</ul></div>
        }

        @if (action == "draft")
        {
            <form class="record-form" novalidate @onsubmit="DraftAsync" @onsubmit:preventDefault>
                <h3>@Texts.Get("contracts.renewalPanel.draftTitle")</h3>
                <p class="small text-muted">
                    @Texts.Get("contracts.renewalPanel.draftIntro")
                </p>
                <div class="form-grid">
                    <div>
                        <label class="form-label" for="rn-start">@Texts.Get("contracts.renewalPanel.draftStart")</label>
                        <input id="rn-start" class="form-control" type="date" @bind="draftStart" />
                    </div>
                    <div>
                        <label class="form-label" for="rn-months">@Texts.Get("contracts.renewalPanel.draftMonths")</label>
                        <input id="rn-months" class="form-control" type="number" min="1" max="120" @bind="draftMonths" />
                    </div>
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn btn-primary" disabled="@busy">@Texts.Get("contracts.renewalPanel.createDraftSubmit")</button>
                    <button type="button" class="btn btn-link" @onclick="Close">@Texts.Get("common.dismiss")</button>
                </div>
            </form>
        }

        @if (action == "decline")
        {
            <form class="record-form" novalidate @onsubmit="DeclineAsync" @onsubmit:preventDefault>
                <h3>@Texts.Get("contracts.renewalPanel.declineTitle")</h3>
                <p class="small text-muted">@Texts.Get("contracts.renewalPanel.declineIntro")</p>
                <div class="form-grid">
                    <div>
                        <label class="form-label" for="dc-reason">@Texts.Get("contracts.renewalPanel.reasonRequired")</label>
                        <select id="dc-reason" class="form-select" @bind="declineReason">
                            <option value="">@Texts.Get("common.choose")</option>
                            @foreach (var r in RenewalLabels.Reasons) { <option value="@r.Key">@r.Label</option> }
                        </select>
                    </div>
                    <div class="wide">
                        <label class="form-label" for="dc-note">@Texts.Get("contracts.field.notes")</label>
                        <input id="dc-note" class="form-control" maxlength="1000" @bind="declineNote" />
                    </div>
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn btn-danger" disabled="@busy">@Texts.Get("contracts.renewalPanel.saveDecision")</button>
                    <button type="button" class="btn btn-link" @onclick="Close">@Texts.Get("common.dismiss")</button>
                </div>
            </form>
        }

        @if (action == "terminate")
        {
            <form class="record-form" novalidate @onsubmit="TerminateAsync" @onsubmit:preventDefault>
                <h3>@Texts.Get("contracts.renewalPanel.terminateTitle")</h3>
                <p class="small text-muted">
                    @Texts.Get("contracts.renewalPanel.terminateIntro")
                </p>
                <div class="form-grid">
                    <div>
                        <label class="form-label" for="tm-date">@Texts.Get("contracts.renewalPanel.terminationDateRequired")</label>
                        <input id="tm-date" class="form-control" type="date" @bind="terminateDate" />
                    </div>
                    <div class="wide">
                        <label class="form-label" for="tm-reason">@Texts.Get("crm.act.reasonRequired")</label>
                        <input id="tm-reason" class="form-control" maxlength="500" @bind="terminateReason" />
                    </div>
                    @if (needsShortNoticeConfirmation)
                    {
                        <div class="wide form-check">
                            <input id="tm-short" class="form-check-input" type="checkbox" @bind="confirmShortNotice" />
                            <label class="form-check-label" for="tm-short">@Texts.Get("contracts.renewalPanel.confirmShortNotice")</label>
                        </div>
                    }
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn btn-danger" disabled="@busy">@Texts.Get("contracts.renewalPanel.terminate")</button>
                    <button type="button" class="btn btn-link" @onclick="Close">@Texts.Get("common.dismiss")</button>
                </div>
            </form>
        }

        <h3>@Texts.Get("contracts.renewalPanel.history")</h3>
        @if (overview.History.Count == 0)
        {
            <p class="text-muted">@Texts.Get("contracts.renewalPanel.historyEmpty")</p>
        }
        else
        {
            <table class="table record-table">
                <caption class="visually-hidden">@Texts.Get("contracts.renewalPanel.historyCaption")</caption>
                <thead><tr><th scope="col">@Texts.Get("contracts.renewalPanel.periodEnd")</th><th scope="col">@Texts.Get("contracts.renewals.col.decision")</th><th scope="col">@Texts.Get("contracts.renewalPanel.col.newEnd")</th><th scope="col">@Texts.Get("contracts.renewalPanel.col.source")</th><th scope="col">@Texts.Get("contracts.dashboard.col.date")</th></tr></thead>
                <tbody>
                    @foreach (var d in overview.History)
                    {
                        <tr>
                            <td data-label="@Texts.Get("contracts.renewalPanel.periodEnd")" class="primary">@ContractLabels.Date(d.PeriodEnd)</td>
                            <td data-label="@Texts.Get("contracts.renewals.col.decision")">
                                <span class="badge stage-@RenewalLabels.Badge(d.Outcome)">@RenewalLabels.Label(RenewalLabels.Outcomes, d.Outcome)</span>
                                @if (d.Reason is not null) { <div class="small">@RenewalLabels.Label(RenewalLabels.Reasons, d.Reason)</div> }
                                @if (d.Note is not null) { <div class="small text-muted">@d.Note</div> }
                            </td>
                            <td data-label="@Texts.Get("contracts.renewalPanel.col.newEnd")">
                                @if (d.NewEndDate is { } newEnd) { <span>@ContractLabels.Date(newEnd)</span> }
                                @if (d.ResultContractId is { } resultId) { <a href="sozlesmeler/@resultId">@Texts.Get("contracts.renewals.openDraft")</a> }
                                @if (d.NewEndDate is null && d.ResultContractId is null) { <span class="text-muted">—</span> }
                            </td>
                            <td data-label="@Texts.Get("contracts.renewalPanel.col.source")">@RenewalLabels.Label(RenewalLabels.Sources, d.Source)@(d.DecidedBy is { } by ? " · " + Lookups.MemberName(by) : string.Empty)</td>
                            <td data-label="@Texts.Get("contracts.dashboard.col.date")">@d.At.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <h3>@Texts.Get("contracts.renewalPanel.reminders")</h3>
        @if (overview.Reminders.Count == 0)
        {
            <p class="text-muted">@Texts.Get("contracts.renewalPanel.remindersEmpty")</p>
        }
        else
        {
            <table class="table record-table">
                <caption class="visually-hidden">@Texts.Get("contracts.renewalPanel.remindersCaption")</caption>
                <thead><tr><th scope="col">@Texts.Get("contracts.commitments.col.period")</th><th scope="col">@Texts.Get("contracts.field.type")</th><th scope="col">@Texts.Get("contracts.renewalPanel.col.threshold")</th><th scope="col">@Texts.Get("common.field.status")</th><th scope="col">@Texts.Get("contracts.dashboard.col.date")</th></tr></thead>
                <tbody>
                    @foreach (var r in overview.Reminders.OrderByDescending(x => x.PeriodKey).ThenByDescending(x => x.At))
                    {
                        <tr>
                            <td data-label="@Texts.Get("contracts.commitments.col.period")" class="primary">@ContractLabels.Date(r.PeriodKey)</td>
                            <td data-label="@Texts.Get("contracts.field.type")">@RenewalLabels.Label(RenewalLabels.ReminderKinds, r.Kind)</td>
                            <td data-label="@Texts.Get("contracts.renewalPanel.col.threshold")">@(r.ThresholdDays > 0 ? Texts.Get("crm.sales.days", r.ThresholdDays) : "—")</td>
                            <td data-label="@Texts.Get("common.field.status")">
                                @RenewalLabels.Label(RenewalLabels.ReminderStatuses, r.Status)
                                @if (r.Note is not null) { <div class="small text-muted">@r.Note</div> }
                            </td>
                            <td data-label="@Texts.Get("contracts.dashboard.col.date")">@r.At.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        @if (chain.Count > 1)
        {
            <h3>@Texts.Get("contracts.renewalPanel.chain")</h3>
            <ol class="chain-list">
                @foreach (var item in chain)
                {
                    <li>
                        <span class="badge stage-@(item.Relation == "Current" ? "open" : "onhold")">@RenewalLabels.Label(RenewalLabels.Relations, item.Relation)</span>
                        @if (item.Relation == "Current") { <strong>@item.Title</strong> } else { <a href="sozlesmeler/@item.Id">@item.Title</a> }
                        <small class="text-muted">@item.Number · @ContractLabels.Date(item.StartDate) – @ContractLabels.Date(item.EndDate) · @ContractLabels.Label(ContractLabels.Effectives, item.EffectiveStatus)</small>
                    </li>
                }
            </ol>
        }
    }
</section>

@code {
    private RenewalOverviewDto? overview;
    private List<ChainItemDto> chain = [];
    private IReadOnlyDictionary<string, string[]>? errors;
    private string? notice;
    private bool noticeFailed;
    private bool busy;
    private bool loading = true;
    private string? loadedFor;
    private string? action;
    private DateTime? draftStart;
    private int? draftMonths;
    private string declineReason = string.Empty;
    private string? declineNote;
    private DateTime? terminateDate;
    private string terminateReason = string.Empty;
    private bool confirmShortNotice;
    private bool needsShortNoticeConfirmation;

    [Parameter, EditorRequired] public ContractDto Contract { get; set; } = null!;

    [Parameter] public EventCallback Changed { get; set; }

    private bool CanManage => Session.Can(ContractsAccess.RenewalsManage) && Session.Can(ContractsAccess.ContractsWrite);

    private bool CanTerminate => Session.Can(ContractsAccess.ContractsTerminate);

    protected override async Task OnParametersSetAsync()
    {
        var key = $"{Contract.Id}:{Contract.Version}";
        if (key == loadedFor) { return; }
        if (loadedFor?.StartsWith($"{Contract.Id}:", StringComparison.Ordinal) != true)
        {
            // Başka sözleşmeye geçildi: açık form ve iletiler taşınmaz.
            action = null;
            errors = null;
            notice = null;
            declineReason = string.Empty;
            declineNote = null;
            terminateReason = string.Empty;
        }

        loadedFor = key;
        await Lookups.LoadAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        var result = await Api.GetAsync<RenewalOverviewDto>($"/api/contracts/contracts/{Contract.Id}/renewal");
        overview = result.Value;
        chain = (await Api.GetAsync<List<ChainItemDto>>($"/api/contracts/contracts/{Contract.Id}/chain")).Value ?? [];
        loading = false;
        if (!result.IsSuccess) { Notify(result.Error, true); }
    }

    private void Open(string name)
    {
        action = name;
        errors = null;
        notice = null;
        needsShortNoticeConfirmation = false;
        confirmShortNotice = false;
        terminateDate ??= DateTime.Today;
    }

    private void Close()
    {
        action = null;
        errors = null;
    }

    private async Task DraftAsync()
    {
        if (busy) { return; }
        busy = true;
        var result = await Api.PostAsync<RenewalDraftResultDto>(
            $"/api/contracts/contracts/{Contract.Id}/renewal/draft",
            new RenewalDraftRequest(draftStart is { } start ? DateOnly.FromDateTime(start) : null, draftMonths));
        busy = false;
        if (!result.IsSuccess)
        {
            errors = result.FieldErrors;
            Notify(result.Error, true);
            return;
        }

        Navigation.NavigateTo($"sozlesmeler/{result.Value!.ContractId}");
    }

    private async Task DeclineAsync()
    {
        if (busy) { return; }
        busy = true;
        var result = await Api.PostAsync<RenewalOverviewDto>($"/api/contracts/contracts/{Contract.Id}/renewal/decline", new DeclineRenewalRequest(declineReason, Blank(declineNote)));
        busy = false;
        await AfterAsync(result, Texts.Get("contracts.renewalPanel.declined"));
    }

    private async Task TerminateAsync()
    {
        if (busy) { return; }
        busy = true;
        var result = await Api.PostAsync<RenewalOverviewDto>(
            $"/api/contracts/contracts/{Contract.Id}/terminate",
            new TerminateContractRequest(DateOnly.FromDateTime(terminateDate ?? DateTime.Today), terminateReason, confirmShortNotice));
        busy = false;
        if (!result.IsSuccess && result.Status == System.Net.HttpStatusCode.Conflict && result.Error?.Contains("bildirim süresinin", StringComparison.Ordinal) == true)
        {
            needsShortNoticeConfirmation = true;
        }

        await AfterAsync(result, terminateDate is { } d && DateOnly.FromDateTime(d) > DateOnly.FromDateTime(DateTime.Today) ? Texts.Get("contracts.renewalPanel.terminationScheduled") : Texts.Get("contracts.renewalPanel.terminated"));
    }

    private async Task AfterAsync(ApiResult<RenewalOverviewDto> result, string success)
    {
        if (!result.IsSuccess)
        {
            errors = result.FieldErrors;
            Notify(result.Error, true);
            return;
        }

        action = null;
        errors = null;
        declineReason = string.Empty;
        declineNote = null;
        terminateReason = string.Empty;
        Notify(success, false);
        await LoadAsync();
        await Changed.InvokeAsync();
    }

    private void Notify(string? text, bool failed)
    {
        notice = text;
        noticeFailed = failed;
    }

    private static string? Blank(string? text) => string.IsNullOrWhiteSpace(text) ? null : text.Trim();
}
