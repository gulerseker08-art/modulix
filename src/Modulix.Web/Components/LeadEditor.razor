@* Lead ekleme/düzenleme formu. Durum, sorumlu ve dönüşüm alanları burada değişmez: ilgili eylemler Lead detayındadır.
   Yeni Lead kaydedilmeden önce olası eşleşmeler gösterilir; aynı e-posta tek başına engel değildir, kullanıcı yine de kaydedebilir.
   Alanlar firmanın form düzenine (ADR-0021) göre bölüm kartlarına ve sekmelere yerleşir; her alanın girdisi burada tanımlıdır. *@
@inject ApiClient Api
@inject SessionState Session
@inject FormLayouts Layouts

<form class="record-form sectioned" novalidate @onsubmit="SaveAsync" @onsubmit:preventDefault @oninput="() => dirty = true">
    <div class="form-toolbar">
        <div>
            <h2>@Texts.Get(Lead is null ? "crm.leads.new" : "crm.lead.editor.card")</h2>
            @if (Lead is not null)
            {
                <p>@Lead.LeadNumber · @Lead.Subject</p>
            }
        </div>
        <div class="form-toolbar-actions">
            <UnsavedChanges IsDirty="() => dirty" />
            <button type="button" class="btn btn-outline-secondary" @onclick="Cancelled">@Texts.Get("common.cancel")</button>
            <button type="submit" class="btn btn-primary" disabled="@(busy || layout is null)">
                @if (busy)
                {
                    <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                }
                @Texts.Get(matches is { Count: > 0 } ? "crm.lead.editor.saveAnyway" : "common.save")
            </button>
        </div>
    </div>

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }
    @if (layoutError is not null)
    {
        <div class="alert alert-danger" role="alert">@layoutError</div>
    }

    <LayoutForm Layout="layout" Shows="Shows" CustomFields="CustomFields" CustomValues="form.Custom" Errors="errors" TabsLabel="@Texts.Get("crm.lead.editor.tabs")">
        <Field Context="f">
            @switch (f.Key)
            {
                case "subject":
                    <label class="@f.LabelClass()" for="lead-subject">@f.Label</label>
                    <input id="lead-subject" class="form-control" maxlength="200" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.Subject" />
                    <FieldError Field="subject" Errors="errors" />
                    break;
                case "priority":
                    <label class="@f.LabelClass()" for="lead-priority">@f.Label</label>
                    <select id="lead-priority" class="form-select" @bind="form.Priority">
                        @foreach (var priority in LeadPriority.All)
                        {
                            <option value="@priority">@CrmText.LeadPriorityName(priority)</option>
                        }
                    </select>
                    <FieldError Field="priority" Errors="errors" />
                    break;
                case "source":
                    <label class="@f.LabelClass()" for="lead-source">@f.Label</label>
                    <select id="lead-source" class="form-select" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.Source">
                        <option value="">—</option>
                        @foreach (var source in Lookups.Choices(CrmLeadLists.Source, form.Source))
                        {
                            <option value="@source.Key">@source.Label</option>
                        }
                    </select>
                    <FieldError Field="source" Errors="errors" />
                    break;
                case "sourceDetail":
                    <label class="@f.LabelClass()" for="lead-source-detail">@f.Label</label>
                    <input id="lead-source-detail" class="form-control" maxlength="200" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.SourceDetail" />
                    <FieldError Field="sourceDetail" Errors="errors" />
                    break;
                case "productInterest":
                    <label class="@f.LabelClass()" for="lead-product">@f.Label</label>
                    <input id="lead-product" class="form-control" maxlength="200" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.ProductInterest" />
                    <FieldError Field="productInterest" Errors="errors" />
                    break;
                case "serviceScope":
                    <label class="@f.LabelClass()" for="lead-service-scope">@f.Label</label>
                    <ActivityCodePicker Id="lead-service-scope" ActivitiesOnly="true" @bind-Selected="form.ServiceScope" />
                    <FieldError Field="serviceScope" Errors="errors" />
                    break;
                case "industry":
                    <label class="@f.LabelClass()" for="lead-industry">@f.Label</label>
                    <select id="lead-industry" class="form-select" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.Industry">
                        <option value="">@Texts.Get("crm.company.editor.industryPlaceholder")</option>
                        @foreach (var industry in IndustryChoices)
                        {
                            <option value="@industry.Code">@industry.Name</option>
                        }
                    </select>
                    @if (string.IsNullOrEmpty(form.Industry) && !string.IsNullOrWhiteSpace(Lead?.LegacyIndustry))
                    {
                        <small class="form-text text-muted">@Texts.Get("crm.company.editor.industryLegacy", Lead!.LegacyIndustry)</small>
                    }
                    <FieldError Field="industry" Errors="errors" />
                    break;
                case "firstName":
                    <label class="@f.LabelClass()" for="lead-first">@f.Label</label>
                    <input id="lead-first" class="form-control" maxlength="100" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.FirstName" />
                    <FieldError Field="firstName" Errors="errors" />
                    break;
                case "lastName":
                    <label class="@f.LabelClass()" for="lead-last">@f.Label</label>
                    <input id="lead-last" class="form-control" maxlength="100" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.LastName" />
                    <FieldError Field="lastName" Errors="errors" />
                    break;
                case "jobTitle":
                    <label class="@f.LabelClass()" for="lead-title">@f.Label</label>
                    <input id="lead-title" class="form-control" maxlength="100" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.JobTitle" />
                    <FieldError Field="jobTitle" Errors="errors" />
                    break;
                case "companyName":
                    <label class="@f.LabelClass()" for="lead-company">@f.Label</label>
                    <div class="input-icon">
                        <AppIcon Name="building" Size="16" />
                        <input id="lead-company" class="form-control" maxlength="200" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.CompanyName" />
                    </div>
                    <FieldError Field="companyName" Errors="errors" />
                    break;
                case "email":
                    <label class="@f.LabelClass()" for="lead-email">@f.Label</label>
                    <div class="input-icon">
                        <AppIcon Name="mail" Size="16" />
                        <input id="lead-email" class="form-control" type="email" maxlength="254" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.Email" />
                    </div>
                    <FieldError Field="email" Errors="errors" />
                    break;
                case "phone":
                    <label class="@f.LabelClass()" for="lead-phone">@f.Label</label>
                    <div class="input-icon">
                        <AppIcon Name="phone" Size="16" />
                        <input id="lead-phone" class="form-control" type="tel" maxlength="40" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.Phone" />
                    </div>
                    <FieldError Field="phone" Errors="errors" />
                    break;
                case "website":
                    <label class="@f.LabelClass()" for="lead-website">@f.Label</label>
                    <div class="input-icon">
                        <AppIcon Name="globe" Size="16" />
                        <input id="lead-website" class="form-control" maxlength="300" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.Website" />
                    </div>
                    <FieldError Field="website" Errors="errors" />
                    break;
                case "city":
                    <label class="@f.LabelClass()" for="lead-city">@f.Label</label>
                    <input id="lead-city" class="form-control" maxlength="100" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.City" />
                    <FieldError Field="city" Errors="errors" />
                    break;
                case "country":
                    <label class="@f.LabelClass()" for="lead-country">@f.Label</label>
                    <input id="lead-country" class="form-control" maxlength="2" placeholder="TR" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.Country" />
                    <FieldError Field="country" Errors="errors" />
                    break;
                case "ownerId":
                    <label class="@f.LabelClass()" for="lead-owner">@f.Label</label>
                    <LookupPicker Id="lead-owner" LookupKey="crm.lead.owner" @bind-Value="form.OwnerId" Placeholder="@Texts.Get("common.me")" Invalid="@(errors?.ContainsKey("ownerId") == true)" />
                    <FieldError Field="ownerId" Errors="errors" />
                    break;
                case "companyId":
                    <label class="@f.LabelClass()" for="lead-existing-company">@f.Label</label>
                    <LookupPicker Id="lead-existing-company" LookupKey="crm.lead.company" @bind-Value="form.CompanyId" Required="f.Required" Placeholder="—" Invalid="@(errors?.ContainsKey("companyId") == true)" />
                    <FieldError Field="companyId" Errors="errors" />
                    break;
                case "contactId":
                    <label class="@f.LabelClass()" for="lead-existing-contact">@f.Label</label>
                    <LookupPicker Id="lead-existing-contact" LookupKey="crm.lead.contact" @bind-Value="form.ContactId" ParentId="form.CompanyId" Required="f.Required" Placeholder="—" Invalid="@(errors?.ContainsKey("contactId") == true)" />
                    <FieldError Field="contactId" Errors="errors" />
                    break;
                case "estimatedBudget":
                    <label class="@f.LabelClass()" for="lead-budget">@f.Label</label>
                    <input id="lead-budget" class="form-control" type="number" step="0.01" min="0" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.EstimatedBudget" />
                    <small class="text-muted">@Texts.Get("crm.lead.editor.budgetHint")</small>
                    <FieldError Field="estimatedBudget" Errors="errors" />
                    break;
                case "currency":
                    <label class="@f.LabelClass()" for="lead-currency">@f.Label</label>
                    <input id="lead-currency" class="form-control" maxlength="3" @bind="form.Currency" />
                    <FieldError Field="currency" Errors="errors" />
                    break;
                case "targetPurchaseDate":
                    <label class="@f.LabelClass()" for="lead-target">@f.Label</label>
                    <input id="lead-target" class="form-control" type="date" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.TargetPurchaseDate" />
                    <FieldError Field="targetPurchaseDate" Errors="errors" />
                    break;
                case "needDescription":
                    <label class="@f.LabelClass()" for="lead-need">@f.Label</label>
                    <textarea id="lead-need" class="form-control" rows="2" maxlength="4000" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.NeedDescription"></textarea>
                    <FieldError Field="needDescription" Errors="errors" />
                    break;
                case "description":
                    <label class="@f.LabelClass()" for="lead-description">@f.Label</label>
                    <textarea id="lead-description" class="form-control" rows="3" maxlength="4000" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.Description"></textarea>
                    <FieldError Field="description" Errors="errors" />
                    break;
            }
        </Field>
    </LayoutForm>

    @if (matches is { Count: > 0 })
    {
        <div class="alert alert-warning" role="alert">
            <strong>@Texts.Get("crm.lead.editor.matches")</strong> — @Texts.Get("crm.lead.editor.matchesHelp")
            <ul class="item-list">
                @foreach (var match in matches)
                {
                    <li>
                        <a href="@MatchLink(match)">@match.Title</a>
                        <span class="text-muted">@MatchKind(match.Kind)@(match.Status is { } status ? $" · {CrmText.LeadStatusName(status)}" : null) · @string.Join(", ", match.Reasons)</span>
                    </li>
                }
            </ul>
        </div>
    }

    <div class="form-actions">
        <button type="submit" class="btn btn-primary" disabled="@(busy || layout is null)">@Texts.Get(matches is { Count: > 0 } ? "crm.lead.editor.saveAnyway" : "common.save")</button>
        <button type="button" class="btn btn-outline-secondary" @onclick="Cancelled">@Texts.Get("common.cancel")</button>
        @if (Lead is not null && Session.Can(CrmAccess.LeadsDelete) && Lead.Status != LeadStatus.Converted)
        {
            <button type="button" class="btn btn-outline-danger ms-auto" disabled="@busy" @onclick="DeleteAsync">@Texts.Get("common.delete")</button>
        }
    </div>
</form>

@code {
    private bool dirty;
    private FormLayoutDto? layout;
    private string? layoutError;

    /// <summary>Firmanın form düzeni (ADR-0021): bölüm, sekme, sıra, genişlik, zorunluluk. Yüklenemezse form kaydedilemez.</summary>
    protected override async Task OnInitializedAsync()
    {
        layout = await Layouts.ForAsync(CrmEntityKeys.Lead);
        layoutError = layout is null ? Texts.Get("common.form.loadFailed") : null;

        // Sektör listesi platform kataloğundan gelir (ADR-0043); yüklenemezse alan boş kalır, form yine kaydedilebilir.
        industries = (await Api.GetAsync<List<IndustryDto>>("/api/industries")).Value ?? [];
    }

    private IReadOnlyList<IndustryDto> industries = [];

    /// <summary>Etkin sektörler; kayıttaki sektör sonradan pasife alınmışsa o da listede kalır (seçili değer kaybolmaz).</summary>
    private IEnumerable<IndustryDto> IndustryChoices =>
        industries.Where(i => i.IsActive || i.Code == Lead?.Industry).OrderBy(i => i.Name, StringComparer.Create(System.Globalization.CultureInfo.GetCultureInfo("tr-TR"), true));

    // Sorumlu yalnızca yeni Lead açarken ve atama izniyle seçilir; sonrası Lead detayındaki atama eylemidir.
    private bool Shows(FormFieldDto field) => field.Key != "ownerId" || (Lead is null && Session.Can(CrmAccess.LeadsAssign));

    private const string Url = "/api/crm/leads";

    private LeadForm form = new();
    private LeadDto? source;
    private bool initialized;
    private bool matchesChecked;
    private IReadOnlyList<LeadMatchDto>? matches;
    private IReadOnlyDictionary<string, string[]>? errors;
    private string? message;
    private bool busy;

    /// <summary>Düzenlenecek Lead; null ise yeni Lead.</summary>
    [Parameter] public LeadDto? Lead { get; set; }

    [Parameter, EditorRequired] public CrmLookups Lookups { get; set; } = default!;

    [Parameter] public EventCallback<LeadDto> Saved { get; set; }

    [Parameter] public EventCallback Deleted { get; set; }

    [Parameter] public EventCallback Cancelled { get; set; }

    private IReadOnlyList<CustomFieldDto> CustomFields => [.. Lookups.FieldsOf(CrmEntityKeys.Lead)];

    protected override void OnParametersSet()
    {
        if (initialized && ReferenceEquals(source, Lead))
        {
            return;
        }

        initialized = true;
        source = Lead;
        form = Lead is { } l
            ? new LeadForm
            {
                Version = l.Version, Subject = l.Subject, Description = l.Description, Priority = l.Priority, FirstName = l.FirstName,
                LastName = l.LastName, CompanyName = l.CompanyName, Email = l.Email, Phone = l.Phone, JobTitle = l.JobTitle, Website = l.Website,
                Country = l.Country, City = l.City, CompanyId = l.CompanyId, ContactId = l.ContactId, ProductInterest = l.ProductInterest,
                ServiceScope = [.. l.ServiceScope ?? []], NeedDescription = l.NeedDescription, EstimatedBudget = l.EstimatedBudget, Currency = l.Currency,
                TargetPurchaseDate = l.TargetPurchaseDate, Industry = l.Industry, Source = l.Source, SourceDetail = l.SourceDetail,
                Referrer = l.Referrer, UtmSource = l.UtmSource, UtmMedium = l.UtmMedium, UtmCampaign = l.UtmCampaign,
                Custom = l.Custom?.DeepClone().AsObject() ?? [],
            }
            : new LeadForm { Source = "Manual" };
        errors = null;
        message = null;
        matches = null;
        matchesChecked = false;
    }

    private static string MatchLink(LeadMatchDto match) => match.Kind switch
    {
        "Lead" => $"crm/leadler/{match.Id}",
        "Company" => $"crm/firmalar/{match.Id}",
        _ => $"crm/kisiler/{match.Id}",
    };

    private static string MatchKind(string kind) => kind switch { "Lead" => Texts.Get("crm.leads.single"), "Company" => Texts.Get("crm.company.fallbackTitle"), _ => Texts.Get("crm.contact.fallbackTitle") };

    private async Task SaveAsync()
    {
        busy = true;
        message = null;

        // Yeni Lead'de önce olası eşleşmeler gösterilir; kullanıcı onaylayınca ("Yine de kaydet") kayıt yapılır.
        if (Lead is null && !matchesChecked)
        {
            matchesChecked = true;
            var query = $"?email={Uri.EscapeDataString(form.Email ?? string.Empty)}&phone={Uri.EscapeDataString(form.Phone ?? string.Empty)}"
                + $"&companyName={Uri.EscapeDataString(form.CompanyName ?? string.Empty)}&website={Uri.EscapeDataString(form.Website ?? string.Empty)}";
            var found = await Api.GetAsync<List<LeadMatchDto>>($"{Url}/duplicates{query}");
            if (found.Value is { Count: > 0 } list)
            {
                matches = list;
                busy = false;
                return;
            }
        }

        var request = new SaveLeadRequest(
            form.Subject, Clean(form.Description), form.Priority, Clean(form.FirstName), Clean(form.LastName), Clean(form.CompanyName),
            Clean(form.Email), Clean(form.Phone), Clean(form.JobTitle), Clean(form.Website), Clean(form.Country), Clean(form.City),
            form.CompanyId, form.ContactId, Clean(form.ProductInterest), Clean(form.NeedDescription), form.EstimatedBudget,
            string.IsNullOrWhiteSpace(form.Currency) ? "TRY" : form.Currency.Trim(), form.TargetPurchaseDate, Clean(form.Industry),
            Clean(form.Source), Clean(form.SourceDetail), Clean(form.Referrer), Clean(form.UtmSource), Clean(form.UtmMedium),
            Clean(form.UtmCampaign), Lead is null ? form.OwnerId : null, form.Version, CustomFieldText.ForSave(CustomFields, form.Custom), form.ServiceScope);
        var result = Lead is { } existing
            ? await Api.PutAsync<LeadDto>($"{Url}/{existing.Id}", request)
            : await Api.PostAsync<LeadDto>(Url, request);
        busy = false;

        if (result.IsSuccess)
        {
            dirty = false;
            await Saved.InvokeAsync(result.Value);
            return;
        }

        errors = result.FieldErrors;
        message = result.Error;
    }

    private async Task DeleteAsync()
    {
        busy = true;
        var result = await Api.DeleteAsync($"{Url}/{Lead!.Id}?version={Lead.Version}");
        busy = false;

        if (result.IsSuccess)
        {
            dirty = false;
            await Deleted.InvokeAsync();
            return;
        }

        message = result.Error;
    }

    private static string? Clean(string? text) => string.IsNullOrWhiteSpace(text) ? null : text.Trim();

    private sealed class LeadForm
    {
        public System.Text.Json.Nodes.JsonObject Custom { get; set; } = [];

        public long? Version { get; init; }

        public string Subject { get; set; } = string.Empty;

        public string? Description { get; set; }

        public string Priority { get; set; } = LeadPriority.Normal;

        public string? FirstName { get; set; }

        public string? LastName { get; set; }

        public string? CompanyName { get; set; }

        public string? Email { get; set; }

        public string? Phone { get; set; }

        public string? JobTitle { get; set; }

        public string? Website { get; set; }

        public string? Country { get; set; }

        public string? City { get; set; }

        public Guid? CompanyId { get; set; }

        public Guid? ContactId { get; set; }

        public string? ProductInterest { get; set; }

        public List<string> ServiceScope { get; set; } = [];

        public string? NeedDescription { get; set; }

        public decimal? EstimatedBudget { get; set; }

        public string Currency { get; set; } = "TRY";

        public DateOnly? TargetPurchaseDate { get; set; }

        public string? Industry { get; set; }

        public string? Source { get; set; }

        public string? SourceDetail { get; set; }

        public string? Referrer { get; set; }

        public string? UtmSource { get; set; }

        public string? UtmMedium { get; set; }

        public string? UtmCampaign { get; set; }

        public Guid? OwnerId { get; set; }
    }
}
