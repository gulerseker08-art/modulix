@* Sözleşme imza paneli (ADR-0022, dilim 6): imza isteği başlatma, imzacı durumları, manuel imza kaydı (imzalı belge yükleme ve doğrulama), simülasyon ve olay günlüğü.
   Kimseye e-posta ya da imza isteği gitmez; hatırlatma yalnızca kaydedilir. Güvence düzeyleri (ıslak imza taraması, simülasyon, sağlayıcı) birbirine eşit gösterilmez. *@
@inject ApiClient Api
@inject SessionState Session
@inject CrmLookups Lookups

<section class="detail-section" aria-labelledby="signature-title">
    <div class="section-header">
        <h2 id="signature-title">İmza</h2>
        @if (overview is not null)
        {
            <span class="badge stage-@ContractLabels.SignatureBadge(overview.SignatureStatus)">@ContractLabels.Label(ContractLabels.Signatures, overview.SignatureStatus)</span>
        }
    </div>

    <Notice Text="@notice" Failed="@noticeFailed" />

    @if (overview is null)
    {
        <p class="text-muted" role="status">@(error ?? "Yükleniyor…")</p>
    }
    else
    {
        @if (overview.ProviderIsSimulation)
        {
            <div class="alert alert-danger" role="status"><strong>SİMÜLASYON SAĞLAYICISI ETKİN</strong> — gerçek bir entegrasyon değildir; kimseye imza isteği ya da e-posta gitmez ve simülasyonla alınan imzaların hiçbir hukuki değeri yoktur.</div>
        }

        <p class="text-muted">
            İmza isteği, onaylı sürümün <strong>kesin belgesine</strong> (SHA-256 özetiyle sabitlenir) bağlıdır. <strong>Manuel</strong> yöntemde imzalı belge taraması yüklenir ve yetkili kişi doğrular
            (güvence: ıslak imza taraması; kimlik ve yetki doğrulaması Modulix dışındadır). <strong>Sağlayıcı</strong> yönteminde imza sağlayıcıdan gelen olayla kaydedilir. Bu düzeyler birbirine eşdeğer sayılmaz.
        </p>

        @if (CanStart)
        {
            @if (startForm is null)
            {
                <button type="button" class="btn btn-primary mb-3" @onclick="BeginStartAsync">İmzaya gönder</button>
            }
            else
            {
                <form class="record-form" novalidate @onsubmit="StartAsync" @onsubmit:preventDefault>
                    <h3>İmza isteği</h3>
                    @if (errors is { Count: > 0 })
                    {
                        <div class="alert alert-danger" role="alert"><ul class="mb-0">@foreach (var (_, messages) in errors) { foreach (var message in messages) { <li>@message</li> } }</ul></div>
                    }
                    <div class="form-grid">
                        <div>
                            <label class="form-label" for="sig-doc">Belge *</label>
                            <select id="sig-doc" class="form-select" @bind="startForm.DocumentId">
                                <option value="">Seçin…</option>
                                @foreach (var d in eligibleDocuments) { <option value="@d.Id">@($"{d.FileName} · {CrmLabels.Time(d.CreatedAt)}")</option> }
                            </select>
                            @if (eligibleDocuments.Count == 0) { <div class="form-text text-danger">Güncel sürümün örnek olmayan kesin belgesi yok; önce Belgeler sekmesinden üretin.</div> }
                        </div>
                        <div>
                            <label class="form-label" for="sig-method">Yöntem</label>
                            <select id="sig-method" class="form-select" @bind="startForm.Method">
                                <option value="Manual">Manuel (imzalı belge yüklenir, yetkili doğrular)</option>
                                @if (overview.ProviderEnabled) { <option value="Provider">Sağlayıcı: @(overview.ProviderName)@(overview.ProviderIsSimulation ? " (simülasyon)" : string.Empty)</option> }
                            </select>
                        </div>
                        <div>
                            <label class="form-label" for="sig-mode">Sıra</label>
                            <select id="sig-mode" class="form-select" @bind="startForm.Mode">
                                <option value="Sequential">Sıralı (sırayla imzalanır)</option>
                                <option value="Parallel">Paralel (hepsi aynı anda)</option>
                            </select>
                        </div>
                        <div>
                            <label class="form-label" for="sig-days">Geçerlilik (gün)</label>
                            <input id="sig-days" class="form-control" type="number" min="1" max="90" @bind="startForm.ValidityDays" />
                        </div>
                    </div>

                    <h4>İmzacılar (imza sırasıyla)</h4>
                    @for (var i = 0; i < startForm.Signatories.Count; i++)
                    {
                        var index = i;
                        var s = startForm.Signatories[index];
                        <div class="form-grid signatory-row">
                            <div>
                                <label class="form-label" for="sg-kind-@index">@(index + 1). imzacı türü</label>
                                <select id="sg-kind-@index" class="form-select" @bind="s.Kind">
                                    <option value="External">Dış (müşteri tarafı)</option>
                                    <option value="Internal">İç (firma üyesi)</option>
                                </select>
                            </div>
                            @if (s.Kind == "Internal")
                            {
                                <div>
                                    <label class="form-label" for="sg-user-@index">Üye *</label>
                                    <select id="sg-user-@index" class="form-select" @bind="s.UserId">
                                        <option value="">Seçin…</option>
                                        @foreach (var m in Lookups.Members) { <option value="@m.UserId">@m.DisplayName</option> }
                                    </select>
                                </div>
                            }
                            else
                            {
                                <div>
                                    <label class="form-label" for="sg-name-@index">Ad soyad *</label>
                                    <input id="sg-name-@index" class="form-control" maxlength="150" @bind="s.Name" />
                                </div>
                                <div>
                                    <label class="form-label" for="sg-email-@index">E-posta @(startForm.Method == "Provider" ? "*" : "(isteğe bağlı)")</label>
                                    <input id="sg-email-@index" class="form-control" type="email" maxlength="254" @bind="s.Email" />
                                </div>
                            }
                            <div>
                                <label class="form-label" for="sg-cap-@index">Sıfat</label>
                                <input id="sg-cap-@index" class="form-control" maxlength="100" placeholder="Ör. Genel müdür" @bind="s.Capacity" />
                            </div>
                            <div class="form-check">
                                <input id="sg-req-@index" class="form-check-input" type="checkbox" @bind="s.IsRequired" />
                                <label class="form-check-label" for="sg-req-@index">Zorunlu</label>
                            </div>
                            <div>
                                <button type="button" class="btn btn-outline-danger btn-sm" disabled="@(startForm.Signatories.Count == 1)" @onclick="() => startForm.Signatories.RemoveAt(index)">Kaldır</button>
                            </div>
                        </div>
                    }
                    <div class="form-actions">
                        <button type="button" class="btn btn-outline-secondary" @onclick="() => startForm.Signatories.Add(new SignatoryForm())">İmzacı ekle</button>
                        <button type="submit" class="btn btn-primary" disabled="@busy">İmza isteğini başlat</button>
                        <button type="button" class="btn btn-link" @onclick="() => startForm = null">Vazgeç</button>
                    </div>
                </form>
            }
        }
        else if (overview.Requests.Count == 0)
        {
            <p class="text-muted">İmza isteği yok. İmzaya göndermek için sözleşme onaylı ve yayıma hazır olmalı, güncel sürümün kesin belgesi üretilmiş olmalıdır ve <code>contracts.signatures.manage</code> izniniz olmalıdır.</p>
        }

        @foreach (var request in overview.Requests)
        {
            <article class="signature-request" aria-label="İmza isteği @(CrmLabels.Time(request.CreatedAt))">
                <h3>
                    <span class="badge stage-@SignatureLabels.Badge(request.Status)">@SignatureLabels.Label(SignatureLabels.RequestStatuses, request.Status)</span>
                    V@(request.VersionNo) · @(request.Method == "Manual" ? "Manuel" : "Sağlayıcı") · @(request.Mode == "Sequential" ? "sıralı" : "paralel")
                    @if (request.IsSimulation) { <span class="badge stage-lost">Simülasyon</span> }
                    @if (request.IsExpired && SignatureOpen(request)) { <span class="badge stage-lost">Süresi doldu</span> }
                </h3>
                <p class="small text-muted">
                    Açan: @Lookups.MemberName(request.CreatedBy) · @CrmLabels.Time(request.CreatedAt) · son tarih @CrmLabels.Time(request.ExpiresAt)
                    · belge özeti <code>@request.DocumentSha256[..16]…</code>
                    @if (request.CloseReason is not null) { <span> · @request.CloseReason</span> }
                </p>

                <table class="table record-table">
                    <caption class="visually-hidden">İmzacılar</caption>
                    <thead><tr><th scope="col">Sıra</th><th scope="col">İmzacı</th><th scope="col">Durum</th><th scope="col">Güvence</th><th scope="col">İşlem</th></tr></thead>
                    <tbody>
                        @foreach (var s in request.Signatories)
                        {
                            <tr>
                                <td data-label="Sıra">@s.Position</td>
                                <td data-label="İmzacı" class="primary">
                                    @s.Name @if (!s.IsRequired) { <small class="text-muted">(isteğe bağlı)</small> }
                                    <div class="small text-muted">@(s.Kind == "Internal" ? "İç" : "Dış")@(s.Capacity is null ? string.Empty : " · " + s.Capacity)@(s.Email is null ? string.Empty : " · " + s.Email)</div>
                                    @if (s.DeclineReason is not null) { <div class="small text-danger">Ret gerekçesi: @s.DeclineReason</div> }
                                    @if (s.ReminderCount > 0) { <div class="small text-muted">@s.ReminderCount hatırlatma kaydı @(s.LastReminderAt is { } last ? "· son " + CrmLabels.Time(last) : string.Empty)</div> }
                                </td>
                                <td data-label="Durum"><span class="badge stage-@SignatureLabels.Badge(s.Status)">@SignatureLabels.Label(SignatureLabels.SignatoryStatuses, s.Status)</span>@if (s.SignedAt is { } at) { <div class="small">@CrmLabels.Time(at)</div> }</td>
                                <td data-label="Güvence">
                                    @(s.Assurance is null ? "—" : SignatureLabels.Label(SignatureLabels.Assurances, s.Assurance))
                                    @if (s.VerifiedBy is not null) { <div class="small text-muted">Doğrulayan: @Lookups.MemberName(s.VerifiedBy) · @(s.VerifiedAt is { } v ? CrmLabels.Time(v) : "—")</div> }
                                    @if (s.EvidenceFileId is { } fileId && CanDownload) { <div class="small"><a href="api/contracts/contracts/@ContractId/signature/files/@fileId" download>@(s.EvidenceFileName ?? "İmzalı belge")</a></div> }
                                </td>
                                <td class="actions">
                                    @if (SignatureOpen(request) && !request.IsExpired && s.CanSignNow)
                                    {
                                        @if (request.Method == "Manual" && CanVerify)
                                        {
                                            <button type="button" class="btn btn-outline-primary btn-sm" @onclick="() => OpenManual(s)">İmzayı kaydet</button>
                                        }
                                        @if (request.IsSimulation && CanManage)
                                        {
                                            <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@busy" @onclick='() => SimulateAsync(s, "Viewed")'>Simüle: görüntüle</button>
                                            <button type="button" class="btn btn-outline-primary btn-sm" disabled="@busy" @onclick='() => SimulateAsync(s, "Signed")'>Simüle: imzala</button>
                                            <button type="button" class="btn btn-outline-danger btn-sm" disabled="@busy" @onclick='() => SimulateAsync(s, "Declined")'>Simüle: reddet</button>
                                        }
                                        @if (CanManage)
                                        {
                                            <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@busy" @onclick="() => RemindAsync(s)">Hatırlatmayı kaydet</button>
                                            @if (request.Method == "Manual") { <button type="button" class="btn btn-outline-danger btn-sm" @onclick="() => OpenDecline(s)">Reddi kaydet</button> }
                                        }
                                    }
                                </td>
                            </tr>
                            @if (manualFor == s.Id)
                            {
                                <tr>
                                    <td colspan="5">
                                        <form class="record-form" novalidate @onsubmit="RecordManualAsync" @onsubmit:preventDefault>
                                            <h4>@s.Name için imzalı belgeyi kaydet</h4>
                                            @if (errors is { Count: > 0 })
                                            {
                                                <div class="alert alert-danger" role="alert"><ul class="mb-0">@foreach (var (_, messages) in errors) { foreach (var message in messages) { <li>@message</li> } }</ul></div>
                                            }
                                            <div class="form-grid">
                                                <div>
                                                    <label class="form-label" for="m-date">İmza tarihi *</label>
                                                    <input id="m-date" class="form-control" type="date" @bind="manualDate" />
                                                </div>
                                                <div>
                                                    <label class="form-label" for="m-file">İmzalı belge (PDF, PNG, JPEG; en fazla 10 MB) *</label>
                                                    <InputFile id="m-file" class="form-control" accept="application/pdf,image/png,image/jpeg" OnChange="PickFileAsync" />
                                                    @if (manualFileName is not null) { <div class="form-text">@manualFileName</div> }
                                                </div>
                                                <div class="wide">
                                                    <label class="form-label" for="m-note">Not</label>
                                                    <input id="m-note" class="form-control" maxlength="400" @bind="manualNote" />
                                                </div>
                                            </div>
                                            <p class="small text-muted">Kaydı siz doğrulamış sayılırsınız (doğrulayan olarak yazılır). Kendi imzanızı doğrulayamazsınız.</p>
                                            <div class="form-actions">
                                                <button type="submit" class="btn btn-primary" disabled="@(busy || manualContent is null)">Kaydet ve doğrula</button>
                                                <button type="button" class="btn btn-link" @onclick="CloseForms">Vazgeç</button>
                                            </div>
                                        </form>
                                    </td>
                                </tr>
                            }
                            @if (declineFor == s.Id)
                            {
                                <tr>
                                    <td colspan="5">
                                        <form class="record-form" novalidate @onsubmit="DeclineAsync" @onsubmit:preventDefault>
                                            <label class="form-label" for="d-reason">@s.Name için ret gerekçesi *</label>
                                            <input id="d-reason" class="form-control" maxlength="500" @bind="reasonText" />
                                            <div class="form-actions">
                                                <button type="submit" class="btn btn-danger" disabled="@busy">Reddi kaydet</button>
                                                <button type="button" class="btn btn-link" @onclick="CloseForms">Vazgeç</button>
                                            </div>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>

                @if (SignatureOpen(request) && CanManage)
                {
                    <div class="header-actions">
                        @if (request.IsExpired)
                        {
                            <button type="button" class="btn btn-outline-primary btn-sm" disabled="@busy" @onclick="ExpireAsync">Süre dolumunu işle</button>
                        }
                        <button type="button" class="btn btn-outline-danger btn-sm" @onclick="() => cancelOpen = true">İsteği iptal et</button>
                    </div>
                    @if (cancelOpen)
                    {
                        <form class="record-form" novalidate @onsubmit="CancelAsync" @onsubmit:preventDefault>
                            <label class="form-label" for="c-reason">İptal gerekçesi *</label>
                            <input id="c-reason" class="form-control" maxlength="500" @bind="reasonText" />
                            <div class="form-actions">
                                <button type="submit" class="btn btn-danger" disabled="@busy">İptal et</button>
                                <button type="button" class="btn btn-link" @onclick="CloseForms">Vazgeç</button>
                            </div>
                        </form>
                    }
                }

                <details>
                    <summary>Olay günlüğü (@request.Events.Count)</summary>
                    <ul class="timeline">
                        @foreach (var e in request.Events)
                        {
                            <li>
                                <strong>@SignatureLabels.Label(SignatureLabels.EventTypes, e.EventType)</strong> · @CrmLabels.Time(e.At) · @(e.Source == "Provider" ? "sağlayıcı" : e.Source == "System" ? "sistem" : Lookups.MemberName(e.ActorId))
                                @if (e.Outcome != "Applied") { <span class="badge stage-@(e.Outcome == "Duplicate" ? "open" : "lost")">@SignatureLabels.Label(SignatureLabels.Outcomes, e.Outcome)</span> }
                                @if (e.Note is not null) { <div class="small text-muted">@e.Note</div> }
                            </li>
                        }
                    </ul>
                </details>
            </article>
        }
    }
</section>

@code {
    private const long MaxBytes = 10 * 1024 * 1024;

    private ContractSignatureDto? overview;
    private List<ContractDocumentDto> eligibleDocuments = [];
    private StartForm? startForm;
    private IReadOnlyDictionary<string, string[]>? errors;
    private string? error;
    private string? notice;
    private bool noticeFailed;
    private bool busy;
    private string? loadedKey;
    private Guid? manualFor;
    private Guid? declineFor;
    private bool cancelOpen;
    private DateTime? manualDate;
    private string? manualFileName;
    private byte[]? manualContent;
    private string? manualNote;
    private string reasonText = string.Empty;

    [Parameter, EditorRequired] public ContractDto Contract { get; set; } = null!;

    private Guid ContractId => Contract.Id;

    private bool CanManage => Session.Can(ContractsAccess.SignaturesManage);

    private bool CanVerify => Session.Can(ContractsAccess.SignaturesVerify);

    private bool CanDownload => Session.Can(ContractsAccess.DocumentsDownload);

    private bool CanStart => CanManage && overview is not null && Contract.ApprovalStatus == "Approved" && Contract.PreparationStatus == "ReadyToPublish"
        && Contract.SignatureStatus is "NotSent" or "Rejected" or "Expired" or "Cancelled";

    private static bool SignatureOpen(SignatureRequestDto request) => request.Status is "Pending" or "PartiallySigned";

    protected override async Task OnParametersSetAsync()
    {
        var key = $"{Contract.Id}:{Contract.Version}";
        if (key == loadedKey) { return; }
        loadedKey = key;
        await Lookups.LoadAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var result = await Api.GetAsync<ContractSignatureDto>($"/api/contracts/contracts/{ContractId}/signature");
        overview = result.Value;
        error = result.IsSuccess ? null : result.Error;
        if (overview is not null && Session.Can(ContractsAccess.ContractsRead))
        {
            var documents = (await Api.GetAsync<List<ContractDocumentDto>>($"/api/contracts/contracts/{ContractId}/documents")).Value ?? [];
            eligibleDocuments = [.. documents.Where(d => d.IsFinal && !d.IsExample && d.ContractVersionNo == overview.CurrentVersionNo)];
        }
    }

    private async Task BeginStartAsync()
    {
        startForm = new StartForm { ValidityDays = overview?.ValidityDays ?? 14, DocumentId = eligibleDocuments.FirstOrDefault()?.Id.ToString() ?? string.Empty };
        errors = null;
        await Task.CompletedTask;
    }

    private async Task StartAsync()
    {
        if (busy || startForm is null) { return; }
        busy = true;
        var f = startForm;
        var request = new StartSignatureRequest(
            Contract.Version, Guid.TryParse(f.DocumentId, out var doc) ? doc : Guid.Empty, f.Method, f.Mode,
            [.. f.Signatories.Select(s => new SignatoryInputDto(s.Kind, Guid.TryParse(s.UserId, out var user) && s.Kind == "Internal" ? user : null,
                Blank(s.Name), Blank(s.Email), Blank(s.Capacity), s.IsRequired))],
            f.ValidityDays);
        var result = await Api.PostAsync<ContractSignatureDto>($"/api/contracts/contracts/{ContractId}/signature", request);
        busy = false;
        await Finish(result, "İmza isteği başlatıldı.", () => startForm = null);
    }

    private void OpenManual(SignatoryDto s)
    {
        CloseForms();
        manualFor = s.Id;
        manualDate = DateTime.Today;
        manualFileName = null;
        manualContent = null;
        manualNote = null;
        errors = null;
    }

    private async Task PickFileAsync(InputFileChangeEventArgs e)
    {
        manualContent = null;
        manualFileName = null;
        var file = e.File;
        if (file.Size > MaxBytes)
        {
            errors = new Dictionary<string, string[]> { ["file"] = ["Dosya en fazla 10 MB olabilir."] };
            return;
        }

        using var stream = file.OpenReadStream(MaxBytes);
        using var buffer = new MemoryStream();
        await stream.CopyToAsync(buffer);
        manualContent = buffer.ToArray();
        manualFileName = $"{file.Name} ({manualContent.Length / 1024} KB)";
        errors = null;
    }

    private async Task RecordManualAsync()
    {
        if (busy || manualFor is not { } id || manualContent is null) { return; }
        busy = true;
        var name = manualFileName?.Split(" (")[0] ?? "imzali-belge";
        var request = new RecordManualSignatureRequest(DateOnly.FromDateTime(manualDate ?? DateTime.Today), name, Convert.ToBase64String(manualContent), Blank(manualNote));
        var result = await Api.PostAsync<ContractSignatureDto>($"/api/contracts/contracts/{ContractId}/signature/signatories/{id}/manual", request);
        busy = false;
        await Finish(result, "İmza kaydedildi ve doğrulandı.", CloseForms);
    }

    private void OpenDecline(SignatoryDto s)
    {
        CloseForms();
        declineFor = s.Id;
        reasonText = string.Empty;
    }

    private async Task DeclineAsync()
    {
        if (busy || declineFor is not { } id) { return; }
        busy = true;
        var result = await Api.PostAsync<ContractSignatureDto>($"/api/contracts/contracts/{ContractId}/signature/signatories/{id}/decline", new SignatureReasonRequest(reasonText));
        busy = false;
        await Finish(result, "Ret kaydedildi.", CloseForms);
    }

    private async Task RemindAsync(SignatoryDto s)
    {
        if (busy) { return; }
        busy = true;
        var result = await Api.PostAsync<ContractSignatureDto>($"/api/contracts/contracts/{ContractId}/signature/signatories/{s.Id}/remind", new { });
        busy = false;
        await Finish(result, "Hatırlatma kaydedildi (bildirim gönderilmedi).", null);
    }

    private async Task SimulateAsync(SignatoryDto s, string type)
    {
        if (busy) { return; }
        busy = true;
        var result = await Api.PostAsync<ContractSignatureDto>($"/api/contracts/contracts/{ContractId}/signature/simulate", new SimulateSignatureRequest(s.Position, type, type == "Declined" ? "Simülasyon: reddedildi" : null));
        busy = false;
        await Finish(result, "Simülasyon olayı uygulandı (hukuki değeri yoktur).", null);
    }

    private async Task CancelAsync()
    {
        if (busy) { return; }
        busy = true;
        var result = await Api.PostAsync<ContractSignatureDto>($"/api/contracts/contracts/{ContractId}/signature/cancel", new SignatureReasonRequest(reasonText));
        busy = false;
        await Finish(result, "İmza isteği iptal edildi.", CloseForms);
    }

    private async Task ExpireAsync()
    {
        if (busy) { return; }
        busy = true;
        var result = await Api.PostAsync<ContractSignatureDto>($"/api/contracts/contracts/{ContractId}/signature/expire", new { });
        busy = false;
        await Finish(result, "Süre dolumu işlendi.", null);
    }

    private async Task Finish(ApiResult<ContractSignatureDto> result, string success, Action? onSuccess)
    {
        if (result.IsSuccess)
        {
            overview = result.Value;
            errors = null;
            notice = success;
            noticeFailed = false;
            onSuccess?.Invoke();
            await Changed.InvokeAsync();
            await LoadAsync();
            return;
        }

        errors = result.FieldErrors;
        notice = result.Error;
        noticeFailed = true;
    }

    /// <summary>İmza durumu değişince sözleşme sayfası yeniden okunur (durum, sürüm, yürürlük).</summary>
    [Parameter] public EventCallback Changed { get; set; }

    private void CloseForms()
    {
        manualFor = null;
        declineFor = null;
        cancelOpen = false;
        errors = null;
        reasonText = string.Empty;
    }

    private static string? Blank(string? text) => string.IsNullOrWhiteSpace(text) ? null : text.Trim();

    private sealed class StartForm
    {
        public string DocumentId { get; set; } = string.Empty;
        public string Method { get; set; } = "Manual";
        public string Mode { get; set; } = "Sequential";
        public int? ValidityDays { get; set; } = 14;
        public List<SignatoryForm> Signatories { get; } = [new SignatoryForm()];
    }

    private sealed class SignatoryForm
    {
        public string Kind { get; set; } = "External";
        public string UserId { get; set; } = string.Empty;
        public string? Name { get; set; }
        public string? Email { get; set; }
        public string? Capacity { get; set; }
        public bool IsRequired { get; set; } = true;
    }
}
