@* Süreç görevleri listesi (ADR-0042 dilim 5): süreç kartında sürecin görevleri, "Görevlerim"de kullanıcıya atananlar. Satır açılınca eylemler
   (tamamlandı, atla, yeniden aç) sunucudan gelir; "zimmet iadesi" görevi çalışanın açık zimmeti varken tamamlanamaz (neden gösterilir). *@
@inject ApiClient Api

<section aria-label="@Title">
    <div class="list-toolbar mt-3">
        <h3 class="h6 mb-0 me-auto">@Title</h3>
    </div>

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }

    @if (items is null)
    {
        <LoadingState Kind="LoadingKind.Table" />
    }
    else if (items.Count == 0)
    {
        <p class="text-muted" role="status">@EmptyText</p>
    }
    else
    {
        <table class="table record-table">
            <caption class="visually-hidden">@Title</caption>
            <thead>
                <tr>
                    <th scope="col"><AppIcon Name="check-circle" Size="14" /> Görev</th>
                    @if (ShowEmployee)
                    {
                        <th scope="col"><AppIcon Name="user" Size="14" /> Çalışan</th>
                    }
                    <th scope="col"><AppIcon Name="user-check" Size="14" /> Sorumlu</th>
                    <th scope="col"><AppIcon Name="calendar" Size="14" /> Son tarih</th>
                    <th scope="col"><AppIcon Name="tag" Size="14" /> Durum</th>
                    <th scope="col" class="row-menu-cell"><span class="visually-hidden">Eylemler</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var task in items)
                {
                    var due = FleetLabels.Day(WarehouseLabels.Text(task, "dueDate"));
                    var late = due is { } d && d < DateOnly.FromDateTime(DateTime.Today) && WarehouseLabels.Text(task, "status") == "open";
                    <tr>
                        <td data-label="Görev" class="primary">@WarehouseLabels.Text(task, "title")</td>
                        @if (ShowEmployee)
                        {
                            <td data-label="Çalışan">@WarehouseLabels.Text(task, "employeeName") · @HrLabels.ChecklistKind(WarehouseLabels.Text(task, "checklistKind"))</td>
                        }
                        <td data-label="Sorumlu">@HrLabels.Responsible(WarehouseLabels.Text(task, "responsibleRole"))</td>
                        <td data-label="Son tarih">
                            @HrLabels.Date(WarehouseLabels.Text(task, "dueDate"))
                            @if (late)
                            {
                                <span class="badge stage-lost">Gecikti</span>
                            }
                        </td>
                        <td data-label="Durum"><span class="badge @HrLabels.TaskStatusBadge(WarehouseLabels.Text(task, "status"))">@HrLabels.TaskStatus(WarehouseLabels.Text(task, "status"))</span></td>
                        <td class="row-menu-cell">
                            <RowMenu Label="@($"{WarehouseLabels.Text(task, "title")} eylemleri")">
                                <button type="button" class="view-menu-item" role="menuitem" @onclick="() => selected = task"><AppIcon Name="eye" Size="16" /> <span>Aç</span></button>
                            </RowMenu>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (selected is not null)
    {
        <div class="summary-card mt-2">
            <h4 class="summary-heading">@WarehouseLabels.Text(selected, "title")</h4>
            <dl class="summary-facts">
                <div><dt>Süreç</dt><dd>@WarehouseLabels.Text(selected, "checklistName") · @WarehouseLabels.Text(selected, "employeeName")</dd></div>
                <div><dt>Görev türü</dt><dd>@HrLabels.TaskType(WarehouseLabels.Text(selected, "taskType"))</dd></div>
                @if (WarehouseLabels.Text(selected, "description") is { Length: > 0 } description)
                {
                    <div><dt>Açıklama</dt><dd>@description</dd></div>
                }
                @if (WarehouseLabels.Text(selected, "note") is { Length: > 0 } note)
                {
                    <div><dt>Not</dt><dd>@note</dd></div>
                }
            </dl>
            <LeaveActionsBar Record="selected" BaseUrl="/api/hr/checklist-tasks" Changed="ChangedAsync" />
            <button type="button" class="btn btn-outline-secondary" @onclick="() => selected = null">Kapat</button>
        </div>
    }
</section>

@code {
    private List<RecordResponse>? items;
    private RecordResponse? selected;
    private string? message;
    private string? loadedFor;

    [Parameter] public string Title { get; set; } = "Görevler";

    [Parameter] public string EmptyText { get; set; } = "Görev yok.";

    /// <summary>Liste süzgeci (ör. <c>checklistId=…</c>, <c>assigneeUserId=…&amp;status=open</c>).</summary>
    [Parameter, EditorRequired] public string Query { get; set; } = string.Empty;

    [Parameter] public bool ShowEmployee { get; set; }

    /// <summary>Bir görev değişince (sürecin ilerlemesi de değişmiş olabilir).</summary>
    [Parameter] public EventCallback Changed { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (loadedFor == Query)
        {
            return;
        }

        loadedFor = Query;
        selected = null;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var result = await Api.GetAsync<RecordPageResponse>($"/api/records/{HrAccess.ChecklistTaskEntityKey}?{Query}&pageSize=200");
        items = result.Value?.Items.ToList() ?? [];
        message = result.Error;
    }

    private async Task ChangedAsync(RecordResponse changed)
    {
        selected = changed;
        await LoadAsync();
        await Changed.InvokeAsync();
    }
}
