@* Halka grafik: dilimler SVG yaylarıyla çizilir, ortada toplam yazar; renkler ortak CSS'teki .chart-c0…c5 sınıflarından gelir. *@
@{
    const string radius = "15.9155"; // çevre = 100; ondalık ayracı yerel ayardan etkilenmesin diye metin
    var total = Slices.Sum(s => s.Value);
    double offset = 0;
}
<div class="donut-chart">
    <svg viewBox="0 0 42 42" role="img" aria-label="@Title">
        <circle class="donut-track" cx="21" cy="21" r="@radius" fill="none" stroke-width="5" />
        @if (total > 0)
        {
            @for (var i = 0; i < Slices.Count; i++)
            {
                var share = (double)(Slices[i].Value / total) * 100;
                if (share <= 0) { continue; }
                <circle class="chart-stroke chart-c@(i % 6)" cx="21" cy="21" r="@radius" fill="none" stroke-width="5"
                        stroke-dasharray="@Num(share) @Num(100 - share)" stroke-dashoffset="@Num(25 - offset)">
                    <title>@Slices[i].Label: @Slices[i].Value.ToString(ValueFormat, Regional.Numbers)</title>
                </circle>
                offset += share;
            }
        }
        <text x="21" y="21.5" text-anchor="middle" class="donut-total">@total.ToString(ValueFormat, Regional.Numbers)</text>
        <text x="21" y="26" text-anchor="middle" class="donut-caption">@Caption</text>
    </svg>
    <ul class="chart-legend">
        @for (var i = 0; i < Slices.Count; i++)
        {
            <li><span class="chart-dot chart-bg-c@(i % 6)"></span>@Slices[i].Label<strong>@Slices[i].Value.ToString(ValueFormat, Regional.Numbers)</strong></li>
        }
    </ul>
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<ChartSlice> Slices { get; set; } = [];

    [Parameter] public string Title { get; set; } = "Dağılım grafiği";

    [Parameter] public string Caption { get; set; } = "toplam";

    /// <summary>Değer etiketlerinin sayı biçimi; ondalıklı değerlerde "N2" verilir.</summary>
    [Parameter] public string ValueFormat { get; set; } = "N0";

    private static string Num(double value) => value.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);
}
