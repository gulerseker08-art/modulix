@* Lead raporu (kullanıcının erişim kapsamıyla sınırlı). Tanımlar ekranda yazılıdır: dönem kohortu = dönemde GELEN Lead'ler. *@
@inject ApiClient Api

<section class="detail-section lead-report">
    <div class="section-header">
        <h2>@Texts.Get("crm.lead.report.title")</h2>
        <div class="filters">
            <label class="form-label-inline">@Texts.Get("crm.link.editor.start") <input class="form-control" type="date" @bind="from" @bind:after="LoadAsync" /></label>
            <label class="form-label-inline">@Texts.Get("crm.party.end") <input class="form-control" type="date" @bind="to" @bind:after="LoadAsync" /></label>
        </div>
    </div>
    <p class="text-muted small">
        @Texts.Get("crm.lead.report.help1") <strong>@Texts.Get("crm.lead.report.helpIncoming")</strong> @Texts.Get("crm.lead.report.help2", Texts.Get("crm.lead.report.convertedInPeriod"))
        @Texts.Get("crm.lead.report.help3")
    </p>

    @if (error is not null)
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }
    else if (report is null)
    {
        <LoadingState />
    }
    else
    {
        @if (report.Truncated)
        {
            <div class="alert alert-warning" role="alert">@Texts.Get("crm.lead.report.truncated")</div>
        }
        <dl class="summary-grid">
            <div><dt>@Texts.Get("crm.lead.report.cohort")</dt><dd>@report.CohortCount</dd></div>
            <div><dt>@Texts.Get("crm.lead.report.withFirstContact")</dt><dd>@report.WithFirstContact</dd></div>
            <div><dt>@Texts.Get("crm.lead.report.avgFirstContact")</dt><dd>@Hours(report.AverageFirstContactHours)</dd></div>
            <div><dt>@Texts.Get("crm.lead.report.medianFirstContact")</dt><dd>@Hours(report.MedianFirstContactHours)</dd></div>
            <div>
                <dt>@Texts.Get("crm.lead.report.breaches")</dt>
                <dd>@(report.FirstContactTargetBreaches is { } breaches ? Texts.Get("crm.lead.report.breachesValue", breaches, report.FirstContactTargetHours) : Texts.Get("crm.lead.report.noTarget"))</dd>
            </div>
            <div><dt>@Texts.Get("crm.lead.report.convertedCohort")</dt><dd>@report.ConvertedFromCohort</dd></div>
            <div><dt>@Texts.Get("crm.lead.report.conversionRate")</dt><dd>@(report.ConversionRate is { } rate ? $"%{rate * 100:0.#}" : "—")</dd></div>
            <div><dt>@Texts.Get("crm.lead.report.avgToConvert")</dt><dd>@Hours(report.AverageHoursToConvert)</dd></div>
            <div><dt>@Texts.Get("crm.lead.report.convertedInPeriod")</dt><dd>@report.ConvertedInPeriod</dd></div>
        </dl>
        <div class="report-tables">
            <div>
                <h3>@Texts.Get("crm.lead.report.bySource")</h3>
                @Table(report.BySource, k => k.Length == 0 ? Texts.Get("crm.lead.report.unspecified") : Lookups.Label(CrmLeadLists.Source, k))
            </div>
            <div>
                <h3>@Texts.Get("crm.lead.report.byStatus")</h3>
                @Table(report.ByStatus, CrmText.LeadStatusName)
            </div>
            <div>
                <h3>@Texts.Get("crm.lead.report.reasons")</h3>
                @Table(report.DisqualificationReasons, k => k.Length == 0 ? Texts.Get("crm.lead.report.unspecified") : Lookups.Label(CrmLeadLists.DisqualificationReason, k))
            </div>
            <div>
                <h3>@Texts.Get("crm.lead.report.openByOwner")</h3>
                @if (report.OpenByOwner.Count == 0)
                {
                    <p class="text-muted">@Texts.Get("crm.lead.report.noOpen")</p>
                }
                else
                {
                    <table class="table">
                        <tbody>
                            @foreach (var row in report.OpenByOwner)
                            {
                                <tr><td>@(row.OwnerId is null ? Texts.Get("crm.leads.unassigned") : Lookups.MemberName(row.OwnerId))</td><td class="text-end">@row.Count</td></tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    }
</section>

@code {
    /// <summary>Sayfanın yüklediği seçim listeleri ve üyeler (<see cref="CrmLookups"/> geçicidir; kendi örneği boş olurdu).</summary>
    [Parameter, EditorRequired] public CrmLookups Lookups { get; set; } = default!;

    private LeadReportDto? report;
    private string? error;
    private DateOnly from = DateOnly.FromDateTime(DateTime.Today.AddDays(-30));
    private DateOnly to = DateOnly.FromDateTime(DateTime.Today);

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        var start = Regional.FromTenant(from.ToDateTime(TimeOnly.MinValue));
        var end = Regional.FromTenant(to.AddDays(1).ToDateTime(TimeOnly.MinValue));
        var result = await Api.GetAsync<LeadReportDto>(
            $"/api/crm/leads/report?from={Uri.EscapeDataString(start.ToString("O"))}&to={Uri.EscapeDataString(end.ToString("O"))}");
        report = result.Value;
        error = result.Error;
    }

    private static string Hours(double? hours) =>
        hours is not { } value ? "—" : value < 48 ? Texts.Get("crm.lead.report.hoursValue", value.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)) : Texts.Get("crm.lead.report.daysValue", (value / 24).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture));

    private RenderFragment Table(IReadOnlyList<LeadCount> rows, Func<string, string> label) => builder =>
    {
        if (rows.Count == 0)
        {
            builder.OpenElement(0, "p");
            builder.AddAttribute(1, "class", "text-muted");
            builder.AddContent(2, Texts.Get("common.noRecords"));
            builder.CloseElement();
            return;
        }

        builder.OpenElement(0, "table");
        builder.AddAttribute(1, "class", "table");
        builder.OpenElement(2, "tbody");
        foreach (var row in rows)
        {
            builder.OpenElement(3, "tr");
            builder.OpenElement(4, "td");
            builder.AddContent(5, label(row.Key));
            builder.CloseElement();
            builder.OpenElement(6, "td");
            builder.AddAttribute(7, "class", "text-end");
            builder.AddContent(8, row.Count);
            builder.CloseElement();
            builder.CloseElement();
        }

        builder.CloseElement();
        builder.CloseElement();
    };
}
