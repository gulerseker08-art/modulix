@* Değişikliğin operasyon, teslimat, sözleşme ve tutar etkisi. Tutar farkı yalnızca tutar görme izni olana gelir (aksi halde null). *@
<ul class="small mb-1">
    @foreach (var item in Operations) { <li><strong>@Texts.Get("orders.impact.operations"):</strong> @item</li> }
    @foreach (var item in Deliveries) { <li><strong>@Texts.Get("orders.impact.deliveries"):</strong> @item</li> }
    @foreach (var item in Contracts) { <li><strong>@Texts.Get("orders.impact.contracts"):</strong> @item</li> }
    @if (NetDelta is { } net && TaxDelta is { } tax && (net != 0 || tax != 0))
    {
        <li><strong>@Texts.Get("orders.impact.amount-label"):</strong> @Texts.Get("orders.impact.amount", OrderLabels.Money(net, Currency), OrderLabels.Money(tax, Currency))</li>
    }
    @if (Operations.Count + Deliveries.Count + Contracts.Count == 0 && (NetDelta ?? 0m) == 0m)
    {
        <li class="text-muted">@Texts.Get("orders.impact.none")</li>
    }
</ul>

@code {
    [Parameter] public IReadOnlyList<string> Operations { get; set; } = [];

    [Parameter] public IReadOnlyList<string> Deliveries { get; set; } = [];

    [Parameter] public IReadOnlyList<string> Contracts { get; set; } = [];

    [Parameter] public decimal? NetDelta { get; set; }

    [Parameter] public decimal? TaxDelta { get; set; }

    [Parameter] public string Currency { get; set; } = "TRY";
}
