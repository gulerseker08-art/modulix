@* Süreli belge ekleme/düzenleme formu (ADR-0038 K3); CredentialsPanel kullanır. Düzen firmanın form düzenine (ADR-0021) göre çizilir. Kayıt genel
   kayıt uçlarından (/api/records/core.credential) yapılır. Belge türünün sahip türüne uyması, tarih tutarlılığı ve numara benzersizliği sunucuda
   denetlenir; ileti alanın altında gösterilir. Belge kaydedildikten sonra dosyası (tarama, PDF) eklenebilir. *@
@using System.Text.Json.Nodes
@inject ApiClient Api
@inject FormLayouts Layouts
@inject ToastService Toasts

<form class="record-form sectioned" novalidate @onsubmit="SaveAsync" @onsubmit:preventDefault @oninput="() => dirty = true">
    <div class="form-toolbar">
        <div>
            <h2>@(Credential is null ? Texts.Get("credentials.form.new") : Lookups.Label(CredentialAccess.TypeList, form.TypeKey))</h2>
            @if (Credential is not null)
            {
                <p>@(string.IsNullOrWhiteSpace(form.DocumentNo) ? Texts.Get("credentials.form.no-number") : form.DocumentNo) · @CredentialLabels.Validity(Credential)</p>
            }
        </div>
        <div class="form-toolbar-actions">
            <UnsavedChanges IsDirty="() => dirty" />
            <button type="button" class="btn btn-outline-secondary" @onclick="Cancelled">@Texts.Get("common.cancel")</button>
            <button type="submit" class="btn btn-primary" disabled="@(busy || layout is null || !CanWrite)">
                @if (busy)
                {
                    <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                }
                @Texts.Get("common.save")
            </button>
        </div>
    </div>

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }
    @if (layoutError is not null)
    {
        <div class="alert alert-danger" role="alert">@layoutError</div>
    }

    <LayoutForm Layout="layout" CustomFields="NoCustomFields" CustomValues="noCustomValues" Errors="errors" TabsLabel="@Texts.Get("credentials.form.tabs")">
        <Field Context="f">
            @switch (f.Key)
            {
                case "typeKey":
                    <label class="@f.LabelClass()" for="cred-type">@f.Label</label>
                    <select id="cred-type" class="form-select" required="@f.Required" aria-required="@f.AriaRequired()" disabled="@(Types.Count == 0)" @bind="form.TypeKey">
                        @foreach (var type in Types)
                        {
                            <option value="@type.Key">@type.Label</option>
                        }
                    </select>
                    <FieldError Field="typeKey" Errors="errors" />
                    <small class="text-muted">@Texts.Get("credentials.form.type-hint")</small>
                    break;
                case "documentNo":
                    <label class="@f.LabelClass()" for="cred-no">@f.Label</label>
                    <input id="cred-no" class="form-control" maxlength="50" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.DocumentNo" />
                    <FieldError Field="documentNo" Errors="errors" />
                    break;
                case "issuedBy":
                    <label class="@f.LabelClass()" for="cred-issuer">@f.Label</label>
                    <input id="cred-issuer" class="form-control" maxlength="200" required="@f.Required" aria-required="@f.AriaRequired()" placeholder="@Texts.Get("credentials.form.issuer-placeholder")" @bind="form.IssuedBy" />
                    <FieldError Field="issuedBy" Errors="errors" />
                    break;
                case "status":
                    <label class="@f.LabelClass()" for="cred-status">@f.Label</label>
                    <select id="cred-status" class="form-select" @bind="form.Status">
                        @foreach (var (key, label) in CredentialLabels.Statuses)
                        {
                            <option value="@key">@label</option>
                        }
                    </select>
                    <FieldError Field="status" Errors="errors" />
                    break;
                case "validFrom":
                    <label class="@f.LabelClass()" for="cred-from">@f.Label</label>
                    <input id="cred-from" class="form-control" type="date" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.ValidFrom" />
                    <FieldError Field="validFrom" Errors="errors" />
                    break;
                case "validTo":
                    <label class="@f.LabelClass()" for="cred-to">@f.Label</label>
                    <input id="cred-to" class="form-control" type="date" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.ValidTo" />
                    <FieldError Field="validTo" Errors="errors" />
                    <small class="text-muted">@Texts.Get("credentials.form.valid-to-hint")</small>
                    break;
                case "notes":
                    <label class="@f.LabelClass()" for="cred-notes">@f.Label</label>
                    <textarea id="cred-notes" class="form-control" rows="3" maxlength="2000" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.Notes"></textarea>
                    <FieldError Field="notes" Errors="errors" />
                    break;
            }
        </Field>
    </LayoutForm>

    @if (form.Id is { } id)
    {
        <AttachmentPanel EntityKey="@CredentialAccess.EntityKey" RecordId="id" CanWrite="CanWrite" Title="@Texts.Get("credentials.form.file-title")" EmptyText="@Texts.Get("credentials.form.file-empty")" />
    }
    else
    {
        <p class="text-muted">@Texts.Get("credentials.form.save-first")</p>
    }

    <div class="form-actions">
        @if (form.Id is not null && CanWrite)
        {
            <button type="button" class="btn btn-outline-danger" disabled="@busy" @onclick="DeleteAsync">@Texts.Get("common.delete")</button>
        }
        <button type="button" class="btn btn-outline-secondary ms-auto" @onclick="Cancelled">@Texts.Get("common.cancel")</button>
        <button type="submit" class="btn btn-primary" disabled="@(busy || layout is null || !CanWrite)">@Texts.Get("common.save")</button>
    </div>
</form>

@code {
    private static readonly string Url = "/api/records/" + CredentialAccess.EntityKey;
    private static readonly IReadOnlyList<CustomFieldDto> NoCustomFields = [];

    private readonly JsonObject noCustomValues = [];
    private bool dirty;
    private FormLayoutDto? layout;
    private string? layoutError;
    private CredentialForm form = new();
    private IReadOnlyDictionary<string, string[]>? errors;
    private string? message;
    private bool busy;
    private RecordResponse? source;
    private bool initialized;

    /// <summary>Düzenlenecek belge; null ise yeni belge.</summary>
    [Parameter] public RecordResponse? Credential { get; set; }

    /// <summary>Sahip kayıt türü (ör. <c>fleet.vehicle</c>) ve kimliği; yeni belgede yazılır, sonra değişmez.</summary>
    [Parameter, EditorRequired] public string OwnerEntityKey { get; set; } = string.Empty;

    [Parameter, EditorRequired] public Guid OwnerId { get; set; }

    /// <summary>Sahip türün belge kategorisi; tür seçimi bu kategoriye süzülür.</summary>
    [Parameter, EditorRequired] public string Category { get; set; } = string.Empty;

    [Parameter, EditorRequired] public CrmLookups Lookups { get; set; } = default!;

    [Parameter] public bool CanWrite { get; set; }

    [Parameter] public EventCallback<RecordResponse> Saved { get; set; }

    [Parameter] public EventCallback Deleted { get; set; }

    [Parameter] public EventCallback Cancelled { get; set; }

    private IReadOnlyList<ChoiceValueDto> Types =>
        [.. Lookups.Choices(CredentialAccess.TypeList, form.TypeKey).Where(t => t.Category == Category || t.Key == form.TypeKey)];

    protected override async Task OnInitializedAsync()
    {
        layout = await Layouts.ForAsync(CredentialAccess.EntityKey);
        layoutError = layout is null ? Texts.Get("common.form.loadFailed") : null;
    }

    /// <summary>Form yalnızca başka bir belge verildiğinde yeniden doldurulur; yazılanlar kaybolmaz.</summary>
    protected override void OnParametersSet()
    {
        if (initialized && ReferenceEquals(source, Credential))
        {
            return;
        }

        initialized = true;
        source = Credential;
        form = Credential is { } r
            ? new CredentialForm
            {
                Id = r.Id, Version = r.Version, TypeKey = WarehouseLabels.Text(r, "typeKey"), DocumentNo = WarehouseLabels.Text(r, "documentNo"),
                IssuedBy = WarehouseLabels.Text(r, "issuedBy"), ValidFrom = FleetLabels.Day(WarehouseLabels.Text(r, "validFrom")),
                ValidTo = FleetLabels.Day(WarehouseLabels.Text(r, "validTo")), Status = WarehouseLabels.Text(r, "status"),
                Notes = WarehouseLabels.Text(r, "notes"),
            }
            : new CredentialForm { Status = CredentialAccess.Active };
        if (Credential is null)
        {
            form.TypeKey = Types.FirstOrDefault()?.Key ?? string.Empty;
        }

        errors = null;
        message = null;
    }

    private async Task SaveAsync()
    {
        busy = true;
        var values = new JsonObject
        {
            ["typeKey"] = form.TypeKey,
            ["documentNo"] = Blank(form.DocumentNo),
            ["issuedBy"] = Blank(form.IssuedBy),
            ["validFrom"] = form.ValidFrom?.ToString("yyyy-MM-dd"),
            ["validTo"] = form.ValidTo?.ToString("yyyy-MM-dd"),
            ["status"] = form.Status,
            ["notes"] = Blank(form.Notes),
        };
        if (form.Id is null)
        {
            // Sahip yalnızca oluştururken verilir; sonra değiştirilemez.
            values["ownerEntityKey"] = OwnerEntityKey;
            values["ownerId"] = OwnerId.ToString();
        }

        var request = new RecordWriteRequest(values, form.Version);
        var result = form.Id is { } id
            ? await Api.PutAsync<RecordResponse>($"{Url}/{id}", request)
            : await Api.PostAsync<RecordResponse>(Url, request);
        busy = false;

        if (result.IsSuccess)
        {
            dirty = false;
            Toasts.Success(Texts.Get("common.saved"));
            await Saved.InvokeAsync(result.Value!);
            return;
        }

        errors = result.FieldErrors;
        message = result.Error;
    }

    private async Task DeleteAsync()
    {
        busy = true;
        var result = await Api.DeleteAsync($"{Url}/{form.Id}?version={form.Version}");
        busy = false;

        if (result.IsSuccess)
        {
            dirty = false;
            Toasts.Success(Texts.Get("common.deleted"));
            await Deleted.InvokeAsync();
            return;
        }

        message = result.Error;
    }

    private static string? Blank(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private sealed class CredentialForm
    {
        public Guid? Id { get; init; }

        public long? Version { get; init; }

        public string TypeKey { get; set; } = string.Empty;

        public string? DocumentNo { get; set; }

        public string? IssuedBy { get; set; }

        public DateOnly? ValidFrom { get; set; }

        public DateOnly? ValidTo { get; set; }

        public string Status { get; set; } = CredentialAccess.Active;

        public string? Notes { get; set; }
    }
}
