@inject ApiClient Api
@inject SessionState Session
@inject CrmLookups Lookups
@inject NavigationManager Navigation
@inject IJSRuntime Js

@* Sunulmuş teklifin müşteri belgesi (PDF), paylaşım bağlantıları ve müşterinin kararı (ADR-0019). Her şey sunucudan gelir; maliyet/iç not yoktur. *@
<section aria-labelledby="share-title" class="quote-sharing">
    <h2 id="share-title">@Texts.Get("crm.quoteShare.title")</h2>
    <Notice Text="@notice" Failed="@noticeFailed" />

    @if (!loaded)
    {
        <p class="text-muted">@Texts.Get("common.loading")</p>
    }
    else
    {
        <h3 class="h6">@Texts.Get("crm.quoteShare.documents")</h3>
        @if (documents.Count == 0)
        {
            <p class="text-muted">@Texts.Get("crm.quoteShare.noDocument")</p>
            @if (CanShare && Quote.Status == "Presented")
            {
                <button type="button" class="btn btn-outline-primary" disabled="@busy" @onclick="GenerateAsync">@Texts.Get("crm.quoteShare.generate")</button>
            }
        }
        else
        {
            <ul class="summary-list">
                @foreach (var document in documents)
                {
                    <li>
                        <a href="api/crm/quotes/@Quote.Id/documents/@document.Id/file" download="@document.FileName">@document.FileName</a>
                        <span class="text-muted">@Texts.Get("crm.quoteShare.docMeta", document.SizeBytes / 1024, CrmLabels.Time(document.CreatedAt), document.TemplateVersion)</span>
                        <div class="small text-muted">SHA-256: <code title="@document.Sha256">@document.Sha256[..16]…@document.Sha256[^8..]</code></div>
                    </li>
                }
            </ul>
            <p class="small text-muted">@Texts.Get("crm.quoteShare.docNote")</p>
        }

        @if (CanShare)
        {
            <h3 class="h6">@Texts.Get("crm.quoteShare.links")</h3>
            @if (created is not null)
            {
                <div class="alert alert-success" role="status">
                    <strong>@Texts.Get("crm.quoteShare.createdTitle")</strong> @Texts.Strong("crm.quoteShare.createdNote", Texts.Get("crm.quoteShare.neverAgain"))
                    <div class="share-url">
                        <label class="visually-hidden" for="share-url">@Texts.Get("crm.quoteShare.urlLabel")</label>
                        <input id="share-url" class="form-control" readonly value="@FullUrl(created)" />
                        <button type="button" class="btn btn-outline-primary" @onclick="() => CopyAsync(created)">@Texts.Get("crm.quoteShare.copy")</button>
                        <button type="button" class="btn btn-link" @onclick="() => created = null">@Texts.Get("common.close")</button>
                    </div>
                    <div class="small text-muted">@Texts.Get("crm.quoteShare.tokenNote")</div>
                </div>
            }

            @if (links.Count == 0)
            {
                <p class="text-muted">@Texts.Get("crm.quoteShare.noLinks")</p>
            }
            else
            {
                <table class="table record-table">
                    <caption class="visually-hidden">@Texts.Get("crm.quoteShare.links")</caption>
                    <thead>
                        <tr><th scope="col">@Texts.Get("crm.quoteShare.col.recipient")</th><th scope="col">@Texts.Get("common.field.status")</th><th scope="col">@Texts.Get("crm.quoteShare.col.expires")</th><th scope="col">@Texts.Get("crm.quoteShare.col.firstViewed")</th><th scope="col">@Texts.Get("crm.quoteShare.col.email")</th><th scope="col">@Texts.Get("crm.quoteShare.col.link")</th><th scope="col">@Texts.Get("crm.quoteShare.col.action")</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var link in links)
                        {
                            <tr>
                                <td data-label="@Texts.Get("crm.quoteShare.col.recipient")" class="primary">@(link.RecipientName ?? "—")@if (link.RecipientEmail is not null) { <small class="text-muted"> @link.RecipientEmail</small> }</td>
                                <td data-label="@Texts.Get("common.field.status")"><span class="badge stage-@(link.State == "Active" ? "qualified" : "cancelled")">@LinkState(link.State)</span>
                                    @if (link.RevokeReason is not null) { <div class="small text-muted">@link.RevokeReason</div> }</td>
                                <td data-label="@Texts.Get("crm.quoteShare.col.expires")">@CrmLabels.Time(link.ExpiresAt)</td>
                                <td data-label="@Texts.Get("crm.quoteShare.col.firstViewed")">@(link.FirstViewedAt is { } viewed ? CrmLabels.Time(viewed) : Texts.Get("crm.quoteShare.notOpened"))</td>
                                <td data-label="@Texts.Get("crm.quoteShare.col.email")">
                                    @if (link.DeliveryStatus == "NotSent") { <span class="text-muted">@QuoteLabels.Label(QuoteLabels.Deliveries, "NotSent")</span> }
                                    else
                                    {
                                        <span class="badge stage-@(link.DeliveryStatus == "Failed" ? "lost" : link.DeliveryStatus == "Succeeded" ? "won" : "onhold")">@QuoteLabels.Label(QuoteLabels.Deliveries, link.DeliveryStatus)</span>
                                        @if (link.ProviderAcceptedAt is { } accepted) { <div class="small text-muted">@CrmLabels.Time(accepted)</div> }
                                        @if (link.DeliveryError is not null) { <div class="small text-muted">@link.DeliveryError</div> }
                                    }
                                </td>
                                <td data-label="@Texts.Get("crm.quoteShare.col.link")"><code>…@link.TokenHint</code></td>
                                <td class="actions">
                                    @if (link.State == "Active")
                                    {
                                        @if (revoking == link.Id)
                                        {
                                            <form @onsubmit="() => RevokeAsync(link)" @onsubmit:preventDefault>
                                                <label class="visually-hidden" for="revoke-@link.Id">@Texts.Get("crm.quoteShare.revokeReasonLabel")</label>
                                                <input id="revoke-@link.Id" class="form-control form-control-sm" maxlength="500" placeholder="@Texts.Get("crm.quoteShare.revokeReasonPlaceholder")" @bind="revokeReason" />
                                                <button type="submit" class="btn btn-outline-danger btn-sm" disabled="@busy">@Texts.Get("crm.quoteShare.revoke")</button>
                                                <button type="button" class="btn btn-link btn-sm" @onclick="() => revoking = null">@Texts.Get("common.dismiss")</button>
                                            </form>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-outline-danger btn-sm" @onclick="() => StartRevoke(link)">@Texts.Get("crm.quoteShare.revokeLink")</button>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            @if (Quote.Status == "Presented")
            {
                <form class="record-form" novalidate @onsubmit="CreateAsync" @onsubmit:preventDefault>
                    <h4 class="h6">@Texts.Get("crm.quoteShare.newLink")</h4>
                    <div class="form-grid">
                        <div>
                            <label class="form-label" for="share-name">@Texts.Get("crm.quoteShare.recipientName")</label>
                            <input id="share-name" class="form-control" maxlength="200" @bind="recipientName" />
                            <FieldError Errors="@errors" Field="recipientName" />
                        </div>
                        <div>
                            <label class="form-label" for="share-email">@Texts.Get("crm.quoteShare.recipientEmail")</label>
                            <input id="share-email" class="form-control" type="email" maxlength="254" @bind="recipientEmail" />
                            <FieldError Errors="@errors" Field="recipientEmail" />
                        </div>
                        <div class="form-check">
                            <input id="share-send" class="form-check-input" type="checkbox" @bind="sendEmail" />
                            <label class="form-check-label" for="share-send">@Texts.Get("crm.quoteShare.sendEmail")</label>
                        </div>
                        <div>
                            <label class="form-label" for="share-days">@Texts.Get("crm.quoteShare.validDays")</label>
                            <input id="share-days" class="form-control" type="number" min="1" max="180" placeholder="@Texts.Get("crm.quoteShare.auto")" @bind="validDays" />
                            <FieldError Errors="@errors" Field="validDays" />
                        </div>
                    </div>
                    <div class="form-actions">
                        <button type="submit" class="btn btn-primary" disabled="@busy">@Texts.Get("crm.quoteShare.create")</button>
                    </div>
                    <p class="small text-muted">@Texts.Get("crm.quoteShare.createNote")</p>
                </form>
            }
        }

        <h3 class="h6">@Texts.Get("crm.quoteShare.decision")</h3>
        @if (decisions.Count == 0)
        {
            <p class="text-muted">@Texts.Get("crm.quoteShare.noDecision")</p>
        }
        else
        {
            <ul class="summary-list">
                @foreach (var decision in decisions)
                {
                    <li>
                        <strong>@Texts.Get(decision.Decision == "Accepted" ? "crm.quoteShare.decisionAccepted" : "crm.quoteShare.decisionRejected")</strong>
                        — @decision.SignerName@(decision.SignerTitle is null ? string.Empty : $", {decision.SignerTitle}")
                        <span class="text-muted">· @CrmLabels.Time(decision.At)@(decision.SignerEmail is null ? string.Empty : $" · {decision.SignerEmail}")</span>
                        @if (decision.Reason is not null) { <div class="small">@Texts.Get("crm.quoteShare.reason", decision.Reason)</div> }
                        @if (decision.TermsStatement is not null) { <div class="small text-muted">@Texts.Get("crm.quoteShare.terms", decision.TermsStatement)</div> }
                        <div class="small text-muted">@Texts.Get("crm.quoteShare.digest") <code>@decision.DocumentSha256[..12]…</code>@(decision.ClientAddressMasked is null ? string.Empty : " · " + Texts.Get("crm.quoteShare.client", decision.ClientAddressMasked))</div>
                    </li>
                }
            </ul>
        }
    }
</section>

@code {
    [Parameter, EditorRequired] public QuoteDto Quote { get; set; } = default!;

    /// <summary>Panel teklifin kendisini değiştiren bir işlem yaptığında (belge üretimi tarihçeye satır ekler) üst sayfanın yenilenmesi için.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    private List<QuoteDocumentDto> documents = [];
    private List<QuoteShareLinkDto> links = [];
    private List<QuoteDecisionDto> decisions = [];
    private QuoteShareLinkCreatedDto? created;
    private IReadOnlyDictionary<string, string[]>? errors;
    private string? notice;
    private bool noticeFailed;
    private bool loaded;
    private bool busy;
    private Guid? revoking;
    private string revokeReason = string.Empty;
    private string? recipientName;
    private string? recipientEmail;
    private int? validDays;
    private bool sendEmail;
    private Guid loadedFor;

    private bool CanShare => Session.Can(CrmAccess.QuotesShare);

    protected override async Task OnParametersSetAsync()
    {
        if (loadedFor == Quote.Id && loaded)
        {
            return;
        }

        loadedFor = Quote.Id;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        documents = (await Api.GetAsync<List<QuoteDocumentDto>>($"/api/crm/quotes/{Quote.Id}/documents")).Value ?? [];
        decisions = (await Api.GetAsync<List<QuoteDecisionDto>>($"/api/crm/quotes/{Quote.Id}/decisions")).Value ?? [];
        links = CanShare ? (await Api.GetAsync<List<QuoteShareLinkDto>>($"/api/crm/quotes/{Quote.Id}/share-links")).Value ?? [] : [];
        loaded = true;

        // Liste okunurken sunucu teklifin gönderim durumunu kuyruğa göre eşitler; sayfa başlığı eskiyse üst sayfa yenilenir.
        var overall = links.FirstOrDefault(l => l.DeliveryStatus != "NotSent")?.DeliveryStatus ?? "NotSent";
        if (CanShare && overall != Quote.DeliveryStatus)
        {
            await OnChanged.InvokeAsync();
        }
    }

    private async Task GenerateAsync()
    {
        if (busy) { return; }
        busy = true;
        var result = await Api.PostAsync<QuoteDocumentDto>($"/api/crm/quotes/{Quote.Id}/documents", new { });
        busy = false;
        Notify(result.IsSuccess ? Texts.Get("crm.quoteShare.generated") : result.Error, !result.IsSuccess);
        await LoadAsync();
        await OnChanged.InvokeAsync();
    }

    private async Task CreateAsync()
    {
        if (busy) { return; }
        busy = true;
        errors = null;
        var result = await Api.PostAsync<QuoteShareLinkCreatedDto>($"/api/crm/quotes/{Quote.Id}/share-links",
            new CreateQuoteShareLinkRequest(null, validDays, Blank(recipientName), Blank(recipientEmail), sendEmail));
        busy = false;
        if (result.IsSuccess)
        {
            created = result.Value;
            var queued = sendEmail ? result.Value!.Link.DeliveryStatus : null;
            recipientName = recipientEmail = null;
            validDays = null;
            sendEmail = false;
            Notify(queued switch
            {
                null => null,
                "Failed" => Texts.Get("crm.quoteShare.emailFailed"),
                _ => Texts.Get("crm.quoteShare.emailQueued"),
            }, queued == "Failed");
            await LoadAsync();
            await OnChanged.InvokeAsync();
            return;
        }

        errors = result.FieldErrors;
        Notify(result.Error, failed: true);
    }

    private void StartRevoke(QuoteShareLinkDto link)
    {
        revoking = link.Id;
        revokeReason = string.Empty;
    }

    private async Task RevokeAsync(QuoteShareLinkDto link)
    {
        if (busy) { return; }
        if (string.IsNullOrWhiteSpace(revokeReason))
        {
            Notify(Texts.Get("crm.quoteShare.revokeReasonRequired"), failed: true);
            return;
        }

        busy = true;
        var result = await Api.PostAsync<QuoteShareLinkDto>($"/api/crm/quotes/{Quote.Id}/share-links/{link.Id}/revoke", new RevokeQuoteShareLinkRequest(revokeReason.Trim()));
        busy = false;
        Notify(result.IsSuccess ? Texts.Get("crm.quoteShare.revoked") : result.Error, !result.IsSuccess);
        revoking = null;
        await LoadAsync();
        await OnChanged.InvokeAsync();
    }

    private string FullUrl(QuoteShareLinkCreatedDto link) => Navigation.ToAbsoluteUri(link.Path).ToString();

    private async Task CopyAsync(QuoteShareLinkCreatedDto link)
    {
        try
        {
            await Js.InvokeVoidAsync("navigator.clipboard.writeText", FullUrl(link));
            Notify(Texts.Get("crm.quoteShare.copied"));
        }
        catch (JSException)
        {
            Notify(Texts.Get("crm.quoteShare.copyBlocked"), failed: true);
        }
    }

    private static string LinkState(string state) => state switch
    {
        "Active" => Texts.Get("crm.quoteShare.state.active"),
        "Expired" => Texts.Get("crm.quoteShare.state.expired"),
        "Revoked" => Texts.Get("crm.quoteShare.state.revoked"),
        _ => state,
    };

    private void Notify(string? text, bool failed = false)
    {
        notice = text;
        noticeFailed = failed;
    }

    private static string? Blank(string? text) => string.IsNullOrWhiteSpace(text) ? null : text.Trim();
}
