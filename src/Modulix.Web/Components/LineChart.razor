@* Çizgi grafik: kategoriler (genellikle tarih dilimleri) yatay eksende, her seri bir çizgi. SVG ile çizilir, ek betik gerekmez.
   Renk tek başına bilgi taşımaz: seriler farklı çizgi desenleri, noktalar <title> ile değer etiketi taşır ve gösterge her seriyi adıyla yazar.
   Değerlerin tamamı sayfadaki tablodadır (grafik tablonun alternatifi değil, özetidir). *@
@{
    const double width = 640;
    const double height = 280;
    const double left = 64;
    const double right = 16;
    const double top = 16;
    const double bottom = 48;
    var plotWidth = width - left - right;
    var plotHeight = height - top - bottom;
    var values = Series.SelectMany(s => s.Values).Where(v => v is not null).Select(v => v!.Value).ToList();
    var min = values.Count == 0 ? 0m : Math.Min(0m, values.Min());
    var max = values.Count == 0 ? 0m : Math.Max(0m, values.Max());
    if (max == min)
    {
        max = min + 1;
    }

    double X(int index) => Categories.Count <= 1 ? left + plotWidth / 2 : left + plotWidth * index / (Categories.Count - 1);
    double Y(decimal value) => top + plotHeight - (double)((value - min) / (max - min)) * plotHeight;
    var labelStep = Math.Max(1, (int)Math.Ceiling(Categories.Count / 8.0));
}
<div class="line-chart">
    <svg viewBox="0 0 @Num(width) @Num(height)" role="img" aria-label="@Title">
        @foreach (var tick in new[] { min, (min + max) / 2, max })
        {
            @* SVG <text> öğesi Razor'ın <text> etiketiyle karışmasın diye <g> içinde yazılır. *@
            <g>
                <line class="line-grid" x1="@Num(left)" x2="@Num(width - right)" y1="@Num(Y(tick))" y2="@Num(Y(tick))" />
                <text class="line-axis" x="@Num(left - 6)" y="@Num(Y(tick) + 4)" text-anchor="end">@tick.ToString("N0", Regional.Numbers)</text>
            </g>
        }

        @for (var c = 0; c < Categories.Count; c += labelStep)
        {
            <g>
                <text class="line-axis" x="@Num(X(c))" y="@Num(height - bottom + 18)" text-anchor="middle">@Categories[c]</text>
            </g>
        }

        @for (var s = 0; s < Series.Count; s++)
        {
            var series = Series[s];
            var color = s % 6;
            var dash = Dashes[s % Dashes.Length];
            var run = new List<string>();
            for (var c = 0; c < Categories.Count && c < series.Values.Count; c++)
            {
                if (series.Values[c] is { } point)
                {
                    run.Add($"{Num(X(c))},{Num(Y(point))}");
                }
                else if (run.Count > 0)
                {
                    <polyline class="line-path chart-c@(color)" points="@string.Join(' ', run)" stroke-dasharray="@dash" fill="none" />
                    run = [];
                }
            }

            if (run.Count > 0)
            {
                <polyline class="line-path chart-c@(color)" points="@string.Join(' ', run)" stroke-dasharray="@dash" fill="none" />
            }

            for (var c = 0; c < Categories.Count && c < series.Values.Count; c++)
            {
                if (series.Values[c] is { } dot)
                {
                    <circle class="line-dot chart-c@(color)" cx="@Num(X(c))" cy="@Num(Y(dot))" r="3.5">
                        <title>@series.Name · @Categories[c]: @dot.ToString("N2", Regional.Numbers)</title>
                    </circle>
                }
            }
        }
    </svg>
    <ul class="chart-legend">
        @for (var s = 0; s < Series.Count; s++)
        {
            <li><span class="chart-dot chart-bg-c@(s % 6)"></span>@Series[s].Name</li>
        }
    </ul>
</div>

@code {
    private static readonly string[] Dashes = ["none", "7 4", "2 4", "9 4 2 4", "1 5", "5 5"];

    [Parameter, EditorRequired] public IReadOnlyList<string> Categories { get; set; } = [];

    [Parameter, EditorRequired] public IReadOnlyList<LineSeries> Series { get; set; } = [];

    [Parameter] public string Title { get; set; } = "Çizgi grafik";

    private static string Num(double value) => value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
}
