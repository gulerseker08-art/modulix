@* Modulix logosu: uygulamadaki tek logo kaynağı (docs/design-system/README.md → Marka).
   Onaylı logo görselidir (işaret + "Modulix" yazısı, isteğe bağlı "İŞİN YENİ ZEKÂSI." sloganı); metin elle yazılmaz.
   Açık/koyu tema ve daraltılmış menü (yalnızca işaret) görünümünü CSS (data-theme, sidebar-collapsed) seçer. *@
<span class="brand-logo">
    <img class="brand-full brand-light" src="@FullSrc" alt="Modulix" width="@FullWidth" height="@Size" />
    <img class="brand-full brand-dark" src="@FullDarkSrc" alt="Modulix" width="@FullWidth" height="@Size" />
    <img class="brand-mark brand-light" src="img/modulix-mark.png" alt="Modulix" width="@MarkWidth" height="@Size" />
    <img class="brand-mark brand-dark" src="img/modulix-mark-dark.png" alt="Modulix" width="@MarkWidth" height="@Size" />
</span>

@code {
    // Görsel en-boy oranları (wwwroot/img): tam logo 960x226, işaret 318x256.
    private const double FullRatio = 960d / 226d;
    private const double MarkRatio = 318d / 256d;

    /// <summary>Logonun piksel yüksekliği (genişlik orandan hesaplanır). Slogan görünecekse yazı küçüleceği için daha büyük verilir.</summary>
    [Parameter]
    public int Size { get; set; } = 36;

    /// <summary>Slogan ("İŞİN YENİ ZEKÂSI.") gösterilsin mi; küçük boyutlarda okunmaz, bu yüzden varsayılan kapalıdır.</summary>
    [Parameter]
    public bool ShowTagline { get; set; }

    private string FullSrc => ShowTagline ? "img/modulix-logo.png" : "img/modulix-logo-wordmark.png";

    private string FullDarkSrc => ShowTagline ? "img/modulix-logo-dark.png" : "img/modulix-logo-wordmark-dark.png";

    private int FullWidth => (int)Math.Round(Size * FullRatio);

    private int MarkWidth => (int)Math.Round(Size * MarkRatio);
}
