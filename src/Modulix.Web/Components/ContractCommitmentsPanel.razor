@* Sözleşme taahhütleri (ADR-0022, dilim 7): tanım, dönem gerçekleşmeleri, tamamlama (ölçüm ve kanıt), muafiyet, iptal ve değerlendirme turu. Her dönem ayrı satırdır; tamamlanmış satır
   değiştirilmez. Modulix hiçbir ceza ya da finansal sonuç uygulamaz (sonuç maddesi yalnızca atıf notudur). *@
@inject ApiClient Api
@inject SessionState Session
@inject CrmLookups Lookups

<section class="detail-section" aria-labelledby="commitments-title">
    <div class="section-header">
        <h2 id="commitments-title">Taahhütler</h2>
        <div class="header-actions">
            @if (CanWrite && form is null)
            {
                <button type="button" class="btn btn-primary btn-sm" @onclick="NewCommitment">Taahhüt ekle</button>
                <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@busy" @onclick="EvaluateAsync">Değerlendir (ihlal ve eskalasyon)</button>
            }
        </div>
    </div>

    <Notice Text="@notice" Failed="@noticeFailed" />

    <p class="text-muted">
        Taahhüt, sözleşmeden doğan yükümlülüğün tanımıdır (teslimat, eğitim, kurulum, belge, raporlama, hizmet seviyesi…). Dönemsel taahhütte her dönem ayrı izlenir. Son tarih ve tolerans geçince
        gerçekleşme ihlal olur ve sorumluya takip aktivitesi açılır. Ceza ya da finansal sonuç otomatik uygulanmaz.
    </p>

    @if (form is not null)
    {
        <form class="record-form" novalidate @onsubmit="SaveAsync" @onsubmit:preventDefault>
            <h3>@(form.Id is null ? "Yeni taahhüt" : "Taahhüdü düzenle")</h3>
            @if (errors is { Count: > 0 })
            {
                <div class="alert alert-danger" role="alert"><ul class="mb-0">@foreach (var (_, messages) in errors) { foreach (var message in messages) { <li>@message</li> } }</ul></div>
            }
            <div class="form-grid">
                <div class="wide">
                    <label class="form-label" for="cm-title">Başlık *</label>
                    <input id="cm-title" class="form-control" maxlength="200" @bind="form.Title" />
                </div>
                <div>
                    <label class="form-label" for="cm-cat">Kategori</label>
                    <select id="cm-cat" class="form-select" @bind="form.Category">
                        @foreach (var c in Lookups.Choices(ContractsAccess.CommitmentCategoryList, form.Category)) { <option value="@c.Key">@c.Label</option> }
                    </select>
                </div>
                <div>
                    <label class="form-label" for="cm-obl">Yükümlü taraf</label>
                    <select id="cm-obl" class="form-select" @bind="form.Obligor">
                        @foreach (var o in CommitmentLabels.Obligors) { <option value="@o.Key">@o.Label</option> }
                    </select>
                </div>
                <div>
                    <label class="form-label" for="cm-resp">Sorumlu</label>
                    <select id="cm-resp" class="form-select" @bind="form.ResponsibleUserId">
                        <option value="">—</option>
                        @foreach (var m in Lookups.Members) { <option value="@m.UserId">@m.DisplayName</option> }
                    </select>
                </div>
                <div>
                    <label class="form-label" for="cm-kind">Tür</label>
                    <select id="cm-kind" class="form-select" @bind="form.Kind" disabled="@lockedSchedule">
                        @foreach (var k in CommitmentLabels.Kinds) { <option value="@k.Key">@k.Label</option> }
                    </select>
                </div>
                <div>
                    <label class="form-label" for="cm-start">Başlangıç *</label>
                    <input id="cm-start" class="form-control" type="date" @bind="form.StartDate" disabled="@lockedSchedule" />
                </div>
                <div>
                    <label class="form-label" for="cm-due">@(form.Kind == "Periodic" ? "İlk son tarih *" : "Son tarih *")</label>
                    <input id="cm-due" class="form-control" type="date" @bind="form.DueDate" disabled="@lockedSchedule" />
                </div>
                @if (form.Kind == "Periodic")
                {
                    <div>
                        <label class="form-label" for="cm-rec">Tekrar *</label>
                        <select id="cm-rec" class="form-select" @bind="form.Recurrence" disabled="@lockedSchedule">
                            <option value="">Seçin…</option>
                            @foreach (var r in CommitmentLabels.Recurrences) { <option value="@r.Key">@r.Label</option> }
                        </select>
                    </div>
                    <div>
                        <label class="form-label" for="cm-recend">Tekrar bitişi (boş = sözleşme bitişi)</label>
                        <input id="cm-recend" class="form-control" type="date" @bind="form.RecurrenceEndDate" disabled="@lockedSchedule" />
                    </div>
                }
                <div>
                    <label class="form-label" for="cm-grace">Tolerans süresi (gün)</label>
                    <input id="cm-grace" class="form-control" type="number" min="0" max="365" @bind="form.GraceDays" />
                </div>
                <div>
                    <label class="form-label" for="cm-esc">Eskalasyon (ihlalden gün sonra; 0 = kapalı)</label>
                    <input id="cm-esc" class="form-control" type="number" min="0" max="365" @bind="form.EscalateAfterDays" />
                </div>
                <div>
                    <label class="form-label" for="cm-escuser">Eskalasyon kullanıcısı</label>
                    <select id="cm-escuser" class="form-select" @bind="form.EscalationUserId">
                        <option value="">—</option>
                        @foreach (var m in Lookups.Members) { <option value="@m.UserId">@m.DisplayName</option> }
                    </select>
                </div>
                <div>
                    <label class="form-label" for="cm-dep">Bağımlı olduğu taahhüt</label>
                    <select id="cm-dep" class="form-select" @bind="form.DependsOnCommitmentId">
                        <option value="">—</option>
                        @foreach (var other in commitments.Where(c => c.Id != form.Id && c.Status == "Active")) { <option value="@other.Id">@other.Title</option> }
                    </select>
                </div>
                <div>
                    <label class="form-label" for="cm-metric">Ölçüt (isteğe bağlı)</label>
                    <input id="cm-metric" class="form-control" maxlength="100" placeholder="Ör. Aylık erişilebilirlik" @bind="form.MetricName" disabled="@lockedSchedule" />
                </div>
                <div>
                    <label class="form-label" for="cm-dir">Yön</label>
                    <select id="cm-dir" class="form-select" @bind="form.Direction" disabled="@lockedSchedule">
                        <option value="">—</option>
                        @foreach (var d in CommitmentLabels.Directions) { <option value="@d.Key">@d.Label</option> }
                    </select>
                </div>
                <div>
                    <label class="form-label" for="cm-target">Hedef</label>
                    <input id="cm-target" class="form-control" type="number" step="any" min="0" @bind="form.TargetValue" disabled="@lockedSchedule" />
                </div>
                <div>
                    <label class="form-label" for="cm-tol">Tolerans</label>
                    <input id="cm-tol" class="form-control" type="number" step="any" min="0" @bind="form.Tolerance" disabled="@lockedSchedule" />
                </div>
                <div>
                    <label class="form-label" for="cm-unit">Birim</label>
                    <input id="cm-unit" class="form-control" maxlength="30" placeholder="%, saat, adet" @bind="form.Unit" disabled="@lockedSchedule" />
                </div>
                <div class="wide">
                    <label class="form-label" for="cm-desc">Açıklama</label>
                    <textarea id="cm-desc" class="form-control" rows="2" maxlength="2000" @bind="form.Description"></textarea>
                </div>
                <div class="wide">
                    <label class="form-label" for="cm-cons">Sonuç maddesi atfı (yalnızca not; ceza uygulanmaz)</label>
                    <input id="cm-cons" class="form-control" maxlength="2000" @bind="form.ConsequenceNote" />
                </div>
            </div>
            @if (lockedSchedule) { <p class="small text-muted">Gerçekleşmesi kaydedilmiş taahhütte takvim ve ölçüm değiştirilemez; önceki kayıtlar yeniden yazılmaz.</p> }
            <div class="form-actions">
                <button type="submit" class="btn btn-primary" disabled="@busy">Kaydet</button>
                <button type="button" class="btn btn-outline-secondary" @onclick="CancelForm">Vazgeç</button>
                @if (form.Id is not null) { <button type="button" class="btn btn-outline-danger ms-auto" disabled="@busy" @onclick="DeleteAsync">Sil</button> }
            </div>
        </form>
    }

    @if (loading)
    {
        <LoadingState />
    }
    else if (commitments.Count == 0)
    {
        <p class="text-muted">Bu sözleşmede taahhüt yok.</p>
    }

    @foreach (var c in commitments)
    {
        var mine = occurrences.Where(o => o.CommitmentId == c.Id).OrderBy(o => o.Sequence).ToList();
        <article class="signature-request" aria-label="@c.Title">
            <h3>
                <span class="badge stage-@CommitmentLabels.Badge(c.Status)">@CommitmentLabels.Label(CommitmentLabels.Statuses, c.Status)</span>
                @c.Title
                <small class="text-muted">@Lookups.Label(ContractsAccess.CommitmentCategoryList, c.Category) · @CommitmentLabels.Label(CommitmentLabels.Kinds, c.Kind)@(c.Recurrence is null ? string.Empty : " · " + CommitmentLabels.Label(CommitmentLabels.Recurrences, c.Recurrence))</small>
            </h3>
            <p class="small text-muted">
                Yükümlü: @CommitmentLabels.Label(CommitmentLabels.Obligors, c.Obligor) · Sorumlu: @(c.ResponsibleUserId is null ? "—" : Lookups.MemberName(c.ResponsibleUserId))
                · @ContractLabels.Date(c.StartDate) – @(c.RecurrenceEndDate is { } end ? ContractLabels.Date(end) : c.Kind == "Periodic" ? "açık uçlu / sözleşme bitişi" : ContractLabels.Date(c.DueDate))
                · tolerans @c.GraceDays gün@(c.EscalateAfterDays > 0 ? $" · eskalasyon {c.EscalateAfterDays} gün sonra" : string.Empty)
                @if (c.MetricName is not null) { <span> · Ölçüt: @CommitmentLabels.Target(c.MetricName, c.Direction, c.TargetValue, c.Tolerance, c.Unit)</span> }
                @if (c.DependsOnCommitmentId is { } dep) { <span> · Bağımlı: @(commitments.FirstOrDefault(x => x.Id == dep)?.Title ?? "—")</span> }
                @if (c.ConsequenceNote is not null) { <span> · Sonuç maddesi: @c.ConsequenceNote</span> }
            </p>
            @if (!string.IsNullOrWhiteSpace(c.Description)) { <p>@c.Description</p> }

            <table class="table record-table">
                <caption class="visually-hidden">@c.Title gerçekleşmeleri</caption>
                <thead><tr><th scope="col">Dönem</th><th scope="col">Son tarih</th><th scope="col">Durum</th><th scope="col">Gerçekleşme</th><th scope="col">İşlem</th></tr></thead>
                <tbody>
                    @foreach (var o in mine)
                    {
                        <tr>
                            <td data-label="Dönem">@o.Sequence</td>
                            <td data-label="Son tarih">@ContractLabels.Date(o.DueDate)@if (o.IsOverdue) { <div class="small text-danger">@o.DaysOverdue gün gecikti</div> }</td>
                            <td data-label="Durum">
                                <span class="badge stage-@CommitmentLabels.Badge(o.Status, o.IsOverdue && o.Status == "Open")">@CommitmentLabels.Label(CommitmentLabels.OccurrenceStatuses, o.Status)@(o.CompletedOn is not null && o.Status == "Breached" ? " (geç/eksik tamamlandı)" : string.Empty)</span>
                                @if (o.BreachReason is not null) { <div class="small text-danger">@o.BreachReason</div> }
                                @if (o.WaiveReason is not null) { <div class="small text-muted">Muafiyet: @o.WaiveReason</div> }
                                @if (o.Status == "Breached") { <div class="small text-muted">@CommitmentLabels.Label(CommitmentLabels.FollowUps, o.FollowUpStatus)@(o.EscalatedAt is not null ? " · eskale edildi" : string.Empty)</div> }
                            </td>
                            <td data-label="Gerçekleşme">
                                @if (o.CompletedOn is { } done)
                                {
                                    <div>@ContractLabels.Date(done) · @Lookups.MemberName(o.CompletedBy)</div>
                                    @if (o.ActualValue is { } actual) { <div class="small">Gerçekleşen: @actual.ToString("0.######", Regional.Numbers)@(o.Unit is null ? string.Empty : " " + o.Unit) @(o.MetTarget == true ? "(hedef karşılandı)" : o.MetTarget == false ? "(hedef karşılanmadı)" : string.Empty)</div> }
                                    @if (o.Note is not null) { <div class="small text-muted">@o.Note</div> }
                                    @if (o.EvidenceFileId is { } fileId && CanDownload) { <div class="small"><a href="api/contracts/commitments/@c.Id/occurrences/@o.Id/files/@fileId" download>@(o.EvidenceFileName ?? "Kanıt")</a></div> }
                                }
                                else { <span class="text-muted">—</span> }
                            </td>
                            <td class="actions">
                                @if (o.CanComplete && CanComplete) { <button type="button" class="btn btn-outline-primary btn-sm" @onclick="() => OpenComplete(o)">Gerçekleşmeyi kaydet</button> }
                                else if (o.BlockedByDue is { } blocked) { <span class="small text-muted">Bağlı taahhüt (@ContractLabels.Date(blocked)) bekleniyor</span> }
                                @if (c.Status == "Active" && CanWaive && o.Status is "Open" or "Breached" && o.CompletedOn is null) { <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => OpenWaive(o)">Muaf tut</button> }
                            </td>
                        </tr>
                        @if (completeFor == o.Id)
                        {
                            <tr>
                                <td colspan="5">
                                    <form class="record-form" novalidate @onsubmit="() => CompleteAsync(c, o)" @onsubmit:preventDefault>
                                        <h4>Dönem @o.Sequence gerçekleşmesi</h4>
                                        @if (errors is { Count: > 0 })
                                        {
                                            <div class="alert alert-danger" role="alert"><ul class="mb-0">@foreach (var (_, messages) in errors) { foreach (var message in messages) { <li>@message</li> } }</ul></div>
                                        }
                                        <div class="form-grid">
                                            <div>
                                                <label class="form-label" for="co-date">Tamamlanma tarihi *</label>
                                                <input id="co-date" class="form-control" type="date" @bind="completeDate" />
                                            </div>
                                            @if (o.MetricName is not null)
                                            {
                                                <div>
                                                    <label class="form-label" for="co-actual">Gerçekleşen değer * (@CommitmentLabels.Target(o.MetricName, o.Direction, o.TargetValue, o.Tolerance, o.Unit))</label>
                                                    <input id="co-actual" class="form-control" type="number" step="any" min="0" @bind="completeActual" />
                                                </div>
                                            }
                                            <div>
                                                <label class="form-label" for="co-file">Kanıt belgesi (PDF, PNG, JPEG; en fazla 10 MB)</label>
                                                <InputFile id="co-file" class="form-control" accept="application/pdf,image/png,image/jpeg" OnChange="PickFileAsync" />
                                                @if (completeFileName is not null) { <div class="form-text">@completeFileName</div> }
                                            </div>
                                            <div class="wide">
                                                <label class="form-label" for="co-note">Not</label>
                                                <input id="co-note" class="form-control" maxlength="1000" @bind="completeNote" />
                                            </div>
                                        </div>
                                        <div class="form-actions">
                                            <button type="submit" class="btn btn-primary" disabled="@busy">Kaydet</button>
                                            <button type="button" class="btn btn-link" @onclick="CloseForms">Vazgeç</button>
                                        </div>
                                    </form>
                                </td>
                            </tr>
                        }
                        @if (waiveFor == o.Id)
                        {
                            <tr>
                                <td colspan="5">
                                    <form class="record-form" novalidate @onsubmit="() => WaiveAsync(c, o)" @onsubmit:preventDefault>
                                        <label class="form-label" for="wv-reason">Muafiyet gerekçesi *</label>
                                        <input id="wv-reason" class="form-control" maxlength="500" @bind="reasonText" />
                                        <div class="form-actions">
                                            <button type="submit" class="btn btn-danger" disabled="@busy">Muaf tut</button>
                                            <button type="button" class="btn btn-link" @onclick="CloseForms">Vazgeç</button>
                                        </div>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
            @if (CanWrite && c.Status == "Active")
            {
                <div class="header-actions">
                    <button type="button" class="btn btn-outline-primary btn-sm" @onclick="() => Edit(c)">Düzenle</button>
                    <button type="button" class="btn btn-outline-danger btn-sm" @onclick="() => cancelFor = c.Id">Taahhüdü iptal et</button>
                </div>
                @if (cancelFor == c.Id)
                {
                    <form class="record-form" novalidate @onsubmit="() => CancelAsync(c)" @onsubmit:preventDefault>
                        <label class="form-label" for="cn-reason">İptal gerekçesi *</label>
                        <input id="cn-reason" class="form-control" maxlength="500" @bind="reasonText" />
                        <div class="form-actions">
                            <button type="submit" class="btn btn-danger" disabled="@busy">İptal et</button>
                            <button type="button" class="btn btn-link" @onclick="CloseForms">Vazgeç</button>
                        </div>
                    </form>
                }
            }
        </article>
    }
</section>

@code {
    private const long MaxBytes = 10 * 1024 * 1024;

    private List<ContractCommitmentDto> commitments = [];
    private List<CommitmentOccurrenceDto> occurrences = [];
    private CommitmentForm? form;
    private IReadOnlyDictionary<string, string[]>? errors;
    private string? notice;
    private bool noticeFailed;
    private bool busy;
    private bool loading = true;
    private string? loadedFor;
    private Guid? completeFor;
    private Guid? waiveFor;
    private Guid? cancelFor;
    private DateTime? completeDate;
    private decimal? completeActual;
    private string? completeNote;
    private string? completeFileName;
    private byte[]? completeContent;
    private string reasonText = string.Empty;

    [Parameter, EditorRequired] public ContractDto Contract { get; set; } = null!;

    [Parameter] public EventCallback Changed { get; set; }

    private bool CanWrite => Session.Can(ContractsAccess.CommitmentsWrite);

    private bool CanComplete => Session.Can(ContractsAccess.CommitmentsComplete);

    private bool CanWaive => Session.Can(ContractsAccess.CommitmentsWaive);

    private bool CanDownload => Session.Can(ContractsAccess.DocumentsDownload);

    private bool lockedSchedule => form?.Id is { } id && occurrences.Any(o => o.CommitmentId == id && o.Status != "Open");

    protected override async Task OnParametersSetAsync()
    {
        var key = $"{Contract.Id}";
        if (key == loadedFor) { return; }
        loadedFor = key;
        await Lookups.LoadAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        var (loaded, error) = await Api.GetAllAsync<ContractCommitmentDto>($"/api/contracts/commitments?contractId={Contract.Id}");
        commitments = loaded ?? [];
        occurrences = (await Api.GetAsync<List<CommitmentOccurrenceDto>>($"/api/contracts/commitments/occurrences?contractId={Contract.Id}&includeClosed=true")).Value ?? [];
        loading = false;
        if (error is not null) { Notify(error, true); }
    }

    private void NewCommitment()
    {
        CloseForms();
        form = new CommitmentForm { Category = Lookups.DefaultOf(ContractsAccess.CommitmentCategoryList) ?? "Delivery", StartDate = DateTime.Today, DueDate = DateTime.Today.AddDays(30) };
    }

    private void Edit(ContractCommitmentDto c)
    {
        CloseForms();
        form = new CommitmentForm
        {
            Id = c.Id, Version = c.Version, Title = c.Title, Description = c.Description, Category = c.Category, Obligor = c.Obligor, ResponsibleUserId = c.ResponsibleUserId?.ToString() ?? string.Empty,
            EscalationUserId = c.EscalationUserId?.ToString() ?? string.Empty, Kind = c.Kind, StartDate = c.StartDate.ToDateTime(TimeOnly.MinValue), DueDate = c.DueDate.ToDateTime(TimeOnly.MinValue),
            Recurrence = c.Recurrence ?? string.Empty, RecurrenceEndDate = c.RecurrenceEndDate?.ToDateTime(TimeOnly.MinValue), GraceDays = c.GraceDays, EscalateAfterDays = c.EscalateAfterDays,
            MetricName = c.MetricName, Unit = c.Unit, Direction = c.Direction ?? string.Empty, TargetValue = c.TargetValue, Tolerance = c.Tolerance,
            DependsOnCommitmentId = c.DependsOnCommitmentId?.ToString() ?? string.Empty, ConsequenceNote = c.ConsequenceNote,
        };
    }

    private void CancelForm()
    {
        form = null;
        errors = null;
    }

    private async Task SaveAsync()
    {
        if (busy || form is null) { return; }
        busy = true;
        var f = form;
        var request = new SaveContractCommitmentRequest(
            Contract.Id, f.Title, DateOnly.FromDateTime(f.StartDate ?? DateTime.Today), DateOnly.FromDateTime(f.DueDate ?? DateTime.Today), Blank(f.Description), Blank(f.Category), f.Obligor,
            Guid.TryParse(f.ResponsibleUserId, out var responsible) ? responsible : null, Guid.TryParse(f.EscalationUserId, out var escalation) ? escalation : null, f.Kind,
            f.Kind == "Periodic" ? Blank(f.Recurrence) : null, f.Kind == "Periodic" && f.RecurrenceEndDate is { } end ? DateOnly.FromDateTime(end) : null, f.GraceDays, f.EscalateAfterDays,
            Blank(f.MetricName), Blank(f.Unit), Blank(f.Direction), f.TargetValue, f.Tolerance, Guid.TryParse(f.DependsOnCommitmentId, out var dependency) ? dependency : null, Blank(f.ConsequenceNote), f.Version);
        var result = f.Id is { } id
            ? await Api.PutAsync<ContractCommitmentDto>($"/api/contracts/commitments/{id}", request)
            : await Api.PostAsync<ContractCommitmentDto>("/api/contracts/commitments", request);
        busy = false;
        if (result.IsSuccess)
        {
            form = null;
            errors = null;
            Notify("Taahhüt kaydedildi.", false);
            await LoadAsync();
            await Changed.InvokeAsync();
            return;
        }

        errors = result.FieldErrors;
        Notify(result.Error, true);
    }

    private async Task DeleteAsync()
    {
        if (busy || form?.Id is not { } id) { return; }
        busy = true;
        var result = await Api.DeleteAsync($"/api/contracts/commitments/{id}?version={form.Version}");
        busy = false;
        Notify(result.IsSuccess ? "Taahhüt silindi." : result.Error, !result.IsSuccess);
        if (result.IsSuccess) { form = null; await LoadAsync(); }
    }

    private void OpenComplete(CommitmentOccurrenceDto o)
    {
        CloseForms();
        completeFor = o.Id;
        completeDate = DateTime.Today;
    }

    private void OpenWaive(CommitmentOccurrenceDto o)
    {
        CloseForms();
        waiveFor = o.Id;
    }

    private async Task PickFileAsync(InputFileChangeEventArgs e)
    {
        completeContent = null;
        completeFileName = null;
        var file = e.File;
        if (file.Size > MaxBytes)
        {
            errors = new Dictionary<string, string[]> { ["file"] = ["Dosya en fazla 10 MB olabilir."] };
            return;
        }

        using var stream = file.OpenReadStream(MaxBytes);
        using var buffer = new MemoryStream();
        await stream.CopyToAsync(buffer);
        completeContent = buffer.ToArray();
        completeFileName = file.Name;
        errors = null;
    }

    private async Task CompleteAsync(ContractCommitmentDto c, CommitmentOccurrenceDto o)
    {
        if (busy) { return; }
        busy = true;
        var request = new CompleteOccurrenceRequest(DateOnly.FromDateTime(completeDate ?? DateTime.Today), completeActual, Blank(completeNote), completeFileName, completeContent is null ? null : Convert.ToBase64String(completeContent));
        var result = await Api.PostAsync<CommitmentOccurrenceDto>($"/api/contracts/commitments/{c.Id}/occurrences/{o.Id}/complete", request);
        busy = false;
        await FinishAsync(result.IsSuccess, result.Error, result.FieldErrors, result.Value?.Status == "Breached" ? "Gerçekleşme kaydedildi: İHLAL (hedef karşılanmadı ya da geç)." : "Gerçekleşme kaydedildi.");
    }

    private async Task WaiveAsync(ContractCommitmentDto c, CommitmentOccurrenceDto o)
    {
        if (busy) { return; }
        busy = true;
        var result = await Api.PostAsync<CommitmentOccurrenceDto>($"/api/contracts/commitments/{c.Id}/occurrences/{o.Id}/waive", new SignatureReasonRequest(reasonText));
        busy = false;
        await FinishAsync(result.IsSuccess, result.Error, result.FieldErrors, "Muafiyet kaydedildi.");
    }

    private async Task CancelAsync(ContractCommitmentDto c)
    {
        if (busy) { return; }
        busy = true;
        var result = await Api.PostAsync<ContractCommitmentDto>($"/api/contracts/commitments/{c.Id}/cancel", new SignatureReasonRequest(reasonText));
        busy = false;
        await FinishAsync(result.IsSuccess, result.Error, result.FieldErrors, "Taahhüt iptal edildi.");
    }

    private async Task EvaluateAsync()
    {
        if (busy) { return; }
        busy = true;
        var result = await Api.PostAsync<CommitmentEvaluationDto>("/api/contracts/commitments/evaluate", new CommitmentEvaluateRequest(Contract.Id));
        busy = false;
        var v = result.Value;
        await FinishAsync(result.IsSuccess, result.Error, result.FieldErrors,
            v is null ? "Değerlendirildi." : $"Değerlendirildi: {v.Breached} ihlal, {v.Escalated} eskalasyon, {v.FollowUpsCreated} takip aktivitesi, {v.OccurrencesCreated} yeni dönem.");
    }

    private async Task FinishAsync(bool success, string? error, IReadOnlyDictionary<string, string[]>? fieldErrors, string message)
    {
        if (success)
        {
            CloseForms();
            Notify(message, false);
            await LoadAsync();
            await Changed.InvokeAsync();
            return;
        }

        errors = fieldErrors;
        Notify(error, true);
    }

    private void CloseForms()
    {
        completeFor = null;
        waiveFor = null;
        cancelFor = null;
        errors = null;
        reasonText = string.Empty;
        completeActual = null;
        completeNote = null;
        completeFileName = null;
        completeContent = null;
    }

    private void Notify(string? text, bool failed)
    {
        notice = text;
        noticeFailed = failed;
    }

    private static string? Blank(string? text) => string.IsNullOrWhiteSpace(text) ? null : text.Trim();

    private sealed class CommitmentForm
    {
        public Guid? Id { get; init; }
        public long? Version { get; init; }
        public string Title { get; set; } = string.Empty;
        public string? Description { get; set; }
        public string Category { get; set; } = string.Empty;
        public string Obligor { get; set; } = "Provider";
        public string ResponsibleUserId { get; set; } = string.Empty;
        public string EscalationUserId { get; set; } = string.Empty;
        public string Kind { get; set; } = "OneTime";
        public DateTime? StartDate { get; set; }
        public DateTime? DueDate { get; set; }
        public string Recurrence { get; set; } = string.Empty;
        public DateTime? RecurrenceEndDate { get; set; }
        public int GraceDays { get; set; }
        public int EscalateAfterDays { get; set; }
        public string? MetricName { get; set; }
        public string? Unit { get; set; }
        public string Direction { get; set; } = string.Empty;
        public decimal? TargetValue { get; set; }
        public decimal? Tolerance { get; set; }
        public string DependsOnCommitmentId { get; set; } = string.Empty;
        public string? ConsequenceNote { get; set; }
    }
}
