@* Sözleşme taahhütleri (ADR-0022, dilim 7): tanım, dönem gerçekleşmeleri, tamamlama (ölçüm ve kanıt), muafiyet, iptal ve değerlendirme turu. Her dönem ayrı satırdır; tamamlanmış satır
   değiştirilmez. Modulix hiçbir ceza ya da finansal sonuç uygulamaz (sonuç maddesi yalnızca atıf notudur). *@
@inject ApiClient Api
@inject SessionState Session
@inject CrmLookups Lookups

<section class="detail-section" aria-labelledby="commitments-title">
    <div class="section-header">
        <h2 id="commitments-title">@Texts.Get("contracts.commitmentsPanel.title")</h2>
        <div class="header-actions">
            @if (CanWrite && form is null)
            {
                <button type="button" class="btn btn-primary btn-sm" @onclick="NewCommitment">@Texts.Get("contracts.commitmentsPanel.add")</button>
                <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@busy" @onclick="EvaluateAsync">@Texts.Get("contracts.commitmentsPanel.evaluate")</button>
            }
        </div>
    </div>

    <Notice Text="@notice" Failed="@noticeFailed" />

    <p class="text-muted">
        @Texts.Get("contracts.commitmentsPanel.intro")
    </p>

    @if (form is not null)
    {
        <form class="record-form" novalidate @onsubmit="SaveAsync" @onsubmit:preventDefault>
            <h3>@Texts.Get(form.Id is null ? "contracts.commitmentsPanel.new" : "contracts.commitmentsPanel.edit")</h3>
            @if (errors is { Count: > 0 })
            {
                <div class="alert alert-danger" role="alert"><ul class="mb-0">@foreach (var (_, messages) in errors) { foreach (var message in messages) { <li>@message</li> } }</ul></div>
            }
            <div class="form-grid">
                <div class="wide">
                    <label class="form-label" for="cm-title">@Texts.Get("contracts.commitmentsPanel.titleRequired")</label>
                    <input id="cm-title" class="form-control" maxlength="200" @bind="form.Title" />
                </div>
                <div>
                    <label class="form-label" for="cm-cat">@Texts.Get("contracts.commitmentsPanel.category")</label>
                    <select id="cm-cat" class="form-select" @bind="form.Category">
                        @foreach (var c in Lookups.Choices(ContractsAccess.CommitmentCategoryList, form.Category)) { <option value="@c.Key">@c.Label</option> }
                    </select>
                </div>
                <div>
                    <label class="form-label" for="cm-obl">@Texts.Get("contracts.commitmentsPanel.obligor")</label>
                    <select id="cm-obl" class="form-select" @bind="form.Obligor">
                        @foreach (var o in CommitmentLabels.Obligors) { <option value="@o.Key">@o.Label</option> }
                    </select>
                </div>
                <div>
                    <label class="form-label" for="cm-resp">@Texts.Get("common.field.owner")</label>
                    <select id="cm-resp" class="form-select" @bind="form.ResponsibleUserId">
                        <option value="">—</option>
                        @foreach (var m in Lookups.Members) { <option value="@m.UserId">@m.DisplayName</option> }
                    </select>
                </div>
                <div>
                    <label class="form-label" for="cm-kind">@Texts.Get("contracts.field.type")</label>
                    <select id="cm-kind" class="form-select" @bind="form.Kind" disabled="@lockedSchedule">
                        @foreach (var k in CommitmentLabels.Kinds) { <option value="@k.Key">@k.Label</option> }
                    </select>
                </div>
                <div>
                    <label class="form-label" for="cm-start">@Texts.Get("contracts.commitmentsPanel.startRequired")</label>
                    <input id="cm-start" class="form-control" type="date" @bind="form.StartDate" disabled="@lockedSchedule" />
                </div>
                <div>
                    <label class="form-label" for="cm-due">@Texts.Get(form.Kind == "Periodic" ? "contracts.commitmentsPanel.firstDueRequired" : "contracts.commitmentsPanel.dueRequired")</label>
                    <input id="cm-due" class="form-control" type="date" @bind="form.DueDate" disabled="@lockedSchedule" />
                </div>
                @if (form.Kind == "Periodic")
                {
                    <div>
                        <label class="form-label" for="cm-rec">@Texts.Get("contracts.commitmentsPanel.recurrenceRequired")</label>
                        <select id="cm-rec" class="form-select" @bind="form.Recurrence" disabled="@lockedSchedule">
                            <option value="">@Texts.Get("common.choose")</option>
                            @foreach (var r in CommitmentLabels.Recurrences) { <option value="@r.Key">@r.Label</option> }
                        </select>
                    </div>
                    <div>
                        <label class="form-label" for="cm-recend">@Texts.Get("contracts.commitmentsPanel.recurrenceEnd")</label>
                        <input id="cm-recend" class="form-control" type="date" @bind="form.RecurrenceEndDate" disabled="@lockedSchedule" />
                    </div>
                }
                <div>
                    <label class="form-label" for="cm-grace">@Texts.Get("contracts.commitmentsPanel.graceDays")</label>
                    <input id="cm-grace" class="form-control" type="number" min="0" max="365" @bind="form.GraceDays" />
                </div>
                <div>
                    <label class="form-label" for="cm-esc">@Texts.Get("contracts.commitmentsPanel.escalateAfter")</label>
                    <input id="cm-esc" class="form-control" type="number" min="0" max="365" @bind="form.EscalateAfterDays" />
                </div>
                <div>
                    <label class="form-label" for="cm-escuser">@Texts.Get("contracts.commitmentsPanel.escalationUser")</label>
                    <select id="cm-escuser" class="form-select" @bind="form.EscalationUserId">
                        <option value="">—</option>
                        @foreach (var m in Lookups.Members) { <option value="@m.UserId">@m.DisplayName</option> }
                    </select>
                </div>
                <div>
                    <label class="form-label" for="cm-dep">@Texts.Get("contracts.commitmentsPanel.dependsOn")</label>
                    <select id="cm-dep" class="form-select" @bind="form.DependsOnCommitmentId">
                        <option value="">—</option>
                        @foreach (var other in commitments.Where(c => c.Id != form.Id && c.Status == "Active")) { <option value="@other.Id">@other.Title</option> }
                    </select>
                </div>
                <div>
                    <label class="form-label" for="cm-metric">@Texts.Get("contracts.commitmentsPanel.metric")</label>
                    <input id="cm-metric" class="form-control" maxlength="100" placeholder="@Texts.Get("contracts.commitmentsPanel.metricPlaceholder")" @bind="form.MetricName" disabled="@lockedSchedule" />
                </div>
                <div>
                    <label class="form-label" for="cm-dir">@Texts.Get("contracts.commitmentsPanel.direction")</label>
                    <select id="cm-dir" class="form-select" @bind="form.Direction" disabled="@lockedSchedule">
                        <option value="">—</option>
                        @foreach (var d in CommitmentLabels.Directions) { <option value="@d.Key">@d.Label</option> }
                    </select>
                </div>
                <div>
                    <label class="form-label" for="cm-target">@Texts.Get("contracts.commitmentsPanel.target")</label>
                    <input id="cm-target" class="form-control" type="number" step="any" min="0" @bind="form.TargetValue" disabled="@lockedSchedule" />
                </div>
                <div>
                    <label class="form-label" for="cm-tol">@Texts.Get("contracts.commitmentsPanel.tolerance")</label>
                    <input id="cm-tol" class="form-control" type="number" step="any" min="0" @bind="form.Tolerance" disabled="@lockedSchedule" />
                </div>
                <div>
                    <label class="form-label" for="cm-unit">@Texts.Get("contracts.field.unitname")</label>
                    <input id="cm-unit" class="form-control" maxlength="30" placeholder="@Texts.Get("contracts.commitmentsPanel.unitPlaceholder")" @bind="form.Unit" disabled="@lockedSchedule" />
                </div>
                <div class="wide">
                    <label class="form-label" for="cm-desc">@Texts.Get("contracts.field.description")</label>
                    <textarea id="cm-desc" class="form-control" rows="2" maxlength="2000" @bind="form.Description"></textarea>
                </div>
                <div class="wide">
                    <label class="form-label" for="cm-cons">@Texts.Get("contracts.commitmentsPanel.consequence")</label>
                    <input id="cm-cons" class="form-control" maxlength="2000" @bind="form.ConsequenceNote" />
                </div>
            </div>
            @if (lockedSchedule) { <p class="small text-muted">@Texts.Get("contracts.commitmentsPanel.locked")</p> }
            <div class="form-actions">
                <button type="submit" class="btn btn-primary" disabled="@busy">@Texts.Get("common.save")</button>
                <button type="button" class="btn btn-outline-secondary" @onclick="CancelForm">@Texts.Get("common.dismiss")</button>
                @if (form.Id is not null) { <button type="button" class="btn btn-outline-danger ms-auto" disabled="@busy" @onclick="DeleteAsync">@Texts.Get("common.delete")</button> }
            </div>
        </form>
    }

    @if (loading)
    {
        <p class="text-muted" role="status">@Texts.Get("common.loading")</p>
    }
    else if (commitments.Count == 0)
    {
        <p class="text-muted">@Texts.Get("contracts.commitmentsPanel.empty")</p>
    }

    @foreach (var c in commitments)
    {
        var mine = occurrences.Where(o => o.CommitmentId == c.Id).OrderBy(o => o.Sequence).ToList();
        <article class="signature-request" aria-label="@c.Title">
            <h3>
                <span class="badge stage-@CommitmentLabels.Badge(c.Status)">@CommitmentLabels.Label(CommitmentLabels.Statuses, c.Status)</span>
                @c.Title
                <small class="text-muted">@Lookups.Label(ContractsAccess.CommitmentCategoryList, c.Category) · @CommitmentLabels.Label(CommitmentLabels.Kinds, c.Kind)@(c.Recurrence is null ? string.Empty : " · " + CommitmentLabels.Label(CommitmentLabels.Recurrences, c.Recurrence))</small>
            </h3>
            <p class="small text-muted">
                @Texts.Get("contracts.commitmentsPanel.parties", CommitmentLabels.Label(CommitmentLabels.Obligors, c.Obligor), c.ResponsibleUserId is null ? "—" : Lookups.MemberName(c.ResponsibleUserId))
                · @ContractLabels.Date(c.StartDate) – @(c.RecurrenceEndDate is { } end ? ContractLabels.Date(end) : c.Kind == "Periodic" ? Texts.Get("contracts.commitmentsPanel.openEnded") : ContractLabels.Date(c.DueDate))
                · @Texts.Get("contracts.commitmentsPanel.graceSummary", c.GraceDays)@(c.EscalateAfterDays > 0 ? " · " + Texts.Get("contracts.commitmentsPanel.escalationSummary", c.EscalateAfterDays) : string.Empty)
                @if (c.MetricName is not null) { <span> · @Texts.Get("contracts.commitmentsPanel.metricSummary", CommitmentLabels.Target(c.MetricName, c.Direction, c.TargetValue, c.Tolerance, c.Unit))</span> }
                @if (c.DependsOnCommitmentId is { } dep) { <span> · @Texts.Get("contracts.commitmentsPanel.dependsSummary", commitments.FirstOrDefault(x => x.Id == dep)?.Title ?? "—")</span> }
                @if (c.ConsequenceNote is not null) { <span> · @Texts.Get("contracts.commitmentsPanel.consequenceSummary", c.ConsequenceNote)</span> }
            </p>
            @if (!string.IsNullOrWhiteSpace(c.Description)) { <p>@c.Description</p> }

            <table class="table record-table">
                <caption class="visually-hidden">@Texts.Get("contracts.commitmentsPanel.occurrencesCaption", c.Title)</caption>
                <thead><tr><th scope="col">@Texts.Get("contracts.commitments.col.period")</th><th scope="col">@Texts.Get("contracts.commitments.col.due")</th><th scope="col">@Texts.Get("common.field.status")</th><th scope="col">@Texts.Get("contracts.commitmentsPanel.col.fulfilment")</th><th scope="col">@Texts.Get("crm.quoteApprovals.col.action")</th></tr></thead>
                <tbody>
                    @foreach (var o in mine)
                    {
                        <tr>
                            <td data-label="@Texts.Get("contracts.commitments.col.period")">@o.Sequence</td>
                            <td data-label="@Texts.Get("contracts.commitments.col.due")">@ContractLabels.Date(o.DueDate)@if (o.IsOverdue) { <div class="small text-danger">@Texts.Get("contracts.commitments.daysOverdue", o.DaysOverdue)</div> }</td>
                            <td data-label="@Texts.Get("common.field.status")">
                                <span class="badge stage-@CommitmentLabels.Badge(o.Status, o.IsOverdue && o.Status == "Open")">@CommitmentLabels.Label(CommitmentLabels.OccurrenceStatuses, o.Status)@(o.CompletedOn is not null && o.Status == "Breached" ? " " + Texts.Get("contracts.commitmentsPanel.lateCompleted") : string.Empty)</span>
                                @if (o.BreachReason is not null) { <div class="small text-danger">@o.BreachReason</div> }
                                @if (o.WaiveReason is not null) { <div class="small text-muted">@Texts.Get("contracts.commitmentsPanel.waiverSummary", o.WaiveReason)</div> }
                                @if (o.Status == "Breached") { <div class="small text-muted">@CommitmentLabels.Label(CommitmentLabels.FollowUps, o.FollowUpStatus)@(o.EscalatedAt is not null ? " · " + Texts.Get("contracts.commitmentsPanel.escalated") : string.Empty)</div> }
                            </td>
                            <td data-label="@Texts.Get("contracts.commitmentsPanel.col.fulfilment")">
                                @if (o.CompletedOn is { } done)
                                {
                                    <div>@ContractLabels.Date(done) · @Lookups.MemberName(o.CompletedBy)</div>
                                    @if (o.ActualValue is { } actual) { <div class="small">@Texts.Get("contracts.commitmentsPanel.actualSummary", actual.ToString("0.######", Regional.Numbers) + (o.Unit is null ? string.Empty : " " + o.Unit)) @(o.MetTarget == true ? Texts.Get("contracts.commitmentsPanel.targetMet") : o.MetTarget == false ? Texts.Get("contracts.commitmentsPanel.targetMissed") : string.Empty)</div> }
                                    @if (o.Note is not null) { <div class="small text-muted">@o.Note</div> }
                                    @if (o.EvidenceFileId is { } fileId && CanDownload) { <div class="small"><a href="api/contracts/commitments/@c.Id/occurrences/@o.Id/files/@fileId" download>@(o.EvidenceFileName ?? Texts.Get("contracts.commitmentsPanel.evidence"))</a></div> }
                                }
                                else { <span class="text-muted">—</span> }
                            </td>
                            <td class="actions">
                                @if (o.CanComplete && CanComplete) { <button type="button" class="btn btn-outline-primary btn-sm" @onclick="() => OpenComplete(o)">@Texts.Get("contracts.commitmentsPanel.recordFulfilment")</button> }
                                else if (o.BlockedByDue is { } blocked) { <span class="small text-muted">@Texts.Get("contracts.commitmentsPanel.blocked", ContractLabels.Date(blocked))</span> }
                                @if (c.Status == "Active" && CanWaive && o.Status is "Open" or "Breached" && o.CompletedOn is null) { <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => OpenWaive(o)">@Texts.Get("contracts.commitmentsPanel.waive")</button> }
                            </td>
                        </tr>
                        @if (completeFor == o.Id)
                        {
                            <tr>
                                <td colspan="5">
                                    <form class="record-form" novalidate @onsubmit="() => CompleteAsync(c, o)" @onsubmit:preventDefault>
                                        <h4>@Texts.Get("contracts.commitmentsPanel.occurrenceTitle", o.Sequence)</h4>
                                        @if (errors is { Count: > 0 })
                                        {
                                            <div class="alert alert-danger" role="alert"><ul class="mb-0">@foreach (var (_, messages) in errors) { foreach (var message in messages) { <li>@message</li> } }</ul></div>
                                        }
                                        <div class="form-grid">
                                            <div>
                                                <label class="form-label" for="co-date">@Texts.Get("contracts.commitmentsPanel.completedOnRequired")</label>
                                                <input id="co-date" class="form-control" type="date" @bind="completeDate" />
                                            </div>
                                            @if (o.MetricName is not null)
                                            {
                                                <div>
                                                    <label class="form-label" for="co-actual">@Texts.Get("contracts.commitmentsPanel.actualRequired", CommitmentLabels.Target(o.MetricName, o.Direction, o.TargetValue, o.Tolerance, o.Unit))</label>
                                                    <input id="co-actual" class="form-control" type="number" step="any" min="0" @bind="completeActual" />
                                                </div>
                                            }
                                            <div>
                                                <label class="form-label" for="co-file">@Texts.Get("contracts.commitmentsPanel.evidenceFile")</label>
                                                <InputFile id="co-file" class="form-control" accept="application/pdf,image/png,image/jpeg" OnChange="PickFileAsync" />
                                                @if (completeFileName is not null) { <div class="form-text">@completeFileName</div> }
                                            </div>
                                            <div class="wide">
                                                <label class="form-label" for="co-note">@Texts.Get("contracts.field.notes")</label>
                                                <input id="co-note" class="form-control" maxlength="1000" @bind="completeNote" />
                                            </div>
                                        </div>
                                        <div class="form-actions">
                                            <button type="submit" class="btn btn-primary" disabled="@busy">@Texts.Get("common.save")</button>
                                            <button type="button" class="btn btn-link" @onclick="CloseForms">@Texts.Get("common.dismiss")</button>
                                        </div>
                                    </form>
                                </td>
                            </tr>
                        }
                        @if (waiveFor == o.Id)
                        {
                            <tr>
                                <td colspan="5">
                                    <form class="record-form" novalidate @onsubmit="() => WaiveAsync(c, o)" @onsubmit:preventDefault>
                                        <label class="form-label" for="wv-reason">@Texts.Get("contracts.commitmentsPanel.waiveReasonRequired")</label>
                                        <input id="wv-reason" class="form-control" maxlength="500" @bind="reasonText" />
                                        <div class="form-actions">
                                            <button type="submit" class="btn btn-danger" disabled="@busy">@Texts.Get("contracts.commitmentsPanel.waive")</button>
                                            <button type="button" class="btn btn-link" @onclick="CloseForms">@Texts.Get("common.dismiss")</button>
                                        </div>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
            @if (CanWrite && c.Status == "Active")
            {
                <div class="header-actions">
                    <button type="button" class="btn btn-outline-primary btn-sm" @onclick="() => Edit(c)">@Texts.Get("common.edit")</button>
                    <button type="button" class="btn btn-outline-danger btn-sm" @onclick="() => cancelFor = c.Id">@Texts.Get("contracts.commitmentsPanel.cancel")</button>
                </div>
                @if (cancelFor == c.Id)
                {
                    <form class="record-form" novalidate @onsubmit="() => CancelAsync(c)" @onsubmit:preventDefault>
                        <label class="form-label" for="cn-reason">@Texts.Get("contracts.commitmentsPanel.cancelReasonRequired")</label>
                        <input id="cn-reason" class="form-control" maxlength="500" @bind="reasonText" />
                        <div class="form-actions">
                            <button type="submit" class="btn btn-danger" disabled="@busy">@Texts.Get("contracts.commitmentsPanel.cancelConfirm")</button>
                            <button type="button" class="btn btn-link" @onclick="CloseForms">@Texts.Get("common.dismiss")</button>
                        </div>
                    </form>
                }
            }
        </article>
    }
</section>

@code {
    private const long MaxBytes = 10 * 1024 * 1024;

    private List<ContractCommitmentDto> commitments = [];
    private List<CommitmentOccurrenceDto> occurrences = [];
    private CommitmentForm? form;
    private IReadOnlyDictionary<string, string[]>? errors;
    private string? notice;
    private bool noticeFailed;
    private bool busy;
    private bool loading = true;
    private string? loadedFor;
    private Guid? completeFor;
    private Guid? waiveFor;
    private Guid? cancelFor;
    private DateTime? completeDate;
    private decimal? completeActual;
    private string? completeNote;
    private string? completeFileName;
    private byte[]? completeContent;
    private string reasonText = string.Empty;

    [Parameter, EditorRequired] public ContractDto Contract { get; set; } = null!;

    [Parameter] public EventCallback Changed { get; set; }

    private bool CanWrite => Session.Can(ContractsAccess.CommitmentsWrite);

    private bool CanComplete => Session.Can(ContractsAccess.CommitmentsComplete);

    private bool CanWaive => Session.Can(ContractsAccess.CommitmentsWaive);

    private bool CanDownload => Session.Can(ContractsAccess.DocumentsDownload);

    private bool lockedSchedule => form?.Id is { } id && occurrences.Any(o => o.CommitmentId == id && o.Status != "Open");

    protected override async Task OnParametersSetAsync()
    {
        var key = $"{Contract.Id}";
        if (key == loadedFor) { return; }
        loadedFor = key;
        await Lookups.LoadAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        var (loaded, error) = await Api.GetAllAsync<ContractCommitmentDto>($"/api/contracts/commitments?contractId={Contract.Id}");
        commitments = loaded ?? [];
        occurrences = (await Api.GetAsync<List<CommitmentOccurrenceDto>>($"/api/contracts/commitments/occurrences?contractId={Contract.Id}&includeClosed=true")).Value ?? [];
        loading = false;
        if (error is not null) { Notify(error, true); }
    }

    private void NewCommitment()
    {
        CloseForms();
        form = new CommitmentForm { Category = Lookups.DefaultOf(ContractsAccess.CommitmentCategoryList) ?? "Delivery", StartDate = DateTime.Today, DueDate = DateTime.Today.AddDays(30) };
    }

    private void Edit(ContractCommitmentDto c)
    {
        CloseForms();
        form = new CommitmentForm
        {
            Id = c.Id, Version = c.Version, Title = c.Title, Description = c.Description, Category = c.Category, Obligor = c.Obligor, ResponsibleUserId = c.ResponsibleUserId?.ToString() ?? string.Empty,
            EscalationUserId = c.EscalationUserId?.ToString() ?? string.Empty, Kind = c.Kind, StartDate = c.StartDate.ToDateTime(TimeOnly.MinValue), DueDate = c.DueDate.ToDateTime(TimeOnly.MinValue),
            Recurrence = c.Recurrence ?? string.Empty, RecurrenceEndDate = c.RecurrenceEndDate?.ToDateTime(TimeOnly.MinValue), GraceDays = c.GraceDays, EscalateAfterDays = c.EscalateAfterDays,
            MetricName = c.MetricName, Unit = c.Unit, Direction = c.Direction ?? string.Empty, TargetValue = c.TargetValue, Tolerance = c.Tolerance,
            DependsOnCommitmentId = c.DependsOnCommitmentId?.ToString() ?? string.Empty, ConsequenceNote = c.ConsequenceNote,
        };
    }

    private void CancelForm()
    {
        form = null;
        errors = null;
    }

    private async Task SaveAsync()
    {
        if (busy || form is null) { return; }
        busy = true;
        var f = form;
        var request = new SaveContractCommitmentRequest(
            Contract.Id, f.Title, DateOnly.FromDateTime(f.StartDate ?? DateTime.Today), DateOnly.FromDateTime(f.DueDate ?? DateTime.Today), Blank(f.Description), Blank(f.Category), f.Obligor,
            Guid.TryParse(f.ResponsibleUserId, out var responsible) ? responsible : null, Guid.TryParse(f.EscalationUserId, out var escalation) ? escalation : null, f.Kind,
            f.Kind == "Periodic" ? Blank(f.Recurrence) : null, f.Kind == "Periodic" && f.RecurrenceEndDate is { } end ? DateOnly.FromDateTime(end) : null, f.GraceDays, f.EscalateAfterDays,
            Blank(f.MetricName), Blank(f.Unit), Blank(f.Direction), f.TargetValue, f.Tolerance, Guid.TryParse(f.DependsOnCommitmentId, out var dependency) ? dependency : null, Blank(f.ConsequenceNote), f.Version);
        var result = f.Id is { } id
            ? await Api.PutAsync<ContractCommitmentDto>($"/api/contracts/commitments/{id}", request)
            : await Api.PostAsync<ContractCommitmentDto>("/api/contracts/commitments", request);
        busy = false;
        if (result.IsSuccess)
        {
            form = null;
            errors = null;
            Notify(Texts.Get("contracts.commitmentsPanel.saved"), false);
            await LoadAsync();
            await Changed.InvokeAsync();
            return;
        }

        errors = result.FieldErrors;
        Notify(result.Error, true);
    }

    private async Task DeleteAsync()
    {
        if (busy || form?.Id is not { } id) { return; }
        busy = true;
        var result = await Api.DeleteAsync($"/api/contracts/commitments/{id}?version={form.Version}");
        busy = false;
        Notify(result.IsSuccess ? Texts.Get("contracts.commitmentsPanel.deleted") : result.Error, !result.IsSuccess);
        if (result.IsSuccess) { form = null; await LoadAsync(); }
    }

    private void OpenComplete(CommitmentOccurrenceDto o)
    {
        CloseForms();
        completeFor = o.Id;
        completeDate = DateTime.Today;
    }

    private void OpenWaive(CommitmentOccurrenceDto o)
    {
        CloseForms();
        waiveFor = o.Id;
    }

    private async Task PickFileAsync(InputFileChangeEventArgs e)
    {
        completeContent = null;
        completeFileName = null;
        var file = e.File;
        if (file.Size > MaxBytes)
        {
            errors = new Dictionary<string, string[]> { ["file"] = [Texts.Get("contracts.commitmentsPanel.fileTooLarge")] };
            return;
        }

        using var stream = file.OpenReadStream(MaxBytes);
        using var buffer = new MemoryStream();
        await stream.CopyToAsync(buffer);
        completeContent = buffer.ToArray();
        completeFileName = file.Name;
        errors = null;
    }

    private async Task CompleteAsync(ContractCommitmentDto c, CommitmentOccurrenceDto o)
    {
        if (busy) { return; }
        busy = true;
        var request = new CompleteOccurrenceRequest(DateOnly.FromDateTime(completeDate ?? DateTime.Today), completeActual, Blank(completeNote), completeFileName, completeContent is null ? null : Convert.ToBase64String(completeContent));
        var result = await Api.PostAsync<CommitmentOccurrenceDto>($"/api/contracts/commitments/{c.Id}/occurrences/{o.Id}/complete", request);
        busy = false;
        await FinishAsync(result.IsSuccess, result.Error, result.FieldErrors, result.Value?.Status == "Breached" ? Texts.Get("contracts.commitmentsPanel.completedBreached") : Texts.Get("contracts.commitmentsPanel.completed"));
    }

    private async Task WaiveAsync(ContractCommitmentDto c, CommitmentOccurrenceDto o)
    {
        if (busy) { return; }
        busy = true;
        var result = await Api.PostAsync<CommitmentOccurrenceDto>($"/api/contracts/commitments/{c.Id}/occurrences/{o.Id}/waive", new SignatureReasonRequest(reasonText));
        busy = false;
        await FinishAsync(result.IsSuccess, result.Error, result.FieldErrors, Texts.Get("contracts.commitmentsPanel.waived"));
    }

    private async Task CancelAsync(ContractCommitmentDto c)
    {
        if (busy) { return; }
        busy = true;
        var result = await Api.PostAsync<ContractCommitmentDto>($"/api/contracts/commitments/{c.Id}/cancel", new SignatureReasonRequest(reasonText));
        busy = false;
        await FinishAsync(result.IsSuccess, result.Error, result.FieldErrors, Texts.Get("contracts.commitmentsPanel.cancelled"));
    }

    private async Task EvaluateAsync()
    {
        if (busy) { return; }
        busy = true;
        var result = await Api.PostAsync<CommitmentEvaluationDto>("/api/contracts/commitments/evaluate", new CommitmentEvaluateRequest(Contract.Id));
        busy = false;
        var v = result.Value;
        await FinishAsync(result.IsSuccess, result.Error, result.FieldErrors,
            v is null ? Texts.Get("contracts.commitmentsPanel.evaluated") : Texts.Get("contracts.commitmentsPanel.evaluatedSummary", v.Breached, v.Escalated, v.FollowUpsCreated, v.OccurrencesCreated));
    }

    private async Task FinishAsync(bool success, string? error, IReadOnlyDictionary<string, string[]>? fieldErrors, string message)
    {
        if (success)
        {
            CloseForms();
            Notify(message, false);
            await LoadAsync();
            await Changed.InvokeAsync();
            return;
        }

        errors = fieldErrors;
        Notify(error, true);
    }

    private void CloseForms()
    {
        completeFor = null;
        waiveFor = null;
        cancelFor = null;
        errors = null;
        reasonText = string.Empty;
        completeActual = null;
        completeNote = null;
        completeFileName = null;
        completeContent = null;
    }

    private void Notify(string? text, bool failed)
    {
        notice = text;
        noticeFailed = failed;
    }

    private static string? Blank(string? text) => string.IsNullOrWhiteSpace(text) ? null : text.Trim();

    private sealed class CommitmentForm
    {
        public Guid? Id { get; init; }
        public long? Version { get; init; }
        public string Title { get; set; } = string.Empty;
        public string? Description { get; set; }
        public string Category { get; set; } = string.Empty;
        public string Obligor { get; set; } = "Provider";
        public string ResponsibleUserId { get; set; } = string.Empty;
        public string EscalationUserId { get; set; } = string.Empty;
        public string Kind { get; set; } = "OneTime";
        public DateTime? StartDate { get; set; }
        public DateTime? DueDate { get; set; }
        public string Recurrence { get; set; } = string.Empty;
        public DateTime? RecurrenceEndDate { get; set; }
        public int GraceDays { get; set; }
        public int EscalateAfterDays { get; set; }
        public string? MetricName { get; set; }
        public string? Unit { get; set; }
        public string Direction { get; set; } = string.Empty;
        public decimal? TargetValue { get; set; }
        public decimal? Tolerance { get; set; }
        public string DependsOnCommitmentId { get; set; } = string.Empty;
        public string? ConsequenceNote { get; set; }
    }
}
