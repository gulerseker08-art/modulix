@* Rol seçimi (onay kutuları). Seçim, verilen kümede tutulur. *@
@if (Roles.Count == 0)
{
    <p class="text-muted">Tanımlı rol yok.</p>
}
else
{
    <div class="role-picker">
        @foreach (var role in Roles)
        {
            var locked = role.IsSystem && !CanGrantAdministrator;
            <label class="form-check">
                <input class="form-check-input" type="checkbox" checked="@Selected.Contains(role.Id)" disabled="@locked"
                       @onchange="e => Toggle(role.Id, e.Value is true)" />
                <span class="form-check-label">
                    @role.Name
                    @if (role.IsSystem)
                    {
                        <small class="text-muted"> · tüm izinler@(locked ? "; yalnızca yönetici verebilir" : null)</small>
                    }
                </span>
            </label>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<RoleDto> Roles { get; set; } = [];

    [Parameter, EditorRequired] public HashSet<Guid> Selected { get; set; } = [];

    /// <summary>Yönetici rolü seçilebilir mi (kullanıcı yönetici mi)?</summary>
    [Parameter] public bool CanGrantAdministrator { get; set; }

    private void Toggle(Guid roleId, bool on)
    {
        if (on)
        {
            Selected.Add(roleId);
        }
        else
        {
            Selected.Remove(roleId);
        }
    }
}
