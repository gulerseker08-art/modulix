@* Kampanya yanıtları çalışma alanı (ADR-0025, dilim 7): gönderilmiş bir iletiye gelen yanıtı kaydet, üstlen, lead ve takip aktivitesi aç, "iletişim istemiyorum" yanıtının çıkışını uygula, kapat.
   Adres gösterilmez. Lead ve aktivite için ayrıca CRM izni gerekir; yetki yoksa sunucu reddeder ve yanıt değişmez. Otomatik yanıt toplama (webhook) bu sürümde yoktur. *@
@inject ApiClient Api
@inject SessionState Session

<Notice Text="@message" Failed="@failed" />
<div class="alert alert-info" role="note">
    @Texts.Strong("marketing.responsesPanel.info", Texts.Get("marketing.responsesPanel.notAutomatic"))
    @Texts.Get("marketing.responsesPanel.noConvert")
</div>

<section aria-labelledby="resp-title">
    <h2 id="resp-title" class="h5">@Texts.Get("marketing.campaignDetail.tab.responses")</h2>
    @if (responses is null)
    {
        <LoadingState />
    }
    else if (responses.Count == 0)
    {
        <p class="text-muted">@Texts.Get("marketing.responsesPanel.empty")</p>
    }
    else
    {
        @foreach (var r in responses)
        {
            <article class="run-card" aria-label="@Texts.Get("marketing.responsesPanel.response")">
                <h3 class="h6">@MarketingLabels.ResponseKind(r.Kind) · @MarketingLabels.ResponseStatus(r.Status)</h3>
                <p class="mb-1 small text-muted">
                    @CrmLabels.Time(r.ReceivedAt)
                    @(r.LeadId is null ? null : " · " + Texts.Get("marketing.responsesPanel.leadOpened"))
                    @(r.ActivityId is null ? null : " · " + Texts.Get("marketing.responsesPanel.activityOpened"))
                    @(r.OptOutAppliedAt is null ? null : " · " + Texts.Get("marketing.responsesPanel.optOutApplied"))
                    @(r.ClosedReason is null ? null : " · " + r.ClosedReason)
                </p>
                @if (!string.IsNullOrWhiteSpace(r.Note)) { <p class="mb-1">@r.Note</p> }
                @if (CanWrite)
                {
                    <div class="form-actions">
                        @if (r.Status == "New") { <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@busy" @onclick='() => ActAsync(r, "take")'>@Texts.Get("marketing.responsesPanel.take")</button> }
                        @if (r.Status is "New" or "InProgress" && r.Kind is "Interested" or "Question" or "MeetingRequest") { <button type="button" class="btn btn-sm btn-primary" disabled="@busy" @onclick='() => ActAsync(r, "convert-to-lead")'>@Texts.Get("marketing.responsesPanel.convert")</button> }
                        @if (r.Status != "Closed" && r.ActivityId is null) { <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@busy" @onclick='() => ActAsync(r, "create-activity")'>@Texts.Get("marketing.responsesPanel.createActivity")</button> }
                        @if (r.Status != "Closed" && r.Kind == "OptOut") { <button type="button" class="btn btn-sm btn-primary" disabled="@busy" @onclick='() => ActAsync(r, "apply-opt-out")'>@Texts.Get("marketing.responsesPanel.applyOptOut")</button> }
                        @if (r.Status != "Closed") { <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@busy" @onclick='() => AskReason(r, "close")'>@Texts.Get("common.close")</button> }
                        @if (r.Status == "Closed") { <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@busy" @onclick='() => AskReason(r, "reopen")'>@Texts.Get("support.action.reopen")</button> }
                    </div>
                }
                @if (askReason == r.Id)
                {
                    <div class="filters">
                        <label class="visually-hidden" for="resp-reason">@Texts.Get("crm.quoteApprovals.reasonLabel")</label>
                        <input id="resp-reason" class="form-control" maxlength="500" placeholder="@Texts.Get("orders.change.reason")" @bind="reason" />
                        <button type="button" class="btn btn-sm btn-primary" disabled="@(busy || string.IsNullOrWhiteSpace(reason))" @onclick="ConfirmReasonAsync">@Texts.Get("crm.quoteApprovals.approve")</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => askReason = null">@Texts.Get("common.dismiss")</button>
                    </div>
                }
            </article>
        }
    }

    @if (CanWrite)
    {
        <form class="record-form" novalidate @onsubmit="RegisterAsync" @onsubmit:preventDefault>
            <fieldset disabled="@busy">
                <legend class="h6">@Texts.Get("marketing.responsesPanel.register")</legend>
                <div class="form-grid">
                    <div class="span-6">
                        <label class="form-label" for="rs-delivery">@Texts.Get("marketing.responsesPanel.delivery")</label>
                        <select id="rs-delivery" class="form-select" @bind="deliveryChoice" @onfocus="LoadDeliveriesAsync">
                            <option value="">@Texts.Get("support.choose")</option>
                            @foreach (var d in deliveries ?? []) { <option value="@d.Id">@d.Label</option> }
                        </select>
                        <small class="text-muted">@Texts.Get("marketing.responsesPanel.deliveryHelp")</small>
                        <FieldError Field="deliveryId" Errors="errors" />
                    </div>
                    <div class="span-3">
                        <label class="form-label" for="rs-kind">@Texts.Get("marketing.responsesPanel.kind")</label>
                        <select id="rs-kind" class="form-select" @bind="kind">
                            @foreach (var k in MarketingLabels.ResponseKinds) { <option value="@k.Key">@k.Label</option> }
                        </select>
                        <FieldError Field="kind" Errors="errors" />
                    </div>
                    <div class="span-12">
                        <label class="form-label" for="rs-note">@Texts.Get("marketing.responsesPanel.noteOptional")</label>
                        <textarea id="rs-note" class="form-control" rows="2" maxlength="2000" @bind="note"></textarea>
                        <FieldError Field="note" Errors="errors" />
                    </div>
                </div>
            </fieldset>
            <div class="form-actions"><button type="submit" class="btn btn-primary" disabled="@(busy || deliveryChoice.Length == 0)">@Texts.Get("marketing.responsesPanel.save")</button></div>
        </form>
    }
</section>

@code {
    [Parameter, EditorRequired] public CampaignDto Campaign { get; set; } = default!;

    private sealed record DeliveryChoice(Guid Id, string Label);

    private List<CampaignResponseDto>? responses;
    private List<DeliveryChoice>? deliveries;
    private string? message;
    private bool failed;
    private bool busy;
    private string deliveryChoice = string.Empty;
    private string kind = "Interested";
    private string note = string.Empty;
    private IReadOnlyDictionary<string, string[]>? errors;
    private Guid? askReason;
    private string pendingAction = string.Empty;
    private string reason = string.Empty;

    private bool CanWrite => Session.Can(MarketingAccess.ResponsesWrite);

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var result = await Api.GetAsync<PagedResult<CampaignResponseDto>>($"/api/marketing/campaign-responses?campaignId={Campaign.Id}&pageSize=100");
        responses = result.Value?.Items.ToList() ?? [];
        if (!result.IsSuccess) { Report(result.Error, true); }
    }

    /// <summary>Çalıştırmaların kabul edilmiş ve sonucu belirsiz iletileri; alıcı adı, anlık görüntüdeki alıcı listesinden gelir (görme izni yoksa yalnızca sıra numarası).</summary>
    private async Task LoadDeliveriesAsync()
    {
        if (deliveries is not null) { return; }
        var list = new List<DeliveryChoice>();
        var runs = (await Api.GetAsync<PagedResult<CampaignRunDto>>($"/api/marketing/campaign-runs?campaignId={Campaign.Id}&pageSize=50")).Value?.Items ?? [];
        foreach (var run in runs.Where(r => r.Status is "Running" or "Paused" or "Completed" or "Cancelled"))
        {
            var labels = new Dictionary<Guid, string?>();
            if (run.SnapshotId is { } snapshotId)
            {
                var recipients = await Api.GetAsync<AudienceRecipientsPageDto>($"/api/marketing/audience-snapshots/{snapshotId}/recipients?pageSize=100");
                foreach (var r in recipients.Value?.Items ?? []) { labels[r.TargetId] = r.Label; }
            }

            foreach (var status in new[] { "Accepted", "Unknown" })
            {
                var page = await Api.GetAsync<CampaignDeliveryPageDto>($"/api/marketing/campaign-runs/{run.Id}/deliveries?status={status}&pageSize=100");
                var index = 0;
                foreach (var d in page.Value?.Items ?? [])
                {
                    index++;
                    var who = labels.GetValueOrDefault(d.TargetId) ?? Texts.Get("marketing.responsesPanel.recipientNo", index);
                    var started = run.StartedAt is { } at ? CrmLabels.Time(at) : Texts.Get("marketing.responsesPanel.startUnknown");
                    list.Add(new DeliveryChoice(d.Id, status == "Unknown"
                        ? Texts.Get("marketing.responsesPanel.deliveryOptionUnknown", who, started)
                        : Texts.Get("marketing.responsesPanel.deliveryOption", who, started)));
                }
            }
        }

        deliveries = list;
    }

    private async Task RegisterAsync()
    {
        if (busy || !Guid.TryParse(deliveryChoice, out var deliveryId)) { return; }
        busy = true;
        errors = null;
        var result = await Api.PostAsync<CampaignResponseDto>("/api/marketing/campaign-responses",
            new RegisterCampaignResponseRequest(deliveryId, kind, string.IsNullOrWhiteSpace(note) ? null : note.Trim()));
        busy = false;
        if (result.IsSuccess) { note = string.Empty; deliveryChoice = string.Empty; Report(Texts.Get("marketing.responsesPanel.saved"), false); await LoadAsync(); }
        else { errors = result.FieldErrors.Count == 0 ? null : result.FieldErrors; Report(result.Error, true); }
    }

    private void AskReason(CampaignResponseDto response, string action)
    {
        askReason = response.Id;
        pendingAction = action;
        reason = string.Empty;
    }

    private async Task ConfirmReasonAsync()
    {
        if (responses?.FirstOrDefault(r => r.Id == askReason) is { } response)
        {
            await ActAsync(response, pendingAction, reason.Trim());
        }

        askReason = null;
    }

    private async Task ActAsync(CampaignResponseDto response, string action, string? why = null)
    {
        if (busy) { return; }
        busy = true;
        var result = await Api.PostAsync<CampaignResponseDto>($"/api/marketing/campaign-responses/{response.Id}/{action}", new ResponseActionRequest(response.Version, why));
        busy = false;
        Report(result.IsSuccess ? Texts.Get("marketing.responsesPanel.done") : result.Error, !result.IsSuccess);
        await LoadAsync();
    }

    private void Report(string? text, bool isFailure)
    {
        message = text;
        failed = isFailure;
    }
}
