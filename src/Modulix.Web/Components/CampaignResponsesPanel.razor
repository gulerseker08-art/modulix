@* Kampanya yanıtları çalışma alanı (ADR-0025, dilim 7): gönderilmiş bir iletiye gelen yanıtı kaydet, üstlen, lead ve takip aktivitesi aç, "iletişim istemiyorum" yanıtının çıkışını uygula, kapat.
   Adres gösterilmez. Lead ve aktivite için ayrıca CRM izni gerekir; yetki yoksa sunucu reddeder ve yanıt değişmez. Otomatik yanıt toplama (webhook) bu sürümde yoktur. *@
@inject ApiClient Api
@inject SessionState Session

<Notice Text="@message" Failed="@failed" />
<div class="alert alert-info" role="note">
    Yanıtı siz kaydedersiniz; sağlayıcıdan otomatik yanıt gelmez. "İletişim istemiyorum" yanıtının çıkışı <strong>kendiliğinden uygulanmaz</strong>: yanıtı açıp "Çıkışı uygula" demeniz gerekir.
    Ret, çıkış ve şikâyet yanıtları müşteri adayına dönüşmez.
</div>

<section aria-labelledby="resp-title">
    <h2 id="resp-title" class="h5">Yanıtlar</h2>
    @if (responses is null)
    {
        <LoadingState />
    }
    else if (responses.Count == 0)
    {
        <p class="text-muted">Henüz yanıt yok. Yanıt, kampanyadan gönderilmiş bir iletiye kaydedilir.</p>
    }
    else
    {
        @foreach (var r in responses)
        {
            <article class="run-card" aria-label="Yanıt">
                <h3 class="h6">@MarketingLabels.ResponseKind(r.Kind) · @MarketingLabels.ResponseStatus(r.Status)</h3>
                <p class="mb-1 small text-muted">
                    @CrmLabels.Time(r.ReceivedAt)
                    @(r.LeadId is null ? null : " · Müşteri adayı açıldı")
                    @(r.ActivityId is null ? null : " · aktivite açıldı")
                    @(r.OptOutAppliedAt is null ? null : " · çıkış uygulandı")
                    @(r.ClosedReason is null ? null : " · " + r.ClosedReason)
                </p>
                @if (!string.IsNullOrWhiteSpace(r.Note)) { <p class="mb-1">@r.Note</p> }
                @if (CanWrite)
                {
                    <div class="form-actions">
                        @if (r.Status == "New") { <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@busy" @onclick='() => ActAsync(r, "take")'>Üstlen</button> }
                        @if (r.Status is "New" or "InProgress" && r.Kind is "Interested" or "Question" or "MeetingRequest") { <button type="button" class="btn btn-sm btn-primary" disabled="@busy" @onclick='() => ActAsync(r, "convert-to-lead")'>Müşteri adayı aç</button> }
                        @if (r.Status != "Closed" && r.ActivityId is null) { <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@busy" @onclick='() => ActAsync(r, "create-activity")'>Takip aktivitesi aç</button> }
                        @if (r.Status != "Closed" && r.Kind == "OptOut") { <button type="button" class="btn btn-sm btn-primary" disabled="@busy" @onclick='() => ActAsync(r, "apply-opt-out")'>Çıkışı uygula</button> }
                        @if (r.Status != "Closed") { <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@busy" @onclick='() => AskReason(r, "close")'>Kapat</button> }
                        @if (r.Status == "Closed") { <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@busy" @onclick='() => AskReason(r, "reopen")'>Yeniden aç</button> }
                    </div>
                }
                @if (askReason == r.Id)
                {
                    <div class="filters">
                        <label class="visually-hidden" for="resp-reason">Gerekçe</label>
                        <input id="resp-reason" class="form-control" maxlength="500" placeholder="Gerekçe (zorunlu)" @bind="reason" />
                        <button type="button" class="btn btn-sm btn-primary" disabled="@(busy || string.IsNullOrWhiteSpace(reason))" @onclick="ConfirmReasonAsync">Onayla</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => askReason = null">Vazgeç</button>
                    </div>
                }
            </article>
        }
    }

    @if (CanWrite)
    {
        <form class="record-form" novalidate @onsubmit="RegisterAsync" @onsubmit:preventDefault>
            <fieldset disabled="@busy">
                <legend class="h6">Yanıt kaydet</legend>
                <div class="form-grid">
                    <div class="span-6">
                        <label class="form-label" for="rs-delivery">Yanıtlanan ileti</label>
                        <select id="rs-delivery" class="form-select" @bind="deliveryChoice" @onfocus="LoadDeliveriesAsync">
                            <option value="">Seçin</option>
                            @foreach (var d in deliveries ?? []) { <option value="@d.Id">@d.Label</option> }
                        </select>
                        <small class="text-muted">Yalnızca sağlayıcıya verilmiş iletiler listelenir; alıcı listesi için alıcıları görme izni gerekir.</small>
                        <FieldError Field="deliveryId" Errors="errors" />
                    </div>
                    <div class="span-3">
                        <label class="form-label" for="rs-kind">Yanıt türü</label>
                        <select id="rs-kind" class="form-select" @bind="kind">
                            @foreach (var k in MarketingLabels.ResponseKinds) { <option value="@k.Key">@k.Label</option> }
                        </select>
                        <FieldError Field="kind" Errors="errors" />
                    </div>
                    <div class="span-12">
                        <label class="form-label" for="rs-note">Not (isteğe bağlı)</label>
                        <textarea id="rs-note" class="form-control" rows="2" maxlength="2000" @bind="note"></textarea>
                        <FieldError Field="note" Errors="errors" />
                    </div>
                </div>
            </fieldset>
            <div class="form-actions"><button type="submit" class="btn btn-primary" disabled="@(busy || deliveryChoice.Length == 0)">Yanıtı kaydet</button></div>
        </form>
    }
</section>

@code {
    [Parameter, EditorRequired] public CampaignDto Campaign { get; set; } = default!;

    private sealed record DeliveryChoice(Guid Id, string Label);

    private List<CampaignResponseDto>? responses;
    private List<DeliveryChoice>? deliveries;
    private string? message;
    private bool failed;
    private bool busy;
    private string deliveryChoice = string.Empty;
    private string kind = "Interested";
    private string note = string.Empty;
    private IReadOnlyDictionary<string, string[]>? errors;
    private Guid? askReason;
    private string pendingAction = string.Empty;
    private string reason = string.Empty;

    private bool CanWrite => Session.Can(MarketingAccess.ResponsesWrite);

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var result = await Api.GetAsync<PagedResult<CampaignResponseDto>>($"/api/marketing/campaign-responses?campaignId={Campaign.Id}&pageSize=100");
        responses = result.Value?.Items.ToList() ?? [];
        if (!result.IsSuccess) { Report(result.Error, true); }
    }

    /// <summary>Çalıştırmaların kabul edilmiş ve sonucu belirsiz iletileri; alıcı adı, anlık görüntüdeki alıcı listesinden gelir (görme izni yoksa yalnızca sıra numarası).</summary>
    private async Task LoadDeliveriesAsync()
    {
        if (deliveries is not null) { return; }
        var list = new List<DeliveryChoice>();
        var runs = (await Api.GetAsync<PagedResult<CampaignRunDto>>($"/api/marketing/campaign-runs?campaignId={Campaign.Id}&pageSize=50")).Value?.Items ?? [];
        foreach (var run in runs.Where(r => r.Status is "Running" or "Paused" or "Completed" or "Cancelled"))
        {
            var labels = new Dictionary<Guid, string?>();
            if (run.SnapshotId is { } snapshotId)
            {
                var recipients = await Api.GetAsync<AudienceRecipientsPageDto>($"/api/marketing/audience-snapshots/{snapshotId}/recipients?pageSize=100");
                foreach (var r in recipients.Value?.Items ?? []) { labels[r.TargetId] = r.Label; }
            }

            foreach (var status in new[] { "Accepted", "Unknown" })
            {
                var page = await Api.GetAsync<CampaignDeliveryPageDto>($"/api/marketing/campaign-runs/{run.Id}/deliveries?status={status}&pageSize=100");
                var index = 0;
                foreach (var d in page.Value?.Items ?? [])
                {
                    index++;
                    var who = labels.GetValueOrDefault(d.TargetId) ?? $"Alıcı {index}";
                    list.Add(new DeliveryChoice(d.Id, $"{who} — {(run.StartedAt is { } at ? CrmLabels.Time(at) : "başlangıç belirsiz")}{(status == "Unknown" ? " (sonuç belirsiz)" : string.Empty)}"));
                }
            }
        }

        deliveries = list;
    }

    private async Task RegisterAsync()
    {
        if (busy || !Guid.TryParse(deliveryChoice, out var deliveryId)) { return; }
        busy = true;
        errors = null;
        var result = await Api.PostAsync<CampaignResponseDto>("/api/marketing/campaign-responses",
            new RegisterCampaignResponseRequest(deliveryId, kind, string.IsNullOrWhiteSpace(note) ? null : note.Trim()));
        busy = false;
        if (result.IsSuccess) { note = string.Empty; deliveryChoice = string.Empty; Report("Yanıt kaydedildi.", false); await LoadAsync(); }
        else { errors = result.FieldErrors.Count == 0 ? null : result.FieldErrors; Report(result.Error, true); }
    }

    private void AskReason(CampaignResponseDto response, string action)
    {
        askReason = response.Id;
        pendingAction = action;
        reason = string.Empty;
    }

    private async Task ConfirmReasonAsync()
    {
        if (responses?.FirstOrDefault(r => r.Id == askReason) is { } response)
        {
            await ActAsync(response, pendingAction, reason.Trim());
        }

        askReason = null;
    }

    private async Task ActAsync(CampaignResponseDto response, string action, string? why = null)
    {
        if (busy) { return; }
        busy = true;
        var result = await Api.PostAsync<CampaignResponseDto>($"/api/marketing/campaign-responses/{response.Id}/{action}", new ResponseActionRequest(response.Version, why));
        busy = false;
        Report(result.IsSuccess ? "İşlem tamamlandı." : result.Error, !result.IsSuccess);
        await LoadAsync();
    }

    private void Report(string? text, bool isFailure)
    {
        message = text;
        failed = isFailure;
    }
}
