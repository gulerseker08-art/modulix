@* Firma ekleme/düzenleme formu; Firmalar listesi ve firma detay sayfası kullanır.
   Düzen (referans "Firma kartı" ekranı): üstte yapışkan başlık + İptal / Kaydet, altında yazdıkça güncellenen gösterge şeridi, sonra firmanın
   form düzenine (ADR-0021: sekme / bölüm / alan sırası, genişlik, zorunluluk, görünürlük) göre çizilen bölüm kartları.
   Her alanın girdisi burada, yeri ve zorunluluğu düzende tanımlıdır; kaydetme davranışı değişmedi. *@
@inject ApiClient Api
@inject FormLayouts Layouts

<form class="record-form sectioned" novalidate @onsubmit="SaveAsync" @onsubmit:preventDefault @oninput="() => dirty = true">
    <div class="form-toolbar">
        <div>
            <h2>@Texts.Get(Company is null ? "crm.companies.new" : "crm.company.editor.card")</h2>
            @if (Company is not null)
            {
                <p>@Company.Name</p>
            }
        </div>
        <div class="form-toolbar-actions">
            <UnsavedChanges IsDirty="() => dirty" />
            <button type="button" class="btn btn-outline-secondary" @onclick="Cancelled">@Texts.Get("common.cancel")</button>
            <button type="submit" class="btn btn-primary" disabled="@(busy || layout is null)">
                @if (busy)
                {
                    <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                }
                @Texts.Get("common.save")
            </button>
        </div>
    </div>

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }
    @if (layoutError is not null)
    {
        <div class="alert alert-danger" role="alert">@layoutError</div>
    }

    @if (Company is not null)
    {
        <p class="shared-note text-muted">@Texts.Get("crm.company.editor.sharedNote")</p>
    }

    <div class="record-layout">
        @* Şirket özeti: formdaki değerlerle canlı önizleme. *@
        <aside class="record-summary" aria-label="@Texts.Get("crm.company.editor.summary")">
            <div class="summary-card">
                <div class="summary-identity">
                    <span class="summary-avatar" aria-hidden="true">@Initials</span>
                    <strong class="summary-name">@(string.IsNullOrWhiteSpace(form.Name) ? Texts.Get("crm.company.editor.nameFallback") : form.Name)</strong>
                    <span class="summary-sub">@Lookups.Label(CrmLists.CompanyStatus, form.Status)</span>
                </div>
                <h3 class="summary-heading">@Texts.Get("crm.company.editor.summary")</h3>
                <dl class="summary-facts">
                    <div><dt>@Texts.Get("crm.company.editor.kind")</dt><dd>@Texts.Get(form.Kind == "Individual" ? "crm.company.editor.individual" : "crm.company.editor.organization")</dd></div>
                    <div><dt>@Texts.Get("crm.companies.col.industry")</dt><dd>@(IndustryName(form.Industry) ?? Company?.LegacyIndustry ?? "—")</dd></div>
                    <div><dt>@Texts.Get("common.field.city")</dt><dd>@(string.IsNullOrWhiteSpace(form.City) ? "—" : form.City)</dd></div>
                    <div><dt>@Texts.Get(form.Kind == "Individual" ? "crm.company.editor.nationalId" : "crm.companies.col.taxNumber")</dt><dd>@(string.IsNullOrWhiteSpace(form.TaxNumber) ? "—" : form.TaxNumber)</dd></div>
                    <div><dt>@Texts.Get("common.field.owner")</dt><dd>@(form.OwnerId is { } owner ? Lookups.MemberName(owner) : (Company is null ? Texts.Get("common.me") : "—"))</dd></div>
                </dl>
            </div>
        </aside>

        <div class="record-main">
            <LayoutForm Layout="layout" CustomFields="CustomFields" CustomValues="form.Custom" Errors="errors" TabsLabel="@Texts.Get("crm.company.editor.tabs")">
                <Field Context="f">
                    @switch (f.Key)
                    {
                        case "name":
                            <label class="@f.LabelClass()" for="name">@f.Label</label>
                            <input id="name" class="form-control" maxlength="@CrmLimits.NameMaxLength" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.Name" />
                            <FieldError Field="name" Errors="errors" />
                            break;
                        case "kind":
                            <SegmentedChoice Id="kind" Label="@f.Label" LabelClass="@f.LabelClass()" Options="KindOptions" @bind-Value="form.Kind" />
                            <FieldError Field="kind" Errors="errors" />
                            break;
                        case "status":
                            <label class="@f.LabelClass()" for="status">@f.Label</label>
                            <select id="status" class="form-select" @bind="form.Status">
                                @foreach (var status in Lookups.Choices(CrmLists.CompanyStatus, source?.Status))
                                {
                                    <option value="@status.Key">@status.Label</option>
                                }
                            </select>
                            <FieldError Field="status" Errors="errors" />
                            break;
                        case "ownerId":
                            <label class="@f.LabelClass()" for="ownerId">@f.Label</label>
                            <LookupPicker Id="ownerId" LookupKey="crm.company.owner" @bind-Value="form.OwnerId" Required="f.Required" Placeholder="@(Company is null ? Texts.Get("common.me") : "—")" Invalid="@(errors?.ContainsKey("ownerId") == true)" />
                            <FieldError Field="ownerId" Errors="errors" />
                            break;
                        case "industry":
                            <label class="@f.LabelClass()" for="industry">@f.Label</label>
                            <select id="industry" class="form-select" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.Industry">
                                <option value="">@Texts.Get("crm.company.editor.industryPlaceholder")</option>
                                @foreach (var industry in IndustryChoices)
                                {
                                    <option value="@industry.Code">@industry.Name</option>
                                }
                            </select>
                            @if (string.IsNullOrEmpty(form.Industry) && !string.IsNullOrWhiteSpace(Company?.LegacyIndustry))
                            {
                                <small class="form-text text-muted">@Texts.Get("crm.company.editor.industryLegacy", Company!.LegacyIndustry)</small>
                            }
                            <FieldError Field="industry" Errors="errors" />
                            break;
                        case "source":
                            <label class="@f.LabelClass()" for="source">@f.Label</label>
                            <select id="source" class="form-select" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.Source">
                                <option value="">—</option>
                                @foreach (var value in Lookups.Choices(CrmLists.CompanySource, source?.Source))
                                {
                                    <option value="@value.Key">@value.Label</option>
                                }
                            </select>
                            <FieldError Field="source" Errors="errors" />
                            break;
                        case "taxOffice":
                            <label class="@f.LabelClass()" for="taxOffice">@f.Label</label>
                            <input id="taxOffice" class="form-control" maxlength="@CrmLimits.TaxOfficeMaxLength" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.TaxOffice" />
                            <FieldError Field="taxOffice" Errors="errors" />
                            break;
                        case "taxNumber":
                            <label class="@f.LabelClass()" for="taxNumber">@Texts.Get(form.Kind == "Individual" ? "crm.company.editor.nationalId" : "crm.companies.col.taxNumber")</label>
                            <input id="taxNumber" class="form-control" maxlength="@CrmLimits.TaxNumberMaxLength" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.TaxNumber" />
                            <FieldError Field="taxNumber" Errors="errors" />
                            break;
                        case "tags":
                            <label class="@f.LabelClass()" for="tags">@f.Label</label>
                            <TagInput Id="tags" MaxLength="@CrmLimits.TagsMaxLength" Placeholder="@Texts.Get("common.tagPlaceholder")" Required="@f.Required" @bind-Value="form.Tags" />
                            <FieldError Field="tags" Errors="errors" />
                            break;
                        case "address":
                            <label class="@f.LabelClass()" for="address">@f.Label</label>
                            <div class="input-icon">
                                <AppIcon Name="map-pin" Size="16" />
                                <input id="address" class="form-control" maxlength="@CrmLimits.AddressMaxLength" placeholder="@Texts.Get("crm.company.editor.addressPlaceholder")" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.Address" />
                            </div>
                            <FieldError Field="address" Errors="errors" />
                            break;
                        case "phone":
                            <label class="@f.LabelClass()" for="phone">@f.Label</label>
                            <div class="input-icon">
                                <AppIcon Name="phone" Size="16" />
                                <input id="phone" class="form-control" type="tel" maxlength="@CrmLimits.PhoneMaxLength" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.Phone" />
                            </div>
                            <FieldError Field="phone" Errors="errors" />
                            break;
                        case "email":
                            <label class="@f.LabelClass()" for="email">@f.Label</label>
                            <div class="input-icon">
                                <AppIcon Name="mail" Size="16" />
                                <input id="email" class="form-control" type="email" maxlength="@CrmLimits.EmailMaxLength" placeholder="@Texts.Get("crm.company.editor.emailPlaceholder")" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.Email" />
                            </div>
                            <FieldError Field="email" Errors="errors" />
                            break;
                        case "website":
                            <label class="@f.LabelClass()" for="website">@f.Label</label>
                            <div class="input-icon">
                                <AppIcon Name="globe" Size="16" />
                                <input id="website" class="form-control" maxlength="@CrmLimits.TextMaxLength" placeholder="@Texts.Get("crm.company.editor.websitePlaceholder")" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.Website" />
                            </div>
                            <FieldError Field="website" Errors="errors" />
                            break;
                        case "city":
                            <label class="@f.LabelClass()" for="city">@f.Label</label>
                            <input id="city" class="form-control" maxlength="@CrmLimits.CityMaxLength" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.City" />
                            <FieldError Field="city" Errors="errors" />
                            break;
                        case "notes":
                            <label class="@f.LabelClass()" for="notes">@f.Label</label>
                            <textarea id="notes" class="form-control" rows="3" maxlength="@CrmLimits.NotesMaxLength" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.Notes"></textarea>
                            <FieldError Field="notes" Errors="errors" />
                            break;
                    }
                </Field>
            </LayoutForm>

            <div class="form-extras">
                <DuplicateSuggestions Resource="companies" Query="DuplicateQuery" ExcludeId="Company?.Id" Use="UseExisting" />
                @if (usePartyId is not null)
                {
                    <p class="alert alert-info mt-2">@Texts.Get("crm.company.editor.usePartyNote")
                        <button type="button" class="btn btn-link btn-sm" @onclick="() => usePartyId = null">@Texts.Get("common.dismiss")</button></p>
                }
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary" disabled="@(busy || layout is null)">@Texts.Get("common.save")</button>
                <button type="button" class="btn btn-outline-secondary" @onclick="Cancelled">@Texts.Get("common.cancel")</button>
                @if (Company is not null)
                {
                    <button type="button" class="btn btn-outline-danger ms-auto" disabled="@busy" @onclick="DeleteAsync">@Texts.Get("common.delete")</button>
                }
            </div>
        </div>
    </div>
</form>

@code {
    private static IReadOnlyList<SegmentOption<string>> KindOptions => [new("Organization", Texts.Get("crm.company.editor.organization")), new("Individual", Texts.Get("crm.company.editor.individual"))];

    private bool dirty;
    private FormLayoutDto? layout;
    private string? layoutError;

    /// <summary>Firmanın form düzeni (ADR-0021): bölüm, sekme, sıra, genişlik, zorunluluk. Yüklenemezse form kaydedilemez.</summary>
    protected override async Task OnInitializedAsync()
    {
        layout = await Layouts.ForAsync(CrmEntityKeys.Company);
        layoutError = layout is null ? Texts.Get("common.form.loadFailed") : null;

        // Sektör listesi platform kataloğundan gelir (ADR-0042); yüklenemezse alan boş kalır, form yine kaydedilebilir.
        industries = (await Api.GetAsync<List<IndustryDto>>("/api/industries")).Value ?? [];
    }

    private IReadOnlyList<IndustryDto> industries = [];

    /// <summary>Etkin sektörler; kayıttaki sektör sonradan pasife alınmışsa o da listede kalır (seçili değer kaybolmaz).</summary>
    private IEnumerable<IndustryDto> IndustryChoices =>
        industries.Where(i => i.IsActive || i.Code == source?.Industry).OrderBy(i => i.Name, StringComparer.Create(System.Globalization.CultureInfo.GetCultureInfo("tr-TR"), true));

    private string? IndustryName(string? code) => string.IsNullOrEmpty(code) ? null : industries.FirstOrDefault(i => i.Code == code)?.Name;

    private const string Url = "/api/crm/companies";

    private CompanyForm form = new();
    private IReadOnlyDictionary<string, string[]>? errors;
    private string? message;
    private bool busy;
    private Guid? usePartyId;

    /// <summary>Düzenlenecek firma; null ise yeni firma.</summary>
    [Parameter] public CompanyDto? Company { get; set; }

    [Parameter, EditorRequired] public CrmLookups Lookups { get; set; } = default!;

    private IReadOnlyList<CustomFieldDto> CustomFields => [.. Lookups.FieldsOf(CrmEntityKeys.Company)];

    [Parameter] public EventCallback<CompanyDto> Saved { get; set; }

    [Parameter] public EventCallback Deleted { get; set; }

    [Parameter] public EventCallback Cancelled { get; set; }

    private CompanyDto? source;
    private bool initialized;

    /// <summary>Özet kartındaki baş harfler (en çok iki kelime).</summary>
    private string Initials
    {
        get
        {
            string[] words = (form.Name ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
            return words.Length == 0 ? "F" : string.Concat(words.Take(2).Select(w => char.ToUpper(w[0], System.Globalization.CultureInfo.GetCultureInfo("tr-TR"))));
        }
    }

    /// <summary>Form yalnızca başka bir firma verildiğinde yeniden doldurulur; yazılanlar kaybolmaz.</summary>
    protected override void OnParametersSet()
    {
        if (!initialized || !ReferenceEquals(source, Company))
        {
            initialized = true;
            source = Company;
            form = Company is { } c
                ? new CompanyForm
                {
                    Id = c.Id, Version = c.Version, Name = c.Name, Kind = c.Kind ?? "Organization", TaxOffice = c.TaxOffice, TaxNumber = c.TaxNumber, Phone = c.Phone, Email = c.Email,
                    Website = c.Website, City = c.City, Address = c.Address, Industry = c.Industry, Status = c.Status,
                    Source = c.Source, Tags = c.Tags, OwnerId = c.OwnerId, Notes = c.Notes,
                    Custom = c.Custom?.DeepClone().AsObject() ?? [],
                }
                : new CompanyForm { Status = Lookups.DefaultOf(CrmLists.CompanyStatus) ?? CompanyStatus.Prospect };
            errors = null;
            message = null;
        }
    }

    private IReadOnlyDictionary<string, string?> DuplicateQuery() => new Dictionary<string, string?>
    {
        ["name"] = form.Name, ["taxNumber"] = form.TaxNumber, ["email"] = form.Email, ["phone"] = form.Phone,
    };

    // Kesin eşleşen ortak kayıt: yeni firma onun üzerine kurulur (partyId); sunucu yine de denetler.
    private void UseExisting(Guid partyId) => usePartyId = partyId;

    private async Task SaveAsync()
    {
        busy = true;
        var request = new SaveCompanyRequest(
            form.Name, form.TaxNumber, form.Phone, form.Email, form.Website, form.City, form.Notes, form.Version,
            form.Address, form.Industry, form.Status, string.IsNullOrEmpty(form.Source) ? null : form.Source, form.Tags, form.OwnerId, CustomFieldText.ForSave(CustomFields, form.Custom),
            Kind: form.Kind, TaxOffice: form.TaxOffice, PartyId: form.Id is null ? usePartyId : null);
        var result = form.Id is { } id
            ? await Api.PutAsync<CompanyDto>($"{Url}/{id}", request)
            : await Api.PostAsync<CompanyDto>(Url, request);
        busy = false;

        if (result.IsSuccess)
        {
            dirty = false;
            await Saved.InvokeAsync(result.Value);
            return;
        }

        errors = result.FieldErrors;
        message = result.Error;
    }

    private async Task DeleteAsync()
    {
        busy = true;
        var result = await Api.DeleteAsync($"{Url}/{form.Id}?version={form.Version}");
        busy = false;

        if (result.IsSuccess)
        {
            dirty = false;
            await Deleted.InvokeAsync();
            return;
        }

        message = result.Error;
    }

    private sealed class CompanyForm
    {
        public System.Text.Json.Nodes.JsonObject Custom { get; set; } = [];

        public Guid? Id { get; init; }

        public long? Version { get; init; }

        public string Name { get; set; } = string.Empty;

        public string Kind { get; set; } = "Organization";

        public string? TaxOffice { get; set; }

        public string? TaxNumber { get; set; }

        public string? Phone { get; set; }

        public string? Email { get; set; }

        public string? Website { get; set; }

        public string? City { get; set; }

        public string? Address { get; set; }

        public string? Industry { get; set; }

        public string Status { get; set; } = CompanyStatus.Prospect;

        public string? Source { get; set; }

        public string? Tags { get; set; }

        public Guid? OwnerId { get; set; }

        public string? Notes { get; set; }
    }
}
