@* Firma ekleme/düzenleme formu; Firmalar listesi ve firma detay sayfası kullanır. *@
@inject ApiClient Api

<form class="record-form" novalidate @onsubmit="SaveAsync" @onsubmit:preventDefault>
    <h2>@(Company is null ? "Yeni firma" : "Firmayı düzenle")</h2>

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }

    @if (Company is not null)
    {
        <p class="shared-note text-muted">Ad, vergi bilgileri, telefon, e-posta, web sitesi, şehir ve adres bu firmayı kullanan diğer modüllerde (ör. Lojistik) de görünür; burada yaptığınız değişiklik onlara da yansır. Telefon, e-posta, şehir ve adres alanları ana iletişim noktasını/adresi günceller; birden fazla kayıt için firma detayındaki "Adres ve iletişim" bölümünü kullanın.</p>
    }

    <div class="form-grid">
        <div>
            <label class="form-label" for="name">Ad *</label>
            <input id="name" class="form-control" maxlength="@CrmLimits.NameMaxLength" @bind="form.Name" />
            <FieldError Field="name" Errors="errors" />
        </div>
        <div>
            <label class="form-label" for="status">Durum</label>
            <select id="status" class="form-select" @bind="form.Status">
                @foreach (var status in Lookups.Choices(CrmLists.CompanyStatus, source?.Status))
                {
                    <option value="@status.Key">@status.Label</option>
                }
            </select>
            <FieldError Field="status" Errors="errors" />
        </div>
        <div>
            <label class="form-label" for="ownerId">Sorumlu</label>
            <select id="ownerId" class="form-select" @bind="form.OwnerId">
                <option value="">@(Company is null ? "Ben" : "—")</option>
                @foreach (var member in Lookups.AssignableMembers)
                {
                    <option value="@member.UserId">@member.DisplayName</option>
                }
            </select>
            <FieldError Field="ownerId" Errors="errors" />
        </div>
        <div>
            <label class="form-label" for="industry">Sektör</label>
            <input id="industry" class="form-control" maxlength="@CrmLimits.IndustryMaxLength" @bind="form.Industry" />
            <FieldError Field="industry" Errors="errors" />
        </div>
        <div>
            <label class="form-label" for="source">Kaynak</label>
            <select id="source" class="form-select" @bind="form.Source">
                <option value="">—</option>
                @foreach (var value in Lookups.Choices(CrmLists.CompanySource, source?.Source))
                {
                    <option value="@value.Key">@value.Label</option>
                }
            </select>
            <FieldError Field="source" Errors="errors" />
        </div>
        <div>
            <label class="form-label" for="kind">Tür</label>
            <select id="kind" class="form-select" @bind="form.Kind">
                <option value="Organization">Tüzel kişi (şirket)</option>
                <option value="Individual">Gerçek kişi (şahıs firması)</option>
            </select>
            <FieldError Field="kind" Errors="errors" />
        </div>
        <div>
            <label class="form-label" for="taxOffice">Vergi dairesi</label>
            <input id="taxOffice" class="form-control" maxlength="@CrmLimits.TaxOfficeMaxLength" @bind="form.TaxOffice" />
            <FieldError Field="taxOffice" Errors="errors" />
        </div>
        <div>
            <label class="form-label" for="taxNumber">@(form.Kind == "Individual" ? "T.C. kimlik no" : "Vergi no")</label>
            <input id="taxNumber" class="form-control" maxlength="@CrmLimits.TaxNumberMaxLength" @bind="form.TaxNumber" />
            <FieldError Field="taxNumber" Errors="errors" />
        </div>
        <div>
            <label class="form-label" for="phone">Telefon</label>
            <input id="phone" class="form-control" type="tel" maxlength="@CrmLimits.PhoneMaxLength" @bind="form.Phone" />
            <FieldError Field="phone" Errors="errors" />
        </div>
        <div>
            <label class="form-label" for="email">E-posta</label>
            <input id="email" class="form-control" type="email" maxlength="@CrmLimits.EmailMaxLength" @bind="form.Email" />
            <FieldError Field="email" Errors="errors" />
        </div>
        <div>
            <label class="form-label" for="website">Web sitesi</label>
            <input id="website" class="form-control" maxlength="@CrmLimits.TextMaxLength" @bind="form.Website" />
            <FieldError Field="website" Errors="errors" />
        </div>
        <div>
            <label class="form-label" for="city">Şehir</label>
            <input id="city" class="form-control" maxlength="@CrmLimits.CityMaxLength" @bind="form.City" />
            <FieldError Field="city" Errors="errors" />
        </div>
        <div class="span-all">
            <label class="form-label" for="address">Adres</label>
            <input id="address" class="form-control" maxlength="@CrmLimits.AddressMaxLength" @bind="form.Address" />
            <FieldError Field="address" Errors="errors" />
        </div>
        <div class="span-all">
            <label class="form-label" for="tags">Etiketler</label>
            <input id="tags" class="form-control" maxlength="@CrmLimits.TagsMaxLength" placeholder="Virgülle ayırın: öncelikli, ihracat" @bind="form.Tags" />
            <FieldError Field="tags" Errors="errors" />
        </div>
        <div class="span-all">
            <label class="form-label" for="notes">Notlar</label>
            <textarea id="notes" class="form-control" rows="3" maxlength="@CrmLimits.NotesMaxLength" @bind="form.Notes"></textarea>
            <FieldError Field="notes" Errors="errors" />
        </div>
        <div class="span-all">
            <DuplicateSuggestions Resource="companies" Query="DuplicateQuery" ExcludeId="Company?.Id" Use="UseExisting" />
            @if (usePartyId is not null)
            {
                <p class="alert alert-info mt-2">Mevcut ortak firma kaydı kullanılacak: yeni taraf açılmaz, kaydettiğinizde bu firma için CRM kaydı oluşur. Boş bıraktığınız ortak alanlar kayıttaki değeri silmez.
                    <button type="button" class="btn btn-link btn-sm" @onclick="() => usePartyId = null">Vazgeç</button></p>
            }
        </div>
        <CustomFieldInputs Fields="CustomFields" Values="form.Custom" Errors="errors" />
    </div>
    <div class="form-actions">
        <button type="submit" class="btn btn-primary" disabled="@busy">Kaydet</button>
        <button type="button" class="btn btn-outline-secondary" @onclick="Cancelled">Vazgeç</button>
        @if (Company is not null)
        {
            <button type="button" class="btn btn-outline-danger ms-auto" disabled="@busy" @onclick="DeleteAsync">Sil</button>
        }
    </div>
</form>

@code {
    private const string Url = "/api/crm/companies";

    private CompanyForm form = new();
    private IReadOnlyDictionary<string, string[]>? errors;
    private string? message;
    private bool busy;
    private Guid? usePartyId;

    /// <summary>Düzenlenecek firma; null ise yeni firma.</summary>
    [Parameter] public CompanyDto? Company { get; set; }

    [Parameter, EditorRequired] public CrmLookups Lookups { get; set; } = default!;

    private IReadOnlyList<CustomFieldDto> CustomFields => [.. Lookups.FieldsOf(CrmEntityKeys.Company)];

    [Parameter] public EventCallback<CompanyDto> Saved { get; set; }

    [Parameter] public EventCallback Deleted { get; set; }

    [Parameter] public EventCallback Cancelled { get; set; }

    private CompanyDto? source;
    private bool initialized;

    /// <summary>Form yalnızca başka bir firma verildiğinde yeniden doldurulur; yazılanlar kaybolmaz.</summary>
    protected override void OnParametersSet()
    {
        if (!initialized || !ReferenceEquals(source, Company))
        {
            initialized = true;
            source = Company;
            form = Company is { } c
                ? new CompanyForm
                {
                    Id = c.Id, Version = c.Version, Name = c.Name, Kind = c.Kind ?? "Organization", TaxOffice = c.TaxOffice, TaxNumber = c.TaxNumber, Phone = c.Phone, Email = c.Email,
                    Website = c.Website, City = c.City, Address = c.Address, Industry = c.Industry, Status = c.Status,
                    Source = c.Source, Tags = c.Tags, OwnerId = c.OwnerId, Notes = c.Notes,
                    Custom = c.Custom?.DeepClone().AsObject() ?? [],
                }
                : new CompanyForm { Status = Lookups.DefaultOf(CrmLists.CompanyStatus) ?? CompanyStatus.Prospect };
            errors = null;
            message = null;
        }
    }

    private IReadOnlyDictionary<string, string?> DuplicateQuery() => new Dictionary<string, string?>
    {
        ["name"] = form.Name, ["taxNumber"] = form.TaxNumber, ["email"] = form.Email, ["phone"] = form.Phone,
    };

    // Kesin eşleşen ortak kayıt: yeni firma onun üzerine kurulur (partyId); sunucu yine de denetler.
    private void UseExisting(Guid partyId) => usePartyId = partyId;

    private async Task SaveAsync()
    {
        busy = true;
        var request = new SaveCompanyRequest(
            form.Name, form.TaxNumber, form.Phone, form.Email, form.Website, form.City, form.Notes, form.Version,
            form.Address, form.Industry, form.Status, string.IsNullOrEmpty(form.Source) ? null : form.Source, form.Tags, form.OwnerId, CustomFieldText.ForSave(CustomFields, form.Custom),
            Kind: form.Kind, TaxOffice: form.TaxOffice, PartyId: form.Id is null ? usePartyId : null);
        var result = form.Id is { } id
            ? await Api.PutAsync<CompanyDto>($"{Url}/{id}", request)
            : await Api.PostAsync<CompanyDto>(Url, request);
        busy = false;

        if (result.IsSuccess)
        {
            await Saved.InvokeAsync(result.Value);
            return;
        }

        errors = result.FieldErrors;
        message = result.Error;
    }

    private async Task DeleteAsync()
    {
        busy = true;
        var result = await Api.DeleteAsync($"{Url}/{form.Id}?version={form.Version}");
        busy = false;

        if (result.IsSuccess)
        {
            await Deleted.InvokeAsync();
            return;
        }

        message = result.Error;
    }

    private sealed class CompanyForm
    {
        public System.Text.Json.Nodes.JsonObject Custom { get; set; } = [];

        public Guid? Id { get; init; }

        public long? Version { get; init; }

        public string Name { get; set; } = string.Empty;

        public string Kind { get; set; } = "Organization";

        public string? TaxOffice { get; set; }

        public string? TaxNumber { get; set; }

        public string? Phone { get; set; }

        public string? Email { get; set; }

        public string? Website { get; set; }

        public string? City { get; set; }

        public string? Address { get; set; }

        public string? Industry { get; set; }

        public string Status { get; set; } = CompanyStatus.Prospect;

        public string? Source { get; set; }

        public string? Tags { get; set; }

        public Guid? OwnerId { get; set; }

        public string? Notes { get; set; }
    }
}
