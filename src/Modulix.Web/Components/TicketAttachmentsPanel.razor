@* Talep ekleri (ADR-0024 dilim 4): ek bir mesaja bağlıdır, iç nota bağlı ek iç not iznine bağlıdır. Tür/imza/boyut denetimi sunucudadır; bu bileşen yalnızca gösterir ve iletir.
   İçerik taraması yoktur ve bu açıkça yazılır. *@
@inject ApiClient Api
@inject SessionState Session

<section aria-labelledby="attachments-title">
    <h2 id="attachments-title">@Texts.Get("support.attachmentsPanel.title")</h2>
    <Notice Text="@message" Failed="@failed" />
    @if (items is null)
    {
        <LoadingState />
    }
    else if (items.Count == 0)
    {
        <EmptyState Compact="true" Title="@Texts.Get("support.attachmentsPanel.none")" />
    }
    else
    {
        <ul class="task-list">
            @foreach (var a in items)
            {
                <li>
                    <a href="api/support/tickets/@Ticket.Id/attachments/@a.Id/file" download="@a.FileName">@a.FileName</a>
                    <small class="text-muted"> · @Size(a.SizeBytes) · @CrmLabels.Time(a.CreatedAt) · SHA-256 @a.Sha256[..12]…</small>
                    @if (a.IsInternal) { <span class="badge stage-lost">@Texts.Get("support.attachmentsPanel.internal")</span> }
                    <span class="badge stage-open">@Texts.Get("support.attachmentsPanel.notScanned")</span>
                </li>
            }
        </ul>
    }

    @if (targets.Count > 0)
    {
        <form class="record-form" novalidate @onsubmit="UploadAsync" @onsubmit:preventDefault>
            <fieldset disabled="@busy">
                <legend class="h6">@Texts.Get("support.attachmentsPanel.add")</legend>
                <p class="small text-muted">
                    @Texts.Get("support.attachmentsPanel.help", "pdf, png, jpg, gif, docx, xlsx, doc, xls, txt, csv")
                </p>
                <div class="form-grid">
                    <div class="span-6">
                        <label class="form-label" for="attach-message">@Texts.Get("support.attachmentsPanel.message")</label>
                        <select id="attach-message" class="form-select" @bind="targetId">
                            <option value="">@Texts.Get("support.attachmentsPanel.chooseMessage")</option>
                            @foreach (var m in targets)
                            {
                                <option value="@m.Id">@(m.Visibility == "Internal" ? Texts.Get("support.attachmentsPanel.kind.note") : m.Direction == "Inbound" ? Texts.Get("support.attachmentsPanel.kind.inbound") : Texts.Get("support.attachmentsPanel.kind.reply")) · @CrmLabels.Time(m.CreatedAt) · @Preview(m.Body)</option>
                            }
                        </select>
                    </div>
                    <div class="span-6">
                        <label class="form-label" for="attach-file">@Texts.Get("support.attachmentsPanel.file")</label>
                        <InputFile @key="inputKey" id="attach-file" class="form-control" OnChange="OnFileChosen" />
                        <FieldError Field="file" Errors="errors" />
                    </div>
                </div>
            </fieldset>
            <div class="form-actions"><button type="submit" class="btn btn-outline-secondary" disabled="@(busy || file is null || targetId == string.Empty)">@Texts.Get("support.attachmentsPanel.upload")</button></div>
        </form>
    }
</section>

@code {
    private const long MaxBytes = 5 * 1024 * 1024;

    [Parameter, EditorRequired] public TicketDto Ticket { get; set; } = default!;

    /// <summary>Üst ekranın yüklediği mesajlar; ek bu mesajlardan birine eklenir.</summary>
    [Parameter] public List<TicketMessageDto>? Messages { get; set; }

    private List<AttachmentDto>? items;
    private IReadOnlyDictionary<string, string[]>? errors;
    private string? message;
    private bool failed;
    private bool busy;
    private string targetId = string.Empty;
    private IBrowserFile? file;
    private Guid loadedFor;
    private int inputKey;
    private int loadedCount = -1;

    private bool IsFinal => Ticket.Status is "Closed" or "Cancelled" or "Merged";

    /// <summary>Çağıranın ek ekleyebileceği mesajlar: dış mesajlar yanıt iznine, iç notlar iç not iznine bağlıdır.</summary>
    private List<TicketMessageDto> targets => IsFinal || Messages is null ? [] : [.. Messages.Where(m =>
        m.Visibility == "Internal" ? Session.Can(SupportAccess.NotesWrite) : Session.Can(SupportAccess.MessagesReply))];

    protected override async Task OnParametersSetAsync()
    {
        // Talep değişince ya da yeni mesaj gelince (ek listesi mesajla birlikte yenilenir) yeniden yüklenir.
        var count = Messages?.Count ?? -1;
        if (loadedFor == Ticket.Id && loadedCount == count) { return; }
        loadedFor = Ticket.Id;
        loadedCount = count;
        await LoadAsync();
    }

    private async Task LoadAsync() => items = (await Api.GetAsync<List<AttachmentDto>>($"/api/support/tickets/{Ticket.Id}/attachments")).Value ?? [];

    private void OnFileChosen(InputFileChangeEventArgs e)
    {
        file = e.File;
        errors = null;
        message = null;
    }

    private async Task UploadAsync()
    {
        if (busy || file is null || !Guid.TryParse(targetId, out var messageId)) { return; }
        busy = true;
        message = null;
        errors = null;
        try
        {
            if (file.Size > MaxBytes)
            {
                errors = new Dictionary<string, string[]> { ["file"] = [Texts.Get("support.attachmentsPanel.tooLarge")] };
                failed = true;
                message = Texts.Get("support.attachmentsPanel.failed");
                return;
            }

            using var stream = file.OpenReadStream(MaxBytes);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            var result = await Api.PostBytesAsync<AttachmentDto>(
                $"/api/support/tickets/{Ticket.Id}/messages/{messageId}/attachments?fileName={Uri.EscapeDataString(file.Name)}", buffer.ToArray(), "application/octet-stream");
            failed = !result.IsSuccess;
            message = result.IsSuccess ? Texts.Get("support.attachmentsPanel.uploaded") : result.Error;
            errors = result.FieldErrors;
            if (result.IsSuccess)
            {
                file = null;
                inputKey++;
                targetId = string.Empty;
                await LoadAsync();
            }
        }
        finally
        {
            busy = false;
        }
    }

    private static string Size(int bytes) => bytes >= 1024 * 1024 ? $"{bytes / 1024.0 / 1024.0:0.#} MB" : bytes >= 1024 ? $"{bytes / 1024.0:0.#} KB" : $"{bytes} B";

    private static string Preview(string body) => body.Length > 40 ? body[..40] + "…" : body;
}
