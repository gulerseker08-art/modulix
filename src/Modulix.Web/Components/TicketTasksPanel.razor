@* Talep alt işleri: engelleyici açık alt iş varken talep çözülemez (kural sunucudadır; bu bileşen yalnızca gösterir). *@
@inject ApiClient Api
@inject SessionState Session
@inject CrmLookups Lookups

<section aria-labelledby="tasks-title">
    <h2 id="tasks-title">Alt işler</h2>
    <Notice Text="@message" Failed="@failed" />
    @if (tasks is null)
    {
        <LoadingState />
    }
    else if (tasks.Count == 0)
    {
        <EmptyState Compact="true" Title="Alt iş yok." />
    }
    else
    {
        <ul class="task-list">
            @foreach (var t in tasks)
            {
                <li>
                    <span class="badge stage-@(t.IsDone ? "won" : t.IsBlocking ? "lost" : "open")">@(t.IsDone ? "Tamamlandı" : t.IsBlocking ? "Engelleyici" : "Açık")</span>
                    <strong class="@(t.IsDone ? "text-decoration-line-through" : null)">@t.Title</strong>
                    <small class="text-muted"> · @(t.AssigneeId is null ? "Atanmamış" : Lookups.MemberName(t.AssigneeId))@(t.DoneAt is { } at ? " · " + CrmLabels.Time(at) + " " + Lookups.MemberName(t.DoneBy) : null)</small>
                    @if (CanWrite)
                    {
                        <button type="button" class="btn btn-sm btn-outline-secondary ms-2" disabled="@busy" @onclick="() => SetDoneAsync(t, !t.IsDone)">@(t.IsDone ? "Yeniden aç" : "Tamamla")</button>
                    }
                </li>
            }
        </ul>
    }

    @if (CanWrite)
    {
        <form class="record-form" novalidate @onsubmit="AddAsync" @onsubmit:preventDefault>
            <fieldset disabled="@busy">
                <legend class="h6">Alt iş ekle</legend>
                <div class="form-grid">
                    <div class="span-6">
                        <label class="form-label" for="task-title">Başlık</label>
                        <input id="task-title" class="form-control" maxlength="200" @bind="title" aria-invalid="@(Has("title") ? "true" : null)" />
                        <FieldError Field="title" Errors="errors" />
                    </div>
                    <div class="span-4">
                        <label class="form-label" for="task-assignee">Sorumlu</label>
                        <LookupPicker Id="task-assignee" LookupKey="support.ticket.owner" @bind-Value="assignee" Placeholder="Atanmamış" />
                        <FieldError Field="assigneeId" Errors="errors" />
                    </div>
                    <div class="span-2 form-check align-self-end">
                        <input id="task-blocking" class="form-check-input" type="checkbox" @bind="blocking" />
                        <label class="form-check-label" for="task-blocking">Engelleyici</label>
                    </div>
                </div>
            </fieldset>
            <div class="form-actions"><button type="submit" class="btn btn-outline-secondary" disabled="@busy">Ekle</button></div>
        </form>
    }
</section>

@code {
    [Parameter, EditorRequired] public TicketDto Ticket { get; set; } = default!;

    /// <summary>Alt iş değişince üst ekran talebi ve eylem listesini yeniler (engelleyici durumu çözme eylemini etkiler).</summary>
    [Parameter] public EventCallback Changed { get; set; }

    private List<TicketTaskDto>? tasks;
    private IReadOnlyDictionary<string, string[]>? errors;
    private string? message;
    private bool failed;
    private bool busy;
    private string title = string.Empty;
    private Guid? assignee;
    private bool blocking;
    private Guid loadedFor;
    private bool lookupsLoaded;

    private bool CanWrite => Session.Can(SupportAccess.TicketsWrite) && Ticket.Status is not ("Closed" or "Cancelled" or "Merged" or "Resolved");

    private bool Has(string field) => errors?.ContainsKey(field) == true;

    protected override async Task OnParametersSetAsync()
    {
        if (!lookupsLoaded)
        {
            lookupsLoaded = true;
            await Lookups.LoadAsync();
        }

        if (loadedFor == Ticket.Id) { return; }
        loadedFor = Ticket.Id;
        await LoadAsync();
    }

    private async Task LoadAsync() => tasks = (await Api.GetAsync<List<TicketTaskDto>>($"/api/support/tickets/{Ticket.Id}/tasks")).Value ?? [];

    private async Task AddAsync()
    {
        if (busy) { return; }
        busy = true;
        errors = null;
        var result = await Api.PostAsync<List<TicketTaskDto>>($"/api/support/tickets/{Ticket.Id}/tasks", new AddTicketTaskRequest(title, assignee, blocking));
        busy = false;
        failed = !result.IsSuccess;
        message = result.IsSuccess ? "Alt iş eklendi." : result.Error;
        errors = result.FieldErrors;
        if (!result.IsSuccess) { return; }
        tasks = result.Value;
        title = string.Empty;
        assignee = null;
        blocking = false;
        await Changed.InvokeAsync();
    }

    private async Task SetDoneAsync(TicketTaskDto task, bool done)
    {
        if (busy) { return; }
        busy = true;
        var result = await Api.PostAsync<List<TicketTaskDto>>($"/api/support/tickets/{Ticket.Id}/tasks/{task.Id}/{(done ? "complete" : "reopen")}", new { });
        busy = false;
        failed = !result.IsSuccess;
        message = result.IsSuccess ? null : result.Error;
        if (!result.IsSuccess) { return; }
        tasks = result.Value;
        await Changed.InvokeAsync();
    }
}
