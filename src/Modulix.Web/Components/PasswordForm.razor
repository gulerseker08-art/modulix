@* Yeni şifre ve tekrarı; davet kabulü ve şifre sıfırlama kullanır. Kurallar sunucuda denetlenir. *@
<form novalidate @onsubmit="SubmitAsync" @onsubmit:preventDefault>
    @if (Email is not null)
    {
        @* Tarayıcının şifre yöneticisi şifreyi doğru hesaba kaydetsin. *@
        <input type="email" autocomplete="username" value="@Email" hidden readonly />
    }
    <div class="mb-3">
        <label class="form-label" for="newPassword">@Texts.Get("auth.password.new")</label>
        <input id="newPassword" class="form-control" type="password" autocomplete="new-password" @bind="password" />
        <div class="form-text">@Texts.Get("auth.password.rules")</div>
        <FieldError Field="password" Errors="Errors" />
    </div>
    <div class="mb-3">
        <label class="form-label" for="newPasswordAgain">@Texts.Get("auth.password.again")</label>
        <input id="newPasswordAgain" class="form-control" type="password" autocomplete="new-password" @bind="again" />
        @if (mismatch)
        {
            <div class="invalid-feedback d-block">@Texts.Get("auth.password.mismatch")</div>
        }
    </div>
    <button type="submit" class="btn btn-primary w-100" disabled="@Busy">@ButtonText</button>
</form>

@code {
    [Parameter, EditorRequired] public EventCallback<string> Submit { get; set; }

    [Parameter, EditorRequired] public string ButtonText { get; set; } = string.Empty;

    [Parameter] public IReadOnlyDictionary<string, string[]>? Errors { get; set; }

    [Parameter] public bool Busy { get; set; }

    [Parameter] public string? Email { get; set; }

    private string password = string.Empty;
    private string again = string.Empty;
    private bool mismatch;

    private async Task SubmitAsync()
    {
        mismatch = password != again;
        if (!mismatch)
        {
            await Submit.InvokeAsync(password);
        }
    }
}
