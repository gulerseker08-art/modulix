@* Kişi ekleme/düzenleme formu; Kişiler listesi ve kişi detay sayfası kullanır.
   Düzen: üstte başlık + İptal / Kaydet, solda yazdıkça güncellenen özet kartı, sağda firmanın form düzenine (ADR-0021) göre
   çizilen bölüm kartları. Her alanın girdisi burada, yeri ve zorunluluğu düzende tanımlıdır; kaydetme davranışı değişmedi. *@
@inject ApiClient Api
@inject FormLayouts Layouts

<form class="record-form sectioned" novalidate @onsubmit="SaveAsync" @onsubmit:preventDefault @oninput="() => dirty = true">
    <div class="form-toolbar">
        <div>
            <h2>@Texts.Get(Contact is null ? "crm.contacts.new" : "crm.contact.editor.card")</h2>
            @if (Contact is not null)
            {
                <p>@Contact.FirstName @Contact.LastName</p>
            }
        </div>
        <div class="form-toolbar-actions">
            <UnsavedChanges IsDirty="() => dirty" />
            <button type="button" class="btn btn-outline-secondary" @onclick="Cancelled">@Texts.Get("common.cancel")</button>
            <button type="submit" class="btn btn-primary" disabled="@(busy || layout is null)">
                @if (busy)
                {
                    <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                }
                @Texts.Get("common.save")
            </button>
        </div>
    </div>

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }
    @if (layoutError is not null)
    {
        <div class="alert alert-danger" role="alert">@layoutError</div>
    }

    @if (Contact is not null)
    {
        <p class="shared-note text-muted">@Texts.Get("crm.contact.editor.sharedNote")</p>
    }

    <div class="record-layout">
        <aside class="record-summary" aria-label="@Texts.Get("crm.contact.summary.aria")">
            <div class="summary-card">
                <div class="summary-identity">
                    <span class="summary-avatar" aria-hidden="true">@Initials</span>
                    <strong class="summary-name">@FullName</strong>
                    @if (!string.IsNullOrWhiteSpace(form.Title))
                    {
                        <span class="summary-sub">@form.Title</span>
                    }
                </div>
                <h3 class="summary-heading">@Texts.Get("crm.contact.summary.aria")</h3>
                <dl class="summary-facts">
                    <div><dt>@Texts.Get("crm.contacts.col.company")</dt><dd>@(form.CompanyId is { } company ? Lookups.CompanyName(company) : "—")</dd></div>
                    <div><dt>@Texts.Get("common.field.owner")</dt><dd>@(form.OwnerId is { } owner ? Lookups.MemberName(owner) : (form.Id is null ? Texts.Get("common.me") : "—"))</dd></div>
                    <div><dt>@Texts.Get("common.field.email")</dt><dd>@(string.IsNullOrWhiteSpace(form.Email) ? "—" : form.Email)</dd></div>
                    <div><dt>@Texts.Get("common.field.phone")</dt><dd>@(string.IsNullOrWhiteSpace(form.Phone) ? "—" : form.Phone)</dd></div>
                </dl>
            </div>
        </aside>

        <div class="record-main">
            <LayoutForm Layout="layout" CustomFields="CustomFields" CustomValues="form.Custom" Errors="errors" TabsLabel="@Texts.Get("crm.contact.editor.tabs")">
                <Field Context="f">
                    @switch (f.Key)
                    {
                        case "firstName":
                            <label class="@f.LabelClass()" for="firstName">@f.Label</label>
                            <input id="firstName" class="form-control" maxlength="@CrmLimits.PersonNameMaxLength" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.FirstName" />
                            <FieldError Field="firstName" Errors="errors" />
                            break;
                        case "lastName":
                            <label class="@f.LabelClass()" for="lastName">@f.Label</label>
                            <input id="lastName" class="form-control" maxlength="@CrmLimits.PersonNameMaxLength" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.LastName" />
                            <FieldError Field="lastName" Errors="errors" />
                            break;
                        case "title":
                            <label class="@f.LabelClass()" for="title">@f.Label</label>
                            <input id="title" class="form-control" maxlength="@CrmLimits.PersonNameMaxLength" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.Title" />
                            <FieldError Field="title" Errors="errors" />
                            break;
                        case "companyId":
                            <label class="@f.LabelClass()" for="companyId">@f.Label</label>
                            <LookupPicker Id="companyId" LookupKey="crm.contact.company" @bind-Value="form.CompanyId" Required="f.Required" Placeholder="—" Invalid="@(errors?.ContainsKey("companyId") == true)" />
                            <FieldError Field="companyId" Errors="errors" />
                            <small class="text-muted">@Texts.Get("crm.contact.editor.companyHint")</small>
                            break;
                        case "ownerId":
                            <label class="@f.LabelClass()" for="ownerId">@f.Label</label>
                            <LookupPicker Id="ownerId" LookupKey="crm.contact.owner" @bind-Value="form.OwnerId" Required="f.Required" Placeholder="@(form.Id is null ? Texts.Get("common.me") : "—")" Invalid="@(errors?.ContainsKey("ownerId") == true)" />
                            <FieldError Field="ownerId" Errors="errors" />
                            <small class="text-muted">@Texts.Get("crm.contact.editor.ownerHint")</small>
                            break;
                        case "email":
                            <label class="@f.LabelClass()" for="email">@f.Label</label>
                            <div class="input-icon">
                                <AppIcon Name="mail" Size="16" />
                                <input id="email" class="form-control" type="email" maxlength="@CrmLimits.EmailMaxLength" placeholder="@Texts.Get("crm.company.editor.emailPlaceholder")" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.Email" />
                            </div>
                            <FieldError Field="email" Errors="errors" />
                            break;
                        case "phone":
                            <label class="@f.LabelClass()" for="phone">@f.Label</label>
                            <div class="input-icon">
                                <AppIcon Name="phone" Size="16" />
                                <input id="phone" class="form-control" type="tel" maxlength="@CrmLimits.PhoneMaxLength" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.Phone" />
                            </div>
                            <FieldError Field="phone" Errors="errors" />
                            break;
                        case "notes":
                            <label class="@f.LabelClass()" for="notes">@f.Label</label>
                            <textarea id="notes" class="form-control" rows="3" maxlength="@CrmLimits.NotesMaxLength" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.Notes"></textarea>
                            <FieldError Field="notes" Errors="errors" />
                            break;
                    }
                </Field>
            </LayoutForm>

            <div class="form-extras">
                <DuplicateSuggestions Resource="contacts" Query="DuplicateQuery" ExcludeId="Contact?.Id" />
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary" disabled="@(busy || layout is null)">@Texts.Get("common.save")</button>
                <button type="button" class="btn btn-outline-secondary" @onclick="Cancelled">@Texts.Get("common.cancel")</button>
                @if (form.Id is not null)
                {
                    <button type="button" class="btn btn-outline-danger ms-auto" disabled="@busy" @onclick="DeleteAsync">@Texts.Get("common.delete")</button>
                }
            </div>
        </div>
    </div>
</form>

@code {
    private bool dirty;
    private FormLayoutDto? layout;
    private string? layoutError;

    /// <summary>Firmanın form düzeni (ADR-0021): bölüm, sekme, sıra, genişlik, zorunluluk. Yüklenemezse form kaydedilemez.</summary>
    protected override async Task OnInitializedAsync()
    {
        layout = await Layouts.ForAsync(CrmEntityKeys.Contact);
        layoutError = layout is null ? Texts.Get("common.form.loadFailed") : null;
    }

    private const string Url = "/api/crm/contacts";

    private ContactForm form = new();
    private IReadOnlyDictionary<string, string[]>? errors;
    private string? message;
    private bool busy;
    private ContactDto? source;
    private bool initialized;

    /// <summary>Özet kartı: ad soyad ve baş harfler formdaki değerlerden gelir.</summary>
    private string FullName => string.Join(" ", new[] { form.FirstName, form.LastName }.Where(p => !string.IsNullOrWhiteSpace(p))) is { Length: > 0 } name ? name : Texts.Get("crm.contact.editor.nameFallback");

    private string Initials
    {
        get
        {
            string[] words = new[] { form.FirstName, form.LastName }.Where(p => !string.IsNullOrWhiteSpace(p)).Select(p => p!).ToArray();
            return words.Length == 0 ? "K" : string.Concat(words.Take(2).Select(w => char.ToUpper(w[0], System.Globalization.CultureInfo.GetCultureInfo("tr-TR"))));
        }
    }

    /// <summary>Düzenlenecek kişi; null ise yeni kişi.</summary>
    [Parameter] public ContactDto? Contact { get; set; }

    [Parameter, EditorRequired] public CrmLookups Lookups { get; set; } = default!;

    [Parameter] public EventCallback<ContactDto> Saved { get; set; }

    [Parameter] public EventCallback Deleted { get; set; }

    [Parameter] public EventCallback Cancelled { get; set; }

    private IReadOnlyList<CustomFieldDto> CustomFields => [.. Lookups.FieldsOf(CrmEntityKeys.Contact)];

    /// <summary>Form yalnızca başka bir kişi verildiğinde yeniden doldurulur; yazılanlar kaybolmaz.</summary>
    protected override void OnParametersSet()
    {
        if (initialized && ReferenceEquals(source, Contact))
        {
            return;
        }

        initialized = true;
        source = Contact;
        form = Contact is { } c
            ? new ContactForm
            {
                Id = c.Id, Version = c.Version, FirstName = c.FirstName, LastName = c.LastName, CompanyId = c.CompanyId, Title = c.Title,
                Email = c.Email, Phone = c.Phone, OwnerId = c.OwnerId, Notes = c.Notes, Custom = c.Custom?.DeepClone().AsObject() ?? [],
            }
            : new ContactForm();
        errors = null;
        message = null;
    }

    private IReadOnlyDictionary<string, string?> DuplicateQuery() => new Dictionary<string, string?>
    {
        ["firstName"] = form.FirstName, ["lastName"] = form.LastName, ["email"] = form.Email, ["phone"] = form.Phone,
    };

    private async Task SaveAsync()
    {
        busy = true;
        var request = new SaveContactRequest(form.FirstName, form.LastName, form.CompanyId, form.Title, form.Email, form.Phone, form.Notes, form.Version,
            Custom: CustomFieldText.ForSave(CustomFields, form.Custom), OwnerId: form.OwnerId);
        var result = form.Id is { } id
            ? await Api.PutAsync<ContactDto>($"{Url}/{id}", request)
            : await Api.PostAsync<ContactDto>(Url, request);
        busy = false;

        if (result.IsSuccess)
        {
            dirty = false;
            await Saved.InvokeAsync(result.Value!);
            return;
        }

        errors = result.FieldErrors;
        message = result.Error;
    }

    private async Task DeleteAsync()
    {
        busy = true;
        var result = await Api.DeleteAsync($"{Url}/{form.Id}?version={form.Version}");
        busy = false;

        if (result.IsSuccess)
        {
            dirty = false;
            await Deleted.InvokeAsync();
            return;
        }

        message = result.Error;
    }

    private sealed class ContactForm
    {
        public System.Text.Json.Nodes.JsonObject Custom { get; set; } = [];

        public Guid? Id { get; init; }

        public long? Version { get; init; }

        public string FirstName { get; set; } = string.Empty;

        public string LastName { get; set; } = string.Empty;

        public Guid? CompanyId { get; set; }

        public string? Title { get; set; }

        public string? Email { get; set; }

        public string? Phone { get; set; }

        public Guid? OwnerId { get; set; }

        public string? Notes { get; set; }
    }
}
