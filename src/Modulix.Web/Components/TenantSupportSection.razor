@inject ApiClient Api

@* Destek erişimi (ADR-0028 Dilim 7, Y1.3): platform hesabına bu firmada gerekçeli, süreli ve salt okunur erişim açar. Erişim firma
   yöneticilerine e-postayla bildirilir, firmanın ve platformun denetim kaydına yazılır; süresi dolunca kendiliğinden kapanır. *@
<section class="detail-section">
    <div class="section-header"><h2>@Texts.Get("admin.supportAccess.title")</h2></div>
    <p class="text-muted">@Texts.Strong("platform.support.intro", Texts.Get("admin.supportAccess.readOnly"))</p>

    <Notice Text="@notice" Failed="failed" />

    @if (Operational)
    {
        <form class="inline-form" novalidate @onsubmit="GrantAsync" @onsubmit:preventDefault>
            <h3>@Texts.Get("platform.support.grant")</h3>
            <div class="form-grid">
                <div>
                    <label class="form-label" for="supportReason">@Texts.Get("platform.reasonRequired")</label>
                    <input id="supportReason" class="form-control" maxlength="500" @bind="reason" @bind:event="oninput" />
                    <FieldError Field="reason" Errors="errors" />
                </div>
                <div>
                    <label class="form-label" for="supportMinutes">@Texts.Get("platform.support.minutes")</label>
                    <input id="supportMinutes" class="form-control" type="number" min="15" max="480" @bind="minutes" />
                    <FieldError Field="minutes" Errors="errors" />
                </div>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary" disabled="@(busy || string.IsNullOrWhiteSpace(reason))">@Texts.Get("platform.support.grant")</button>
            </div>
        </form>
    }

    @if (items is not null && items.Count > 0)
    {
        <table class="table record-table">
            <thead><tr><th>@Texts.Get("admin.supportAccess.col.person")</th><th>@Texts.Get("admin.supportAccess.col.reason")</th><th>@Texts.Get("admin.supportAccess.col.start")</th><th>@Texts.Get("admin.supportAccess.col.end")</th><th>@Texts.Get("common.field.status")</th><th></th></tr></thead>
            <tbody>
                @foreach (var item in items)
                {
                    <tr>
                        <td data-label="@Texts.Get("admin.supportAccess.col.person")" class="primary">@item.UserName</td>
                        <td data-label="@Texts.Get("admin.supportAccess.col.reason")">@item.Reason</td>
                        <td data-label="@Texts.Get("admin.supportAccess.col.start")">@CrmLabels.Time(item.GrantedAt)</td>
                        <td data-label="@Texts.Get("admin.supportAccess.col.end")">@CrmLabels.Time(item.EndedAt ?? item.ExpiresAt)</td>
                        <td data-label="@Texts.Get("common.field.status")">
                            <span class="badge @(item.State == SupportAccessStateDto.Active ? "user-active" : "user-disabled")">@StateText(item.State)</span>
                        </td>
                        <td class="actions">
                            <button type="button" class="btn btn-ghost btn-sm" @onclick="() => ToggleReadsAsync(item.Id)">@Texts.Get("platform.support.reads")</button>
                            @if (item.State == SupportAccessStateDto.Active)
                            {
                                <button type="button" class="btn btn-outline-danger btn-sm" disabled="@busy" @onclick="() => RevokeAsync(item.Id)">@Texts.Get("common.close")</button>
                            }
                        </td>
                    </tr>
                    @if (openGrant == item.Id)
                    {
                        <tr>
                            <td colspan="6">
                                @if (reads is null)
                                {
                                    <span class="text-muted">@Texts.Get("common.loading")</span>
                                }
                                else if (reads.Count == 0)
                                {
                                    <span class="text-muted">@Texts.Get("platform.support.noReads")</span>
                                }
                                else
                                {
                                    <ul class="list-unstyled">
                                        @foreach (var read in reads)
                                        {
                                            <li><span class="text-muted">@CrmLabels.Time(read.At)</span> <strong>@read.Method</strong> @read.Path</li>
                                        }
                                    </ul>
                                    <p class="text-muted">@Texts.Get("platform.support.readsNote")</p>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    }
</section>

@code {
    [Parameter, EditorRequired] public Guid TenantId { get; set; }

    /// <summary>Firma açık (Açık ya da Deneme) değilse erişim açılamaz.</summary>
    [Parameter] public bool Operational { get; set; } = true;

    [Parameter] public EventCallback Changed { get; set; }

    private IReadOnlyList<SupportAccessDto>? items;
    private string reason = string.Empty;
    private int minutes = 60;
    private IReadOnlyDictionary<string, string[]>? errors;
    private string? notice;
    private bool failed;
    private bool busy;
    private Guid? openGrant;
    private IReadOnlyList<SupportAccessReadDto>? reads;

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        var result = await Api.GetAsync<List<SupportAccessDto>>($"/api/platform/support-access?tenantId={TenantId}");
        items = result.Value;
    }

    private async Task GrantAsync()
    {
        busy = true;
        var result = await Api.PostAsync<SupportAccessDto>($"/api/platform/tenants/{TenantId}/support-access", new GrantSupportAccessRequest(reason, minutes));
        busy = false;
        errors = result.FieldErrors;
        if (!result.IsSuccess)
        {
            (notice, failed) = (result.FieldErrors.Count > 0 ? null : result.Error, true);
            return;
        }

        (notice, failed, reason) = (Texts.Get("platform.support.granted", CrmLabels.Time(result.Value!.ExpiresAt)), false, string.Empty);
        await LoadAsync();
        await Changed.InvokeAsync();
    }

    private async Task RevokeAsync(Guid grantId)
    {
        busy = true;
        var result = await Api.PostAsync<bool>($"/api/platform/support-access/{grantId}/revoke?reason={Uri.EscapeDataString("Platform ekibi kapattı")}", new { });
        busy = false;
        (notice, failed) = result.IsSuccess ? (Texts.Get("platform.support.revoked"), false) : (result.Error, true);
        await LoadAsync();
    }

    private async Task ToggleReadsAsync(Guid grantId)
    {
        if (openGrant == grantId)
        {
            openGrant = null;
            return;
        }

        (openGrant, reads) = (grantId, null);
        var result = await Api.GetAsync<List<SupportAccessReadDto>>($"/api/platform/support-access/{grantId}/reads");
        reads = result.IsSuccess ? result.Value : [];
        if (!result.IsSuccess)
        {
            (notice, failed) = (result.Error, true);
        }
    }

    private static string StateText(SupportAccessStateDto state) => state switch
    {
        SupportAccessStateDto.Active => Texts.Get("admin.supportAccess.state.active"),
        SupportAccessStateDto.Expired => Texts.Get("admin.supportAccess.state.expired"),
        _ => Texts.Get("admin.supportAccess.state.revoked"),
    };
}
