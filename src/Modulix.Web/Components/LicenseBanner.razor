@inject SessionState Session

@* Lisans süresi uyarısı (ADR-0028): yalnızca firma yöneticisine; süresi yaklaşan, ek sürede olan ve salt okunura geçmiş modüller.
   Sunucu da yazmayı reddeder (salt okunur modüle yazma 403); bu yalnızca nedenini açıklar. *@
@if (Session.Access is { IsAdministrator: true, Licenses.Count: > 0 } access)
{
    @foreach (var license in access.Licenses)
    {
        <div class="alert @(license.Phase == LicensePhase.ReadOnly ? "alert-danger" : "alert-warning")" role="alert">
            @switch (license.Phase)
            {
                case LicensePhase.ReadOnly:
                    <strong>@license.DisplayName</strong> <span>@Texts.Get("shell.license.readOnly", CrmLabels.Time(license.ValidUntil))</span>
                    break;
                case LicensePhase.Grace:
                    <strong>@license.DisplayName</strong> <span>@Texts.Get("shell.license.grace", CrmLabels.Time(license.ValidUntil), CrmLabels.Time(license.GraceEndsAt))</span>
                    break;
                default:
                    <strong>@license.DisplayName</strong> <span>@Texts.Get("shell.license.expiring", CrmLabels.Time(license.ValidUntil))</span>
                    break;
            }
        </div>
    }
}
