@* Fırsat ekleme/düzenleme formu; Fırsatlar sayfası, fırsat detayı ve firma detay sayfası (çekmecede) kullanır.
   Alanlar firmanın form düzenine (ADR-0021) göre bölüm kartlarına ve sekmelere yerleşir; her alanın girdisi burada tanımlıdır.
   Tutar alanları izne bağlı, firma sabitse (firma detayı) çizilmez. Kaydetme davranışı değişmedi; aşama yalnızca aşama eylemleriyle değişir. *@
@inject ApiClient Api
@inject SessionState Session
@inject FormLayouts Layouts

<form class="record-form sectioned" novalidate @onsubmit="SaveAsync" @onsubmit:preventDefault>
    <div class="form-toolbar">
        <div>
            <h2>@(Opportunity is null ? "Yeni fırsat" : "Fırsat kartı")</h2>
            @if (Opportunity is not null)
            {
                <p>@Opportunity.Title</p>
            }
        </div>
        <div class="form-toolbar-actions">
            <button type="button" class="btn btn-outline-secondary" @onclick="Cancelled">İptal</button>
            <button type="submit" class="btn btn-primary" disabled="@(busy || layout is null)">
                @if (busy)
                {
                    <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                }
                Kaydet
            </button>
        </div>
    </div>

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }
    @if (layoutError is not null)
    {
        <div class="alert alert-danger" role="alert">@layoutError</div>
    }

    <LayoutForm Layout="layout" Shows="Shows" CustomFields="CustomFields" CustomValues="form.Custom" Errors="errors" TabsLabel="Fırsat formu bölümleri">
        <Field Context="f">
            @switch (f.Key)
            {
                case "title":
                    <label class="@f.LabelClass()" for="title">@f.Label</label>
                    <input id="title" class="form-control" maxlength="@CrmLimits.TextMaxLength" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.Title" />
                    <FieldError Field="title" Errors="errors" />
                    break;
                case "companyId":
                    <label class="@f.LabelClass()" for="companyId">@f.Label</label>
                    <LookupPicker Id="companyId" LookupKey="crm.opportunity.company" @bind-Value="form.CompanyId" Required="true" Invalid="@(errors?.ContainsKey("companyId") == true)" />
                    <FieldError Field="companyId" Errors="errors" />
                    break;
                case "contactId":
                    <label class="@f.LabelClass()" for="contactId">@f.Label</label>
                    <LookupPicker Id="contactId" LookupKey="crm.opportunity.contact" @bind-Value="form.ContactId" ParentId="form.CompanyId" Required="f.Required" Placeholder="—" Invalid="@(errors?.ContainsKey("contactId") == true)" />
                    <FieldError Field="contactId" Errors="errors" />
                    break;
                case "stage":
                    <label class="@f.LabelClass()" for="stage">@f.Label</label>
                    @if (Opportunity is null)
                    {
                        <select id="stage" class="form-select" @bind="form.Stage">
                            @foreach (var stage in Lookups.Choices(CrmLists.OpportunityStage).Where(s => s.Category == CrmLists.StageCategories.Open))
                            {
                                <option value="@stage.Key">@stage.Label</option>
                            }
                        </select>
                    }
                    else
                    {
                        // Aşama yalnızca aşama değiştirme / kapatma eylemleriyle değişir (panodaki taşıma ya da fırsat sayfası).
                        <input id="stage" class="form-control" readonly value="@Lookups.Label(CrmLists.OpportunityStage, form.Stage)" />
                    }
                    <FieldError Field="stage" Errors="errors" />
                    break;
                case "priority":
                    <label class="@f.LabelClass()" for="priority">@f.Label</label>
                    <select id="priority" class="form-select" @bind="form.Priority">
                        @foreach (var priority in LeadPriority.All)
                        {
                            <option value="@priority">@LeadPriority.Label(priority)</option>
                        }
                    </select>
                    break;
                case "type":
                    <label class="@f.LabelClass()" for="type">@f.Label</label>
                    <select id="type" class="form-select" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.Type">
                        <option value="">—</option>
                        @foreach (var type in Lookups.Choices(CrmLists.OpportunityType, form.Type))
                        {
                            <option value="@type.Key">@type.Label</option>
                        }
                    </select>
                    <FieldError Field="type" Errors="errors" />
                    break;
                case "source":
                    <label class="@f.LabelClass()" for="source">@f.Label</label>
                    <select id="source" class="form-select" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.Source">
                        <option value="">—</option>
                        @foreach (var source in Lookups.Choices(CrmLeadLists.Source, form.Source))
                        {
                            <option value="@source.Key">@source.Label</option>
                        }
                    </select>
                    <FieldError Field="source" Errors="errors" />
                    break;
                case "ownerId":
                    <label class="@f.LabelClass()" for="ownerId">@f.Label</label>
                    <LookupPicker Id="ownerId" LookupKey="crm.opportunity.owner" @bind-Value="form.OwnerId" Required="f.Required" Placeholder="@(Opportunity is null ? "Ben" : "—")" Invalid="@(errors?.ContainsKey("ownerId") == true)" />
                    <FieldError Field="ownerId" Errors="errors" />
                    break;
                case "amount":
                    <label class="@f.LabelClass()" for="amount">@f.Label</label>
                    <input id="amount" class="form-control" type="number" min="0" step="0.01" inputmode="decimal" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.Amount" />
                    <FieldError Field="amount" Errors="errors" />
                    break;
                case "probability":
                    <label class="@f.LabelClass()" for="probability">@f.Label</label>
                    <input id="probability" class="form-control" type="number" min="0" max="100" step="5" inputmode="numeric" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.Probability" />
                    <FieldError Field="probability" Errors="errors" />
                    break;
                case "currency":
                    <label class="@f.LabelClass()" for="currency">@f.Label</label>
                    <input id="currency" class="form-control" maxlength="3" @bind="form.Currency" />
                    <FieldError Field="currency" Errors="errors" />
                    break;
                case "expectedCloseDate":
                    <label class="@f.LabelClass()" for="expectedCloseDate">@f.Label</label>
                    <input id="expectedCloseDate" class="form-control" type="date" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.ExpectedCloseDate" />
                    <FieldError Field="expectedCloseDate" Errors="errors" />
                    break;
                case "targetDecisionDate":
                    <label class="@f.LabelClass()" for="targetDecisionDate">@f.Label</label>
                    <input id="targetDecisionDate" class="form-control" type="date" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.TargetDecisionDate" />
                    <FieldError Field="targetDecisionDate" Errors="errors" />
                    break;
                case "customerBudget":
                    <label class="@f.LabelClass()" for="customerBudget">@f.Label</label>
                    <input id="customerBudget" class="form-control" type="number" min="0" step="0.01" inputmode="decimal" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.CustomerBudget" />
                    <FieldError Field="customerBudget" Errors="errors" />
                    break;
                case "budgetStatus":
                    <label class="@f.LabelClass()" for="budgetStatus">@f.Label</label>
                    <select id="budgetStatus" class="form-select" @bind="form.BudgetStatus">
                        @foreach (var status in OpportunityBudgetStatus.All)
                        {
                            <option value="@status">@OpportunityBudgetStatus.Label(status)</option>
                        }
                    </select>
                    break;
                case "nextAction":
                    <label class="@f.LabelClass()" for="nextAction">@f.Label</label>
                    <input id="nextAction" class="form-control" maxlength="200" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.NextAction" />
                    <FieldError Field="nextAction" Errors="errors" />
                    break;
                case "nextActionDate":
                    <label class="@f.LabelClass()" for="nextActionDate">@f.Label</label>
                    <input id="nextActionDate" class="form-control" type="date" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.NextActionDate" />
                    <FieldError Field="nextActionDate" Errors="errors" />
                    break;
                case "needDescription":
                    <label class="@f.LabelClass()" for="needDescription">@f.Label</label>
                    <textarea id="needDescription" class="form-control" rows="2" maxlength="4000" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.NeedDescription"></textarea>
                    <FieldError Field="needDescription" Errors="errors" />
                    break;
                case "currentProblem":
                    <label class="@f.LabelClass()" for="currentProblem">@f.Label</label>
                    <textarea id="currentProblem" class="form-control" rows="2" maxlength="4000" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.CurrentProblem"></textarea>
                    <FieldError Field="currentProblem" Errors="errors" />
                    break;
                case "expectedBenefit":
                    <label class="@f.LabelClass()" for="expectedBenefit">@f.Label</label>
                    <textarea id="expectedBenefit" class="form-control" rows="2" maxlength="4000" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.ExpectedBenefit"></textarea>
                    <FieldError Field="expectedBenefit" Errors="errors" />
                    break;
                case "scope":
                    <label class="@f.LabelClass()" for="scope">@f.Label</label>
                    <textarea id="scope" class="form-control" rows="2" maxlength="4000" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.Scope"></textarea>
                    <FieldError Field="scope" Errors="errors" />
                    break;
                case "serviceScope":
                    <label class="@f.LabelClass()" for="serviceScope">@f.Label</label>
                    <ActivityCodePicker Id="serviceScope" ActivitiesOnly="true" @bind-Selected="form.ServiceScope" />
                    <FieldError Field="serviceScope" Errors="errors" />
                    break;
                case "successCriteria":
                    <label class="@f.LabelClass()" for="successCriteria">@f.Label</label>
                    <textarea id="successCriteria" class="form-control" rows="2" maxlength="4000" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.SuccessCriteria"></textarea>
                    <FieldError Field="successCriteria" Errors="errors" />
                    break;
                case "risks":
                    <label class="@f.LabelClass()" for="risks">@f.Label</label>
                    <textarea id="risks" class="form-control" rows="2" maxlength="4000" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.Risks"></textarea>
                    <FieldError Field="risks" Errors="errors" />
                    break;
                case "decisionProcess":
                    <label class="@f.LabelClass()" for="decisionProcess">@f.Label</label>
                    <textarea id="decisionProcess" class="form-control" rows="2" maxlength="4000" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.DecisionProcess"></textarea>
                    <FieldError Field="decisionProcess" Errors="errors" />
                    break;
                case "description":
                    <label class="@f.LabelClass()" for="description">@f.Label</label>
                    <textarea id="description" class="form-control" rows="2" maxlength="4000" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.Description"></textarea>
                    <FieldError Field="description" Errors="errors" />
                    break;
                case "notes":
                    <label class="@f.LabelClass()" for="notes">@f.Label</label>
                    <textarea id="notes" class="form-control" rows="3" maxlength="@CrmLimits.NotesMaxLength" required="@f.Required" aria-required="@f.AriaRequired()" @bind="form.Notes"></textarea>
                    <FieldError Field="notes" Errors="errors" />
                    break;
            }
        </Field>
    </LayoutForm>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary" disabled="@(busy || layout is null)">Kaydet</button>
        <button type="button" class="btn btn-outline-secondary" @onclick="Cancelled">İptal</button>
        @if (Opportunity is not null)
        {
            <button type="button" class="btn btn-outline-danger ms-auto" disabled="@busy" @onclick="DeleteAsync">Sil</button>
        }
    </div>
</form>

@code {
    private FormLayoutDto? layout;
    private string? layoutError;

    /// <summary>Firmanın form düzeni (ADR-0021): bölüm, sekme, sıra, genişlik, zorunluluk. Yüklenemezse form kaydedilemez.</summary>
    protected override async Task OnInitializedAsync()
    {
        layout = await Layouts.ForAsync(CrmEntityKeys.Opportunity);
        layoutError = layout is null ? "Form düzeni yüklenemedi; sayfayı yenileyip yeniden deneyin." : null;
    }

    // Düzen alanı çizilsin mi: firma sabitse (firma detayı) seçilmez; tutar alanları hassastır (Y8b), izni olmayan görmez.
    private bool Shows(FormFieldDto field) => field.Key switch
    {
        "companyId" => FixedCompanyId is null,
        "amount" or "probability" or "customerBudget" => Session.Can(CrmAccess.OpportunityAmountsRead),
        _ => true,
    };

    private const string Url = "/api/crm/opportunities";

    private OpportunityForm form = new();
    private OpportunityDto? source;
    private bool initialized;
    private IReadOnlyDictionary<string, string[]>? errors;
    private string? message;
    private bool busy;

    /// <summary>Düzenlenecek fırsat; null ise yeni fırsat.</summary>
    [Parameter] public OpportunityDto? Opportunity { get; set; }

    /// <summary>Verilirse firma seçilemez (firma detay sayfası).</summary>
    [Parameter] public Guid? FixedCompanyId { get; set; }

    [Parameter, EditorRequired] public CrmLookups Lookups { get; set; } = default!;

    private IReadOnlyList<CustomFieldDto> CustomFields => [.. Lookups.FieldsOf(CrmEntityKeys.Opportunity)];

    [Parameter] public EventCallback<OpportunityDto> Saved { get; set; }

    [Parameter] public EventCallback Deleted { get; set; }

    [Parameter] public EventCallback Cancelled { get; set; }

    protected override void OnParametersSet()
    {
        if (initialized && ReferenceEquals(source, Opportunity))
        {
            return;
        }

        initialized = true;
        source = Opportunity;
        form = Opportunity is { } o
            ? new OpportunityForm
            {
                Id = o.Id, Version = o.Version, Title = o.Title, CompanyId = o.CompanyId, ContactId = o.ContactId, Stage = o.Stage,
                Probability = o.Probability, Amount = o.Amount, Currency = o.Currency, ExpectedCloseDate = o.ExpectedCloseDate,
                LostReason = o.LostReason, OwnerId = o.OwnerId, Notes = o.Notes,
                Description = o.Description, Priority = o.Priority, Type = o.Type, Source = o.Source, CustomerBudget = o.CustomerBudget,
                BudgetStatus = o.BudgetStatus, NeedDescription = o.NeedDescription, CurrentProblem = o.CurrentProblem,
                ExpectedBenefit = o.ExpectedBenefit, Scope = o.Scope, ServiceScope = [.. o.ServiceScope ?? []], SuccessCriteria = o.SuccessCriteria, Risks = o.Risks,
                DecisionProcess = o.DecisionProcess, TargetDecisionDate = o.TargetDecisionDate, NextAction = o.NextAction, NextActionDate = o.NextActionDate,
                    Custom = o.Custom?.DeepClone().AsObject() ?? [],
            }
            : new OpportunityForm { CompanyId = FixedCompanyId, Stage = Lookups.DefaultOf(CrmLists.OpportunityStage) ?? OpportunityStage.Lead };
        errors = null;
        message = null;
    }

    private async Task SaveAsync()
    {
        if (form.CompanyId is not { } companyId)
        {
            errors = new Dictionary<string, string[]> { ["companyId"] = ["Bu alan zorunludur."] };
            return;
        }

        busy = true;
        var request = new SaveOpportunityRequest(
            form.Title, companyId, form.ContactId, form.Stage, form.Amount, form.Currency, form.ExpectedCloseDate, form.Notes, form.Version,
            form.Probability, form.LostReason, form.OwnerId, Custom: CustomFieldText.ForSave(CustomFields, form.Custom),
            Description: form.Description, Priority: form.Priority, Type: NullIfEmpty(form.Type), Source: NullIfEmpty(form.Source),
            CustomerBudget: form.CustomerBudget, BudgetStatus: form.BudgetStatus, NeedDescription: form.NeedDescription,
            CurrentProblem: form.CurrentProblem, ExpectedBenefit: form.ExpectedBenefit, Scope: form.Scope, SuccessCriteria: form.SuccessCriteria,
            Risks: form.Risks, DecisionProcess: form.DecisionProcess, TargetDecisionDate: form.TargetDecisionDate,
            NextAction: form.NextAction, NextActionDate: form.NextActionDate, ServiceScope: form.ServiceScope);
        var result = form.Id is { } id
            ? await Api.PutAsync<OpportunityDto>($"{Url}/{id}", request)
            : await Api.PostAsync<OpportunityDto>(Url, request);
        busy = false;

        if (result.IsSuccess)
        {
            await Saved.InvokeAsync(result.Value);
            return;
        }

        errors = result.FieldErrors;
        message = result.Error;
    }

    private static string? NullIfEmpty(string? text) => string.IsNullOrWhiteSpace(text) ? null : text;

    private async Task DeleteAsync()
    {
        busy = true;
        var result = await Api.DeleteAsync($"{Url}/{form.Id}?version={form.Version}");
        busy = false;

        if (result.IsSuccess)
        {
            await Deleted.InvokeAsync();
            return;
        }

        message = result.Error;
    }

    private sealed class OpportunityForm
    {
        public System.Text.Json.Nodes.JsonObject Custom { get; set; } = [];

        public Guid? Id { get; init; }

        public long? Version { get; init; }

        public string Title { get; set; } = string.Empty;

        public Guid? CompanyId { get; set; }

        public Guid? ContactId { get; set; }

        public string Stage { get; set; } = OpportunityStage.Lead;

        public int? Probability { get; set; }

        public decimal? Amount { get; set; }

        // Yeni fırsatın para birimi firmanın varsayılanıdır (Y6b).
        public string Currency { get; set; } = Regional.Currency;

        public DateOnly? ExpectedCloseDate { get; set; }

        public string? LostReason { get; set; }

        public string? Description { get; set; }

        public string Priority { get; set; } = "Normal";

        public string? Type { get; set; }

        public string? Source { get; set; }

        public decimal? CustomerBudget { get; set; }

        public string BudgetStatus { get; set; } = OpportunityBudgetStatus.Unknown;

        public string? NeedDescription { get; set; }

        public string? CurrentProblem { get; set; }

        public string? ExpectedBenefit { get; set; }

        public string? Scope { get; set; }

        public List<string> ServiceScope { get; set; } = [];

        public string? SuccessCriteria { get; set; }

        public string? Risks { get; set; }

        public string? DecisionProcess { get; set; }

        public DateOnly? TargetDecisionDate { get; set; }

        public string? NextAction { get; set; }

        public DateOnly? NextActionDate { get; set; }

        public Guid? OwnerId { get; set; }

        public string? Notes { get; set; }
    }
}
