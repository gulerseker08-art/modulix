@* Fırsat ekleme/düzenleme formu; Fırsatlar sayfası ve firma detay sayfası kullanır. *@
@inject ApiClient Api
@inject SessionState Session

<form class="record-form" novalidate @onsubmit="SaveAsync" @onsubmit:preventDefault>
    <h2>@(Opportunity is null ? "Yeni fırsat" : "Fırsatı düzenle")</h2>

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }

    <div class="form-grid">
        <div class="span-all">
            <label class="form-label" for="title">Başlık *</label>
            <input id="title" class="form-control" maxlength="@CrmLimits.TextMaxLength" @bind="form.Title" />
            <FieldError Field="title" Errors="errors" />
        </div>
        @if (FixedCompanyId is null)
        {
            <div>
                <label class="form-label" for="companyId">Firma *</label>
                <LookupPicker Id="companyId" LookupKey="crm.opportunity.company" @bind-Value="form.CompanyId" Required="true" Invalid="@(errors?.ContainsKey("companyId") == true)" />
                <FieldError Field="companyId" Errors="errors" />
            </div>
        }
        <div>
            <label class="form-label" for="contactId">Kişi</label>
            <LookupPicker Id="contactId" LookupKey="crm.opportunity.contact" @bind-Value="form.ContactId" ParentId="form.CompanyId" Placeholder="—" Invalid="@(errors?.ContainsKey("contactId") == true)" />
            <FieldError Field="contactId" Errors="errors" />
        </div>
        <div>
            <label class="form-label" for="stage">Aşama</label>
            @if (Opportunity is null)
            {
                <select id="stage" class="form-select" @bind="form.Stage">
                    @foreach (var stage in Lookups.Choices(CrmLists.OpportunityStage).Where(s => s.Category == CrmLists.StageCategories.Open))
                    {
                        <option value="@stage.Key">@stage.Label</option>
                    }
                </select>
            }
            else
            {
                // Aşama yalnızca aşama değiştirme / kapatma eylemleriyle değişir (panodaki taşıma ya da fırsat sayfası).
                <input id="stage" class="form-control" readonly value="@Lookups.Label(CrmLists.OpportunityStage, form.Stage)" />
            }
            <FieldError Field="stage" Errors="errors" />
        </div>
        <div>
            <label class="form-label" for="priority">Öncelik</label>
            <select id="priority" class="form-select" @bind="form.Priority">
                @foreach (var priority in LeadPriority.All)
                {
                    <option value="@priority">@LeadPriority.Label(priority)</option>
                }
            </select>
        </div>
        <div>
            <label class="form-label" for="type">Tür</label>
            <select id="type" class="form-select" @bind="form.Type">
                <option value="">—</option>
                @foreach (var type in Lookups.Choices(CrmLists.OpportunityType, form.Type))
                {
                    <option value="@type.Key">@type.Label</option>
                }
            </select>
        </div>
        <div>
            <label class="form-label" for="source">Edinim kaynağı</label>
            <select id="source" class="form-select" @bind="form.Source">
                <option value="">—</option>
                @foreach (var source in Lookups.Choices(CrmLeadLists.Source, form.Source))
                {
                    <option value="@source.Key">@source.Label</option>
                }
            </select>
        </div>
        @* Tutar ve olasılık hassas alandır (Y8b): izni olmayan görmez; boş gönderilir, sunucu kayıttaki değeri korur. *@
        @if (Session.Can(CrmAccess.OpportunityAmountsRead))
        {
            <div>
                <label class="form-label" for="probability">Olasılık (%)</label>
                <input id="probability" class="form-control" type="number" min="0" max="100" step="5" inputmode="numeric" @bind="form.Probability" />
                <FieldError Field="probability" Errors="errors" />
            </div>
            <div>
                <label class="form-label" for="amount">Tutar</label>
                <input id="amount" class="form-control" type="number" min="0" step="0.01" inputmode="decimal" @bind="form.Amount" />
                <FieldError Field="amount" Errors="errors" />
            </div>
        }
        <div>
            <label class="form-label" for="currency">Para birimi</label>
            <input id="currency" class="form-control" maxlength="3" @bind="form.Currency" />
            <FieldError Field="currency" Errors="errors" />
        </div>
        <div>
            <label class="form-label" for="expectedCloseDate">Beklenen kapanış</label>
            <input id="expectedCloseDate" class="form-control" type="date" @bind="form.ExpectedCloseDate" />
            <FieldError Field="expectedCloseDate" Errors="errors" />
        </div>
        <div>
            <label class="form-label" for="ownerId">Sorumlu</label>
            <LookupPicker Id="ownerId" LookupKey="crm.opportunity.owner" @bind-Value="form.OwnerId" Placeholder="@(Opportunity is null ? "Ben" : "—")" Invalid="@(errors?.ContainsKey("ownerId") == true)" />
            <FieldError Field="ownerId" Errors="errors" />
        </div>
        <div class="span-all">
            <label class="form-label" for="description">Açıklama</label>
            <textarea id="description" class="form-control" rows="2" maxlength="4000" @bind="form.Description"></textarea>
            <FieldError Field="description" Errors="errors" />
        </div>
        <div>
            <label class="form-label" for="nextAction">Sonraki aksiyon</label>
            <input id="nextAction" class="form-control" maxlength="200" @bind="form.NextAction" />
            <FieldError Field="nextAction" Errors="errors" />
        </div>
        <div>
            <label class="form-label" for="nextActionDate">Aksiyon tarihi</label>
            <input id="nextActionDate" class="form-control" type="date" @bind="form.NextActionDate" />
            <FieldError Field="nextActionDate" Errors="errors" />
        </div>
        @if (Session.Can(CrmAccess.OpportunityAmountsRead))
        {
            <div>
                <label class="form-label" for="customerBudget">Müşteri bütçesi</label>
                <input id="customerBudget" class="form-control" type="number" min="0" step="0.01" inputmode="decimal" @bind="form.CustomerBudget" />
                <FieldError Field="customerBudget" Errors="errors" />
            </div>
        }
        <div>
            <label class="form-label" for="budgetStatus">Bütçe durumu</label>
            <select id="budgetStatus" class="form-select" @bind="form.BudgetStatus">
                @foreach (var status in OpportunityBudgetStatus.All)
                {
                    <option value="@status">@OpportunityBudgetStatus.Label(status)</option>
                }
            </select>
        </div>
        <div>
            <label class="form-label" for="targetDecisionDate">Hedef karar tarihi</label>
            <input id="targetDecisionDate" class="form-control" type="date" @bind="form.TargetDecisionDate" />
            <FieldError Field="targetDecisionDate" Errors="errors" />
        </div>
        <details class="span-all">
            <summary>İhtiyaç analizi</summary>
            <label class="form-label" for="needDescription">İhtiyaç</label>
            <textarea id="needDescription" class="form-control" rows="2" maxlength="4000" @bind="form.NeedDescription"></textarea>
            <label class="form-label" for="currentProblem">Mevcut sorun</label>
            <textarea id="currentProblem" class="form-control" rows="2" maxlength="4000" @bind="form.CurrentProblem"></textarea>
            <label class="form-label" for="expectedBenefit">Beklenen fayda</label>
            <textarea id="expectedBenefit" class="form-control" rows="2" maxlength="4000" @bind="form.ExpectedBenefit"></textarea>
            <label class="form-label" for="scope">Kapsam</label>
            <textarea id="scope" class="form-control" rows="2" maxlength="4000" @bind="form.Scope"></textarea>
            <label class="form-label" for="successCriteria">Başarı ölçütleri</label>
            <textarea id="successCriteria" class="form-control" rows="2" maxlength="4000" @bind="form.SuccessCriteria"></textarea>
            <label class="form-label" for="risks">Riskler ve engeller</label>
            <textarea id="risks" class="form-control" rows="2" maxlength="4000" @bind="form.Risks"></textarea>
            <label class="form-label" for="decisionProcess">Karar süreci</label>
            <textarea id="decisionProcess" class="form-control" rows="2" maxlength="4000" @bind="form.DecisionProcess"></textarea>
        </details>
        <div class="span-all">
            <label class="form-label" for="notes">Notlar</label>
            <textarea id="notes" class="form-control" rows="3" maxlength="@CrmLimits.NotesMaxLength" @bind="form.Notes"></textarea>
            <FieldError Field="notes" Errors="errors" />
        </div>
        <CustomFieldInputs Fields="CustomFields" Values="form.Custom" Errors="errors" />
    </div>
    <div class="form-actions">
        <button type="submit" class="btn btn-primary" disabled="@busy">Kaydet</button>
        <button type="button" class="btn btn-outline-secondary" @onclick="Cancelled">Vazgeç</button>
        @if (Opportunity is not null)
        {
            <button type="button" class="btn btn-outline-danger ms-auto" disabled="@busy" @onclick="DeleteAsync">Sil</button>
        }
    </div>
</form>

@code {
    private const string Url = "/api/crm/opportunities";

    private OpportunityForm form = new();
    private OpportunityDto? source;
    private bool initialized;
    private IReadOnlyDictionary<string, string[]>? errors;
    private string? message;
    private bool busy;

    /// <summary>Düzenlenecek fırsat; null ise yeni fırsat.</summary>
    [Parameter] public OpportunityDto? Opportunity { get; set; }

    /// <summary>Verilirse firma seçilemez (firma detay sayfası).</summary>
    [Parameter] public Guid? FixedCompanyId { get; set; }

    [Parameter, EditorRequired] public CrmLookups Lookups { get; set; } = default!;

    private IReadOnlyList<CustomFieldDto> CustomFields => [.. Lookups.FieldsOf(CrmEntityKeys.Opportunity)];

    [Parameter] public EventCallback<OpportunityDto> Saved { get; set; }

    [Parameter] public EventCallback Deleted { get; set; }

    [Parameter] public EventCallback Cancelled { get; set; }

    protected override void OnParametersSet()
    {
        if (initialized && ReferenceEquals(source, Opportunity))
        {
            return;
        }

        initialized = true;
        source = Opportunity;
        form = Opportunity is { } o
            ? new OpportunityForm
            {
                Id = o.Id, Version = o.Version, Title = o.Title, CompanyId = o.CompanyId, ContactId = o.ContactId, Stage = o.Stage,
                Probability = o.Probability, Amount = o.Amount, Currency = o.Currency, ExpectedCloseDate = o.ExpectedCloseDate,
                LostReason = o.LostReason, OwnerId = o.OwnerId, Notes = o.Notes,
                Description = o.Description, Priority = o.Priority, Type = o.Type, Source = o.Source, CustomerBudget = o.CustomerBudget,
                BudgetStatus = o.BudgetStatus, NeedDescription = o.NeedDescription, CurrentProblem = o.CurrentProblem,
                ExpectedBenefit = o.ExpectedBenefit, Scope = o.Scope, SuccessCriteria = o.SuccessCriteria, Risks = o.Risks,
                DecisionProcess = o.DecisionProcess, TargetDecisionDate = o.TargetDecisionDate, NextAction = o.NextAction, NextActionDate = o.NextActionDate,
                    Custom = o.Custom?.DeepClone().AsObject() ?? [],
            }
            : new OpportunityForm { CompanyId = FixedCompanyId, Stage = Lookups.DefaultOf(CrmLists.OpportunityStage) ?? OpportunityStage.Lead };
        errors = null;
        message = null;
    }

    private async Task SaveAsync()
    {
        if (form.CompanyId is not { } companyId)
        {
            errors = new Dictionary<string, string[]> { ["companyId"] = ["Bu alan zorunludur."] };
            return;
        }

        busy = true;
        var request = new SaveOpportunityRequest(
            form.Title, companyId, form.ContactId, form.Stage, form.Amount, form.Currency, form.ExpectedCloseDate, form.Notes, form.Version,
            form.Probability, form.LostReason, form.OwnerId, Custom: CustomFieldText.ForSave(CustomFields, form.Custom),
            Description: form.Description, Priority: form.Priority, Type: NullIfEmpty(form.Type), Source: NullIfEmpty(form.Source),
            CustomerBudget: form.CustomerBudget, BudgetStatus: form.BudgetStatus, NeedDescription: form.NeedDescription,
            CurrentProblem: form.CurrentProblem, ExpectedBenefit: form.ExpectedBenefit, Scope: form.Scope, SuccessCriteria: form.SuccessCriteria,
            Risks: form.Risks, DecisionProcess: form.DecisionProcess, TargetDecisionDate: form.TargetDecisionDate,
            NextAction: form.NextAction, NextActionDate: form.NextActionDate);
        var result = form.Id is { } id
            ? await Api.PutAsync<OpportunityDto>($"{Url}/{id}", request)
            : await Api.PostAsync<OpportunityDto>(Url, request);
        busy = false;

        if (result.IsSuccess)
        {
            await Saved.InvokeAsync(result.Value);
            return;
        }

        errors = result.FieldErrors;
        message = result.Error;
    }

    private static string? NullIfEmpty(string? text) => string.IsNullOrWhiteSpace(text) ? null : text;

    private async Task DeleteAsync()
    {
        busy = true;
        var result = await Api.DeleteAsync($"{Url}/{form.Id}?version={form.Version}");
        busy = false;

        if (result.IsSuccess)
        {
            await Deleted.InvokeAsync();
            return;
        }

        message = result.Error;
    }

    private sealed class OpportunityForm
    {
        public System.Text.Json.Nodes.JsonObject Custom { get; set; } = [];

        public Guid? Id { get; init; }

        public long? Version { get; init; }

        public string Title { get; set; } = string.Empty;

        public Guid? CompanyId { get; set; }

        public Guid? ContactId { get; set; }

        public string Stage { get; set; } = OpportunityStage.Lead;

        public int? Probability { get; set; }

        public decimal? Amount { get; set; }

        // Yeni fırsatın para birimi firmanın varsayılanıdır (Y6b).
        public string Currency { get; set; } = Regional.Currency;

        public DateOnly? ExpectedCloseDate { get; set; }

        public string? LostReason { get; set; }

        public string? Description { get; set; }

        public string Priority { get; set; } = "Normal";

        public string? Type { get; set; }

        public string? Source { get; set; }

        public decimal? CustomerBudget { get; set; }

        public string BudgetStatus { get; set; } = OpportunityBudgetStatus.Unknown;

        public string? NeedDescription { get; set; }

        public string? CurrentProblem { get; set; }

        public string? ExpectedBenefit { get; set; }

        public string? Scope { get; set; }

        public string? SuccessCriteria { get; set; }

        public string? Risks { get; set; }

        public string? DecisionProcess { get; set; }

        public DateOnly? TargetDecisionDate { get; set; }

        public string? NextAction { get; set; }

        public DateOnly? NextActionDate { get; set; }

        public Guid? OwnerId { get; set; }

        public string? Notes { get; set; }
    }
}
