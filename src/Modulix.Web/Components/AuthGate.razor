@* Oturum, aktif tenant ve (verilirse) izin ister; yoksa giriş veya tenant seçimine yönlendirir ya da uyarı gösterir.
   Asıl denetim sunucudadır; bu yalnızca kullanıcıyı doğru ekrana götürür. *@
@implements IDisposable
@inject SessionState Session
@inject NavigationManager Navigation

@if (!Session.IsLoaded)
{
    <p class="text-muted">Yükleniyor…</p>
}
else if (Session.IsSignedIn && Session.HasActiveTenant && (!Session.TwoFactorRequired || AllowWithoutTwoFactor))
{
    @if (Module is not null && !Session.IsModuleEnabled(Module))
    {
        <div class="alert alert-warning">Bu modül kuruluşunuz için açık değil.</div>
    }
    else if ((Permission is not null && !Session.Can(Permission))
             || (AnyPermission is not null && !Session.CanAny(AnyPermission)))
    {
        <div class="alert alert-warning">Bu ekranı görüntüleme yetkiniz yok. Yöneticinizden rol isteyin.</div>
    }
    else
    {
        @ChildContent
    }
}

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Firma iki adımlı doğrulama istese de gösterilir (Hesabım: kurulum orada yapılır).</summary>
    [Parameter] public bool AllowWithoutTwoFactor { get; set; }

    /// <summary>Modül anahtarı (ör. "crm"); tenant için kapalıysa içerik gösterilmez.</summary>
    [Parameter] public string? Module { get; set; }

    /// <summary>İzin anahtarı (ör. "crm.companies.read").</summary>
    [Parameter] public string? Permission { get; set; }

    /// <summary>İzinlerden en az biri yeterli (ör. yönetim giriş sayfası).</summary>
    [Parameter] public IReadOnlyList<string>? AnyPermission { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += OnChanged;
        await Session.EnsureLoadedAsync();
        Redirect();
    }

    private void OnChanged()
    {
        Redirect();
        InvokeAsync(StateHasChanged);
    }

    private void Redirect()
    {
        if (!Session.IsLoaded)
        {
            return;
        }

        if (!Session.IsSignedIn)
        {
            // Oturum kapanınca birden fazla bileşen aynı anda yönlendirebilir; giriş sayfasındaysak dönüş adresi bozulmasın.
            var current = Navigation.ToBaseRelativePath(Navigation.Uri);
            if (!current.StartsWith("giris", StringComparison.Ordinal))
            {
                Navigation.NavigateTo($"giris?donus={Uri.EscapeDataString(current)}");
            }
        }
        else if (!Session.HasActiveTenant)
        {
            Navigation.NavigateTo(Session.NoTenantHome);
        }
        else if (Session.TwoFactorRequired && !Navigation.ToBaseRelativePath(Navigation.Uri).StartsWith("hesabim", StringComparison.Ordinal))
        {
            // Firma iki adımlı doğrulama istiyor (Y7b): kurulum Hesabım'da yapılır.
            Navigation.NavigateTo("hesabim?iki-adim=gerekli");
        }
    }

    public void Dispose() => Session.Changed -= OnChanged;
}
