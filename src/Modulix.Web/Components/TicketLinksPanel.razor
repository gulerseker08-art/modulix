@* Talebin ilişkili kayıtları (ADR-0024, dilim 5): sözleşme, sipariş, teslimat. Bağlama sunucuda çağıranın yetkisiyle doğrulanır, kayıt talebin müşterisine ait olmalıdır; bu bileşen yalnızca seçim sunar.
   Etiket bağlandığı andaki numara ve başlıktır; karşı modül kapalıysa bağlantı çizilmez ama etiket okunur kalır. Sözleşme bağı SLA politikasını etkileyebilir. *@
@inject ApiClient Api
@inject SessionState Session

<section aria-labelledby="links-title">
    <h2 id="links-title">@Texts.Get("support.linksPanel.title")</h2>
    <Notice Text="@message" Failed="@failed" />
    @if (links is null)
    {
        <LoadingState />
    }
    else if (links.Count == 0)
    {
        <EmptyState Compact="true" Title="@Texts.Get("support.linksPanel.none")" />
    }
    else
    {
        <ul class="task-list">
            @foreach (var l in links)
            {
                <li>
                    <span class="badge stage-open">@Kind(l.EntityKey)</span>
                    @if (Href(l) is { } href && Session.IsModuleEnabled(ModuleOf(l.EntityKey))) { <a href="@href">@l.Label</a> }
                    else { <span>@l.Label</span> }
                    <small class="text-muted"> · @CrmLabels.Time(l.CreatedAt) · @Texts.Get("support.linksPanel.snapshot")</small>
                    @if (CanWrite)
                    {
                        <ConfirmAction Class="btn btn-sm btn-outline-secondary ms-2" Disabled="@busy" OnConfirm="() => RemoveAsync(l)">@Texts.Get("support.linksPanel.remove")</ConfirmAction>
                    }
                </li>
            }
        </ul>
    }

    @if (CanWrite)
    {
        @if (Ticket.PartyId is null)
        {
            <p class="small text-muted">@Texts.Get("support.linksPanel.needCustomer")</p>
        }
        else if (Kinds.Count > 0)
        {
            <form class="record-form" novalidate @onsubmit="AddAsync" @onsubmit:preventDefault>
                <fieldset disabled="@busy">
                    <legend class="h6">@Texts.Get("support.linksPanel.add")</legend>
                    <p class="small text-muted">@Texts.Get("support.linksPanel.help")</p>
                    <div class="form-grid">
                        <div class="span-4">
                            <label class="form-label" for="link-kind">@Texts.Get("common.field.kind")</label>
                            <select id="link-kind" class="form-select" @bind="kind" @bind:after="LoadOptionsAsync">
                                @foreach (var k in Kinds) { <option value="@k.Key">@k.Label</option> }
                            </select>
                        </div>
                        <div class="span-8">
                            <label class="form-label" for="link-record">@Texts.Get("support.linksPanel.record")</label>
                            <select id="link-record" class="form-select" @bind="recordId" aria-invalid="@(Has("recordId") ? "true" : null)">
                                <option value="">@(options is null ? Texts.Get("common.loading") : options.Count == 0 ? Texts.Get("support.linksPanel.noOptions") : Texts.Get("support.linksPanel.choose"))</option>
                                @foreach (var o in options ?? []) { <option value="@o.Id">@o.Label</option> }
                            </select>
                            <FieldError Field="recordId" Errors="errors" />
                        </div>
                    </div>
                </fieldset>
                <div class="form-actions"><button type="submit" class="btn btn-outline-secondary" disabled="@(busy || string.IsNullOrEmpty(recordId))">@Texts.Get("crm.opp.link")</button></div>
            </form>
        }
    }
</section>

@code {
    private sealed record Option(Guid Id, string Label);

    [Parameter, EditorRequired] public TicketDto Ticket { get; set; } = default!;

    /// <summary>Bağ değişince üst ekran talebi/SLA'yı yeniler.</summary>
    [Parameter] public EventCallback Changed { get; set; }

    private List<TicketLinkDto>? links;
    private List<Option>? options;
    private IReadOnlyDictionary<string, string[]>? errors;
    private string? message;
    private bool failed;
    private bool busy;
    private string kind = "contracts.contract";
    private string recordId = string.Empty;
    private Guid loadedFor;

    private bool CanWrite => Session.Can(SupportAccess.TicketsWrite) && Ticket.Status is not ("Closed" or "Cancelled" or "Merged");

    private bool Has(string field) => errors?.ContainsKey(field) == true;

    /// <summary>Kullanıcının ilgili modülü açık ve okuma izni olan kayıt türleri.</summary>
    private List<(string Key, string Label)> Kinds
    {
        get
        {
            var list = new List<(string, string)>();
            if (Session.IsModuleEnabled(ContractsAccess.ModuleKey) && Session.Can(ContractsAccess.ContractsRead)) { list.Add(("contracts.contract", Kind("contracts.contract"))); }
            if (Session.IsModuleEnabled(OrdersAccess.ModuleKey) && Session.Can(OrdersAccess.OrdersRead))
            {
                list.Add(("orders.order", Kind("orders.order")));
                list.Add(("orders.delivery", Kind("orders.delivery")));
            }

            return list;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (loadedFor == Ticket.Id) { return; }
        loadedFor = Ticket.Id;
        links = (await Api.GetAsync<List<TicketLinkDto>>($"/api/support/tickets/{Ticket.Id}/links")).Value ?? [];
        if (Kinds.Count > 0 && !Kinds.Any(k => k.Key == kind)) { kind = Kinds[0].Key; }
        await LoadOptionsAsync();
    }

    private async Task LoadOptionsAsync()
    {
        recordId = string.Empty;
        options = null;
        if (Ticket.PartyId is not { } party || Kinds.Count == 0) { options = []; return; }
        var linked = links?.Where(l => l.EntityKey == kind).Select(l => l.RecordId).ToHashSet() ?? [];
        switch (kind)
        {
            case "contracts.contract":
                options = ((await Api.GetAsync<PagedResult<ContractDto>>($"/api/contracts/contracts?partyId={party}&pageSize=50")).Value?.Items ?? [])
                    .Where(c => !linked.Contains(c.Id)).Select(c => new Option(c.Id, $"{c.Number} · {c.Title}")).ToList();
                break;
            case "orders.order":
                options = ((await Api.GetAsync<PagedResult<OrderDto>>($"/api/orders/orders?partyId={party}&pageSize=50")).Value?.Items ?? [])
                    .Where(o => !linked.Contains(o.Id)).Select(o => new Option(o.Id, $"{o.Number} · {o.Title}")).ToList();
                break;
            default:
                var orders = (await Api.GetAsync<PagedResult<OrderDto>>($"/api/orders/orders?partyId={party}&pageSize=50")).Value?.Items ?? [];
                var found = new List<Option>();
                foreach (var order in orders)
                {
                    var deliveries = (await Api.GetAsync<PagedResult<DeliveryDto>>($"/api/orders/deliveries?orderId={order.Id}&pageSize=20")).Value?.Items ?? [];
                    found.AddRange(deliveries.Where(d => !linked.Contains(d.Id)).Select(d => new Option(d.Id, $"{d.Number} · {order.Number}")));
                }

                options = found;
                break;
        }
    }

    private async Task AddAsync()
    {
        if (busy || !Guid.TryParse(recordId, out var id)) { return; }
        busy = true;
        message = null;
        errors = null;
        var result = await Api.PostAsync<List<TicketLinkDto>>($"/api/support/tickets/{Ticket.Id}/links", new AddTicketLinkRequest(kind, id));
        busy = false;
        failed = !result.IsSuccess;
        message = result.IsSuccess ? Texts.Get("support.linksPanel.added") : result.Error;
        errors = result.FieldErrors;
        if (result.IsSuccess)
        {
            links = result.Value;
            await LoadOptionsAsync();
            await Changed.InvokeAsync();
        }
    }

    private async Task RemoveAsync(TicketLinkDto link)
    {
        if (busy) { return; }
        busy = true;
        message = null;
        var result = await Api.DeleteAsync($"/api/support/tickets/{Ticket.Id}/links/{link.Id}");
        busy = false;
        failed = !result.IsSuccess;
        message = result.IsSuccess ? Texts.Get("support.linksPanel.removed") : result.Error;
        if (result.IsSuccess)
        {
            links = (await Api.GetAsync<List<TicketLinkDto>>($"/api/support/tickets/{Ticket.Id}/links")).Value ?? [];
            await LoadOptionsAsync();
            await Changed.InvokeAsync();
        }
    }

    private static string Kind(string entityKey) => entityKey switch
    {
        "contracts.contract" => Texts.Get("support.linksPanel.kind.contract"),
        "orders.order" => Texts.Get("support.linksPanel.kind.order"),
        "orders.delivery" => Texts.Get("support.linksPanel.kind.delivery"),
        _ => entityKey,
    };

    private static string ModuleOf(string entityKey) => entityKey.StartsWith("contracts.", StringComparison.Ordinal) ? ContractsAccess.ModuleKey : OrdersAccess.ModuleKey;

    private static string? Href(TicketLinkDto l) => l.EntityKey switch
    {
        "contracts.contract" => $"sozlesmeler/{l.RecordId}",
        "orders.order" => $"siparisler/{l.RecordId}",
        _ => null,
    };
}
